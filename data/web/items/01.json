,"cuisine/turkish-cuisine",14036],["Palestine","cuisine/palestinian-cuisine",1581],["Serbia","cuisine/serbian-cuisine",1075],["North Macedonia","cuisine/macedonian-cuisine",34]]}},{"h":"Often cooked with","links":[["Wheat flour","ingredient/wheat-flour"],["Butter","ingredient/butter"],["Curd","ingredient/curd"],["Egg","ingredient/egg"],["Fruit preserves","ingredient/fruit-preserves"],["Jam","ingredient/jam"],["Milk","ingredient/milk"],["Peel","ingredient/peel"],["Sugar","ingredient/sugar"],["Yeast","ingredient/yeast"],["Celery salt","ingredient/celery-salt"],["Chicago-style relish","ingredient/chicago-style-relish"],["Chili pepper","ingredient/chili-pepper"],["Hot dog","ingredient/hot-dog"],["Kosher dill pickle","ingredient/kosher-dill-pickle"],["Mustard","ingredient/mustard"]]}],"img":{"src":"/world-cuisine/img/thumb/6/69/Poppy_seeds.jpg/500px-Poppy_seeds.jpg","w":500,"h":375,"by":"Odedr","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Poppy_seeds.jpg"}},"ingredient/icing":{"t":"ingredient","r":"ingredient/icing","n":"Icing","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 4 dishes across 4 cuisines","intro":[["Icing is a sweet glaze, made of sugar with a liquid, such as water or milk, that is often enriched with ingredients like butter, eggwhites, cream cheese, or flavorings. It is used to coat or decorate baked goods, such as cakes, donuts, or honey buns. When it is used between layers of cake, it is known as a filling in some foods."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-icing"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Icing_(food)"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Austrian cuisine","cuisine/austrian-cuisine",[["Sachertorte","dish/sachertorte"]]],["Hungarian cuisine","cuisine/hungarian-cuisine",[["Rigójancsi","dish/rigojancsi"]]],["Italian cuisine","cuisine/italian-cuisine",[["Cassatella di sant'Agata","dish/cassatella-di-sant-agata