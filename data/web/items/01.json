american-cuisine",[["Cheesesteak","dish/cheesesteak"],["Hamburg steak","dish/hamburg-steak"]]],["Australian cuisine","cuisine/australian-cuisine",[["Steak and eggs","dish/steak-and-eggs"]]],["German cuisine","cuisine/german-cuisine",[["Hamburg steak","dish/hamburg-steak"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Hamburg steak","dish/hamburg-steak"]]]]},{"h":"Often cooked with","links":[["Hoagie roll","ingredient/hoagie-roll"],["Processed cheese","ingredient/processed-cheese"],["Beef","ingredient/beef"],["Egg","ingredient/egg"]]}],"img":{"src":"/world-cuisine/img/thumb/1/1c/Steak_frites_-_yummy.jpg/500px-Steak_frites_-_yummy.jpg","w":500,"h":343,"by":"LuvsMG481","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Steak_frites_-_yummy.jpg"}},"dish/makalo":{"t":"dish","r":"dish/makalo","n":"Makalo","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Macedonian cuisine","dot":"#cf5f87","intro":[["Makalo is a traditional Macedonian side dish. The main ingredients include oil, garlic and peppers although variations in the recipe can also include dry embroidered peppers, mashed potatoes, aubergine, leek and onion. It is usually served as an addition to stews or as a spread on bread."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-makalo"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Makalo"}],"sections":[{"h":"Where it's from","links":[["Macedonian cuisine","cuisine/macedonian-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Chili pepper","ingredient/chili-pepper"]]},{"h":"More from Macedonian cuisine","links":[["Cabbage roll","dish/cabbage-roll"],["İmam bayıldı","dish/imam-bay-ld"],["Pindjur","dish/pindjur"],["Stuffed peppers","dish/stuffed-peppers"],["Tarator","dish/tarator"]]}],"img":{"src":"/world-cuisine/img/thumb/4/4c/%D0%A2%D1%80%D0%B0%D0%B4%D0%B8%D1%86%D0%B8%D0%BE%D0%BD%D0%B0%D0%BB%D0%BD%D0%BE_%D0%9C%D0%B0%D0%BA%D0%B5%D0%B4%D0%BE%D0%BD%D1%