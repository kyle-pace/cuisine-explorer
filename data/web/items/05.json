/en.wikipedia.org/wiki/Cuisine_of_the_Thirteen_Colonies"}],"sections":[{"h":"Dishes","count":1,"links":[["City Tavern","dish/city-tavern"]]},{"h":"Recipe sites","count":1,"rows":[{"name":"Colonial Williamsburg: Recipes","color":"#55b8ad","shape":"site","sub":"colonialwilliamsburg.org","note":"Historic foodways recipes from the Colonial Williamsburg living history museum, adapted from 18th-century sources.","url":"https://www.colonialwilliamsburg.org/learn/recipes/","suggested":true,"kind":"site"}]},{"h":"Cookbooks","count":1,"rows":[{"name":"Martha Washington's Booke of Cookery and Booke of Sweetmeats","color":"#f0b340","shape":"book","sub":"Karen Hess (transcriber and editor), 1981","note":"Columbia University Press edition of the Custis family manuscript used at Mount Vernon, annotated by culinary historian Karen Hess.","url":"https://openlibrary.org/isbn/9780231049313","suggested":true,"isbn":"9780231049313"}]}],"cont":null,"img":{"src":"/labs/cuisines/img/thumb/d/d5/Colonial_Williamsburg_%282463555097%29.jpg/500px-Colonial_Williamsburg_%282463555097%29.jpg","w":500,"h":335,"by":"Harvey Barrison from Massapequa, NY, USA","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Colonial_Williamsburg_(2463555097).jpg"}},"dish/basque-cheesecake":{"t":"dish","r":"dish/basque-cheesecake","n":"Basque cheesecake","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Basque cuisine","dot":"#cf5f87","intro":[["Basque cheesecake, is a crustless cheesecake. It was created in 1988 by Santiago Rivera, chef and owner of the restaurant La Viña in San Sebastián in the Basque Country, Spain. It is characterized by a caramelized surface and a creamy, custard-like interior, achieved by baking at high temperatures."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-basque-cheesecake"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Basque_cheesecake"}],"sections":[{"h":"Where it's from","links":[["Basque cuisine","cuisine/basque-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Cream","ingredient/cream"],["Cream cheese","ingredient/cream-cheese"],["Egg","ingredient/egg"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"More from Basque cuisine","links":[["Gâteau Basque","dish/gateau-basque"],["Gilda (snack)","dish/gilda-snack"],["Goxua","dish/goxua"],["Intxaursaltsa","dish/intxaursaltsa"],["Pantxineta","dish/pantxineta"],["Pincho","dish/pincho"],["Piperade","dish/piperade"],["Stuffed peppers","dish/stuffed-peppers"],["Sukalki","dish/sukalki"],["Tuna pot","dish/tuna-pot"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/ba/%E3%82%B9%E3%83%9A%E3%82%A4%E3%83%B3%E3%81%AE%E5%8C%97%E9%83%A8%E3%81%AE%E7%94%BA%E3%82%B5%E3%83%B3%E3%82%BB%E3%83%90%E3%82%B9%E3%83%81%E3%83%A3%E3%83%B3%E3%81%AB%E3%81%82%E3%82%8B%E3%83%AC%E3%82%B9%E3%83%88%E3%83%A9%E3%83%B3La_Vi%C3%B1a%E3%81%AE%E3%83%81%E3%83%BC%E3%82%BA%E3%82%B1%E3%83%BC%E3%82%AD.jpg/500px-%E3%82%B9%E3%83%9A%E3%82%A4%E3%83%B3%E3%81%AE%E5%8C%97%E9%83%A8%E3%81%AE%E7%94%BA%E3%82%B5%E3%83%B3%E3%82%BB%E3%83%90%E3%82%B9%E3%83%81%E3%83%A3%E3%83%B3%E3%81%AB%E3%81%82%E3%82%8B%E3%83%AC%E3%82%B9%E3%83%88%E3%83%A9%E3%83%B3La_Vi%C3%B1a%E3%81%AE%E3%83%81%E3%83%BC%E3%82%BA%E3%82%B1%E3%83%BC%E3%82%AD.jpg","w":500,"h":667,"by":"Yukio 12","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%E3%82%B9%E3%83%9A%E3%82%A4%E3%83%B3%E3%81%AE%E5%8C%97%E9%83%A8%E3%81%AE%E7%94%BA%E3%82%B5%E3%83%B3%E3%82%BB%E3%83%90%E3%82%B9%E3%83%81%E3%83%A3%E3%83%B3%E3%81%AB%E3%81%82%E3%82%8B%E3%83%AC%E3%82%B9%E3%83%88%E3%83%A9%E3%83%B3La_Vi%C3%B1a%E3%81%AE%E3%83%81%E3%83%BC%E3%82%BA%E3%82%B1%E3%83%BC%E3%82%AD.jpg"}},"dish/biscotti":{"t":"dish","r":"dish/biscotti","n":"Biscotti","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["Biscotti are Italian almond biscuits originating in the city of Prato, Tuscany. They are twice-baked, oblong-shaped, dry, and crunchy. In Italy, they are known as cantucci, biscotti di Prato or biscotti etruschi and may be dipped in a drink, traditionally Vin Santo. Smaller biscotti may be known as biscottini or cantuccini. In Italian, the word biscotti encompasses all types of biscuits or cookies."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-biscotti"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Biscotti"}],"sections":[{"h":"Where it's from","links":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Egg","ingredient/egg"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's long-running video series filming Italian grandmothers making regional pasta by hand.","url":"https://pastagrannies.substack.com/p/pasta-grannies-is-now-on-substack","suggested":true,"kind":"youtube"},{"name":"Recipes from Italy","color":"#55b8ad","shape":"site","sub":"recipesfromitaly.com","note":"Traditional Italian recipes written by Italian home cooks, organized by region and course.","url":"https://recipesfromitaly.com","suggested":true,"kind":"blog"},{"name":"Manu's Menu","color":"#55b8ad","shape":"site","sub":"manusmenu.com","note":"Italian-born home cook Manuela sharing classic family and regional Italian dishes.","url":"https://www.manusmenu.com/about/about-this-site","suggested":true,"kind":"blog"}]},{"h":"More from Italian cuisine","links":[["Acquacotta","dish/acquacotta"],["Agliata","dish/agliata"],["Agnolotti","dish/agnolotti"],["Antipasto","dish/antipasto"],["Arancini","dish/arancini"],["Bolinhos de bacalhau","dish/bolinhos-de-bacalhau"],["Bombolone","dish/bombolone"],["Budino","dish/budino"],["Cabbage roll","dish/cabbage-roll"],["Caesar salad","dish/caesar-salad"],["Cannelloni","dish/cannelloni"],["Capellini","dish/capellini"],["Carbonara","dish/carbonara"],["Carpaccio","dish/carpaccio"],["Cassatella di sant'Agata","dish/cassatella-di-sant-agata"],["Cassoeula","dish/cassoeula"],["Ciabatta","dish/ciabatta"],["Cioppino","dish/cioppino"],["Coda alla vaccinara","dish/coda-alla-vaccinara"],["Colomba pasquale","dish/colomba-pasquale"],["Conti roll","dish/conti-roll"],["Cotoletta alla bolognese","dish/cotoletta-alla-bolognese"],["Crostata","dish/crostata"],["Drago restaurants","dish/drago-restaurants"],["Focaccia pugliese","dish/focaccia-pugliese"],["Frittata","dish/frittata"],["Giardiniera","dish/giardiniera"],["Guanciale","dish/guanciale"],["Italian restaurant","dish/italian-restaurant"],["Italian wedding soup","dish/italian-wedding-soup"],["Lampredotto","dish/lampredotto"],["Lasagna","dish/lasagna"],["List of Italian restaurants","dish/list-of-italian-restaurants"],["Marinara sauce","dish/marinara-sauce"],["Mondeghili","dish/mondeghili"],["Paccheri","dish/paccheri"],["Panini (sandwich)","dish/panini-sandwich"],["Panna cotta","dish/panna-cotta"],["Passatelli","dish/passatelli"],["Pecorino","dish/pecorino"]]}],"img":{"src":"/labs/cuisines/img/thumb/3/38/Biscotti_from_Cossetta%27s.jpg/500px-Biscotti_from_Cossetta%27s.jpg","w":500,"h":204,"by":"Gobonobo","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Biscotti_from_Cossetta's.jpg"}},"ingredient/tauco":{"t":"ingredient","r":"ingredient/tauco","n":"Tauco","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Tauco, Taucu, Taotjo, Tao Jiew or Tauchu are various adaptations of the yellow soybean paste from China created by overseas Chinese in Southeast Asia. Tauco is made by boiling yellow soybeans, grinding them, mixing them with flour, and fermenting them to make a soy paste. The soy paste is soaked in salt water and sun-dried for several weeks, furthering the fermentation process, until the color of the paste has turned yellow-reddish. Good tauco has a distinct aroma.  The tauco is commonly used by Chinese Indonesians, Malaysian Chinese, Chinese Singaporeans, Chinese Bruneians, and Thai Chinese. It is also used in other Indonesian cuisine traditions, such as Sundanese cuisine and Javanese cuisine, as well as by non-Chinese Malaysians, Singaporeans, Bruneians, and Thais."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tauco"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tauco"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Coto makassar","dish/coto-makassar"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Black pepper","ingredient/black-pepper"],["Broth","ingredient/broth"],["Candlenut","ingredient/candlenut"],["Caraway","ingredient/caraway"],["Celery","ingredient/celery"],["Chili pepper","ingredient/chili-pepper"],["Cinnamomum verum","ingredient/cinnamomum-verum"],["Coconut milk","ingredient/coconut-milk"],["Galangal","ingredient/galangal"],["Ginger","ingredient/ginger"],["Lemongrass","ingredient/lemongrass"],["Lime","ingredient/lime"],["Lontong","ingredient/lontong"],["Offal","ingredient/offal"],["Palm sugar","ingredient/palm-sugar"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e0/Tauco_in_Supermarket.JPG/500px-Tauco_in_Supermarket.JPG","w":500,"h":800,"by":"Gunawan Kartapranata","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Tauco_in_Supermarket.JPG"}},"dish/dambalkhacho":{"t":"dish","r":"dish/dambalkhacho","n":"Dambalkhacho","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Georgian cuisine","dot":"#f0b340","intro":[["Dambalkhacho is a pungent Georgian cheese. The dried lumps are placed into clay pots and left that way for 2-3 months, in order for the cheese to develop special mold. The cheese has a specific, intense aroma, the texture is semi-soft and uniform, while the flavors are spicy."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-dambalkhacho"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Dambalkhacho"}],"sections":[{"h":"Where it's from","links":[["Georgian cuisine","cuisine/georgian-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Milk","ingredient/milk"]]},{"h":"Cook it","rows":[{"name":"Georgian Recipes","color":"#55b8ad","shape":"site","sub":"georgianrecipes.net","note":"Recipe site dedicated to traditional Georgian dishes.","url":"https://georgianrecipes.net/about-georgian-recipes","suggested":true,"kind":"site"}]},{"h":"More from Georgian cuisine","links":[["Achma","dish/achma"],["Ajika","dish/ajika"],["Akhasheni","dish/akhasheni"],["Cabbage roll","dish/cabbage-roll"],["Chakapuli","dish/chakapuli"],["Chakhokhbili","dish/chakhokhbili"],["Chashushuli","dish/chashushuli"],["Chicken tabaka","dish/chicken-tabaka"],["Churchkhela","dish/churchkhela"],["Eggplant jam","dish/eggplant-jam"],["Gozinaki","dish/gozinaki"],["Khachapuri","dish/khachapuri"],["Kharcho","dish/kharcho"],["Khash (dish)","dish/khash-dish"],["Khvanchkara","dish/khvanchkara"],["Kindzmarauli","dish/kindzmarauli"],["Kubdari","dish/kubdari"],["Kuchmachi","dish/kuchmachi"],["Kvass","dish/kvass"],["Lobiani","dish/lobiani"],["Mchadi","dish/mchadi"],["Mujuretuli","dish/mujuretuli"],["Nadugi","dish/nadugi"],["Nigvziani badrijani","dish/nigvziani-badrijani"],["Pkhali","dish/pkhali"],["Shkmeruli","dish/shkmeruli"],["Tsolikouri","dish/tsolikouri"],["Tvishi (wine)","dish/tvishi-wine"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/0d/%E1%83%93%E1%83%90%E1%83%9B%E1%83%91%E1%83%90%E1%83%9A%E1%83%AE%E1%83%90%E1%83%AD%E1%83%9D.jpg/500px-%E1%83%93%E1%83%90%E1%83%9B%E1%83%91%E1%83%90%E1%83%9A%E1%83%AE%E1%83%90%E1%83%AD%E1%83%9D.jpg","w":500,"h":332,"by":"ბექა ბაიაშვილი (Beqabai)","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%E1%83%93%E1%83%90%E1%83%9B%E1%83%91%E1%83%90%E1%83%9A%E1%83%AE%