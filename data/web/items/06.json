_content=thumbnail_unscaled","w":500,"h":528,"by":"Vivianngovu","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:BR_-_Exterior_-_01.jpg"}},"ingredient/common-octopus":{"t":"ingredient","r":"ingredient/common-octopus","n":"Common octopus","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The common octopus (Octopus vulgaris) is a mollusk belonging to the class Cephalopoda. Octopus vulgaris is one of the most studied of all the octopus species, and also one of the most intelligent. It ranges from the eastern Atlantic, extends from the Mediterranean Sea, Black sea and the southern coast of England, to the southern coast of South Africa. It also occurs off the Azores, Canary Islands, and Cape Verde Islands. The species is also common in the Western Atlantic."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-common-octopus"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Common_octopus"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Galician cuisine","cuisine/galician-cuisine",[["Polbo á feira","dish/polbo-a-feira"]]]]},{"h":"Often cooked with","links":[["Octopus as food","ingredient/octopus-as-food"],["Olive oil","ingredient/olive-oil"],["Paprika","ingredient/paprika"]]}]},"dish/pommes-anna":{"t":"dish","r":"dish/pommes-anna","n":"Pommes Anna","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Pommes Anna, or Anna potatoes, is a classic French dish of sliced, layered potatoes cooked in a very large amount of melted butter. There are several variants of the dish, containing, in addition to potatoes and butter, other ingredients, which may include artichoke hearts, black truffles, mushrooms and cheese."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pommes-anna"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pommes_Anna"}],"