["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Chow-chow (food)","dish/chow-chow-food"],["Chowder","dish/chowder"],["Cioppino","dish/cioppino"],["Clam chowder","dish/clam-chowder"],["Clam dip","dish/clam-dip"],["Club sandwich","dish/club-sandwich"],["Cobb salad","dish/cobb-salad"],["Cobbler (food)","dish/cobbler-food"],["Cook's Corner","dish/cook-s-corner"],["Crab cake","dish/crab-cake"],["Croffle","dish/croffle"],["Dagwood Bumstead","dish/dagwood-bumstead"],["Dagwood sandwich","dish/dagwood-sandwich"],["Deep-dish pizza","dish/deep-dish-pizza"],["Desperation pie","dish/desperation-pie"],["Dirty rice","dish/dirty-rice"],["Egg in the basket","dish/egg-in-the-basket"],["Fish and chips","dish/fish-and-chips"],["Fritter","dish/fritter"]]}],"img":{"src":"/world-cuisine/img/thumb/7/75/Timbits2.jpg/500px-Timbits2.jpg","w":500,"h":331,"by":"Raysonho @ Open Grid Scheduler / Grid Engine","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Timbits2.jpg"}},"ingredient/blackcurrant":{"t":"ingredient","r":"ingredient/blackcurrant","n":"Blackcurrant","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The blackcurrant (Ribes nigrum), black currant or cassis is a deciduous shrub in the family Grossulariaceae grown for its edible berries. It is native to temperate parts of central and northern Europe and northern Asia, where it prefers damp fertile soils. It is widely cultivated both commercially and domestically."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-blackcurrant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Blackcurrant"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["British cuisine","cuisine/british-cuisine",[["Flies' graveyard","dish/flies-graveyard"]]]]},{"h":"Often cooked with","links":[["Raisin","ingredient/raisin"],["Ribes","ingredient/ribes"]]}],"img":{"src":"/world-cuisine/img/thumb/0/05/Ribes_nigrum_a1.JPG/500px-Ribes_nigrum_a1.JPG","w":500,"h":374,"by":"Jerzy Opioła","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Ribes_nigrum_a1.JPG"}},"ingredient/parkia-speciosa":{"t":"ingredient","r":"ingredient/parkia-speciosa","n":"Parkia speciosa","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Parkia speciosa, the bitter bean, twisted cluster bean, sator bean, stink bean, or petai is a plant of the genus Parkia in the family Fabaceae.  It bears long, flat edible beans with bright green seeds the size and shape of plump almonds that have a rather peculiar smell that is similar to but stronger than that of the shiitake mushroom, due to sulfur-containing compounds also found in shiitake, truffles, and cabbage."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-parkia-speciosa"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Parkia_speciosa"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Keluak","dish/keluak"]]]]},{"h":"Often cooked with","links":[["Hydrogen cyanide","ingredient/hydrogen-cyanide"],["Tomato","ingredient/tomato"]]}],"img":{"src":"/world-cuisine/img/thumb/7/7a/Parkia_speciosa.JPG/500px-Parkia_speciosa.JPG","w":500,"h":332,"by":"Hariadhi","lic":"CC BY 2.5","licUrl":"https://creativecommons.org/licenses/by/2.5","page":"https://commons.wikimedia.org/wiki/File:Parkia_speciosa.JPG"}},"ingredient/sodium-hydroxide":{"t":"ingredient","r":"ingredient/sodium-hydroxide","n":"Sodium hydroxide","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Sodium hydroxide, also known as caustic soda and, more generically, as lye, is an inorganic compound with the formula NaOH. It is a white solid ionic compound consisting of sodium cations Na+ and hydroxide anions OH−. As a strong nucleophile, it is frequently used in SN2 reactions."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sodium-hydroxide"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sodium_hydroxide"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Norwegian cuisine","cuisine/norwegian-cuisine",[["Lutefisk","dish/lutefisk"]]],["Swedish cuisine","cuisine/swedish-cuisine",[["Lutefisk","dish/lutefisk"]]]]},{"h":"Often cooked with","links":[["Atlantic cod","ingredient/atlantic-cod"]]}],"img":{"src":"/world-cuisine/img/thumb/6/63/Sodium-hydroxide-crystal-3D-vdW.png/500px-Sodium-hydroxide-crystal-3D-vdW.png","w":500,"h":376,"by":"Ben Mills","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Sodium-hydroxide-crystal-3D-vdW.png"}},"ingredient/black-eyed-bean":{"t":"ingredient","r":"ingredient/black-eyed-bean","n":"Black-eyed bean","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The black-eyed pea or black-eyed bean is a legume grown around the world for its medium-sized, edible bean. It is a subspecies of the cowpea, an Old World plant domesticated in Africa, and is sometimes simply called a cowpea."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-black-eyed-bean"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Black-eyed_bean"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Nigerian cuisine","cuisine/nigerian-cuisine",[["Moin moin","dish/moin-moin"]]]]},{"h":"Often cooked with","links":[["Black-eyed pea","ingredient/black-eyed-pea"],["Chicken","ingredient/chicken"],["Chili pepper","ingredient/chili-pepper"],["Crayfish","ingredient/crayfish"],["Egg","ingredient/egg"],["Onion","ingredient/onion"],["Palm oil","ingredient/palm-oil"]]}],"img":{"src":"/world-cuisine/img/thumb/3/30/Black-eyed_peas_close_up.jpg/500px-Black-eyed_peas_close_up.jpg","w":500,"h":359,"by":"Jud McCranie","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Black-eyed_peas_close_up.jpg"}},"ingredient/cosmos":{"t":"ingredient","r":"ingredient/cosmos","n":"Cosmos","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Cosmos is a genus, with the same common name of cosmos, consisting of flowering plants in the daisy family."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-cosmos"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cosmos_(plant)"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Nasi tempong","dish/nasi-tempong"]]]]},{"h":"Often cooked with","links":[["Amaranth","ingredient/amaranth"],["Bakwan","ingredient/bakwan"],["Bird's eye chili","ingredient/bird-s-eye-chili"],["Holy basil","ingredient/holy-basil"],["Ikan goreng","ingredient/ikan-goreng"],["Peanut sauce","ingredient/peanut-sauce"],["Rice","ingredient/rice"],["Tahu goreng","ingredient/tahu-goreng"],["Tomato","ingredient/tomato"]]}],"img":{"src":"/world-cuisine/img/thumb/e/e0/Cosmos_bipinnatus%2C_a_wild_Cosmos_%289461227273%29.jpg/500px-Cosmos_bipinnatus%2C_a_wild_Cosmos_%289461227273%29.jpg","w":500,"h":473,"by":"Dick Culbert from Gibsons, B.C., Canada","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Cosmos_bipinnatus%2C_a_wild_Cosmos_(9461227273).jpg"}},"dish/taco":{"t":"dish","r":"dish/taco","n":"Taco","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#94bd5c","intro":[["A taco is a traditional Mexican dish consisting of a small hand-sized corn- or wheat-based tortilla topped with a filling. The tortilla is then folded around the filling and eaten by hand. A taco can be made with a variety of fillings, including beef, pork, chicken, seafood, beans, vegetables, and cheese, and garnished with various condiments, such as salsa, guacamole, or sour cream, and vegetables, such as lettuce, coriander, onion, tomatoes, and chiles. Tacos are a common form of antojitos, or Mexican street food, which have spread around the world."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-taco"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Taco"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"],["Mexican cuisine","cuisine/mexican-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Corn tortilla","ingredient/corn-tortilla"],["Flour tortilla","ingredient/flour-tortilla"],["Protein_(nutrient)","ingredient/protein-nutrient"],["Tortilla","ingredient/tortilla"]]},{"h":"Cook it","rows":[{"name":"Mexico in My Kitchen","color":"#55b8ad","shape":"site","sub":"mexicoinmykitchen.com","note":"Mely Martínez's long-running blog of Mexican home-style recipes.","url":"https://www.mexicoinmykitchen.com/","suggested":true,"kind":"blog"},{"name":"Pati Jinich","color":"#55b8ad","shape":"site","sub":"patijinich.com","note":"Recipe archive from the Mexican-born chef and host of the PBS series Pati's Mexican Table.","url":"https://patijinich.com/recipes/","suggested":true,"kind":"site"}]},{"h":"More from American cuisine","links":[["Angel food cake","dish/angel-food-cake"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Beer cake","dish/beer-cake"],["Better than sex cake","dish/better-than-sex-cake"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Brown Betty (dessert)","dish/brown-betty-dessert"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Butter cake","dish/butter-cake"],["Caesar salad","dish/caesar-salad"],["Caramel apple","dish/caramel-apple"],["Carbonara","dish/carbonara"],["Cheesesteak","dish/cheesesteak"],["Chicago-style hot dog","dish/chicago-style-hot-dog"],["Chicken nugget","dish/chicken-nugget"