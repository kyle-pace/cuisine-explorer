{"ingredient/garcinia-atroviridis":{"t":"ingredient","r":"ingredient/garcinia-atroviridis","n":"Garcinia atroviridis","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 3 cuisines","intro":[["Garcinia atroviridis, known as asam gelugur, asam gelugo, or asam keping is a large rainforest tree which ranges from the eastern Himalayas through Myanmar and Thailand to Peninsular Malaysia, Borneo, and Sumatra. Garcinia atroviridis is commonly found in evergreen forests in the southern region of Thailand and Malaysia. This species grows wild throughout Peninsular Malaysia but is also widely cultivated, especially in the northern states, owing to its economic and medicinal value."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-garcinia-atroviridis"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Garcinia_atroviridis"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Arsik","dish/arsik"],["Rendang","dish/rendang"]]],["Chinese cuisine","cuisine/chinese-cuisine",[["Tshài-bué-thng","dish/tshai-bue-thng"]]],["Padang food","cuisine/padang-food",[["Rendang","dish/rendang"]]]]},{"h":"Often cooked with","links":[["Candlenut","ingredient/candlenut"],["Chili pepper","ingredient/chili-pepper"],["Lemongrass","ingredient/lemongrass"],["Asparagus bean","ingredient/asparagus-bean"],["Bay leaf","ingredient/bay-leaf"],["Chives","ingredient/chives"],["Etlingera elatior","ingredient/etlingera-elatior"],["Galangal","ingredient/galangal"],["Garlic","ingredient/garlic"],["Ginger","ingredient/ginger"],["Goldfish","ingredient/goldfish"],["Sugar","ingredient/sugar"],["Beef","ingredient/beef"],["Chicken","ingredient/chicken"],["Coconut cream","ingredient/coconut-cream"],["Coconut milk","ingredient/coconut-milk"]]}]},"ingredient/lemon":{"t":"ingredient","r":"ingredient/lemon","n":"Lemon","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 7 dishes acr