cuisine",[["Qatayef","dish/qatayef"]]],["Thai cuisine","cuisine/thai-cuisine",[["Boat noodles","dish/boat-noodles"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Stollen","dish/stollen"]]],["Western American cuisine","cuisine/cuisine-of-the-western-united-states",[["Dutch baby pancake","dish/dutch-baby-pancake"]]]]},{"h":"Where it's grown","grown":{"what":"Cinnamon and cinnamon-tree flowers, raw","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":235147,"top":[["China","cuisine/chinese-cuisine",92122],["Vietnam","cuisine/vietnamese-cuisine",63661],["Indonesia","cuisine/indonesian-cuisine",53141],["Sri Lanka","cuisine/sri-lankan-cuisine",22680],["Madagascar","cuisine/malagasy-cuisine",3255],["Timor-Leste","cuisine/cuisine-of-east-timor",122],["Grenada","cuisine/culture-of-grenada-cuisine",72],["São Tomé and Principe","cuisine/cuisine-of-sao-tome-and-principe",58],["Dominica","cuisine/cuisine-of-dominica",34],["Seychelles","cuisine/seychellois-cuisine",2]]}},{"h":"Often cooked with","links":[["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"],["Cardamom","ingredient/cardamom"],["Ginger","ingredient/ginger"],["Butter","ingredient/butter"],["Nutmeg","ingredient/nutmeg"],["Egg","ingredient/egg"],["Milk","ingredient/milk"],["Walnut","ingredient/walnut"],["Lemongrass","ingredient/lemongrass"],["Yeast","ingredient/yeast"],["Coconut milk","ingredient/coconut-milk"],["Black pepper","ingredient/black-pepper"],["Caraway","ingredient/caraway"],["Galangal","ingredient/galangal"],["Rice","ingredient/rice"]]}],"img":{"src":"/world-cuisine/img/thumb/d/de/Cinnamomum_verum_spices.jpg/500px-Cinnamomum_verum_spices.jpg","w":500,"h":287,"by":"Simon A. Eugster","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Cinnamomum_verum_spices.jpg"}},"ingredient/snail":{"t":"ingredient","r":"ingredient/snail","n":"Snail","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A snail is a shelled gastropod. The name is most often applied to land snails, terrestrial pulmonate gastropod molluscs. However, the common name snail is also used for most of the members of the molluscan class Gastropoda that have a coiled shell that is large enough for the animal to retract completely into. When the word \"snail\" is used in this most general sense, it includes not just land snails but also numerous species of sea snails and freshwater snails. Gastropods that naturally lack a shell, or have only an internal shell, are mostly called slugs, and land snails that have only a very small shell (that they cannot retract into) are sometimes called semi-slugs."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-snail"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Snail"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Moroccan cuisine","cuisine/moroccan-cuisine",[["Babbouche","dish/babbouche"]]]]},{"h":"Often cooked with","links":[["Anise","ingredient/anise"],["Elettaria cardamomum","ingredient/elettaria-cardamomum"],["Liquorice","ingredient/liquorice"],["Mentha pulegium","ingredient/mentha-pulegium"],["Ras el hanout","ingredient/ras-el-hanout"],["Thymus","ingredient/thymus"]]}],"img":{"src":"/world-cuisine/img/thumb/c/cc/Snail.jpg/500px-Snail.jpg","w":500,"h":375,"by":"Geierunited","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Snail.jpg"}},"ingredient/namul":{"t":"ingredient","r":"ingredient/namul","n":"Namul","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Namul refers to either a variety of edible greens or leaves or seasoned herbal dishes made of them. Wild greens are called san-namul (산나물; lit. 'mountain namul'), and spring vegetables are called bom-namul (봄나물; lit. 'spring namul'). On the day of Daeboreum, the first full moon of the year, Koreans eat boreum-namul (보름나물; lit. 'full moon namul') with five-grain rice. It is believed that boreum namuls eaten in winter help one to withstand the heat of the summer to come."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-namul"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Namul"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Korean cuisine","cuisine/korean-cuisine",[["Bibimbap","dish/bibimbap"]]]]},{"h":"Often cooked with","links":[["Egg","ingredient/egg"],["Gochujang","ingredient/gochujang"],["Rice","ingredient/rice"]]}],"img":{"src":"/world-cuisine/img/thumb/2/28/KOCIS_Korea_President_Park_Arirang_Concert_07_%2810552593495%29.jpg/500px-KOCIS_Korea_President_Park_Arirang_Concert_07_%2810552593495%29.jpg","w":500,"h":311,"by":"Korea.net / Korean Culture and Information Service (Photographer name)","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:KOCIS_Korea_President_Park_Arirang_Concert_07_(10552593495).jpg"}},"ingredient/shaved-ice":{"t":"ingredient","r":"ingredient/shaved-ice","n":"Shaved ice","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Shaved ice is a large family of ice-based desserts made of fine shavings of ice and sweet condiments or flavored syrups. Usually, the syrup is added after the ice has been frozen and shaved—typically at the point of sale; however, flavoring can also be added before freezing. The dessert is consumed worldwide in various forms and ways. Shaved ice can also be mixed with large quantities of liquid to produce shaved ice drinks."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-shaved-ice"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Shaved_ice"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Cendol","dish/cendol"]]]]},{"h":"Often cooked with","links":[["Coconut milk","ingredient/coconut-milk"],["Ice","ingredient/ice"],["Palm sugar","ingredient/palm-sugar"],["Pandan","ingredient/pandan"],["Rice flour","ingredient/rice-flour"]]}],"img":{"src":"/world-cuisine/img/thumb/f/f6/Shavedice.jpg/500px-Shavedice.jpg","w":500,"h":313,"by":"Sean Loyless from Austin, USA","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Shavedice.jpg"}},"dish/chakapuli":{"t":"dish","r":"dish/chakapuli","n":"Chakapuli","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Georgian cuisine","dot":"#f0b340","intro":[["Chakapuli is a Georgian stew. It is considered to be one of the most popular dishes in Georgia."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-chakapuli"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chakapuli"}],"sections":[{"h":"Where it's from","links":[["Georgian cuisine","cuisine/georgian-cuisine"]]},{"h":"Ingredients","count":15,"links":[["Anethum","ingredient/anethum"],["Coriander","ingredient/coriander"],["Garlic","ingredient/garlic"],["Lamb","ingredient/lamb"],["Mentha","ingredient/mentha"],["Onion","ingredient/onion"],["Petroselinum","ingredient/petroselinum"],["Plum","ingredient/plum"],["Prunus cerasifera","ingredient/prunus-cerasifera"],["Prunus vachuschtii","ingredient/prunus-vachuschtii"],["Scallion","ingredient/scallion"],["Tarragon","ingredient/tarragon"],["Tkemali","ingredient/tkemali"],["Veal","ingredient/veal"],["White wine","ingredient/white-wine"]]},{"h":"Cook it","rows":[{"name":"Georgian Recipes","color":"#55b8ad","shape":"site","sub":"georgianrecipes.net","note":"Recipe site dedicated to traditional Georgian dishes.","url":"https://georgianrecipes.net/about-georgian-recipes","suggested":true,"kind":"site"}]},{"h":"More from Georgian cuisine","links":[["Achma","dish/achma"],["Ajika","dish/ajika"],["Akhasheni","dish/akhasheni"],["Cabbage roll","dish/cabbage-roll"],["C