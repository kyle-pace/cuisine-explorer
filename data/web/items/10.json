bouche","dish/croquembouche"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Crêpes Suzette","dish/crepes-suzette"],["Croquembouche","dish/croquembouche"]]],["Ashkenazi Jewish cuisine","cuisine/ashkenazi-jewish-cuisine",[["Yerushalmi Kugel","dish/yerushalmi-kugel"]]],["Basque cuisine","cuisine/basque-cuisine",[["Goxua","dish/goxua"]]],["Chinese cuisine","cuisine/chinese-cuisine",[["Huangqiao sesame cake","dish/huangqiao-sesame-cake"]]],["Georgian cuisine","cuisine/georgian-cuisine",[["Gozinaki","dish/gozinaki"]]]]},{"h":"Often cooked with","links":[["Sugar","ingredient/sugar"],["Apple","ingredient/apple"],["Profiterole","ingredient/profiterole"],["Profiteroles","ingredient/profiteroles"],["Butter","ingredient/butter"],["Crêpe","ingredient/crepe"],["Crêpes","ingredient/crepes"],["Curaçao liqueur","ingredient/curacao-liqueur"],["Grand Marnier","ingredient/grand-marnier"],["Orange (fruit)","ingredient/orange-fruit"],["Tangerine","ingredient/tangerine"],["Triple sec","ingredient/triple-sec"],["Zest","ingredient/zest"],["Cream","ingredient/cream"],["Sponge cake","ingredient/sponge-cake"],["Honey","ingredient/honey"]]}]},"dish/egg-butter":{"t":"dish","r":"dish/egg-butter","n":"Egg butter","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Egg butter is a mixture of butter and chopped hard-boiled eggs. It is a well known spread in Finnish cuisine and Estonian cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-egg-butter"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Egg_butter"}],"sections":[{"h":"Where it's from","links":[["Estonian cuisine","cuisine/estonian-cuisine"],["Finnish cuisine","cuisine/finnish-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Butter","ingredient/butter"]]},{"h":"Cook it","rows":[{"name":"Estonian Cuisine","ref":"site/estoniancuisine-com","color":"#55b8ad","shape":"site","sub":"estoniancuisine.com","note":"English-language blog dedicated to Estonian home recipes.","url":"https://estoniancuisine.com/about-estonian-food-blog/","suggested":true}]},{"h":"More from Estonian cuisine","links":[["Aspic","dish/aspic"],["Cabbage roll","dish/cabbage-roll"],["Glögg","dish/glogg"],["Kvass","dish/kvass"],["Smörgåstårta","dish/smorgastarta"]]}]},"dish/filipino-barbecue":{"t":"dish","r":"dish/filipino-barbecue","n":"Filipino barbecue","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#f0b340","intro":[["Filipino barbecue or Pinoy barbecue is a Filipino cuisine variety of skewers (tusok-tusok) that are grilled (inihaw). Entrenched in the street food of the Philippines since the 1950s, Filipino barbecue is quintessentially based on marinated pork, chicken and  offal."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-filipino-barbecue"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Filipino_barbecue"}],"sections":[{"h":"Where it's from","links":[["Filipino cuisine","cuisine/filipino-cuisine"],["Mindanao cuisine","cuisine/filipino-cuisine-mindanao"],["Visayan cuisine","cuisine/filipino-cuisine-visayas"]]},{"h":"Cook it","rows":[{"name":"Panlasang Pinoy","ref":"site/panlasangpinoy-com","color":"#55b8ad","shape":"site","sub":"panlasangpinoy.com","note":"Vanjo Merano's large library of Filipino recipes and cooking videos.","url":"https://panlasangpinoy.com/filipino-food/","suggested":true},{"name":"Kawaling Pinoy","ref":"site/kawalingpinoy-com","color":"#55b8ad","shape":"site","sub":"kawalingpinoy.com","note":"Lalaine Manalo's blog of Filipino home cooking.","url":"https://www.kawalingpinoy.com/about/","suggested":true},{"name":"Flavours of Iloilo","ref":"site/flavoursofiloilo-blogspot-com","color":"#55b8ad","shape":"site","sub":"flavoursofiloilo.blogspot.com","note":"Blog of Ilonggo home dishes from Iloilo in the Western Visayas.","url":"https://flavoursofiloilo.blogspot.com/2013/05/how-about-some-chicken-binakol.html","suggested":true}]},{"h":"More from Filipino cuisine","links":[