lo-taqueria"],["El Tepeyac Café","dish/el-tepeyac-cafe"],["El Torito","dish/el-torito"],["Em (restaurant)","dish/em-restaurant"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/8d/Pujol_Restaurant_%2840553682022%29.jpg/500px-Pujol_Restaurant_%2840553682022%29.jpg","w":500,"h":334,"by":"Nan Palmero from San Antonio, TX, USA","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Pujol_Restaurant_(40553682022).jpg"}},"ingredient/ramyeon":{"t":"ingredient","r":"ingredient/ramyeon","n":"Ramyeon","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["This is a list of instant noodle brands. Instant noodles are a dried or precooked noodle block, usually sold with a packet of flavoring powder and/or seasoning oil. Dried noodles are usually eaten after being cooked or soaked in boiling water, while precooked noodles can be reheated or eaten straight from the packet/cup. The instant noodle was invented by Momofuku Ando of Nissin Foods in Japan. They were launched in 1958 under the brand name Chikin Ramen."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-ramyeon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ramyeon"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["South Korean cuisine","cuisine/south-korean-cuisine",[["Rabokki","dish/rabokki"]]]]},{"h":"Often cooked with","links":[["Instant noodles","ingredient/instant-noodles"],["Tteok","ingredient/tteok"]]}],"img":{"src":"/labs/cuisines/img/thumb/3/3f/2016_Indomie_Mi_Goreng_Rendang_NL_01.jpg/500px-2016_Indomie_Mi_Goreng_Rendang_NL_01.jpg","w":500,"h":500,"by":"Takeaway","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:2016_Indomie_Mi_Goreng_Rendang_NL_01.jpg"}},"ingredient/candeal-bread":{"t":"ingredient","r":"ingredient/candeal-bread","n":"Candeal bread","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Candeal bread, also known as sobado or bregado, is a type of white bread characterized by low hydration, a dense texture, and long shelf life. Its preparation differs from other breads due to a single fermentation and a process of dough sheeting (refinado), which compacts and hardens the dough. In this sense, it is the opposite of flama breads (pan de flama) or soft dough bread (common breads). Candeal bread has a dense, tight crumb with no pores and a crispy crust with a very smooth, golden surface. It often features scorings (cuts) in geometric patterns. Candeal bread is sold in various shapes, including round loaves, bars, squares, rings, spikes, and braids. Traditionally, it was made with durum wheat flour, which has less strength – gluten – than conventional flour but a higher protein content."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-candeal-bread"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Candeal_bread"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Spanish cuisine","cuisine/spanish-cuisine",[["Salmorejo","dish/salmorejo"]]]]},{"h":"Often cooked with","links":[["Garlic","ingredient/garlic"],["Olive oil","ingredient/olive-oil"],["Tomato","ingredient/tomato"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/7b/CocinaPalentina-Pan_002.jpg/500px-CocinaPalentina-Pan_002.jpg","w":500,"h":395,"by":"Valdavia","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:CocinaPalentina-Pan_002.jpg"}},"dish/speckkuchen":{"t":"dish","r":"dish/speckkuchen","n":"Speckkuchen","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#cf5f87","intro":[["Speckkuchen is a type of quiche, a specialty of northern Hesse, Germany. It is a bacon pie/flan with a rye flour crust on the base and made with eggs, and in some villages contains high proportion of leeks or onions. It is popular as a quick snack in Kassel, especially on market days, sold at food stalls and bakeries. As with many regional specialties, every village and every baker has his own Speckkuchen recipe."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-speckkuchen"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Speckkuchen"}],"sections":[{"h":"Where it's from","links":[["German cuisine","cuisine/german-cuisine"],["Thuringian cuisine","cuisine/german-cuisine-thuringia"],["Hungarian cuisine","cuisine/hungarian-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Bacon","ingredient/bacon"],["Egg","ingredient/egg"],["Leek","ingredient/leek"],["Onion","ingredient/onion"]]},{"h":"Cook it","rows":[{"name":"Quick German Recipes","ref":"site/quick-german-recipes-com","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Long-running site by German-born cook Gerhild Fulson (Oma) with traditional German home recipes.","url":"https://www.quick-german-recipes.com/about-me.html","suggested":true},{"name":"Dirndl Kitchen","ref":"site/dirndlkitchen-com","color":"#55b8ad","shape":"site","sub":"dirndlkitchen.com","note":"Blog of German and Bavarian recipes, from main dishes to holiday baking.","url":"https://dirndlkitchen.com","suggested":true},{"name":"Quick German Recipes","ref":"site/quick-german-recipes-com","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Thuringia page on German-born cook Gerhild Fulson's long-running German recipe site.","url":"https://www.quick-german-recipes.com/thuringia.html","suggested":true},{"name":"Zsuzsa Is in the Kitchen","ref":"site/zsuzsaisinthekitchen-blogspot-com","color":"#55b8ad","shape":"site","sub":"zsuzsaisinthekitchen.blogspot.com","note":"Hungarian-born home cook's blog of traditional Hungarian recipes.","url":"https://zsuzsaisinthekitchen.blogspot.com/2010/01","suggested":true}]},{"h":"More from German cuisine","links":[["Baumkuchen","dish/baumkuchen"],["Berlin Inn","dish/b