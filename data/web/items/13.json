sh/paccheri"],["Panini (sandwich)","dish/panini-sandwich"],["Panna cotta","dish/panna-cotta"],["Passatelli","dish/passatelli"],["Pecorino","dish/pecorino"]]}],"img":{"src":"/world-cuisine/img/thumb/a/a8/GiardinieraSpicy.JPG/500px-GiardinieraSpicy.JPG","w":500,"h":401,"by":"Antonio Cavallo","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:GiardinieraSpicy.JPG"}},"dish/haggis":{"t":"dish","r":"dish/haggis","n":"Haggis","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Scottish cuisine","dot":"#cf5f87","intro":[["Haggis is a savoury pudding and sausage containing sheep's pluck (heart, liver, and lungs), minced with chopped onion, oatmeal, suet, seasonings, and salt, mixed with stock, and cooked while traditionally encased in the animal's stomach though now an artificial casing is often used instead. According to the 2001 English edition of the Larousse Gastronomique: \"Although its description is not immediately appealing, haggis has an excellent nutty texture and delicious savoury flavour\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-haggis"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Haggis"}],"sections":[{"h":"Where it's from","links":[["Scottish cuisine","cuisine/scottish-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Oatmeal","ingredient/oatmeal"],["Offal","ingredient/offal"],["Onion","ingredient/onion"],["Sausage casing","ingredient/sausage-casing"],["Suet","ingredient/suet"]]},{"h":"Cook it","rows":[{"name":"Scottish Scran","color":"#55b8ad","shape":"site","sub":"scottishscran.com","note":"Blog working through traditional Scottish dishes one recipe at a time.","url":"https://scottishscran.com","suggested":true,"kind":"blog"},{"name":"Something Sweet Something Savoury: Scottish recipes","color":"#55b8ad","shape":"site","sub":"somethingsweetsomethingsavoury.com","note":"Scottish home baking and cooking section of a UK food blog.","url":"https://somethingsweetsomethingsavoury.com/category/scottish-recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Scottish cuisine","links":[["Clootie dumpling","dish/clootie-dumpling"],["Cock-a-leekie","dish/cock-a-leekie"],["Finnan haddie","dish/finnan-haddie"],["Haggis pakora","dish/haggis-pakora"],["Hobnob biscuit","dish/hobnob-biscuit"],["Lorne sausage","dish/lorne-sausage"],["Mince and tatties","dish/mince-and-tatties"],["Rumbledethumps","dish/rumbledethumps"],["Scotch broth","dish/scotch-broth"],["Skirlie","dish/skirlie"],["Stornoway black pudding","dish/stornoway-black-pudding"]]}],"img":{"src":"/world-cuisine/img/6/6a/Haggis_Mo.jpg","w":500,"h":357,"by":"Unknown author","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Haggis_Mo.jpg"}},"ingredient/jeon":{"t":"ingredient","r":"ingredient/jeon","n":"Jeon","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Jeon is a fritter in Korean cuisine made by seasoning whole, sliced, or minced fish, meat, vegetables, and other ingredients, and coating them with wheat flour and egg wash before frying them in oil. Jeon can be served as an appetizer, a banchan (side dish), or an anju (food served and eaten with drinks). Some jeons are sweet desserts; one such variety is called hwajeon (literally \"flower jeon\")."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-jeon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Jeon_(food)"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Korean cuisine","cuisine/korean-cuisine",[["Hwajeon","dish/hwajeon"]]]]},{"h":"Often cooked with","links":[["Edible flower","ingredient/edible-flower"],["Glutinous rice","ingredient/glutinous-rice"],["Honey","ingredient/honey"],["Japonica rice","ingredient/japonica-rice"],["Rice flour","ingredient/rice-flour"]]}],"img":{"src":"/world-cuisine/img/thumb/8/8b/Dongtae-jeon_and_donggeurang-ttaeng.jpg/500px-Dongtae-jeon_and_donggeurang-ttaeng.jpg","w":500,"h":281,"by":"행복한 초록개구리","lic":"CC BY 4.0","licUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:Dongtae-jeon_and_donggeurang-ttaeng.jpg"}},"dish/kkulppang":{"t":"dish","r":"dish/kkulppang","n":"Kkulppang","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from South Korean cuisine","dot":"#f0b340","intro":[["Kkulppang, also known as honey bread, is a South Korean dish. It is a sticky, sweet bread filled with sweetened red bean paste. Softer, fluffier ones that are made in Tongyeong, South Gyeongsang Province in South Korea, are called Tongyeong-kkulppang, being a local specialty. In an adjacent city called Jinju, crunchier Jinju-kkulppang is sold as a local specialty. Shortly after the Korean War, many bakeries in Tongyeong were sold. Fishermen and shipbuilding workers who worked on the beach simply ate a meal or snack because they could be kept for a long time despite the warm climate of Tongyeong."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kkulppang"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kkulppang"}],"sections":[{"h":"Where it's from","links":[["South Korean cuisine","cuisine/south-korean-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Red bean paste","ingredient/red-bean-paste"],["Syrup","ingredient/syrup"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Korean Bapsang","color":"#55b8ad","shape":"site","sub":"koreanbapsang.com","note":"Home-style Korean recipes from Hyosun, a Korean-American mom.","url":"https://www.koreanbapsang.com/category/recipes/","suggested":true,"kind":"blog"}]},{"h":"More from South Korean cuisine","links":[["Chalbori-ppang","dish/chalbori-ppang"],["Chimaek","dish/chimaek"],["Croffle","dish/croffle"],["Dak-galbi","dish/dak-galbi"],["Gilgeori toast","dish/gilgeori-toast"],["Hodu-gwaja","dish/hodu-gwaja"],["Hwangnam-ppang","dish/hwangnam-ppang"],["Jinju bibimbap","dish/jinju-bibimbap"],["Jjolmyeon","dish/jjolmyeon"],["Milmyeon","dish/milmyeon"],["Rabokki","dish/rabokki"],["So-tteok-so-tteok","dish/so-tteok-so-tteok"],["Tornado potato","dish/tornado-potato"],["Ttongppang","dish/ttongppang"],["Yangnyeom chicken","dish/yangnyeom-chicken"]]}],"img":{"src":"/world-cuisine/img/thumb/6/68/%ED%86%B5%EC%98%81%EA%BF%80%EB%B9%B5-%281%29.jpg/500px-%ED%86%B5%EC%98%81%EA%BF%80%EB%B9%B5-%281%29.jpg","w":500,"h":409,"by":"Jocelyndurrey","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%ED%86%B5%EC%98%81%EA%BF%80%EB%B9%B5-(1).jpg"}},"ingredient/peppermint":{"t":"ingredient","r":"ingredient/peppermint","n":"Peppermint","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Peppermint (Mentha × piperita) is a hybrid species of mint, a cross between watermint and spearmint. Indigenous to Europe and the Middle East, the plant is now widely spread and cultivated in many regions of the world. It is occasionally found in the wild with its parent species."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-peppermint"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Peppermint"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["American cuisine","cuisine/american-cuisine",[["Peppermint bark","dish/peppermint-bark"]]]]},{"h":"Often cooked with","links":[["Candy cane","ingredient/candy-cane"],["Caramel","ingredient/caramel"],["Dark chocolate","ingredient/dark-chocolate"],["White chocolate","ingredient/white-chocolate"]]}],"img":{"src":"/world-cuisine/img/thumb/7/72/Pfefferminze_natur_peppermint.jpg/500px-Pfefferminze_natur_peppermint.jpg","w":500,"h":375,"by":"Unknown author","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Pfefferminze_natur_peppermint.jpg"}},"dish/pork-tenderloin-sandwich":{"t":"dish","r":"dish/pork-tenderloin-sandwich","n":"Pork tenderloin sandwich","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Midwestern American cuisine","dot":"#94bd5c","intro":[["The pork tenderloin sandwich, also known as a breaded pork tenderloin sandwich (BPT), contains a breaded and fried cutlet similar to Wiener schnitzel and is popular in the Midwest region of the United States, especially in the states of Indiana, Illinois, Nebraska, Missouri, and Iowa. The sandwich is claimed to have originated at Nick's Kitchen restaurant in Huntington, Indiana, near Fort Wayne."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pork-tenderloin-sandwich"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pork_tenderloin_sandwich"}],"sections":[{"h":"Where it's from","links":[["Midwestern American cuisine","cuisine/cuisine-of-the-midwestern-united-states"]]},{"h":"Ingredients","count":1,"links":[["Breaded cutlet","ingredient/breaded-cutlet"]]},{"h":"More from Midwestern American cuisine","links":[["Chicago-style relish","dish/chicago-style-relish"]]}],"img":{"src":"/world-cuisine/img/thumb/a/ac/Pork_tenderloin_sandwich.JPG/500px-Pork_tenderloin_sandwich.JPG","w":500,"h":375,"by":"Glane23","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Pork_tenderloin_sandwich.JPG"}},"dish/quesadilla":{"t":"dish","r":"dish/quesadilla","n":"Quesadilla","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Mexican cuisine","dot":"#94bd5c","intro":[["A quesadilla is a Mexican dish made from a tortilla folded in half or two tortillas that are filled with cheese (queso), and sometimes meats, spices, and other fillings, and then cooked on a griddle or stove. Quesadillas are frequently sold at Mexican restaurants all over the world."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-quesadilla"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Quesadilla"}],"sections":[{"h":"Where it's from","links":[["Mexican cuisine","cuisine/mexican-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Cheese","ingredient/cheese"],["Flour tortilla","ingredient/flour-tortilla"],["Onion","ingredient/onion"],["Salsa (sauce)","ingredient/salsa-sauce"],["Tortilla","ingredient/tortilla"]]},{"h":"Cook it","rows":[{"name":"Mexico in My Kitchen","color":"#55b8ad","shape":"site","sub":"mexicoinmykitchen.com","note":"Mely Martínez's long-running blog of Mexican home-style recipes.","url":"https://www.mexicoinmykitchen.com/","suggested":true,"kind":"blog"},{"name":"Pati Jinich","color":"#55b8ad","shape":"site","sub":"patijinich.com","note":"Recipe archive from the Mexican-born chef and host of the PBS series Pati's Mexican Table.","url":"https://patijinich.com/recipes/","suggested":true,"kind":"site"}]},{"h":"More from Mexican cuisine","links":[["Chile con queso","dish/chile-con-queso"],["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Concha","dish/concha"],["Discada","dish/discada"],["El Adobe de Capistrano","dish/el-adobe-de-capistrano"],["Guacamole","dish/guacamole"],["Huevos rancheros","dish/huevos-rancheros"],["List of Mexican restaurants","dish/list-of-mexican-restaurants"],["Mexican juice bar","dish/mexican-juice-bar"],["Mexican restaurant","dish/mexican-restaurant"],["Nachos","dish/nachos"],["Pico de gallo","dish/pico-de-gallo"],["Pozole","dish/pozole"],["Quesabirria","dish/quesabirria"],["Real Mex Restaurants","dish/real-mex-restaurants"],["Relleno negro","dish/relleno-negro"],["Sopa de lima","dish/sopa-de-lima"],["Taco","dish/taco"],["Taquería","dish/taqueria"],["Tortilla soup","dish/tortilla-soup"],["Walnut soup","dish/walnut-soup"]]}],"img":{"src":"/world-cuisine/img/thumb/8/8c/Quesadilles_de_Blanes_amb_salses.jpg/500px-Quesadilles_de_Blanes_amb_salses.jpg","w":500,"h":225,"by":"Brunnaiz","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Quesadilles_de_Blanes_amb_salses.jpg"}},"ingredient/hungarian-sausages":{"t":"ingredient","r":"ingredient/hungarian-sausages","n":"Hungarian sausages","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Hungarian sausages are sausages found in the cuisine of Hungary. Hungary produces a vast number of sausage types. They may be boiled, fresh or dried, and smoked, with different spices and flavors, hot or mild. Hungarian cuisine uses different types of sausages in many ways such as in dishes, for example, in stews like paprikás krumpli or in soups such as bean goulash."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-hungarian-sausages"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hungarian_sausages"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Hungarian cuisine","cuisine/hungarian-cuisine",[["Rakott krumpli","dish/rakott-krumpli"]]],["Ukrainian cuisine","cuisine/ukrainian-cuisine",[["Rakott krumpli","dish/rakott-krumpli"]]]]},{"h":"Often cooked with","links":[["Egg","ingredient/egg"],["Potato","ingredient/potato"],["Salo","ingredient/salo"],["Sour cream","ingredient/sour-cream"]]}],"img":{"src":"/world-cuisine/img/thumb/b/b9/Gyulai_kolbasz.jpg/500px-Gyulai_kolbasz.jpg","w":500,"h":375,"by":"Hu Totya","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Gyulai_kolbasz.jpg"}},"dish/reuben-sandwich":{"t":"dish","r":"dish/reuben-sandwich","n":"Reuben sandwich","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#94bd5c","intro":[["The Reuben sandwich is an American grilled sandwich comprising corned beef, Swiss cheese, sauerkraut, and Russian dressing or Thousand Island dressing, grilled between slices of rye bread. The sandwich is traditionally grilled or toasted until the bread is crisp and the cheese has melted."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-reuben-sandwich"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Reuben_sandwich"}],"sect