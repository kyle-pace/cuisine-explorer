atini","dish/rollatini"]]],["Maltese cuisine","cuisine/maltese-cuisine",[["Pastizz","dish/pastizz"]]],["Neapolitan cuisine","cuisine/neapolitan-cuisine",[["Pastiera","dish/pastiera"]]]]},{"h":"Often cooked with","links":[["Eggplant","ingredient/eggplant"],["Candied peel","ingredient/candied-peel"],["Ceramic glaze","ingredient/ceramic-glaze"],["Fruit juice","ingredient/fruit-juice"],["Icing","ingredient/icing"],["Liqueur","ingredient/liqueur"],["Marzipan","ingredient/marzipan"],["Sponge cake","ingredient/sponge-cake"],["Succade","ingredient/succade"],["Sugar","ingredient/sugar"],["Custard","ingredient/custard"],["Jam","ingredient/jam"],["Nutella","ingredient/nutella"],["Shortcrust pastry","ingredient/shortcrust-pastry"],["Basil","ingredient/basil"],["Garlic","ingredient/garlic"]]}]},"dish/chuy-s":{"t":"dish","r":"dish/chuy-s","n":"Chuy's","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Tex-Mex cuisine","dot":"#94bd5c","intro":[["Chuy's Opco, Inc. is an American Tex-Mex restaurant chain founded in 1982 in Austin, Texas, by Mike Young and John Zapp.  As of July 2024, Chuy's had 101 restaurants across 15 states in Arkansas, Louisiana, Colorado, Texas, Virginia, Florida, Ohio, Indiana, Tennessee, Georgia, Alabama, Kentucky, Oklahoma, North Carolina, and South Carolina."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-chuy-s"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chuy's"}],"sections":[{"h":"Where it's from","links":[["Tex-Mex cuisine","cuisine/tex-mex-cuisine"]]},{"h":"Cook it","rows":[{"name":"Homesick Texan","ref":"site/homesicktexan-com","color":"#55b8ad","shape":"site","sub":"homesicktexan.com","note":"Lisa Fain's long-running blog of Texan and Tex-Mex home cooking.","url":"https://www.homesicktexan.com/homesick-texan-cookbook-introduction/comment-page-20/","suggested":true}]},{"h":"More from Tex-Mex cuisine","links":[["Baja Fresh","dish/baja-fresh"],["Chapultepec Lupita","dish/chapultepec-lupita"],["Chile con queso","dish/chile-con-queso"],["Chili con carne","dish/chili-con-carne"],["Chipotle Mexican Grill","dish/chipotle-mexican-grill"],["Esparza's","dish/esparza-s"],["Guacamole","dish/guacamole"],["La Bamba Mexican Restaurant","dish/la-bamba-mexican-restaurant"],["Pancho Villa (restaurant)","dish/pancho-villa-restaurant"],["Salsarita's Fresh Mexican Grill","dish/salsarita-s-fresh-mexican-grill"],["The Goose (restaurant)","dish/the-goose-restaurant"],["Tia's Tex-Mex","dish/tia-s-tex-mex"],["Tortilla Coast","dish/tortilla-coast"]]}]},"dish/coniglio-alla-sanremese":{"t":"dish","r":"dish/coniglio-alla-sanremese","n":"Coniglio alla sanremese","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Ligurian cuisine","dot":"#cf5f87","intro":[["Coniglio alla sanremese is an Italian recipe based on rabbit, cooked and served with a sauce enriched with olives, walnuts and herbs. It is a traditional dish of Ligurian cuisine, originating in the town of Sanremo; variations of the recipe, under the name coniglio alla ligure, are spread all over Liguria."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-coniglio-alla-sanremese"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Coniglio_alla_sanremese"}],"sections":[{"h":"Where it's from","links":[["Ligurian cuisine","cuisine/cuisine-of-liguria"]]},{"h":"Ingredients","count":1,"links":[["Rabbit meat","ingredient/rabbit-meat"]]},{"h":"Cook it","rows":[{"name":"A Small Kitchen in Genoa","ref":"site/asmallkitcheningenoa-com","color":"#55b8ad","shape":"site","sub":"asmallkitcheningenoa.com","note":"Genoese cook Enrica Monzani's English-language blog of Ligurian recipes.","url":"https://asmallkitcheningenoa.com/about","suggested":true}]},{"h":"More from Ligurian cuisine","links":[["Baxin","dish/baxin"]]}]},"dish/giardiniera":{"t":"dish","r":"dish/giardiniera","n":"Giardiniera","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["Giardiniera is an Italian relish of pickled vegetables in vi