JPG/500px-Salumi_e_vino_lucchese.JPG","w":500,"h":408,"by":"OneArmedMan","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Salumi_e_vino_lucchese.JPG"}},"dish/sauerkraut":{"t":"dish","r":"dish/sauerkraut","n":"Sauerkraut","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 7 cuisines","dot":"#cf5f87","intro":[["Sauerkraut is finely cut raw white cabbage that has been fermented by various lactic acid bacteria. It has a long shelf life and a distinctive sour flavor, both of which result from the lactic acid formed when the bacteria ferment the carbohydrates in the cabbage leaves."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-sauerkraut"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sauerkraut"}],"sections":[{"h":"Where it's from","links":[["Bulgarian cuisine","cuisine/bulgarian-cuisine"],["Czech cuisine","cuisine/czech-cuisine"],["German cuisine","cuisine/german-cuisine"],["Thuringian cuisine","cuisine/german-cuisine-thuringia"],["Polish cuisine","cuisine/polish-cuisine"],["Russian cuisine","cuisine/russian-cuisine"],["Ukrainian cuisine","cuisine/ukrainian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Cabbage","ingredient/cabbage"],["DL-lactic acid","ingredient/dl-lactic-acid"]]},{"h":"Cook it","rows":[{"name":"Cook Like Czechs","color":"#55b8ad","shape":"site","sub":"cooklikeczechs.com","note":"English-language blog of traditional Czech home recipes by a Czech cook.","url":"https://cooklikeczechs.com/about/","suggested":true,"kind":"blog"},{"name":"Quick German Recipes","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Long-running site by German-born cook Gerhild Fulson (Oma) with traditional German home recipes.","url":"https://www.quick-german-recipes.com/about-me.html","suggested":true,"kind":"blog"},{"name":"Dirndl Kitchen","color":"#55b8ad","shape":"site","sub":"dirndlkitchen.com","note":"Blog of German and Bavarian recipes, from main dishes to holiday baking.","url":"https://dirndlkitchen.com","suggested":true,"kind":"blog"},{"name":"Quick German Recipes","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Thuringia page on German-born cook Gerhild Fulson's long-running German recipe site.","url":"https://www.quick-german-recipes.com/thuringia.html","suggested":true,"kind":"blog"}]},{"h":"More from Bulgarian cuisine","links":[["Banitsa","dish/banitsa"],["Cabbage roll","dish/cabbage-roll"],["Garash cake","dish/garash-cake"],["İmam bayıldı","dish/imam-bay-ld"],["Kolach (bread)","dish/kolach-bread"],["Kyopolou","dish/kyopolou"],["Lyutenitsa","dish/lyutenitsa"],["Patatnik","dish/patatnik"],["Pindjur","dish/pindjur"],["Stuffed peppers","dish/stuffed-peppers"],["Tarator","dish/tarator"]]}],"img":{"src":"/world-cuisine/img/thumb/5/5e/Fourchette_avec_choucroute.jpg/500px-Fourchette_avec_choucroute.jpg","w":500,"h":381,"by":"Annakareninerussie","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Fourchette_avec_choucroute.jpg"}},"dish/sur-komi-beverage":{"t":"dish","r":"dish/sur-komi-beverage","n":"Sur (Komi beverage)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Komi cuisine","dot":"#f0b340","intro":[["Sur is an alcoholic beverage similar to beer made by Komi people. From a technical standpoint, it is a weak top-fermented ale similar to Finnish sahti and raw ales that do not undergo wort boiling."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-sur-komi-beverage"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sur_(Komi_beverage)"}],"sections":[{"h":"Where it's from","links":[["Komi cuisine","cuisine/komi-cuisine"]]}]}}