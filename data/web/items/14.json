"],["Potato","ingredient/potato"],["Rice","ingredient/rice"],["Shallots","ingredient/shallots"],["Sweet potato","ingredient/sweet-potato"],["The Borneo Post","ingredient/the-borneo-post"],["Turmeric","ingredient/turmeric"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true,"kind":"blog"}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"],["Gepuk","dish/gepuk"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/4d/Bubur_100618-4100_sbs.jpg/500px-Bubur_100618-4100_sbs.jpg","w":500,"h":377,"by":"Wibowo Djatmiko (Wie146)","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Bubur_100618-4100_sbs.jpg"}},"dish/clotted-cream":{"t":"dish","r":"dish/clotted-cream","n":"Clotted cream","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from English cuisine","dot":"#cf5f87","intro":[["Clotted cream is a thick cream made by heating full-cream cow's milk using steam or a water bath and then leaving it in shallow pans to cool slowly. During this time, the cream content rises to the surface and forms \"clots\" or \"clouts\", hence the name. Clotted cream is an essential ingredient for cream tea."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-clotted-cream"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Clotted_cream"}],"sections":[{"h":"Where it's from","links":[["English cuisine","cuisine/english-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Milk","ingredient/milk"]]},{"h":"More from English cuisine","links":[["Angels on horseback","dish/angels-on-horseback"],["Cabinet pudding","dish/cabinet-pudding"],["Crème anglaise","dish/creme-anglaise"],["Fish and chips","dish/fish-and-chips"],["Macaroni and cheese","dish/macaroni-and-cheese"],["Maids of honour tart","dish/maids-of-honour-tart"],["Manchester tart","dish/manchester-tart"],["Mock turtle soup","dish/mock-turtle-soup"],["Pie and mash","dish/pie-and-mash"],["Pork pie","dish/pork-pie"],["Pottage","dish/pottage"],["Windsor soup","dish/windsor-soup"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/bf/Clotted_cream_%28cropped%29.JPG/500px-Clotted_cream_%28cropped%29.JPG","w":500,"h":386,"by":"Biggishben","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Clotted_cream_(cropped).JPG"}},"ingredient/goat-milk":{"t":"ingredient","r":"ingredient/goat-milk","n":"Goat milk","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 6 cuisines","intro":[["Goat milk is the milk of domestic goats. Goats produce about 2% of the world's total annual milk supply. Some goats are bred specifically for milk. Goat milk naturally has small, well-emulsified fat globules, which means the cream remains in suspension for a longer period of time than cow's milk; therefore, it does not need to be homogenized. Eventually, the cream rises to the top over a period of a few days. If the milk is to be used to make cheese, homogenization is not recommended as this changes the structure of the milk, affecting the culture's ability to coagulate the milk as well as the final quality and yield of the cheese."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-goat-milk"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Goat_milk"}],"sections":[{"h":"Where it's cooked with","count":6,"groups":[["Andorran cuisine","cuisine/andorran-cuisine",[["Mató","dish/mato"]]],["Catalan cuisine","cuisine/catalan-cuisine",[["Mató","dish/mato"]]],["Lebanese cuisine","cuisine/lebanese-cuisine",[["Jibneh Arabieh","dish/jibneh-arabieh"]]],["Levantine cuisine","cuisine/levantine-cuisine",[["Jibneh Arabieh","dish/jibneh-arabieh"]]],["Palestinian cuisine","cuisine/palestinian-cuisine",[["Jibneh Arabieh","dish/jibneh-arabieh"]]],["Syrian cuisine","cuisine/syrian-cuisine",[["Jibneh Arabieh","dish/jibneh-arabieh"]]]]},{"h":"Where it's grown","grown":{"what":"Raw milk of goats","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":20059755,"top":[["India","cuisine/indian-cuisine",7121101],["Sudan","cuisine/sudanese-cuisine",1138904],["Pakistan","cuisine/pakistani-cuisine",1018800],["Bangladesh","cuisine/bangladeshi-cuisine",907914],["France","cuisine/french-cuisine",716440],["Turkey","cuisine/turkish-cuisine",555627],["S. Sudan","cuisine/south-sudanese-cuisine",507705],["Spain","cuisine/spanish-cuisine",493126],["Netherlands","cuisine/dutch-cuisine",426240],["Niger","cuisine/cuisine-of-niger",419121],["Somalia","cuisine/somali-cuisine",377355],["Indonesia","cuisine/indonesian-cuisine",359865],["Greece","cuisine/greek-cuisine",352994],["Iran","cuisine/iranian-cuisine",326763],["Algeria","cuisine/algerian-cuisine",323191]]}},{"h":"Often cooked with","links":[["Milk","ingredient/milk"],["Sheep milk","ingredient/sheep-milk"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a0/Liqueur_from_goat_milk%2C_Fuerteventura.JPG/500px-Liqueur_from_goat_milk%2C_Fuerteventura.JPG","w":500,"h":498,"by":"MOs810","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Liqueur_from_goat_milk%2C_Fuerteventura.JPG"}},"ingredient/kecap-manis":{"t":"ingredient","r":"ingredient/kecap-manis","n":"Kecap manis","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Sweet soy sauce is a sweetened aromatic soy sauce, originating in Indonesia, which has a darker color, a viscous syrupy consistency, and a molasses-like flavor due to the generous addition of palm sugar or jaggery. Kecap manis is widely used with satay. It is similar to, though finer in flavor than, Chinese Tianmian sauce (tianmianjiang). It is by far the most commonly employed type of soy sauce in Indonesian cuisine and accounts for an estimated 90 percent of the nation's total soy sauce production."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-kecap-manis"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kecap_manis"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Ketoprak (dish)","dish/ketoprak-dish"]]]]},{"h":"Often cooked with","links":[["Bean sprouts","ingredient/bean-sprouts"],["Cucumber","ingredient/cucumber"],["Ketupat","ingredient/ketupat"],["Krupuk","ingredient/krupuk"],["Lontong","ingredient/lontong"],["Mung bean sprout","ingredient/mung-bean-sprout"],["Peanut sauce","ingredient/peanut-sauce"],["Rice cake","ingredient/rice-ca