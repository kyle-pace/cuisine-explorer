ish/avgolemono"],["Baba ghanoush","dish/baba-ghanoush"],["Bouyiourdi","dish/bouyiourdi"],["Cabbage roll","dish/cabbage-roll"],["Diples","dish/diples"],["Fasolada","dish/fasolada"],["Freddo cappuccino","dish/freddo-cappuccino"],["Greek restaurant","dish/greek-restaurant"],["Greek salad","dish/greek-salad"],["İmam bayıldı","dish/imam-bay-ld"],["Kakavia (soup)","dish/kakavia-soup"],["Kalitsounia","dish/kalitsounia"],["Keşkek","dish/keskek"],["Ladera","dish/ladera"],["Noumboulo","dish/noumboulo"],["Psarosoupa","dish/psarosoupa"],["Spanakorizo","dish/spanakorizo"],["Taramasalata","dish/taramasalata"],["Tzatziki","dish/tzatziki"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a8/%CE%A0%CE%B1%CF%81%CE%B1%CE%B4%CE%BF%CF%83%CE%B9%CE%B1%CE%BA%CF%8C_%CE%B3%CE%BB%CF%85%CE%BA%CF%8C_%CE%BC%CE%B5_%CE%BA%CE%B1%CF%81%CF%85%CE%B4%CF%8C%CF%88%CE%B9%CF%87%CE%B1.JPG/500px-%CE%A0%CE%B1%CF%81%CE%B1%CE%B4%CE%BF%CF%83%CE%B9%CE%B1%CE%BA%CF%8C_%CE%B3%CE%BB%CF%85%CE%BA%CF%8C_%CE%BC%CE%B5_%CE%BA%CE%B1%CF%81%CF%85%CE%B4%CF%8C%CF%88%CE%B9%CF%87%CE%B1.JPG","w":500,"h":414,"by":"EFSTA","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%CE%A0%CE%B1%CF%81%CE%B1%CE%B4%CE%BF%CF%83%CE%B9%CE%B1%CE%BA%CF%8C_%CE%B3%CE%BB%CF%85%CE%BA%CF%8C_%CE%BC%CE%B5_%CE%BA%CE%B1%CF%81%CF%85%CE%B4%CF%8C%CF%88%CE%B9%CF%87%CE%B1.JPG"}},"ingredient/zapallo":{"t":"ingredient","r":"ingredient/zapallo","n":"Zapallo","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 3 cuisines","intro":[["Calabaza is the generic name in the Spanish language for any type of winter squash. Within an English-language context it specifically refers to the West Indian pumpkin, a winter squash typically grown in the West Indies, tropical America, and the Philippines. Calabaza is the common name for Cucurbita moschata in Cuba, Florida, Puerto Rico, Mexico and the Philippines (where it is also spelled kalabasa). C. moschata is also known as ahuyama in Colombia, the Dominican Republic and Venezuela; ayote in Central America; zapallo in certain countries of South America; and \"pumpkin\", \"squash\", or \"calabash\" in English-speaking islands."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-zapallo"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Zapallo"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Bolivian cuisine","cuisine/bolivian-cuisine",[["Locro","dish/locro"]]],["Ecuadorian cuisine","cuisine/ecuadorian-cuisine",[["Locro","dish/locro"]]],["Peruvian cuisine","cuisine/peruvian-cuisine",[["Locro","dish/locro"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Beef jerky","ingredient/beef-jerky"],["Cayenne pepper","ingredient/cayenne-pepper"],["Chorizo","ingredient/chorizo"],["Hot sauce","ingredient/hot-sauce"],["Maize","ingredient/maize"],["Paprika","ingredient/paprika"],["Potato","ingredient/potato"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/4e/Kalabasa_%28Calabaza%29_squash_from_the_Philippines.jpg/500px-Kalabasa_%28Calabaza%29_squash_from_the_Philippines.jpg","w":500,"h":367,"by":"Obsidian Soul","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Kalabasa_(Calabaza)_squash_from_the_Philippines.jpg"}},"ingredient/cheddar-cheese":{"t":"ingredient","r":"ingredient/cheddar-cheese","n":"Cheddar cheese","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 3 cuisines","intro":[["Cheddar cheese (or simply cheddar) is a natural cheese that is relatively hard, off-white (or orange if colourings such as annatto are added), and sometimes sharp-tasting. It originates from the village of Cheddar in Somerset, South West England."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-cheddar-cheese"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cheddar_cheese"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["American cuisine","cuisine/american-cuisine",[["Macaroni and cheese","dish/macaroni-and-cheese"]]],["Canadian cuisine","cuisine/canadian-cuisine",[["Macaroni and cheese","dish/macaroni-and-cheese"]]],["English cuisine","cuisine/english-cuisine",[["Macaroni and cheese","dish/macaroni-and-cheese"]]]]},{"h":"Often cooked with","links":[["Butter","ingredient/butter"],["Cheddar sauce","ingredient/cheddar-sauce"],["Cheese","ingredient/cheese"],["Macaroni","ingredient/macaroni"],["Milk","ingredient/milk"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/18/Somerset-Cheddar.jpg/500px-Somerset-Cheddar.jpg","w":500,"h":357,"by":"I, J.P.Lon","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Somerset-Cheddar.jpg"}},"dish/morningstar-farms":{"t":"dish","r":"dish/morningstar-farms","n":"Morningstar Farms","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Vegetarian cuisine","dot":"#a99fb5","intro":[["Morningstar Farms (stylized as MorningStar Farms) is a division of Kellanova that produces vegan and vegetarian food. Many of their offerings are plant-based variations of traditionally meat products. Their products include meatless chicken nuggets, popcorn chicken, corn dogs, breakfast sausage, burgers, hot dogs, bacon, and pizza rolls with vegan cheese. Originally, Morningstar offered some, but not all vegan products. In 2019, Morningstar Farms announced all products would be vegan by 2021, but had not yet done so as of May 2024."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-morningstar-farms"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Morningstar_Farms"}],"sections":[{"h":"Where it's from","links":[["Vegetarian cuisine","cuisine/vegetarian-cuisine"]]},{"h":"More from Vegetarian cuisine","links":[["Plant-based food","dish/plant-based-food"],["Vegetarianism","dish/vegetarianism"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/43/Veggie_burger_SuziJane_flickr_creative_commons.jpg/500px-Veggie_burger_SuziJane_flickr_creative_commons.jpg","w":500,"h":382,"by":"SuziJane","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Veggie_burger_SuziJane_flickr_creative_commons.jpg"}},"dish/nachos":{"t":"dish","r":"dish/nachos","n":"Nachos","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Mexican cuisine","dot":"#94bd5c","intro":[["Nachos are a Tex-Mex dish consisting of  tortilla chips or totopos covered with cheese or chile con queso, as well as a variety of other toppings and garnishes, often including meats (such as ground beef or grilled chicken), vegetables (such as chili peppers, lettuce, tomatoes, and olives), and condiments such as salsa, guacamole, or sour cream. At its most basic form, nachos may consist of merely chips covered with melted cheese (usually cheddar or American cheese), or cheese sauce and served as an appetizer or snack, while other versions are substantial enough to serve as a main course.  The dish was created by, and named after, Mexican restaurateur Ignacio \"Nacho\" Anaya, who created it in 1943 for American customers at the Victory Club restaurant in Piedras Negras, Coahuila."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-nachos"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Nachos"}],"sections":[{"h":"Where it's from","links":[["Mexican cuisine","cuisine/mexican-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Cheese","ingredient/cheese"],["Cheese sauce","ingredient/cheese-sauce"],["Tortilla chip","ingredient/tortilla-chip"],["Tortilla chips","ingredient/tortilla-chips"]]},{"h":"Cook it","rows":[{"name":"Mexico in My Kitchen","color":"#55b8ad","shape":"site","sub":"mexicoinmykitchen.com","note":"Mely Martínez's long-running blog of Mexican home-style recipes.","url":"https://www.mexicoinmykitchen.com/","suggested":true,"kind":"blog"},{"name":"Pati Jinich","color":"#55b8ad","shape":"site","sub":"patijinich.com","note":"Recipe archive from the Mexican-born chef and host of the PBS series Pati's Mexican Table.","url":"https://patijinich.com/recipes/","suggested":true,"kind":"site"}]},{"h":"More from Mexican cuisine","links":[["Chile con queso","dish/chile-con-queso"],["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Concha","dish/concha"],["Discada","dish/discada"],["El Adobe de Capistrano","dish/el-adobe-de-capistrano"],["Guacamole","dish/guacamole"],["Huevos rancheros","dish/huevos-rancheros"],["List of Mexican restaurants","dish/list-of-mexican-restaurants"],["Mexican juice bar","dish/mexican-juice-bar"],["Mexican restaurant","dish/mexican-restaurant"],["Pico de gallo","dish/pico-de-gallo"],["Pozole","dish/pozole"],["Quesabirria","dish/quesabirria"],["Quesadilla","dish/quesadilla"],["Real Mex Restaurants","dish/real-mex-restaurants"],["Relleno negro","dish/relleno-negro"],["Sopa de lima","dish/sopa-de-lima"],["Taco","dish/taco"],["Taquería","dish/taqueria"],["Tortilla soup","dish/tortilla-soup"],["Walnut soup","dish/walnut-soup"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/79/The_Beanery_Nachos.jpg/500px-The_Beanery_Nachos.jpg","w":500,"h":299,"by":"Navajcmer","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:The_Beanery_Nachos.jpg"}},"ingredient/candy-cane":{"t":"ingredient","r":"ingredient/candy-cane","n":"Candy cane","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A candy cane is a cane-shaped stick candy often associated with Christmastide as well as Saint Nicholas Day. The canes are typically white with red stripes and flavoured with peppermint, but the canes also come in a variety of other flavours and colours."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-candy-cane"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Candy_cane"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["American cuisine","cuisine/american-cuisine",[["Peppermint bark","dish/peppermint-bark"]]]]},{"h":"Often cooked with","links":[["Caramel","ingredient/caramel"],["Dark chocolate","ingredient/dark-chocolate"],["Peppermint","ingredient/peppermint"],["White chocolate","ingredient/white-chocolate"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/de/Candy-Cane-Classic.jpg/500px-Candy-Cane-Classic.jpg","w":500,"h":823,"by":"Evan-Amos","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Candy-Cane-Classic.jpg"}},"dish/soldaditos-de-pavia":{"t":"dish","r":"dish/soldaditos-de-pavia","n":"Soldaditos de Pavía","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Spanish cuisine","dot":"#cf5f87","intro":[["Soldaditos de Pavía (lit. “little soldiers of Pavia”) is a dish  of fried cod wrapped in a slice of roasted red pepper. The dish is found in Andalusian cuisine and common at tapas bars in Madrid, capital of Spain. The cod is marinated in a paprika and lemon juice mix. Before being fried, the pieces of cod can be placed in cold seasoned water and removed when the water begins to boil. It's said to be a popular dish after Easter in the 1905 cookbook by Manuel Maria Puga y Parga."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-soldaditos-de-pavia"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Soldaditos_de_Pav%C3%ADa"}],"sections":[{"h":"Where it's from","links":[["Spanish cuisine","cuisine/spanish-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Bacalhau","ingredient/bacalhau"],["Chili pepper","ingredient/chili-pepper"]]},{"h":"Cook it","rows":[{"name":"Spain on a Fork","color":"#55b8ad","shape":"site","sub":"spainonafork.com","note":"Albert Bevia's video channel and site of traditional and everyday Spanish recipes.","url":"https://spainonafork.com/welcome2/","suggested":true,"kind":"youtube"}]},{"h":"More from Spanish cuisine","links":[["Andrajos","dish/andrajos"],["Bolinhos de bacalhau","dish/bolinhos-de-bacalhau"],["Buñuelo","dish/bunuelo"],["Caldo galego","dish/caldo-galego"],["Chistorra","dish/chistorra"],["Churro","dish/churro"],["Cocido","dish/cocido"],["Cuajada","dish/cuajada"],["Embutido","dish/embutido"],["Gazpacho","dish/gazpacho"],["Hojuela","dish/hojuela"],["Jamón","dish/jamon"],["Migas","dish/migas"],["Mojo (sauce)","dish/mojo-sauce"],["Patatas a lo pobre","dish/patatas-a-lo-pobre"],["Patatas bravas","dish/patatas-bravas"],["Picatostes","dish/picatostes"],["Pincho","dish/pincho"],["Pottage","dish/pottage"],["Salchichón","dish/salchichon"],["Salmorejo","dish/salmorejo"],["Sobrassada","dish/sobrassada"],["Sopa de gato","dish/sopa-de-gato"],["Spanish omelette","dish/spanish-omelette"],["Spanish restaurant","dish/spanish-restaurant"],["Stuffed peppers","dish/stuffed-peppers"],["Tapas","dish/tapas"],["Turrón","dish/turron"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/09/Soldaditos_de_Pavia-Bacalao.jpg/500px-Soldaditos_de_Pavia-Bacalao.jpg","w":500,"h":333,"by":"Tamorlan","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Soldaditos_de_Pavia-Bacalao.jpg"}},"ingredient/nigella-seeds":{"t":"ingredient","r":"ingredient/nigella-seeds","n":"Nigella seeds","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Nigella sativa (common names, black caraway, black cumin, nigella, charnushka, or kalonji) is an annual flowering plant in the family Ranunculaceae, native to western Asia (the Levant, Cyprus, Turkey, Iran and Iraq), and eastern Europe (Bulgaria and Romania). It is used as a spice in various food preparations."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-nigella-seeds"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Nigella_seeds"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Israeli cuisine","cuisine/israeli-cuisine",[["Ziva (dish)","dish/ziva-dish"]]]]},{"h":"Often cooked with","links":[["Cheese","ingredient/cheese"],["Laminated dough","ingredient/laminated-dough"],["Olive","ingredient/olive"],["Puff pastry","ingredient/puff-pastry"],["Sesame seeds","ingredient/sesame-seeds"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/53/Nsativa001Wien.jpg/500px-Nsativa001Wien.jpg","w":500,"h":667,"by":"AndreHolz at English Wikipedia","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Nsativa001Wien.jpg"}},"ingredient/urfa-biber":{"t":"ingredient","r":"ingredient/urfa-biber","n":"Urfa biber","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Urfa biber (also known as isot pepper, ) is a spice prepared from landrace Capsicum annuum  in the Urfa region of Turkey. It is often described as having a smoky, raisin-like taste. Urfa biber is technically a red (chili) pepper, ripening to a dark maroon on the plant. The peppers go through a two-part process, where they are sun-dried during the day and wrapped tightly at night. The night process is called 'sweating', and works to infuse the dried flesh with the remaining moisture of the pepper. The result is an appearance ranging from deep purple to a dark, purplish black. Urfa biber is less spicy than many other chili peppers, but provides a more lasting build of heat."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-urfa-biber"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Urfa_biber"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Turkish cuisine","cuisine/turkish-cuisine",[["Çiğ köfte","dish/cig-kofte"]]]]},{"h":"Often cooked with","links":[["Bulgur","ingredient/bulgur"],["Onion","ingredient/onion"],["Red pepper paste","ingredient/red-pepper-paste"],["Tomato paste","ingredient/tomato-paste"],["Veal","ingredient/veal"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/56/Flaked_Isot_Chili.jpg/500px-Flaked_Isot_Chili.jpg","w":500,"h":346,"by":"Fornax","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Flaked_Isot_Chili.jpg"}}}