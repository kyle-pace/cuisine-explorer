{"cuisine/puerto-rican-cuisine":{"t":"cuisine","r":"cuisine/puerto-rican-cuisine","n":"Puerto Rican cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Cuisine"]],"sub":"National cuisine of Puerto Rico","intro":[["Puerto Rican cuisine consists of the cooking style and traditional dishes original to Puerto Rico. It has been primarily a fusion influenced by the ancestors of the Puerto Rican people: the indigenous Taínos, Spanish Criollos and sub-Saharan African slaves. As a territory of the United States, the culinary scene of Puerto Rico has also been moderately influenced by American cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"puerto-rican-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Puerto_Rican_cuisine"}],"sections":[{"h":"Recipe sites","count":2,"rows":[{"name":"Delish D'Lites","color":"#55b8ad","shape":"site","sub":"delishdlites.com","note":"Jannese Torres's blog of Puerto Rican and Latin recipes.","url":"https://delishdlites.com","suggested":true,"kind":"blog"},{"name":"Sense and Edibility","color":"#55b8ad","shape":"site","sub":"senseandedibility.com","note":"Food blog with a large Puerto Rican recipe category.","url":"https://senseandedibility.com/category/cuisines/puerto-rican/page/5/","suggested":true,"kind":"blog"}]},{"h":"Cookbooks","count":2,"rows":[{"name":"Diasporican: A Puerto Rican Cookbook","color":"#f0b340","shape":"book","sub":"Illyanna Maisonet, 2022","note":"Puerto Rican cooking as practiced in the diaspora, by a Sacramento-based food writer.","url":"https://openlibrary.org/isbn/9781984859761","suggested":true,"isbn":"9781984859761"},{"name":"Cocina criolla","color":"#f0b340","shape":"book","sub":"Carmen Aboy Valldejuli","note":"Long-standing reference of Puerto Rican cooking, also published in English as Puerto Rican Cookery.","url":"https://openlibrary.org/books/OL6181464M/Cocina_criolla.","suggested":true}]},{"h":"More from Puerto Rico","count":1,"links":[["Taíno heritage foodways","cuisine/taino-heritage-foodways"]]}],"cont":"Cuisine of the Americas","img":{"src":"/world-cuisine/img/9/9d/Aranitas_tostones.jpg","w":500,"h":463,"by":"Portorricensis (talk) (Uploads)","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Aranitas_tostones.jpg"}},"cuisine/leonese-cuisine":{"t":"cuisine","r":"cuisine/leonese-cuisine","n":"Leonese cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Spanish cuisine","cuisine/spanish-cuisine"]],"sub":"Regional cuisine in Spain","intro":[["Leonese cuisine is a subcategory of Spanish cuisine from the Province of León."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"leonese-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Leonese_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Spanish cuisine","cuisine/spanish-cuisine"]]},{"h":"Part of","links":[["Spanish cuisine","cuisine/spanish-cuisine"]]}],"cont":"European cuisine","img":{"src":"/world-cuisine/img/thumb/8/8c/Cocido_maragato_04_by-dpc.jpg/500px-Cocido_maragato_04_by-dpc.jpg","w":500,"h":335,"by":"David Perez","lic":"CC BY 4.0","licUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:Cocido_maragato_04_by-dpc.jpg"}},"dish/brown-betty-dessert":{"t":"dish","r":"dish/brown-betty-dessert","n":"Brown Betty (dessert)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["A Brown Betty is a traditional American dessert made from fruit, usually apple (this variant is known as Apple Betty), but also berries or pears and sweetened crumbs. Similar to a cobbler or apple crisp, the fruit is baked, and, in this case, the sweetened crumbs are placed in layers between the fruit. It is sometimes served with lemon sauce or whipped cream."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-brown-betty-dessert"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Brown_Betty_(dessert)"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"Ingredients","count":8,"links":[["Apple","ingredient/apple"],["Berry","ingredient/berry"],["Bread crumbs","ingredient/bread-crumbs"],["Breadcrumbs","ingredient/breadcrumbs"],["Butter","ingredient/butter"],["Pear","ingredient/pear"],["Sugar","ingredient/sugar"],["Zest","ingredient/zest"]]},{"h":"More from American cuisine","links":[["Angel food cake","dish/angel-food-cake"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Beer cake","dish/beer-cake"],["Better than sex cake","dish/better-than-sex-cake"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Butter cake","dish/butter-cake"],["Caesar salad","dish/caesar-salad"],["Caramel apple","dish/caramel-apple"],["Carbonara","dish/carbonara"],["Cheesesteak","dish/cheesesteak"],["Chicago-style hot dog","dish/chicago-style-hot-dog"],["Chicken nugget","dish/chicken-nugget"],["Chiffon cake","dish/chiffon-cake"],["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Chow-chow (food)","dish/chow-chow-food"],["Chowder","dish/chowder"],["Cioppino","dish/cioppino"],["Clam chowder","dish/clam-chowder"],["Clam dip","dish/clam-dip"],["Club sandwich","dish/club-sandwich"],["Cobb salad","dish/cobb-salad"],["Cobbler (food)","dish/cobbler-food"],["Cook's Corner","dish/cook-s-corner"],["Crab cake","dish/crab-cake"],["Croffle","dish/croffle"],["Dagwood Bumstead","dish/dagwood-bumstead"],["Dagwood sandwich","dish/dagwood-sandwich"],["Deep-dish pizza","dish/deep-dish-pizza"],["Desperation pie","dish/desperation-pie"],["Dirty rice","dish/dirty-rice"],["Donut hole","dish/donut-hole"],["Egg in the basket","dish/egg-in-the-basket"],["Fish and chips","dish/fish-and-chips"],["Fritter","dish/fritter"]]}],"img":{"src":"/world-cuisine/img/thumb/2/2c/Brown_Betty.jpg/500px-Brown_Betty.jpg","w":500,"h":281,"by":"KaMan","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Brown_Betty.jpg"}},"ingredient/hoagie-roll":{"t":"ingredient","r":"ingredient/hoagie-roll","n":"Hoagie roll","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["In American usage, a hoagie roll is a long, crusty-on-the-outside, soft-on-the-inside bread roll used to prepare hoagie sandwiches, particularly in the Philadelphia area. Also known as a \"sub\" or \"hero\" roll. Key characteristics include a firm exterior that holds up to fillings and a tender interior. They are the foundation for classic sandwiches with cold cuts, cheese, and oil, vinegar, and oregano. Hoagie rolls are sometimes toasted before being used to prepare a sandwich."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-hoagie-roll"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hoagie_roll"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["American cuisine","cuisine/american-cuisine",[["Cheesesteak","dish/cheesesteak"]]]]},{"h":"Often cooked with","links":[["Beefsteak","ingredient/beefsteak"],["Processed cheese","ingredient/processed-cheese"]]}],"img":{"src":"/world-cuisine/img/thumb/8/89/Fresh_hoagie_rolls_%286189590468%29.jpg/500px-Fresh_hoagie_rolls_%286189590468%29.jpg","w":500,"h":331,"by":"jeffreyw","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Fresh_hoagie_rolls_(6189590468).jpg"}},"ingredient/black-olive":{"t":"ingredient","r":"ingredient/black-olive","n":"Black olive","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The cultivated olive (botanical name Olea europaea subsp. europaea) is a subspecies of subtropical evergreen tree in the family Oleaceae. Modern cultivars are traced primarily to the Near East, Aegean Sea, and Strait of Gibraltar. Olea europaea is the type species for its genus, Olea, which lends its name to the Oleaceae plant family. The olive fruit is classed botanically as a drupe, similar in structure and function to the cherry or peach. The term oil was originally synonymous with olive oil."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-black-olive"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Black_olive"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Valencian cuisine","cuisine/valencian-cuisine",[["Esgarrat","dish/esgarrat"]]]]},{"h":"Often cooked with","links":[["Bacalhau","ingredient/bacalhau"],["Bell pepper","ingredient/bell-pepper"],["Garlic","ingredient/garlic"],["Olive oil","ingredient/olive-oil"],["Salt cod","ingredient/salt-cod"]]}]},"dish/pasta-con-le-sarde":{"t":"dish","r":"dish/pasta-con-le-sarde","n":"Pasta con le sarde","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Sicilian cuisine","dot":"#cf5f87","intro":[["Pasta con le sarde is a Sicilian pasta dish with sardines and anchovies. It is recognized as a traditional Italian food product in the prodotto agroalimentare tradizionale (PAT) scheme of the Italian government. It is most associated with the city of Palermo, but it can be found all over the island."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pasta-con-le-sarde"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pasta_con_le_sarde"}],"sections":[{"h":"Where it's from","links":[["Sicilian cuisine","cuisine/sicilian-cuisine"]]},{"h":"Ingredients","count":9,"links":[["Anchovies as food","ingredient/anchovies-as-food"],["Breadcrumbs","ingredient/breadcrumbs"],["European pilchard","ingredient/european-pilchard"],["Fennel","ingredient/fennel"],["Pasta","ingredient/pasta"],["Pine nut","ingredient/pine-nut"],["Raisin","ingredient/raisin"],["Saffron","ingredient/saffron"],["Sardines as food","ingredient/sardines-as-food"]]},{"h":"More from Sicilian cuisine","links":[["Busiate","dish/busiate"],["Cassatella di Agira","dish/cassatella-di-agira"],["Crocchè","dish/crocche"],["Iris (pastry)","dish/iris-pastry"],["Maccu","dish/maccu"],["Panella","dish/panella"],["Pani câ meusa","dish/pani-ca-meusa"],["Parmigiana","dish/parmigiana"],["Pasta alla Norma","dish/pasta-alla-norma"],["Pasta mollicata","dish/pasta-mollicata"],["Stigghiola","dish/stigghiola"]]}],"img":{"src":"/world-cuisine/img/thumb/4/45/Pasta_con_le_sarde_%28Palermo%29.jpg/500px-Pasta_con_le_sarde_%28Palermo%29.jpg","w":500,"h":375,"by":"Adriao","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Pasta_con_le_sarde_(Palermo).jpg"}},"ingredient/swamp-taro":{"t":"ingredient","r":"ingredient/swamp-taro","n":"Swamp taro","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Cyrtosperma merkusii or giant swamp taro, is a crop grown throughout Oceania and into South and Southeast Asia. It is a riverine and \"swamp crop\" similar to taro, but \"with bigger leaves and larger, coarser roots.\" There are no demonstrably wild populations today, but it is believed to be native to Indonesia. It is known as puraka in Cook Islands, lak in Yap (Federated States of Micronesia), babai in Kiribati, iaraj in the Marshall Islands, brak in Palau, babaʻ in the Marianas Islands, pula’a in Samoa, via kana, Pulaka in Lau, Lovo in Fiji, pulaka in Tokelau and Tuvalu, mwahng in Pohnpei, pasruk in Kosrae, simiden in Chuuk, swam taro in Papua New Guinea, 'kakake' in Solomon Islands, navia in Vanuatu and galyang or palawan in the Philippines."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-swamp-taro"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Swamp_taro"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Hawaiian cuisine","cuisine/cuisine-of-hawaii",[["Poi (Hawaiian food)","dish/poi-hawaiian-food"]]],["Kānaka Maoli foodways","cuisine/kanaka-maoli-foodways",[["Poi (Hawaiian food)","dish/poi-hawaiian-food"]]]]},{"h":"Often cooked with","links":[["Taro","ingredient/taro"]]}],"img":{"src":"/world-cuisine/img/thumb/1/14/Babai.jpg/500px-Babai.jpg","w":500,"h":375,"by":"Tauʻolunga","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Babai.jpg"}},"dish/rempeyek":{"t":"dish","r":"dish/rempeyek","n":"Rempeyek","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Rempeyek or peyek is a deep-fried savoury Indonesian-Javanese cracker made from flour (usually rice flour) with other ingredients, bound or coated by crispy flour batter. The most common type of rempeyek is peyek kacang (\"peanut peyek\"); However, other ingredients can be used instead, such as teri (dried anchovies), rebon (small shrimp), or ebi (dried shrimp). Today, rempeyek is commonly found in Indonesia and Malaysia, as well as in countries with considerable Indonesian migrant populations, such as The Netherlands and Suriname."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-rempeyek"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rempeyek"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Anchovies as food","ingredient/anchovies-as-food"],["Coconut milk","ingredient/coconut-milk"],["Egg","ingredient/egg"],["Peanut","ingredient/peanut"],["Rice flour","ingredient/rice-flour"],["Sugar","ingredient/sugar"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true,"kind":"blog"}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}],"img":{"src":"/world-cuisine/img/thumb/6/65/Peyek_Kacang.jpg/500px-Peyek_Kacang.jpg","w":500,"h":750,"by":"Aininapple","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Peyek_Kacang.jpg"}},"ingredient/syzygium":{"t":"ingredient","r":"ingredient/syzygium","n":"Syzygium","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Syzygium () is a genus of flowering plants that belongs to the myrtle family, Myrtaceae. The genus comprises about 1200 species, and has a native range that extends from Africa and Madagascar through southern Asia east through the Pacific. Its highest levels of diversity occur from Malaysia to northeastern Australia, where many species are very poorly known and many more have not been described taxonomically. One indication of this diversity is in leaf size, ranging from as little as a half inch (1.3 cm) to as great as 4 ft 11 inches (1.5 meters) by 16 inches (41 centimeters) in Syzygium acre of New Caledonia. Of the 1,100 species of clove worldwide, 175 exist on New Guinea alone, providing fruit and flowers integral to pollination."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-syzygium"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Syzygium"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Arab cuisine","cuisine/arab-cuisine",[["Shawarma","dish/shawarma"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Cardamom","ingredient/cardamom"],["Chicken","ingredient/chicken"],["Cinnamon","ingredient/cinnamon"],["Laffa","ingredient/laffa"],["Lamb","ingredient/lamb"],["Lavash","ingredient/lavash"],["Mentha","ingredient/mentha"],["Morkovcha","ingredient/morkovcha"],["Paprika","ingredient/paprika"],["Pita","ingredient/pita"],["Taboon bread","ingredient/taboon-bread"],["Turkey meat","ingredient/turkey-meat"],["Veal","ingredient/veal"],["Wrap","ingredient/wrap"]]}],"img":{"src":"/world-cuisine/img/thumb/d/d3/Starr_070321-6132_Syzygium_malaccense.jpg/500px-Starr_070321-6132_Syzygium_malaccense.jpg","w":500,"h":375,"by":"Forest & Kim Starr","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Starr_070321-6132_Syzygium_malaccense.jpg"}},"dish/yukpo":{"t":"dish","r":"dish/yukpo","n":"Yukpo","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Korean cuisine","dot":"#f0b340","intro":[["Yukpo is a type of po or dried meat, made from beef. It is a traditional Korean food, commonly eaten as snack food, banchan (food accompanying bap) or anju (food accompanying sul). It is also one of the foods prepared for traditional occasions such as pyebaek (formal greetings from the newlyweds after the wedding ceremony) and jesa (ancestral rite)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-yukpo"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Yukpo"}],"sections":[{"h":"Where it's from","links":[["Korean cuisine","cuisine/korean-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Beef","ingredient/beef"]]},{"h":"Cook it","rows":[{"name":"Maangchi","color":"#55b8ad","shape":"site","sub":"maangchi.com","note":"Maangchi's Korean recipe site and YouTube channel, one of the best known English sources for Korean cooking.","url":"https://www.maangchi.com/","suggested":true,"kind":"youtube"},{"name":"Korean Bapsang","color":"#55b8ad","shape":"site","sub":"koreanbapsang.com","note":"Home-style Korean recipes from Hyosun, a Korean-American mom.","url":"https://www.koreanbapsang.com/category/recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Korean cuisine","links":[["Bap (rice dish)","dish/bap-rice-dish"],["Bibim-guksu","dish/bibim-guksu"],["Bibimbap","dish/bibimbap"],["Bosintang","dish/bosintang"],["Cheonggukjang","dish/cheonggukjang"],["Doenjang","dish/doenjang"],["Garak-guksu","dish/garak-guksu"],["Gochujang","dish/gochujang"],["Gopchang","dish/gopchang"],["Hwajeon","dish/hwajeon"],["Jijimi","dish/jijimi"],["Jokbal","dish/jokbal"],["Korean restaurant","dish/korean-restaurant"],["Maekjeok","dish/maekjeok"],["Maeun-tang","dish/maeun-tang"],["Makchang","dish/makchang"],["Mandu-guk","dish/mandu-guk"],["Mandu-gwa","dish/mandu-gwa"],["Meat jun","dish/meat-jun"],["Meju","dish/meju"],["Morkovcha","dish/morkovcha"],["Scorched rice","dish/scorched-rice"],["Seon (food)","dish/seon-food"],["Sungnyung","dish/sungnyung"],["Tteokbokki","dish/tteokbokki"],["Wakame","dish/wakame"],["Yakgwa","dish/yakgwa"]]}],"img":{"src":"/world-cuisine/img/thumb/f/fd/Hanu-yukpo_3.jpg/500px-Hanu-yukpo_3.jpg","w":500,"h":376,"by":"맛객","lic":"CC BY 2.0 kr","licUrl":"https://creativecommons.org/licenses/by/2.0/kr/deed.en","page"