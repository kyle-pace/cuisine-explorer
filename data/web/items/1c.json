h/food-for-thought-restaurant":{"t":"dish","r":"dish/food-for-thought-restaurant","n":"Food for Thought (restaurant)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Vegetarian cuisine","dot":"#a99fb5","intro":[["Food for Thought was a vegetarian restaurant in the Seven Dials district of London's Covent Garden. Founded in 1971 in a former banana warehouse, it later closed in 2015 due to rising rents."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-food-for-thought-restaurant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Food_for_Thought_(restaurant)"}],"sections":[{"h":"Where it's from","links":[["Vegetarian cuisine","cuisine/vegetarian-cuisine"]]},{"h":"More from Vegetarian cuisine","links":[["'t Vlasbloemeken","dish/t-vlasbloemeken"],["De Librije","dish/de-librije"],["Follow Your Heart (company)","dish/follow-your-heart-company"],["Morningstar Farms","dish/morningstar-farms"],["Plant-based food","dish/plant-based-food"],["Vegetarianism","dish/vegetarianism"],["Veggie Victory","dish/veggie-victory"]]}]},"dish/grimaldi-s-pizzeria":{"t":"dish","r":"dish/grimaldi-s-pizzeria","n":"Grimaldi's Pizzeria","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["Grimaldi's Pizzeria is an American pizzeria chain from the New York City area with over 40 restaurants throughout the United States. Its most famous restaurant is under the Brooklyn Bridge in Brooklyn at 1 Front Street, next door to its original location. Zagat Survey rated Grimaldi's the No. 1 Pizzeria in New York in 2007. With a carry-out and delivery service model in response to the COVID-19 pandemic, in 2022 it had 43 restaurants in operation overall. Slices are sold at all locations except Brooklyn and Palazzo locations, which are cooked by coal-fired brick ovens. It also sells wines and appetizers, as well as calzones. Among desserts are cannoli and tiramisu, as well as New York–style cheesecake."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-grimaldi-s-pizzeria"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Grimaldi's_Pizzeria"}],"sections":[{"h":"Where it's from","links":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","ref":"site/pastagrannies-substack-com","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's long-running video series filming Italian grandmothers making regional pasta by hand.","url":"https://pastagrannies.substack.com/p/pasta-grannies-is-now-on-substack","suggested":true},{"name":"Recipes from Italy","ref":"site/recipesfromitaly-com","color":"#55b8ad","shape":"site","sub":"recipesfromitaly.com","note":"Traditional Italian recipes written by Italian home cooks, organized by region and course.","url":"https://recipesfromitaly.com","suggested":true},{"name":"Manu's Menu","ref":"site/manusmenu-com","color":"#55b8ad","shape":"site","sub":"manusmenu.com","note":"Italian-born home cook Manuela sharing classic family and regional Italian dishes.","url":"https://www.manusmenu.com/about/about-this-site","suggested":true}]},{"h":"More from Italian cuisine","links":[["8½ Otto e Mezzo Bombana","dish/8-otto-e-mezzo-bombana"],["A16 (restaurant)","dish/a16-restaurant"],["Acquacotta","dish/acquacotta"],["Agliata","dish/agliata"],["Agnolotti","dish/agnolotti"],["Alfredo alla Scrofa","dish/alfredo-alla-scrofa"],["Alioto's","dish/alioto-s"],["Amalfi's Italian Restaurant","dish/amalfi-s-italian-restaurant"],["Amato's","dish/amato-s"],["Angelo's Civita Farnese","dish/angelo-s-civita-farnese"],["Antica Pizzeria Port'Alba","dish/antica-pizzeria-port-alba"],["Antico Pizza","dish/antico-pizza"],["Antipasto","dish/antipasto"],["Arancini","dish/arancini"],["ASK Italian","dish/ask-italian"],["Asti (restaurant)","dish/asti-restaurant"],["Ava Gene's","dish/ava-gene-s"],["Bamonte's","dish/bamonte-s"],["Bar del Corso","dish/bar-del-corso"],["Barbetta","dish/barbetta"],["Barbuto (restaurant)","dish/barbuto-restaurant"],["Bella Italia","dish/bella-italia"],["Beppi's Restaurant","dish/beppi-s-restaurant"],["Bertucci's","dish/bertucci-s"],["BiCE Ristorante","dish/bice-ristorante"],["Biscotti","dish/biscotti"],["Black' Smith","dish/black-smith"],["Bocca di Lupo","dish/bocca-di-lupo"],["Bolinhos de bacalhau","dish/bolinhos-de-bacalhau"],["Bombolone","dish/bombolone"],["Buca di Beppo","dish/buca-di-beppo"],["Budino","dish/budino"],["Buona","dish/buona"],["Cabbage roll","dish/cabbage-roll"],["Caesar salad","dish/caesar-salad"],["Caffé Vittoria","dish/caffe-vittoria"],["Camille's (Providence, Rhode Island)","dish/camille-s-providence-rhode-island"],["Campisi's Egyptian Restaurant","dish/campisi-s-egyptian-restaurant"],["Cannelloni","dish/cannelloni"],["Capellini","dish/capellini"]]}]},"dish/pasta-con-le-sarde":{"t":"dish","r":"dish/pasta-con-le-sarde","n":"Pasta con le sarde","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Sicilian cuisine","dot":"#cf5f87","intro":[["Pasta con le sarde is a Sicilian pasta dish with sardines and anchovies. It is recognized as a traditional Italian food product in the prodotto agroalimentare tradizionale (PAT) scheme of the Italian government. It is most associated with the city of Palermo, but it can be found all over the island."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pasta-con-le-sarde"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pasta_con_le_sarde"}],"sections":[{"h":"Where it's from","links":[["Sicilian cuisine","cuisine/sicilian-cuisine"]]},{"h":"Ingredients","count":9,"links":[["Anchovies as food","ingredient/anchovies-as-food"],["Breadcrumbs","ingredient/breadcrumbs"],["European pilchard","ingredient/european-pilchard"],["Fennel","ingredient/fennel"],["Pasta","ingredient/pasta"],["Pine nut","ingredient/pine-nut"],["Raisin","ingredient/raisin"],["Saffron","ingredient/saffron"],["Sardines as food","ingredient/sardines-as-food"]]},{"h":"More from Sicilian cuisine","links":[["Busiate","dish/busiate"],["Cassatella di Agira","dish/cassatella-di-agira"],["Crocchè","dish/crocche"],["Iris (pastry)","dish/iris-pastry"],["Maccu","dish/maccu"],["Panella","dish/panella"],["Pani câ meusa","dish/pani-ca-meusa"],["Parmigiana","dish/parmigiana"],["Pasta alla Norma","dish/pasta-alla-norma"],["Pasta mollicata","dish/pasta-mollicata"],["Stigghiola","dish/stigghiola"]]}]},"ingredient/swamp-taro":{"t":"ingredient","r":"ingredient/swamp-taro","n":"Swamp taro","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Cyrtosperma merkusii or giant swamp taro, is a crop grown throughout Oceania and into South and Southeast Asia. It is a riverine and \"swamp crop\" similar to taro, but \"with bigger leaves and larger, coarser roots.\" There are no demonstrably wild populations today, but it is believed to be native to Indonesia. It is known as puraka in Cook Islands, lak in Yap (Federated States of Micronesia), babai in Kiribati, iaraj in the Marshall Islands, brak in Palau, babaʻ in the Marianas Islands, pula’a in Samoa, via kana, Pulaka in Lau, Lovo in Fiji, pulaka in Tokelau and Tuvalu, mwahng in Pohnpei, pasruk in Kosrae, simiden in Chuuk, swam taro in Papua New Guinea, 'kakake' in Solomon Islands, navia in Vanuatu and galyang or palawan in the Philippines."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-swamp-taro"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Swamp_taro"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Hawaiian cuisine","cuisine/cuisine-of-hawaii",[["Poi (Hawaiian food)","dish/poi-hawaiian-food"]]],["Kānaka Maoli foodways","cuisine/kanaka-maoli-foodways",[["Poi (Hawaiian food)","dish/poi-hawaiian-food"]]]]},{"h":"Often cooked with","links":[["Taro","ingredient/taro"]]}]},"dish/rempeyek":{"t":"dish","r":"dish/rempeyek","n":"Rempeyek","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Rempeyek or peyek is a deep-fried savoury Indonesian-Javanese cracker made from flour (usually rice flour) with other ingredients, bound or coated by crispy flour batter. The most common type of rempeyek is peyek kacang (\"peanut peyek\"); However, other ingredients can be used instead, such as teri (dried anchovies), rebon (small shrimp), or ebi (dried shrimp). Today, rempeyek is commonly found in Indonesia and Malaysia, as well as in countries with considerable Indonesian migrant populations, such as The Netherlands and Suriname."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-rempeyek"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rempeyek"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Anchovies as food","ingredient/anchovies-as-food"],["Coconut milk","ingredient/coconut-milk"],["Egg","ingredient/egg"],["Peanut","ingredient/peanut"],["Rice flour","ingredient/rice-flour"],["Sugar","ingredient/sugar"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","ref":"site/dailycookingquest-com","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}]},"ingredient/syzygium":{"t":"ingredient","r":"ingredient/syzygium","n":"Syzygium","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Syzygium () is a genus of flowering plants that belongs to the myrtle family, Myrtaceae. The genus comprises about 1200 species, and has a native range that extends from Africa and Madagascar through southern Asia east through the Pacific. Its highest levels of diversity occur from Malaysia to northeastern Australia, where many species are very poorly known and many more have not been described taxonomically. One indication of this diversity is in leaf size, ranging from as little as a half inch (1.3 cm) to as great as 4 ft 11 inches (1.5 meters) by 16 inches (41 centimeters) in Syzygium acre of New Caledonia. Of the 1,100 species of clove worldwide, 175 exist on New Guinea alone, providing fruit and flowers integral to pollination."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-syzygium"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Syzygium"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Arab cuisine","cuisine/arab-cuisine",[["Shawarma","dish/shawarma"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Cardamom","ingredient/cardamom"],["Chicken","ingred