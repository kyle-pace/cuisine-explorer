{"cuisine/puerto-rican-cuisine":{"t":"cuisine","r":"cuisine/puerto-rican-cuisine","n":"Puerto Rican cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Cuisine"]],"sub":"National cuisine of Puerto Rico","intro":[["Puerto Rican cuisine consists of the cooking style and traditional dishes original to Puerto Rico. It has been primarily a fusion influenced by the ancestors of the Puerto Rican people: the indigenous Taínos, Spanish Criollos and sub-Saharan African slaves. As a territory of the United States, the culinary scene of Puerto Rico has also been moderately influenced by American cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"puerto-rican-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Puerto_Rican_cuisine"}],"sections":[{"h":"Recipe sites","count":2,"rows":[{"name":"Delish D'Lites","ref":"site/delishdlites-com","color":"#55b8ad","shape":"site","sub":"delishdlites.com","note":"Jannese Torres's blog of Puerto Rican and Latin recipes.","url":"https://delishdlites.com","suggested":true},{"name":"Sense and Edibility","ref":"site/senseandedibility-com","color":"#55b8ad","shape":"site","sub":"senseandedibility.com","note":"Food blog with a large Puerto Rican recipe category.","url":"https://senseandedibility.com/category/cuisines/puerto-rican/page/5/","suggested":true}]},{"h":"Cookbooks","count":2,"rows":[{"name":"Diasporican: A Puerto Rican Cookbook","ref":"cookbook/diasporican-a-puerto-rican-cookbook","color":"#f0b340","shape":"book","sub":"Illyanna Maisonet, 2022","note":"Puerto Rican cooking as practiced in the diaspora, by a Sacramento-based food writer.","url":"https://openlibrary.org/isbn/9781984859761","suggested":true},{"name":"Cocina criolla","ref":"cookbook/cocina-criolla","color":"#f0b340","shape":"book","sub":"Carmen Aboy Valldejuli","note":"Long-standing reference of Puerto Rican cooking, also published in English as Puerto Rican Cookery.","url":"https://openlibrary.org/books/OL6181464M/Cocina_criolla.","suggested":true}]},{"h":"More from Puerto Rico","count":1,"links":[["Taíno heritage foodways","cuisine/taino-heritage-foodways"]]}],"cont":"Cuisine of the Americas","img":{"src":"/labs/cuisines/img/9/9d/Aranitas_tostones.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","w":500,"h":463,"by":"Portorricensis (talk) (Uploads)","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Aranitas_tostones.jpg"}},"cuisine/leonese-cuisine":{"t":"cuisine","r":"cuisine/leonese-cuisine","n":"Leonese cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Spanish cuisine","cuisine/spanish-cuisine"]],"sub":"Regional cuisine in Spain","intro":[["Leonese cuisine is a subcategory of Spanish cuisine from the Province of León."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"leonese-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Leonese_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Spanish cuisine","cuisine/spanish-cuisine"]]},{"h":"Part of","links":[["Spanish cuisine","cuisine/spanish-cuisine"]]}],"cont":"European cuisine"},"dish/brown-betty-dessert":{"t":"dish","r":"dish/brown-betty-dessert","n":"Brown Betty (dessert)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["A Brown Betty is a traditional American dessert made from fruit, usually apple (this variant is known as Apple Betty), but also berries or pears and sweetened crumbs. Similar to a cobbler or apple crisp, the fruit is baked, and, in this case, the sweetened crumbs are placed in layers between the fruit. It is sometimes served with lemon sauce or whipped cream."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-brown-betty-dessert"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Brown_Betty_(dessert)"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"Ingredients","count":8,"links":[["Apple","ingredient/apple"],["Berry","ingredient/berry"],["Bread crumbs","ingredient/bread-crumbs"],["Breadcrumbs","ingredient/breadcrumbs"],["Butter","ingredient/butter"],["Pear","ingredient/pear"],["Sugar","ingredient/sugar"],["Zest","ingredient/zest"]]},{"h":"More from American cuisine","links":[["5-8 Club","dish/5-8-club"],["Altabira City Tavern","dish/altabira-city-tavern"],["Angel food cake","dish/angel-food-cake"],["Applebee's","dish/applebee-s"],["Arby's","dish/arby-s"],["Arnold's Bar and Grill","dish/arnold-s-bar-and-grill"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Be Our Guest Restaurant","dish/be-our-guest-restaurant"],["Beer cake","dish/beer-cake"],["Ben's Chili Bowl","dish/ben-s-chili-bowl"],["Benjy's","dish/benjy-s"],["Besaw's","dish/besaw-s"],["Better than sex cake","dish/better-than-sex-cake"],["Blackhawk (restaurant)","dish/blackhawk-restaurant"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Bobcat Bite","dish/bobcat-bite"],["Boiling Springs Tavern","dish/boiling-springs-tavern"],["Brix Tavern","dish/brix-tavern"],["Brown Derby","dish/brown-derby"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Buona","dish/buona"],["Busboys and Poets","dish/busboys-and-poets"],["Butter cake","dish/butter-cake"],["Byways Cafe","dish/byways-cafe"],["Caesar salad","dish/caesar-salad"],["California Grill","dish/california-grill"],["Camp Washington Chili","dish/camp-washington-chili"],["Caramel apple","dish/caramel-apple"],["Carbonara","dish/carbonara"],["Carnation Cafe","dish/carnation-cafe"],["Cheesesteak","dish/cheesesteak"],["Chicago-style hot dog","dish/chicago-style-hot-dog"],["Chicken nugget","dish/chicken-nugget"],["Chiffon cake","dish/chiffon-cake"],["Chili con carne","dish/chili-con-carne"],["Chiltern Firehouse","dish/chiltern-firehouse"]]}]},"ingredient/hoagie-roll":{"t":"ingredient","r":"ingredient/hoagie-roll","n":"Hoagie roll","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["In American usage, a hoagie roll is a long, crusty-on-the-outside, soft-on-the-inside bread roll used to prepare hoagie sandwiches, particularly in the Philadelphia area. Also known as a \"sub\" or \"hero\" roll. Key characteristics include a firm exterior that holds up to fillings and a tender interior. They are the foundation for classic sandwiches with cold cuts, cheese, and oil, vinegar, and oregano. Hoagie rolls are sometimes toasted before being used to prepare a sandwich."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-hoagie-roll"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hoagie_roll"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["American cuisine","cuisine/american-cuisine",[["Cheesesteak","dish/cheesesteak"]]]]},{"h":"Often cooked with","links":[["Beefsteak","ingredient/beefsteak"],["Processed cheese","ingredient/processed-cheese"]]}]},"ingredient/black-olive":{"t":"ingredient","r":"ingredient/black-olive","n":"Black olive","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The cultivated olive (botanical name Olea europaea subsp. europaea) is a subspecies of subtropical evergreen tree in the family Oleaceae. Modern cultivars are traced primarily to the Near East, Aegean Sea, and Strait of Gibraltar. Olea europaea is the type species for its genus, Olea, which lends its name to the Oleaceae plant family. The olive fruit is classed botanically as a drupe, similar in structure and function to the cherry or peach. The term oil was originally synonymous with olive oil."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-black-olive"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Black_olive"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Valencian cuisine","cuisine/valencian-cuisine",[["Esgarrat","dish/esgarrat"]]]]},{"h":"Often cooked with","links":[["Bacalhau","ingredient/bacalhau"],["Bell pepper","ingredient/bell-pepper"],["Garlic","ingredient/garlic"],["Olive oil","ingredient/olive-oil"],["Salt cod","ingredient/salt-cod"]]}],"img":{"src":"/labs/cuisines/img/8/84/Olivesfromjordan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","w":500,"h":506,"by":"en:User:Nickfraser","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Olivesfromjordan.jpg"}},"dish/ferrara-bakery-and-cafe":{"t":"dish","r":"dish/ferrara-bakery-and-cafe","n":"Ferrara Bakery and Cafe","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["Ferrara Bakery and Cafe, established in 1892 by Antonio Ferrara, claims to be America's first espresso bar. It is located in Little Italy, Manhattan, New York City, and offers Italian delicacies. Ferrara has remained a family owned business since its inception, and is operated at its original location on Grand Street by the family's fifth generation of bakers."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-ferrara-bakery-and-cafe"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ferrara_Bakery_and_Cafe"}],"sections":[{"h":"Where it's from","links":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","ref":"site/pastagrannies-substack-com","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's long-running video series filming Italian grandmothers making regional pasta by hand.","url":"https://pastagrannies.substack.com/p/pasta-grannies-is-now-on-substack","suggested":true},{"name":"Recipes from Italy","ref":"site/recipesfromitaly-com","color":"#55b8ad","shape":"site","sub":"recipesfromitaly.com","note":"Traditional Italian recipes written by Italian home cooks, organized by region and cou