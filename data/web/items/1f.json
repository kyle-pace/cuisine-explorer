romming"]]]]},{"h":"Often cooked with","links":[["Baltic herring","ingredient/baltic-herring"],["Clupea","ingredient/clupea"],["Edible salt","ingredient/edible-salt"]]}],"img":{"src":"/labs/cuisines/img/0/04/Clupea_harengus.png","w":500,"h":302,"by":"Unknown authorUnknown author","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Clupea_harengus.png"}},"ingredient/metapenaeopsis-barbata":{"t":"ingredient","r":"ingredient/metapenaeopsis-barbata","n":"Metapenaeopsis barbata","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Metapenaeopsis barbata, commonly known as the whiskered velvet shrimp, is a species of prawn in the family Penaeidae. It is benthic, living in the depth range of 20–70 m. M. barbata grows up to 108 mm in length."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-metapenaeopsis-barbata"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Metapenaeopsis_barbata"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Taiwan cuisine","cuisine/taiwan-cuisine",[["Tàⁿ-á-mī","dish/ta-a-mi"]]]]},{"h":"Often cooked with","links":[["Noodles","ingredient/noodles"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/92/Metapenaeopsis_barbata_%28MNHN-IU-2014-19876%29.jpeg/500px-Metapenaeopsis_barbata_%28MNHN-IU-2014-19876%29.jpeg","w":500,"h":375,"by":"Laura FLAMME","lic":"CC BY 4.0","licUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:Metapenaeopsis_barbata_(MNHN-IU-2014-19876).jpeg"}},"ingredient/penne":{"t":"ingredient","r":"ingredient/penne","n":"Penne","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Penne are an extruded type of pasta in the shape of tubular pieces with ends cut at an angle. They are usually made from wheat flour."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-penne"},{"kind":"wiki","url":"https://en