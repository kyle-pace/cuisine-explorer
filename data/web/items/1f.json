.0","page":"https://commons.wikimedia.org/wiki/File:%D0%9C%D0%B5%D1%82%D0%B0%D0%BB%D0%BB%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B5_%D1%87%D0%B0%D0%B9%D0%BD%D1%8B%D0%B5_%D0%B1%D0%B0%D0%BD%D0%BA%D0%B8.jpg"}},"ingredient/lemon-juice":{"t":"ingredient","r":"ingredient/lemon-juice","n":"Lemon juice","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 6 cuisines","intro":[["The lemon (Citrus × limon) is a species of small evergreen tree in the Citrus genus of the flowering plant family Rutaceae. A true lemon is a hybrid of the citron and the bitter orange. Its origins are uncertain, but some evidence suggests lemons originated during the 1st millennium BC in what is now northeastern India. Some other citrus fruits are called lemon."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-lemon-juice"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lemon_juice"}],"sections":[{"h":"Where it's cooked with","count":6,"groups":[["American cuisine","cuisine/american-cuisine",[["Caesar salad","dish/caesar-salad"]]],["French cuisine","cuisine/french-cuisine",[["Hollandaise sauce","dish/hollandaise-sauce"]]],["Italian cuisine","cuisine/italian-cuisine",[["Caesar salad","dish/caesar-salad"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Hollandaise sauce","dish/hollandaise-sauce"]]],["Russian cuisine","cuisine/russian-cuisine",[["Caesar salad","dish/caesar-salad"]]],["Sephardic Jewish cuisine","cuisine/sephardic-jewish-cuisine",[["Apio (appetizer)","dish/apio-appetizer"]]]]},{"h":"Where it's grown","grown":{"what":"Lemons and limes","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":22113897,"top":[["India","cuisine/indian-cuisine",3726745],["Mexico","cuisine/mexican-cuisine",3105561],["China","cuisine/chinese-cuisine",2302252],["Argentina","cuisine/argentine-cuisine",1955298],["Brazil","cuisine/brazilian-cuisine",1632185],["Turkey","cuisine/turkish-cuisine",1623449],["Spain","cuisin