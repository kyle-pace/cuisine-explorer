 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Gotham_Bar_Grill.jpg"}},"ingredient/water-spinach":{"t":"ingredient","r":"ingredient/water-spinach","n":"Water spinach","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Ipomoea aquatica, commonly known as water spinach or kangkung,  is a semi-aquatic, tropical plant grown as a vegetable for its tender shoots. I. aquatica is generally believed to have been first domesticated in Southeast Asia. It is widely cultivated in Southeast Asia, East Asia, and South Asia. It grows abundantly near waterways and requires little to no care."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-water-spinach"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Water_spinach"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Kapurung","dish/kapurung"]]]]},{"h":"Often cooked with","links":[["Anchovy","ingredient/anchovy"],["Asparagus bean","ingredient/asparagus-bean"],["Cayenne pepper","ingredient/cayenne-pepper"],["Chicken","ingredient/chicken"],["Maize","ingredient/maize"],["Moringa (genus)","ingredient/moringa-genus"],["Pindang","ingredient/pindang"],["Sago","ingredient/sago"],["Shrimp paste","ingredient/shrimp-paste"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/10/N_Ipoa_D1600.JPG/500px-N_Ipoa_D1600.JPG","w":500,"h":375,"by":"Eric Guinther","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:N_Ipoa_D1600.JPG"}},"dish/kiam-piann":{"t":"dish","r":"dish/kiam-piann","n":"Kiâm-piánn","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Taiwan cuisine","dot":"#f0b340","intro":[["Kiâm-piánn, or Penghu Salty Biscuit, is a traditional Taiwanese biscuit, originating from the island of Penghu."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kiam-piann"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ki%C3%A2m-pi%C3%A1nn"}],"sections":[{"h":"Where it's from","links":[["Taiwan cuisine","cuisine/taiwan-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Lard","ingredient/lard"],["Scallion","ingredient/scallion"],["Sesame","ingredient/sesame"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Cooking in Chinglish","ref":"site/cookinginchinglish-com","color":"#55b8ad","shape":"site","sub":"cookinginchinglish.com","note":"Taiwanese home recipes from Edwina, who grew up in Taiwan.","url":"https://cookinginchinglish.com","suggested":true},{"name":"Tiny Urban Kitchen: Taiwanese Recipes","ref":"site/tinyurbankitchen-com","color":"#55b8ad","shape":"site","sub":"tinyurbankitchen.com","note":"Small set of Taiwanese recipes from Jen Che, a Taiwanese American blogger in Hong Kong.","url":"https://tinyurbankitchen.com/taiwanese-recipes/","suggested":true}]},{"h":"More from Taiwan cuisine","links":[["886 (restaurant)","dish/886-restaurant"],["Ageh (food)","dish/ageh-food"],["Alivongvong","dish/alivongvong"],["Alkemē","dish/alkeme"],["Apple bread","dish/apple-bread"],["Bah-uân","dish/bah-uan"],["Braised pork rice","dish/braised-pork-rice"],["Coffin bread","dish/coffin-bread"],["Doujiang","dish/doujiang"],["Egg yolk pastry","dish/egg-yolk-pastry"],["Iron egg","dish/iron-egg"],["Kato (restaurant)","dish/kato-restaurant"],["Ló͘-bah-pn̄g","dish/lo-bah-png"],["Mongolian barbecue","dish/mongolian-barbecue"],["Peanut ice cream roll","dish/peanut-ice-cream-roll"],["Penglai rice","dish/penglai-rice"],["Pineapple cake","dish/pineapple-cake"],["Pineapple shrimp balls","dish/pineapple-shrimp-balls"],["Pork ball","dish/pork-ball"],["Rechao","dish/rechao"],["Shuangbaotai","dish/shuangbaotai"],["Small sausage in large sausage","dish/small-sausage-in-large-sausage"],["Taiwanese beef noodle soup","dish/taiwanese-beef-noodle-soup"],["Taiwanese fried chicken","dish/taiwanese-fried-chicken"],["Taiwanese fried chicken cutlet","dish/taiwanese-fried-chicken-cutlet"],["Tàⁿ-á-mī","dish/ta-a-mi"],["Tapioca Express","dish/tapioca-express"],["Tea egg","dish/tea-egg"],["Ti-hueh-kué","dish/ti-hueh-kue"],["Tshik-á-mī","dish/tshik-a-mi"],["Tube rice pudding","dish/tube-rice-pudding"],["Xiaolongbao","dish/xiaolongbao"]]}],"img":{"src":"/labs/cuisines/img/thumb/c/c5/%E9%B9%B9%E9%A4%85_02_salty_biscuit.jpg/500px-%E9%B9%B9%E9%A4%85_02_salty_biscuit.jpg","w":500,"h":374,"by":"舟集 Boattoad","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%E9%B9%B9%E9%A4%85_02_salty_biscuit.jpg"}},"dish/lambert-s-cafe":{"t":"dish","r":"dish/lambert-s-cafe","n":"Lambert's Cafe","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Southern American cuisine","dot":"#94bd5c","intro":[["Lambert's Cafe is a US restaurant chain with locations in Foley, Alabama; Sikeston, Missouri; and Ozark, Missouri. It was founded in 1942. It  is known for throwing hot rolls to the customers. It features Southern or country cooking (fried chicken, catfish, etc.); a variety of side dishes, called \"pass arounds\", are brought to the table to accompany each meal. The restaurants have been cited as a prime example of \"road food\", and diners often arrive via tour bus."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-lambert-s-cafe"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lambert's_Cafe"}],"sections":[{"h":"Where it's from","links":[["Southern American cuisine","cuisine/cuisine-of-the-southern-united-states"]]},{"h":"Cook it","rows":[{"name":"Lana's Cooking","ref":"site/lanascooking-com","color":"#55b8ad","shape":"site","sub":"lanascooking.com","note":"Lana Stuart's blog of Southern home cooking from Georgia.","url":"https://www.lanascooking.com/about/","suggested":true},{"name":"A Southern Soul: Southern Classics","ref":"site/asouthernsoul-com","color":"#55b8ad","shape":"site","sub":"asouthernso