{"ingredient/prunus-cerasifera":{"t":"ingredient","r":"ingredient/prunus-cerasifera","n":"Prunus cerasifera","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 1 cuisine","intro":[["Prunus cerasifera is a species of plum known by the common names cherry plum and myrobalan plum. Native to Eurasia and naturalized elsewhere, P. cerasifera is believed to be one of the parents of the cultivated plum."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-prunus-cerasifera"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Prunus_cerasifera"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Georgian cuisine","cuisine/georgian-cuisine",[["Chakapuli","dish/chakapuli"],["Kharcho","dish/kharcho"]]]]},{"h":"Often cooked with","links":[["Garlic","ingredient/garlic"],["Anethum","ingredient/anethum"],["Coriander","ingredient/coriander"],["Lamb","ingredient/lamb"],["Mentha","ingredient/mentha"],["Onion","ingredient/onion"],["Petroselinum","ingredient/petroselinum"],["Plum","ingredient/plum"],["Prunus vachuschtii","ingredient/prunus-vachuschtii"],["Scallion","ingredient/scallion"],["Tarragon","ingredient/tarragon"],["Tkemali","ingredient/tkemali"],["Veal","ingredient/veal"],["White wine","ingredient/white-wine"],["Beef","ingredient/beef"],["Pomegranate juice","ingredient/pomegranate-juice"]]}],"img":{"src":"/world-cuisine/img/thumb/2/2d/Wildpflaume_Althof-2.jpg/500px-Wildpflaume_Althof-2.jpg","w":500,"h":755,"by":"An-d","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Wildpflaume_Althof-2.jpg"}},"dish/chebureki":{"t":"dish","r":"dish/chebureki","n":"Chebureki","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Crimean Tatar cuisine","dot":"#cf5f87","intro":[["Chebureki (sing. cheburek) are deep-fried turnovers with a filling of ground or minced meat and onions. A popular street dish, they are made with a single round piece of dough folded over the filling in a crescent shape. They have become widespread in  Eastern Europe in the 20th century."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-chebureki"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chebureki"}],"sections":[{"h":"Where it's from","links":[["Crimean Tatar cuisine","cuisine/crimean-tatar-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Animal fats and oils","ingredient/animal-fats-and-oils"],["Beef","ingredient/beef"],["Egg","ingredient/egg"],["Lamb","ingredient/lamb"],["Onion","ingredient/onion"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"More from Crimean Tatar cuisine","links":[["Stuffed leaves","dish/stuffed-leaves"]]}],"img":{"src":"/world-cuisine/img/thumb/e/ee/Burek.jpg/500px-Burek.jpg","w":500,"h":375,"by":"Loyna","lic":"CC BY-SA 2.5","licUrl":"https://creativecommons.org/licenses/by-sa/2.5","page":"https://commons.wikimedia.org/wiki/File:Burek.jpg"}},"ingredient/kefir":{"t":"ingredient","r":"ingredient/kefir","n":"Kefir","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 5 cuisines","intro":[["Kefir is a fermented milk drink similar to a thin yogurt or ayran that is made from kefir grains, a specific type of mesophilic symbiotic culture. It is prepared by inoculating the milk of cows, goats, or sheep with kefir grains."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-kefir"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kefir"}],"sections":[{"h":"Where it's cooked with","count":5,"groups":[["Belarusian cuisine","cuisine/belarusian-cuisine",[["Cold beet soup","dish/cold-beet-soup"]]],["Latvian cuisine","cuisine/latvian-cuisine",[["Cold beet soup","dish/cold-beet-soup"]]],["Lithuanian cuisine","cuisine/lithuanian-cuisine",[["Cold beet soup","dish/cold-beet-soup"]]],["Polish cuisine","cuisine/polish-cuisine",[["Cold beet soup","dish/cold-beet-soup"]]],["Ukrainian cuisine","cuisine/ukrainian-cuisine",[["Cold beet soup","dish/cold-b