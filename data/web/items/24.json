inang.jpg/500px-Nasi_Kapau_Selera_Minang.jpg","w":500,"h":359,"by":"Erisonjkambari","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Nasi_Kapau_Selera_Minang.jpg"}},"dish/picarones":{"t":"dish","r":"dish/picarones","n":"Picarones","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Peruvian cuisine","dot":"#94bd5c","intro":[["Picarones (or picarón singular) is a Peruvian dessert that originated in Lima during the viceroyalty. It is somewhat similar to buñuelos, a type of doughnut brought to the colonies by Spanish conquistadors. Its principal ingredients are squash and sweet potato. It is served in a doughnut form and covered with syrup, made from chancaca (solidified molasses). It is traditional to serve picarones when people prepare anticuchos, another traditional Peruvian dish."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-picarones"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Picarones"}],"sections":[{"h":"Where it's from","links":[["Peruvian cuisine","cuisine/peruvian-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Chancaca","ingredient/chancaca"],["Cucurbita maxima","ingredient/cucurbita-maxima"],["Fig","ingredient/fig"],["Panela","ingredient/panela"],["Squash (plant)","ingredient/squash-plant"],["Sweet potato","ingredient/sweet-potato"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Peru Delights","color":"#55b8ad","shape":"site","sub":"perudelights.com","note":"Morena Cuadra's blog of Peruvian home recipes and food culture.","url":"https://perudelights.com/tag/peruvian-home-cooking/","suggested":true,"kind":"blog"},{"name":"Eat Peru","color":"#55b8ad","shape":"site","sub":"eatperu.com","note":"Guide to Peruvian dishes and ingredients with a recipe section.","url":"https://www.eatperu.com/category/recipes/?sf_paged=2","suggested":true,"kind":"site"}]},{"h":"More from Peruvian cuisine","links":[["Anticucho","dish/anticu