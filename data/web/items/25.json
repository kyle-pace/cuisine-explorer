{"cuisine/tanzanian-cuisine":{"t":"cuisine","r":"cuisine/tanzanian-cuisine","n":"Tanzanian cuisine","c":"#e46a3f","crumb":[["Africa","cuisines#africa"],["Cuisine"]],"sub":"National cuisine of Tanzania","intro":[["Following Tanganyika's independence (1961) and unification with Zanzibar (1964), leading to the formation of the state of Tanzania, President Julius Nyerere emphasised a need to construct a national identity for the citizens of the new country. To achieve this, Nyerere provided what has been regarded by some commentators as one of the most successful cases of ethnic repression and identity transformation in Africa."],["With over 130 ethnic groups and local languages spoken, Tanzania is one of the most ethnically diverse countries in Africa. Despite this, ethnic divisions have remained rare in Tanzania, especially when compared to the rest of the continent."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"tanzanian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tanzanian_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"Cookbooks","count":2,"rows":[{"name":"Eva Pendaeli's Original Tanzania Cookbook","ref":"cookbook/eva-pendaeli-s-original-tanzania-cookbook","color":"#f0b340","shape":"book","sub":"Eva Pendaeli Sarakikya","note":"Tanzanian home recipes published in Dar es Salaam by Mkuki na Nyota.","url":"https://www.africanbookscollective.com/books/eva-pendaelis-original-tanzania-cookbook","suggested":true},{"name":"Taste of Tanzania","ref":"cookbook/taste-of-tanzania","color":"#f0b340","shape":"book","sub":"Miriam R. Kinunda","note":"Collection of Tanzanian recipes, reviewed by BellaNaija and GeekMom in 2014.","url":"","suggested":true}]},{"h":"Within Tanzanian cooking","count":1,"links":[["Zanzibari cuisine","cuisine/zanzibari-cuisine"]]}],"cont":"African cuisine"},"cuisine/saint-lucian-cuisine":{"t":"cuisine","r":"cuisine/saint-lucian-cuisine","n":"Saint Lucian cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Cuisine"]],"sub":"National cuisine of Saint Lucia","intro":[["Saint Lucian cuisine is a combination of French, East Indian and British dishes. Before colonization, Kalinago and Arawakan-speaking peoples occupied the island, surviving on its various natural fruits and vegetables like mangoes, oranges, tangerines, avocados, and breadfruit."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"saint-lucian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Saint_Lucian_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"Cookbooks","count":1,"rows":[{"name":"Kwéyòl / Creole: Recipes, Stories, and Tings from a St. Lucian Chef's Journey","ref":"cookbook/kweyol-creole-recipes-stories-and-tings-from-a-st-lucian-chef-s-journey","color":"#f0b340","shape":"book","sub":"Nina Compton","note":"Saint Lucian and Creole cooking from a Saint Lucia-born New Orleans chef.","url":"https://openlibrary.org/isbn/9780593578971","suggested":true}]}],"cont":"Cuisine of the Americas"},"dish/aatxe-restaurant":{"t":"dish","r":"dish/aatxe-restaurant","n":"Aatxe (restaurant)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Basque cuisine","dot":"#cf5f87","intro":[["Aatxe was a Basque tapas bar and restaurant in San Francisco, California in the United States."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-aatxe-restaurant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Aatxe_(restaurant)"}],"sections":[{"h":"Where it's from","links":[["Basque cuisine","cuisine/basque-cuisine"]]},{"h":"More from Basque cuisine","links":[["Basque cheesecake","dish/basque-cheesecake"],["Gâteau Basque","dish/gateau-basque"],["Gilda (snack)","dish/gilda-snack"],["Goxua","dish/goxua"],["Intxaursaltsa","dish/intxaursaltsa"],["Noriega Hotel","dish/noriega-hotel"],["Pantxineta","dish/pantxineta"],["Pincho","dish/pincho"],["Piperade","dish/piperade"],["Stuffed peppers","dish/stuffed-peppers"],["Sukalki","dish/sukalki"],["Tuna pot","dish/tuna-pot"]]}]},"ingredient/roast-beef":{"t":"ingredient","r":"ingredient/roast-beef","n":"Roast beef","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Roast beef is a dish of beef that is roasted, generally served as the main dish of a meal. In the Anglosphere, roast beef is one of the meats often served at Sunday lunch or dinner. Yorkshire pudding is a standard side dish. Sliced roast beef is also sold as a cold cut, and used as a sandwich filling. Leftover roast beef may be minced and made into hash."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-roast-beef"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Roast_beef"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Brazilian cuisine","cuisine/brazilian-cuisine",[["Bauru (sandwich)","dish/bauru-sandwich"]]],["Italian-American cuisine","cuisine/italian-american-cuisine",[["Italian beef","dish/italian-beef"]]]]},{"h":"Often cooked with","links":[["Bun","ingredient/bun"],["Cheese","ingredient/cheese"],["Mozzarella","ingredient/mozzarella"],["Pickled cucumber","ingredient/pickled-cucumber"],["Tomato","ingredient/tomato"],["Au jus","ingredient/au-jus"],["Baguette","ingredient/baguette"],["Bread roll","ingredient/bread-roll"],["Giardiniera","ingredient/giardiniera"]]}]},"ingredient/sourdough":{"t":"ingredient","r":"ingredient/sourdough","n":"Sourdough","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Sourdough is a leavening agent containing naturally occurring yeast and lactobacillus bacteria. The term is used to describe bread baked with sourdough, while the sourdough itself is referred to as a starter.  In addition to leavening the bread, the fermentation process produces lactic acid, which gives the bread its distinctive sour taste and improves its keeping qualities."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sourdough"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sourdough"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Neapolitan cuisine","cuisine/neapolitan-cuisine",[["Casatiello","dish/casatiello"]]]]},{"h":"Often cooked with","links":[["Cheese","ingredient/cheese"],["Cracklings","ingredient/cracklings"],["Lard","ingredient/lard"],["Salami","ingredient/salami"],["Wheat flour","ingredient/wheat-flour"]]}]},"dish/chipotle-mexican-grill":{"t":"dish","r":"dish/chipotle-mexican-grill","n":"Chipotle Mexican Grill","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Tex-Mex cuisine","dot":"#94bd5c","intro":[["Chipotle Mexican Grill, Inc. ( chih-POAT-lay), also known simply as Chipotle, is an American multinational chain of fast casual restaurants specializing in bowls, tacos, and Mission burritos made to order in front of the customer. As of December 2025, Chipotle has 4,000 locations. Its name derives from chipotle, the Nahuatl name (from chilpoctli) for a smoked and dried jalapeño chili pepper."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-chipotle-mexican-grill"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chipotle_Mexican_Grill"}],"sections":[{"h":"Where it's from","links":[["Tex-Mex cuisine","cuisine/tex-mex-cuisine"]]},{"h":"Cook it","rows":[{"name":"Homesick Texan","ref":"site/homesicktexan-com","color":"#55b8ad","shape":"site","sub":"homesicktexan.com","note":"Lisa Fain's long-running blog of Texan and Tex-Mex home cooking.","url":"https://www.homesicktexan.com/homesick-texan-cookbook-introduction/comment-page-20/","suggested":true}]},{"h":"More from Tex-Mex cuisine","links":[["Baja Fresh","dish/baja-fresh"],["Chapultepec Lupita","dish/chapultepec-lupita"],["Chile con queso","dish/chile-con-queso"],["Chili con carne","dish/chili-con-carne"],["Chuy's","dish/chuy-s"],["Esparza's","dish/esparza-s"],["Guacamole","dish/guacamole"],["La Bamba Mexican Restaurant","dish/la-bamba-mexican-restaurant"],["Pancho Villa (restaurant)","dish/pancho-villa-restaurant"],["Salsarita's Fresh Mexican Grill","dish/salsarita-s-fresh-mexican-grill"],["The Goose (restaurant)","dish/the-goose-restaurant"],["Tia's Tex-Mex","dish/tia-s-tex-mex"],["Tortilla Coast","dish/tortilla-coast"]]}]},"ingredient/french-fries":{"t":"ingredient","r":"ingredient/french-fries","n":"French fries","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 11 cuisines","intro":[["French fries, or simply fries, also known as French fried potatoes, chips, and finger chips, are batonnet or julienne-cut deep-fried potatoes of disputed origin. They are prepared by cutting potatoes into even strips, drying them, and frying them, usually in a deep fryer. Pre-cut, blanched, and frozen russet potatoes are widely used, and sometimes baked in a regular or convection oven, such as an air fryer."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-french-fries"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/French_fries"}],"sections":[{"h":"Where it's cooked with","count":11,"groups":[["American cuisine","cuisine/american-cuisine",[["Fish and chips","dish/fish-and-chips"],["Loaded fries","dish/loaded-fries"]]],["Afrikaner cuisine","cuisine/afrikaner-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["Australian cuisine","cuisine/australian-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["British Chinese cuisine","cuisine/british-chinese-cuisine",[["Salt and pepper chips","dish/salt-and-pepper-chips"]]],["Canadian cuisine","cuisine/canadian-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["English cuisine","cuisine/english-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["Indian cuisine","cuisine/indian-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["Irish cuisine","cuisine/irish-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["New Zealand cuisine","cuisine/new-zealand-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["Norwegian cuisine",