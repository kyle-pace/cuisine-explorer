{"cuisine/heilongjiang-cuisine":{"t":"cuisine","r":"cuisine/heilongjiang-cuisine","n":"Heilongjiang cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Northeastern Chinese cuisine","cuisine/northeastern-chinese-cuisine"]],"sub":"Regional cuisine in China","intro":[],"src":null,"wiki":"Heilongjiang cuisine","actions":[{"kind":"globe","hash":"heilongjiang-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Heilongjiang_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Northeastern Chinese cuisine","cuisine/northeastern-chinese-cuisine"]]},{"h":"Part of","links":[["Northeastern Chinese cuisine","cuisine/northeastern-chinese-cuisine"]]}],"cont":"Asian cuisine"},"cuisine/tripuri-cuisine":{"t":"cuisine","r":"cuisine/tripuri-cuisine","n":"Tripuri cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["North East Indian cuisine","cuisine/north-east-indian-cuisine"]],"sub":"Regional cuisine in India","intro":[["Tripuri cuisine (Borok Chamung) is the type of traditional foods of the Tripuri/Tiprasa people served in the northeastern region of India (mainly Tripura) and Bangladesh. The Tripuri cuisine reflect the organic lifestyle and evolving cultural trend with times from its natural Huk (shifting cultivation) to now settled farming."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"tripuri-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tripuri_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["North East Indian cuisine","cuisine/north-east-indian-cuisine"]]},{"h":"Part of","links":[["North East Indian cuisine","cuisine/north-east-indian-cuisine"]]}],"cont":"Asian cuisine"},"cuisine/slovenian-cuisine":{"t":"cuisine","r":"cuisine/slovenian-cuisine","n":"Slovenian cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Cuisine"]],"sub":"National cuisine of Slovenia","intro":[["Slovenian cuisine is influenced by the diversity of Slovenia's landscape, climate, history and neighbouring cultures. In 2016, the leading Slovenian ethnologists divided the country into 24 gastronomic regions."],["The first Slovene-language cookbook was published by Valentin Vodnik in 1798."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"slovenian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Slovenian_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"Cookbooks","count":1,"rows":[{"name":"The Food and Cooking of Slovenia","ref":"cookbook/the-food-and-cooking-of-slovenia","color":"#f0b340","shape":"book","sub":"Janez Bogataj","note":"Overview of Slovenian regional dishes by a Slovenian ethnologist.","url":"https://www.simonandschuster.ca/books/The-Food-and-Cooking-of-Slovenia/Janez-Bogataj/9781903141601","suggested":true}]},{"h":"Dishes","count":1,"links":[["Kasha","dish/kasha"]]},{"h":"Key ingredients","links":[["Barley","ingredient/barley"],["Buckwheat","ingredient/buckwheat"],["Millet","ingredient/millet"],["Oats","ingredient/oats"],["Rye","ingredient/rye"],["Wheat","ingredient/wheat"]],"note":"Most used across its dishes."}],"cont":"European cuisine"},"cuisine/finnish-cuisine":{"t":"cuisine","r":"cuisine/finnish-cuisine","n":"Finnish cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Cuisine"]],"sub":"National cuisine of Finland","intro":[["Finnish cuisine is notable for generally combining traditional country fare and haute cuisine with contemporary continental-style cooking. Fish and meat (usually pork, beef or reindeer) play a prominent role in traditional Finnish dishes in some parts of the country, while the dishes elsewhere have traditionally included various vegetables and mushrooms. Evacuees from Karelia contributed to foods in other parts of Finland in the aftermath of the Continuation War."],["Finnish foods often use wholemeal products (rye, barley, oats) and berries (such as bilberries, lingonberries, cloudberries, and sea buckthorn). Milk and its derivatives like buttermilk are commonly used as food, drink or in various recipes. Various turnips were common in traditional cooking, but were replaced with the potato after its introduction in the 18th century."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"finnish-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Finnish_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"Dishes","count":17,"links":[["Blodpalt","dish/blodpalt"],["Cabbage roll","dish/cabbage-roll"],["Egg butter","dish/egg-butter"],["Glögg","dish/glogg"],["Joulutorttu","dish/joulutorttu"],["Kalakukko","dish/kalakukko"],["Karelian hot pot","dish/karelian-hot-pot"],["Kesäkeitto","dish/kesakeitto"],["Kringle","dish/kringle"],["Kuivaliha","dish/kuivaliha"],["Lanttulaatikko","dish/lanttulaatikko"],["Lohikeitto","dish/lohikeitto"],["Lörtsy","dish/lortsy"],["Semla","dish/semla"],["Smörgåstårta","dish/smorgastarta"],["Strong beer","dish/strong-beer"],["The Hoito","dish/the-hoito"]]},{"h":"Key ingredients","links":[["Potato","ingredient/potato"],["Wheat flour","ingredient/wheat-flour"],["Rye flour","ingredient/rye-flour"],["Salmon","ingredient/salmon"],["Milk","ingredient/milk"],["Blood","ingredient/blood"],["Blood as food","ingredient/blood-as-food"],["Cabbage","ingredient/cabbage"],["Ground meat","ingredient/ground-meat"],["Onion","ingredient/onion"],["Rice","ingredient/rice"],["Butter","ingredient/butter"],["Almond","ingredient/almond"],["Mulled wine","ingredient/mulled-wine"],["Raisin","ingredient/raisin"],["Wine","ingredient/wine"],["Coregonus albula","ingredient/coregonus-albula"],["European perch","ingredient/european-perch"],["Fish fillet","ingredient/fish-fillet"],["Pork belly","ingredient/pork-belly"],["Beef","ingredient/beef"],["Black pepper","ingredient/black-pepper"],["Lamb","ingredient/lamb"],["Pork","ingredient/pork"]],"note":"Most used across its dishes."}],"cont":"European cuisine"},"dish/bannock-indigenous-american-food":{"t":"dish","r":"dish/bannock-indigenous-american-food","n":"Bannock (Indigenous American food)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#94bd5c","intro":[["A flat bread of flour, water and fat, often raised with baking powder, cooked on a griddle, on a stick over the fire, or in a pan. ",["Métis","cuisine/metis-foodways"]," cooks call it galette, and it's served with fry bread at Anishinaabe sugarbush gatherings at Grand Portage."]],"src":"note","sources":[{"name":"Gabriel Dumont Institute, Traditional Métis foods","url":"https://www.metismuseum.ca/media/document.php/14522.Traditional Metis Foods revised May 2018.pdf"},{"name":"National Park Service, Grand Portage, Iskigamizigan (sugarbush)","url":"https://www.nps.gov/articles/000/iskigamizigan-sugarbush.htm"}],"actions":[{"kind":"globe","hash":"dish-bannock-indigenous-american-food"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bannock_(Indigenous_American_food)"}],"sections":[{"h":"Where it's from","links":[["Native American cuisine","cuisine/native-american-cuisine"],["Métis foodways","cuisine/metis-foodways"],["Anishinaabe foodways","cuisine/anishinaabe-foodways"]]},{"h":"Ingredients","count":1,"links":[["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Native Harvest","ref":"site/nativeharvest-com","color":"#55b8ad","shape":"site","sub":"nativeharvest.com","note":"Wild rice and maple syrup from the White Earth Reservation in Minnesota.","url":"https://www.nativeharvest.com/","suggested":true}]},{"h":"More from Native American cuisine","links":[["Frybread","dish/frybread"],["Grits","dish/grits"]]}]},"dish/baxin":{"t":"dish","r":"dish/baxin","n":"Baxin","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Ligurian cuisine","dot":"#cf5f87","intro":[["Baxin, also known as baxin d'Albenga, is a typical sweet baked good originating in the Liguria region of Italy. It is made with fennel seeds, cloves, sugar, flour and lemon."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-baxin"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Baxin"}],"sections":[{"h":"Where it's from","links":[["Ligurian cuisine","cuisine/cuisine-of-liguria"]]},{"h":"Ingredients","count":4,"links":[["Fennel","ingredient/fennel"],["Lemon","ingredient/lemon"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"A Small Kitchen in Genoa","ref":"site/asmallkitcheningenoa-com","color":"#55b8ad","shape":"site","sub":"asmallkitcheningenoa.com","note":"Genoese cook Enrica Monzani's English-language blog of Ligurian recipes.","url":"https://asmallkitcheningenoa.com/about","suggested":true}]},{"h":"More from Ligurian cuisine","links":[["Coniglio alla sanremese","dish/coniglio-alla-sanremese"]]}]},"dish/burmese-salads":{"t":"dish","r":"dish/burmese-salads","n":"Burmese salads","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Burmese cuisine","dot":"#f0b340","intro":[["Burmese salads are a diverse category of indigenous salads in Burmese cuisine. Burmese salads are made of cooked and raw ingredients that are mixed by hand to combine and balance a wide-ranging array of flavors and textures. Burmese salads are eaten as standalone snacks, as side dishes paired with Burmese curries, and as entrees. The most common or popular, the iconic laphet thoke (fermented tea leaf salad) is traditionally eaten as a palate cleanser at the end of a meal."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-burmese-salads"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Burmese_salads"}],"sections":[{"h":"Where it's from","links":[["Burmese cuisine","cuisine/burmese-cuisine"]]},{"h":"More from Burmese cuisine","links":[["Khao soi","dish/khao-soi"],["Mohinga","dish/mohinga"],["Thali","dish/thali"],["Thua nao","dish/thua-nao"],["Top Burmese","dish/top-burmese"]]}]},"ingredient/ginger-root":{"t":"ingredient","r":"ingredient/ginger-root","n":"Ginger root","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Ginger (Zingiber officinale) is a flowering plant whose rhizome, ginger root or ginger, is widely used as a spice and a folk medicine. It is an herbaceous perennial that grows annual pseudostems (false stems made of the rolled bases of leaves) about one meter tall, bearing narrow leaf blades. The inflorescences bear flowers having pale yellow petals with purple edges, and arise directly from the rhizome on separate shoots."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-ginger-root"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ginger_root"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Cambodian cuisine","cuisine/cambodian-cuisine",[["Chha kh'nhei","dish/chha-kh-nhei"]]]]},{"h":"Often cooked with","links":[["Black pepper","ingredient/black-pepper"],["Garlic","ingredient/garlic"],["Holy basil","ingredient/holy-basil"],["Palm sugar","ingredient/palm-sugar"],["Soy sauce","ingredient/soy-sauce"]]}]},"ingredient/mustard-oil":{"t":"ingredient","r":"ingredient/mustard-oil","n":"Mustard oil","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 3 cuisines","intro":[["Mustard oil refers to either the pressed oil of the mustard plant used for cooking or its pungent essential (or volatile) oil."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-mustard-oil"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mustard_oil"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Bangladeshi cuisine","cuisine/bangladeshi-cuisine",[["Shorshe ilish","dish/shorshe-ilish"]]],["Bhojpuri cuisine","cuisine/bhojpuri-cuisine",[["Litti (dish)","dish/litti-dish"]]],["Gujarati cuisine","cuisine/gujarati-cuisine",[["Dhokla","dish/dhokla"]]]]},{"h":"Often cooked with","links":[["Chili pepper","ingredient/chili-pepper"],["Ginger","ingredient/ginger"],["Lentil","ingredient/lentil"],["Sodium bicarbonate","ingredient/sodium-bicarbonate"],["Atta","in