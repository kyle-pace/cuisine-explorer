m"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/4d/Mamak_rojak.jpg/500px-Mamak_rojak.jpg","w":500,"h":332,"by":"Unknown author","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Mamak_rojak.jpg"}},"ingredient/sauteed-onions":{"t":"ingredient","r":"ingredient/sauteed-onions","n":"Sautéed onions","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Fried onions are slices of onions that are either pan fried (sautéed) or deep fried — and consumed as a popular snack food, garnish, or vegetable accompaniment to various recipes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sauteed-onions"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Saut%C3%A9ed_onions"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Pacific Northwest cuisine","cuisine/pacific-northwest-cuisine",[["Seattle-style hot dog","dish/seattle-style-hot-dog"]]],["Western American cuisine","cuisine/cuisine-of-the-western-united-states",[["Seattle-style hot dog","dish/seattle-style-hot-dog"]]]]},{"h":"Often cooked with","links":[["Bialy","ingredient/bialy"],["Bialy (bread)","ingredient/bialy-bread"],["Cream cheese","ingredient/cream-cheese"],["Hot dog","ingredient/hot-dog"],["Hot dog bun","ingredient/hot-dog-bun"]]}]},"ingredient/carp":{"t":"ingredient","r":"ingredient/carp","n":"Carp","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 3 cuisines","intro":[["The term carp is a generic common name for numerous species of freshwater fish from the family Cyprinidae, a very large clade of ray-finned fish mostly native to Eurasia. While carp are prized quarries and are valued (even commercially cultivated) as both food and ornamental fish in many parts of the Old World, they are considered trash fish and invasive pests in many parts of Africa, Australia and most of the United States."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-carp"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Carp"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Greek cuisine","cuisine/greek-cuisine",[["Taramasalata","dish/taramasalata"]]],["Romanian cuisine","cuisine/romanian-cuisine",[["Taramasalata","dish/taramasalata"]]],["Turkish cuisine","cuisine/turkish-cuisine",[["Taramasalata","dish/taramasalata"]]]]},{"h":"Often cooked with","links":[["Bread crumbs","ingredient/bread-crumbs"],["Cod","ingredient/cod"],["Mashed potato","ingredient/mashed-potato"],["Olive oil","ingredient/olive-oil"],["Roe","ingredient/roe"],["Vinegar","ingredient/vinegar"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/ac/Unsere_S%C3%BC%C3%9Fwasserfische_%28Tafel_33%29_%286102602781%29.jpg/500px-Unsere_S%C3%BC%C3%9Fwasserfische_%28Tafel_33%29_%286102602781%29.jpg","w":500,"h":341,"by":"Walter, Emil","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Unsere_S%C3%BC%C3%9Fwasserfische_(Tafel_33)_(6102602781).jpg"}}}