,["Stuffed leaves","dish/stuffed-leaves"],["Stuffed peppers","dish/stuffed-peppers"],["Stuffed squash","dish/stuffed-squash"],["Stuffed tomatoes","dish/stuffed-tomatoes"],["Taramasalata","dish/taramasalata"],["Yayla çorbası","dish/yayla-corbas"]]}]},"ingredient/borassus-flabellifer":{"t":"ingredient","r":"ingredient/borassus-flabellifer","n":"Borassus flabellifer","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Borassus flabellifer, also known as palmyra palm, is a fan palm native to tropical and sub-tropical regions of South Asia and Southeast Asia. It is a tall, sturdy tree growing up to 20–30 m, with large fan-shaped leaves arranged in the form of a crown. It produces a pale white and branched inflorescence consisting of clusters of flowers. It produces bunches of large fruits containing sweet, watery kernels."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-borassus-flabellifer"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Borassus_flabellifer"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Neera","dish/neera"]]]]}]},"dish/sashimi":{"t":"dish","r":"dish/sashimi","n":"Sashimi","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Sashimi is a Japanese delicacy that consists of fresh raw fish or other raw meat that is sliced into thin pieces, and is often eaten with soy sauce."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-sashimi"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sashimi"}],"sections":[{"h":"Where it's from","links":[["Japanese cuisine","cuisine/japanese-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Fish","ingredient/fish"]]},{"h":"Cook it","rows":[{"name":"Just One Cookbook","ref":"site/justonecookbook-com","color":"#55b8ad","shape":"site","sub":"justonecookbook.com","note":"Namiko Chen's long-running blog and vide