sine","cuisine/australian-cuisine"],["Canadian cuisine","cuisine/canadian-cuisine"],["English cuisine","cuisine/english-cuisine"],["Indian cuisine","cuisine/indian-cuisine"],["Irish cuisine","cuisine/irish-cuisine"],["New Zealand cuisine","cuisine/new-zealand-cuisine"],["Norwegian cuisine","cuisine/norwegian-cuisine"],["South African cuisine","cuisine/south-african-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Atlantic cod","ingredient/atlantic-cod"],["Fish","ingredient/fish"],["French fries","ingredient/french-fries"],["Fried fish","ingredient/fried-fish"],["Fries","ingredient/fries"],["Potato","ingredient/potato"]]},{"h":"Cook it","rows":[{"name":"Belly Rumbles: Australian Recipes","ref":"site/bellyrumbles-com","color":"#55b8ad","shape":"site","sub":"bellyrumbles.com","note":"Sara McCleary's collection of Australian classics such as Anzac biscuits, pavlova, sausage rolls and native-ingredient bakes.","url":"https://bellyrumbles.com/category/australian-recipes/","suggested":true},{"name":"RecipeTin Eats","ref":"site/recipetineats-com","color":"#55b8ad","shape":"site","sub":"recipetineats.com","note":"Sydney-based Nagi Maehashi's widely used recipe site; broad in scope, but a staple of Australian home cooking.","url":"https://www.recipetineats.com/home/","suggested":true},{"name":"Kitchen Frau: Canadian Food","ref":"site/kitchenfrau-com","color":"#55b8ad","shape":"site","sub":"kitchenfrau.com","note":"Canadian food section of an Alberta-based home cooking blog.","url":"https://www.kitchenfrau.com/canadian-food/","suggested":true},{"name":"Swasthi's Recipes","ref":"site/indianhealthyrecipes-com","color":"#55b8ad","shape":"site","sub":"indianhealthyrecipes.com","note":"Swasthi Shreekanth's long-running blog of everyday Indian home cooking from across the regions.","url":"https://www.indianhealthyrecipes.com/about/","suggested":true}]},{"h":"More from Afrikaner cuisine","links":[["Bobotie","dish/bobotie"],["Hertzoggie","dish/hertzoggie"],["Malva pudding","dish/malva-pudding"]]}]},"ingredient/creme-fraiche":{"t":"ingredient","r":"ingredient/creme-fraiche","n":"Crème fraîche","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 4 cuisines","intro":[["Crème fraîche is a dairy product similar to sour cream; it is a soured cream containing 10–45% butterfat, with a pH of approximately 4.5. It is soured with a bacterial culture. European labeling regulations specify the two ingredients must be cream and bacterial culture. It is served over fruit and baked goods, as well as being added to soups and sauces. It is used in a variety of other recipes. Sour cream is a similar foodstuff, except that crème fraîche is less sour and has a higher fat content. Sour cream may contain thickening agents not permitted in crème fraîche in many jurisdictions."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-creme-fraiche"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cr%C3%A8me_fra%C3%AEche"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["French cuisine","cuisine/french-cuisine",[["Flammekueche","dish/flammekueche"]]],["German cuisine","cuisine/german-cuisine",[["Flammekueche","dish/flammekueche"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Flammekueche","dish/flammekueche"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Flammekueche","dish/flammekueche"]]]]},{"h":"Often cooked with","links":[["Bacon","ingredient/bacon"],["Cream","ingredient/cream"],["Fromage frais","ingredient/fromage-frais"],["Lardon","ingredient/lardon"],["Onion","ingredient/onion"]]}]},"dish/focaccia-pugliese":{"t":"dish","r":"dish/focaccia-pugliese","n":"Focaccia pugliese","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["Focaccia is a flat leavened oven-baked Italian bread. It is similar to a flatbread called pizza bianca in Roman cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-focaccia-pugliese"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Focaccia_pugliese"}],"sections":[{"h":"Where it's from","links":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Wheat flour","ingredient/wheat-flour"],["Yeast","ingredient/yeast"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","ref":"site/pastagrannies-substack-com","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's long-running video series filming Italian grandmothers making regional pasta by hand.","url":"https://pastagrannies.substack.com/p/pasta-grannies-is-now-on-substack","suggested":true},{"name":"Recipes from Italy","ref":"site/recipesfromitaly-com","color":"#55b8ad","shape":"site","sub":"recipesfromitaly.com","note":"Traditional Italian recipes written by Italian home cooks, organized by region and course.","url":"https://recipesfromitaly.com","suggested":true},{"name":"Manu's Menu","ref":"site/manusmenu-com","color":"#55b8ad","shape":"site","sub":"manusmenu.com","note":"Italian-born home cook Manuela sharing classic family and regional Italian dishes.","url":"https://www.manusmenu.com/about/about-this-site","suggested":true}]},{"h":"More from Italian cuisine","links":[["8½ Otto e Mezzo Bombana","dish/8-otto-e-mezzo-bombana"],["A16 (restaurant)","dish/a16-restaurant"],["Acquacotta","dish/acquacotta"],["Agliata","dish/agliata"],["Agnolotti","dish/agnolotti"],["Alfredo alla Scrofa","dish/alfredo-alla-scrofa"],["Alioto's","dish/alioto-s"],["Amalfi's Italian Restaurant","dish/amalfi-s-italian-restaurant"],["Amato's","dish/amato-s"],["Angelo's Civita Farnese","dish/angelo-s-civita-farnese"],["Antica Pizzeria Port'Alba","dish/antica-pizzeria-port-alba"],["Antico Pizza","dish/antico-pizza"],["Antipasto","dish/antipasto"],["Arancini","dish/arancini"],["ASK Italian","dish/ask-italian"],["Asti (restaurant)","dish/asti-restaurant"],["Ava Gene's","dish/ava-gene-s"],["Bamonte's","dish/bamonte-s"],["Bar del Corso","dish/bar-