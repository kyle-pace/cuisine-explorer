[["Echpochmak, ocpocmaq, ochpochmaq, ochpochmak, uchpochmak, oechpochmaq, uchpuchmak, ucpucmak or treugolnik is a Tatar and Bashkir national dish, an essential food in Tatar and Bashkir culture. It is a triangular turnover, filled with chopped meat, onion and potatoes. Echpochmak is usually eaten with bouillon or with tea."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-echpochmak"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Echpochmak"}],"sections":[{"h":"Where it's from","links":[["Bashkir cuisine","cuisine/bashkir-cuisine"],["Tatar cuisine","cuisine/tatar-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Onion","ingredient/onion"],["Potato","ingredient/potato"]]},{"h":"More from Bashkir cuisine","links":[["Beshbarmak","dish/beshbarmak"],["Peremech","dish/peremech"],["Pilaf","dish/pilaf"],["Qazı","dish/qaz"],["Qistibi","dish/qistibi"]]}]},"ingredient/haddock":{"t":"ingredient","r":"ingredient/haddock","n":"Haddock","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The haddock (Melanogrammus aeglefinus) is a saltwater ray-finned fish from the family Gadidae, the true cods. It is the only species in the monotypic genus Melanogrammus. It is found in the North Atlantic Ocean and associated seas, where it is an important species for fisheries, especially in northern Europe, where it is marketed fresh, frozen and smoked; smoked varieties include the Finnan haddie and the Arbroath smokie.  Other smoked versions include long boneless, the filleted side of larger haddock smoked in oak chips with the skin left on the fillet."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-haddock"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Haddock"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Scottish cuisine","cuisine/scottish-cuisine",[["Finnan haddie","dish/finnan-haddie"]]]]}]},"dish/hard-rock-cafe":{"t":"dish","r":"dish/hard-rock-cafe","n":"Hard Rock Cafe","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["Hard Rock Cafe, Inc. is a chain of theme bar-restaurants, memorabilia shops, and museums founded in 1971 by Isaac Tigrett and Peter Morton in London. In 1979, the cafe began covering its walls with rock and roll memorabilia, a tradition which expanded to others in the chain. In March 2007, Hard Rock Cafe International (USA), Inc. was sold to the Seminole Tribe of Florida and was headquartered in Orlando, Florida, until April 2018, when the corporate offices were relocated to Davie, Florida. The Hard Rock Cafe chain continues to be owned by Hard Rock International."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-hard-rock-cafe"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hard_Rock_Cafe"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"More from American cuisine","links":[["5-8 Club","dish/5-8-club"],["Altabira City Tavern","dish/altabira-city-tavern"],["Angel food cake","dish/angel-food-cake"],["Applebee's","dish/applebee-s"],["Arby's","dish/arby-s"],["Arnold's Bar and Grill","dish/arnold-s-bar-and-grill"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Be Our Guest Restaurant","dish/be-our-guest-restaurant"],["Beer cake","dish/beer-cake"],["Ben's Chili Bowl","dish/ben-s-chili-bowl"],["Benjy's","dish/benjy-s"],["Besaw's","dish/besaw-s"],["Better than sex cake","dish/better-than-sex-cake"],["Blackhawk (restaurant)","dish/blackhawk-restaurant"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Bobcat Bite","dish/bobcat-bite"],["Boiling Springs Tavern","dish/boiling-springs-tavern"],["Brix Tavern","dish/brix-tavern"],["Brown Betty (dessert)","dish/brown-betty-dessert"],["Brown Derby","dish/brown-derby"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Buona","dish/buona"