om_kha_gai.jpg","w":500,"h":753,"by":"Evan Joshua Swigart (TheCulinaryGeek) from Chicago, Illinois, USA; hometown of Ames,…","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Flickr_preppybyday_4711943668--Tom_kha_gai.jpg"}},"ingredient/batata-vada":{"t":"ingredient","r":"ingredient/batata-vada","n":"Batata vada","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Batata vada is a popular vegetarian fast food dish from the Indian state of Maharashtra. The dish consists of a mashed potato patty coated with chickpea flour, which is then deep-fried and served hot with chutney. The vada is typically around two or three inches in diameter. Across different regions of India, this dish is also known as aloo bonda, aloo vada, batata bonda, potato bonda and potato vada."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-batata-vada"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Batata_vada"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Maharashtrian cuisine","cuisine/maharashtrian-cuisine",[["Vada pav","dish/vada-pav"]]]]},{"h":"Often cooked with","links":[["Bread roll","ingredient/bread-roll"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/8b/Mumbai-vada.jpg/500px-Mumbai-vada.jpg","w":500,"h":333,"by":"Vivekpat30","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Mumbai-vada.jpg"}},"dish/volga-rice":{"t":"dish","r":"dish/volga-rice","n":"Volga rice","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Yoshoku","dot":"#f0b340","intro":[["Volga rice (sometimes boruga rice) is a fried rice dish popular in Echizen, Fukui Prefecture, Japan. Sometimes classed as one of the Three Delicacies of Echizen alongside oroshi soba and ekimae chuka soba, it is a variant of omurice made of a base of fried rice which is then topped with an omelet and crumb-covered pork cutlet; the whole is then covered in rich sauce. There is no proven explanation for the name \"Volga rice\", though there are various theories."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-volga-rice"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Volga_rice"}],"sections":[{"h":"Where it's from","links":[["Yoshoku","cuisine/yoshoku"]]},{"h":"Ingredients","count":5,"links":[["Breaded cutlet","ingredient/breaded-cutlet"],["Fried rice","ingredient/fried-rice"],["Omelette","ingredient/omelette"],["Omurice","ingredient/omurice"],["Tonkatsu","ingredient/tonkatsu"]]},{"h":"More from Yoshoku","links":[["Chicken katsu","dish/chicken-katsu"],["Cream stew","dish/cream-stew"],["Doria (food)","dish/doria-food"],["Hayashi rice","dish/hayashi-rice"],["Menchi-katsu","dish/menchi-katsu"],["Naporitan","dish/naporitan"],["Tonkatsu","dish/tonkatsu"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/8c/%E6%AD%A6%E7%94%9F%E5%90%8D%E7%89%A9%E3%83%9C%E3%83%AB%E3%82%AC%E3%83%A9%E3%82%A4%E3%82%B9%EF%BC%81%E3%82%AB%E3%83%84_on_%E3%82%AA%E3%83%A0%E3%83%A9%E3%82%A4%E3%82%B9%EF%BC%81_%2827926171860%29.jpg/500px-%E6%AD%A6%E7%94%9F%E5%90%8D%E7%89%A9%E3%83%9C%E3%83%AB%E3%82%AC%E3%83%A9%E3%82%A4%E3%82%B9%EF%BC%81%E3%82%AB%E3%83%84_on_%E3%82%AA%E3%83%A0%E3%83%A9%E3%82%A4%E3%82%B9%EF%BC%81_%2827926171860%29.jpg","w":500,"h":412,"by":"ayustety from Tokyo, Japan","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:%E6%AD%A6%E7%94%9F%E5%90%8D%E7%89%A9%E3%83%9C%E3%83%AB%E3%82%AC%E3%83%A9%E3%82%A4%E3%82%B9%EF%BC%81%E3%82%AB%E3%83%84_on_%E3%82%AA%E3%83%A0%E3%83%A9%E3%82%A4%E3%82%B9%EF%BC%81_(27926171860).jpg"}},"dish/xiaolongbao":{"t":"dish","r":"dish/xiaolongbao","n":"Xiaolongbao","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Xiaolongbao is a type of Chinese tangbao (汤包; 湯包), traditionally prepared in a xiaolong, a small bamboo steaming basket. Xiaolongbao is generally believed to have originated in Shanghai."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-xiaolongbao"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Xiaolongbao"}],"sections":[{"h":"Where it's from","links":[["Chinese cuisine","cuisine/chinese-cuisine"],["Taiwan cuisine","cuisine/taiwan-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Auricularia heimuer","ingredient/auricularia-heimuer"],["Flour dough","ingredient/flour-dough"],["Gelatin","ingredient/gelatin"],["Lard","ingredient/lard"],["Napa cabbage","ingredient/napa-cabbage"],["Pork","ingredient/pork"],["Shiitake","ingredient/shiitake"]]},{"h":"Cook it","rows":[{"name":"The Woks of Life","color":"#55b8ad","shape":"site","sub":"thewoksoflife.com","note":"Chinese and Chinese American recipes from the Leung family, running since 2013.","url":"https://thewoksoflife.com/","suggested":true,"kind":"blog"},{"name":"Chinese Cooking Demystified","color":"#55b8ad","shape":"site","sub":"youtube.com","note":"Technique-heavy YouTube channel on regional Chinese home and restaurant cooking.","url":"https://www.youtube.com/@ChineseCookingDemystified","suggested":true,"kind":"youtube"},{"name":"Red House Spice","color":"#55b8ad","shape":"site","sub":"redhousespice.com","note":"Classic Chinese recipes from Wei Guo, who grew up in Gansu, blogging since 2017.","url":"https://redhousespice.com/about/","suggested":true,"kind":"blog"},{"name":"Cooking in Chinglish","color":"#55b8ad","shape":"site","sub":"cookinginchinglish.com","note":"Taiwanese home recipes from Edwina, who grew up in Taiwan.","url":"https://cookinginchinglish.com","suggested":true,"kind":"blog"}]},{"h":"More from Chinese cuisine","links":[["Almond biscuit","dish/almond-biscuit"],["Banana roll","dish/banana-roll"],["Baozi","dish/baozi"],["Bear paw","dish/bear-paw"],["Black sesame roll","dish/black-sesame-roll"],["Century egg","dish/century-egg"],["Cha siu bao","dish/cha-siu-bao"],["Chinese restaurant","dish/