mmons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Ciabatta_cut.JPG"}},"dish/echpochmak":{"t":"dish","r":"dish/echpochmak","n":"Echpochmak","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Echpochmak, ocpocmaq, ochpochmaq, ochpochmak, uchpochmak, oechpochmaq, uchpuchmak, ucpucmak or treugolnik is a Tatar and Bashkir national dish, an essential food in Tatar and Bashkir culture. It is a triangular turnover, filled with chopped meat, onion and potatoes. Echpochmak is usually eaten with bouillon or with tea."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-echpochmak"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Echpochmak"}],"sections":[{"h":"Where it's from","links":[["Bashkir cuisine","cuisine/bashkir-cuisine"],["Tatar cuisine","cuisine/tatar-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Onion","ingredient/onion"],["Potato","ingredient/potato"]]},{"h":"More from Bashkir cuisine","links":[["Beshbarmak","dish/beshbarmak"],["Peremech","dish/peremech"],["Pilaf","dish/pilaf"],["Qazı","dish/qaz"],["Qistibi","dish/qistibi"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/d4/Echpochmak2.jpg/500px-Echpochmak2.jpg","w":500,"h":375,"by":"Qweasdqwe","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Echpochmak2.jpg"}},"ingredient/haddock":{"t":"ingredient","r":"ingredient/haddock","n":"Haddock","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The haddock (Melanogrammus aeglefinus) is a saltwater ray-finned fish from the family Gadidae, the true cods. It is the only species in the monotypic genus Melanogrammus. It is found in the North Atlantic Ocean and associated seas, where it is an important species for fisheries, especially in northern Europe, where it is marketed fresh, frozen and smoked; smoked varieties include the Finnan haddie and the Arbroath smokie.  Other smoked versions include long boneless, the filleted side of larger haddock smoked in oak chips with the skin left on the fillet."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-haddock"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Haddock"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Scottish cuisine","cuisine/scottish-cuisine",[["Finnan haddie","dish/finnan-haddie"]]]]}],"img":{"src":"/labs/cuisines/img/thumb/4/4d/Haddock%2C_Boston_Aquarium.JPG/500px-Haddock%2C_Boston_Aquarium.JPG","w":500,"h":332,"by":"Steven G. Johnson","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Haddock%2C_Boston_Aquarium.JPG"}},"dish/marinara-sauce":{"t":"dish","r":"dish/marinara-sauce","n":"Marinara sauce","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["Marinara sauce is a tomato sauce usually made with tomatoes, garlic, herbs, and onions. Variations include capers, olives, spices, and a dash of wine. Widely used in Italian-American cuisine, it is known as alla marinara  ('sailor's style') in its native Italy, where it is typically made with tomatoes, basil, olive oil, garlic, and oregano, but also sometimes with olives, capers, and salted anchovies. It is used for spaghetti and vermicelli, but also with meat or fish."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-marinara-sauce"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Marinara_sauce"}],"sections":[{"h":"Where it's from","links":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Basil","ingredient/basil"],["Garlic","ingredient/garlic"],["Onion","ingredient/onion"],["Oregano","ingredient/oregano"],["Tomato","ingredient/tomato"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's