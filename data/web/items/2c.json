{"cuisine/caspian-cuisine":{"t":"cuisine","r":"cuisine/caspian-cuisine","n":"Caspian cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Iranian cuisine","cuisine/iranian-cuisine"]],"sub":"Regional cuisine in Iran","intro":[["Caspian cuisine is a regional cuisine found in Northern Iran, primarily found in the Mazandaran, Gilan, Alborz, and Golestan provinces. The recipes are diverse, just like the region's landscape. Nature in the Mazandaran region of Iran is distinct and varied sections with a mixture of coastal, plains, prairies, forests, and rainforests. The Mazandarani cuisine of coastal regions is very different from that of mountainous regions since people settled in the Alborz usually use indigenous herbs, while coastal populations prepare dishes using local fish and Caspian (Mazan) rice with vegetables."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"caspian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Caspian_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Iranian cuisine","cuisine/iranian-cuisine"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"Cooking in Iran: Regional Recipes & Kitchen Secrets","color":"#f0b340","shape":"book","sub":"Najmieh Batmanglij","note":"Region-by-region survey of Iranian cooking, including the Caspian provinces of Gilan and Mazandaran.","url":"https://www.najmieh.com/?p=87","suggested":true}]},{"h":"Part of","links":[["Iranian cuisine","cuisine/iranian-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/thumb/8/8e/Shomal-Iran.png/500px-Shomal-Iran.png","w":500,"h":460,"by":"Nima Farid","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Shomal-Iran.png"}},"cuisine/mangalorean-catholic-cuisine":{"t":"cuisine","r":"cuisine/mangalorean-catholic-cuisine","n":"Mangalorean Catholic cuisine","c":"#f0b340","crumb":[["Christian diet","cuisine/christian-dietary-laws"]],"sub":"Religious cuisine or diet in India","intro":[["Mangalorean Catholic cuisine is the cuisine of the Mangalorean Catholic community which is an important aspect of the culture of Mangalorean Catholics."],["Mangalorean Catholics are Catholic Christians from Mangalore and the rest of the historical South Canara area by the southern coast of present-day Karnataka, India. Most Mangalorean Catholics share ancestry with Goan Catholics, as they migrated from Portuguese Goa to the Keladi Kingdom, between 1560 and 1763, following their Christianisation. The migrations continued during the Portuguese Inquisition, the Mahratta Invasion of Goa and Bombay etc. After their migrations, they adopted some aspects of local Mangalorean culture, but also retained some elements of their Konkani way of life."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"mangalorean-catholic-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mangalorean_Catholic_cuisine"}],"sections":[{"h":"Recipe sites","count":1,"rows":[{"name":"Ruchik Randhap","color":"#55b8ad","shape":"site","sub":"ruchikrandhap.com","note":"Mangalore-raised Shireen Sequeira's blog, strong on Mangalorean Catholic dishes alongside other Mangalorean communities.","url":"https://www.ruchikrandhap.com/recipes","suggested":true,"kind":"blog"}]},{"h":"Cookbooks","count":1,"rows":[{"name":"Jane DSouza's Cook Book","color":"#f0b340","shape":"book","sub":"Jane D'Souza, 2004","note":"Collection of 480 recipes, 109 of them Mangalorean Catholic; publisher not confirmed.","url":"","suggested":true}]},{"h":"Part of","links":[["Christian diet","cuisine/christian-dietary-laws"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/thumb/e/ef/Pan-fried-fish.jpg/500px-Pan-fried-fish.jpg","w":500,"h":375,"by":"madhukar pai","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Pan-fried-fish.jpg"}},"dish/banana-bread":{"t":"dish","r":"dish/banana-bread","n":"Banana bread","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["Banana bread is a type of sweet bread or cake made from mashed bananas. Banana bread is typically classified as a quick bread, relying on chemical leavening agents such as baking soda or baking powder rather than yeast, which allows it to be prepared without fermentation. It is often a moist and sweet quick bread, but some recipes are yeast raised. Its sweet taste and slightly crumbly texture make it more akin to a tea cake or muffin than bread."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-banana-bread"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Banana_bread"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Banana","ingredient/banana"],["Sugar","ingredient/sugar"],["Wheat","ingredient/wheat"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"More from American cuisine","links":[["Angel food cake","dish/angel-food-cake"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Beer cake","dish/beer-cake"],["Better than sex cake","dish/better-than-sex-cake"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Brown Betty (dessert)","dish/brown-betty-dessert"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Butter cake","dish/butter-cake"],["Caesar salad","dish/caesar-salad"],["Caramel apple","dish/caramel-apple"],["Carbonara","dish/carbonara"],["Cheesesteak","dish/cheesesteak"],["Chicago-style hot dog","dish/chicago-style-hot-dog"],["Chicken nugget","dish/chicken-nugget"],["Chiffon cake","dish/chiffon-cake"],["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Chow-chow (food)","dish/chow-chow-food"],["Chowder","dish/chowder"],["Cioppino","dish/cioppino"],["Clam chowder","dish/clam-chowder"],["Clam dip","dish/clam-dip"],["Club sandwich","dish/club-sandwich"],["Cobb salad","dish/cobb-salad"],["Cobbler (food)","dish/cobbler-food"],["Cook's Corner","dish/cook-s-corner"],["Crab cake","dish/crab-cake"],["Croffle","dish/croffle"],["Dagwood Bumstead","dish/dagwood-bumstead"],["Dagwood sandwich","dish/dagwood-sandwich"],["Deep-dish pizza","dish/deep-dish-pizza"],["Desperation pie","dish/desperation-pie"],["Dirty rice","dish/dirty-rice"],["Donut hole","dish/donut-hole"],["Egg in the basket","dish/egg-in-the-basket"],["Fish and chips","dish/fish-and-chips"],["Fritter","dish/fritter"]]}],"img":{"src":"/labs/cuisines/img/7/7e/Banananutbread.jpg","w":500,"h":500,"by":"Unknown author","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Banananutbread.jpg"}},"ingredient/dijon-mustard":{"t":"ingredient","r":"ingredient/dijon-mustard","n":"Dijon mustard","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 3 cuisines","intro":[["Dijon mustard is a traditional mustard from France. It is named after the city of Dijon in Burgundy, which was the center of mustard making in the late Middle Ages and was granted exclusive rights in France in the 17th century. First used in 1336 for the table of King Philip VI, it assumed its current form in 1856 when Jean Naigeon of Dijon replaced the vinegar usually used in prepared mustard with verjuice, the acidic juice of unripe grapes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-dijon-mustard"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Dijon_mustard"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["American cuisine","cuisine/american-cuisine",[["Caesar salad","dish/caesar-salad"]]],["Italian cuisine","cuisine/italian-cuisine",[["Caesar salad","dish/caesar-salad"]]],["Russian cuisine","cuisine/russian-cuisine",[["Caesar salad","dish/caesar-salad"]]]]},{"h":"Often cooked with","links":[["Anchovy","ingredient/anchovy"],["Black pepper","ingredient/black-pepper"],["Crouton","ingredient/crouton"],["Egg","ingredient/egg"],["Lemon juice","ingredient/lemon-juice"],["Olive oil","ingredient/olive-oil"],["Parmesan","ingredient/parmesan"],["Parmigiano-Reggiano","ingredient/parmigiano-reggiano"],["Romaine lettuce","ingredient/romaine-lettuce"],["Worcestershire sauce","ingredient/worcestershire-sauce"]]}],"img":{"src":"/labs/cuisines/img/thumb/3/3c/Dijon_mustard_on_a_spoon_-_20051218.jpg/500px-Dijon_mustard_on_a_spoon_-_20051218.jpg","w":500,"h":375,"by":"Rainer Zenz.","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Dijon_mustard_on_a_spoon_-_20051218.jpg"}},"ingredient/profiterole":{"t":"ingredient","r":"ingredient/profiterole","n":"Profiterole","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["A profiterole, or chou à la crème (French: [ʃu a la kʁɛm]), known as a cream puff in the US and Canada, is a filled French choux pastry ball with a typically sweet and moist filling of whipped cream, custard, pastry cream, or ice cream. They may be garnished with chocolate sauce, caramel, or a dusting of powdered sugar."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-profiterole"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Profiterole"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["French cuisine","cuisine/french-cuisine",[["Croquembouche","dish/croquembouche"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Croquembouche","dish/croquembouche"]]]]},{"h":"Often cooked with","links":[["Caramel","ingredient/caramel"],["Profiteroles","ingredient/profiteroles"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/75/Paris_2e_-_Rue_Vivienne_-_Restaurant_Le_Vaudeville_-_Profiteroles_au_chocolat.jpg/500px-Paris_2e_-_Rue_Vivienne_-_Restaurant_Le_Vaudeville_-_Profiteroles_au_chocolat.jpg","w":500,"h":375,"by":"Romainbehar","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Paris_2e_-_Rue_Vivienne_-_Restaurant_Le_Vaudeville_-_Profiteroles_au_chocolat.jpg"}},"dish/es-goyobod":{"t":"dish","r":"dish/es-goyobod","n":"Es goyobod","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Es goyobod is an Sundanese drink from Indonesia. The origin of coconut milk based cold beverage similar to es campur.  It is made with shaved ice, coconut milk, sugar syrup, and jellied mung bean starch known as hunkwe. Other ingredients may include avocado and shredded coconut."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-es-goyobod"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Es_goyobod"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Basil","ingredient/basil"],["Cucumis melo","ingredient/cucumis-melo"],["Ice","ingredient/ice"],["Rice flour","ingredient/rice-flour"],["Syrup","ingredient/syrup"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true,"kind":"blog"}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"],["Gepuk","dish/gepuk"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/8e/Goyobod_Subang.jpg/500px-Goyobod_Subang.jpg","w":500,"h":500,"by":"Afrogindahood","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Goyobod_Subang.jpg"}},"ingredient/desiccated-coconut":{"t":"ingredient","r":"ingredient/desiccated-coconut","n":"Desiccated coconut","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["The coconut (Cocos nucifera) is a member of the palm family (Arecaceae) and the only living species of the genus Cocos. The term \"coconut\" (or the archaic \"cocoanut\") can denote the whole coconut palm tree or the large hard fruit. Originally native to the Southeast Asia, New Guinea, and the Southwestern Pacific, they are ubiquitous in coastal tropical regions."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-desiccated-coconut"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Desiccated_coconut"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Afrikaner cuisine","cuisine/afrikaner-cuisine",[["Hertzoggie","dish/hertzoggie"]]],["South African cuisine","cuisine/south-african-cuisine",[["Hertzoggie","dish/hertzoggie"]]]]},{"h":"Often cooked with","links":[["Apricot jam","ingredient/apricot-