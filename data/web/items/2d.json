rospective","suggested":true,"kind":"blog"},{"name":"Cuisine Helvetica","color":"#55b8ad","shape":"site","sub":"cuisinehelvetica.com","note":"Heddi Nieuwsma's Swiss recipes and food culture from her life in Switzerland.","url":"https://cuisinehelvetica.com/swiss-recipes","suggested":true,"kind":"blog"}]},{"h":"More from Swiss cuisine","links":[["Basler Läckerli","dish/basler-lackerli"],["Birnbrot","dish/birnbrot"],["Bündnerfleisch","dish/bundnerfleisch"],["Cabbage roll","dish/cabbage-roll"],["Carac (pastry)","dish/carac-pastry"],["Cervelat","dish/cervelat"],["Cholera (food)","dish/cholera-food"],["Egg puffs and soup pearls","dish/egg-puffs-and-soup-pearls"],["Landjäger","dish/landjager"],["Leberkäse","dish/leberkase"],["Raclette","dish/raclette"],["Riz Casimir","dish/riz-casimir"],["Schenkele","dish/schenkele"],["Spätzle","dish/spatzle"],["Swiss sausages and cured meats","dish/swiss-sausages-and-cured-meats"],["Wähe","dish/wahe"],["Zopf","dish/zopf"],["Zuger Kirschtorte","dish/zuger-kirschtorte"],["Zürcher Geschnetzeltes","dish/zurcher-geschnetzeltes"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/80/%C3%84lplermagronen.JPG/500px-%C3%84lplermagronen.JPG","w":500,"h":472,"by":"Pakeha","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%C3%84lplermagronen.JPG"}}}