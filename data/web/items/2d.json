{"cuisine/komi-cuisine":{"t":"cuisine","r":"cuisine/komi-cuisine","n":"Komi cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Russian cuisine","cuisine/russian-cuisine"]],"sub":"Regional cuisine in Russia","intro":[["Komi cuisine consists of the cuisine of the Komi Republic and the Komi peoples, and is characterized by the rich use of local foods."],["Significant differences separate Komis' dining preferences in the northern and southern regions of their homeland. In the northern reindeer herding and hunting areas, meat is eaten daily, but it is not in the more agricultural south. In the south, fish is commonly eaten; hogs and poultry are eaten less often."],["Komi women bake fish pie on festive family occasions. The Fish Pie Festival (Komi: Черинянь гаж) is held annually on the last Sunday of June in the village of Byzovaya, Pechora Raion."],["Traditional Komi beverages include kvas and sur, a type of ale."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"komi-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Komi_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Russian cuisine","cuisine/russian-cuisine"]]},{"h":"Dishes","count":1,"links":[["Sur (Komi beverage)","dish/sur-komi-beverage"]]},{"h":"Part of","links":[["Russian cuisine","cuisine/russian-cuisine"]]}],"cont":"Asian cuisine"},"ingredient/scrambled-eggs":{"t":"ingredient","r":"ingredient/scrambled-eggs","n":"Scrambled eggs","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Scrambled eggs is a culinary dish made from eggs (usually chicken eggs), where the whites and yolks have been stirred, whipped, or beaten together (typically with the addition of other ingredients), then heated so that the proteins denature and coagulate, and they form into \"curds\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-scrambled-eggs"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Scrambled_eggs"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Indian cuisine","cuisine/indian-cuisine",[["Akuri","dish/akuri"]]],["Iranian cuisine","cuisine/iranian-cuisine",[["Akuri","dish/akuri"]]]]},{"h":"Often cooked with","links":[["Mentha","ingredient/mentha"],["Scrambled egg","ingredient/scrambled-egg"]]}]},"ingredient/bamboo-shoot":{"t":"ingredient","r":"ingredient/bamboo-shoot","n":"Bamboo shoot","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 4 dishes across 3 cuisines","intro":[["Bamboo shoots or bamboo sprouts are the edible shoots (new bamboo culms that come out of the ground) of many bamboo species including Bambusa vulgaris and Phyllostachys edulis. They are used as vegetables in numerous Asian dishes and broths. They are sold in various processed shapes and are available in fresh, dried, and canned versions."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-bamboo-shoot"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bamboo_shoot"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Bubur pedas","dish/bubur-pedas"],["Lumpia semarang","dish/lumpia-semarang"]]],["Cantonese cuisine","cuisine/cantonese-cuisine",[["Har gow","dish/har-gow"]]],["Taiwan cuisine","cuisine/taiwan-cuisine",[["Bah-uân","dish/bah-uan"]]]]},{"h":"Often cooked with","links":[["Chicken","ingredient/chicken"],["Rice","ingredient/rice"],["Sweet potato","ingredient/sweet-potato"],["Dried shrimp","ingredient/dried-shrimp"],["Shrimp","ingredient/shrimp"],["Corn starch","ingredient/corn-starch"],["Pork","ingredient/pork"],["Shiitake","ingredient/shiitake"],["Wheat flour","ingredient/wheat-flour"],["Anchovy","ingredient/anchovy"],["Bean curd","ingredient/bean-curd"],["Bumbu (seasoning)","ingredient/bumbu-seasoning"],["Caraway seed","ingredient/caraway-seed"],["Carrots","ingredient/carrots"],["Chili pepper","ingredient/chili-pepper"],["Coconut","ingredient/coconut"]]}]},"ingredient/illicium-verum":{"t":"ingredient","r":"ingredient/illicium-verum","n":"Illicium verum","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 3 cuisines","intro":[["Illicium verum (star anise or badian, Chinese star anise, star anise seed, star aniseed and star of anise) is a medium-sized evergreen tree native to South China and northeast Vietnam. Its star-shaped pericarp fruits harvested just before ripening are a spice that closely resembles anise in flavor. Its primary production country is China, followed by Vietnam and other Southeast Asian countries. Star anise oil is highly fragrant, used in cooking, perfumery, soaps, toothpastes, mouthwashes, and skin creams. Until 2012, when it switched to using genetically modified E. coli, Roche Pharmaceuticals used up to 90% of the world's annual star anise crop to produce oseltamivir (Tamiflu) via shikimic acid."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-illicium-verum"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Illicium_verum"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Bir pletok","dish/bir-pletok"],["Rendang","dish/rendang"]]],["Betawi cuisine","cuisine/betawi-cuisine",[["Bir pletok","dish/bir-pletok"]]],["Padang food","cuisine/padang-food",[["Rendang","dish/rendang"]]]]},{"h":"Often cooked with","links":[["Lemongrass","ingredient/lemongrass"],["Biancaea sappan","ingredient/biancaea-sappan"],["Cardamom","ingredient/cardamom"],["Cinnamon","ingredient/cinnamon"],["Ginger","ingredient/ginger"],["Nigella sativa","ingredient/nigella-sativa"],["Pandan","ingredient/pandan"],["Piper retrofractum","ingredient/piper-retrofractum"],["Sugar","ingredient/sugar"],["Beef","ingredient/beef"],["Candlenut","ingredient/candlenut"],["Chicken","ingredient/chicken"],["Chili pepper","ingredient/chili-pepper"],["Coconut cream","ingredient/coconut-cream"],["Coconut milk","ingredient/coconut-milk"],["Garcinia atroviridis","ingredient/garcinia-atroviridis"]]}]},"ingredient/baking-powder":{"t":"ingredient","r":"ingredient/baking-powder","n":"Baking powder","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 6 dishes across 10 cuisines","intro":[["Baking powder is a dry chemical leavening agent, a mixture of a carbonate or bicarbonate and a weak acid. The base and acid are prevented from reacting prematurely by the inclusion of a desiccant such as cornstarch. Baking powder is used to increase the volume and lighten the texture of baked goods. It works by releasing carbon dioxide gas into a batter or dough through an acid–base reaction, causing bubbles in the wet mixture to expand and thus leavening the mixture."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-baking-powder"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Baking_powder"}],"sections":[{"h":"Where it's cooked with","count":10,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Kue ape","dish/kue-ape"],["Kue leker","dish/kue-leker"]]],["American cuisine","cuisine/american-cuisine",[["Chiffon cake","dish/chiffon-cake"]]],["British cuisine","cuisine/british-cuisine",[["Spotted dick","dish/spotted-dick"]]],["Dutch cuisine","cuisine/dutch-cuisine",[["Oliebol","dish/oliebol"]]],["Egyptian cuisine","cuisine/egyptian-cuisine",[["Qatayef","dish/qatayef"]]],["Jordanian cuisine","cuisine/jordanian-cuisine",[["Qatayef","dish/qatayef"]]],["Lebanese cuisine","cuisine/lebanese-cuisine",[["Qatayef","dish/qatayef"]]],["Levantine cuisine","cuisine/levantine-cuisine",[["Qatayef","dish/qatayef"]]],["Palestinian cuisine","cuisine/palestinian-cuisine",[["Qatayef","dish/qatayef"]]],["Syrian cuisine","cuisine/syrian-cuisine",[["Qatayef","dish/qatayef"]]]]},{"h":"Often cooked with","links":[["Wheat flour","ingredient/wheat-flour"],["Sugar","ingredient/sugar"],["Milk","ingredient/milk"],["Egg","ingredient/egg"],["Yeast","ingredient/yeast"],["Coconut m