t's from","links":[["Yoshoku","cuisine/yoshoku"]]},{"h":"Ingredients","count":3,"links":[["Pilaf","ingredient/pilaf"],["Spaghetti","ingredient/spaghetti"],["Tonkatsu","ingredient/tonkatsu"]]},{"h":"More from Yoshoku","links":[["Chicken katsu","dish/chicken-katsu"],["Cream stew","dish/cream-stew"],["Doria (food)","dish/doria-food"],["Hayashi rice","dish/hayashi-rice"],["Menchi-katsu","dish/menchi-katsu"],["Naporitan","dish/naporitan"],["Tonkatsu","dish/tonkatsu"],["Volga rice","dish/volga-rice"]]}],"img":{"src":"/world-cuisine/img/thumb/6/68/Toruko_rice_Cafe_Olympic.jpg/500px-Toruko_rice_Cafe_Olympic.jpg","w":500,"h":375,"by":"Totti","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Toruko_rice_Cafe_Olympic.jpg"}},"dish/zhizhig-galnash":{"t":"dish","r":"dish/zhizhig-galnash","n":"Zhizhig-galnash","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Chechen cuisine","dot":"#f0b340","intro":[["Zhizhig-galnash is a traditional Chechen dish consisting of boiled meat and dumplings, which are cooked in the flavorful broth made from beef, chicken or lamb."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-zhizhig-galnash"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Zhizhig-galnash"}],"sections":[{"h":"Where it's from","links":[["Chechen cuisine","cuisine/chechen-cuisine"]]},{"h":"More from Chechen cuisine","links":[["Blini","dish/blini"],["Khingalsh","dish/khingalsh"],["Vieta (dish)","dish/vieta-dish"]]}],"img":{"src":"/world-cuisine/img/thumb/2/2b/%D0%96%D0%B8%D0%B6%D0%B8%D0%B3-%D0%B3%D0%B0%D0%BB%D0%BD%D0%B0%D1%88_%28%D1%84%D0%B0%D0%B9%D0%BB_1%29.jpg/500px-%D0%96%D0%B8%D0%B6%D0%B8%D0%B3-%D0%B3%D0%B0%D0%BB%D0%BD%D0%B0%D1%88_%28%D1%84%D0%B0%D0%B9%D0%BB_1%29.jpg","w":500,"h":375,"by":"Rocky Jaguar","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:%D0%96%D0%B8%D0%B6%D0%B8%D0%B3-%D0%B3%D0%B0%D0%BB%D0%BD%D0%B0%D1%88_(%D1%84%D0%B0%D0%B9%D0%BB_1).jpg"}},"dish/tesguino":{"t":"dish","r":"dish/tesguino","n":"Tesgüino","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Rarámuri foodways","dot":"#94bd5c","intro":[["A thick, mildly alcoholic beer of sprouted ",["corn","ingredient/maize"],", called sowiki or batari by the ",["Rarámuri","cuisine/raramuri-foodways"],". Women sprout and grind the corn, boil it for 10 to 12 hours and ferment it in clay pots over a week or more, and it's shared when neighbors gather to work, heal, plant, harvest or mourn."]],"src":"note","sources":[{"name":"La Jornada del Campo, Sowiki, la bebida rarámuri","url":"https://www.jornada.com.mx/2015/05/16/cam-bebida.html"}],"actions":[{"kind":"globe","hash":"dish-tesguino"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tesg%C3%BCino"}],"sections":[{"h":"Where it's from","links":[["Rarámuri foodways","cuisine/raramuri-foodways"]]},{"h":"Ingredients","count":1,"links":[["Maize","ingredient/maize"]]},{"h":"More from Rarámuri foodways","links":[["Pinole","dish/pinole"]]}]}}