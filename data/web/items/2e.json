"cuisine/peruvian-cuisine",[["Chicha morada","dish/chicha-morada"]]]]}],"img":{"src":"/world-cuisine/img/thumb/e/e1/Maizmorado.png/500px-Maizmorado.png","w":500,"h":199,"by":"Malosh","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Maizmorado.png"}},"dish/custard":{"t":"dish","r":"dish/custard","n":"Custard","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Ukrainian cuisine","dot":"#cf5f87","intro":[["Custard is a variety of culinary preparations based on sweetened milk, cheese, or cream cooked with egg or egg yolk to thicken it, and sometimes also flour, corn starch, or gelatin. Depending on the recipe, custard may vary in consistency from a thin pouring sauce (crème anglaise) to the thick pastry cream (crème pâtissière) used to fill éclairs. The most common custards are used in custard desserts or dessert sauces and typically include sugar and vanilla; however, savory custards are also found, e.g., in quiche."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-custard"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Custard"}],"sections":[{"h":"Where it's from","links":[["Ukrainian cuisine","cuisine/ukrainian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Milk","ingredient/milk"],["Sugar","ingredient/sugar"],["Vanilla","ingredient/vanilla"]]},{"h":"Cook it","rows":[{"name":"Savas Kitchen: Ukrainian recipes","color":"#55b8ad","shape":"site","sub":"savaskitchen.com","note":"Ukrainian-born home cook Nataliia Savas's section of family Ukrainian recipes.","url":"https://savaskitchen.com/category/ukrainian-recipes","suggested":true,"kind":"blog"}]},{"h":"More from Ukrainian cuisine","links":[["Angel wings","dish/angel-wings"],["Aspic","dish/aspic"],["Baba (cake)","dish/baba-cake"],["Banosh","dish/banosh"],["Blini","dish/blini"],["Borscht","dish/borscht"],["Cabbage roll","dish/cabbage-roll"],["Cabbage soup","dish/cabbage-soup"],["Candy","dish/candy"],["Cold beet s