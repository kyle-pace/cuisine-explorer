"]]}]},"ingredient/gianduja":{"t":"ingredient","r":"ingredient/gianduja","n":"Gianduja","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Gianduja or gianduia is a homogeneous blend of chocolate with 30% hazelnut paste, invented in Turin during Napoleon's regency. It can be consumed in the form of bars or as a filling for chocolates, but it is most notably sold in the form of gianduiotti."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-gianduja"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Gianduja_(chocolate)"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Italian cuisine","cuisine/italian-cuisine",[["Torta setteveli","dish/torta-setteveli"]]]]},{"h":"Often cooked with","links":[["Almond","ingredient/almond"],["Chocolate","ingredient/chocolate"],["Hazelnut","ingredient/hazelnut"],["Nougat","ingredient/nougat"],["Theobroma cacao","ingredient/theobroma-cacao"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b9/Gianduiotti.jpg/500px-Gianduiotti.jpg","w":500,"h":269,"by":"Clop","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Gianduiotti.jpg"}},"ingredient/roast-chicken":{"t":"ingredient","r":"ingredient/roast-chicken","n":"Roast chicken","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Roast chicken is chicken prepared as food by roasting whether in a home kitchen, over a fire, or with a rotisserie (rotary spit). Generally, the chicken is roasted with its own fat and juices by circulating the meat during roasting, and therefore, is usually cooked exposed to fire or heat with some type of rotary grill so that the circulation of these fats and juices is as efficient as possible. Roast chicken is a dish that appears in a wide variety of cuisines worldwide."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-roast-chicken"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Roast_chicken"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["South Korean cuisine","cuisine/south-korean-cuisine",[["Yangnyeom chicken","dish/yangnyeom-chicken"]]]]}],"img":{"src":"/labs/cuisines/img/thumb/d/d9/Max%27s_Roasted_Chicken_-_Evan_Swigart.jpg/500px-Max%27s_Roasted_Chicken_-_Evan_Swigart.jpg","w":500,"h":753,"by":"Evan Swigart from Chicago, USA","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Max's_Roasted_Chicken_-_Evan_Swigart.jpg"}},"ingredient/bison":{"t":"ingredient","r":"ingredient/bison","n":"Bison","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["For the ",["Lakota","cuisine/lakota-foodways"]," and other Plains nations, bison gives food, clothing, shelter and tools. The meat is dried, and pounded with fat and berries into ",["Pemmican","dish/pemmican"],". The InterTribal Buffalo Council's 89 member nations are bringing herds back, and many share the meat with elders and families."]],"src":"note","sources":[{"name":"North Dakota Studies, The Lakota bison hunt","url":"https://www.ndstudies.gov/gr8/node/261"},{"name":"Native News Online, Buffalo return","url":"https://nativenewsonline.net/currents/buffalo-return-new-herd-report-shows-more-than-25000-buffalo-on-tribal-lands"}],"actions":[{"kind":"globe","hash":"ingredient-bison"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bison"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Lakota foodways","cuisine/lakota-foodways",[["Pemmican","dish/pemmican"]]],["Métis foodways","cuisine/metis-foodways",[["Pemmican","dish/pemmican"]]]]},{"h":"Often cooked with","links":[["Animal fats and oils","ingredient/animal-fats-and-oils"],["Berry","ingredient/berry"]]},{"h":"Mentioned in","links":[["Lakota foodways","cuisine/lakota-foodways"],["Métis foodways","cuisine/metis-foodways"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/8d/