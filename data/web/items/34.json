sselrode-pudding"]]],["Swiss cuisine","cuisine/swiss-cuisine",[["Zuger Kirschtorte","dish/zuger-kirschtorte"]]]]},{"h":"Often cooked with","links":[["Icing","ingredient/icing"],["Succade","ingredient/succade"],["Sugar","ingredient/sugar"],["Meringue","ingredient/meringue"],["Egg yolk","ingredient/egg-yolk"],["Chocolate","ingredient/chocolate"],["Jam","ingredient/jam"],["Candied peel","ingredient/candied-peel"],["Ceramic glaze","ingredient/ceramic-glaze"],["Fruit juice","ingredient/fruit-juice"],["Liqueur","ingredient/liqueur"],["Marzipan","ingredient/marzipan"],["Ricotta","ingredient/ricotta"],["Caramel","ingredient/caramel"],["Cream","ingredient/cream"],["Cherry","ingredient/cherry"]]}],"img":{"src":"/world-cuisine/img/thumb/8/80/Victoria_Sponges.jpg/500px-Victoria_Sponges.jpg","w":500,"h":332,"by":"euphro","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Victoria_Sponges.jpg"}},"ingredient/almond-meal":{"t":"ingredient","r":"ingredient/almond-meal","n":"Almond meal","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 4 cuisines","intro":[["Almond meal, almond flour or ground almond is made from ground sweet almonds. Almond flour is usually made with blanched almonds (no skin), whereas almond meal can be made with whole or blanched almonds. The consistency is more like corn meal than wheat flour."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-almond-meal"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Almond_meal"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["French cuisine","cuisine/french-cuisine",[["Calisson","dish/calisson"],["Gâteau Basque","dish/gateau-basque"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Calisson","dish/calisson"],["Gâteau Basque","dish/gateau-basque"]]],["Basque cuisine","cuisine/basque-cuisine",[["Gâteau Basque","dish/gateau-basque"]]],["Galician cuisine","cuisine/galician-cuisine",[["Tarta de Santiago","dish/tarta-de-santiago"]]]]},{"h":"Often cooked with","links":[["Almond","ingredient/almond"],["Butter","ingredient/butter"],["Egg","ingredient/egg"],["Candied fruit","ingredient/candied-fruit"],["Fondant icing","ingredient/fondant-icing"],["Melon","ingredient/melon"],["Syrup","ingredient/syrup"],["Almond flour","ingredient/almond-flour"],["Fruit preserves","ingredient/fruit-preserves"],["Pastry cream","ingredient/pastry-cream"],["Cinnamomum verum","ingredient/cinnamomum-verum"],["Powdered sugar","ingredient/powdered-sugar"],["Sherry","ingredient/sherry"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/world-cuisine/img/thumb/1/11/Almond_meal_by_hand.jpg/500px-Almond_meal_by_hand.jpg","w":500,"h":375,"by":"Yun Huang Yong","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Almond_meal_by_hand.jpg"}},"dish/donkey-burger":{"t":"dish","r":"dish/donkey-burger","n":"Donkey burger","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Chinese cuisine","dot":"#f0b340","intro":[["Lürou Huoshao is a kind of sandwich commonly eaten in Baoding and Hejian, Hebei Province, China, where it is considered a local specialty, though it may also be found in other parts of China, particularly in Northeastern China. Chopped or shredded donkey meat or offal is placed within a huǒshāo or shao bing, a roasted, semi-flaky bread pocket, and eaten as a snack or as part of a meal. Hejian style typically serves the meat cold in a warm huoshao while Baoding style serves the meat hot; both often include green chili-pepper and coriander leaves. Lurou Huoshao is a popular street food and can also be found on the menus of high-end restaurants. In recent years, the price of donkey meat has risen as China's donkey numbers have fallen sharply."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-donkey-burger"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Donkey_burger"}],"sections":[{"h":"Where it's from","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Donkey","ingredient/donkey"],["Donkey meat","ingredient/donkey-meat"],["Shaobing","ingredient/shaobing"]]},{"h":"Cook it","rows":[{"name":"The Woks of Life","color":"#55b8ad","shape":"site","sub":"thewoksoflife.com","note":"Chinese and Chinese American recipes from the Leung family, running since 2013.","url":"https://thewoksoflife.com/","suggested":true,"kind":"blog"},{"name":"Chinese Cooking Demystified","color":"#55b8ad","shape":"site","sub":"youtube.com","note":"Technique-heavy YouTube channel on regional Chinese home and restaurant cooking.","url":"https://www.youtube.com/@ChineseCookingDemystified","suggested":true,"kind":"youtube"},{"name":"Red House Spice","color":"#55b8ad","shape":"site","sub":"redhousespice.com","note":"Classic Chinese recipes from Wei Guo, who grew up in Gansu, blogging since 2017.","url":"https://redhousespice.com/about/","suggested":true,"kind":"blog"}]},{"h":"More from Chinese cuisine","links":[["Almond biscuit","dish/almond-biscuit"],["Banana roll","dish/banana-roll"],["Baozi","dish/baozi"],["Bear paw","dish/bear-paw"],["Black sesame roll","dish/black-sesame-roll"],["Century egg","dish/century-egg"],["Cha siu bao","dish/cha-siu-bao"],["Chinese restaurant","dish/chinese-restaurant"],["Dandan noodles","dish/dandan-noodles"],["Dapanji","dish/dapanji"],["Dong'an chicken","dish/dong-an-chicken"],["Dongpo pork","dish/dongpo-pork"],["Doujiang","dish/doujiang"],["Drunken shrimp","dish/drunken-shrimp"],["Edible bird's nest","dish/edible-bird-s-nest"],["Fuqi feipian","dish/fuqi-feipian"],["Gaifan","dish/gaifan"],["Goubuli","dish/goubuli"],["Hainanese chicken rice","dish/hainanese-chicken-rice"],["Hog maw","dish/hog-maw"],["Hong dou tang","dish/hong-dou-tang"],["Hot dry noodles","dish/hot-dry-noodles"],["Hot pot","dish/hot-pot"],["Huangqiao sesame cake","dish/huangqiao-sesame-cake"],["Imitation shark fin soup","dish/imitation-shark-fin-soup"],["Jiaozi","dish/jiaozi"],["Jiuqu","dish/jiuqu"],["Kung Pao chicken","dish/kung-pao-chicken"],["Lanzhou beef noodles","dish/lanzhou-beef-noodles"],["Liangfen","dish/liangfen"],["Lo mai chi","dish/lo-mai-chi"],["Mao xue wang","dish/mao-xue-wang"],["Mapo tofu","dish/mapo-tofu"],["Mianwo","dish/mianwo"],["Miso soup","dish/miso-soup"],["Orange cuttlefish","dish/orange-cuttlefish"],["Osmanthus cake","dish/osmanthus-cake"],["Pickled egg","dish/pickled-egg"],["Pilaf","dish/pilaf"],["Red braised pork belly","dish/red-braised-pork-belly"]]}],"img":{"src":"/world-cuisine/img/thumb/8/8e/Donkey_sandwich%2C_Baoding_style_%2820160310111719%29.jpg/500px-Donkey_sandwich%2C_Baoding_style_%2820160310111719%29.jpg","w":500,"h":375,"by":"N509FZ","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Donkey_sandwich%2C_Baoding_style_(20160310111719).jpg"}},"dish/el-adobe-de-capistrano":{"t":"dish","r":"dish/el-adobe-de-capistrano","n":"El Adobe de Capistrano","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Mexican cuisine","dot":"#94bd5c","intro":[["El Adobe de Capistrano, or El Adobe, is a restaurant located in at 31891 Camino Capistrano in San Juan Capistrano, California. It has been operated since 1948 and is in a building composed of two historic adobes near Mission San Juan Capistrano.  It is also notable for being frequented by and being a favorite of U.S. President Richard Nixon who lived in nearby San Clemente. Now El Adobe is a California historical landmark."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-el-adobe-de-capistrano"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/El_Adobe_de_Capistrano"}],"sections":[{"h":"Where it's from","links":[["Mexican cuisine","cuisine/mexican-cuisine"]]},{"h":"Cook it","rows":[{"name":"Mexico in My Kitchen","color":"#55b8ad","shape":"site","sub":"mexicoinmykitchen.com","note":"Mely Martínez's long-running blog of Mexican home-style recipes.","url":"https://www.mexicoinmykitchen.com/","suggested":true,"kind":"blog"},{"name":"Pati Jinich","color":"#55b8ad","shape":"site","sub":"patijinich.com","note":"Recipe archive from the Mexican-born chef and host of the PBS series Pati's Mexican Table.","url":"https://patijinich.com/recipes/","suggested":true,"kind":"site"}]},{"h":"More from Mexican cuisine","links":[["Chile con queso","dish/chile-con-queso"],["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Concha","dish/concha"],["Discada","dish/discada"],["Guacamole","dish/guacamole"],["Huevos rancheros","dish/huevos-rancheros"],["List of Mexican restaurants","dish/list-of-mexican-restaurants"],["Mexican juice bar","dish/mexican-juice-bar"],["Mexican restaurant","dish/mexican-restaurant"],["Nachos","dish/nachos"],["Pico de gallo","dish/pico-de-gallo"],["Pozole","dish/pozole"],["Quesabirria","dish/quesabirria"],["Quesadilla","dish/quesadilla"],["Real Mex Restaurants","dish/real-mex-restaurants"],["Relleno negro","dish/relleno-negro"],["Sopa de lima","dish/sopa-de-lima"],["Taco","dish/taco"],["Taquería","dish/taqueria"],["Tortilla soup","dish/tortilla-soup"],["Walnut soup","dish/walnut-soup"]]}],"img":{"src":"/world-cuisine/img/thumb/0/01/2019_El_Adobe_de_Capistrano.jpg/500px-2019_El_Adobe_de_Capistrano.jpg","w":500,"h":173,"by":"Beyond My Ken","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:2019_El_Adobe_de_Capistrano.jpg"}},"dish/flake-fish":{"t":"dish","r":"dish/flake-fish","n":"Flake (fish)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Australian cuisine","dot":"#55b8ad","intro":[["Flake is a term used in Australia to indicate the flesh of any of several species of shark, particularly the gummy shark. The term probably arose in the late 1920s when the large-scale commercial shark fishery off the coast of Victoria was established. Until that time, shark was generally an incidental catch rather than a targeted species."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-flake-fish"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Flake_(fish)"}],"sections":[{"h":"Where it's from","links":[["Australian cuisine","cuisine/australian-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Shark","ingredient/shark"]]},{"h":"Cook it","rows":[{"name":"Belly Rumbles: Australian Recipes","color":"#55b8ad","shape":"site","sub":"bellyrumbles.com","note":"Sara McCleary's collection of Australian classics such as Anzac biscuits, pavlova, sausage rolls and native-ingredient bakes.","url":"https://bellyrumbles.com/category/australian-recipes/","suggested":true,"kind":"blog"},{"name":"RecipeTin Eats","color":"#55b8ad","shape":"site","sub":"recipetineats.com","note":"Sydney-based Nagi Maehashi's widely used recipe site; broad in scope, but a staple of Australian home cooking.","url":"https://www.recipetineats.com/home/","suggested":true,"kind":"blog"}]},{"h":"More from Australian cuisine","links":[["Anzac biscuit","dish/anzac-biscuit"],["Fish and chips","dish/fish-and-chips"],["Kangaroo meat","dish/kangaroo-meat"],["Parrot pie","dish/parrot-pie"],["Pavlova","dish/pavlova"],["Sausage sizzle","dish/sausage-sizzle"],["Steak and eggs","dish/steak-and-eggs"],["Zucchini slice","dish/zucchini-slice"]]}]},"dish/gulyasleves":{"t":"dish","r":"dish/gulyasleves","n":"Gulyásleves","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Gulyásleves (gulyás 'herdsman' and leves 'soup' in Hungarian), is a Hungarian soup, made of beef, vegetables, ground paprika and other spices.  It originates from a dish cooked by the cattlemen (Hungarian: gulya 'cattle herd', gulyás 'cattle herder'), who tended their herds in the Great Hungarian Plain (known as the Alföld or puszta in Hungarian). These Hungarian cowboys often camped out with their cattle days away from populated areas, so they had to make their food from ingredients they could carry with themselves, and this food had to be cooked in the one available portable cauldron (called bogrács) over an open fire."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-gulyasleves"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Guly%C3%A1sleves"}],"sections":[{"h":"Where it's from","links":[["Austrian cuisine","cuisine/austrian-cuisine"],["Hungarian cuisine","cuisine/hungarian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Beef","ingredient/beef"],["Paprika","ingredient/paprika"]]},{"h":"Cook it","rows":[{"name":"Vienna Sunday Kitchen","color":"#55b8ad","shape":"site","sub":"vienna-sunday.kitchen","note":"Viennese food blog of Austrian home cooking and pastries, with English-language recipes.","url":"https://www.vienna-sunday.kitchen/newest-recipes/","suggested":true,"kind":"blog"},{"name":"Lil Vienna","color":"#55b8ad","shape":"site","sub":"lilvienna.com","note":"Austrian recipes from Ursula and David, two Austrians living in Boston.","url":"https://www.lilvienna.com/?p=1366","suggested":true,"kind":"blog"},{"name":"Zsuzsa Is in the Kitchen","color":"#55b8ad","shape":"site","sub":"zsuzsaisinthekitchen.blogspot.com","note":"Hungarian-born home cook's blog of traditional Hungarian recipes.","url":"https://zsuzsaisinthekitchen.blogspot.com/2010/01","suggested":true,"kind":"blog"}]},{"h":"More from Austrian cuisine","links":[["Blini","dish/blini"],["Cabbage roll","dish/cabbage-roll"],["Chicken paprikash","dish/chicken-paprikash"],["Dampfnudel","dish/dampfnudel"],["Egg puffs and soup pearls","dish/egg-puffs-and-soup-pearls"],["Leberkäse","dish/leberkase"],["Liptauer","dish/liptauer"],["Pancake","dish/pancake"],["Potato salad","dish/potato-salad"],["Sachertorte","dish/sachertorte"],["Spätzle","dish/spatzle"],["Strudel","dish/strudel"],["Tarhonya","dish/tarhonya"],["Zopf","dish/zopf"]]}],"img":{"src":"/world-cuisine/img/thumb/5/5c/Gulyas080.jpg/500px-Gulyas080.jpg","w":500,"h":375,"by":"Lily15","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Gulyas080.jpg"}},"dish/hot-cross-bun":{"t":"dish","r":"dish/hot-cross-bun","n":"Hot cross bun","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from British cuisine","dot":"#cf5f87","intro":[["A hot cross bun is a spiced bun, usually containing small pieces of raisins and marked with a cross on the top, traditionally eaten on Good Friday in the United Kingdom and other Commonwealth countries. Hot Cross Bun Day is  the 11th of September. They are available all year round in some countries, including the UK."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-hot-cross-bun"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hot_cross_bun"}],"sections":[{"h":"Where it's from","links":[["British cuisine","cuisine/british-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Currant","ingredient/currant"],["Raisin","ingredient/raisin"],["Wheat flour","ingredient/wheat-flour"],["Zante currant","ingredient/zante-currant"]]},{"h":"Cook it","rows":[{"name":"Great British Chefs: traditional British recipes","color":"#55b8ad","shape":"site","sub":"greatbritishchefs.com","note":"UK chef-driven recipe site with a large section of classic British dishes.","url":"https://www.greatbritishchefs.com/features/our-most-popular-traditional-british-recipes","suggested":true,"kind":"site"}]},{"h":"More from British cuisine","links":[["Banbury cake","dish/banbury-cake"],["Battenberg cake","dish/battenberg-cake"],["Black pudding","dish/black-pudding"],["Bread sauce","dish/bread-sauce"],["Carpetbag steak","dish/carpetbag-steak"],["Chelsea bun","dish/chelsea-bun"],["Christmas pudding","dish/christmas-pudding"],["Cobbler (food)","dish/cobbler-food"],["Crumble","dish/crumble"],["Crumpet","dish/crumpet"],["Curry in the United Kingdom","dish/curry-in-the-united-kingdom"],["Digestive biscuit","dish/digestive-biscuit"],["