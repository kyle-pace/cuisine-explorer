{"cuisine/mauritanian-cuisine":{"t":"cuisine","r":"cuisine/mauritanian-cuisine","n":"Mauritanian cuisine","c":"#e46a3f","crumb":[["Africa","cuisines#africa"],["Cuisine"]],"sub":"National cuisine of Mauritania","intro":[["The cuisine of Mauritania, including the culinary practices of Mauritania, has been influenced by Arab, Berbers and African peoples who have lived in and traversed the \"stark\" landscape marked with Sahara desert dunes in caravans. There is an overlap with Moroccan cuisine in the north and Senegalese cuisine in the south."],["French colonial influence (Mauritania was a colony until 1960) has also played a role in influencing the cuisine of the relatively isolated land. Alcohol is prohibited in the Muslim faith and its sale is largely limited to hotels. Mint tea is widely consumed and poured from height to create foam. Traditionally, meals are eaten communally."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"mauritanian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mauritanian_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"Dishes","count":2,"links":[["Boulaghmane","dish/boulaghmane"],["Couscous","dish/couscous"]]},{"h":"Key ingredients","links":[["Semolina","ingredient/semolina"],["Wheat","ingredient/wheat"]],"note":"Most used across its dishes."}],"cont":"African cuisine","img":{"src":"/labs/cuisines/img/thumb/f/f1/Adrar_teapot_%28Mauritania%29.jpg/500px-Adrar_teapot_%28Mauritania%29.jpg","w":500,"h":365,"by":"Ji-Elle","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Adrar_teapot_(Mauritania).jpg"}},"cuisine/guatemalan-cuisine":{"t":"cuisine","r":"cuisine/guatemalan-cuisine","n":"Guatemalan cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Cuisine"]],"sub":"National cuisine of Guatemala","intro":[["Most traditional foods in Guatemalan cuisine are based on  Maya cuisine, with Spanish influence, and prominently feature corn, chilies and beans as key ingredients."],["There are also foods that are commonly eaten on certain days of the week. For example, it is a popular custom to eat paches (a kind of tamale made from potatoes) on Thursday. Certain dishes are also associated with special occasions, such as fiambre for All Saints Day on November 1 and tamales, which are common around Christmas."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"guatemalan-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Guatemalan_cuisine"}],"sections":[{"h":"Recipe sites","count":2,"rows":[{"name":"The Foodies' Kitchen: Guatemalan Recipe Collection","ref":"site/thefoodieskitchen-com","color":"#55b8ad","shape":"site","sub":"thefoodieskitchen.com","note":"Index of Guatemalan recipes on a home cooking blog.","url":"https://www.thefoodieskitchen.com/2011/09/12/guatemalan-recipe-collection/","suggested":true,"kind":"blog"},{"name":"Familia Kitchen: Argentina","ref":"site/familiakitchen-com","color":"#55b8ad","shape":"site","sub":"familiakitchen.com","note":"Guatemalan recipes and stories on a Latino family cooking site.","url":"https://familiakitchen.com/destination/guatemala/","suggested":true,"kind":"site"}]},{"h":"Cookbooks","count":1,"rows":[{"name":"False Tongues and Sunday Bread: A Guatemalan and Mayan Cookbook","ref":"cookbook/false-tongues-and-sunday-bread-a-guatemalan-and-mayan-cookbook","color":"#f0b340","shape":"book","sub":"Copeland Marks","note":"Survey of Guatemalan and Maya home cooking gathered across the country.","url":"","suggested":true}]},{"h":"Dishes","count":1,"links":[["Kak'ik","dish/kak-ik"]]},{"h":"Key ingredients","links":[["Turkey meat","ingredient/turkey-meat"],["Achiote","ingredient/annatto"],["Tomato","ingredient/tomato"],["Chili pepper","ingredient/chili-pepper"]],"note":"Most used across its dishes."}],"cont":"Cuisine of the Americas","img":{"src":"/labs/cuisines/img/thumb/5/56/Cocido%2C_o_caldo_de_res.jpg/500px-Cocido%2C_o_caldo_de_res.jpg","w":500,"h":501,"by":"Luisfi","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Cocido%2C_o_caldo_de_res.jpg"}},"cuisine/karakalpak-cuisine":{"t":"cuisine","r":"cuisine/karakalpak-cuisine","n":"Karakalpak cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Cuisine"]],"sub":"Cuisine of a people","intro":[],"src":null,"wiki":"Karakalpak cuisine","actions":[{"kind":"globe","hash":"karakalpak-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Karakalpak_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]}],"cont":"Asian cuisine"},"cuisine/hubei-cuisine":{"t":"cuisine","r":"cuisine/hubei-cuisine","n":"Hubei cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Chinese cuisine","cuisine/chinese-cuisine"]],"sub":"Regional cuisine in China","intro":[["Hubei cuisine, also known as Chu cuisine or E cuisine, is derived from the native cooking styles of Hubei Province in China."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"hubei-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hubei_cuisine"}],"sections":[{"h":"Recipe sites","count":1,"rows":[{"name":"Madame Huang's Kitchen: Henan cuisine","ref":"site/carolynjphillips-blogspot-com","color":"#55b8ad","shape":"site","sub":"carolynjphillips.blogspot.com","note":"Recipe posts on Hubei dishes from Carolyn Phillips' blog, Madame Huang's Kitchen.","url":"https://carolynjphillips.blogspot.com/search/label/Hubei%20cuisine","suggested":true,"kind":"blog"}]},{"h":"Cookbooks","count":1,"rows":[{"name":"All Under Heaven: Recipes from the 35 Cuisines of China","ref":"cookbook/all-under-heaven-recipes-from-the-35-cuisines-of-china","color":"#f0b340","shape":"book","sub":"Carolyn Phillips, 2016","note":"Regional survey of Chinese cooking that includes a section on Hubei dishes.","url":"https://www.penguinrandomhouse.com/books/534780/all-under-heaven-by-carolyn-phillips/9781607749820