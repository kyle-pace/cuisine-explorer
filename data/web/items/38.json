nch onion soup","dish/french-onion-soup"],["French restaurant","dish/french-restaurant"],["Fricassee","dish/fricassee"],["Garbure","dish/garbure"],["Gâteau Basque","dish/gateau-basque"],["Gugelhupf","dish/gugelhupf"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/89/Lobster_bisque.jpg/500px-Lobster_bisque.jpg","w":500,"h":332,"by":"Unknown author","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Lobster_bisque.jpg"}},"ingredient/guanciale":{"t":"ingredient","r":"ingredient/guanciale","n":"Guanciale","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Guanciale is an Italian salt-cured meat product prepared from pork jowl or cheeks. Its name is derived from guancia, meaning 'cheek'. Its rendered fat gives flavour to and thickens the sauce of pasta dishes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-guanciale"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Guanciale"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["American cuisine","cuisine/american-cuisine",[["Carbonara","dish/carbonara"]]],["Italian cuisine","cuisine/italian-cuisine",[["Carbonara","dish/carbonara"]]]]},{"h":"Often cooked with","links":[["Black pepper","ingredient/black-pepper"],["Egg","ingredient/egg"],["Pancetta","ingredient/pancetta"],["Pasta","ingredient/pasta"],["Pecorino","ingredient/pecorino"],["Pecorino romano","ingredient/pecorino-romano"],["Peppercorn","ingredient/peppercorn"],["Spaghetti","ingredient/spaghetti"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/51/Guanciale_closeup_%28cropped%29.jpg/500px-Guanciale_closeup_%28cropped%29.jpg","w":500,"h":255,"by":"Popo le Chien","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Guanciale_closeup_(cropped).jpg"}},"dish/cassoeula":{"t":"dish","r":"dish/cassoeula","n":"Cassoeula","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["Cassoeula or cazzoeula, sometimes Italianized as cassola, cazzuola or cazzola (the word for 'trowel', etymologically unrelated), or bottaggio (probably derived from the French word potage), is a typical winter dish popular in western Lombardy, Italy, chiefly made from pork and Savoy cabbage. The dish has a strong, decisive flavour, and was a favourite of conductor Arturo Toscanini. One writer describes it as a \"noble, ancient Milanese dish\", and writes of the inexpressible \"pleasure that it furnishes the soul as well as the palate, especially on a wintry day\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-cassoeula"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cassoeula"}],"sections":[{"h":"Where it's from","links":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Cut of pork","ingredient/cut-of-pork"],["Pig's trotter","ingredient/pig-s-trotter"],["Pork","ingredient/pork"],["Pork ribs","ingredient/pork-ribs"],["Pork rind","ingredient/pork-rind"],["Savoy cabbage","ingredient/savoy-cabbage"],["Tomato paste","ingredient/tomato-paste"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","ref":"site/pastagrannies-substack-com","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's long-running video series filming Italian grandmothers making regional pasta by hand.","url":"https://pastagrannies.substack.com/p/pasta-grannies-is-now-on-substack","suggested":true,"kind":"youtube"},{"name":"Recipes from Italy","ref":"site/recipesfromitaly-com","color":"#55b8ad","shape":"site","sub":"recipesfromitaly.com","note":"Traditional Italian recipes written by Italian home cooks, organized by region and course.","url":"https://recipesfromitaly.com","suggested":true,"kind":"blog"},{"name":"Manu's Menu","ref":"site/manusmenu-com","color":"#55b8ad","shape":"site","sub":"manusmenu.com","note":"Italia