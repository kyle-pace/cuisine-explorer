lebanon-bologna"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lebanon_bologna"}],"sections":[{"h":"Where it's from","links":[["Cuisine of the Pennsylvania Dutch","cuisine/cuisine-of-the-pennsylvania-dutch"]]},{"h":"Ingredients","count":1,"links":[["Beef","ingredient/beef"]]},{"h":"More from Cuisine of the Pennsylvania Dutch","links":[["Fasnacht (doughnut)","dish/fasnacht-doughnut"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a4/Lebanon_Bologna_example.jpg/500px-Lebanon_Bologna_example.jpg","w":500,"h":333,"by":"Ll1324","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Lebanon_Bologna_example.jpg"}},"dish/lemang":{"t":"dish","r":"dish/lemang","n":"Lemang","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Lemang is a  Malay and Minangkabau traditional food made from glutinous rice, coconut milk, and salt, cooked in a hollowed bamboo tube coated with banana leaves in order to prevent the rice from sticking to the bamboo. Lemang is believed to have origins linked to the ancient Proto-Malay and Deutero-Malay peoples who settled across Maritime Southeast Asia centuries ago. Similar dishes made from sticky rice in bamboo are common throughout Mainland Southeast Asia."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-lemang"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lemang"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Bamboo","ingredient/bamboo"],["Banana leaf","ingredient/banana-leaf"],["Coconut milk","ingredient/coconut-milk"],["Glutinous rice","ingredient/glutinous-rice"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","ref":"site/dailycookingquest-com","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"