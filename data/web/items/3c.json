]]},{"h":"Often cooked with","links":[["Coconut","ingredient/coconut"],["Coconut milk","ingredient/coconut-milk"],["Sugar","ingredient/sugar"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/43/GreenTeaYokan.jpg/500px-GreenTeaYokan.jpg","w":500,"h":375,"by":"Sjschen","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:GreenTeaYokan.jpg"}},"dish/chicken-katsu":{"t":"dish","r":"dish/chicken-katsu","n":"Chicken katsu","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Yoshoku","dot":"#f0b340","intro":[["Chicken katsu, also known as panko chicken or tori katsu (鶏カツ), is a Japanese dish of fried chicken made with panko bread crumbs. It is related to tonkatsu, fried pork cutlets. The dish has spread internationally and has become a common dish served at Japanese and East Asian restaurants worldwide."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-chicken-katsu"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chicken_katsu"}],"sections":[{"h":"Where it's from","links":[["Yoshoku","cuisine/yoshoku"]]},{"h":"Ingredients","count":4,"links":[["Chicken","ingredient/chicken"],["Fried chicken","ingredient/fried-chicken"],["Japanese rice","ingredient/japanese-rice"],["Panko","ingredient/panko"]]},{"h":"More from Yoshoku","links":[["Cream stew","dish/cream-stew"],["Doria (food)","dish/doria-food"],["Hayashi rice","dish/hayashi-rice"],["Menchi-katsu","dish/menchi-katsu"],["Naporitan","dish/naporitan"],["Rengatei","dish/rengatei"],["Tonkatsu","dish/tonkatsu"],["Volga rice","dish/volga-rice"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e5/Matsunoya_W_Mega_Chicken_Katsu_Set_20200923-04.jpg/500px-Matsunoya_W_Mega_Chicken_Katsu_Set_20200923-04.jpg","w":500,"h":281,"by":"円周率３パーセント","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Matsunoya_W_Mega_Chicken_Katsu_Set_20200923-04.jpg"}},"ingredient/panko":{"t":"ingredient","r":"ingredient/panko","n":"Panko","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 4 dishes across 2 cuisines","intro":[["Breadcrumbs are a culinary ingredient consisting of flour or crumbled bread of varying dryness, sometimes with seasonings added. They are used for a variety of purposes, including breading or crumbing foods before frying (such as breaded cutlets like tonkatsu and schnitzel), topping casseroles, stuffing poultry, thickening stews, and adding inexpensive bulk to soups, meatloaves, and similar foods."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-panko"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Panko"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Yoshoku","cuisine/yoshoku",[["Chicken katsu","dish/chicken-katsu"],["Menchi-katsu","dish/menchi-katsu"],["Tonkatsu","dish/tonkatsu"]]],["Japanese cuisine","cuisine/japanese-cuisine",[["Kaki furai","dish/kaki-furai"]]]]},{"h":"Often cooked with","links":[["Chicken","ingredient/chicken"],["Fried chicken","ingredient/fried-chicken"],["Japanese rice","ingredient/japanese-rice"],["Egg","ingredient/egg"],["Oyster","ingredient/oyster"],["Bread crumbs","ingredient/bread-crumbs"],["Cutlet","ingredient/cutlet"],["Pork","ingredient/pork"]]}]},"ingredient/escabeche":{"t":"ingredient","r":"ingredient/escabeche","n":"Escabeche","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Escabeche is the name for several dishes in Spanish, French, Portuguese, Italian, Filipino and Hispanic American cuisines, consisting of marinated fish, meat or vegetables, cooked or pickled in an acidic sauce (usually with vinegar), and flavored with paprika, citrus, and other spices."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-escabeche"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Escabeche"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Bolivian cuisine"