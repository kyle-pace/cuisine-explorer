"ingredient/sago"],["Scallion","ingredient/scallion"],["Shallot","ingredient/shallot"],["Shrimp","ingredient/shrimp"],["Vermicelli","ingredient/vermicelli"],["Gochujang","ingredient/gochujang"]]}],"img":{"src":"/labs/cuisines/img/thumb/f/fb/Fish_cakes_food_dinner.jpg/500px-Fish_cakes_food_dinner.jpg","w":500,"h":375,"by":"Jon Sullivan","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Fish_cakes_food_dinner.jpg"}},"ingredient/tianmianjiang":{"t":"ingredient","r":"ingredient/tianmianjiang","n":"Tianmianjiang","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Tianmian sauce, also known as sweet bean sauce, sweet flour sauce or sweet wheat paste, is a thick, smooth, dark brown or black paste with either a mild, savory or sweet flavor. It is commonly used in Northern Chinese cuisine, Northeastern Chinese cuisine, and Korean-Chinese cuisine. Peking duck and jajangmyeon are two popular dishes that feature the sauce."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tianmianjiang"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tianmian_sauce"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Beijing cuisine","cuisine/beijing-cuisine",[["Peking duck","dish/peking-duck"]]]]},{"h":"Often cooked with","links":[["Allium fistulosum","ingredient/allium-fistulosum"],["Duck as food","ingredient/duck-as-food"],["Spring pancake","ingredient/spring-pancake"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/54/Sweetnoodlesauce.jpg/500px-Sweetnoodlesauce.jpg","w":500,"h":375,"by":"Unknown author","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Sweetnoodlesauce.jpg"}},"dish/piracaldo":{"t":"dish","r":"dish/piracaldo","n":"Piracaldo","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Paraguayan cuisine","dot":"#94bd5c","intro":[["Piracaldo is a fish soup that is part of the traditional cuisine of Paraguay. The Guarani word Pira means \"fish\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-piracaldo"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Piracaldo"}],"sections":[{"h":"Where it's from","links":[["Paraguayan cuisine","cuisine/paraguayan-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Bell pepper","ingredient/bell-pepper"],["Onion","ingredient/onion"],["Tomato","ingredient/tomato"]]},{"h":"Cook it","rows":[{"name":"Camila Made: Top 15 Paraguayan Recipes","color":"#55b8ad","shape":"site","sub":"camilamade.com","note":"Paraguayan recipe roundup on a Latin American home cooking blog.","url":"https://camilamade.com/top-15-paraguayan-recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Paraguayan cuisine","links":[["Chipá","dish/chipa"],["Dulce de batata","dish/dulce-de-batata"],["Paraguay cheese","dish/paraguay-cheese"],["Sopa paraguaya","dish/sopa-paraguaya"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/bd/Suquet_de_peix.jpg/500px-Suquet_de_peix.jpg","w":500,"h":375,"by":"Hector Garcia from Barcelona, Catalonia, Spain","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Suquet_de_peix.jpg"}},"dish/sarde-in-saor":{"t":"dish","r":"dish/sarde-in-saor","n":"Sarde in saor","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Venetian cuisine","dot":"#cf5f87","intro":[["Sarde in saor (alternative spelling sarde in saòr) are an Italian appetizer (antipasto) consisting of fried sardines, seasoned with sweet and sour onions, pine nuts, and raisins, typical of Venetian cuisine. They are a form of cicchetti, often served as snacks in Venetian bacari."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-sarde-in-saor"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sarde_in_saor"}],"sections":[{"h":"Where it's from","links":[["Venetian cuisine","cuisine/venetian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["European pilchard","ingredient/european-pilchard"],["Onion","ingredient/onion"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/1e/Sarde_in_sa%C3%B2r.jpg/500px-Sarde_in_sa%C3%B2r.jpg","w":500,"h":375,"by":"ezioman","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Sarde_in_sa%C3%B2r.jpg"}},"ingredient/prunus-cerasus":{"t":"ingredient","r":"ingredient/prunus-cerasus","n":"Prunus cerasus","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Prunus cerasus (sour cherry, tart cherry, or dwarf cherry) is an Old World species of Prunus in the subgenus Cerasus (cherries). It has two main groups of cultivars: the dark-red Morello cherry and the lighter-red Amarelle cherry. The sour pulp is edible."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-prunus-cerasus"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Prunus_cerasus"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Hungarian cuisine","cuisine/hungarian-cuisine",[["Sour cherry soup","dish/sour-cherry-soup"]]]]},{"h":"Often cooked with","links":[["Sour cream","ingredient/sour-cream"],["Sugar","ingredient/sugar"]]}],"img":{"src":"/labs/cuisines/img/2/2a/Prunus_cerasus_-_K%C3%B6hler%E2%80%93s_Medizinal-Pflanzen-113.jpg","w":500,"h":642,"by":"Franz Eugen Köhler, Köhler's Medizinal-Pflanzen","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Prunus_cerasus_-_K%C3%B6hler%E2%80%93s_Medizinal-Pflanzen-113.jpg"}},"ingredient/frog-legs":{"t":"ingredient","r":"ingredient/frog-legs","n":"Frog legs","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Frog legs are the muscular hindlimbs of frogs that are consumed as food by humans in some cuisines. Frog legs are rich in protein, omega-3 fatty acids, vitamin A, and potassium. They are often said to taste like chicken because of the mild flavor, with a texture most similar to chicken wings. The taste and texture of frog meat are approximately between chicken and fish. Frog muscles do not resolve rigor mortis as quickly as skeletal muscles from warm-blooded animals (chicken, for example) do, so heat from cooking can cause fresh frog legs to twitch when in the pan."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-frog-legs"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Frog_legs"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Swikee","dish/swikee"]]]]},{"h":"Often cooked with","links":[["Frog leg","ingredient/frog-leg"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e4/2012_Froschschenkel_anagoria.JPG/500px-2012_Froschschenkel_anagoria.JPG","w":500,"h":375,"by":"Anagoria","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:2012_Froschschenkel_anagoria.JPG"}},"dish/timoleague-brown-pudding":{"t":"dish","r":"dish/timoleague-brown-pudding","n":"Timoleague Brown Pudding","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Irish cuisine","dot":"#cf5f87","intro":[["Timoleague Brown Pudding is a variety of brown pudding which  was granted  Protected Geographical Indication status under European Union law in 1999. In 2012 the sole producer of the pudding Staunton Foods decided to stop using the PGI designation because they felt it wasn't of huge benefit to their business."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-timoleague-brown-pudding"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Timoleague_Brown_Pudding"}],"sections":[{"h":"Where it's from","links":[["Irish cuisine","cuisine/irish-cuisine"]]},{"h":"Cook it","rows":[{"name":"Irish American Mom","color":"#55b8ad","shape":"site","sub":"irishamericanmom.com","note":"Irish-born cook living in the US sharing traditional Irish recipes.","url":"https://www.irishamericanmom.com/recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Irish cuisine","links":[["Bacon and cabbage","dish/bacon-and-cabbage"],["Black pudding","dish/black-pudding"],["Croffle","dish/croffle"],["Crumble","dish/crumble"],["Fish and chips","dish/fish-and-chips"],["Potato salad","dish/potato-salad"],["Sausage roll","dish/sausage-roll"]]}]}}