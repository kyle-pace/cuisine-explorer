ingredients"]],"sub":"Ingredient in 4 dishes across 5 cuisines","intro":[["Zest is a food ingredient that is prepared by scraping or cutting from the rind of unwaxed citrus fruits such as lemon, orange, citron, and lime. Zest is used to add flavor to many different types of food."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-lemon-zest"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lemon_zest"}],"sections":[{"h":"Where it's cooked with","count":5,"groups":[["Andorran cuisine","cuisine/andorran-cuisine",[["Crema catalana","dish/crema-catalana"]]],["Catalan cuisine","cuisine/catalan-cuisine",[["Crema catalana","dish/crema-catalana"]]],["Italian cuisine","cuisine/italian-cuisine",[["Torta della nonna","dish/torta-della-nonna"]]],["Lombard cuisine","cuisine/lombard-cuisine",[["Gremolata","dish/gremolata"]]],["Portuguese cuisine","cuisine/portuguese-cuisine",[["Sericaia","dish/sericaia"]]]]},{"h":"Often cooked with","links":[["Egg","ingredient/egg"],["Milk","ingredient/milk"],["Sugar","ingredient/sugar"],["Cinnamon","ingredient/cinnamon"],["Wheat flour","ingredient/wheat-flour"],["Egg yolk","ingredient/egg-yolk"],["Butter","ingredient/butter"],["Custard","ingredient/custard"],["Pine nut","ingredient/pine-nut"],["Powdered sugar","ingredient/powdered-sugar"],["Shortcrust pastry","ingredient/shortcrust-pastry"],["Vanilla","ingredient/vanilla"]]}],"img":{"src":"/world-cuisine/img/thumb/c/c3/Zesting_an_orange.jpg/500px-Zesting_an_orange.jpg","w":500,"h":412,"by":"Dvortygirl","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Zesting_an_orange.jpg"}},"dish/dal-dhokli":{"t":"dish","r":"dish/dal-dhokli","n":"Dal dhokli","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Daal dhokli  is an Indian dish that originated in Gujarat however also popular in Rajasthan. made by boiling wheat flour pieces in a toor dal stew. A similar preparation is called varanfal (Marathi: वरण फळ), or chakolyaa (Marathi: चकोल्या) in Marathi. In some household traditions it is made out of leftover dal."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-dal-dhokli"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Dal_dhokli"}],"sections":[{"h":"Where it's from","links":[["Indian cuisine","cuisine/indian-cuisine"],["Rajasthani cuisine","cuisine/rajasthani-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Dal","ingredient/dal"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Swasthi's Recipes","color":"#55b8ad","shape":"site","sub":"indianhealthyrecipes.com","note":"Swasthi Shreekanth's long-running blog of everyday Indian home cooking from across the regions.","url":"https://www.indianhealthyrecipes.com/about/","suggested":true,"kind":"blog"},{"name":"Hari Ghotra","color":"#55b8ad","shape":"site","sub":"harighotra.co.uk","note":"UK-based cook Hari Ghotra's recipe library and videos of home-style Indian dishes.","url":"https://www.harighotra.co.uk/indian-recipes","suggested":true,"kind":"site"},{"name":"My Ginger Garlic Kitchen (Rajasthani)","color":"#55b8ad","shape":"site","sub":"mygingergarlickitchen.com","note":"Rajasthani section of Anupama Paliwal's Indian home cooking blog.","url":"https://www.mygingergarlickitchen.com/categories/rajasthani-recipes","suggested":true,"kind":"blog"},{"name":"Tarla Dalal (Sindhi)","color":"#55b8ad","shape":"site","sub":"cdn.tarladalal.com","note":"Rajasthani category on the recipe site of the late Indian cookbook author Tarla Dalal.","url":"https://cdn.tarladalal.com/recipes/category/Rajasthani-Food","suggested":true,"kind":"site"}]},{"h":"More from Indian cuisine","links":[["Akuri","dish/akuri"],["Aloo paratha","dish/aloo-paratha"],["Amba (condiment)","dish/amba-condiment"],["Baingan bharta","dish/baingan-bharta"],["Bombay potato","dish/bombay-potato"],["Butter chicken","dish/butter-chicken"],["Chaat masala","dish/chaat-masala"],["Chi