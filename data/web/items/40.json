{"cuisine/cossack-cuisine":{"t":"cuisine","r":"cuisine/cossack-cuisine","n":"Cossack cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Cuisine"]],"sub":"Cuisine of a people","intro":[["Cossack cuisine is the traditional cuisine of the Cossack people of present-day Ukraine and Russia. Having emerged in parallel with the settlement of Eastern European steppes, Cossack food culture incorporated elements of various traditions, including European, Caucasian and Central Asian cuisines."]],"src":"wikipedia","actions":[{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cossack_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]}],"cont":"European cuisine","img":{"src":"/labs/cuisines/img/thumb/2/2e/Varenyky_opischnya_03.jpg/500px-Varenyky_opischnya_03.jpg","w":500,"h":749,"by":"Yurii-mr","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Varenyky_opischnya_03.jpg"}},"cuisine/epirotic-cuisine":{"t":"cuisine","r":"cuisine/epirotic-cuisine","n":"Epirotic cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Greek cuisine","cuisine/greek-cuisine"]],"sub":"Regional cuisine in Greece","intro":[["Epirotic cuisine is the traditional Greek cuisine of the region of Epirus. It is based mostly on dairy products; butter and various cheeses."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"epirotic-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Epirotic_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Greek cuisine","cuisine/greek-cuisine"]]},{"h":"Part of","links":[["Greek cuisine","cuisine/greek-cuisine"]]}],"cont":"European cuisine"},"dish/argentine-pizza":{"t":"dish","r":"dish/argentine-pizza","n":"Argentine pizza","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Argentine cuisine","dot":"#94bd5c","intro":[["Argentine pizza, also known as Porteño-style pizza, is a mainstay of the country's cuisine, especially of its capital Buenos Aires, where it is regarded as a cultural heritage and icon of the city. Argentina is the country with the most pizzerias per inhabitant in the world and, although they are consumed throughout the country, the highest concentration of pizzerias and customers is in Buenos Aires, the city with the highest consumption of pizzas in the world (estimated in 2015 to be 14 million per year). As such, the city has been considered one of the world capitals of pizza."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-argentine-pizza"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Argentine_pizza"}],"sections":[{"h":"Where it's from","links":[["Argentine cuisine","cuisine/argentine-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Mozzarella","ingredient/mozzarella"],["Tomato sauce","ingredient/tomato-sauce"],["Wheat flour","ingredient/wheat-flour"],["Yeast","ingredient/yeast"]]},{"h":"Cook it","rows":[{"name":"Familia Kitchen: Argentina","ref":"site/familiakitchen-com","color":"#55b8ad","shape":"site","sub":"familiakitchen.com","note":"Argentine recipes and stories on a Latino family cooking site.","url":"https://familiakitchen.com/destination/argentina/","suggested":true,"kind":"site"}]},{"h":"More from Argentine cuisine","links":[["Anticucho","dish/anticucho"],["Asado","dish/asado"],["Bara brith","dish/bara-brith"],["Bondiola sandwich","dish/bondiola-sandwich"],["Cabbage roll","dish/cabbage-roll"],["Dulce de batata","dish/dulce-de-batata"],["Fugazza","dish/fugazza"],["Jesuita (sandwich)","dish/jesuita-sandwich"],["Jésuite","dish/jesuite"],["Matambre","dish/matambre"],["Puchero","dish/puchero"],["Rogel (cake)","dish/rogel-cake"],["Salsa golf","dish/salsa-golf"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/0f/Pizzas_Buenos_Aires.png/500px-Pizzas_Buenos_Aires.png","w":500,"h":334,"by":"Gobierno de la Ciudad Autónoma de Buenos Aires","lic":"CC BY 2.5 ar","licUrl":"https://creativecommons.org/licenses/by/2.5/ar/deed.en","page":"https://commons.wikimedia.org/wiki/File:Pizzas_Buenos_Aires.png"}},"dish/bockwurst":{"t":"dish","r":"dish/bockwurst","n":"Bockwurst","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#94bd5c","intro":[["Bockwurst is a German sausage traditionally made from ground pork or veal (tending more towards veal, unlike bratwurst). Bockwurst is flavored with salt, white pepper and paprika. Other herbs, such as marjoram, chives, parsley, ginger, mace and coriander, are also often added."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-bockwurst"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bockwurst"}],"sections":[{"h":"Where it's from","links":[["Brazilian cuisine","cuisine/brazilian-cuisine"],["German cuisine","cuisine/german-cuisine"],["Thuringian cuisine","cuisine/german-cuisine-thuringia"]]},{"h":"Cook it","rows":[{"name":"Olivia's Cuisine","ref":"site/oliviascuisine-com","color":"#55b8ad","shape":"site","sub":"oliviascuisine.com","note":"Brazilian-born Olivia Mesquita's blog, with a large section of Brazilian classics.","url":"https://oliviascuisine.com/","suggested":true,"kind":"blog"},{"name":"Easy and Delish","ref":"site/easyanddelish-com","color":"#55b8ad","shape":"site","sub":"easyanddelish.com","note":"Brazilian recipe collection from a Brazilian-born home cook based in the US.","url":"https://www.easyanddelish.com/easy-brazilian-recipes/","suggested":true,"kind":"blog"},{"name":"Quick German Recipes","ref":"site/quick-german-recipes-com","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Long-running site by German-born cook Gerhild Fulson (Oma) with traditional German home recipes.","url":"https://www.quick-german-recipes.com/about-me.html","suggested":true,"kind":"blog"},{"name":"Dirndl Kitchen","ref":"site/dirndlkitchen-com","color":"#55b8ad","shape":"site","sub":"dirndlkitchen.com","note":"Blog of German and Bavarian recipes, from main dishes to holiday baking.","url":"https://dirndlkitchen.com","suggested":true,"kind":"blog"}]},{"h":"More from Brazilian cuisine","links":[["Arabu","dish/arabu"],["Arroz carreteiro","dish/arroz-carreteiro"],["Bauru (sandwich)","dish/bauru-sandwich"],["Beijinho","dish/beijinho"],["Beirute","dish/beirute"],["Bobó de camarão","dish/bobo-de-camarao"],["Bolo de fubá","dish/bolo-de-fuba"],["Brigadeiro","dish/brigadeiro"],["Canja de galinha","dish/canja-de-galinha"],["Coxinha","dish/coxinha"],["Feijoada","dish/feijoada"],["Maniçoba","dish/manicoba"],["Manuê","dish/manue"],["Marmelada de Santa Luzia","dish/marmelada-de-santa-luzia"],["Pão na chapa","dish/pao-na-chapa"],["Pie","dish/pie"],["Sobá","dish/soba"],["Xis (sandwich)","dish/xis-sandwich"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/54/Bockwurst_.jpg/500px-Bockwurst_.jpg","w":500,"h":263,"by":"Tinoelf at German Wikipedia (Original text: tinoelf)","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Bockwurst_.jpg"}},"dish/canape":{"t":"dish","r":"dish/canape","n":"Canapé","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["A canapé is a type of starter, a small, prepared, and often decorative food, consisting of a small piece of bread (sometimes toasted) or cracker, wrapped or topped with some savoury food, held in the fingers and often eaten in one bite."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-canape"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Canap%C3%A9"}],"sections":[{"h":"Where it's from","links":[["French cuisine","cuisine/french-cuisine"],["New Caledonian cuisine","cuisine/new-caledonian-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Butter","ingredient/butter"],["Cracker","ingredient/cracker"],["Paste","ingredient/paste"],["Puff pastry","ingredient/puff-pastry"],["Spread","ingredient/spread"],["Toast","ingredient/toast"]]},{"h":"Cook it","rows":[{"name":"Pardon Your French","ref":"site/pardonyourfrench-com","color":"#55b8ad","shape":"site","sub":"p