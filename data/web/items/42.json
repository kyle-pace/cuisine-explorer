],["Cervelle de canut","dish/cervelle-de-canut"],["Cream of sorrel soup","dish/cream-of-sorrel-soup"],["Crêpes Suzette","dish/crepes-suzette"],["Croquembouche","dish/croquembouche"],["Crozets de Savoie","dish/crozets-de-savoie"],["Crudités","dish/crudites"],["Damien Pignolet","dish/damien-pignolet"],["Daube","dish/daube"],["Demi-glace","dish/demi-glace"],["Duxelles","dish/duxelles"],["Espagnole sauce","dish/espagnole-sauce"],["Fin gras du Mézenc","dish/fin-gras-du-mezenc"],["Flammekueche","dish/flammekueche"],["Foie gras","dish/foie-gras"],["Foin de Crau","dish/foin-de-crau"],["Fraisier","dish/fraisier"],["French onion soup","dish/french-onion-soup"],["French restaurant","dish/french-restaurant"],["Fricassee","dish/fricassee"],["Garbure","dish/garbure"],["Gâteau Basque","dish/gateau-basque"],["Gugelhupf","dish/gugelhupf"],["Hollandaise sauce","dish/hollandaise-sauce"]]}],"img":{"src":"/world-cuisine/img/thumb/1/15/Petit_sal%C3%A9_01.jpg/500px-Petit_sal%C3%A9_01.jpg","w":500,"h":375,"by":"Arnaud 25","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Petit_sal%C3%A9_01.jpg"}},"ingredient/strawberry":{"t":"ingredient","r":"ingredient/strawberry","n":"Strawberry","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 3 cuisines","intro":[["The garden strawberry is a widely grown hybrid plant cultivated worldwide for its fruit. The genus Fragaria, the strawberries, is in the rose family, Rosaceae. The fruit is appreciated for its aroma, bright red colour, juicy texture, and sweetness. It is eaten either fresh or in prepared foods such as jam, ice cream, and chocolates. Artificial strawberry flavourings and aromas are widely used in commercial products. Botanically, the strawberry is not a berry, but an aggregate accessory fruit. Each apparent 'seed' on the outside of the strawberry is actually an achene, a botanical fruit with a seed inside it."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-strawberry"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Strawberry"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["American cuisine","cuisine/american-cuisine",[["Strawberry delight","dish/strawberry-delight"]]],["German cuisine","cuisine/german-cuisine",[["Spaghettieis","dish/spaghettieis"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Spaghettieis","dish/spaghettieis"]]]]},{"h":"Where it's grown","grown":{"what":"Strawberries","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":10130864,"top":[["China","cuisine/chinese-cuisine",3896460],["United States of America","cuisine/american-cuisine",1297002],["Egypt","cuisine/egyptian-cuisine",711039],["Turkey","cuisine/turkish-cuisine",645381],["Mexico","cuisine/mexican-cuisine",603242],["Spain","cuisine/spanish-cuisine",322364],["Russia","cuisine/russian-cuisine",245695],["Brazil","cuisine/brazilian-cuisine",196069],["Poland","cuisine/polish-cuisine",177560],["South Korea","cuisine/korean-cuisine",165735],["Japan","cuisine/japanese-cuisine",161430],["Germany","cuisine/german-cuisine",133390],["Morocco","cuisine/moroccan-cuisine",132109],["Italy","cuisine/italian-cuisine",116774],["United Kingdom","cuisine/british-cuisine",114301]]}},{"h":"Often cooked with","links":[["Whipped cream","ingredient/whipped-cream"],["Butter","ingredient/butter"],["Cracker","ingredient/cracker"],["Cream cheese","ingredient/cream-cheese"],["Gelatin","ingredient/gelatin"],["Gelatine dessert","ingredient/gelatine-dessert"],["Graham cracker","ingredient/graham-cracker"],["Whipped topping","ingredient/whipped-topping"]]}],"img":{"src":"/world-cuisine/img/thumb/4/4c/Garden_strawberry_%28Fragaria_%C3%97_ananassa%29_single2.jpg/500px-Garden_strawberry_%28Fragaria_%C3%97_ananassa%29_single2.jpg","w":500,"h":333,"by":"Ivar Leidus","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.