"China","cuisine/chinese-cuisine",2528329],["India","cuisine/indian-cuisine",1440788],["Pakistan","cuisine/pakistani-cuisine",532222],["Nigeria","cuisine/nigerian-cuisine",288885],["Bangladesh","cuisine/bangladeshi-cuisine",235035],["Chad","cuisine/chadian-cuisine",148001],["Ethiopia","cuisine/ethiopian-cuisine",135775],["Sudan","cuisine/sudanese-cuisine",115106],["Turkey","cuisine/turkish-cuisine",105891],["Mongolia","cuisine/mongolian-cuisine",102064],["Tanzania","cuisine/tanzanian-cuisine",93520],["Yemen","cuisine/yemeni-cuisine",84011],["Kenya","cuisine/kenyan-cuisine",76925],["Nepal","cuisine/nepalese-cuisine",76692],["Malawi","cuisine/malawian-cuisine",66910]]}},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Black pepper","ingredient/black-pepper"],["Coconut milk","ingredient/coconut-milk"],["Ghee","ingredient/ghee"],["Wheat flour","ingredient/wheat-flour"],["Cabbage","ingredient/cabbage"],["Caraway seed","ingredient/caraway-seed"],["Chili pepper","ingredient/chili-pepper"],["Scallion","ingredient/scallion"],["Shallot","ingredient/shallot"],["Shrimp","ingredient/shrimp"],["Sweet soy sauce","ingredient/sweet-soy-sauce"],["Chicken","ingredient/chicken"],["Lime","ingredient/lime"],["Soy sauce","ingredient/soy-sauce"],["Galangal","ingredient/galangal"]]},{"h":"Mentioned in","links":[["Wayuu foodways","cuisine/wayuu-foodways"]]}]},"dish/irazu-costa-rican-restaurant":{"t":"dish","r":"dish/irazu-costa-rican-restaurant","n":"Irazu Costa Rican Restaurant","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Costa Rican cuisine","dot":"#94bd5c","intro":[["Irazu Costa Rican Restaurant is a Latin American restaurant in Chicago, Illinois that opened in 1990. It is located on Milwaukee Avenue in the Bucktown/Wicker Park neighborhood on Chicago's north side. The restaurant takes its name from the Irazú volcano in Costa Rica."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-irazu-costa-rican-restaurant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Irazu_Costa_Rican_Restaurant"}],"sections":[{"h":"Where it's from","links":[["Costa Rican cuisine","cuisine/costa-rican-cuisine"]]},{"h":"Cook it","rows":[{"name":"Pura Vida Moms","ref":"site/puravidamoms-com","color":"#55b8ad","shape":"site","sub":"puravidamoms.com","note":"Costa Rica-focused family site with traditional Costa Rican recipes and its own cookbook.","url":"https://puravidamoms.com/costa-rican-cookbook/","suggested":true}]}]},"dish/khubz-al-abbas":{"t":"dish","r":"dish/khubz-al-abbas","n":"Khubz al-ʾAbbas","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Iraqi cuisine","dot":"#f0b340","intro":[["Khubz al-ʾAbbas is a type of flatbread originating in southern Iraq. It is commonly offered as an act of charity during religious ceremonies, and various occasions of celebration or mourning. Its namesake is a reference to Abbas ibn Ali, also known by the kunya Abu al-Fadl (Arabic: أَبو الْفَضْل, lit. 'father of virtue'). The khubz is baked similarly to common bread, but is often served with added vegetables such as celery, parsley, mint, basil leaves, or garden cress. It may also be prepared with meat, cheese, vegetables, and onion."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-khubz-al-abbas"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Khubz_al-%CA%BEAbbas"}],"sections":[{"h":"Where it's from","links":[["Iraqi cuisine","cuisine/iraqi-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"The Iraqi Family Cookbook","ref":"site/iraqifamilycookbook-blogspot-com","color":"#55b8ad","shape":"site","sub":"iraqifamilycookbook.blogspot.com","note":"Long-running blog of Iraqi family recipes tied to the cookbook of the same name.","url":"https://iraqifamilycookbook.blogspot.com/2014","suggested":true}]},{"h":"More from Iraqi cuisine","links":[["Qeema Najafi","dish/qeema-najafi"]]}]},"ingredient/boston-butt":{"t":"ingredient","r":"ingredient/boston-butt","n":"Boston butt","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A Boston butt is a slightly wedge-shaped portion cut of the pork shoulder located above the standard picnic cut. It includes the blade bone or may be sold as a boneless “lean butt,” and it can be used as a substitutes for tenderloin in certain preparations. The pork shoulder is generally classified as a primal cut, with the picnic and butt portions considered sub-primal cuts. Some sources, however, refer to the butt itself as a primary cut."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-boston-butt"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Boston_butt"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Galician cuisine","cuisine/galician-cuisine",[["Lacón","dish/lacon"]]]]},{"h":"Often cooked with","links":[["Dried meat","ingredient/dried-meat"]]}]},"dish/liptauer":{"t":"dish","r":"dish/liptauer","n":"Liptauer","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#cf5f87","intro":[["Liptauer is a spicy cheese spread from Slovak, Austrian and Hungarian cuisine. Liptauer is made with sheep milk cheese, goat cheese, quark, or cottage cheese."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-liptauer"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Liptauer"}],"sections":[{"h":"Where it's from","links":[["Austrian cuisine","cuisine/austrian-cuisine"],["Hungarian cuisine","cuisine/hungarian-cuisine"],["Slovak cuisine","cuisine/slovak-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Bryndza","ingredient/bryndza"],["Cottage cheese","ingredient/cottage-cheese"],["Goat cheese","ingredient/goat-cheese"],["Quark","ingredient/quark"],["Quark cheese","ingredient/quark-cheese"],["Sheep milk","ingredient/sheep-milk"]]},{"h":"Cook it","rows":[{"name":"Vienna Sunday Kitchen","ref":"site/vienna-sunday-kitchen","color":"#55b8ad","shape":"site","sub":"vienna-s