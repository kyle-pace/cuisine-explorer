lor":"#55b8ad","shape":"site","sub":"zsuzsaisinthekitchen.blogspot.com","note":"Hungarian-born home cook's blog of traditional Hungarian recipes.","url":"https://zsuzsaisinthekitchen.blogspot.com/2010/01","suggested":true,"kind":"blog"},{"name":"Slovak Cooking","color":"#55b8ad","shape":"site","sub":"slovakcooking.com","note":"English-language site of Slovak home recipes started by a young Slovak cook.","url":"https://www.slovakcooking.com/about/","suggested":true,"kind":"blog"}]},{"h":"More from Austrian cuisine","links":[["Blini","dish/blini"],["Cabbage roll","dish/cabbage-roll"],["Chicken paprikash","dish/chicken-paprikash"],["Dampfnudel","dish/dampfnudel"],["Egg puffs and soup pearls","dish/egg-puffs-and-soup-pearls"],["Gulyásleves","dish/gulyasleves"],["Leberkäse","dish/leberkase"],["Pancake","dish/pancake"],["Potato salad","dish/potato-salad"],["Sachertorte","dish/sachertorte"],["Spätzle","dish/spatzle"],["Strudel","dish/strudel"],["Tarhonya","dish/tarhonya"],["Zopf","dish/zopf"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/7a/Liptauer.jpg/500px-Liptauer.jpg","w":500,"h":406,"by":"Unknown author","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Liptauer.jpg"}},"dish/mimosa-salad":{"t":"dish","r":"dish/mimosa-salad","n":"Mimosa salad","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 4 cuisines","dot":"#cf5f87","intro":[["Mimosa salad is a festive salad of which the main ingredients are cheese, eggs, canned fish, onion, and mayonnaise. Mimosa salad got its name because of its resemblance to mimosa flowers scattered on the snow. The similarity is achieved by crumbling and scattering boiled egg yolk on the surface. The salad's popularity in the USSR (and nowadays in the post-Soviet states) has led to the emergence of a wide variety of recipes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-mimosa-salad"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mimosa_salad"}],"sections":[{"h":"Where it's from","links":[["Belarusian cuisine","cuisine/belarusian-cuisine"],["Russian cuisine","cuisine/russian-cuisine"],["Soviet cuisine","cuisine/soviet-cuisine"],["Ukrainian cuisine","cuisine/ukrainian-cuisine"]]},{"h":"Ingredients","count":10,"links":[["Butter","ingredient/butter"],["Canned fish","ingredient/canned-fish"],["Canning","ingredient/canning"],["Cheese","ingredient/cheese"],["Egg","ingredient/egg"],["Grated cheese","ingredient/grated-cheese"],["Mayonnaise","ingredient/mayonnaise"],["Onion","ingredient/onion"],["Potato","ingredient/potato"],["Thunnus","ingredient/thunnus"]]},{"h":"Cook it","rows":[{"name":"Olga's Flavor Factory","color":"#55b8ad","shape":"site","sub":"olgasflavorfactory.com","note":"Russian-born home cook Olga's blog, with a dedicated Russian recipes category.","url":"https://www.olgasflavorfactory.com/category/russianrecipes/","suggested":true,"kind":"blog"},{"name":"Savas Kitchen: Ukrainian recipes","color":"#55b8ad","shape":"site","sub":"savaskitchen.com","note":"Ukrainian-born home cook Nataliia Savas's section of family Ukrainian recipes.","url":"https://savaskitchen.com/category/ukrainian-recipes","suggested":true,"kind":"blog"}]},{"h":"More from Belarusian cuisine","links":[["Angel wings","dish/angel-wings"],["Aspic","dish/aspic"],["Baba (cake)","dish/baba-cake"],["Borscht","dish/borscht"],["Cabbage roll","dish/cabbage-roll"],["Cold beet soup","dish/cold-beet-soup"],["Gugelhupf","dish/gugelhupf"],["Kalduny","dish/kalduny"],["Kasha","dish/kasha"],["Krupnik (soup)","dish/krupnik-soup"],["Medovukha","dish/medovukha"],["Paska (bread)","dish/paska-bread"],["Potato pancake","dish/potato-pancake"],["Šakotis","dish/sakotis"],["Salceson","dish/salceson"],["Solyanka","dish/solyanka"],["Sorrel soup","dish/sorrel-soup"],["Syrniki","dish/syrniki"],["Zatiruha","dish/zatiruha"],["Zrazy","dish/zrazy"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/13/Mimoza_salat_e-citizen.jpg/500px-Mimoza_salat_e-citizen.jpg","w":500,"h":375,"by":"Moonsun1981","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Mimoza_salat_e-citizen.jpg"}},"ingredient/satsivi":{"t":"ingredient","r":"ingredient/satsivi","n":"Satsivi","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Satsivi is a Georgian dish. It is made using poultry (such as chicken or turkey) put into a walnut sauce, typically seasoned with salt, pepper, garlic, fenugreek, coriander and cinnamon. The term satsivi is also used as a generic name for a variety of poultry made with the walnut sauce."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-satsivi"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Satsivi"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Georgian cuisine","cuisine/georgian-cuisine",[["Nigvziani badrijani","dish/nigvziani-badrijani"]]]]},{"h":"Often cooked with","links":[["Eggplant","ingredient/eggplant"],["Garlic","ingredient/garlic"],["Juglans regia","ingredient/juglans-regia"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/9d/Satsivi_%282%29.jpg/500px-Satsivi_%282%29.jpg","w":500,"h":333,"by":"Lesya Dolyk","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Satsivi_(2).jpg"}},"dish/rechao":{"t":"dish","r":"dish/rechao","n":"Rechao","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Taiwan cuisine","dot":"#f0b340","intro":[["Rechao is a style of Taiwanese cuisine that uses a wok to stir fry food. Rechao combines the Chinese characters for \"hot\" (Chinese: 熱) and \"stir-fry\" (Chinese: 炒) and is the Mandarin pronunciation for those characters. It is also known as kuaichao (Chinese: 快炒), which literally means \"fast stir-fry\". Rechao eateries have been compared to Cantonese-style dim sum eateries, the Japanese bar izakaya, British pubs, Hong Kong's dai pai dong, and night markets in Taiwan."]],"src":"wikipedi