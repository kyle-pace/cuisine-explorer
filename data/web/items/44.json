dish/bistro-moulin"]]}]},"ingredient/waffle":{"t":"ingredient","r":"ingredient/waffle","n":"Waffle","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 4 cuisines","intro":[["A waffle is a dish made from usually leavened batter or dough that is cooked between two plates that are patterned to give a characteristic size, shape, and surface impression. There are many variations based on the type of waffle iron and recipe used. Waffles are eaten throughout the world, particularly in Belgium, which has over a dozen regional varieties.  Waffles may be made fresh or simply heated after having been commercially baked and packaged fresh or frozen."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-waffle"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Waffle"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Algerian cuisine","cuisine/algerian-cuisine",[["Zviti","dish/zviti"]]],["American cuisine","cuisine/american-cuisine",[["Croffle","dish/croffle"]]],["Irish cuisine","cuisine/irish-cuisine",[["Croffle","dish/croffle"]]],["South Korean cuisine","cuisine/south-korean-cuisine",[["Croffle","dish/croffle"]]]]},{"h":"Often cooked with","links":[["Croissant","ingredient/croissant"],["Rakhsas","ingredient/rakhsas"]]}]},"dish/el-modelo":{"t":"dish","r":"dish/el-modelo","n":"El Modelo","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from New Mexican cuisine","dot":"#94bd5c","intro":[["El Modelo (originally El Modelo Tortilla Factory) is a Mexican and New Mexican cuisine restaurant in the city of Albuquerque, New Mexico, which was founded in 1929. It is located in the historic neighborhood of Barelas."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-el-modelo"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/El_Modelo"}],"sections":[{"h":"Where it's from","links":[["New Mexican cuisine","cuisine/new-mexican-cuisine"]]},{"h":"Cook it","rows":[{"name":"MJ's Kitchen: Chile and New Mexic