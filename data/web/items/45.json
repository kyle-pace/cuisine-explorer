":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-croissant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Croissant"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["American cuisine","cuisine/american-cuisine",[["Croffle","dish/croffle"]]],["Irish cuisine","cuisine/irish-cuisine",[["Croffle","dish/croffle"]]],["South Korean cuisine","cuisine/south-korean-cuisine",[["Croffle","dish/croffle"]]]]},{"h":"Often cooked with","links":[["Waffle","ingredient/waffle"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/2a/Croissant-Petr_Kratochvil.jpg/500px-Croissant-Petr_Kratochvil.jpg","w":500,"h":333,"by":"Petr Kratochvil","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Croissant-Petr_Kratochvil.jpg"}},"ingredient/ocimum":{"t":"ingredient","r":"ingredient/ocimum","n":"Ocimum","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 4 cuisines","intro":[["Ocimum  is a genus of aromatic annual and perennial herbs and shrubs in the family Lamiaceae, native to the tropical and warm temperate regions of all 6 inhabited continents, with the greatest number of species in Africa. Its best known species are the cooking herb basil, O. basilicum, and the medicinal herb tulsi (holy basil), O. tenuiflorum."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-ocimum"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ocimum"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Afghan cuisine","cuisine/afghan-cuisine",[["Falooda","dish/falooda"]]],["Indian cuisine","cuisine/indian-cuisine",[["Falooda","dish/falooda"]]],["Iranian cuisine","cuisine/iranian-cuisine",[["Falooda","dish/falooda"]]],["Pakistani cuisine","cuisine/pakistani-cuisine",[["Falooda","dish/falooda"]]]]},{"h":"Often cooked with","links":[["Milk","ingredient/milk"],["Rose syrup","ingredient/rose-syrup"],["Rose water","ingredient/rose-water"],["Sweet basil","ingredient/sweet-basil"],["Vermicelli","ingredient/vermicelli"]]}]},"ingredient/vermicelli":{"t":"ingredient","r":"ingredient/vermicelli","n":"Vermicelli","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 4 dishes across 8 cuisines","intro":[["Vermicelli is a type of pasta that is round in section, similar to spaghetti. In English-speaking regions, it is usually thinner than spaghetti, while in Italy it is thicker. It is typically made with semolina."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-vermicelli"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Vermicelli"}],"sections":[{"h":"Where it's cooked with","count":8,"groups":[["Indian cuisine","cuisine/indian-cuisine",[["Falooda","dish/falooda"],["Shemai","dish/shemai"]]],["Afghan cuisine","cuisine/afghan-cuisine",[["Falooda","dish/falooda"]]],["Bangladeshi cuisine","cuisine/bangladeshi-cuisine",[["Shemai","dish/shemai"]]],["Indonesian cuisine","cuisine/indonesian-cuisine",[["Tekwan","dish/tekwan"]]],["Iranian cuisine","cuisine/iranian-cuisine",[["Falooda","dish/falooda"]]],["Moroccan cuisine","cuisine/moroccan-cuisine",[["Harira","dish/harira"]]],["Pakistani cuisine","cuisine/pakistani-cuisine",[["Falooda","dish/falooda"]]],["Palembang cuisine","cuisine/palembang-cuisine",[["Tekwan","dish/tekwan"]]]]},{"h":"Often cooked with","links":[["Milk","ingredient/milk"],["Ocimum","ingredient/ocimum"],["Rose syrup","ingredient/rose-syrup"],["Rose water","ingredient/rose-water"],["Sweet basil","ingredient/sweet-basil"],["Beef","ingredient/beef"],["Chicken","ingredient/chicken"],["Chickpea","ingredient/chickpea"],["Lamb","ingredient/lamb"],["Lentil","ingredient/lentil"],["Olive oil","ingredient/olive-oil"],["Onion","ingredient/onion"],["Rice","ingredient/rice"],["Tomato","ingredient/tomato"],["Wheat flour","ingredient/wheat-flour"],["Cardamom","ingredient/cardamom"]]}],"img":{"src":"/labs/cuisines/img/thumb/f/f2/Fideo_%28coiled_vermicelli%29.JPG/500px-Fideo_%28coiled_vermicelli%29.JPG","w":500,"h":355,"by":"Glane23","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Fideo_(coiled_vermicelli).JPG"}},"dish/fritas-de-prasa":{"t":"dish","r":"dish/fritas-de-prasa","n":"Fritas de prasa","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Sephardic Jewish cuisine","dot":"#f0b340","intro":[["Fritas de prasa, also keftes de prasa and albondigas de prasa are fried potato-leek pancakes common in Sephardic Jewish cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-fritas-de-prasa"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fritas_de_prasa"}],"sections":[{"h":"Where it's from","links":[["Sephardic Jewish cuisine","cuisine/sephardic-jewish-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Egg","ingredient/egg"],["Kosher salt","ingredient/kosher-salt"],["Leeks","ingredient/leeks"],["Matzo meal","ingredient/matzo-meal"],["Potatoes","ingredient/potatoes"]]},{"h":"More from Sephardic Jewish cuisine","links":[["Apio (appetizer)","dish/apio-appetizer"],["Bulemas","dish/bulemas"]]}],"img":{"src":"/labs/cuisines/img/thumb/f/fd/Fritas_de_prasa_ready_a.jpg/500px-Fritas_de_prasa_ready_a.jpg","w":500,"h":375,"by":"w:he:משתמש:assayas","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Fritas_de_prasa_ready_a.jpg"}},"dish/la-tante-dc10-restaurant":{"t":"dish","r":"dish/la-tante-dc10-restaurant","n":"La Tante DC10 Restaurant","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Ghanaian cuisine","dot":"#e46a3f","intro":[["La Tante DC10 Restaurant, known locally as The Green Plane, was a public–private partnership restaurant established in Accra. It operated from the defunct Ghana Airways McDonnell Douglas DC-10, which had been in operation as a passenger jet between 1983 and 2005. The restaurant served staple Ghanaian dishes. The restaurant was well received locall