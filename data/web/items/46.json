"dish/manicoba":{"t":"dish","r":"dish/manicoba","n":"Maniçoba","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Brazilian cuisine","dot":"#94bd5c","intro":[["Maniçoba is a dish in Brazilian cuisine that is from the Brazilian state of Pará located in the Brazilian Amazon. It is of indigenous origin, and is made with leaves of the Manioc plant that have been finely ground and boiled for at least four days and up to a week, to remove their hydrogen cyanide content. The ground and boiled leaves (maniva) are then mixed with salted pork, dried meat and other smoked ingredients, such as bacon and sausage. The dish is served with rice and cassava meal (farinha). Maniçoba is usually eaten during the Círio de Nazaré, a religious festival that takes place in October in the city of Belém."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-manicoba"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mani%C3%A7oba"}],"sections":[{"h":"Where it's from","links":[["Brazilian cuisine","cuisine/brazilian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Olivia's Cuisine","color":"#55b8ad","shape":"site","sub":"oliviascuisine.com","note":"Brazilian-born Olivia Mesquita's blog, with a large section of Brazilian classics.","url":"https://oliviascuisine.com/","suggested":true,"kind":"blog"},{"name":"Easy and Delish","color":"#55b8ad","shape":"site","sub":"easyanddelish.com","note":"Brazilian recipe collection from a Brazilian-born home cook based in the US.","url":"https://www.easyanddelish.com/easy-brazilian-recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Brazilian cuisine","links":[["Arabu","dish/arabu"],["Arroz carreteiro","dish/arroz-carreteiro"],["Bauru (sandwich)","dish/bauru-sandwich"],["Beijinho","dish/beijinho"],["Beirute","dish/beirute"],["Bobó de camarão","dish/bobo-de-camarao"],["Bockwurst","dish/bockwurst"],["Bolo de fubá","dish/bolo-de-fuba"],["Brigadeiro","dish/brigadeiro"],["Canja de galinha","dish/canja-de-galinha"],["Coxinha","dish/coxinha"],["Feijoada","dish/feijoada"],["Manuê","dish/manue"],["Marmelada de Santa Luzia","dish/marmelada-de-santa-luzia"],["Pão na chapa","dish/pao-na-chapa"],["Pie","dish/pie"],["Sobá","dish/soba"],["Xis (sandwich)","dish/xis-sandwich"]]}],"img":{"src":"/world-cuisine/img/thumb/7/75/Manicoba.jpg/500px-Manicoba.jpg","w":500,"h":375,"by":"Ana_Cotta","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Manicoba.jpg"}},"ingredient/endive":{"t":"ingredient","r":"ingredient/endive","n":"Endive","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Endive () is a leaf vegetable belonging to the genus Cichorium, which includes several similar bitter-leafed vegetables. Species include Cichorium endivia (also called endive), Cichorium pumilum (also called wild endive), and Cichorium intybus (also called chicory). Chicory includes types such as radicchio, puntarelle, and Belgian endive."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-endive"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Endive"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Dutch cuisine","cuisine/dutch-cuisine",[["Stamppot","dish/stamppot"]]]]},{"h":"Often cooked with","links":[["Broccoli","ingredient/broccoli"],["Onion","ingredient/onion"],["Potato","ingredient/potato"],["Vegetables","ingredient/vegetables"]]}],"img":{"src":"/world-cuisine/img/thumb/0/00/Cichorium_endivia_-_Botanischer_Garten_Mainz_IMG_5453.JPG/500px-Cichorium_endivia_-_Botanischer_Garten_Mainz_IMG_5453.JPG","w":500,"h":333,"by":"Oceancetaceen - Alice Chodura","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Cichorium_endivia_-_Botanischer_Garten_Mainz_IMG_5453.JPG"}},"dish/tagliatelle":{"t":"dish","r":"dish/tagliatelle","n":"Tagliatelle","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["Tagliatelle are a traditional type of pasta from the Italian regions of Emilia-Romagna and Marche. Individual pieces of tagliatelle are long, flat ribbons that are similar in shape to fettuccine and are traditionally about 6 mm (1⁄4 in) wide. Tagliatelle can be served with a variety of sauces, though the classic is a meat sauce or Bolognese sauce."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-tagliatelle"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tagliatelle"}],"sections":[{"h":"Where it's from","links":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Durum wheat","ingredient/durum-wheat"],["Egg","ingredient/egg"],["Semolina","ingredient/semolina"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's long-running video series filming Italian grandmothers making regional pasta by hand.","url":"https://pastagrannies.substack.com/p/pasta-grannies-is-now-on-substack","suggested":true,"kind":"youtube"},{"name":"Recipes from Italy","color":"#55b8ad","shape":"site","sub":"recipesfromitaly.com","note":"Traditional Italian recipes written by Italian home cooks, organized by region and course.","url":"https://recipesfromitaly.com","suggested":true,"kind":"blog"},{"name":"Manu's Menu","color":"#55b8ad","shape":"site","sub":"manusmenu.com","note":"Italian-born home cook Manuela sharing classic family and regional Italian dishes.","url":"https://www.manusmenu.com/about/about-this-site","suggested":true,"kind":"blog"}]},{"h":"More from Italian cuisine","links":[["Acquacotta","dish/acquacotta"],["Agliata","dish/agliata"],["Agnolotti","dish/agnolotti"],["Antipasto","dish/antipasto"],["Arancini","dish/arancini"],["Biscotti","dish/biscotti"],["Bolinhos de bacalhau","dish/bolinhos-de-bacalhau"],["Bombolone","dish/bombolone"],["Budino","dish/budino"],["Ca