{"src":"/labs/cuisines/img/thumb/7/78/Studio_Building_from_the_south_-_Portland%2C_Oregon_%282019%29_%28cropped%29.jpg/500px-Studio_Building_from_the_south_-_Portland%2C_Oregon_%282019%29_%28cropped%29.jpg","w":500,"h":256,"by":"Steve Morgan","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Studio_Building_from_the_south_-_Portland%2C_Oregon_(2019)_(cropped).jpg"}},"ingredient/siling-labuyo":{"t":"ingredient","r":"ingredient/siling-labuyo","n":"Siling labuyo","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Siling labuyo is a small chili pepper cultivar that developed in the Philippines after the Columbian Exchange, particularly the Manila galleon trade. It belongs to the species Capsicum frutescens and is characterized by triangular fruits that grow pointing upwards. The fruits and leaves are used in traditional Philippine cuisine. The fruit is pungent, ranking at 80,000 to 100,000 heat units in the Scoville scale."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-siling-labuyo"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Siling_labuyo"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Pecel ayam","dish/pecel-ayam"]]]]},{"h":"Often cooked with","links":[["Chicken","ingredient/chicken"],["Grated coconut","ingredient/grated-coconut"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/bf/Capsicum_%27Siling_Labuyo%27_%28Mindanao%2C_Philippines%29_2.jpg/500px-Capsicum_%27Siling_Labuyo%27_%28Mindanao%2C_Philippines%29_2.jpg","w":500,"h":378,"by":"Obsidian Soul","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Capsicum_'Siling_Labuyo'_(Mindanao%2C_Philippines)_2.jpg"}},"ingredient/rusk":{"t":"ingredient","r":"ingredient/rusk","n":"Rusk","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A rusk is a hard, dry biscuit or a twice-baked bread. It is sometimes used as a teether for babies. In some cultures, rusk is made of cake rather than bread: this is sometimes referred to as cake rusk. In the UK, the name also refers to a wheat-based food additive."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-rusk"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rusk"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Russian cuisine","cuisine/russian-cuisine",[["Polonaise sauce","dish/polonaise-sauce"]]]]},{"h":"Often cooked with","links":[["Breadcrumbs","ingredient/breadcrumbs"],["Butter","ingredient/butter"]]}]},"ingredient/crab-stick":{"t":"ingredient","r":"ingredient/crab-stick","n":"Crab stick","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Crab sticks, krab sticks, snow legs, imitation crab meat, or seafood sticks are a Japanese seafood product made of surimi (pulverized whitefish) and starch, shaped and cured to resemble the leg meat of snow crab or Japanese spider crab. It is a product that uses fish meat to imitate shellfish meat."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-crab-stick"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Crab_stick"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Japanese cuisine","cuisine/japanese-cuisine",[["Rainbow roll","dish/rainbow-roll"]]]]},{"h":"Often cooked with","links":[["Avocado","ingredient/avocado"],["Cucumber","ingredient/cucumber"],["Rice","ingredient/rice"]]}],"img":{"src":"/labs/cuisines/img/thumb/c/c7/Kanikama.jpg/500px-Kanikama.jpg","w":500,"h":375,"by":"Original uploader was Natto at ja.wikipedia","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Kanikama.jpg"}},"dish/sarbhaja":{"t":"dish","r":"dish/sarbhaja","n":"Sarbhaja","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Bengali cuisine","dot":"#f0b340","intro":[["A Sarbhaja is a milk based sweet originating from West Bengal, which is one of the famous Bengali sweets. The sweet's name comes from sar, the surface creamy layer of milk which is its main ingredient, and the word Bhaja refers to the frying of the sar. The Sarbhaja uses cow's milk and ghee is used for frying. It is fried until golden brown in color. This sweet made from milk is famous throughout Bengal."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-sarbhaja"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sarbhaja"}],"sections":[{"h":"Where it's from","links":[["Bengali cuisine","cuisine/bengali-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Cardamom","ingredient/cardamom"],["Ghee","ingredient/ghee"],["Kheer (Bengali sweets)","ingredient/kheer-bengali-sweets"],["Maida (flour)","ingredient/maida-flour"],["Milk skin","ingredient/milk-skin"],["Sugar","ingredient/sugar"]]},{"h":"Cook it","rows":[{"name":"Playful Cooking (Bengali cuisine)","ref":"site/playfulcooking-com","color":"#55b8ad","shape":"site","sub":"playfulcooking.com","note":"Bengali section of Kankana Saxena's home cooking blog.","url":"https://www.playfulcooking.com/category/bengali-cuisine","suggested":true}]},{"h":"More from Bengali cuisine","links":[["Chutney","dish/chutney"],["Pilaf","dish/pilaf"],["Roti","dish/roti"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/0c/Shorbhaja.jpg/500px-Shorbhaja.jpg","w":500,"h":333,"by":"Sumit Surai","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Shorbhaja.jpg"}},"ingredient/buffalo-meat":{"t":"ingredient","r":"ingredient/buffalo-meat","n":"Buffalo meat","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Buffalo meat is the meat of the water buffalo, a large bovid, raised for its milk and meat in many countries. The water buffalo population is distributed worldwide, but ninety-seven percent of it is located in Asia. China, Pakistan, and India have most of the available stock."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-buffalo-meat"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Buffalo_meat"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Sop saudara","dish/sop-saudara"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Candlenut","ingredient/candlenut"],["Caraway","ingredient/caraway"],["Cinnamon","ingredient/cinnamon"],["Galangal","ingredient/galangal"],["Ginger","ingredient/ginger"],["Lemongrass","ingredient/lemongrass"],["Nutmeg","ingredient/nutmeg"],["Perkedel","ingredient/perkedel"],["Rice vermicelli","ingredient/rice-vermicelli"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/9b/Water_buffalo%2C_Little_Hungerford%2C_West_Berkshire_-_geograph.org.uk_-_398640.jpg/500px-Water_buffalo%2C_Little_Hungerford%2C_West_Berkshire_-_geograph.org.uk_-_398640.jpg","w":500,"h":375,"by":"Brian Robert Marshall","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Water_buffalo%2C_Little_Hungerford%2C_West_Berkshire_-_geograph.org.uk_-_398640.jpg"}},"cookbook/the-medieval-kitchen-recipes-from-france-and-italy":{"t":"book","r":"cookbook/the-medieval-kitchen-recipes-from-france-and-italy","n":"The Medieval Kitchen: Recipes from France and Italy","c":"#f0b340","crumb":[["Cookbooks","cookbooks"]],"sub":"Cookbook by Odile Redon, Françoise Sabban and Silvano Serventi, 1998","square":true,"suggested":true,"intro":[["Food historians' adaptations of 14th and 15th century French and Italian recipes, with historical commentary."]],"actions":[],"sections":[{"h":"Cuisines it covers","count":1,"links":[["Medieval cuisine","cuisine/medieval-cuisine"]]}]},"site/patijinich-com":{"t":"site","r