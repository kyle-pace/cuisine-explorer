{"cuisine/namibian-cuisine":{"t":"cuisine","r":"cuisine/namibian-cuisine","n":"Namibian cuisine","c":"#e46a3f","crumb":[["Africa","cuisines#africa"],["Cuisine"]],"sub":"National cuisine of Namibia","intro":[["Namibian cuisine is the cuisine of Namibia. It is influenced by two primary cultural strands: cookery practised by indigenous people of Namibia such as the Himba, Herero and San groups; and settler cookery introduced during the colonial period by people of German, Afrikaner and British descent."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"namibian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Namibian_cuisine"}],"sections":[{"h":"Recipe sites","count":1,"rows":[{"name":"Ester kocht","color":"#55b8ad","shape":"site","sub":"esterkocht.com","note":"Namibian and German home recipes from Namibian born Ester, now living in Bavaria.","url":"https://www.esterkocht.com/about/","suggested":true,"kind":"blog"}]},{"h":"Cookbooks","count":1,"rows":[{"name":"My Hungry Heart: Notes from a Namibian Kitchen","color":"#f0b340","shape":"book","sub":"Antoinette de Chavonnes Vrugt, 2009","note":"Namibian recipe collection released in Windhoek, with text by Christine Hugo.","url":"","suggested":true}]}],"cont":"African cuisine","img":{"src":"/world-cuisine/img/thumb/5/5b/Grilled_game.JPG/500px-Grilled_game.JPG","w":500,"h":375,"by":"ElGringoLoco","lic":"CC BY-SA 3.0 at","licUrl":"https://creativecommons.org/licenses/by-sa/3.0/at/deed.en","page":"https://commons.wikimedia.org/wiki/File:Grilled_game.JPG"}},"ingredient/scrambled-egg":{"t":"ingredient","r":"ingredient/scrambled-egg","n":"Scrambled egg","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Scrambled eggs is a culinary dish made from eggs (usually chicken eggs), where the whites and yolks have been stirred, whipped, or beaten together (typically with the addition of other ingredients), then heated so that the proteins denature and coagulate, and they form into \"curds\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-scrambled-egg"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Scrambled_egg"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Indian cuisine","cuisine/indian-cuisine",[["Akuri","dish/akuri"]]],["Iranian cuisine","cuisine/iranian-cuisine",[["Akuri","dish/akuri"]]]]},{"h":"Often cooked with","links":[["Mentha","ingredient/mentha"],["Scrambled eggs","ingredient/scrambled-eggs"]]}],"img":{"src":"/world-cuisine/img/thumb/2/20/Scrambed_eggs.jpg/500px-Scrambed_eggs.jpg","w":500,"h":500,"by":"Takeaway","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Scrambed_eggs.jpg"}},"dish/bap-rice-dish":{"t":"dish","r":"dish/bap-rice-dish","n":"Bap (rice dish)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Korean cuisine","dot":"#f0b340","intro":[["Bap is a Korean name for cooked rice prepared by boiling rice or other grains, such as black rice, barley, sorghum, various millets, and beans, until the water has cooked away. Special ingredients such as vegetables, seafood, and meat can also be added to create different kinds of bap. In the past, except for the socially wealthy class, people used to eat mixed grain rice together with beans and barley rather than only rice."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-bap-rice-dish"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bap_(rice_dish)"}],"sections":[{"h":"Where it's from","links":[["Korean cuisine","cuisine/korean-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Japonica rice","ingredient/japonica-rice"]]},{"h":"Cook it","rows":[{"name":"Maangchi","color":"#55b8ad","shape":"site","sub":"maangchi.com","note":"Maangchi's Korean recipe site and YouTube channel, one of the best known English sources for Korean cooking.","url":"https://www.maangchi.com/","suggested":true,"kind":"youtube"},{"name":"Korean Bapsang","color":"#55b8ad","shape":"site","sub":"koreanbapsang.com","note":"Home-style Korean recipes from Hyosun, a Korean-American mom.","url":"https://www.koreanbapsang.com/category/recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Korean cuisine","links":[["Bibim-guksu","dish/bibim-guksu"],["Bibimbap","dish/bibimbap"],["Bosintang","dish/bosintang"],["Cheonggukjang","dish/cheonggukjang"],["Doenjang","dish/doenjang"],["Garak-guksu","dish/garak-guksu"],["Gochujang","dish/gochujang"],["Gopchang","dish/gopchang"],["Hwajeon","dish/hwajeon"],["Jijimi","dish/jijimi"],["Jokbal","dish/jokbal"],["Korean restaurant","dish/korean-restaurant"],["Maekjeok","dish/maekjeok"],["Maeun-tang","dish/maeun-tang"],["Makchang","dish/makchang"],["Mandu-guk","dish/mandu-guk"],["Mandu-gwa","dish/mandu-gwa"],["Meat jun","dish/meat-jun"],["Meju","dish/meju"],["Morkovcha","dish/morkovcha"],["Scorched rice","dish/scorched-rice"],["Seon (food)","dish/seon-food"],["Sungnyung","dish/sungnyung"],["Tteokbokki","dish/tteokbokki"],["Wakame","dish/wakame"],["Yakgwa","dish/yakgwa"],["Yukpo","dish/yukpo"]]}],"img":{"src":"/world-cuisine/img/thumb/7/7f/Bap_%28cooked_rice%29.jpg/500px-Bap_%28cooked_rice%29.jpg","w":500,"h":333,"by":"rozh3","lic":"CC BY 2.5","licUrl":"https://creativecommons.org/licenses/by/2.5","page":"https://commons.wikimedia.org/wiki/File:Bap_(cooked_rice).jpg"}},"ingredient/rice-water":{"t":"ingredient","r":"ingredient/rice-water","n":"Rice water","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Rice water is a suspension of starch obtained by draining boiled rice or by boiling rice until it completely dissolves into the water.  It has sometimes been used as food for people with medical conditions affecting the digestive system.  It has been claimed to be particularly effective in the treatment of diarrhea such as that arising in cholera or gastroenteritis."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-rice-water"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rice_water"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Coto makassar","dish/coto-makassar"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Black pepper","ingredient/black-pepper"],["Broth","ingredient/broth"],["Candlenut","ingredient/candlenut"],["Caraway","ingredient/caraway"],["Celery","ingredient/celery"],["Chili pepper","ingredient/chili-pepper"],["Cinnamomum verum","ingredient/cinnamomum-verum"],["Coconut milk","ingredient/coconut-milk"],["Galangal","ingredient/galangal"],["Ginger","ingredient/ginger"],["Lemongrass","ingredient/lemongrass"],["Lime","ingredient/lime"],["Lontong","ingredient/lontong"],["Offal","ingredient/offal"],["Palm sugar","ingredient/palm-sugar"]]}],"img":{"src":"/world-cuisine/img/thumb/5/52/Rice_Water.jpg/500px-Rice_Water.jpg","w":500,"h":279,"by":"Tausif.zawad","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Rice_Water.jpg"}},"ingredient/bechamel-sauce":{"t":"ingredient","r":"ingredient/bechamel-sauce","n":"Béchamel sauce","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 4 dishes across 6 cuisines","intro":[["Béchamel sauce is a white sauce made from a roux of butter and flour, heated in cream or milk, and seasoned with ground nutmeg. Béchamel is one of the mother sauces of French cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-bechamel-sauce"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/B%C3%A9chamel_sauce"}],"sections":[{"h":"Where it's cooked with","count":6,"groups":[["French cuisine","cuisine/french-cuisine",[["Nantua sauce","dish/nantua-sauce"]]],["Italian cuisine","cuisine/italian-cuisine",[["Lasagna","dish/lasagna"]]],["Neapolitan cuisine","cuisine/neapolitan-cuisine",[["Crocchè","dish/crocche"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Nantua sauce","dish/nantua-sauce"]]],["Sicilian cuisine","cuisine/sicilian-cuisine",[["Crocchè","dish/crocche"]]],["Yoshoku","cuisine/yoshoku",[["Doria (food)","dish/doria-food"]]]]},{"h":"Often cooked with","links":[["Cheese","ingredient/cheese"],["Brown sauce","ingredient/brown-sauce"],["Ground meat","ingredient/ground-meat"],["Ham","ingredient/ham"],["Mashed potato","ingredient/mashed-potato"],["Shellfish","ingredient/shellfish"],["Béchamel","ingredient/bechamel"],["Pilaf","ingredient/pilaf"],["Rice","ingredient/rice"],["Parmesan","ingredient/parmesan"],["Ragù","ingredient/ragu"]]}],"img":{"src":"/world-cuisine/img/thumb/8/8a/2021_Sos_beszamelowy.jpg/500px-2021_Sos_beszamelowy.jpg","w":500,"h":352,"by":"Jacek Halicki","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:2021_Sos_beszamelowy.jpg"}},"dish/gochujang":{"t":"dish","r":"dish/gochujang","n":"Gochujang","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Korean cuisine","dot":"#f0b340","intro":[["Gochujang or red chili paste is a savory, sweet, and spicy fermented  condiment popular in Korean cooking. It is made from gochugaru  (red chili powder), chapssal (glutinous rice), meju (fermented soybean) powder, yeotgireum (barley malt powder), and salt. The sweetness comes from the starch of cooked glutinous rice, cultured with saccharifying enzymes during the fermentation process. Traditionally, it would be naturally fermented over years in jangdok (earthenware) on an elevated stone platform called jangdokdae in the backyard."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-gochujang"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Gochujang"}],"sections":[{"h":"Where it's from","links":[["Korean cuisine","cuisine/korean-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Chili powder","ingredient/chili-powder"],["Glutinous rice","ingredient/glutinous-rice"],["Gochu-garu","ingredient/gochu-garu"],["Malt","ingredient/malt"],["Meju","ingredient/meju"]]},{"h":"Cook it","rows":[{"name":"Maangchi","color":"#55b8ad","shape":"site","sub":"maangchi.com","note":"Maangchi's Korean recipe site and YouTube channel, one of the best known English sources for Korean cooking.","url":"https://www.maangchi.com/","suggested":true,"kind":"youtube"},{"name":"Korean Bapsang","color":"#55b8ad","shape":"site","sub":"koreanbapsang.com","note":"Home-style Korean recipes from Hyosun, a Korean-American mom.","url":"https://www.koreanbapsang.com/category/recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Korean cuisine","links":[["Bap (rice dish)","dish/bap-rice-dish"],["Bibim-guksu","dish/bibim-guksu"],["Bibimbap","dish/bibimbap"],["Bosintang","dish/bosintang"],["Cheonggukjang","dish/cheonggukjang"],["Doenjang","dish/doenjang"],["Garak-guksu","dish/garak-guksu"],["Gopchang","dish/gopchang"],["Hwajeon","dish/hwajeon"],["Jijimi","dish/jijimi"],["Jokbal","dish/jokbal"],["Korean restaurant","dish/korean-restaurant"],["Maekjeok","dish/maekjeok"],["Maeun-tang","dish/maeun-tang"],["Makchang","dish/makchang"],["Mandu-guk","dish/mandu-guk"],["Mandu-gwa","dish/mandu-gwa"],["Meat jun","dish/meat-jun"],["Meju","dish/meju"],["Morkovcha","dish/morkovcha"],["Scorched rice","dish/scorched-rice"],["Seon (food)","dish/seon-food"],["Sungnyung","dish/sungnyung"],["Tteokbokki","dish/tteokbokki"],["Wakame","dish/wakame"],["Yakgwa","dish/yakgwa"],["Yukpo","dish/yukpo"]]}]},"dish/italian-tomato-pie":{"t":"dish","r":"dish/italian-tomato-pie","n":"Italian tomato pie","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian-American cuisine","dot":"#94bd5c","intro":[["Italian tomato pie is an Italian-American and Italian-Canadian baked good consisting of a thick, porous, focaccia-like dough covered with tomato sauce. It may be sprinkled with Romano cheese or oregano. It is not usually served straight from the oven, but allowed to cool and then consumed at room temperature or reheated. Like Sicilian pizza, tomato pie is baked in a large rectangular pan and usually served in square slices, although in Rhode Island it is cut into rectangular strips like pizza al taglio. Tomato pie descends from and resembles the Italian sfincione, although it is not the same dish. For instance, sfincione may have toppings, is usually served hot, and has a crust more like brioche than focaccia."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-italian-tomato-pie"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Italian_tomato_pie"}],"sections":[{"h":"Where it's from","links":[["Italian-American cuisine","cuisine/italian-american-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Focaccia","ingredient/focaccia"],["Tomato sauce","ingredient/tomato-sauce"]]},{"h":"More from Italian-American cuisine","links":[["Chicken Francese","dish/chicken-francese"],["Fettuccine Alfredo","dish/fettuccine-alfredo"],["Garlic bread","dish/garlic-bread"],["Italian beef","dish/italian-beef"],["Rollatini","dish/rollatini"],["Spaghetti and meatballs","dish/spaghetti-and-meatballs"],["Stromboli (food)","dish/stromboli-food"],["Tetrazzini","dish/tetrazzini"],["Vodka sauce","dish/vodka-sauce"]]}],"img":{"src":"/world-cuisine/img/2/29/TomatoPie.jpg","w":500,"h":333,"by":"Frank DuRoss Jr. a.k.a. Fduross of English Wikipedia","lic":"CC BY-SA 2.5","licUrl":"https://creativecommons.org/licenses/by-sa/2.5","page":"https://commons.wikimedia.org/wiki/File:TomatoPie.jpg"}},"dish/kalitsounia":{"t":"dish","r":"dish/kalitsounia","n":"Kalitsounia","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Greek cuisine","dot":"#cf5f87","intro":[["Kalitsounia are small cheese or herb snacks associated with the Greek island of Crete. They can be described as a treat, with different filling and serving variations. In the Chania region, salty kalitsounia are found, stuffed with the locally made mild whey cheese mizithra, or various herbs from the Cretan land (without cheese) and the sweet kalitsounia, also stuffed with mizithra but with honey poured on top. In the Lasithi region, they are mainly sweet, made with dough and filled with mizithra, cinnamon, and sometimes lemon zest."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kalitsounia"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kalitsounia"}],"sections":[{"h":"Where it's from","links":[["Greek cuisine","cuisine/greek-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Honey","ingredient/honey"],["Mizithra","ingredient/mizithra"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Dimitra's Dishes","color":"#55b8ad","shape":"site","sub":"dimitrasdishes.com","note":"Dimitra Alfieris's video channel and blog focused on classic Greek home cooking.","url":"https://dimitrasdishes.com","suggested":true,"kind":"youtube"}]},{"h":"More from Greek cuisine","links":[["Avgolemono","dish/avgolemono"],["Baba ghanoush","dish/baba-ghanoush"],["Bouyiourdi","dish/bouyiourdi"],["Cabbage roll","dish/cabbage-roll"],["Diples","dish/diples"],["Fasolada","dish/fasolada"],["Freddo cappuccino","dish/freddo-cappuccino"],["Greek restaurant","dish/greek-restaurant"],["Greek salad","dish/greek-salad"],["İmam bayıldı","dish/imam-bay-ld"],["Kakavia (soup)","dish/kakavia-soup"],["Karydopita","dish/karydopita"],["Keşkek","dish/keskek"],["Ladera","dish/ladera"],["Noumboulo","dish/noumboulo"],["Psarosoupa","dish/psarosoupa"],["Spanakorizo","dish/spanakorizo"],["Taramasalata","dish/taramasalata"],["Tzatziki","dish/tzatziki"]]}],"img":{"src":"/world-cuisine/img/thumb/0/09/Restaurant_Erotokritos_%28Almyrida%29_-_beignets.jpg/500px-Restaurant_Erotokritos_%28Almyrida%29_-_beignets.jpg","w":500,"h":601,"by":"Benoît Prieur","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Restaurant_Erotokritos_(Almyrida)_-_beignets.jpg"}},"dish/oyakodon":{"t":"dish","r":"dish/oyakodon","n":"Oyakodon","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Oyakodon, literally \"parent-and-child donburi\", is a donburi, or Japanese rice bowl dish, in which chicken, egg, sliced scallion (or sometimes regular onions), and other ingredients are all simmered together in a kind of soup that is made with soy sauce and stock, and then served on top of a large bowl of rice. The name of the dish is a poetic reflection of both chicken and egg being used in the dish."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-oyakodon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Oyakodon"}],"sections":[{"h":"Where it's from","links":[["Japanese cuisine","cuisine/japanese-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Chicken","ingredient/chicken"],["Egg","ingredient/egg"],["Rice","ingredient/rice"]]},{"h":"Cook it","rows":[{"name":"Just One Cookbook","color":"#55b8ad","shape":"site","sub":"justonecookbook.com","note":"Namiko Chen's long-running blog and videos on Japanese home cooking.","url":"https://justonecookbook.com","suggested":true,"kind":"blog"},{"name":"RecipeTin Japan","color":"#55b8ad","shape":"site","sub":"japan.recipetineats.com","note":"Japanese home recipes from Yumiko, a Japan-born cook, sister site to RecipeTin Eats.","url":"https://japan.recipetineats.com/","suggested":true,"kind":"blog"}]},{"h":"More from Japanese cuisine","links":[["Bergh–Stoutenburgh House","dish/bergh-stoutenburgh-house"],["Chikuwa","dish/chikuwa"],["Curry bread","dish/curry-bread"],["Donburi","dish/donburi"],["Fukamushicha","dish/fukamushicha"],["Gyokuro","dish/gyokuro"],["Hitsumabushi","dish/hitsumabushi"],["Horumonyaki","dish/horumonyaki"],["Iekei ramen","dish/iekei-ramen"],["Inago no tsukudani","dish/inago-no-tsukudani"],["Itamae","dish/itamae"],["Izakaya","dish/izakaya"],["Japanese cheesecake","dish/japanese-cheesecake"],["Japanese noodles","dish/japanese-noodles"],["Japanese restaurant","dish/japanese-restaurant"],["Japanese tea","dish/japanese-tea"],["Jingisukan","dish/jingisukan"],["Kaki furai","dish/kaki-furai"],["Kamaboko","dish/kamaboko"],["Kōji (food)","dish/koji-food"],["Kusa mochi","dish/kusa-mochi"],["Kushikatsu","dish/kushikatsu"],["List of Japanese restaurants","dish/list-of-japanese-restaurants"],["Makizushi","dish/makizushi"],["Miso","dish/miso"],["Miso soup","dish/miso-soup"],["Monjayaki","dish/monjayaki"],["Nikujaga","dish/nikujaga"],["Nimono","dish/nimono"],["Oden","dish/oden"],["Onigiri","dish/onigiri"],["Osechi","dish/osechi"],["Rainbow roll","dish/rainbow-roll"],["Ramen","dish/ramen"],["Ryōtei","dish/ryotei"],["Sashimi","dish/sashimi"],["Sencha","dish/sencha"],["Shizuoka oden","dish/shizuoka-oden"],["Sumiso","dish/sumiso"],["Sushi","dish/sushi"]]}],"img":{"src":"/world-cuisine/img/thumb/2/29/Oyakodon_003.jpg/500px-Oyakodon_003.jpg","w":500,"h":334,"by":"Ocdp","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Oyakodon_003.jpg"}},"ingredient/hot-water-crust-pastry":{"t":"ingredient","r":"ingredient/hot-water-crust-pastry","n":"Hot water crust pastry","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Hot water crust is a type of pastry used for savoury pies, such as pork pies, game pies, Scotch pies and more rarely, steak and kidney pies. Hot water crust is traditionally used for producing hand-made pies."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-hot-water-crust-pastry"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hot_water_crust_pastry"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["English cuisine","cuisine/english-cuisine",[["Pork pie","dish/pork-pie"]]]]},{"h":"Often cooked with","links":[["Pork","ingredient/pork"],["Pork jelly","ingredient/pork-jelly"]]}],"img":{"src":"/world-cuisine/img/thumb/2/21/Melton_Mowbray_Pork_Pie.png/500px-Melton_Mowbray_Pork_Pie.png","w":500,"h":431,"by":"Innocenceisdeath","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Melton_Mowbray_Pork_Pie.png"}}}