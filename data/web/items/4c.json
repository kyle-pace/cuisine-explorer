{"cuisine/namibian-cuisine":{"t":"cuisine","r":"cuisine/namibian-cuisine","n":"Namibian cuisine","c":"#e46a3f","crumb":[["Africa","cuisines#africa"],["Cuisine"]],"sub":"National cuisine of Namibia","intro":[["Namibian cuisine is the cuisine of Namibia. It is influenced by two primary cultural strands: cookery practised by indigenous people of Namibia such as the Himba, Herero and San groups; and settler cookery introduced during the colonial period by people of German, Afrikaner and British descent."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"namibian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Namibian_cuisine"}],"sections":[{"h":"Recipe sites","count":1,"rows":[{"name":"Ester kocht","ref":"site/esterkocht-com","color":"#55b8ad","shape":"site","sub":"esterkocht.com","note":"Namibian and German home recipes from Namibian born Ester, now living in Bavaria.","url":"https://www.esterkocht.com/about/","suggested":true}]},{"h":"Cookbooks","count":1,"rows":[{"name":"My Hungry Heart: Notes from a Namibian Kitchen","ref":"cookbook/my-hungry-heart-notes-from-a-namibian-kitchen","color":"#f0b340","shape":"book","sub":"Antoinette de Chavonnes Vrugt, 2009","note":"Namibian recipe collection released in Windhoek, with text by Christine Hugo.","url":"","suggested":true}]}],"cont":"African cuisine"},"ingredient/scrambled-egg":{"t":"ingredient","r":"ingredient/scrambled-egg","n":"Scrambled egg","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Scrambled eggs is a culinary dish made from eggs (usually chicken eggs), where the whites and yolks have been stirred, whipped, or beaten together (typically with the addition of other ingredients), then heated so that the proteins denature and coagulate, and they form into \"curds\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-scrambled-egg"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Scrambled_egg"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Indian cuisine","cuisine/indian-cuisine",[["Akuri","dish/akuri"]]],["Iranian cuisine","cuisine/iranian-cuisine",[["Akuri","dish/akuri"]]]]},{"h":"Often cooked with","links":[["Mentha","ingredient/mentha"],["Scrambled eggs","ingredient/scrambled-eggs"]]}]},"dish/bap-rice-dish":{"t":"dish","r":"dish/bap-rice-dish","n":"Bap (rice dish)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Korean cuisine","dot":"#f0b340","intro":[["Bap is a Korean name for cooked rice prepared by boiling rice or other grains, such as black rice, barley, sorghum, various millets, and beans, until the water has cooked away. Special ingredients such as vegetables, seafood, and meat can also be added to create different kinds of bap. In the past, except for the socially wealthy class, people used to eat mixed grain rice together with beans and barley rather than only rice."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-bap-rice-dish"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bap_(rice_dish)"}],"sections":[{"h":"Where it's from","links":[["Korean cuisine","cuisine/korean-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Japonica rice","ingredient/japonica-rice"]]},{"h":"Cook it","rows":[{"name":"Maangchi","ref":"site/maangchi-com","color":"#55b8ad","shape":"site","sub":"maangchi.com","note":"Maangchi's Korean recipe site and YouTube channel, one of the best known English sources for Korean cooking.","url":"https://www.maangchi.com/","suggested":true},{"name":"Korean Bapsang","ref":"site/koreanbapsang-com","color":"#55b8ad","shape":"site","sub":"koreanbapsang.com","note":"Home-style Korean recipes from Hyosun, a Korean-American mom.","url":"https://www.koreanbapsang.com/category/recipes/","suggested":true}]},{"h":"More from Korean cuisine","links":[["Bibim-guksu","dish/bibim-guksu"],["Bibimbap","dish/bibimbap"],["Bosintang","dish/bosintang"],["Cheonggukjang","dish/cheonggukjang"],["Danji","dish/danji"],["Doenjang