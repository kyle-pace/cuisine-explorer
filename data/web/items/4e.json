{"cuisine/rwandan-cuisine":{"t":"cuisine","r":"cuisine/rwandan-cuisine","n":"Rwandan cuisine","c":"#e46a3f","crumb":[["Africa","cuisines#africa"],["Cuisine"]],"sub":"National cuisine of Rwanda","intro":[["Rwandan cuisine differs from other East African cuisine by its greater plant-based ingredients and sauces, despite considerable overlap in ingredients. Staple foods are largely produced from subsistence agriculture, although with notable regional variation."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"rwandan-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rwandan_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]}],"cont":"African cuisine","img":{"src":"/labs/cuisines/img/thumb/1/13/Rwanda_fruits.jpg/500px-Rwanda_fruits.jpg","w":500,"h":332,"by":"Antoshananarivo","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Rwanda_fruits.jpg"}},"cuisine/zhuang-cuisine":{"t":"cuisine","r":"cuisine/zhuang-cuisine","n":"Zhuang cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Chinese cuisine","cuisine/chinese-cuisine"]],"sub":"Regional cuisine in China","intro":[],"src":null,"wiki":"Zhuang cuisine","actions":[{"kind":"globe","hash":"zhuang-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Zhuang_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Part of","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]}],"cont":"Asian cuisine"},"ingredient/tortilla":{"t":"ingredient","r":"ingredient/tortilla","n":"Tortilla","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 6 dishes across 2 cuisines","intro":[["A tortilla is a thin, circular unleavened flatbread, originally made from corn (maize) but now also made of wheat flour. The corn tortilla is a staple food in most of Mexico and Central America, while the flour tortilla is typical of No