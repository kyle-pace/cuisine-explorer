rg/wiki/File:Oisterwijk-delind-08080039.jpg"}},"ingredient/steamed-rice":{"t":"ingredient","r":"ingredient/steamed-rice","n":"Steamed rice","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Cooked rice refers to rice that has been cooked either by steaming or boiling. The terms steamed rice or boiled rice are also commonly used. Any variant of Asian rice (both indica and japonica varieties), African rice or wild rice, glutinous or non-glutinous, long-, medium-, or short-grain, of any colour, can be used. Rice for cooking can be whole-grain or milled."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-steamed-rice"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Steamed_rice"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Afghan cuisine","cuisine/afghan-cuisine",[["Kabuli pulao","dish/kabuli-pulao"]]]]},{"h":"Often cooked with","links":[["Carrot","ingredient/carrot"],["Carrots","ingredient/carrots"],["Lamb","ingredient/lamb"],["Nut_(fruit)","ingredient/nut-fruit"],["Raisin","ingredient/raisin"],["Raisins","ingredient/raisins"],["Rice","ingredient/rice"],["Veal","ingredient/veal"]]}]},"dish/kuluban":{"t":"dish","r":"dish/kuluban","n":"Kuluban","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Kuluban is a traditional salad of Central Java. Kuluban can be consumed on its own as a salad for vegetarian meals or as a side dish. Kuluban is one of ancient Javanese cuisine, as it was mentioned in inscription dated from Medang Mataram era circa 9th century CE."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kuluban"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kuluban"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Carrot","ingredient/carrot"],["Coconut","ingredient/coconut"],["Ipomoea aquatica","ingredient/