org/wiki/File:Kuluban_topped_with_Serundeng.jpg"}},"ingredient/aspergillus-niger":{"t":"ingredient","r":"ingredient/aspergillus-niger","n":"Aspergillus niger","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Aspergillus niger ( ) is a mold classified within the Nigri section of the Aspergillus genus. The Aspergillus genus consists of common molds found throughout the environment within soil and water, on vegetation, in fecal matter, on decomposing matter, and suspended in the air. Species within this genus often grow quickly and can sporulate within a few days of germination. A combination of characteristics unique to A. niger makes the microbe invaluable to the production of many acids, proteins and bioactive compounds. Characteristics including extensive metabolic diversity, high production yield, secretion capability, and the ability to conduct post-translational modifications are responsible for A. niger's robust production of secondary metabolites. A. niger's capability to withstand extremely acidic conditions makes it effective as an industrial producer of citric acid."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-aspergillus-niger"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Aspergillus_niger"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Japanese cuisine","cuisine/japanese-cuisine",[["Kōji (food)","dish/koji-food"]]]]},{"h":"Often cooked with","links":[["Aspergillus luchuensis","ingredient/aspergillus-luchuensis"],["Aspergillus oryzae","ingredient/aspergillus-oryzae"],["Aspergillus sojae","ingredient/aspergillus-sojae"],["Aspergillus tamarii","ingredient/aspergillus-tamarii"],["Aspergillus tubingensis","ingredient/aspergillus-tubingensis"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/74/Aspergillus_niger_01.jpg/500px-Aspergillus_niger_01.jpg","w":500,"h":346,"by":"Unknown author","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Aspergillus_niger_01.jpg"}},"dish/meuseukat":{"t":"dish","r":"dish/meuseukat","n":"Meuseukat","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Meuseukat is a dodol-like cake found in Acehnese cuisine. The cake is made using flour, sugar, a mixture of pineapple and lemon juice, and butter. The pineapple used in the cake imparts a yellow hue. Meuseukat is typically served on special occasions, such as during wedding festivities, and religious celebrations like Eid al-Fitr and Eid al-Adha."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-meuseukat"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Meuseukat"}],"sections":[{"h":"Where it's from","links":[["Acehnese cuisine","cuisine/acehnese-cuisine"],["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Butter","ingredient/butter"],["Orange","ingredient/orange"],["Pineapple","ingredient/pineapple"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","ref":"site/dailycookingquest-com","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true}]},{"h":"More from Acehnese cuisine","links":[["Keumamah","dish/keumamah"],["Mie aceh","dish/mie-aceh"],["Mie caluk","dish/mie-caluk"],["Timphan","dish/timphan"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/94/Meuseukat.JPG/500px-Meuseukat.JPG","w":500,"h":375,"by":"Si Gam","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Meuseukat.JPG"}},"dish/nasi-ayam":{"t":"dish","r":"dish/nasi-ayam","n":"Nasi Ayam","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Malay cuisine","dot":"#f0b340","intro":[["Hainanese chicken rice is a dish of poached or roasted chicken with seasoned rice, served with chilli sauce and usually with cucumbers, tomato slices or cilantro garnishes. It was created by immigrants from Hainan in southern China and adapted from the Hainanese dishes of Wenchang chicken and Wenchang chicken rice."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-nasi-ayam"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Nasi_Ayam"}],"sections":[{"h":"Where it's from","links":[["Malay cuisine","cuisine/malay-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Chicken","ingredient/chicken"],["Chili pepper","ingredient/chili-pepper"],["Rice","ingredient/rice"],["Soy sauce","ingredient/soy-sauce"]]},{"h":"More from Malay cuisine","links":[["Akok (food)","dish/akok-food"],["Ikan bakar","dish/ikan-bakar"],["Karas (food)","dish/karas-food"],["Ketupat","dish/ketupat"],["Lekor","dish/lekor"],["Mee siput","dish/mee-siput"],["Nasi kerabu","dish/nasi-kerabu"],["Nasi tumpang","dish/nasi-tumpang"],["Roti jala","dish/roti-jala"],["Sata (food)","dish/sata-food"],["Tahu goreng","dish/tahu-goreng"],["Ulam (salad)","dish/ulam-salad"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b1/Nasi_ayam_20250917_114013.jpg/500px-Nasi_ayam_20250917_114013.jpg","w":500,"h":375,"by":"Wiki Farazi","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Nasi_ayam_20250917_114013.jpg"}},"dish/pohulpohul":{"t":"dish","r":"dish/pohulpohul","n":"Pohulpohul","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Pohulpohul (itak pohulpohul) is a traditional Batak snack from Tapanuli, Indonesia."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pohulpohul"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pohulpohul"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Brown sugar","ingredient/brown-sugar"],["Co