g","w":500,"h":333,"by":"MaedaAkihiko","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Salmon-Ruibe.jpg"}},"ingredient/garnish-cooking":{"t":"ingredient","r":"ingredient/garnish-cooking","n":"Garnish (cooking)","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A garnish is an edible item or substance used as a decoration or embellishment for a prepared food dish or drink. Some garnishes are mainly for appearance, while others impart additional or contrasting flavors or textures, and may also serve cultural or symbolic functions. The notion of a garnish is distinct from that of a condiment, a prepared sauce added to another food item primarily for its flavor, but which does not serve a decorative function. A food item which is served with garnish may be described as being garni, French for \"garnished.\""]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-garnish-cooking"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Garnish_(cooking)"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Danish cuisine","cuisine/danish-cuisine",[["Smørrebrød","dish/sm-rrebr-d"]]]]},{"h":"Often cooked with","links":[["Butter","ingredient/butter"],["Cheese","ingredient/cheese"],["Cold cut","ingredient/cold-cut"],["Lunch meat","ingredient/lunch-meat"],["Rugbrød","ingredient/rugbr-d"],["Spread","ingredient/spread"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/4b/Gyro_sandwich.jpg/500px-Gyro_sandwich.jpg","w":500,"h":368,"by":"jeffreyw","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Gyro_sandwich.jpg"}},"dish/variety-jones-restaurant":{"t":"dish","r":"dish/variety-jones-restaurant","n":"Variety Jones (restaurant)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Fusion cuisine","dot":"#94bd5c","intro":[["Variety Jones is a restaurant