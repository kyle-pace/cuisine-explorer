ta/QCL","world":1207191,"top":[["United States of America","cuisine/american-cuisine",514554],["Iran","cuisine/iranian-cuisine",296273],["Turkey","cuisine/turkish-cuisine",242804],["China","cuisine/chinese-cuisine",78335],["Syria","cuisine/syrian-cuisine",57399],["Madagascar","cuisine/malagasy-cuisine",4952],["Tunisia","cuisine/tunisian-cuisine",3127],["Afghanistan","cuisine/afghan-cuisine",2810],["Ashmore and Cartier Is.","cuisine/australian-cuisine",2767],["Iraq","cuisine/iraqi-cuisine",1791],["Kyrgyzstan","cuisine/kyrgyz-cuisine",895],["Jordan","cuisine/jordanian-cuisine",572],["Uzbekistan","cuisine/uzbek-cuisine",428],["Pakistan","cuisine/pakistani-cuisine",332],["Mexico","cuisine/mexican-cuisine",73]]}},{"h":"Often cooked with","links":[["Sugar","ingredient/sugar"],["Almond","ingredient/almond"],["Rice","ingredient/rice"],["Akkawi cheese","ingredient/akkawi-cheese"],["Qishta","ingredient/qishta"],["Rose water","ingredient/rose-water"],["Semolina","ingredient/semolina"],["Anise","ingredient/anise"],["Caraway","ingredient/caraway"],["Caraway seed","ingredient/caraway-seed"],["Cinnamon","ingredient/cinnamon"],["Coconut","ingredient/coconut"],["Pine nut","ingredient/pine-nut"],["Pistachio nut","ingredient/pistachio-nut"],["Rice flour","ingredient/rice-flour"],["Walnut","ingredient/walnut"]]}]},"dish/kajitsu":{"t":"dish","r":"dish/kajitsu","n":"Kajitsu","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#a99fb5","intro":[["Kajitsu was a Japanese restaurant in New York City. It specialized in shojin ryori or Japanese Buddhist cuisine serving seasonal vegetarian set menus. Along with the main restaurant, the owners also operated a non-vegetarian handmade soba space called Kokage downstairs as well as Kaijitsu Cafe for lunch options and wagashi. The space also hosted the only New York location of Ippodo, a tea place specializing in matcha which did full tea ceremonies as well as gyokuro and sencha. The restaurant had received a Michelin star. Time Out New York rated the restaurant four out of five stars. The restaurant opened at 414 East 9th Street in the East Village in 2009 and moved to 125 East 39th Street in Murray Hill in 2013."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kajitsu"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kajitsu"}],"sections":[{"h":"Where it's from","links":[["Buddhist cuisine","cuisine/buddhist-cuisine"],["Chinese Buddhist cuisine","cuisine/chinese-buddhist-cuisine"]]},{"h":"More from Buddhist cuisine","links":[["Saikan","dish/saikan"]]}]},"ingredient/seabird":{"t":"ingredient","r":"ingredient/seabird","n":"Seabird","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Seabirds (also known as marine birds) are birds that are adapted to life within the marine environment. While seabirds vary greatly in lifestyle, behaviour and physiology, they often exhibit striking convergent evolution, as the same environmental problems and feeding niches have resulted in similar adaptations. The first seabirds evolved in the Cretaceous period, while modern seabird families emerged in the Paleogene."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-seabird"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Seabird"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Swedish cuisine","cuisine/swedish-cuisine",[["Kroppkaka","dish/kroppkaka"]]]]},{"h":"Often cooked with","links":[["Bacon","ingredient/bacon"],["Eel","ingredient/eel"],["Onion","ingredient/onion"],["Pork","ingredient/pork"],["Potato","ingredient/potato"]]}]},"dish/odette-restaurant":{"t":"dish","r":"dish/odette-restaurant","n":"Odette (restaurant)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Odette is a Singaporean restaurant. Founded in 2015 by chef Julien Royer in collaboration with the local Lo & Behold Group, Odette features a fusion of French cuisin