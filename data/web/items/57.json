Hoisin sauce","ingredient/hoisin-sauce"],["Honey","ingredient/honey"],["Maltose","ingredient/maltose"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/db/Fermentedchilibeancurd.jpg/500px-Fermentedchilibeancurd.jpg","w":500,"h":272,"by":"Hmm...","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Fermentedchilibeancurd.jpg"}},"ingredient/european-conger":{"t":"ingredient","r":"ingredient/european-conger","n":"European conger","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["The European conger (Conger conger) is a species of conger of the family Congridae. It is the heaviest eel in the world and native to the northeast Atlantic, including the Mediterranean Sea."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-european-conger"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/European_conger"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["French cuisine","cuisine/french-cuisine",[["Bouillabaisse","dish/bouillabaisse"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Bouillabaisse","dish/bouillabaisse"]]]]},{"h":"Often cooked with","links":[["Crouton","ingredient/crouton"],["Fish","ingredient/fish"],["Olive oil","ingredient/olive-oil"],["Rouille","ingredient/rouille"],["Scorpionfish","ingredient/scorpionfish"],["Sea robin","ingredient/sea-robin"],["Tomato","ingredient/tomato"],["White wine","ingredient/white-wine"],["Wine","ingredient/wine"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e5/European_conger.jpg/500px-European_conger.jpg","w":500,"h":375,"by":"West Brom 4ever","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:European_conger.jpg"}},"ingredient/paraguay-cheese":{"t":"ingredient","r":"ingredient/paraguay-cheese","n":"Paraguay cheese","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Paraguay cheese is a cows' milk cheese from Paraguay. It gives the Paraguayan cuisine a high value in calories and proteins, especially in the salted dishes recipes, very characteristic of the country and an important part of its culture."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-paraguay-cheese"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Paraguay_cheese"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Paraguayan cuisine","cuisine/paraguayan-cuisine",[["Sopa paraguaya","dish/sopa-paraguaya"]]]]},{"h":"Often cooked with","links":[["Cheese","ingredient/cheese"],["Cornmeal","ingredient/cornmeal"],["Egg","ingredient/egg"],["Maize flour","ingredient/maize-flour"],["Milk","ingredient/milk"],["Onion","ingredient/onion"]]}],"img":{"src":"/labs/cuisines/img/5/55/Queso_Paraguay_%28Kes%C3%BA_Paraguai%29.jpg","w":500,"h":468,"by":"Correadeb","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Queso_Paraguay_(Kes%C3%BA_Paraguai).jpg"}},"dish/spas-soup":{"t":"dish","r":"dish/spas-soup","n":"Spas (soup)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Armenian cuisine","dot":"#f0b340","intro":[["Spas is a matzoon-based soup. It is a traditional dish in Armenia. Besides matzoon (a fermented milk product), the main ingredient are herbs, and hulled wheat berries (i.e. with husks removed)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-spas-soup"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Spas_(soup)"}],"sections":[{"h":"Where it's from","links":[["Armenian cuisine","cuisine/armenian-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Coriander","ingredient/coriander"],["Egg","ingredient/egg"],["Egg yolk","ingredient/egg-yolk"],["Matzoon","ingredient/matzoon"],["Parsley","ingredient/parsley"],["Triticum","ingredient/triticum"],["Wheat berry","ingredient/wheat-berry"]]},{"h":"Cook it","rows":[{"name":"The Armenian Kitchen","ref":"site/thearmeniankitchen-com","color":"#55b8ad","shape":"site","sub":"thearmeniankitchen.com","note":"Armenian-American blog of family recipes and reviews of Armenian cookbooks.","url":"https://www.thearmeniankitchen.com/classic-armenian-recipes-another/","suggested":true,"kind":"blog"}]},{"h":"More from Armenian cuisine","links":[["Alani (dried fruit)","dish/alani-dried-fruit"],["Baba ghanoush","dish/baba-ghanoush"],["Bagharj","dish/bagharj"],["Cabbage roll","dish/cabbage-roll"],["İmam bayıldı","dish/imam-bay-ld"],["Khash (dish)","dish/khash-dish"],["Khorovats","dish/khorovats"],["Lavash","dish/lavash"],["Matnakash","dish/matnakash"],["Mikado cake","dish/mikado-cake"],["Pilaf","dish/pilaf"],["Pirozhki","dish/pirozhki"],["Tjvjik (food)","dish/tjvjik-food"]]}],"img":{"src":"/labs/cuisines/img/thumb/c/c6/%D0%A1%D0%BF%D0%B0%D0%B9%D1%81.jpeg/500px-%D0%A1%D0%BF%D0%B0%D0%B9%D1%81.jpeg","w":500,"h":667,"by":"KarenWunderkind","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%D0%A1%D0%BF%D0%B0%D0%B9%D1%81.jpeg"}},"dish/yueguangbing":{"t":"dish","r":"dish/yueguangbing","n":"Yueguangbing","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Hakka cuisine","dot":"#f0b340","intro":[["Yueguangbing, also called moonlight cake, Hakka mooncake, and sometimes referred as Hakka mooncake biscuits or Hakka Moonlight cake in English, is a form of traditional mooncake of Hakka origins. It is a white, flat and disc-like biscuit which typically features carvings and paintings of flowers and animals on its top surface as adornments. It was traditionally used as offerings to the moon on the Mid-Autumn Festival. It is also consumed by the Hakka diaspora and/or people of Chinese and/or Hakka heritage in countries outside of China, such as countries in the regions of Southeast Asia and Africa (Mauritius)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-yueguangbing"},{"kind":"wiki","url":"ht