humb/2/27/Petroselinum_segetum_1.jpg/500px-Petroselinum_segetum_1.jpg","w":500,"h":642,"by":"I, Aroche","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Petroselinum_segetum_1.jpg"}},"ingredient/tempeh":{"t":"ingredient","r":"ingredient/tempeh","n":"Tempeh","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 6 dishes across 2 cuisines","intro":[["Tempeh or tempe is a traditional Indonesian food made from fermented soybeans. It is made by a natural culturing and controlled fermentation process that binds soybeans into a cake form. A fungus, Rhizopus oligosporus or Rhizopus oryzae, is used in the fermentation process and is also known as tempeh starter."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tempeh"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tempeh"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Gado-gado","dish/gado-gado"],["Gudeg","dish/gudeg"],["Mendoan","dish/mendoan"],["Rojak","dish/rojak"],["Tumpeng","dish/tumpeng"]]],["Javanese cuisine","cuisine/javanese-cuisine",[["Nasi ambeng","dish/nasi-ambeng"]]]]},{"h":"Often cooked with","links":[["Tofu","ingredient/tofu"],["Egg","ingredient/egg"],["Palm sugar","ingredient/palm-sugar"],["Peanut sauce","ingredient/peanut-sauce"],["Rice","ingredient/rice"],["Sugar","ingredient/sugar"],["Cucumber","ingredient/cucumber"],["Ghost pepper","ingredient/ghost-pepper"],["Ipomoea aquatica","ingredient/ipomoea-aquatica"],["Krupuk","ingredient/krupuk"],["Lontong","ingredient/lontong"],["Rice cake","ingredient/rice-cake"],["Seedling","ingredient/seedling"],["Tamarind","ingredient/tamarind"],["Bay leaf","ingredient/bay-leaf"],["Candlenut","ingredient/candlenut"]]}],"img":{"src":"/world-cuisine/img/thumb/e/e1/Tempeh_%288681605421%29.jpg/500px-Tempeh_%288681605421%29.jpg","w":500,"h":333,"by":"Veganbaking.net from USA","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Tempeh_(8681605421).jpg"}},"dish/manue":{"t":"dish","r":"dish/manue","n":"Manuê","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Brazilian cuisine","dot":"#94bd5c","intro":[["Manuê or manauê refers to several Brazilian cake varieties that have traditionally been made with corn and sugar cane molasses. The corn that is used can either be grinded fresh sweet corn, fubá de moinho (corn fubá), or grinded rehydrated dried corn kernels. Aside from these two primary ingredients, coconut milk, shredded coconut, butter and other cooking fats, cassava, sugar, and wheat flour are sometimes added for special occasions."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-manue"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Manu%C3%AA"}],"sections":[{"h":"Where it's from","links":[["Brazilian cuisine","cuisine/brazilian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Corn","ingredient/corn"],["Sugar cane molasses","ingredient/sugar-cane-molasses"]]},{"h":"Cook it","rows":[{"name":"Olivia's Cuisine","color":"#55b8ad","shape":"site","sub":"oliviascuisine.com","note":"Brazilian-born Olivia Mesquita's blog, with a large section of Brazilian classics.","url":"https://oliviascuisine.com/","suggested":true,"kind":"blog"},{"name":"Easy and Delish","color":"#55b8ad","shape":"site","sub":"easyanddelish.com","note":"Brazilian recipe collection from a Brazilian-born home cook based in the US.","url":"https://www.easyanddelish.com/easy-brazilian-recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Brazilian cuisine","links":[["Arabu","dish/arabu"],["Arroz carreteiro","dish/arroz-carreteiro"],["Bauru (sandwich)","dish/bauru-sandwich"],["Beijinho","dish/beijinho"],["Beirute","dish/beirute"],["Bobó de camarão","dish/bobo-de-camarao"],["Bockwurst","dish/bockwurst"],["Bolo de fubá","dish/bolo-de-fuba"],["Brigadeiro","dish/brigadeiro"],["Canja de galinha","dish/canja-de-galinha"],["Coxinha","dish/coxinha"],["Feijoada","dish/feijoada"],["Maniçoba","dish/manicoba"],["Marmelada de Santa Luzia","dish/marmelada-de-santa-luzia"],["Pão na chapa","dish/pao-na-chapa"],["Pie","dish/pie"],["Sobá","dish/soba"],["Xis (sandwich)","dish/xis-sandwich"]]}]},"ingredient/mala-seasoning":{"t":"ingredient","r":"ingredient/mala-seasoning","n":"Mala (seasoning)","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Mala is a numbing and pungent seasoning derived from Sichuan peppercorn and chili. Most commonly, mala is made into a sauce by simmering it in oil and other spices.  Characteristic of Sichuan cuisine, particularly Chongqing cuisine, it has become one of the most popular and synthesized ingredients in Chinese cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-mala-seasoning"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mala_(seasoning)"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Chinese cuisine","cuisine/chinese-cuisine",[["Mao xue wang","dish/mao-xue-wang"]]]]},{"h":"Often cooked with","links":[["Blood curd","ingredient/blood-curd"],["Chili oil","ingredient/chili-oil"]]}],"img":{"src":"/world-cuisine/img/thumb/f/f2/JiaoMaJi.png/500px-JiaoMaJi.png","w":500,"h":473,"by":"Bigvocab","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:JiaoMaJi.png"}},"dish/nasi-campur":{"t":"dish","r":"dish/nasi-campur","n":"Nasi campur","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Nasi campur, also known as nasi rames (Javanese: ꦤꦱꦶꦫꦩꦼꦱ꧀, romanized: nasi raměs, lit. 'mixed rice') or sega campur (Javanese: ꦱꦼꦒ​ꦕꦩ꧀ꦥꦸꦂ, romanized: sěgå campur; [səˌgɔ ˈtʃampʊr]) in Java, refers to an Indonesian and Malay dish of a scoop of nasi putih (white rice) accompanied by small portions of several other dishes, including meats, vegetables, peanuts, eggs, and fried-shrimp krupuk."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-nasi-campur"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Nasi_campur"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Egg","ingredient/egg"],["Rice","ingredient/rice"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true,"kind":"blog"}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/ga