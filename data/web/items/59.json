b":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A plum is a fruit of some species in Prunus subg. Prunus. Dried plums are usually called prunes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-plum"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Plum"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Georgian cuisine","cuisine/georgian-cuisine",[["Chakapuli","dish/chakapuli"]]]]},{"h":"Where it's grown","grown":{"what":"Plums and sloes","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":12637958,"top":[["China","cuisine/chinese-cuisine",6891278],["Romania","cuisine/romani-cuisine",695688],["Chile","cuisine/chilean-cuisine",455110],["Serbia","cuisine/serbian-cuisine",446772],["Turkey","cuisine/turkish-cuisine",348294],["Iran","cuisine/iranian-cuisine",345716],["United States of America","cuisine/american-cuisine",282096],["Bosnia and Herz.","cuisine/bosnian-cuisine",237694],["Russia","cuisine/russian-cuisine",191415],["Morocco","cuisine/moroccan-cuisine",183309],["Argentina","cuisine/argentine-cuisine",173438],["Ukraine","cuisine/ukrainian-cuisine",172490],["Uzbekistan","cuisine/uzbek-cuisine",165816],["Italy","cuisine/italian-cuisine",162508],["France","cuisine/french-cuisine",162052]]}},{"h":"Often cooked with","links":[["Anethum","ingredient/anethum"],["Coriander","ingredient/coriander"],["Garlic","ingredient/garlic"],["Lamb","ingredient/lamb"],["Mentha","ingredient/mentha"],["Onion","ingredient/onion"],["Petroselinum","ingredient/petroselinum"],["Prunus cerasifera","ingredient/prunus-cerasifera"],["Prunus vachuschtii","ingredient/prunus-vachuschtii"],["Scallion","ingredient/scallion"],["Tarragon","ingredient/tarragon"],["Tkemali","ingredient/tkemali"],["Veal","ingredient/veal"],["White wine","ingredient/white-wine"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/ec/Plums_African_Rose_-_whole%2C_halved_and_slice.jpg/500px-Plums_African_Rose_-_whole%2C_halved_and_slice.jpg","w":500,"h":333,"by":"Ivar Leidus","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Plums_African_Rose_-_whole%2C_halved_and_slice.jpg"}},"dish/kibbeh-safarjaliyeh":{"t":"dish","r":"dish/kibbeh-safarjaliyeh","n":"Kibbeh safarjaliyeh","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#f0b340","intro":[["Kibbeh safarjaliyeh or kibbeh bi'safarjaliyeh (sometimes kubbah) is a dish of Syrian cuisine that consists of lamb or beef chunks as well as kibbeh in safarjaliyeh, a broth consisting of quince, pomegranate juice, pomegranate molasses, and beef broth. Kibbeh safarjaliyeh is a variation of the common Levantine dish, kibbeh, which it includes as an essential ingredient."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kibbeh-safarjaliyeh"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kibbeh_safarjaliyeh"}],"sections":[{"h":"Where it's from","links":[["Arab cuisine","cuisine/arab-cuisine"],["Levantine cuisine","cuisine/levantine-cuisine"],["Syrian cuisine","cuisine/syrian-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Beef","ingredient/beef"],["Broth","ingredient/broth"],["Kibbeh","ingredient/kibbeh"],["Pomegranate","ingredient/pomegranate"]]},{"h":"More from Arab cuisine","links":[["Baba ghanoush","dish/baba-ghanoush"],["Habib's","dish/habib-s"],["Ma'amoul","dish/ma-amoul"],["Meghli","dish/meghli"],["Shakshouka","dish/shakshouka"],["Shawarma","dish/shawarma"],["Torshi","dish/torshi"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/4d/Kibbeh_Safarjaliyeh.jpg/500px-Kibbeh_Safarjaliyeh.jpg","w":500,"h":500,"by":"Bee Eater007","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Kibbeh_Safarjaliyeh.jpg"}},"dish/masala-y-maiz":{"t":"dish","r":"dish/masala-y-maiz","n":"Masala y Maíz","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Masala y Maíz is a fusion restaurant in Mexico City known for blending Mexican, African and Indian cuisines. Founded by chefs Norma Listman and Saqib Keval, the restaurant defines its approach as mestizaje rebelde (\"rebellious mestizaje\"), a concept that, according to its founders, acknowledges the complex legacies of colonization by naming systems of oppression while also celebrating the diverse cultures that have shaped their culinary influences."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-masala-y-maiz"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Masala_y_Ma%C3%ADz"}],"sections":[{"h":"Where it's from","links":[["Indian cuisine","cuisine/indian-cuisine"],["Mexican cuisine","cuisine/mexican-cuisine"]]},{"h":"Cook it","rows":[{"name":"Swasthi's Recipes","ref":"site/indianhealthyrecipes-com","color":"#55b8ad","shape":"site","sub":"indianhealthyrecipes.com","note":"Swasthi Shreekanth's long-running blog of everyday Indian home cooking from across the regions.","url":"https://www.indianhealthyrecipes.com/about/","suggested":true,"kind":"blog"},{"name":"Hari Ghotra","ref":"site/harighotra-co-uk","color":"#55b8ad","shape":"site","sub":"harighotra.co.uk","note":"UK-based cook Hari Ghotra's recipe library and videos of home-style Indian dishes.","url":"https://www.harighotra.co.uk/indian-recipes","suggested":true,"kind":"site"},{"name":"Mexico in My Kitchen","ref":"site/mexicoinmykitchen-com","color":"#55b8ad","shape":"site","sub":"mexicoinmykitchen.com","note":"Mely Martínez's long-running blog of Mexican home-style recipes.","url":"https://www.mexicoinmykitchen.com/","suggested":true,"kind":"blog"},{"name":"Pati Jinich","ref":"site/patijinich-com","color":"#55b8ad","shape":"site","sub":"patijinich.com","note":"Recipe archive from the Mexican-born chef and host of the PBS series Pati's Mexican Table.","url":"https://patijinich.com/recipes/","suggested":true,"kind":"site"}]},{"h":"More from Indian cuisine","links":[["Akuri","dish/akuri"],["Aloo paratha","dish/aloo-paratha"],["Amba (condiment)","dish/amba-condiment"],["Annapurna Cafe","dish/annapurna-cafe"],["Baingan bharta","dish/baingan-bharta"],["Bombay potato","dish/bombay-potato"],["Butter chicken","dish/butter-chicken"],["Chaat masala","dish/chaat-masala"],["Chai Pani","dish/chai-pani"],["Chicken Chettinad","dish/chicken-chettinad"],["Chutney Mary","dish/chutney-mary"],["Dahi vada","dish/dahi-vada"],["Dal dhokli","dish/dal-dhokli"],["Dal makhani","dish/dal-makhani"],["Dhamaka (restaurant)","dish/dhamaka-restaurant"],["East India Co. Grill and Bar","dish/east-india-co-grill-and-bar"],["Fafda","dish/fafda"],["Falooda","dish/falooda"],["Fish and chips","dish/fish-and-chips"],["Gaggan","dish/gaggan"],["Handvo","dish/handvo"],["Hindoostane Coffee House","dish/hindoostane-coffee-house"],["Hyderabadi haleem","dish/hyderabadi-haleem"],["Idli","dish/idli"],["Indian restaurant","dish/indian-restaurant"],["Kachumber","dish/kachumber"],["Kidyo","dish/kidyo"],["Kulfi","dish/kulfi"],["Lasan","dish/lasan"],["Maruti Indian Restaurant","dish/maruti-indian-restaurant"],["Masala chai","dish/masala-chai"],["Mirchi bada","dish/mirchi-bada"],["Mokthuk","dish/mokthuk"],["Naan","dish/naan"],["Osmania biscuit","dish/osmania-biscuit"],["Panipuri","dish/panipuri"],["Pathia","dish/pathia"],["Rabri","dish/rabri"],["Semma (restaurant)","dish/semma-restaurant"],["Shemai","dish/shemai"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b8/Masala_y_Maiz_%282025%29_2.jpg/500px-Masala_y_Maiz_%282025%29_2.jpg","w":500,"h":359,"by":"Tbhotch","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Masala_y_Maiz_(2025)_2.jpg"}},"ingredient/ice-cream":{"t":"ingredient","r":"ingredient/ice-cream","n":"Ice cream","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 3 cuisines","intro":[["Ice cream is a frozen dessert typically made from milk or cream that has been flavoured with a sweetener, either sugar or an alternative, and a spice, such as cocoa or vanilla, or with fruit, such as strawberries or peaches. Food colouring is sometimes added in addition to stabilizers. The mixture is cooled below the freezing point of water and stirred to incorporate air spaces and prevent detectable ice crystals from forming. It can also be made by whisking a flavoured cream base and liquid nitrogen together. The result is a smooth, semi-solid foam that is solid at very low temperatures (below 2 °C or 35 °F). It becomes more malleable as its temperature increases."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-ice-cream"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ice_cream"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["French cuisine","cuisine/french-cuisine",[["Peach Melba","dish/peach-melba"],["Profiterole","dish/profiterole"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Peach Melba","dish/peach-melba"],["Profiterole","dish/profiterole"]]],["Italian cuisine","cuisine/italian-cuisine",[["Stracciatella (ice cream)","dish/stracciatella-ice-cream"]]]]},{"h":"Often cooked with","links":[["Vanilla ice cream","ingredient/vanilla-ice-cream"],["Peach","ingredient/peach"],["Raspberry","ingredient/raspberry"],["Vanilla","ingredient/vanilla"],["Chouquette","ingredient/chouquette"],["Choux pastry","ingredient/choux-pastry"],["Custard","ingredient/custard"],["Ganache","ingredient/ganache"],["Whipped cream","ingredient/whipped-cream"],["Chocolate","ingredient/chocolate"],["Cream","ingredient/cream"],["Egg yolk","ingredient/egg-yolk"],["Gelatin","ingredient/gelatin"],["Milk","ingredient/milk"],["Milk chocolate","ingredient/milk-chocolate"],["Smetana","ingredient/smetana"]]}],"img":{"src":"/labs/cuisines/img/f/f3/Vanilla_Ice_Cream_Cone_at_Camp_Manitoulin.jpg","w":500,"h":749,"by":"Steven Depolo","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Vanilla_Ice_Cream_Cone_at_Camp_Manitoulin.jpg"}},"ingredient/tandoori-masala":{"t":"ingredient","r":"ingredient/tandoori-masala","n":"Tandoori masala","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Tandoori masala or tandoori sauce is a mixture of spices specifically for use with a tandoor, or clay oven, in traditional cooking in the Indian subcontinent. The specific spices vary somewhat from one region to another but typically include garam masala, garlic, ginger, onion, cayenne pepper, and sometimes other spices and additives. The spices are often ground together with a pestle and mortar."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tandoori-masala"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tandoori_masala"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indian cuisine","cuisine/indian-cuisine",[["Tandoori chicken","dish/tandoori-chicken"]]]]},{"h":"Often cooked with","links":[["Chicken","ingredient/chicken"],["Dahi (curd)","ingredient/dahi-curd"],["Honey","ingredient/honey"],["Yogurt","ingredient/yogurt"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/d7/Tandoori_masala.jpg/500px-Tandoori_masala.jpg","w":500,"h":400,"by":"Kamava1971","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Tandoori_masala.jpg"}},"dish/the-river-cafe-london":{"t":"dish","r":"dish/the-river-cafe-london","n":"The River Cafe (London)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["The River Café is a restaurant in the Borough of Hammersmith and Fulham, London, specialising in Italian cuisine. It was owned and run by chefs Ruth Rogers and Rose Gray until Gray's death in 2010; since then, Rogers has been the sole owner and has run the restaurant. It earned a Michelin star in 1997."]],"src":"wikipedia","actions":[{"kin