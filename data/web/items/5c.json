/File:3_types_of_lentil.png"}},"dish/hollandaise-sauce":{"t":"dish","r":"dish/hollandaise-sauce","n":"Hollandaise sauce","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Hollandaise sauce is a French recipe,  a mixture of egg yolk, melted butter, and lemon juice (or a white wine or vinegar reduction). It is usually seasoned with salt, and either white pepper or cayenne pepper."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-hollandaise-sauce"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hollandaise_sauce"}],"sections":[{"h":"Where it's from","links":[["French cuisine","cuisine/french-cuisine"],["New Caledonian cuisine","cuisine/new-caledonian-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Butter","ingredient/butter"],["Egg","ingredient/egg"],["Egg yolk","ingredient/egg-yolk"],["Lemon juice","ingredient/lemon-juice"]]},{"h":"Cook it","rows":[{"name":"Pardon Your French","ref":"site/pardonyourfrench-com","color":"#55b8ad","shape":"site","sub":"pardonyourfrench.com","note":"Audrey Le Goff, a French cook, shares classic and regional French home recipes.","url":"https://pardonyourfrench.com","suggested":true,"kind":"blog"},{"name":"La Cuisine de Géraldine","ref":"site/lacuisinedegeraldine-fr","color":"#55b8ad","shape":"site","sub":"lacuisinedegeraldine.fr","note":"French home cooking blog by Géraldine Leverd, also author of The New French Kitchen.","url":"https://lacuisinedegeraldine.fr/en/about-us","suggested":true,"kind":"blog"},{"name":"New Caledonia Tourism: Kanak cooking","ref":"site/newcaledonia-travel","color":"#55b8ad","shape":"site","sub":"newcaledonia.travel","note":"Official tourism board overview of Kanak food, including bougna cooked in an earth oven.","url":"https://www.newcaledonia.travel/nz/gastronomy-wine/gastronomy/kanak-cooking","suggested":true,"kind":"site"}]},{"h":"More from French cuisine","links":[["Adventureland Bazaar","dish/adventureland-bazaar"],["Albufera sauce",