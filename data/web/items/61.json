{"cuisine/ethiopian-jewish-cuisine":{"t":"cuisine","r":"cuisine/ethiopian-jewish-cuisine","n":"Ethiopian Jewish cuisine","c":"#e46a3f","crumb":[["Africa","cuisines#africa"],["Ethiopian cuisine","cuisine/ethiopian-cuisine"],["Jewish cuisine","cuisine/jewish-cuisine"]],"sub":"Regional cuisine in Ethiopia","intro":[["Ethiopian Jewish cuisine is the cuisine of the Beta Israel (Ethiopian Jews). The cuisine of the Ethiopian Jews is similar to the cuisine of other Ethiopians, with some variations."],["Because treyf foods such as pork and shellfish are not traditionally eaten by either Ethiopian Christians or Ethiopian Muslims, keeping kosher in Ethiopia is a largely invisible practice. However, there are some noticeable distinctions. Ethiopian Jews refrain from eating popular national dishes made from raw meat, such as kitfo and gored gored. Jewish merchants in Addis Ababa five centuries ago deeply influenced Ethiopian cuisine by introducing curry powder and other aspects of Indian cooking."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ethiopian-jewish-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ethiopian_Jewish_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Ethiopian cuisine","cuisine/ethiopian-cuisine"],["Jewish cuisine","cuisine/jewish-cuisine"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"Gursha: Timeless Recipes for Modern Kitchens, from Ethiopia, Israel, Harlem, and Beyond","ref":"cookbook/gursha-timeless-recipes-for-modern-kitchens-from-ethiopia-israel-harlem-and-beyond","color":"#f0b340","shape":"book","sub":"Beejhy Barhany with Elisa Ung, 2025","note":"Beta Israel family cooking from a Harlem based Ethiopian Israeli chef, following the community from Ethiopia to Israel and New York.","url":"https://openlibrary.org/isbn/9780593536674","suggested":true,"isbn":"9780593536674"}]},{"h":"Part of","links":[["Ethiopian cuisine","cuisine/ethiopian-cuisine"],["Jewish cuisine","cuisine/jewish-cuisine"]]}],"cont":"African cuisine"},"dish/alani-dried-fruit":{"t":"dish","r":"dish/alani-dried-fruit","n":"Alani (dried fruit)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Armenian cuisine","dot":"#f0b340","intro":[["Alani is a traditional Armenian sweet made from dried, pitted peaches filled with a mixture of ground walnuts, sugar, and spices such as cinnamon and cardamom. It is mainly found in the eastern regions of Armenia, particularly in the Gegharkunik Province."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-alani-dried-fruit"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Alani_(dried_fruit)"}],"sections":[{"h":"Where it's from","links":[["Armenian cuisine","cuisine/armenian-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Cardamom","ingredient/cardamom"],["Cinnamon","ingredient/cinnamon"],["Peach","ingredient/peach"],["Sugar","ingredient/sugar"],["Walnut","ingredient/walnut"]]},{"h":"Cook it","rows":[{"name":"The Armenian Kitchen","ref":"site/thearmeniankitchen-com","color":"#55b8ad","shape":"site","sub":"thearmeniankitchen.com","note":"Armenian-American blog of family recipes and reviews of Armenian cookbooks.","url":"https://www.thearmeniankitchen.com/classic-armenian-recipes-another/","suggested":true,"kind":"blog"}]},{"h":"More from Armenian cuisine","links":[["Baba ghanoush","dish/baba-ghanoush"],["Bagharj","dish/bagharj"],["Cabbage roll","dish/cabbage-roll"],["İmam bayıldı","dish/imam-bay-ld"],["Khash (dish)","dish/khash-dish"],["Khorovats","dish/khorovats"],["Lavash","dish/lavash"],["Matnakash","dish/matnakash"],["Mikado cake","dish/mikado-cake"],["Pilaf","dish/pilaf"],["Pirozhki","dish/pirozhki"],["Spas (soup)","dish/spas-soup"],["Tjvjik (food)","dish/tjvjik-food"]]}],"img":{"src":"/labs/cuisines/img/thumb/6/6e/Yerevan_Market_%285211865578%29.jpg/500px-Yerevan_Market_%285211865578%29.jpg","w":500,"h":385,"by":"Shaun Dunphy from Lindfield, United Kingdom","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Yerevan_Market_(5211865578).jpg"}},"ingredient/bologna-sausage":{"t":"ingredient","r":"ingredient/bologna-sausage","n":"Bologna sausage","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Bologna sausage, informally Baloney (, bə-LOH-nee), is an American cooked sausage. It derives from Italian mortadella Bologna PGI, a variety of mortadella, a large salume. Its seasonings include black pepper, nutmeg, allspice, celery seed, coriander, and myrtle berries."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-bologna-sausage"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bologna_sausage"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Southern American cuisine","cuisine/cuisine-of-the-southern-united-states",[["Barbecue bologna","dish/barbecue-bologna"]]]]}],"img":{"src":"/labs/cuisines/img/thumb/c/c3/Bologna_lunch_meat_style_sausage.JPG/500px-Bologna_lunch_meat_style_sausage.JPG","w":500,"h":448,"by":"Glane23","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Bologna_lunch_meat_style_sausage.JPG"}},"ingredient/sour-cream":{"t":"ingredient","r":"ingredient/sour-cream","n":"Sour cream","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 8 dishes across 9 cuisines","intro":[["Sour cream (sometimes known as soured cream in British English) is a dairy product obtained by fermenting regular cream with certain kinds of lactic acid bacteria. The bacterial culture, which is introduced either deliberately or naturally, sours and thickens the cream. Its name comes from the production of lactic acid by bacterial fermentation, which is called souring."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sour-cream"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sour_cream"}],"sections":[{"h":"Where it's cooked with","c