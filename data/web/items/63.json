n-starter"],["Milk","ingredient/milk"],["Tabliya","ingredient/tabliya"],["Chili powder","ingredient/chili-powder"],["Gochu-garu","ingredient/gochu-garu"],["Malt","ingredient/malt"],["Meju","ingredient/meju"],["Edible flower","ingredient/edible-flower"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/aa/Chapssal_%28glutinous_rice%29.jpg/500px-Chapssal_%28glutinous_rice%29.jpg","w":500,"h":334,"by":"국립국어원","lic":"CC BY-SA 2.0 kr","licUrl":"https://creativecommons.org/licenses/by-sa/2.0/kr/deed.en","page":"https://commons.wikimedia.org/wiki/File:Chapssal_(glutinous_rice).jpg"}},"ingredient/fermentation-starter":{"t":"ingredient","r":"ingredient/fermentation-starter","n":"Fermentation starter","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 4 dishes across 2 cuisines","intro":[["A fermentation starter (called simply starter within the corresponding context, sometimes called a mother) is a preparation to assist the beginning of the fermentation process in preparation of various foods and alcoholic drinks.  Food groups where they are used include breads, especially sourdough bread, and cheese.  A starter culture is a microbiological culture which actually performs fermentation. These starters usually consist of a cultivation medium, such as grains, seeds, or nutrient liquids that have been well colonized by the microorganisms used for the fermentation."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-fermentation-starter"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fermentation_starter"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Bika ambon","dish/bika-ambon"],["Brem","dish/brem"],["Kue pukis","dish/kue-pukis"]]],["Italian cuisine","cuisine/italian-cuisine",[["Ciabatta","dish/ciabatta"]]]]},{"h":"Often cooked with","links":[["Wheat flour","ingredient/wheat-flour"],["Coconut","ingredient/coconut"],["Coconut milk","ingredient/coconut-milk"],["Egg","ing