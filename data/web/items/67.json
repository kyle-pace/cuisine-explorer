uisine","cuisine/chinese-american-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Almond","ingredient/almond"],["Chicken","ingredient/chicken"]]},{"h":"Cook it","rows":[{"name":"I Heart Umami: Chinese American","ref":"site/iheartumami-com","color":"#55b8ad","shape":"site","sub":"iheartumami.com","note":"Chinese American takeout-style recipes on an Asian home cooking blog.","url":"https://iheartumami.com/category/cuisines/chinese-american","suggested":true},{"name":"I Heart Umami: Chinese American","ref":"site/iheartumami-com","color":"#55b8ad","shape":"site","sub":"iheartumami.com","note":"Chinese American takeout-style recipes on an Asian home cooking blog.","url":"https://iheartumami.com/category/cuisines/chinese-american","suggested":true}]},{"h":"More from American Chinese cuisine","links":[["Beef and broccoli","dish/beef-and-broccoli"],["Chicken and broccoli","dish/chicken-and-broccoli"]]}]},"dish/baingan-bharta":{"t":"dish","r":"dish/baingan-bharta","n":"Baingan bharta","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indian cuisine","dot":"#f0b340","intro":[["Baigan bharta, also spelled baingan bharta or begun bharta or baigan chokha (mashed eggplant) is an Indian dish prepared by mashing or mincing grilled brinjal (aubergine in UK English, eggplant in US English, baigan in Hindi) with tomato, onion, herbs and spices, with variations being common from chef to chef. Traditionally, cooking the eggplant over charcoal, inside of a tandoor, barbecue grill or oven, or even directly applying flame to the outside of the fruit infuses the dish with a smoky flavour; the blackened skin is then easily peeled and the eggplant may be further prepared."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-baingan-bharta"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Baingan_bharta"}],"sections":[{"h":"Where it's from","links":[["Indian cuisine","cuisine/indian-cuisine"]]},{"h":"Ingredients","count":9,"links":[["Brinjal","ingredient/brinjal"],["