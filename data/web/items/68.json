":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Gulai_ayam.JPG"}},"dish/lohikeitto":{"t":"dish","r":"dish/lohikeitto","n":"Lohikeitto","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Finnish cuisine","dot":"#cf5f87","intro":[["Salmon chowder is a common dish in Finland and other Nordic countries. It consists of salmon fillets, boiled potatoes, carrots and leeks. The dish is served hot, and typically seasoned with fresh dill, allspice, salt and black pepper. The soup is made with cream or whole milk, making it a chowder with a creamy flavour and texture."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-lohikeitto"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lohikeitto"}],"sections":[{"h":"Where it's from","links":[["Finnish cuisine","cuisine/finnish-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Leek","ingredient/leek"],["Milk","ingredient/milk"],["Potato","ingredient/potato"],["Salmon","ingredient/salmon"],["Salmon as food","ingredient/salmon-as-food"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"More from Finnish cuisine","links":[["Blodpalt","dish/blodpalt"],["Cabbage roll","dish/cabbage-roll"],["Egg butter","dish/egg-butter"],["Glögg","dish/glogg"],["Joulutorttu","dish/joulutorttu"],["Kalakukko","dish/kalakukko"],["Karelian hot pot","dish/karelian-hot-pot"],["Kesäkeitto","dish/kesakeitto"],["Kringle","dish/kringle"],["Kuivaliha","dish/kuivaliha"],["Lanttulaatikko","dish/lanttulaatikko"],["Lörtsy","dish/lortsy"],["Semla","dish/semla"],["Smörgåstårta","dish/smorgastarta"],["Strong beer","dish/strong-beer"],["The Hoito","dish/the-hoito"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b7/Lohikeitto.jpg/500px-Lohikeitto.jpg","w":500,"h":375,"by":"Tuijasal","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Lohikeitto.jpg"}},"dish/maggiano-s-little-italy":{"t":"dish","r":"dish/maggiano-s-little-italy","n":"Maggiano's Little Italy","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian-American cuisine","dot":"#94bd5c","intro":[["Maggiano's Little Italy is an American casual dining restaurant chain specializing in Italian-American cuisine. The company was founded in Chicago's River North neighborhood, at Clark Street and Grand Avenue, in 1991 by Rich Melman's Lettuce Entertain You Enterprises (LEYE). The concept was acquired by Brinker International, Inc. in August 1995 from LEYE. As of March 22, 2021, there were 54 locations throughout 22 states and the District of Columbia."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-maggiano-s-little-italy"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Maggiano's_Little_Italy"}],"sections":[{"h":"Where it's from","links":[["Italian-American cuisine","cuisine/italian-american-cuisine"]]},{"h":"More from Italian-American cuisine","links":[["Buona","dish/buona"],["Chicken Francese","dish/chicken-francese"],["Dan Tana's","dish/dan-tana-s"],["Fettuccine Alfredo","dish/fettuccine-alfredo"],["Garlic bread","dish/garlic-bread"],["Italian beef","dish/italian-beef"],["Italian tomato pie","dish/italian-tomato-pie"],["Rollatini","dish/rollatini"],["Spaghetti and meatballs","dish/spaghetti-and-meatballs"],["Stromboli (food)","dish/stromboli-food"],["Tetrazzini","dish/tetrazzini"],["Vodka sauce","dish/vodka-sauce"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/d7/Maggiano%27s_in_Friendship_Heights.jpg/500px-Maggiano%27s_in_Friendship_Heights.jpg","w":500,"h":667,"by":"AgnosticPreachersKid","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Maggiano's_in_Friendship_Heights.jpg"}},"dish/matzah-brei":{"t":"dish","r":"dish/matzah-brei","n":"Matzah brei","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Jewish cuisine","dot":"#a99fb5","intro":[["Matzah brei, sometimes spelled matzah brie, matzoh brei, or matzo brei, is a dish of Ashkenazi Jewish origin made from matzah fried with eggs. It is commonly eaten as a breakfast food during the Jewish holiday of Passover. It can be prepared either sweet or savory."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-matzah-brei"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Matzah_brei"}],"sections":[{"h":"Where it's from","links":[["Jewish cuisine","cuisine/jewish-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Egg","ingredient/egg"],["Matzah","ingredient/matzah"],["Milk","ingredient/milk"]]},{"h":"Cook it","rows":[{"name":"Tori Avey: Jewish Recipes","ref":"site/toriavey-com","color":"#55b8ad","shape":"site","sub":"toriavey.com","note":"Tori Avey's Jewish recipe index, often paired with notes on each dish's history.","url":"https://toriavey.com/jewish-recipes/","suggested":true},{"name":"The Nosher (My Jewish Learning)","ref":"site/myjewishlearning-com","color":"#55b8ad","shape":"site","sub":"myjewishlearning.com","note":"Recipe section of the nonprofit My Jewish Learning, covering Ashkenazi, Sephardi and Mizrahi home cooking and holiday food.","url":"https://www.myjewishlearning.com/recipes/","suggested":true}]},{"h":"More from Jewish cuisine","links":[["Appetizing store","dish/appetizing-store"],["Bagel","dish/bagel"],["Brent's Deli","dish/brent-s-deli"],["Brisket (Jewish dish)","dish/brisket-jewish-dish"],["Cebularz","dish/cebularz"],["Challah","dish/challah"],["Forshmak","dish/forshmak"],["Gaby's Deli","dish/gaby-s-deli"],["Gefilte fish","dish/gefilte-fish"],["Gondi (food)","dish/gondi-food"],["Gribenes","dish/gribenes"],["Hamantash","dish/hamantash"],["Holishkes","dish/holishkes"],["Jewish deli","dish/jewish-deli"],["Katz's Delicatessen","dish/katz-s-delicatessen"],["Lekach","dish/lekach"],["Liebman's Deli","dish/liebman-s-deli"],["Mafrum","dish/mafrum"],["Miodownik","dish/miodownik"],["Pizza dolce di Beridde","dish/pizza-dolce-di-beridde"],["Reuben sandwich","dish/reuben-sandwich"],["Shirin polo","dish/shirin-polo"],["Sorrel soup","dish/sorrel-soup"],["Teiglach","dish/teiglach"],["Tsvikli","dish/tsvikli"],["Tzimmes","dish/tzimmes"],["Wolfie Cohen's Rascal House","dish/wolfie-cohen-s-rascal-house"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/2c/Matzah_brei_serving.jpg/500px-Matzah_brei_serving.jpg","w":500,"h":375,"by":"Yoninah","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Matzah_brei_serving.jpg"}},"ingredient/beef-tenderloin":{"t":"ingredient","r":"ingredient/beef-tenderloin","n":"Beef tenderloin","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A beef tenderloin (US English), known as an eye fillet in Australasia and fillet in the United Kingdom and South Africa, is cut from the loin of beef."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-beef-tenderloin"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Beef_tenderloin"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Selat solo","dish/selat-solo"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Carrot","ingredient/carrot"],["Egg","ingredient/egg"],["Green bean","ingredient/green-bean"],["Lettuce","ingredient/lettuce"],["Mayonnaise","ingredient/mayonnaise"],["Onion","ingredient/onion"],["Potato","ingredient/potato"],["Soy sauce","ingredient/soy-sauce"],["Sweet soy sauce","ingredient/sweet-soy-sauce"],["Vinegar","ingredient/vinegar"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b8/BeefCutTenderloin.png/500px-BeefCutTenderloin.png","w":500,"h":295,"by":"JoeSmack at English Wikipedia","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:BeefCutTenderloin.png"}},"dish/shaking-beef":{"t":"dish","r":"dish/shaking-beef","n":"Shaking beef","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Vietnamese cuisine","dot":"#f0b340","intro":[["Shaking beef or bo luc lac is a Vietnamese dish that consists of beef that has been cut into small cubes, marinated with fish sauce, soy sauce and oyster sauce, then sauteed in a wok with red onion and bell pepper before being served on a bed of fresh lettuce or watercress with slices of tomato and cucumber. Prior to French colonization, beef was considered a luxury ingredient in Vietnam, as cows were rarely slaughtered for food and were kept as working animals to be used for labor instead. This dish was, therefore, mostly reserved for formal events, such as wedding banquets and anniversaries, although now it has become a common food."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-shaking-beef"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Shaking_beef"}],"sections":[{"h":"Where it's from","links":[["Vietnamese cuisine","cuisine/vietnamese-cuisine"]]},{"h":"Ingredients","count":11,"links":[["Beef","ingredient/beef"],["Bell pepper","ingredient/bell-pepper"],["Cucumber","ingredient/cucumber"],["Fish sauce","ingredient/fish-sauce"],["Lettuce","ingredient/lettuce"],["Oyster sauce","ingredient/oyster-sauce"],["Peppercorn","ingredient/peppercorn"],["Red onion","ingredient/red-onion"],["Soy sauce","ingredient/soy-sauce"],["Tomato","ingredient/tomato"],["Watercress","ingredient/watercress"]]},{"h":"Cook it","rows":[{"name":"Viet World Kitchen","ref":"site/vietworldkitchen-com","color":"#55b8ad","shape":"site","sub":"vietworldkitchen.com","note":"Andrea Nguyen's blog on Vietnamese cooking, ingredients and technique.","url":"https://vietworldkitchen.com/blog/category/recipes-vietnamese","suggested":true},{"name":"Hungry Huy","ref":"site/hungryhuy-com","color":"#55b8ad","shape":"site","sub":"hungryhuy.com","note":"Vietnamese-American Huy Vu's recipes for home-style Vietnamese dishes.","url":"https://www.hungryhuy.com/vietnamese/","suggested":true}]},{"h":"More from Vietnamese cuisine","links":[["Alkemē","dish/alkeme"],["Bánh bao","dish/banh-bao"],["Bánh bột lọc","dish/b