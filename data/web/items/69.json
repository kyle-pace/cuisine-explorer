rant"],["Berowra Waters Inn","dish/berowra-waters-inn"],["Beurre maître d'hôtel","dish/beurre-maitre-d-hotel"],["Beurre manié","dish/beurre-manie"],["Bisque (food)","dish/bisque-food"],["Bistro 990","dish/bistro-990"],["Bistro Agnes","dish/bistro-agnes"],["Bistro Jeanty","dish/bistro-jeanty"]]}]},"ingredient/lumpia-wrapper":{"t":"ingredient","r":"ingredient/lumpia-wrapper","n":"Lumpia wrapper","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Lumpia (in Indonesian and Filipino) are various types of spring rolls commonly found in Indonesian and Filipino cuisines. Lumpia are made of thin paper-like or crêpe-like pastry skin called \"lumpia wrapper\" enveloping savory or sweet fillings. It is often served as an appetizer or snack, and might be served deep-fried or fresh (unfried). Lumpia are Indonesian and Filipino adaptations of the Fujianese lūn-piáⁿ (潤餅) and Teochew popiah (薄餅), usually consumed during Qingming Festival."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-lumpia-wrapper"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lumpia_wrapper"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Lumpia semarang","dish/lumpia-semarang"]]]]},{"h":"Often cooked with","links":[["Bamboo shoot","ingredient/bamboo-shoot"],["Chicken","ingredient/chicken"],["Crêpe","ingredient/crepe"],["Dried shrimp","ingredient/dried-shrimp"],["Shrimp","ingredient/shrimp"],["Sugar","ingredient/sugar"]]}]},"dish/matta-restaurant":{"t":"dish","r":"dish/matta-restaurant","n":"Matta (restaurant)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Vietnamese cuisine","dot":"#f0b340","intro":[["Matta is a Vietnamese restaurant in Portland, Oregon."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-matta-restaurant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Matta_(restaurant)"}],"sections":[{"h":"Where it's from","li