{"cuisine/cuisine-of-the-maritimes":{"t":"cuisine","r":"cuisine/cuisine-of-the-maritimes","n":"Cuisine of the Maritimes","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Canadian cuisine","cuisine/canadian-cuisine"]],"sub":"Regional cuisine in Canada","intro":[["The Maritimes consist of the provinces of New Brunswick, Nova Scotia and Prince Edward Island. Some of the cuisine has its origins in the foods of the indigenous peoples of the region."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"cuisine-of-the-maritimes"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cuisine_of_the_Maritimes"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Canadian cuisine","cuisine/canadian-cuisine"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"Maritime Flavours: Guidebook and Cookbook","ref":"cookbook/maritime-flavours-guidebook-and-cookbook","color":"#f0b340","shape":"book","sub":"Virginia Lee and Elaine Elliot","note":"Recipes from inns and restaurants across Nova Scotia, New Brunswick, and Prince Edward Island.","url":"https://formac.ca/product/maritime-flavours","suggested":true}]},{"h":"Part of","links":[["Canadian cuisine","cuisine/canadian-cuisine"]]}],"cont":"Cuisine of the Americas"},"cuisine/cuisine-of-ceredigion":{"t":"cuisine","r":"cuisine/cuisine-of-ceredigion","n":"Cuisine of Ceredigion","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Welsh cuisine","cuisine/welsh-cuisine"]],"sub":"Regional cuisine in United Kingdom","intro":[["The coast of Ceredigion is made up of a long coastal plain that contains high cliffs, coves, large bays and estuaries. The coastal plain gets narrower towards the more mountainous north of the county  and is cut by the wide estuaries of the Teifi and the Dyfi. The broad and fertile Teifi valley is ideal for dairy farming and mixed farming. Heavy rainfall washes the minerals out of the soil and results in the mountainous areas of the county having relatively poorer, acidic soils. The plough line can be as low as 700 feet, which restricts cultivation."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"cuisine-of-ceredigion"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cuisine_of_Ceredigion"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Welsh cuisine","cuisine/welsh-cuisine"]]},{"h":"Part of","links":[["Welsh cuisine","cuisine/welsh-cuisine"]]}],"cont":"European cuisine"},"dish/anticucho":{"t":"dish","r":"dish/anticucho","n":"Anticucho","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 4 cuisines","dot":"#94bd5c","intro":[["Anticuchos are popular and inexpensive meat dishes that originated in the Andes during the pre-Columbian era, specifically in the Antisuyu region of the Tawantinsuyu (Inca Empire). The modern dish was adapted during the colonial era between the 16th and 19th centuries and can now be found in Peru, Bolivia, Chile, and Ecuador, where they are known as \"chuzos\" or \"carne en palito\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-anticucho"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Anticucho"}],"sections":[{"h":"Where it's from","links":[["Argentine cuisine","cuisine/argentine-cuisine"],["Bolivian cuisine","cuisine/bolivian-cuisine"],["Chilean cuisine","cuisine/chilean-cuisine"],["Peruvian cuisine","cuisine/peruvian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Capsicum chinense","ingredient/capsicum-chinense"],["Offal","ingredient/offal"]]},{"h":"Cook it","rows":[{"name":"Familia Kitchen: Argentina","ref":"site/familiakitchen-com","color":"#55b8ad","shape":"site","sub":"familiakitchen.com","note":"Argentine recipes and stories on a Latino family cooking site.","url":"https://familiakitchen.com/destination/argentina/","suggested":true},{"name":"Chipa by the Dozen","ref":"site/chipabythedozen-com","color":"#55b8ad","shape":"site","sub":"chipabythedozen.com","note":"Bolivian-American Lizet Bowen's bilingual blog of Bolivian recipes.","url":"https://chipabythedozen.com/en/category/bolivian-food-recipes-savory-sweet/","suggested":true},{"name":"Mi Diario de Cocina: Chilean Recipes","ref":"site/midiariodecocina-com","color":"#55b8ad","shape":"site","sub":"midiariodecocina.com","note":"Bilingual blog with a large collection of traditional Chilean recipes.","url":"https://www.midiariodecocina.com/en/chilean-recipes/","suggested":true},{"name":"Pilar's Chilean Food & Garden","ref":"site/chileanfoodandgarden-com","color":"#55b8ad","shape":"site","sub":"chileanfoodandgarden.com","note":"Chilean home cooking blog by Pilar Hernández.","url":"https://www.chileanfoodandgarden.com/?p=37406","suggested":true}]},{"h":"More from Argentine cuisine","links":[["Argentine pizza","dish/argentine-pizza"],["Asado","dish/asado"],["Bara brith","dish/bara-brith"],["Bondiola sandwich","dish/bondiola-sandwich"],["Cabbage roll","dish/cabbage-roll"],["Dulce de batata","dish/dulce-de-batata"],["Fugazza","dish/fugazza"],["Jesuita (sandwich)","dish/jesuita-sandwich"],["Jésuite","dish/jesuite"],["Matambre","dish/matambre"],["Ox (Portland restaurant)","dish/ox-portland-restaurant"],["Puchero","dish/puchero"],["Rogel (cake)","dish/rogel-cake"],["Salsa golf","dish/salsa-golf"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b8/Anticucho_del_Per%C3%BA.JPG/500px-Anticucho_del_Per%C3%BA.JPG","w":500,"h":375,"by":"No machine-readable author provided. Manuel González Olaechea assumed (based on…","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Anticucho_del_Per%C3%BA.JPG"}},"ingredient/fries":{"t":"ingredient","r":"ingredient/fries","n":"Fries","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 6 dishes across 12 cuisines","intro":[["French fries, or simply fries, also known as French fried potatoes, chips, and finger chips, are batonnet or julienne-cut deep-fried potatoes of disputed origin. They are prepared by cutting potatoes into even strips, drying them, and f