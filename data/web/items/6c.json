{"cuisine/meitei-cuisine":{"t":"cuisine","r":"cuisine/meitei-cuisine","n":"Meitei cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Manipuri cuisine","cuisine/manipuri-cuisine"]],"sub":"Regional cuisine in India","intro":[["The Meitei people, also known as Meetei people, are a Tibeto-Burman ethnic group native to the Indian State of  Manipur. They form the largest and dominant ethnic group of Manipur in Northeast India. They speak the Meitei language (officially called Manipuri), one of the 22 official languages of the Republic of India and the sole official language of government of Manipur. The Meiteis primarily settle in the Imphal Valley region of modern-day Manipur, though a sizeable population has settled in the other Indian states of Assam, Tripura, Nagaland, Meghalaya, and Mizoram. There is also a notable presence of Meiteis in the neighbouring countries of Myanmar and Bangladesh. The Meiteis represent about 53% of Manipur's population, according to the 2011 census."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"meitei-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Meitei_cuisine"}],"sections":[{"h":"Recipe sites","count":1,"rows":[{"name":"Lukthel","color":"#55b8ad","shape":"site","sub":"lukthel.com","note":"Meetei-origin category on a Manipuri recipe site.","url":"https://lukthel.com/recipe/category/origin/meetei","suggested":true,"kind":"site"}]},{"h":"Part of","links":[["Manipuri cuisine","cuisine/manipuri-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/world-cuisine/img/thumb/1/11/SAGOL_KANGJEI_-_POLO_IN_MANIPUR.jpg/500px-SAGOL_KANGJEI_-_POLO_IN_MANIPUR.jpg","w":500,"h":331,"by":"E.J. Mitchell, Esq.","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:SAGOL_KANGJEI_-_POLO_IN_MANIPUR.jpg"}},"ingredient/sorrel":{"t":"ingredient","r":"ingredient/sorrel","n":"Sorrel","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 7 cuisines","intro":[["Sorrel (Rumex acetosa) is a perennial herbaceous plant in the family Polygonaceae. It is also called common sorrel, meadow sorrel, green sorrel, sour dock, spinach dock and narrow-leaved dock (\"dock\" often used for the genus)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sorrel"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sorrel"}],"sections":[{"h":"Where it's cooked with","count":7,"groups":[["Belarusian cuisine","cuisine/belarusian-cuisine",[["Cold beet soup","dish/cold-beet-soup"],["Sorrel soup","dish/sorrel-soup"]]],["Polish cuisine","cuisine/polish-cuisine",[["Cold beet soup","dish/cold-beet-soup"],["Sorrel soup","dish/sorrel-soup"]]],["Ukrainian cuisine","cuisine/ukrainian-cuisine",[["Cold beet soup","dish/cold-beet-soup"],["Sorrel soup","dish/sorrel-soup"]]],["Jewish cuisine","cuisine/jewish-cuisine",[["Sorrel soup","dish/sorrel-soup"]]],["Latvian cuisine","cuisine/latvian-cuisine",[["Cold beet soup","dish/cold-beet-soup"]]],["Lithuanian cuisine","cuisine/lithuanian-cuisine",[["Cold beet soup","dish/cold-beet-soup"]]],["Russian cuisine","cuisine/russian-cuisine",[["Sorrel soup","dish/sorrel-soup"]]]]},{"h":"Often cooked with","links":[["Beetroot","ingredient/beetroot"],["Kefir","ingredient/kefir"],["Kvass","ingredient/kvass"],["Broth","ingredient/broth"],["Carrot","ingredient/carrot"],["Edible salt","ingredient/edible-salt"],["Egg","ingredient/egg"],["Pork ribs","ingredient/pork-ribs"],["Potato","ingredient/potato"],["Smetana","ingredient/smetana"]]}],"img":{"src":"/world-cuisine/img/thumb/a/a3/%28MHNT%29_Rumex_acetosa_-_Habit.jpg/500px-%28MHNT%29_Rumex_acetosa_-_Habit.jpg","w":500,"h":281,"by":"Didier Descouens","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:(MHNT)_Rumex_acetosa_-_Habit.jpg"}},"ingredient/dip":{"t":"ingredient","r":"ingredient/dip","n":"Dip","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["A dip or dipping sauce is a common condiment for many types of food. Dips are used to add flavor or texture to a food, such as pita bread, dumplings, crackers, chopped raw vegetables, fruits, seafood, cubed pieces of meat and cheese, potato chips, tortilla chips, falafel, and sometimes even whole sandwiches in the case of jus. Unlike other sauces, instead of applying the sauce to the food, the food is typically placed or dipped into the sauce."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-dip"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Dip_(food)"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["French cuisine","cuisine/french-cuisine",[["Crudités","dish/crudites"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Crudités","dish/crudites"]]]]},{"h":"Often cooked with","links":[["Vinaigrette","ingredient/vinaigrette"]]}],"img":{"src":"/world-cuisine/img/thumb/3/3e/Showing_how_to_dip_a_piece_of_sushi_into_a_bowl_of_soy_sauce.jpg/500px-Showing_how_to_dip_a_piece_of_sushi_into_a_bowl_of_soy_sauce.jpg","w":500,"h":375,"by":"Bodhi Peace","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Showing_how_to_dip_a_piece_of_sushi_into_a_bowl_of_soy_sauce.jpg"}},"dish/gondi-food":{"t":"dish","r":"dish/gondi-food","n":"Gondi (food)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#a99fb5","intro":[["Gondi, sometimes spelled gundi, is a Persian Jewish dish of meatballs made from ground lamb, veal or chicken traditionally served on Shabbat. Dried lime is sometimes used as an ingredient. Gondi are served as part of chicken soup on Shabbat and other Jewish holidays, like the similar-looking but unrelated Ashkenazi Jewish matzo balls."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-gondi-food"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Gondi_(food)"}],"sections":[{"h":"Where it's fr