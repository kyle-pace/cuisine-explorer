{"cuisine/indo-caribbean-food":{"t":"cuisine","r":"cuisine/indo-caribbean-food","n":"Indo Caribbean food","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Indian cuisine","cuisine/indian-cuisine"]],"sub":"Diaspora cuisine in India","intro":[],"src":null,"wiki":"Indo Caribbean food","actions":[{"kind":"globe","hash":"indo-caribbean-food"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Indo_Caribbean_food"}],"sections":[{"h":"Recipe sites","count":2,"rows":[{"name":"Cooking with Ria","color":"#55b8ad","shape":"site","sub":"cookingwithria.com","note":"Trinidadian home cook's blog, with Indo-Trinidadian curries, roti and snacks.","url":"https://cookingwithria.com/category/indian-recipes/","suggested":true,"kind":"blog"},{"name":"Alica's Pepperpot","color":"#55b8ad","shape":"site","sub":"alicaspepperpot.com","note":"Guyanese-born Alica's blog of Guyanese recipes, including Indo-Guyanese dishes.","url":"https://www.alicaspepperpot.com/about/","suggested":true,"kind":"blog"}]},{"h":"Part of","links":[["Indian cuisine","cuisine/indian-cuisine"]]}],"cont":"Asian cuisine"},"ingredient/leafy-greens":{"t":"ingredient","r":"ingredient/leafy-greens","n":"Leafy greens","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Leaf vegetables, also called leafy greens, vegetable greens, or simply greens, are plant leaves eaten as a vegetable. Those eaten raw in a salad can be called salad greens, whereas leaf vegetables eaten cooked can be called pot herbs."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-leafy-greens"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Leafy_greens"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Bubur pedas","dish/bubur-pedas"]]]]},{"h":"Often cooked with","links":[["Anchovy","ingredient/anchovy"],["Bamboo shoot","ingredient/bamboo-shoot"],["Bean curd","ingredient/bean-curd"],["Bumbu (seasoning)","ing