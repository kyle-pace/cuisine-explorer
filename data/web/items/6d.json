tions":[{"h":"Where it's from","links":[["Cambodian cuisine","cuisine/cambodian-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Black pepper","ingredient/black-pepper"],["Garlic","ingredient/garlic"],["Ginger root","ingredient/ginger-root"],["Holy basil","ingredient/holy-basil"],["Palm sugar","ingredient/palm-sugar"],["Soy sauce","ingredient/soy-sauce"]]},{"h":"Cook it","rows":[{"name":"Chef Nak","ref":"site/chefnak-com","color":"#55b8ad","shape":"site","sub":"chefnak.com","note":"Site of Cambodian chef and cookbook author Chef Nak, with notes on Khmer cookbooks.","url":"https://www.chefnak.com/nhum","suggested":true}]},{"h":"More from Cambodian cuisine","links":[["Cha kroeung","dish/cha-kroeung"],["Grilled honeycomb","dish/grilled-honeycomb"],["Kampot pepper crab","dish/kampot-pepper-crab"],["Phnom Penh Noodle House","dish/phnom-penh-noodle-house"],["Thali","dish/thali"]]}]},"ingredient/jalapeno":{"t":"ingredient","r":"ingredient/jalapeno","n":"Jalapeño","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 3 cuisines","intro":[["The jalapeño is a medium-sized chili pepper pod type cultivar of the species Capsicum annuum. A mature jalapeño chili is 5–10 cm (2–4 in) long and 25–38 mm (1–1+1⁄2 in) wide, and hangs down from the plant. The pungency of jalapeño peppers varies, but is usually between 4,000 and 8,500 units on the Scoville scale. Commonly picked and consumed while still green, it is occasionally allowed to fully ripen and turn red, orange, or yellow. It is wider and generally milder than the similar Serrano pepper."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-jalapeno"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Jalape%C3%B1o"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Mexican cuisine","cuisine/mexican-cuisine",[["Chimichanga","dish/chimichanga"],["Guacamole","dish/guacamole"]]],["American cuisine","cuisine/american-cuisine",[["Chimichanga","dish/chimichanga"]]],