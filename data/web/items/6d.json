ind":"site"}]},{"h":"More from Cambodian cuisine","links":[["Cha kroeung","dish/cha-kroeung"],["Grilled honeycomb","dish/grilled-honeycomb"],["Kampot pepper crab","dish/kampot-pepper-crab"],["Thali","dish/thali"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/5c/Char_Kh%E2%80%99nhei_at_Khmer_Cuisine_%282%29.jpg/500px-Char_Kh%E2%80%99nhei_at_Khmer_Cuisine_%282%29.jpg","w":500,"h":485,"by":"Turaids","lic":"CC BY 4.0","licUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:Char_Kh%E2%80%99nhei_at_Khmer_Cuisine_(2).jpg"}},"ingredient/jalapeno":{"t":"ingredient","r":"ingredient/jalapeno","n":"Jalapeño","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 3 cuisines","intro":[["The jalapeño is a medium-sized chili pepper pod type cultivar of the species Capsicum annuum. A mature jalapeño chili is 5–10 cm (2–4 in) long and 25–38 mm (1–1+1⁄2 in) wide, and hangs down from the plant. The pungency of jalapeño peppers varies, but is usually between 4,000 and 8,500 units on the Scoville scale. Commonly picked and consumed while still green, it is occasionally allowed to fully ripen and turn red, orange, or yellow. It is wider and generally milder than the similar Serrano pepper."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-jalapeno"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Jalape%C3%B1o"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Mexican cuisine","cuisine/mexican-cuisine",[["Chimichanga","dish/chimichanga"],["Guacamole","dish/guacamole"]]],["American cuisine","cuisine/american-cuisine",[["Chimichanga","dish/chimichanga"]]],["Tex-Mex cuisine","cuisine/tex-mex-cuisine",[["Guacamole","dish/guacamole"]]]]},{"h":"Where it's grown","grown":{"what":"Chillies and peppers, green (Capsicum spp. and Pimenta spp.)","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":43513792,"top":[["China","cuisine/chinese-cuisine",17329872],