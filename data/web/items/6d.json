3,"groups":[["Lao cuisine","cuisine/lao-cuisine",[["Drunken noodles","dish/drunken-noodles"]]],["Thai cuisine","cuisine/thai-cuisine",[["Drunken noodles","dish/drunken-noodles"]]],["Vietnamese cuisine","cuisine/vietnamese-cuisine",[["Shaking beef","dish/shaking-beef"]]]]},{"h":"Often cooked with","links":[["Fish sauce","ingredient/fish-sauce"],["Peppercorn","ingredient/peppercorn"],["Soy sauce","ingredient/soy-sauce"],["Baby corn","ingredient/baby-corn"],["Bean sprout","ingredient/bean-sprout"],["Chicken","ingredient/chicken"],["Chili pepper","ingredient/chili-pepper"],["Garlic","ingredient/garlic"],["Holy basil","ingredient/holy-basil"],["Pisum sativum subsp. sativum convar. axiphium","ingredient/pisum-sativum-subsp-sativum-convar-axiphium"],["Shahe fen","ingredient/shahe-fen"],["Shrimp","ingredient/shrimp"],["Sugar","ingredient/sugar"],["Tofu","ingredient/tofu"],["Beef","ingredient/beef"],["Bell pepper","ingredient/bell-pepper"]]}]},"dish/jumbo-kingdom":{"t":"dish","r":"dish/jumbo-kingdom","n":"Jumbo Kingdom","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Cantonese cuisine","dot":"#f0b340","intro":[["Jumbo Kingdom consisted of the Jumbo Floating Restaurant (Chinese: 珍寶海鮮舫) and the adjacent Tai Pak Floating Restaurant (Chinese: 太白海鮮舫), which were tourist attractions in the Aberdeen South Typhoon Shelters within Hong Kong's Aberdeen Harbour. During its 44 years of operation, over thirty million visitors visited Jumbo Kingdom, including Queen Elizabeth II, Jimmy Carter, Tom Cruise, Chow Yun Fat, and Gong Li. A subsidiary, Jumbo Kingdom Manila, operated in Manila Bay, Philippines, but closed after eight years. Jumbo Kingdom was part of Melco International Development Limited, a company listed on the Hong Kong Stock Exchange. It suspended operations in 2020 amidst the COVID-19 pandemic."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-jumbo-kingdom"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Jumbo_Kingdom"}],"sections":[{"h":"Where it's from","links":[["Cantonese cuisine","cuisine/cantonese-cuisine"]]},{"h":"Cook it","rows":[{"name":"Made With Lau","ref":"site/madewithlau-com","color":"#55b8ad","shape":"site","sub":"madewithlau.com","note":"Family-run channel and site teaching Cantonese recipes from retired chef Daddy Lau.","url":"https://madewithlau.com","suggested":true}]},{"h":"More from Cantonese cuisine","links":[["Cantonese restaurant","dish/cantonese-restaurant"],["Char siu","dish/char-siu"],["ClubONE Riviera","dish/clubone-riviera"],["Fook Lam Moon","dish/fook-lam-moon"],["Har gow","dish/har-gow"],["Heichinrou Hong Kong","dish/heichinrou-hong-kong"],["Hong dou tang","dish/hong-dou-tang"],["Lap cheong","dish/lap-cheong"],["Lung King Heen","dish/lung-king-heen"],["Mak's Noodle","dish/mak-s-noodle"],["Rice noodle roll","dish/rice-noodle-roll"],["Siu mei","dish/siu-mei"],["Sweet and sour pork","dish/sweet-and-sour-pork"],["Turnip cake","dish/turnip-cake"],["Wong Kei","dish/wong-kei"]]}]},"dish/khingalsh":{"t":"dish","r":"dish/khingalsh","n":"Khingalsh","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Chechen cuisine","dot":"#f0b340","intro":[["Khingalsh is a traditional Chechen pie filled with pumpkin or sweet potato and served with butter or clarified butter. The pies are typically cut into pieces before serving."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-khingalsh"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Khingalsh"}],"sections":[{"h":"Where it's from","links":[["Chechen cuisine","cuisine/chechen-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Pumpkin","ingredient/pumpkin"]]},{"h":"More from Chechen cuisine","links":[["Blini","dish/blini"],["Vieta (dish)","dish/vieta-dish"],["Zhizhig-galnash","dish/zhizhig-galnash"]]}]},"dish/manchow-soup":{"t":"dish","r":"dish/manchow-soup","n":"Manchow soup","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indian Chinese cuisine","dot":"#f0b340","intro":[["Manchow soup is a popular type of soup exclusive to Indo-Chinese cuisine, due to its easy preparation and hot, spicy taste. It is available in many restaurants and street food carts. Although the soup is named after the Asian region of Manchuria, it does not resemble food that is normally found in the region and is instead from the state of Meghalaya."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-manchow-soup"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Manchow_soup"}],"sections":[{"h":"Where it's from","links":[["Indian Chinese cuisine","cuisine/indian-chinese-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Scallion","ingredient/scallion"]]}]},"ingredient/sauce-bourguignonne":{"t":"ingredient","r":"ingredient/sauce-bourguignonne","n":"Sauce Bourguignonne","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Sauce bourguignonne is a French sauce with a base of red wine with onions or shallots, a bouquet garni (parsley, thyme and bay leaf), reduced, strained, and mixed with some espagnole sauce. Just before serving it is mounted with butter and seasoned lightly with cayenne pepper. Like all red wine sauces, it may have some mushrooms added during cooking to enrich the flavour."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sauce-bourguignonne"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sauce_bourguignonne"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["French cuisine","cuisine/french-cuisine",[["Oeufs en meurette","dish/oeufs-en-meurette"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Oeufs en meurette","dish/oeufs-en-meurette"]]]]},{"h":"Often cooked with","links":[["Poached egg","ingredient/poached-egg"]]}]},"ingredient/cucurbita":{"t":"ingredient","r":"ingredient/cucurbita","n":"Cucurbita","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 4 cuisines","intro":[["Cucurbita (Latin for 'gourd') is a genus, native to the Andes and Mesoamerica, of herbaceous fruits in the gourd family, Cucurbitaceae (also known as cucurbits or cucurbi). Five edible species are grown and consumed for their flesh and seeds. They are variously known as squash, pumpkin, or gourd, depending on species, variety, and local parlance. Other kinds of gourd, also called bottle gourds, are native to Africa and belong to the genus Lagenaria, which is in the same family and subfamily as Cucurbita, but in a different tribe; their young fruits are eaten much like those of the Cucurbita species."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-cucurbita"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cucurbita"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Tinutuan","dish/tinutuan"]]],["Kazakh cuisine","cuisine/kazakh-cuisine",[["Orama (dish)","dish/orama-dish"]]],["Kyrgyz cuisine","cuisine/kyrgyz-cuisine",[["Orama (dish)","dish/orama-dish"]]],["Uzbek cuisine","cuisine/uzbek-cuisine",[["Orama (dish)","dish/orama-dish"]]]]},{"h":"Often cooked with","links":[["Animal fat","ingredient/animal-fat"],["Brassica","ingredient/brassica"],["Potato","ingredient/potato"],["Pumpkin","ingredient/pumpkin"],["Wheat flour","ingredient/wheat-flour"],["Congee","ingredient/congee"],["Corncob","ingredient/corncob"],["Granulated sugar","ingredient/granulated-sugar"],["Holy basil","ingredient/holy-basil"],["Ipomoea aquatica","ingredient/ipomoea-aquatica"],["Rice","ingredient/rice"],["Salt-cured meat","ingredient/salt-cured-meat"],["Sweet potato","ingredient/sweet-potato"],["Tapioca","ingredient/tapioca"]]}]},"dish/pakistani-rice-dishes":{"t":"dish","r":"dish/pakistani-rice-dishes","n":"Pakistani rice dishes","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Pakistani cuisine","dot":"#f0b340","intro":[["Pakistani rice dishes are popular across the country, and based on Pakistan's role major producer, consumer, and exporter rice, with Basmati being the most commonly used variety. Rice is often served alongside or mixed with other dishes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pakistani-rice-dishes"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pakistani_rice_dishes"}],"sections":[{"h":"Where it's from","links":[["Pakistani cuisine","cuisine/pakistani-cuisine"]]},{"h":"Cook it","rows":[{"name":"Pakistan Eats","ref":"site/pakistaneats-substack-com","color":"#55b8ad","shape":"site","sub":"pakistaneats.substack.com","note":"Maryam Jillani's newsletter on Pakistani food, recipes and food culture.","url":"https://pakistaneats.substack.com/p/pakistani-dishes-for-beginners","suggested":true}]},{"h":"More from Pakistani cuisine","links":[["Bannu pulao","dish/bannu-pulao"],["Falooda","dish/falooda"],["Paratha roll","dish/paratha-roll"],["Reshmi kabab","dish/reshmi-kabab"],["Tandoori roti","dish/tandoori-roti"],["Thali","dish/thali"],["Zarda (food)","dish/zarda-food"]]}]},"dish/philippe-the-original":{"t":"dish","r":"dish/philippe-the-original","n":"Philippe the Original","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["\"Philippe the Original\", commonly known as Philippe's ( fi-LEEPS) is a restaurant located in downtown Los Angeles, California.  The restaurant is well known for continuously operating since 1908, making it one of the oldest restaurants in Los Angeles. It is also renowned for claiming to be the inventor of the French dip sandwich."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-philippe-the-original"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Philippe_the_Original"}],"sections":[{"h":"Where it's from","links":[["French cuisine","cuisine/french-cuisine"],["New Caledonian cuisine","cuisine/new-caledonian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Pardon Your French","ref":"site/pardonyourfrench-com","color":"#55b8ad","shape":"site","sub":"pardonyourfrench.com","note":"Audrey Le Goff, a French cook, shares classic and regional French home recipes.","url":"https://pardonyourfrench.com","suggested":true},{"name":"La Cuisine de Géraldine","ref":"site/lacuisinedegeraldine-fr","color":"#55b8ad","shape":"site","sub":"lacuisinedegeraldine.fr","note":"French home cooking blog by Géraldine Leverd, also author of The New French Kitchen.","url":"https://lacuisinedegeraldine.fr/en/about-us","suggested":true},{"name":"New Caledonia Tourism: Kanak cooking","ref":"site/newcaledonia-travel","color":"#55b8ad","shape":"site","sub":"newcaledonia.travel","note":"Official tourism board overview of Kanak food, including bougna cooked in an earth oven.","url":"https://www.newcaledonia.travel/nz/gastronomy-wine/gastronomy/kanak-cooking","suggested":true}]},{"h":"More from French cuisine","links":[["'t Fornuis","dish/t-fornuis"],["'t Misverstant","dish/t-misverstant"],["'t Vlasbloemeken","dish/t-vlasbloemeken"],["&moshik","dish/moshik"],["Aan de Poel","dish/aan-de-poel"],["Adrian (restaurant)","dish/adrian-restaurant"],["Adventureland Bazaar","dish/adventureland-bazaar"],["Alain Ducasse at The Dorchester","dish/alain-ducasse-at-the-dorchester"],["Albufera sauce","dish/albufera-sauce"],["Alex (restaurant)","dish/alex-restaurant"],["Andouillette","dish/andouillette"],["Arpège (restaurant)","dish/arpege-restaurant"],["Aspic","dish/aspic"],["Atelier Crenn","dish/atelier-crenn"],["Au Coin des Bons Enfants","dish/au-coin-des-bons-enfants"],["Au Crocodile","dish/au-crocodile"],["Au Pied de Cochon (Mexico City)","dish/au-pied-de-cochon-mexico-city"],["Auberge (restaurant)","dish/auberge-restaurant"],["Auberge De Kieviet","dish/auberge-de-kieviet"],["Aubergine (London restaurant)","dish/aubergine-london-restaurant"],["Auguste (restaurant)","dish/auguste-restaurant"],["Bagatelle (restaurant)","dish/bagatelle-restaurant"],["Balthazar (restaurant)","dish/balthazar-restaurant"],["Bardot Brasserie","dish/bardot-brasserie"],["Bâtard (restaurant)","dish/batard-restaurant"],["Baumé (restaurant)","dish/baume-restaurant"],["Bayonne ham","dish/bayonne-ham"],["Be Our Guest Restaurant","dish/be-our-guest-restaurant"],["Beaulieu, Doorwerth Castle","dish/beaulieu-doorwerth-castle"],["Beef Stroganoff","dish/beef-stroganoff"],["Bell's (restaurant)","dish/bell-s-restaurant"],["Belmond Le Manoir aux Quat'Saisons","dish/belmond-le-manoir-aux-quat-saisons"],["Beluga (restaurant)","dish/beluga-restaurant"],["Berowra Waters Inn","dish/berowra-waters-inn"],["Beurre maître d'hôtel","dish/beurre-maitre-d-hotel"],["Beurre manié","dish/beurre-manie"],["Bisque (food)","dish/bisque-food"],["Bistro 990","dish/bistro-990"],["Bistro Agnes","dish/bistro-agnes"],["Bistro Jeanty","dish/bistro-jeanty"]]}]},"dish/rumford-s-soup":{"t":"dish","r":"dish/rumford-s-soup","n":"Rumford's Soup","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Bavarian cuisine","dot":"#cf5f87","intro":[["Rumford's Soup (Rumfordsche Suppe, also called economy soup) was an early effort in scientific nutrition. It was invented by Benjamin Thompson, Reichsgraf von Rumford, circa 1800 and consumed in Munich and greater Bavaria, where he was employed as an advisor to Charles Theodore, Elector of Bavaria. It was used as a ration for the poor, for Bavarian workhouses and military workhouses, and prisoners. Count Rumford has been credited in many instances for \"establishing the first real soup kitchen.\""]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-rumford-s-soup"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rumford's_Soup"}],"sections":[{"h":"Where it's from","links":[["Bavarian cuisine","cuisine/bavarian-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Beer","ingredient/beer"],["Pea","ingredient/pea"],["Pearl barley","ingredient/pearl-barley"],["Potato","ingredient/potato"],["Sour beer","ingredient/sour-beer"]]},{"h":"More from Bavarian cuisine","links":[["Bayrisch Kraut","dish/bayrisch-kraut"],["Biergarten Restaurant","dish/biergarten-restaurant"],["Leberkäse","dish/leberkase"],["Weißwurst","dish/wei-wurst"]]}]},"dish/selat-solo":{"t":"dish","r":"dish/selat-solo","n":"Selat solo","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Selat solo is a Javanese dish influenced by Western cuisine; it is a specialty of Solo city, Central Java, Indonesia. It consists of braised beef tenderloin served in thin watery sauce made from a mixture of garlic, vinegar, kecap manis (sweet soy sauce), Worcestershire sauce, water, and spiced with nutmeg and black pepper. It is served with hard boiled egg and vegetables such as string beans, potato, tomato, lettuce, cucumber, cauliflower or broccoli and carrot, and topped with potato chips and some dash of mustard, hollandaise or sauce gribiche on the side."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-selat-solo"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Selat_solo"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":12,"links":[["Beef","ingredient/beef"],["Beef tenderloin","ingredient/beef-tenderloin"],["Carrot","ingredient/carrot"],["Egg","ingredient/egg"],["Green bean","ingredient/green-bean"],["Lettuce","ingredient/lettuce"],["Mayonnaise","ingredient/mayonnaise"],["Onion","ingredient/onion"],["Potato","ingredient/potato"],["Soy sauce","ingredient/soy-sauce"],["Sweet soy sauce","ingredient/sweet-soy-sauce"],["Vinegar","ingredient/vinegar"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","ref":"site/dailycookingquest-com","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan"