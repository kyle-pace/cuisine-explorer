edient/flavor-enhancer":{"t":"ingredient","r":"ingredient/flavor-enhancer","n":"Flavor enhancer","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["A flavoring (or flavouring), also known as flavor (or flavour) or flavorant, is a food additive that is used to improve the taste or smell of food. It changes the perceptual impression of food as determined primarily by the chemoreceptors of the gustatory and olfactory systems. Along with additives, other components, like sugars, determine the taste of food."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-flavor-enhancer"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Flavor_enhancer"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Pempek","dish/pempek"],["Saksang","dish/saksang"]]],["Palembang cuisine","cuisine/palembang-cuisine",[["Pempek","dish/pempek"]]]]},{"h":"Often cooked with","links":[["Egg","ingredient/egg"],["Fish","ingredient/fish"],["Noodles","ingredient/noodles"],["Palm sugar","ingredient/palm-sugar"],["Tamarind","ingredient/tamarind"],["Tapioca","ingredient/tapioca"],["Vinegar","ingredient/vinegar"],["Wheat flour","ingredient/wheat-flour"],["Alpinia officinarum","ingredient/alpinia-officinarum"],["Andaliman","ingredient/andaliman"],["Bay leaf","ingredient/bay-leaf"],["Black pepper","ingredient/black-pepper"],["Chili pepper","ingredient/chili-pepper"],["Dog meat","ingredient/dog-meat"],["Ginger","ingredient/ginger"],["Grated coconut","ingredient/grated-coconut"]]}]},"ingredient/scotch-bonnet":{"t":"ingredient","r":"ingredient/scotch-bonnet","n":"Scotch bonnet","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Scotch bonnet (also known as Bonney peppers, Caribbean red peppers or Panamanian pepper"]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-scotch-bonnet"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Scotch_bonnet"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["British cuisine","cuisine/british-cuisine",[["Phall","dish/phall"]]]]},{"h":"Often cooked with","links":[["Carolina Reaper","ingredient/carolina-reaper"],["Chili pepper","ingredient/chili-pepper"],["Ginger","ingredient/ginger"],["Habanero","ingredient/habanero"],["Tomato","ingredient/tomato"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/97/Scotch_bonnet_chili_pepper.jpg/500px-Scotch_bonnet_chili_pepper.jpg","w":500,"h":502,"by":"Temaciejewski","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Scotch_bonnet_chili_pepper.jpg"}},"ingredient/stock-cooking":{"t":"ingredient","r":"ingredient/stock-cooking","n":"Stock (cooking)","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 14 cuisines","intro":[["Stock, sometimes called bone broth, is a savory cooking liquid that forms the basis of many dishes – particularly soups, stews, and sauces. Making stock involves simmering animal bones, meat, seafood, or vegetables in water or wine, often for an extended period. Mirepoix or other aromatics may be added for more flavor."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-stock-cooking"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Stock_(cooking)"}],"sections":[{"h":"Where it's cooked with","count":14,"groups":[["Afghan cuisine","cuisine/afghan-cuisine",[["Pilaf","dish/pilaf"]]],["Armenian cuisine","cuisine/armenian-cuisine",[["Pilaf","dish/pilaf"]]],["Azerbaijani cuisine","cuisine/azerbaijani-cuisine",[["Pilaf","dish/pilaf"]]],["Bashkir cuisine","cuisine/bashkir-cuisine",[["Pilaf","dish/pilaf"]]],["Bengali cuisine","cuisine/bengali-cuisine",[["Pilaf","dish/pilaf"]]],["Chinese cuisine","cuisine/chinese-cuisine",[["Pilaf","dish/pilaf"]]],["Iranian cuisine","cuisine/iranian-cuisine",[["Pilaf","dish/pilaf"]]],["Kazakh cuisine","cuisine/kazakh-cuisine",[["Pilaf","dish/pilaf"]]],["Kyrgyz cuisine","cuisine/kyrgyz-cuisine",[["Pilaf","dish/pilaf"]]],["Tajik cuisine","cuisine/tajik-cuisine",[["Pilaf","dish/pilaf"]]],["Tatar cuisine","cuisine/tatar-cuisine",[["Pilaf","dish/pilaf"]]],["Turkish cuisine","cuisine/turkish-cuisine",[["Pilaf","dish/pilaf"]]],["Turkmen cuisine","cuisine/turkmen-cuisine",[["Pilaf","dish/pilaf"]]],["Uzbek cuisine","cuisine/uzbek-cuisine",[["Pilaf","dish/pilaf"]]]]},{"h":"Often cooked with","links":[["Animal fats and oils","ingredient/animal-fats-and-oils"],["Beef","ingredient/beef"],["Broth","ingredient/broth"],["Carrot","ingredient/carrot"],["Dried fruit","ingredient/dried-fruit"],["Lard","ingredient/lard"],["Onion","ingredient/onion"],["Rice","ingredient/rice"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a9/Making_stock_for_pho_bo.jpg/500px-Making_stock_for_pho_bo.jpg","w":500,"h":349,"by":"Blue Lotus","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Making_stock_for_pho_bo.jpg"}},"dish/qurutob":{"t":"dish","r":"dish/qurutob","n":"Qurutob","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Tajik cuisine","dot":"#f0b340","intro":[["Qurutob is a dish of Tajik cuisine. Sometimes described as a \"bread salad\", it is created using qurut, dried balls of cheese, which are soaked in water; the resulting liquid, salty in flavor, is used as the base of the dish. Strips of fatir, a type of flatbread, are then placed on top. The mixture is served on large plates, and is usually topped with a variety of vegetables, such as onions, cucumbers, tomatoes, or herbs; meat or chili peppers are also sometimes seen as garnishes. Qurutob is a shared dish, meant to be eaten with the hands."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-qurutob"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Qurutob"}],"sections":[{"h":"Where it's from","links":[["Tajik cuisine","cuisine/tajik-cuisine"]]},{"h":