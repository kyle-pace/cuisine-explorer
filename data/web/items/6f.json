{"cuisine/malawian-cuisine":{"t":"cuisine","r":"cuisine/malawian-cuisine","n":"Malawian cuisine","c":"#e46a3f","crumb":[["Africa","cuisines#africa"],["Cuisine"]],"sub":"National cuisine of Malawi","intro":[["Tea and fish are popular features of Malawian cuisine. Sugar, coffee, corn, potatoes, sorghum, cattle and goats are also important components of the cuisine and economy."],["Lake Malawi is a source of fish including chambo (similar to bream), usipa (similar to sardine), mpasa (similar to salmon), and kampango."],["Nsima is a staple food made from ground corn and served with side dishes of meat, beans and vegetables. It can be eaten for lunch and dinner."],["Additional Malawi cuisine includes:"],["Kachumbari, a type of tomato and onion salad, known locally in Malawi as a sumu or shum or simply 'tomato and onion salad'."],["Thobwa, a fermented drink made from white maize and millet or sorghum."],["Kondowole, made from cassava flour and water. It is primarily from northern Malawi and is a very sticky meal resembling Malawian nsima, Tanzanian ugali, or Ugandan posho. It is mostly cooked on the floor because of its texture as it is normally tough to run a cooking stick through hence much strength is needed. Kondowole is normally eaten with fish."],["Futali"],["Nthochi, banana bread"]],"src":"wikipedia","actions":[{"kind":"globe","hash":"malawian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Malawian_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"Cookbooks","count":1,"rows":[{"name":"The Malawi Cookbook","color":"#f0b340","shape":"book","sub":"Annabel Shaxson, Pat Dickson and June Walker, 1974","note":"Long running Malawian cookbook issued through the Ministry of Health; now out of print.","url":"","suggested":true}]}],"cont":"African cuisine","img":{"src":"/labs/cuisines/img/thumb/1/1d/Nsima_Relishes.JPG/500px-Nsima_Relishes.JPG","w":500,"h":358,"by":"Jpatokal","lic":"CC BY-SA 2.5","licUrl":"https://creativecommons.org/licenses/by-sa/2.5","page":"https://commons.wikimedia.org/wiki/File:Nsima_Relishes.JPG"}},"cuisine/panamanian-cuisine":{"t":"cuisine","r":"cuisine/panamanian-cuisine","n":"Panamanian cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Cuisine"]],"sub":"National cuisine of Panama","intro":[["Panamanian cuisine is a mix of Spanish, Indigenous, and African techniques, dishes, and ingredients, reflecting its diverse population. Since Panama is a land bridge between two continents, it has a large variety of tropical fruits, vegetables and herbs that are used in native cooking."],["Common ingredients in Panamanian food are maize, rice, wheat flour, plantains, yuca (cassava), beef, chicken, pork and seafood."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"panamanian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Panamanian_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"More from Panama","count":1,"links":[["Guna foodways","cuisine/guna-foodways"]]}],"cont":"Cuisine of the Americas","img":{"src":"/labs/cuisines/img/thumb/4/45/Ropa_vieja_plato_cubano_por_excelencia_2.jpg/500px-Ropa_vieja_plato_cubano_por_excelencia_2.jpg","w":500,"h":366,"by":"El Mono Español","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Ropa_vieja_plato_cubano_por_excelencia_2.jpg"}},"cuisine/arequipan-cuisine":{"t":"cuisine","r":"cuisine/arequipan-cuisine","n":"Arequipan cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Peruvian cuisine","cuisine/peruvian-cuisine"]],"sub":"Regional cuisine in Peru","intro":[["Arequipan cuisine is the cuisine of Arequipa, a regional Peruvian cuisine. Arequipan cuisine is known for its picanterías (place of spicy food), traditional local restaurants offering chicha de jora accompanied by four small plates of spicy rocoto seasoned regional delicacies along with singing or music."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"arequipan-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Arequipan_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Peruvian cuisine","cuisine/peruvian-cuisine"]]},{"h":"Part of","links":[["Peruvian cuisine","cuisine/peruvian-cuisine"]]}],"cont":"Cuisine of the Americas"},"cuisine/trinidad-and-tobago-cuisine":{"t":"cuisine","r":"cuisine/trinidad-and-tobago-cuisine","n":"Trinidad and Tobago cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Cuisine"]],"sub":"National cuisine of Trinidad and Tobago","intro":[["Trinidad and Tobago's cuisine is influenced by Indian-South Asian, West African, Creole, European, North American, Chinese, Amerindian, Latin American, and Levantine culinary styles."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"trinidad-and-tobago-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Trinidad_and_Tobago_cuisine"}],"sections":[{"h":"Dishes","count":1,"links":[["Saheena","dish/saheena"]]},{"h":"Recipe sites","count":2,"rows":[{"name":"Cooking with Ria","color":"#55b8ad","shape":"site","sub":"cookingwithria.com","note":"Trinidadian home recipes from Ria Mathura.","url":"https://cookingwithria.com/about","suggested":true,"kind":"blog"},{"name":"Trini Gourmet","color":"#55b8ad","shape":"site","sub":"trinigourmet.com","note":"Long-running Trinidad and Tobago food blog with local recipes.","url":"https://trinigourmet.com/","suggested":true,"kind":"blog"}]},{"h":"Cookbooks","count":2,"rows":[{"name":"Sweet Hands: Island Cooking from Trinidad and Tobago","color":"#f0b340","shape":"book","sub":"Ramin Ganeshram","note":"Classic Trinidadian and Tobagonian dishes, reissued in a 20th anniversary edition.","url":"https://openlibrary.org/isbn/9780781814652","suggested":true,"isbn":"9780781814652"},{"name":"Cook-up in a Trini Kitchen","color":"#f0b340","shape":"book","sub":"John Lyons, 2009","note":"Trinidadian recipes and food memories from a Trinidad-born artist and writer, published by Peepal Tree Press.","url":"https://openlibrary.org/isbn/9781845230821","suggested":true,"isbn":"9781845230821"}]},{"h":"Key ingredients","links":[["Spinach","ingredient/spinach"],["Split pea","ingredient/split-pea"],["Taro","ingredient/taro"]],"note":"Most used across its dishes."}],"cont":"Cuisine of the Americas","img":{"src":"/labs/cuisines/img/thumb/1/19/FOOD_Saheena_1.jpg/500px-FOOD_Saheena_1.jpg","w":500,"h":650,"by":"Grueslayer","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:FOOD_Saheena_1.jpg","of":"Saheena"}},"cuisine/indian-vegetarian-cuisine":{"t":"cuisine","r":"cuisine/indian-vegetarian-cuisine","n":"Indian vegetarian cuisine","c":"#f0b340","crumb":[["Vegetarian cuisine","cuisine/vegetarian-cuisine"]],"sub":"Style of cooking in India","intro":[["India has the world's largest number of vegetarians. Vegetarianism has been present in India since antiquity although a non-vegetarian diet may be present even on the highest priest caste. Many Indians who do not regularly follow a vegetarian diet may adopt one during religious festivals."],["Also, many Indian vegetarians eschew eggs as well as meat. There are many vegetarian cuisines across India."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"indian-vegetarian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Indian_vegetarian_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Vegetarian cuisine","cuisine/vegetarian-cuisine"]]},{"h":"Part of","links":[["Vegetarian cuisine","cuisine/vegetarian-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/thumb/4/49/Vegetarian_Curry.jpeg/500px-Vegetarian_Curry.jpeg","w":500,"h":281,"by":"GracinhaMarco Abundo","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Vegetarian_Curry.jpeg"}},"dish/amba-condiment":{"t":"dish","r":"dish/amba-condiment","n":"Amba (condiment)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indian cuisine","dot":"#f0b340","intro":[["Amba or anba is a tangy condiment made with mango pickle. Created by Iraqi Jewish merchants in Bombay who purportedly shipped mangoes in vinegar back to Baghdad, Amba bears a resemblance to chutneys from South Asia. The spicy, sweet and sour sauce is typically made of pickled green mangoes, vinegar, salt, turmeric, chilies, and fenugreek. It is enjoyed in various Middle Eastern countries, particularly in Israel, as well as to a lesser extent in Europe and the United States (largely among the Iraqi, Jewish, and Assyrian diaspora)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-amba-condiment"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Amba_(condiment)"}],"sections":[{"h":"Where it's from","links":[["Indian cuisine","cuisine/indian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Mango","ingredient/mango"],["Mango pickle","ingredient/mango-pickle"]]},{"h":"Cook it","rows":[{"name":"Swasthi's Recipes","color":"#55b8ad","shape":"site","sub":"indianhealthyrecipes.com","note":"Swasthi Shreekanth's long-running blog of everyday Indian home cooking from across the regions.","url":"https://www.indianhealthyrecipes.com/about/","suggested":true,"kind":"blog"},{"name":"Hari Ghotra","color":"#55b8ad","shape":"site","sub":"harighotra.co.uk","note":"UK-based cook Hari Ghotra's recipe library and videos of home-style Indian dishes.","url":"https://www.harighotra.co.uk/indian-recipes","suggested":true,"kind":"site"}]},{"h":"More from Indian cuisine","links":[["Akuri","dish/akuri"],["Aloo paratha","dish/aloo-paratha"],["Baingan bharta","dish/baingan-bharta"],["Bombay potato","dish/bombay-potato"],["Butter chicken","dish/butter-chicken"],["Chaat masala","dish/chaat-masala"],["Chicken Chettinad","dish/chicken-chettinad"],["Dahi vada","dish/dahi-vada"],["Dal dhokli","dish/dal-dhokli"],["Dal makhani","dish/dal-makhani"],["Fafda","dish/fafda"],["Falooda","dish/falooda"],["Fish and chips","dish/fish-and-chips"],["Handvo","dish/handvo"],["Hyderabadi haleem","dish/hyderabadi-haleem"],["Idli","dish/idli"],["Indian restaurant","dish/indian-restaurant"],["Kachumber","dish/kachumber"],["Kidyo","dish/kidyo"],["Kulfi","dish/kulfi"],["Masala chai","dish/masala-chai"],["Mirchi bada","dish/mirchi-bada"],["Mokthuk","dish/mokthuk"],["Naan","dish/naan"],["Osmania biscuit","dish/osmania-biscuit"],["Panipuri","dish/panipuri"],["Pathia","dish/pathia"],["Rabri","dish/rabri"],["Shemai","dish/shemai"],["Tandoori chicken","dish/tandoori-chicken"],["Tandoori roti","dish/tandoori-roti"],["Thali","dish/thali"],["Zarda (food)","dish/zarda-food"]]}],"img":{"src":"/labs/cuisines/img/9/99/Amba.jpg","w":500,"h":388,"by":"Tatan48","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Amba.jpg"}},"dish/bika-ambon":{"t":"dish","r":"dish/bika-ambon","n":"Bika ambon","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Bika ambon or golden cake or golden kuih bingka, is an Indonesian dessert made from ingredients such as tapioca flour, eggs, sugar, yeast and coconut milk. Bika ambon is generally sold in kaffir lime or pandan flavor, but today it is also available in other flavors like banana, durian, cheese and chocolate."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-bika-ambon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bika_ambon"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":8,"links":[["Coconut","ingredient/coconut"],["Coconut milk","ingredient/coconut-milk"],["Egg","ingredient/egg"],["Fermentation starter","ingredient/fermentation-starter"],["Margarine","ingredient/margarine"],["Pandan","ingredient/pandan"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true,"kind":"blog"}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"],["Gepuk","dish/gepuk"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/43/Kue_bika_ambon.JPG/500px-Kue_bika_ambon.JPG","w":500,"h":375,"by":"Midori","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Kue_bika_ambon.JPG"}},"dish/dhikri":{"t":"dish","r":"dish/dhikri","n":"Dhikri","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Nepalese cuisine","dot":"#f0b340","intro":[["Dhikri is a Nepalese steamed rice cake primarily prepared by the Tharu people of southern Nepal. It is an essential food for the Maghi festival. It is also served in other festivals such as Dashain and Chhath."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-dhikri"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Dhikri"}],"sections":[{"h":"Where it's from","links":[["Nepalese cuisine","cuisine/nepalese-cuisine"]]},{"h":"Cook it","rows":[{"name":"The Gundruk","color":"#55b8ad","shape":"site","sub":"thegundruk.com","note":"Blog dedicated to Nepali recipes and food culture.","url":"https://thegundruk.com","suggested":true,"kind":"blog"}]},{"h":"More from Nepalese cuisine","links":[["Ghonghi","dish/ghonghi"],["Mokthuk","dish/mokthuk"],["Momo (food)","dish/momo-food"],["Sel roti","dish/sel-roti"],["Sichuan pepper","dish/sichuan-pepper"],["Sohari","dish/sohari"],["Thali","dish/thali"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a8/Dhikri_Tharu_Food.jpg/500px-Dhikri_Tharu_Food.jpg","w":500,"h":281,"by":"Janak Bhatta","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Dhikri_Tharu_Food.jpg"}},"ingredient/rosewater":{"t":"ingredient","r":"ingredient/rosewater","n":"Rosewater","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 8 cuisines","intro":[["Rose water or rosewater is a flavoured water created by steeping rose petals in water. It is typically made as a by-product during the distillation of rose petals to make rose oil for perfumes. Rose water is widely used to flavour culinary dishes and enhance cosmetic products, and it is significant in religious rituals throughout Eurasia. Iran is a major producer, supplying around 90% of the world's rose water demand."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-rosewater"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rosewater"}],"sections":[{"h":"Where it's cooked with","count":8,"groups":[["Belarusian cuisine","cuisine/belarusian-cuisine",[["Gugelhupf","dish/gugelhupf"]]],["French cuisine","cuisine/french-cuisine",[["Gugelhupf","dish/gugelhupf"]]],["German cuisine","cuisine/german-cuisine",[["Gugelhupf","dish/gugelhupf"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Gugelhupf","dish/gugelhupf"]]],["Polish cuisine","cuisine/polish-cuisine",[["Gugelhupf","dish/gugelhupf"]]],["Russian cuisine","cuisine/russian-cuisine",[["Gugelhupf","dish/gugelhupf"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Gugelhupf","dish/gugelhupf"]]],["Ukrainian cuisine","cuisine/ukrainian-cuisine",[["Gugelhupf","dish/gugelhupf"]]]]},{"h":"Often cooked with","links":[["Almond","ingredient/almond"],["Raisin","ingredient/raisin"],["Wheat flour","ingredient/wheat-flour"],["Yeast","ingredient/yeast"]]}]},"dish/palapa-condiment":{"t":"dish","r":"dish/palapa-condiment","n":"Palapa (condiment)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#f0b340","intro":[["Palapa is a sweet and spicy Filipino condiment made from thinly chopped white scallions (sakurab), pounded ginger (luya pagirison), turmeric (kalawag), labuyo chili (luya tiduk), and toasted grated coconut (niog). It originates from the Maranao people of Lanao del Sur. The ingredients are mixed together and cooked briefly or cooked until slightly dry. It is stored immediately in sealed jars (garapon) after cooking. Palapa can be used as an ingredient in certain dishes, most notably in piaparan, or as a condiment after briefly sautéing, often with a spoonful of condensed milk. It can also be eaten fresh as salad dressing. Palapa is an important cultural symbol of the Maranao people and is a common accompaniment at every meal."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-palapa-condiment"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Palapa_(condiment)"}],"sections":[{"h":"Where it's from","links":[["Filipino cuisine","cuisine/filipino-cuisine"],["Mindanao cuisine","cuisine/filipino-cuisine-mindanao"],["Visayan cuisine","cuisine/filipino-cuisine-visayas"]]},{"h":"Ingredients","count":1,"links":[["Sakurab","ingredient/sakurab"]]},{"h":"Cook it","rows":[{"name":"Panlasang Pinoy","color":"#55b8ad","shape":"site","sub":"panlasangpinoy.com","note":"Vanjo Merano's large library of Filipino recipes and cooking videos.","url":"https://panlasangpinoy.com/filipino-food/","suggested":true,"kind":"blog"},{"name":"Kawaling Pinoy","color":"#55b8ad","shape":"site","sub":"kawalingpinoy.com","note":"Lalaine Manalo's blog of Filipino home cooking.","url":"https://www.kawalingpinoy.com/about/","suggested":true,"kind":"blog"},{"name":"Flavours of Iloilo","color":"#55b8ad","shape":"site","sub":"flavoursofiloilo.blogspot.com","note":"Blog of Ilonggo home dishes from Iloilo in the Western Visayas.","url":"https://flavoursofiloilo.blogspot.com/2013/05/how-about-some-chicken-binakol.html","suggested":true,"kind":"blog"}]},{"h":"More from Filipino cuisine","links":[["Adobo (Filipino dish)","dish/adobo-filipino-dish"],["Aparon","dish/aparon"],["Banana ketchup","dish/banana-ketchup"],["Champorado","dish/champorado"],["Filipino barbecue","dish/filipino-barbecue"],["Food for the gods","dish/food-for-the-gods"],["Isaw","dish/isaw"],["Kadyos, baboy, kag langka","dish/kadyos-baboy-kag-langka"],["Kadyos, manok, kag ubad","dish/kadyos-manok-kag-ubad"],["Kumukunsi","dish/kumukunsi"],["Mango float","dish/mango-float"],["Pastil","dish/pastil"],["Piaparan","dish/piaparan"],["Pilipit","dish/pilipit"],["Piyanggang manok","dish/piyanggang-manok"],["Sushi bake","dish/sushi-bake"],["Tortang talong","dish/tortang-talong"]]}],"img":{"src":"/labs/cuisines/img/thumb/6/6d/Palapa_%28Philippines%29.jpg/500px-Palapa_%28Philippines%29.jpg","w":500,"h":358,"by":"Obsidian Soul","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Palapa_(Philippines).jpg"}},"ingredient/chile-pepper":{"t":"ingredient","r":"ingredient/chile-pepper","n":"Chile pepper","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Chili peppers, also spelled chile or chilli, are varieties of berry-fruit plants from the genus Capsicum, which are members of the nightshade family Solanaceae, cultivated for their pungency (spicy heat). They are used as a spice to add pungency in many cuisines. Capsaicin and the related capsaicinoids give chili peppers their intensity when ingested or applied topically. Chili peppers exhibit a range of heat and flavors. This diversity is the reason behind the availability of different types of chili powder, each offering its own taste and heat level."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-chile-pepper"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chile_pepper"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Mexican cuisine","cuisine/mexican-cuisine",[["Pozole","dish/pozole"]]]]},{"h":"Often cooked with","links":[["Chicken","ingredient/chicken"],["Hominy","ingredient/hominy"],["Pork","ingredient/pork"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/50/Madame_Jeanette_and_other_chillies.jpg/500px-Madame_Jeanette_and_other_chillies.jpg","w":500,"h":400,"by":"Takeaway","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Madame_Jeanette_and_other_chillies.jpg"}},"dish/tahu-campur":{"t":"dish","r":"dish/tahu-campur","n":"Tahu campur","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Tahu campur, literally meaning \"mixed tofu\" in Javanese language and broader Indonesian language, is an East Javanese tofu dish. The dish consists of sliced tahu goreng (fried tofu), lontong (rice cakes), lentho (fried black-eyed pea patty) or sometimes replaced by perkedel (potato or cassava patty cakes), fresh bean sprouts, fresh lettuce, yellow noodles, and krupuk crackers, served in savoury beef stew, garnished with fried onions, and sambal chili sauce. The beef stew soup is seasoned with spices and petis, a type of shrimp paste commonly used in East Javanese cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-tahu-campur"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tahu_campur"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":9,"links":[["Beef","ingredient/beef"],["Caraway","ingredient/caraway"],["Lemongrass","ingredient/lemongrass"],["Lontong","ingredient/lontong"],["Mung bean sprout","ingredient/mung-bean-sprout"],["Noodles","ingredient/noodles"],["Sugar","ingredient/sugar"],["Tofu","ingredient/tofu"],["Turmeric","ingredient/turmeric"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true,"kind":"blog"}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/7b/Tahu_Campur.jpg/500px-Tahu_Campur.jpg","w":500,"h":375,"by":"Veriyanta Kusuma","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Tahu_Campur.jpg"}},"ingredient/squid":{"t":"ingredient","r":"ingredient/squid","n":"Squid","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A squid is a mollusc with an elongated soft body, large eyes, eight arms, and two tentacles in the orders Myopsida, Oegopsida, and Bathyteuthida (though many other molluscs within the broader Neocoleoidea are also called squid despite not strictly fitting these criteria). Like all other cephalopods, squid have a distinct head, bilateral symmetry, and a mantle. They are mainly soft-bodied, like octopuses, but have a small internal skeleton in the form of a rod-like gladius or pen, made of chitin."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-squid"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Squid"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Japanese cuisine","cuisine/japanese-cuisine",[["Tempura","dish/tempura"]]]]},{"h":"Often cooked with","links":[["Bivalvia","ingredient/bivalvia"],["Egg","ingredient/egg"],["Flammulina filiformis","ingredient/flammulina-filiformis"],["Shiitake","ingredient/shiitake"],["Shrimp","ingredient/shrimp"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e1/Sepioteuthis_sepioidea_%28Caribbean_Reef_Squid%29.jpg/500px-Sepioteuthis_sepioidea_%28Caribbean_Reef_Squid%29.jpg","w":500,"h":375,"by":"Nhobgood Nick Hobgood","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Sepioteuthis_sepioidea_(Caribbean_Reef_Squid).jpg"}},"ingredient/napa-cabbage":{"t":"ingredient","r":"ingredient/napa-cabbage","n":"Napa cabbage","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Napa cabbage (Brassica rapa subsp. pekinensis, or Brassica rapa Pekinensis Group) is a type of Chinese cabbage originating near the Beijing region of China that is widely used in East Asian cuisine. Since the 20th century, it has also become a widespread crop in Europe, the Americas, and Australia. In much of the world, it is referred to as \"Chinese cabbage\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-napa-cabbage"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Napa_cabbage"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Chinese cuisine","cuisine/chinese-cuisine",[["Xiaolongbao","dish/xiaolongbao"]]],["Taiwan cuisine","cuisine/taiwan-cuisine",[["Xiaolongbao","dish/xiaolongbao"]]]]},{"h":"Where it's grown","grown":{"what":"Cabbages","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":74999436,"top":[["China","cuisine/chinese-cuisine",36131058],["India","cuisine/indian-cuisine",9827541],["Russia","cuisine/russian-cuisine",2448353],["South Korea","cuisine/korean-cuisine",2433494],["Ukraine","cuisine/ukrainian-cuisine",1632598],["Japan","cuisine/japanese-cuisine",1444853],["Indonesia","cuisine/indonesian-cuisine",1440078],["Ethiopia","cuisine/ethiopian-cuisine",1208135],["Vietnam","cuisine/vietnamese-cuisine",1138065],["Kenya","cuisine/kenyan-cuisine",1066829],["United States of America","cuisine/american-cui