/lutefisk":{"t":"dish","r":"dish/lutefisk","n":"Lutefisk","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Lutefisk is dried whitefish, usually cod, but sometimes ling or burbot, cured in lye. It is made from aged stockfish (air-dried whitefish), or dried and salted cod. The fish takes a gelatinous texture after being rehydrated for days prior to eating."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-lutefisk"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lutefisk"}],"sections":[{"h":"Where it's from","links":[["Norwegian cuisine","cuisine/norwegian-cuisine"],["Swedish cuisine","cuisine/swedish-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Atlantic cod","ingredient/atlantic-cod"],["Sodium hydroxide","ingredient/sodium-hydroxide"]]},{"h":"Cook it","rows":[{"name":"Scandicuisine: Swedish recipes","ref":"site/scandicuisine-com","color":"#55b8ad","shape":"site","sub":"scandicuisine.com","note":"Traditional Swedish recipes from Cecilia, a cook from a Finnish-Swedish family on Åland.","url":"https://scandicuisine.com/category/swedish-recipes","suggested":true,"kind":"blog"}]},{"h":"More from Norwegian cuisine","links":[["Fish and chips","dish/fish-and-chips"],["Fruktsoppa","dish/fruktsoppa"],["Glögg","dish/glogg"],["Kransekage","dish/kransekage"],["Labskaus","dish/labskaus"],["Risalamande","dish/risalamande"],["Trollkrem","dish/trollkrem"]]}]},"ingredient/fermented-soybean-paste":{"t":"ingredient","r":"ingredient/fermented-soybean-paste","n":"Fermented soybean paste","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Fermented bean paste is a category of fermented foods typically made from ground soybeans, which are indigenous to the cuisines of East, South and Southeast Asia. In some cases, such as the production of miso, other varieties of beans, such as broad beans, may also be used."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-fermented-soybean-paste"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fermented_soybean_paste"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Koryo-saram cuisine","cuisine/koryo-saram-cuisine",[["Pukjai","dish/pukjai"]]]]},{"h":"Often cooked with","links":[["Doenjang","ingredient/doenjang"],["Fermented bean paste","ingredient/fermented-bean-paste"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/ee/Doenjangwithbeans.jpg/500px-Doenjangwithbeans.jpg","w":500,"h":375,"by":"Badagnani","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Doenjangwithbeans.jpg"}},"dish/sauce-ravigote":{"t":"dish","r":"dish/sauce-ravigote","n":"Sauce ravigote","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Sauce ravigote is a classic, lightly acidic sauce in French cuisine, which may be prepared either warm or cold. The warm sauce is classically based on a vegetable or meat broth, or a velouté, with herbs. Current recipes often add Dijon mustard. The cold sauce is based on a vinaigrette."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-sauce-ravigote"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sauce_ravigote"}],"sections":[{"h":"Where it's from","links":[["French cuisine","cuisine/french-cuisine"],["New Caledonian cuisine","cuisine/new-caledonian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Pardon Your French","ref":"site/pardonyourfrench-com","color":"#55b8ad","shape":"site","sub":"pardonyourfrench.com","note":"Audrey Le Goff, a French cook, shares classic and regional French home recipes.","url":"https://pardonyourfrench.com","suggested":true,"kind":"blog"},{"name":"La Cuisine de Géraldine","ref":"site/lacuisinedegeraldine-fr","color":"#55b8ad","shape":"site","sub":"lacuisinedegeraldine.fr","note":"French home cooking blog by Géraldine Leverd, also author of The New French Kitchen.","url":"https://lac