[["Roux () is a mixture of flour and fat cooked together and used to thicken sauces. Roux is typically made from equal parts of flour and fat by weight. The flour is added to the melted fat or oil on the stove top, blended until smooth, and cooked to the desired level of brownness. A roux can be white, blond (darker), or brown. Butter, bacon drippings, or lard are commonly used fats. Roux is used as a thickening agent for gravy, sauces, soups, and stews. It provides the base for a dish, and other ingredients are added after the roux is complete."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-roux"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Roux"}],"sections":[{"h":"Where it's cooked with","count":5,"groups":[["French cuisine","cuisine/french-cuisine",[["Espagnole sauce","dish/espagnole-sauce"],["Velouté sauce","dish/veloute-sauce"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Espagnole sauce","dish/espagnole-sauce"],["Velouté sauce","dish/veloute-sauce"]]],["American cuisine","cuisine/american-cuisine",[["Gumbo","dish/gumbo"]]],["Cajun cuisine","cuisine/cajun-cuisine",[["Gumbo","dish/gumbo"]]],["Yoshoku","cuisine/yoshoku",[["Cream stew","dish/cream-stew"]]]]},{"h":"Often cooked with","links":[["Onion","ingredient/onion"],["Broth","ingredient/broth"],["Cabbage","ingredient/cabbage"],["Carrot","ingredient/carrot"],["Chicken","ingredient/chicken"],["Pork","ingredient/pork"],["Potato","ingredient/potato"],["Bell pepper","ingredient/bell-pepper"],["Brachyura","ingredient/brachyura"],["Celery","ingredient/celery"],["Chili pepper","ingredient/chili-pepper"],["Filé powder","ingredient/file-powder"],["Okra","ingredient/okra"],["Ostreidae","ingredient/ostreidae"],["Shrimp","ingredient/shrimp"],["Tomato","ingredient/tomato"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a1/Roux%21.jpg/500px-Roux%21.jpg","w":500,"h":667,"by":"Megs","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Roux!.jpg"}},"ingredient/almond-flour":{"t":"ingredient","r":"ingredient/almond-flour","n":"Almond flour","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 3 cuisines","intro":[["Almond meal, almond flour or ground almond is made from ground sweet almonds. Almond flour is usually made with blanched almonds (no skin), whereas almond meal can be made with whole or blanched almonds. The consistency is more like corn meal than wheat flour."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-almond-flour"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Almond_flour"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Basque cuisine","cuisine/basque-cuisine",[["Gâteau Basque","dish/gateau-basque"]]],["French cuisine","cuisine/french-cuisine",[["Gâteau Basque","dish/gateau-basque"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Gâteau Basque","dish/gateau-basque"]]]]},{"h":"Often cooked with","links":[["Almond meal","ingredient/almond-meal"],["Butter","ingredient/butter"],["Egg","ingredient/egg"],["Fruit preserves","ingredient/fruit-preserves"],["Pastry cream","ingredient/pastry-cream"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/11/Almond_meal_by_hand.jpg/500px-Almond_meal_by_hand.jpg","w":500,"h":375,"by":"Yun Huang Yong","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Almond_meal_by_hand.jpg"}},"ingredient/phaseolus":{"t":"ingredient","r":"ingredient/phaseolus","n":"Phaseolus","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 2 cuisines","intro":[["Phaseolus (bean, wild bean) is a genus of herbaceous to woody annual and perennial vines in the family Fabaceae containing about 70 plant species, all native to the Americas, primarily Mesoamerica."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-phaseolus"},{"kind":"wiki","ur