{"cuisine/mozambican-cuisine":{"t":"cuisine","r":"cuisine/mozambican-cuisine","n":"Mozambican cuisine","c":"#e46a3f","crumb":[["Africa","cuisines#africa"],["Cuisine"]],"sub":"National cuisine of Mozambique","intro":[["The cuisine of Mozambique represents a mixture of indigenous foods and cooking practices, coupled with outside influences from Indian Ocean trade and Portuguese colonization."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"mozambican-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mozambican_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]}],"cont":"African cuisine"},"dish/brunswick-stew":{"t":"dish","r":"dish/brunswick-stew","n":"Brunswick stew","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["Brunswick stew is a tomato-based stew generally involving local beans, vegetables, and originally small game meat such as squirrel or rabbit, though today often chicken. The exact origin of the stew is disputed. The states of Virginia and Georgia both claim its birth, with Brunswick County in Virginia and the city of Brunswick in Georgia claiming it was developed there. It may have originated earlier in some form in the city of Braunschweig (Brunswick) in the  Duchy of Brunswick-Lüneburg in today's northern Germany."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-brunswick-stew"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Brunswick_stew"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Bean","ingredient/bean"],["Game meat","ingredient/game-meat"],["Maize","ingredient/maize"],["Tomato","ingredient/tomato"]]},{"h":"More from American cuisine","links":[["Angel food cake","dish/angel-food-cake"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Beer cake","dish/beer-cake"],["Better tha