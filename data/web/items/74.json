onia-travel","color":"#55b8ad","shape":"site","sub":"newcaledonia.travel","note":"Official tourism board overview of Kanak food, including bougna cooked in an earth oven.","url":"https://www.newcaledonia.travel/nz/gastronomy-wine/gastronomy/kanak-cooking","suggested":true,"kind":"site"}]},{"h":"More from French cuisine","links":[["'t Fornuis","dish/t-fornuis"],["'t Misverstant","dish/t-misverstant"],["'t Vlasbloemeken","dish/t-vlasbloemeken"],["&moshik","dish/moshik"],["Aan de Poel","dish/aan-de-poel"],["Adrian (restaurant)","dish/adrian-restaurant"],["Adventureland Bazaar","dish/adventureland-bazaar"],["Alain Ducasse at The Dorchester","dish/alain-ducasse-at-the-dorchester"],["Albufera sauce","dish/albufera-sauce"],["Alex (restaurant)","dish/alex-restaurant"],["Andouillette","dish/andouillette"],["Arpège (restaurant)","dish/arpege-restaurant"],["Aspic","dish/aspic"],["Atelier Crenn","dish/atelier-crenn"],["Au Coin des Bons Enfants","dish/au-coin-des-bons-enfants"],["Au Crocodile","dish/au-crocodile"],["Au Pied de Cochon (Mexico City)","dish/au-pied-de-cochon-mexico-city"],["Auberge (restaurant)","dish/auberge-restaurant"],["Auberge De Kieviet","dish/auberge-de-kieviet"],["Aubergine (London restaurant)","dish/aubergine-london-restaurant"],["Auguste (restaurant)","dish/auguste-restaurant"],["Bagatelle (restaurant)","dish/bagatelle-restaurant"],["Balthazar (restaurant)","dish/balthazar-restaurant"],["Bardot Brasserie","dish/bardot-brasserie"],["Bâtard (restaurant)","dish/batard-restaurant"],["Baumé (restaurant)","dish/baume-restaurant"],["Bayonne ham","dish/bayonne-ham"],["Be Our Guest Restaurant","dish/be-our-guest-restaurant"],["Beaulieu, Doorwerth Castle","dish/beaulieu-doorwerth-castle"],["Beef Stroganoff","dish/beef-stroganoff"],["Bell's (restaurant)","dish/bell-s-restaurant"],["Belmond Le Manoir aux Quat'Saisons","dish/belmond-le-manoir-aux-quat-saisons"],["Beluga (restaurant)","dish/beluga-restaurant"],["Berowra Waters Inn","dish/berowra-waters-inn"],["Beurre maître d'hôtel","dish/beurre-maitre-d-hotel"],["Beurre manié","dish/beurre-manie"],["Bisque (food)","dish/bisque-food"],["Bistro 990","dish/bistro-990"],["Bistro Agnes","dish/bistro-agnes"],["Bistro Jeanty","dish/bistro-jeanty"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/ed/Sauce_Spagnole-09.JPG/500px-Sauce_Spagnole-09.JPG","w":500,"h":373,"by":"Tamorlan","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Sauce_Spagnole-09.JPG"}},"dish/esparza-s":{"t":"dish","r":"dish/esparza-s","n":"Esparza's","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Tex-Mex cuisine","dot":"#94bd5c","intro":[["Esparza's Tex Mex Cafe, or simply Esparza's, was a Tex-Mex restaurant in Portland, Oregon, in the United States. Opened by Martha and Joe Esparza in 1990, the restaurant operated for more than 24 years before closing in January 2014. Its unusual menu included buffalo tostadas, ground ostrich and nopalitos, several varieties of tongue, beef brisket, and more traditional options such as enchiladas, quesadillas, tacos and tamales. Esparza's was one of Portland's most popular restaurants during the 1990s and was named \"Restaurant of the Year\" by The Oregonian in 1992."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-esparza-s"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Esparza's"}],"sections":[{"h":"Where it's from","links":[["Tex-Mex cuisine","cuisine/tex-mex-cuisine"]]},{"h":"Cook it","rows":[{"name":"Homesick Texan","ref":"site/homesicktexan-com","color":"#55b8ad","shape":"site","sub":"homesicktexan.com","note":"Lisa Fain's long-running blog of Texan and Tex-Mex home cooking.","url":"https://www.homesicktexan.com/homesick-texan-cookbook-introduction/comment-page-20/","suggested":true,"kind":"blog"}]},{"h":"More from Tex-Mex cuisine","links":[["Baja Fresh","dish/baja-fresh"],["Chapultepec Lupita","dish/chapultepec-lupita"],["Chile con queso","dish/chile-con-queso"],["Chili con carne","dish/chili-con-carne"],["Chipotle Mexican Grill","dish/chipotle-mexican-grill"],["Chuy's","dish/chuy-s"],["Guacamole","dish/guacamole"],["La Bamba Mexican Restaurant","dish/la-bamba-mexican-restaurant"],["Pancho Villa (restaurant)","dish/pancho-villa-restaurant"],["Salsarita's Fresh Mexican Grill","dish/salsarita-s-fresh-mexican-grill"],["The Goose (restaurant)","dish/the-goose-restaurant"],["Tia's Tex-Mex","dish/tia-s-tex-mex"],["Tortilla Coast","dish/tortilla-coast"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/58/Esparza%27s_-_Portland%2C_Oregon_%282008%29.jpg/500px-Esparza%27s_-_Portland%2C_Oregon_%282008%29.jpg","w":500,"h":375,"by":"eyeliam","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Esparza's_-_Portland%2C_Oregon_(2008).jpg"}},"dish/fig-restaurant":{"t":"dish","r":"dish/fig-restaurant","n":"Fig (restaurant)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Southern American cuisine","dot":"#94bd5c","intro":[["Fig, stylized as FIG, is a modern American restaurant located in Charleston, South Carolina. The name is an acronym for \"Food Is Good.\" Established in April 2003 by Mike Lata and partner Adam Nemirow, the restaurant is situated in downtown Charleston. Fig is known for its Southern classics, featuring seasonal ingredients served in a bistro setting."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-fig-restaurant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fig_(restaurant)"}],"sections":[{"h":"Where it's from","links":[["Southern American cuisine","cuisine/cuisine-of-the-southern-united-states"]]},{"h":"Cook it","rows":[{"name":"Lana's Cooking","ref":"site/lanascooking-com","color":"#55b8ad","shape":"site","sub":"lanascooking.com","note":"Lana Stuart's blog of Southern home cooking from Georgia.","url":"https://www.lanascooking.com/about/","suggested":true,"kind":"blog"},{"name":"A Southern Soul: Southern Classics","ref":"site/asouthernsoul-com","color":"#55b8ad","shape":"site","sub":"asouthernsoul.com","note":"Collection of classic Southern recipes on a Southern home cooking blog.","url":"https://asouthernsoul.com/recipes/southern-classics","suggested":true,"kind":"blog"}]},{"h":"More from Southern American cuisine","links":[["Ambrosia (fruit salad)","dish/ambrosia-fruit-salad"],["Barbecue bologna","dish/barbecue-bologna"],["Chess pie","dish/chess-pie"],["Chicken Maryland","dish/chicken-maryland"],["Chitlins","dish/chitlins"],["Conecuh Sausage","dish/conecuh-sausage"],["Grape hull pie","dish/grape-hull-pie"],["Hash (stew)","dish/hash-stew"],["Lambert's Cafe","dish/lambert-s-cafe"],["Lem's Bar-B-Q","dish/lem-s-bar-b-q"],["Lemon pepper wings","dish/lemon-pepper-wings"],["Mississippi mud pie","dish/mississippi-mud-pie"],["Monroe Sausage","dish/monroe-sausage"],["Moon Pie","dish/moon-pie"],["Paschal's","dish/paschal-s"],["Screen Door (restaurant)","dish/screen-door-restaurant"],["The Grey (restaurant)","dish/the-grey-restaurant"],["Yardbird Table & Bar","dish/yardbird-table-bar"]]}]},"ingredient/gravy":{"t":"ingredient","r":"ingredient/gravy","n":"Gravy","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Gravy is a sauce made from the juices of meats and vegetables that run naturally during cooking and often thickened with thickeners for added texture. The gravy may be further coloured and flavoured with gravy salt (a mix of salt and caramel food colouring), gravy browning (gravy salt dissolved in water), or bouillon cubes. Powders can be used as a substitute for natural meat or vegetable extracts. Canned and instant gravies are also available. Gravy is commonly served with roasts, meatloaf, sandwiches, rice, noodles, fries (chips), mashed potatoes, or biscuits (North America; see biscuits and gravy)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-gravy"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Gravy"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Minnesotan cuisine","cuisine/minnesotan-cuisine",[["Hot beef commercial","dish/hot-beef-commercial"]]],["Swiss cuisine","cuisine/swiss-cuisine",[["Zürcher Geschnetzeltes","dish/zurcher-geschnetzeltes"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Mashed potato","ingredient/mashed-potato"],["Pot roast","ingredient/pot-roast"],["White bread","ingredient/white-bread"],["Rösti","ingredient/rosti"],["Veal","ingredient/veal"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/88/Wine_sauces_on_the_sauceboat.jpg/500px-Wine_sauces_on_the_sauceboat.jpg","w":500,"h":375,"by":"Peachyeung316","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Wine_sauces_on_the_sauceboat.jpg"}},"ingredient/sweet-bean-sauce":{"t":"ingredient","r":"ingredient/sweet-bean-sauce","n":"Sweet bean sauce","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Tianmian sauce, also known as sweet bean sauce, sweet flour sauce or sweet wheat paste, is a thick, smooth, dark brown or black paste with either a mild, savory or sweet flavor. It is commonly used in Northern Chinese cuisine, Northeastern Chinese cuisine, and Korean-Chinese cuisine. Peking duck and jajangmyeon are two popular dishes that feature the sauce."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sweet-bean-sauce"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sweet_bean_sauce"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Korean Chinese cuisine","cuisine/korean-chinese-cuisine",[["Jjajangmyeon","dish/jjajangmyeon"]]]]},{"h":"Often cooked with","links":[["Cumian","ingredient/cumian"],["Noodles","ingredient/noodles"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/54/Sweetnoodlesauce.jpg/500px-Sweetnoodlesauce.jpg","w":500,"h":375,"by":"Unknown author","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Sweetnoodlesauce.jpg"}},"dish/koji-food":{"t":"dish","r":"dish/koji-food","n":"Kōji (food)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Kōji is a filamentous fungus, most commonly Aspergillus oryzae, which is traditionally used in Japanese cuisine for the fermentation of food, or a mixture of such a culture with wheat and soybean meal. The latter can be fried and eaten directly or processed to a sauce."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-koji-food"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/K%C5%8Dji_(food)"}],"sections":[{"h":"Where it's from","links":[["Japanese cuisine","cuisine/japanese-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Aspergillus luchuensis","ingredient/aspergillus-luchuensis"],["Aspergillus niger","ingredient/aspergillus-niger"],["Aspergillus oryzae","ingredient/aspergillus-oryzae"],["Aspergillus sojae","ingredient/aspergillus-sojae"],["Aspergillus tamarii","ingredient/aspergillus-tamarii"],["Aspergillus tubingensis","ingredient/aspergillus-tubingensis"]]},{"h":"Cook it","rows":[{"name":"Just One Cookbook","ref":"site/justonecookbook-com","color":"#55b8ad","shape":"site","sub":"justonecookbook.com","note":"Namiko Chen's long-running blog and videos on Japanese home cooking.","url":"https://justonecookbook.com","suggested":true,"kind":"blog"},{"name":"RecipeTin Japan","ref":"site/japan-recipetineats-com","color":"#55b8ad","shape":"site","sub":"japan.recipetineats.com","note":"Japanese home recipes from Yumiko, a Japan-born cook, sister site to RecipeTin Eats.","url":"https://japan.recipetineats.com/","suggested":true,"kind":"blog"}]},{"h":"More from Japanese cuisine","links":[["Benihana","dish/benihana"],["Bergh–Stoutenburgh House","dish/bergh-stoutenburgh-house"],["Bincho","dish/bincho"],["Boxer Ramen","dish/boxer-ramen"],["Cagen","dish/cagen"],["Chikuwa","dish/chikuwa"]