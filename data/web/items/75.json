,"ingredient/bivalvia"],["Flammulina filiformis","ingredient/flammulina-filiformis"],["Squid","ingredient/squid"],["Agaricus bisporus","ingredient/agaricus-bisporus"],["Broth","ingredient/broth"],["Carrot","ingredient/carrot"],["Cornstarch","ingredient/cornstarch"]]}],"img":{"src":"/world-cuisine/img/thumb/6/64/Shiitakegrowing.jpg/500px-Shiitakegrowing.jpg","w":500,"h":667,"by":"frankenstoen from Portland, Oregon","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Shiitakegrowing.jpg"}},"dish/cocido-montanes":{"t":"dish","r":"dish/cocido-montanes","n":"Cocido montañés","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Cantabrian cuisine","dot":"#cf5f87","intro":[["Cocido montañés (translated as 'Mountain stew' or 'Cantabrian stew', depending on context) is a rich hearty Spanish bean stew, originally from and most commonly found in Cantabria in northern Spain."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-cocido-montanes"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cocido_monta%C3%B1%C3%A9s"}],"sections":[{"h":"Where it's from","links":[["Cantabrian cuisine","cuisine/cantabrian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Collard greens","ingredient/collard-greens"],["Common bean","ingredient/common-bean"],["Pork","ingredient/pork"]]},{"h":"More from Cantabrian cuisine","links":[["Tuna pot","dish/tuna-pot"]]}],"img":{"src":"/world-cuisine/img/thumb/f/f7/Highlander_stew.jpg/500px-Highlander_stew.jpg","w":500,"h":500,"by":"Jorge Sanz","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Highlander_stew.jpg"}},"dish/dulce-de-batata":{"t":"dish","r":"dish/dulce-de-batata","n":"Dulce de batata","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#94bd5c","intro":[["Dulce de batata is a traditional South American jellied dessert. Depending on the locality, it is known by a variety of names, including dulce de boniatos and, in Brazil, marrom glacê (Portuguese: candied chestnut) or doce de batata doce. Dulce de batata is consumed across many nations of the Southern Cone; it can be served plain, eaten with cheese, or combined with less traditional ingredients such as chocolate."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-dulce-de-batata"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Dulce_de_batata"}],"sections":[{"h":"Where it's from","links":[["Argentine cuisine","cuisine/argentine-cuisine"],["Paraguayan cuisine","cuisine/paraguayan-cuisine"],["Uruguayan cuisine","cuisine/uruguayan-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Sweet potato","ingredient/sweet-potato"]]},{"h":"Cook it","rows":[{"name":"Familia Kitchen: Argentina","color":"#55b8ad","shape":"site","sub":"familiakitchen.com","note":"Argentine recipes and stories on a Latino family cooking site.","url":"https://familiakitchen.com/destination/argentina/","suggested":true,"kind":"site"},{"name":"Camila Made: Top 15 Paraguayan Recipes","color":"#55b8ad","shape":"site","sub":"camilamade.com","note":"Paraguayan recipe roundup on a Latin American home cooking blog.","url":"https://camilamade.com/top-15-paraguayan-recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Argentine cuisine","links":[["Anticucho","dish/anticucho"],["Argentine pizza","dish/argentine-pizza"],["Asado","dish/asado"],["Bara brith","dish/bara-brith"],["Bondiola sandwich","dish/bondiola-sandwich"],["Cabbage roll","dish/cabbage-roll"],["Fugazza","dish/fugazza"],["Jesuita (sandwich)","dish/jesuita-sandwich"],["Jésuite","dish/jesuite"],["Matambre","dish/matambre"],["Puchero","dish/puchero"],["Rogel (cake)","dish/rogel-cake"],["Salsa golf","dish/salsa-golf"]]}],"img":{"src":"/world-cuisine/img/thumb/d/d4/Dulce_de_batata1.JPG/500px-Dulce_de_batata1.JPG","w":500,"h":375,"by":"Gveret Tered","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Dulce_de_batata1.JPG"}},"ingredient/clov":{"t":"ingredient","r":"ingredient/clov","n":"Clov","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Endgame is an absurdist, tragicomic one-act play by the Irish playwright Samuel Beckett. First performed in London in 1957, it is about a blind, paralysed, domineering elderly man, his geriatric parents, and his servile companion in an abandoned house in a fictional post-apocalyptic wasteland, all of whom await an unspecified \"end\". Much of the play's content consists of terse, back and forth dialogue between the characters reminiscent of bantering, along with trivial stage actions. The plot is also supplanted by the development of a grotesque story-within-a-story that the character Hamm is relating. The play's title refers to chess and frames the characters as acting out a losing battle with each other or their fate."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-clov"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Clov"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Albanian cuisine","cuisine/cuisine-of-albania",[["Kabuni","dish/kabuni"]]]]},{"h":"Often cooked with","links":[["Butter","ingredient/butter"],["Cinnamon","ingredient/cinnamon"],["Raisin","ingredient/raisin"],["Rice","ingredient/rice"],["Sugar","ingredient/sugar"]]}],"img":{"src":"/world-cuisine/img/thumb/d/de/Endspiel_%28Berlin%29.jpg/500px-Endspiel_%28Berlin%29.jpg","w":500,"h":334,"by":"Francisco Peralta Torrejón","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Endspiel_(Berlin).jpg"}},"dish/mandu-gwa":{"t":"dish","r":"dish/mandu-gwa","n":"Mandu-gwa","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Korean cuisine","dot":"#f0b340","intro":[["Mandu-gwa is a Korean sweet dumpling filled with sweetened ingredients and coated with jocheong (rice syrup). It is a type of yumil-gwa, a deep-fried hangwa (Korean confection) made with wheat flour. Mandu means \"dumplings\" and gwa means \"confection\". Mandu-gwa is typically eaten as a dessert or bamcham (late-night snack)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-mandu-gwa"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mandu-gwa"}],"sections":[{"h":"Where it's from","links":[["Korean cuisine","cuisine/korean-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Cinnamomum cassia","ingredient/cinnamomum-cassia"],["Honey","ingredient/honey"],["Jujube","ingredient/jujube"]]},{"h":"Cook it","rows":[{"name":"Maangchi","color":"#55b8ad","shape":"site","sub":"maangchi.com","note":"Maangchi's Korean recipe site and YouTube channel, one of the best known English sources for Korean cooking.","url":"https://www.maangchi.com/","suggested":true,"kind":"youtube"},{"name":"Korean Bapsang","color":"#55b8ad","shape":"site","sub":"koreanbapsang.com","note":"Home-style Korean recipes from Hyosun, a Korean-American mom.","url":"https://www.koreanbapsang.com/category/recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Korean cuisine","links":[["Bap (rice dish)","dish/bap-rice-dish"],["Bibim-guksu","dish/bibim-guksu"],["Bibimbap","dish/bibimbap"],["Bosintang","dish/bosintang"],["Cheonggukjang","dish/cheonggukjang"],["Doenjang","dish/doenjang"],["Garak-guksu","dish/garak-guksu"],["Gochujang","dish/gochujang"],["Gopchang","dish/gopchang"],["Hwajeon","dish/hwajeon"],["Jijimi","dish/jijimi"],["Jokbal","dish/jokbal"],["Korean restaurant","dish/korean-restaurant"],["Maekjeok","dish/maekjeok"],["Maeun-tang","dish/maeun-tang"],["Makchang","dish/makchang"],["Mandu-guk","dish/mandu-guk"],["Meat jun","dish/meat-jun"],["Meju","dish/meju"],["Morkovcha","dish/morkovcha"],["Scorched rice","dish/scorched-rice"],["Seon (food)","dish/seon-food"],["Sungnyung","dish/sungnyung"],["Tteokbokki","dish/tteokbokki"],["Wakame","dish/wakame"],["Yakgwa","dish/yakgwa"],["Yukpo","dish/yukpo"]]}]},"ingredient/daikon":{"t":"ingredient","r":"ingredient/daikon","n":"Daikon","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Daikon or mooli (Raphanus sativus var. longipinnatus) is a mild-flavored winter radish usually characterized by fast-growing leaves and a long, white, napiform root. Native to continental East Asia, daikon and its cultivars are now harvested and consumed globally. In some locations, daikon is left unharvested to loosen compacted soils and recover nutrients."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-daikon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Daikon"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Cantonese cuisine","cuisine/cantonese-cuisine",[["Turnip cake","dish/turnip-cake"]]],["Japanese cuisine","cuisine/japanese-cuisine",[["Oden","dish/oden"]]]]},{"h":"Often cooked with","links":[["Broth","ingredient/broth"],["Dashi","ingredient/dashi"],["Egg","ingredient/egg"],["Fishcake","ingredient/fishcake"],["Konjac","ingredient/konjac"],["Soy sauce","ingredient/soy-sauce"],["Daikon radish","ingredient/daikon-radish"],["Rice flour","ingredient/rice-flour"]]}],"img":{"src":"/world-cuisine/img/thumb/2/23/Different_kinds_of_White_Radish.png/500px-Different_kinds_of_White_Radish.png","w":500,"h":375,"by":"KimYunmi","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Different_kinds_of_White_Radish.png"}},"dish/piadina-romagnola":{"t":"dish","r":"dish/piadina-romagnola","n":"Piadina romagnola","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["Piadina romagnola or simply piadina, traditionally piada (pronounced [ˈpjaːda]; Romagnol: pièda), is a thin Italian flatbread, typically prepared in the Romagna historical region (which mostly consists of the Italian provinces of Forlì-Cesena, Ravenna, and Rimini, and the Republic of San Marino). It is usually made with white flour, lard or olive oil, salt, and water. The dough was traditionally cooked on a terracotta dish (locally called teggia or testo), although nowadays flat pans or electric griddles are commonly used."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-piadina-romagnola"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Piadina_romagnola"}],"sections":[{"h":"Where it's from","links":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Lard","ingredient/lard"],["Olive oil","ingredient/olive-oil"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's long-running video series filming Italian grandmothers making regional pasta by hand.","url":"https://pastagrannies.substack.com/p/pasta-grannies-is-now-on-substack","suggested":true,"kind":"youtube"},{"name":"Recipes from Italy","color":"#55b8ad","shape":"site","sub":"recipesfromitaly.com","note":"Traditional Italian recipes written by Italian home cooks, organized by region and course.","url":"https://recipesfromitaly.com","suggested":true,"kind":"blog"},{"name":"Manu's Menu","color":"#55b8ad","shape":"site","sub":"manusmenu.com","note":"Italian-born home cook Manuela sharing classic family and regional Italian dishes.","url":"https://www.manusmenu.com/about/about-this-site","suggested":true,"kind":"blog"}]},{"h":"More from Italian cuisine","links":[["Acquacotta","dish/acquacotta"],["Agliata","dish/agliata"],["Agnolotti","dish/agnolotti"],["Antipasto","dish/antipasto"],["Arancini","dish/arancini"],["Biscotti","dish/biscotti"],["Bolinhos de bacalhau","dish/bolinhos-de-bacalhau"],["Bombolone","dish/bombolone"],["Budino","dish/budino"],["Cabbage roll","dish/cabbage-roll"],["Caesar salad","dish/caesar-salad"],["Cannelloni","dish/cannelloni"],["Capellini","dish/capellini"],["Carbonara","dish/carbonara"],["Carpaccio","dish/carpaccio"],["Cassatella di sant'Agata","dish/cassatella-di-sant-agata"],["Cassoeula","dish/cassoeula"],["Ciabatta","dish/ciabatta"],["Cioppino","dish/cioppino"],["Coda alla vaccinara","dish/coda-alla-vaccinara"],["Colomba pasquale","dish/colomba-pasquale"],["Conti roll","dish/conti-roll"],["Cotoletta alla bolognese","dish/cotoletta-alla-bolognese"],["Crostata","dish/crostata"],["Drago restaurants","dish/drago-restaurants"],["Focaccia pugliese","dish/focaccia-pugliese"],["Frittata","dish/frittata"],["Giardiniera","dish/giardiniera"],["Guanciale","dish/guanciale"],["Italian restaurant","dish/italian-restaurant"],["Italian wedding soup","dish/italian-wedding-soup"],["Lampredotto","dish/lampredotto"],["Lasagna","dish/lasagna"],["List of Italian restaurants","dish/list-of-italian-restaurants"],["Marinara sauce","dish/marinara-sauce"],["Mondeghili","dish/mondeghili"],["Paccheri","dish/paccheri"],["Panini (sandwich)","dish/panini-sandwich"],["Panna cotta","dish/panna-cotta"],["Passatelli","dish/passatelli"]]}],"img":{"src":"/world-cuisine/img/thumb/e/e6/Piadina.jpg/500px-Piadina.jpg","w":500,"h":491,"by":"Kobako","lic":"CC BY-SA 2.5","licUrl":"https://creativecommons.org/licenses/by-sa/2.5","page":"https://commons.wikimedia.org/wiki/File:Piadina.jpg"}},"ingredient/pig":{"t":"ingredient","r":"ingredient/pig","n":"Pig","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["The pig (Sus domesticus), also called swine (pl.: swine) or hog, is an omnivorous, domesticated, even-toed, hoofed mammal. It is named the domestic pig when distinguishing it from other members of the genus Sus. Some authorities consider it a subspecies of Sus scrofa (the wild boar or Eurasian boar); other authorities consider it a distinct species. Pigs were domesticated independently twice during the Neolithic, in the Near East around the Tigris Basin, and in China. When domesticated pigs arrived in Europe from the Near East, they extensively interbred with wild boar in Europe but retained their domesticated features."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-pig"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pig"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Balinese cuisine","cuisine/balinese-cuisine",[["Sate lilit","dish/sate-lilit"]]],["Indonesian cuisine","cuisine/indonesian-cuisine",[["Sate lilit","dish/sate-lilit"]]]]},{"h":"Often cooked with","links":[["Black pepper","ingredient/black-pepper"],["Candlenut","ingredient/candlenut"],["Chicken","ingredient/chicken"],["Chili pepper","ingredient/chili-pepper"],["Coconut","ingredient/coconut"],["Galangal","ingredient/galangal"],["Ginger","ingredient/ginger"],["Grated coconut","ingredient/grated-coconut"],["Kencur","ingredient/kencur"],["Lemongrass","ingredient/lemongrass"],["Turmeric","ingredient/turmeric"]]}],"img":{"src":"/world-cuisine/img/thumb/3/3e/Pig_farm_Vampula_1.jpg/500px-Pig_farm_Vampula_1.jpg","w":500,"h":310,"by":"kallerna","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Pig_farm_Vampula_1.jpg"}},"ingredient/soured-milk":{"t":"ingredient","r":"ingredient/soured-milk","n":"Soured milk","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Soured milk, sour milk, spontaneously soured milk, or naturally soured milk is the milk product fermented with indigenous microorganisms (chiefly mesophilic lactic acid bacteria), as opposed to cultured milk, of which the production involves controlled fermentation with starter cultures. Lactic acid produced by the bacteria brings tart taste and causes milk to coagulate and thicken, inhibiting the growth of harmful bacteria and improving the product's shelf life. It is unlike \"spoiled milk\" and is historically used for culinary, nutritional and preservation purposes in many cultures."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-soured-milk"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Soured_milk"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Albanian cuisine","cuisine/cuisine-of-albania",[["Tavë kosi","dish/tave-kosi"]]]]},{"h":"Often cooked with","links":[["Butter","ingredient/butter"],["Egg","ingredient/egg"],["Lamb","ingredient/lamb"],["Wheat flour","ingredient/wheat-flour"],["Yogurt","ingredient/yogurt"]]}],"img":{"src":"/world-cuisine/img/thumb/a/a6/Latte_025.jpg/500px-Latte_025.jpg","w":500,"h":449,"by":"Kagor at the Ukrainian language Wikipedia","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Latte_025.jpg"}},"ingredient/nougat":{"t":"ingredient","r":"ingredient/nougat","n":"Nougat","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Nougat refers to a variety of soft, chewy or crunchy confections made from sugar, honey or syrup combined with nuts, egg white, cocoa, milk powder, candied fruits, and/or other ingredients. The main colour is usually white or brown."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-nougat"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Nougat"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Italian cuisine","cuisine/italian-cuisine",[["Torta setteveli","dish/torta-setteveli"]]]]},{"h":"Often cooked with","links":[["Almond","ingredient/almond"],["Chocolate","ingredient/chocolate"],["Gianduja","ingredient/gianduja"],["Hazelnut","ingredient/hazelnut"],["Theobroma cacao","ingredient/theobroma-cacao"]]}],"img":{"src":"/world-cuisine/img/thumb/d/d5/Nougat.jpg/500px-Nougat.jpg","w":500,"h":459,"by":"The original uploader was Gregory at Finnish Wikipedia.","lic":"CC BY 2.5","licUrl":"https://creativecommons.org/licenses/by/2.5","page":"https://commons.wikimedia.org/wiki/File:Nougat.jpg"}}}