{"cuisine/jilin-cuisine":{"t":"cuisine","r":"cuisine/jilin-cuisine","n":"Jilin cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Northeastern Chinese cuisine","cuisine/northeastern-chinese-cuisine"]],"sub":"Regional cuisine in China","intro":[["Jilin cuisine is the regional cooking style of the Han Chinese with heavy influence from native Manchu, Korean, and Mongolian minorities in the Jilin Province of Northeastern China."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"jilin-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Jilin_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Northeastern Chinese cuisine","cuisine/northeastern-chinese-cuisine"]]},{"h":"Part of","links":[["Northeastern Chinese cuisine","cuisine/northeastern-chinese-cuisine"]]}],"cont":"Asian cuisine"},"cuisine/zhejiang-cuisine":{"t":"cuisine","r":"cuisine/zhejiang-cuisine","n":"Zhejiang cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Chinese cuisine","cuisine/chinese-cuisine"]],"sub":"Regional cuisine in China","intro":[["Zhejiang cuisine, alternatively known as Zhe cuisine, is one of the Eight Culinary Traditions of Chinese cuisine. Zhejiang cuisine contains four different styles, Hangzhou, Shaoxing, Ningbo, and Wenzhou (also known as Ou cuisine). It derives from the traditional ways of cooking in Zhejiang Province, which is located south of Shanghai and centred around Hangzhou, a historical Chinese capital. In general, Zhejiang cuisine is not greasy but has a fresh and soft flavour with a mellow fragrance."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"zhejiang-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Zhejiang_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"Land of Fish and Rice: Recipes from the Culinary Heart of China","color":"#f0b340","shape":"book","sub":"Fuchsia Dunlop, 2016","note":"Covers the Jiangnan region, including Hangzhou, Shaoxing and Ningbo in Zhejiang.","url":"https://wwnorton.com/books/Land-of-Fish-and-Rice/","suggested":true}]},{"h":"Part of","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Within Zhejiang cooking","count":1,"links":[["Hangbang cuisine","cuisine/hangbang-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/world-cuisine/img/thumb/f/fe/DongPoRou.jpg/500px-DongPoRou.jpg","w":500,"h":375,"by":"Sjschen","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:DongPoRou.jpg"}},"ingredient/banana-leaf":{"t":"ingredient","r":"ingredient/banana-leaf","n":"Banana leaf","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 16 dishes across 8 cuisines","intro":[["The banana leaf is the leaf of the banana plant, which may produce up to 40 leaves in a growing cycle. The leaves have a wide range of applications because they are large, flexible, waterproof and decorative. They are used for cooking, wrapping, and food-serving in a wide range of cuisines in tropical and subtropical areas. They are used for decorative and symbolic purposes in numerous Hindu and Buddhist ceremonies. In traditional home building in tropical areas, roofs and fences are made with dry banana-leaf thatch. Bananas and palm leaves were historically the primary writing surfaces in many nations of South and Southeast Asia."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-banana-leaf"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Banana_leaf"}],"sections":[{"h":"Where it's cooked with","count":8,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Arem-arem","dish/arem-arem"],["Botok","dish/botok"],["Lampet","dish/lampet"],["Lemang","dish/lemang"],["Lemper","dish/lemper"],["Lupis (food)","dish/lupis-food"],["Nagasari","dish/nagasari"],["Nasi bakar","dish/nasi-bakar"],["Otak-otak","dish/otak-otak"],["Pepes","dish/pepes"