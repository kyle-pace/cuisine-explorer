ttps://commons.wikimedia.org/wiki/File:Esgrarrat_(Meliana).jpg"}},"ingredient/genoise":{"t":"ingredient","r":"ingredient/genoise","n":"Genoise","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["A génoise, also known as Genoese cake or Genovese cake, is a French sponge cake named after the city of Genoa and associated with French cuisine. Instead of using chemical leavening, air is suspended in the batter during mixing to provide volume."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-genoise"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Genoise"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["French cuisine","cuisine/french-cuisine",[["Fraisier","dish/fraisier"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Fraisier","dish/fraisier"]]]]},{"h":"Often cooked with","links":[["Cream","ingredient/cream"],["Custard","ingredient/custard"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/56/Cocoa_G%C3%A9noise_cake.jpg/500px-Cocoa_G%C3%A9noise_cake.jpg","w":500,"h":333,"by":"Roozitaa","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Cocoa_G%C3%A9noise_cake.jpg"}},"dish/kolach-bread":{"t":"dish","r":"dish/kolach-bread","n":"Kolach (bread)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 5 cuisines","dot":"#cf5f87","intro":[["A kolach or kalach is a traditional bread found in Central and Eastern European cuisines, commonly served during various special occasions – particularly wedding celebrations, Christmas, Easter, and Dożynki. The name originates from the Old Slavonic word kolo meaning \"circle\" or \"wheel\". Korovai is sometimes categorised as a type of kolach."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kolach-bread"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kolach_(bread)"}],"sections":[{"h":"Where it's from","links":[["Bulgarian cuisine","cuisine/bulgarian-cuisine"],["Czech cuisine","cuisine/czech-cuisine"],["Polish cuisine","cuisine/polish-cuisine"],["Russian cuisine","cuisine/russian-cuisine"],["Ukrainian cuisine","cuisine/ukrainian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Rye flour","ingredient/rye-flour"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Cook Like Czechs","ref":"site/cooklikeczechs-com","color":"#55b8ad","shape":"site","sub":"cooklikeczechs.com","note":"English-language blog of traditional Czech home recipes by a Czech cook.","url":"https://cooklikeczechs.com/about/","suggested":true},{"name":"Polonist","ref":"site/polonist-com","color":"#55b8ad","shape":"site","sub":"polonist.com","note":"Polish recipes and food culture from a Polish-born writer living abroad.","url":"https://www.polonist.com/about/","suggested":true},{"name":"Polish Your Kitchen","ref":"site/polishyourkitchen-com","color":"#55b8ad","shape":"site","sub":"polishyourkitchen.com","note":"Long-running blog of traditional Polish home recipes.","url":"https://polishyourkitchen.com","suggested":true},{"name":"Olga's Flavor Factory","ref":"site/olgasflavorfactory-com","color":"#55b8ad","shape":"site","sub":"olgasflavorfactory.com","note":"Russian-born home cook Olga's blog, with a dedicated Russian recipes category.","url":"https://www.olgasflavorfactory.com/category/russianrecipes/","suggested":true}]},{"h":"More from Bulgarian cuisine","links":[["Banitsa","dish/banitsa"],["Cabbage roll","dish/cabbage-roll"],["Garash cake","dish/garash-cake"],["İmam bayıldı","dish/imam-bay-ld"],["Kyopolou","dish/kyopolou"],["Lyutenitsa","dish/lyutenitsa"],["Patatnik","dish/patatnik"],["Pindjur","dish/pindjur"],["Sauerkraut","dish/sauerkraut"],["Stuffed peppers","dish/stuffed-peppers"],["Tarator","dish/tarator"]]}],"img":{"src":"/labs/cuisines/img/thumb/6/64/Lob_NARkult_09.JPG/500px-Lob_NARkult_09.JPG","w":500,"h":335,"by":"Лобачев Владимир","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Lob_NARkult_09.JPG"}},"ingredient/savoiarde-pat":{"t":"ingredient","r":"ingredient/savoiarde-pat","n":"Savoiarde PAT","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 4 cuisines","intro":[["Ladyfingers or Naples biscuits, in British English sponge fingers, also known by the Italian name savoiardi or by the French name boudoirs (French: [budwaʁ]), are low-density, dry, egg-based, sweet sponge cake biscuits roughly shaped like large fingers. They are a principal ingredient in many dessert recipes, such as trifles and charlottes, and are also used as fruit or chocolate gateau linings, and for the sponge element of tiramisu. They are typically soaked in a sugar syrup or liqueur, or in espresso for tiramisu."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-savoiarde-pat"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ladyfingers_(biscuits)"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Filipino cuisine","cuisine/filipino-cuisine",[["Mango float","dish/mango-float"]]],["Italian cuisine","cuisine/italian-cuisine",[["Tiramisu","dish/tiramisu"]]],["Mindanao cuisine","cuisine/filipino-cuisine-mindanao",[["Mango float","dish/mango-float"]]],["Visayan cuisine","cuisine/filipino-cuisine-visayas",[["Mango float","dish/mango-float"]]]]},{"h":"Often cooked with","links":[["Ladyfinger (biscuit)","ingredient/ladyfinger-biscuit"],["Carabao mango","ingredient/carabao-mango"],["Condensed milk","ingredient/condensed-milk"],["Cracker","ingredient/cracker"],["Graham crackers","ingredient/graham-crackers"],["Mango","ingredient/mango"],["Whipped cream","ingredient/whipped-cream"],["Cocoa powder","ingredient/cocoa-powder"],["Coffee","ingredient/coffee"],["Egg","ingredient/egg"],["Egg yolk","ingredient/egg-yolk"],["Espresso","ingredient/espresso"],["Marsala wine","ingredient/marsala-wine"],["Mascarpone","ingredient/mascarpone"],["Sugar","ingredient/sugar"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/0c/Biskotten-02.jpg/500px-Biskotten-02.jpg","w":500,"h":375,"by":"Priwo","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Biskotten-02.jpg"}},"dish/mie-gomak":{"t":"dish","r":"dish/mie-gomak","n":"Mie gomak","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Mie gomak is a Batak thick spicy noodle soup dish served in a coconut milk and andaliman-based broth, that is a specialty of Toba Batak region of  North Sumatra, Indonesia. Other than traditional Batak lands surrounding Lake Toba, this dish is also a specialty of the Sibolga and Tapanuli area. Unlike common Indonesian noodles, the type of noodle used in this dish is a thick one called mie lidi, similar to spaghetti pasta, and thus mie gomak is often described as Batak-style spaghetti. Mie gomak is similar to mie Aceh from a neighbouring province."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-mie-gomak"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mie_gomak"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":12,"links":[["Andaliman","ingredient/andaliman"],["Black pepper","ingredient/black-pepper"],["Chayote","ingredient/chayote"],["Chili pepper","ingredient/chili-pepper"],["Coconut milk","ingredient/coconut-milk"],["Egg","ingredient/egg"],["Galangal","ingredient/galangal"],["Ginger","ingredient/ginger"],["Lemongrass","ingredient/lemongrass"],["Noodles","ingredient/noodles"],["Scallion","ingredient/scallion"],["Shallot","ingredient/shallot"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","ref":"site/dailycookingquest-com","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/2b/Mie_Gomak_2.jpg/500px-Mie_Gomak_2.jpg","w":500,"h":486,"by":"Gunawan Kartapranata","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Mie_Gomak_2.jpg"}},"dish/skirlie":{"t":"dish","r":"dish/skirlie","n":"Skirlie","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Scottish cuisine","dot":"#cf5f87","intro":[["Skirlie is a Scottish dish, made from oatmeal fried with fat, onions and seasonings. The \"skirl\" indicates the noise made by the frying ingredients. Similar to white pudding, which has similar ingredients but is boiled in a tripe skin, it is served as a side-dish with potatoes,  or used as a stuffing for chicken or other fowl. It is also a common side dish to accompany mince and tatties or Christmas dinner, especially in the northeast of Scotland. Suet, lard, beef dripping or butter are used.  The addition of salt at the cooking stage is crucial, but a bit less than used to be added as salt is to be found in so many other foods."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-skirlie"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Skirlie"}],"sections":[{"h":"Where it's from","links":[["Scottish cuisine","cuisine/scottish-cuisine"]]},{"h":"Cook it","rows":[{"name":"Scottish Scran","ref":"site/scottishscran-com","color":"#55b8ad","shape":"site","sub":"scottishscran.com","note":"Blog working through traditional Scottish dishes one recipe at a time.","url":"https://scottishscran.com","suggested":true},{"name":"Something Sweet Something Savoury: Scottish recipes","ref":"site/somethingsweetsomethingsavoury-com","color":"#55b8ad","shape":"site","sub":"somethingsweetsomethingsavoury.com","note":"Scottish home baking and cooking section of a UK food blog.","url":"https://somethingsweetsomethingsavoury.com/category/scottish-recipes/","suggested":true}]},{"h":"More from Scottish cuisine","links":[["Clootie dumpling","dish/clootie-dumpling"],["Cock-a-leekie","dish/cock-a-leekie"],["Finnan haddie","dish/finnan-haddie"],["Haggis","dish/haggis"],["Haggis pakora","dish/haggis-pakora"],["Hobnob biscuit","dish/hobnob-biscuit"],["Lorne sausage","dish/lorne-sausage"],["Mince and tatties","dish/mince-and-tatties"],["Rumbledethumps","dish/rumbledethumps"],["Scotch broth","dish/scotch-broth"],["Stornoway black pudding","dish/stornoway-black-pudding"]]}]},"dish/taco-john-s":{"t":"dish","r":"dish/taco-john-s","n":"Taco John's","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Mexican cuisine","dot":"#94bd5c","intro":[["Taco John's International, Inc. is an American fast food restaurant. The chain serves Mexican-inspired fast food as well as the company's signature dish, Potato Olés, which are bite-sized deep-fried potato nuggets coated with a proprietary blend of seasonings. Since 2025, the company has been headquartered in St. Louis Park, Minnesota."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-taco-john-s"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Taco_John's"}],"sections":[{"h":"Where it's from","links":[["Mexican cuisine","cuisine/mexican-cuisine"]]},{"h":"Cook it","rows":[{"name":"Mexico in My Kitchen","ref":"site/mexicoinmykitchen-com","color":"#55b8ad","shape":"site","sub":"mexicoinmykitchen.com","note":"Mely Martínez's long-running blog of Mexican home-style recipes.","url":"https://www.mexicoinmykitchen.com/","suggested":true},{"name":"Pati Jinich","ref":"site/patijinich-com","color":"#55b8ad","shape":"site","sub":"patijinich.com","note":"Recipe archive from the Mexican-born chef and host of the PBS series Pati's Mexican Table.","url":"https://patijinich.com/recipes/","suggested":true}]},{"h":"More from Mexican cuisine","links":[["Acapulco Mexican Restaurant and Cantina","dish/acapulco-mexican-restaurant-and-cantina"],["Amigos (restaurant chain)","dish/amigos-restaurant-chain"],["Animalón","dish/animalon"],["Anna's Taqueria","dish/anna-s-taqueria"],["Baker's Drive-Thru","dish/baker-s-drive-thru"],["Barburrito","dish/barburrito"],["Birrieria La Plaza","dish/birrieria-la-plaza"],["Birrieria PDX","dish/birrieria-pdx"],["Boca Grande Taqueria","dish/boca-grande-taqueria"],["BurritoVille","dish/burritoville"],["Cafe Rio","dish/cafe-rio"],["California Tortilla","dish/california-tortilla"],["Cantina Mariachi","dish/cantina-mariachi"],["Carlos'n Charlie's","dish/carlos-n-charlie-s"],["Casa Bonita","dish/casa-bonita"],["Casa Enrique","dish/casa-enrique"],["Casa Vega","dish/casa-vega"],["Chevys Fresh Mex","dish/chevys-fresh-mex"],["Chi-Chi's","dish/chi-chi-s"],["Chico's Tacos","dish/chico-s-tacos"],["Chile con queso","dish/chile-con-queso"],["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Chiquito (restaurant)","dish/chiquito-restaurant"],["Concha","dish/concha"],["Contramar","dish/contramar"],["Cosecha","dish/cosecha"],["Del Taco","dish/del-taco"],["Discada","dish/discada"],["District Taco","dish/district-taco"],["Don Pablo's","dish/don-pablo-s"],["El Adobe de Capistrano","dish/el-adobe-de-capistrano"],["El Bajío (restaurant)","dish/el-bajio-restaurant"],["El Chico (restaurant)","dish/el-chico-restaurant"],["El Coyote Cafe","dish/el-coyote-cafe"],["El Fenix (restaurant)","dish/el-fenix-restaurant"],["El Gallo Taqueria","dish/el-gallo-taqueria"],["El Tepeyac Café","dish/el-tepeyac-cafe"],["El Torito","dish/el-torito"],["Em (restaurant)","dish/em-restaurant"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/ad/Taco_John%27s_Drive_Thru_Restaurant%2C_Cheyenne%2C_WY.JPG/500px-Taco_John%27s_Drive_Thru_Restaurant%2C_Cheyenne%2C_WY.JPG","w":500,"h":335,"by":"Highplains-scout","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Taco_John's_Drive_Thru_Restaurant%2C_Cheyenne%2C_WY.JPG"}},"ingredient/green-laver":{"t":"ingredient","r":"ingredient/green-laver","n":"Green laver","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Green laver (), known as aonori (アオノリ; 青海苔) in Japan, sea cabbage (海白菜) or hutai (滸苔) in China, and parae (파래) and kim (김) in Korean, is a type of edible green seaweed, including species from the genera Monostroma and Ulva (Ulva prolifera, Ulva pertusa, Ulva intestinalis). It is commercially cultivated in some bay areas in Japan, Korea, and Taiwan, such as Ise Bay. It is rich in minerals such as calcium, magnesium, lithium, vitamins, and amino acids such as methionine. It is also called aosa (アオサ, Ulva pertusa) in some places in Japan."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-green-laver"},{"