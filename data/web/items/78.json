{"cuisine/andorran-cuisine":{"t":"cuisine","r":"cuisine/andorran-cuisine","n":"Andorran cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Catalan cuisine","cuisine/catalan-cuisine"]],"sub":"Regional cuisine in Spain","intro":[["Catalan cuisine is the cooking traditions and practices from Catalonia. It may also refer to the shared cuisine of Northern Catalonia and Andorra, the second of which has a similar cuisine to that of the neighbouring Alt Urgell and Cerdanya comarques, often referred to as \"Catalan mountain cuisine\". It is considered a part of western Mediterranean cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"andorran-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Andorran_cuisine"}],"sections":[{"h":"Dishes","count":5,"links":[["Arròs negre","dish/arros-negre"],["Crema catalana","dish/crema-catalana"],["Mató","dish/mato"],["Pa de pagès","dish/pa-de-pages"],["Samfaina","dish/samfaina"]]},{"h":"Recipe sites","empty":"None yet","tryLinks":[["Catalan cuisine","cuisine/catalan-cuisine"]]},{"h":"Key ingredients","links":[["Milk","ingredient/milk"],["Cephalopod ink","ingredient/cephalopod-ink"],["Cubanelle","ingredient/cubanelle"],["Cuttlefish","ingredient/cuttlefish"],["Rice","ingredient/rice"],["Squid as food","ingredient/squid-as-food"],["Cinnamon","ingredient/cinnamon"],["Egg","ingredient/egg"],["Egg yolk","ingredient/egg-yolk"],["Lemon zest","ingredient/lemon-zest"],["Sugar","ingredient/sugar"],["Goat milk","ingredient/goat-milk"],["Sheep milk","ingredient/sheep-milk"],["Wheat flour","ingredient/wheat-flour"],["Yeast","ingredient/yeast"],["Cucurbita pepo","ingredient/cucurbita-pepo"],["Eggplant","ingredient/eggplant"],["Garlic","ingredient/garlic"],["Olive oil","ingredient/olive-oil"],["Onion","ingredient/onion"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["Catalan cuisine","cuisine/catalan-cuisine"]]}],"cont":"European cuisine","img":{"src":"/labs/cuisines/img/thumb/0/00/Arr%C3%B2s_de_Pals_amb_pollastre_i_poma.jpg/500px-Arr%C3%B2s_de_Pals_amb_pollastre_i_poma.jpg","w":500,"h":281,"by":"Consell Comarcal del Baix Empordà","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Arr%C3%B2s_de_Pals_amb_pollastre_i_poma.jpg"}},"ingredient/coconut-water":{"t":"ingredient","r":"ingredient/coconut-water","n":"Coconut water","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 4 dishes across 2 cuisines","intro":[["Coconut water (also coconut juice) is the clear liquid inside young coconuts (fruits of the coconut palm). In early development, it serves as a suspension for the endosperm of the coconut during the nuclear phase of development. As development continues, the endosperm matures into its cellular phase and deposits into the rind of the coconut pulp."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-coconut-water"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Coconut_water"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Klappertaart","dish/klappertaart"]]],["Padang food","cuisine/padang-food",[["Ayam pop","dish/ayam-pop"]]]]},{"h":"Often cooked with","links":[["Chicken","ingredient/chicken"],["Galangal","ingredient/galangal"],["Chili pepper","ingredient/chili-pepper"],["Candlenut","ingredient/candlenut"],["Coconut oil","ingredient/coconut-oil"],["Deep fried","ingredient/deep-fried"],["Ginger","ingredient/ginger"],["Shallots","ingredient/shallots"],["Turmeric","ingredient/turmeric"],["Ayam goreng","ingredient/ayam-goreng"],["Palm sugar","ingredient/palm-sugar"],["Shrimp paste","ingredient/shrimp-paste"],["Sweet soy sauce","ingredient/sweet-soy-sauce"],["Coconut milk","ingredient/coconut-milk"],["Lemongrass","ingredient/lemongrass"],["Almond","ingredient/almond"]]}],"img":{"src":"/labs/c