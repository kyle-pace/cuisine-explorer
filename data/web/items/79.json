ngredient/garlic"],["Paprika","ingredient/paprika"],["Parsley","ingredient/parsley"],["Pickled bean curd","ingredient/pickled-bean-curd"],["Pig blood","ingredient/pig-blood"],["Radish","ingredient/radish"],["Rice noodles","ingredient/rice-noodles"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/90/Ipomoea_tricolor_%27Heavenly_Blue%27.jpg/500px-Ipomoea_tricolor_%27Heavenly_Blue%27.jpg","w":500,"h":334,"by":"James Steakley","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Ipomoea_tricolor_'Heavenly_Blue'.jpg"}},"dish/bryndzove-halusky":{"t":"dish","r":"dish/bryndzove-halusky","n":"Bryndzové halušky","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Slovak cuisine","dot":"#cf5f87","intro":[["Bryndzové halušky, Austrian German: Brimsennocken) is one of the national dishes in Slovakia. This meal consists of halušky (boiled lumps of potato dough similar in appearance to gnocchi) and bryndza (a soft sheep cheese), optionally sprinkled with cooked bits of smoked pork fat or bacon, and chives or spring onions."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-bryndzove-halusky"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bryndzov%C3%A9_halu%C5%A1ky"}],"sections":[{"h":"Where it's from","links":[["Slovak cuisine","cuisine/slovak-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Bryndza","ingredient/bryndza"],["Corned beef","ingredient/corned-beef"],["Halušky","ingredient/halusky"],["Potato","ingredient/potato"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Slovak Cooking","ref":"site/slovakcooking-com","color":"#55b8ad","shape":"site","sub":"slovakcooking.com","note":"English-language site of Slovak home recipes started by a young Slovak cook.","url":"https://www.slovakcooking.com/about/","suggested":true,"kind":"blog"},{"name":"Cook Slovak","ref":"site/cookslovak-com","color":"#55b8ad","shape":"site","sub":"cookslovak.com","note":"Blog of traditional Slovak recipes and food customs.","url":"https://cookslovak.com/category/recipes/","suggested":true,"kind":"blog"}]},{"h":"More from Slovak cuisine","links":[["Cabbage roll","dish/cabbage-roll"],["Halušky","dish/halusky"],["Liptauer","dish/liptauer"],["Székelykáposzta","dish/szekelykaposzta"],["Tarhonya","dish/tarhonya"],["Trdelník","dish/trdelnik"],["Tsvikli","dish/tsvikli"]]}],"img":{"src":"/labs/cuisines/img/thumb/f/f7/Bryndzov%C3%A9_halu%C5%A1ky.jpg/500px-Bryndzov%C3%A9_halu%C5%A1ky.jpg","w":500,"h":375,"by":"Matus Kacmar","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Bryndzov%C3%A9_halu%C5%A1ky.jpg"}},"dish/hamburg-steak":{"t":"dish","r":"dish/hamburg-steak","n":"Hamburg steak","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#94bd5c","intro":[["Hamburg steak is a patty of ground beef. Made popular worldwide by migrating Germans, it became a mainstream dish around the start of the 19th century. It is related to Salisbury steaks, which also use ground beef. It is considered the origin of the hamburger when, in the early 20th century, vendors began selling the Hamburg steak between bread as a sandwich."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-hamburg-steak"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hamburg_steak"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"],["German cuisine","cuisine/german-cuisine"],["Thuringian cuisine","cuisine/german-cuisine-thuringia"]]},{"h":"Ingredients","count":2,"links":[["Beef","ingredient/beef"],["Beefsteak","ingredient/beefsteak"]]},{"h":"Cook it","rows":[{"name":"Quick German Recipes","ref":"site/quick-german-recipes-com","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Long-running site by German-born cook Gerhild Fulson (Oma) with traditional German home recipes.","url":"https://www.quick-german-recipes.com/about-me.html","suggested":true,"kind":"blog"},{"name":"Dirndl Kitchen","ref":"site/dirndlkitchen-com","color":"#55b8ad","shape":"site","sub":"dirndlkitchen.com","note":"Blog of German and Bavarian recipes, from main dishes to holiday baking.","url":"https://dirndlkitchen.com","suggested":true,"kind":"blog"},{"name":"Quick German Recipes","ref":"site/quick-german-recipes-com","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Thuringia page on German-born cook Gerhild Fulson's long-running German recipe site.","url":"https://www.quick-german-recipes.com/thuringia.html","suggested":true,"kind":"blog"}]},{"h":"More from American cuisine","links":[["Angel food cake","dish/angel-food-cake"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Beer cake","dish/beer-cake"],["Better than sex cake","dish/better-than-sex-cake"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Brown Betty (dessert)","dish/brown-betty-dessert"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Butter cake","dish/butter-cake"],["Caesar salad","dish/caesar-salad"],["Caramel apple","dish/caramel-apple"],["Carbonara","dish/carbonara"],["Cheesesteak","dish/cheesesteak"],["Chicago-style hot dog","dish/chicago-style-hot-dog"],["Chicken nugget","dish/chicken-nugget"],["Chiffon cake","dish/chiffon-cake"],["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Chow-chow (food)","dish/chow-chow-food"],["Chowder","dish/chowder"],["Cioppino","dish/cioppino"],["Clam chowder","dish/clam-chowder"],["Clam dip","dish/clam-dip"],["Club sandwich","dish/club-sandwich"],["Cobb salad","dish/cobb-salad"],["Cobbler (food)","dish/cobbler-food"],["Cook's Corner","dish/cook-s-corner"],["Crab cake","dish/crab-cake"],["Croffle","dish/croffle"],["Dagwood Bumstead","dish/dagwood-bumstead"],["Dagwood sandwich","dish/dagwood-sandwich"],["Deep-dish pizza","dish/deep-dish-pizza"],["Desperation pie","dish/desperation-pie"],["Dirty rice","dish/dirty-rice"],["Donut hole","dish/donut-hole"],["Egg in the basket","dish/egg-in-the-basket"],["Fish and chips","dish/fish-and-chips"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e0/Hamburg-Steak.jpg/500px-Hamburg-Steak.jpg","w":500,"h":333,"by":"MaedaAkihiko","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Hamburg-Steak.jpg"}},"ingredient/sorghum-flour":{"t":"ingredient","r":"ingredient/sorghum-flour","n":"Sorghum flour","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Sorghum bicolor, commonly called sorghum () and also known as broomcorn, great millet, Indian millet, Guinea corn, jowar, or milo, is a species in the grass genus Sorghum. It is typically an annual, but some cultivars are perennial. It grows in clumps that may reach over 4 metres (13 ft) high. The grain is 2 to 4 millimetres (0.08 to 0.2 in) in diameter."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sorghum-flour"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sorghum_flour"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Israeli cuisine","cuisine/israeli-cuisine",[["Lahoh","dish/lahoh"]]]]},{"h":"Often cooked with","links":[["Cornmeal","ingredient/cornmeal"],["Self-rising flour","ingredient/self-rising-flour"],["Wheat flour","ingredient/wheat-flour"],["Yeast","ingredient/yeast"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/84/Sorghum_bicolor03.jpg/500px-Sorghum_bicolor03.jpg","w":500,"h":667,"by":"No machine-readable author provided. Pethan assumed (based on copyright claims).","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Sorghum_bicolor03.jpg"}},"ingredient/bakso":{"t":"ingredient","r":"ingredient/bakso","n":"Bakso","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Bakso or baso is an Indonesian meatball, or a meat paste made from beef surimi. Its texture is similar to the Chinese beef ball, fish ball, or pork ball. The word bakso may refer to a single meatball or the complete dish of meatball soup. Mie bakso refers to bakso served with yellow noodles and rice vermicelli, while bakso kuah refers to bakso soup served without noodles."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-bakso"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bakso"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Mie kocok","dish/mie-kocok"]]]]},{"h":"Often cooked with","links":[["Bean sprout","ingredient/bean-sprout"],["Beef","ingredient/beef"],["Broth","ingredient/broth"],["Celery","ingredient/celery"],["Ginger","ingredient/ginger"],["Lemongrass","ingredient/lemongrass"],["Meatball","ingredient/meatball"],["Mung bean sprout","ingredient/mung-bean-sprout"],["Mustard plant","ingredient/mustard-plant"],["Noodle","ingredient/noodle"],["Noodles","ingredient/noodles"],["Scallion","ingredient/scallion"],["Shallot","ingredient/shallot"],["Surimi","ingredient/surimi"],["Tendon as food","ingredient/tendon-as-food"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/28/Bakso_mi_bihun.jpg/500px-Bakso_mi_bihun.jpg","w":500,"h":375,"by":"christian r from Singapore","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Bakso_mi_bihun.jpg"}},"ingredient/cloves":{"t":"ingredient","r":"ingredient/cloves","n":"Cloves","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Cloves are the aromatic flower buds of a tree in the family Myrtaceae, Syzygium aromaticum (). They are native to the Maluku Islands, or Moluccas, in Indonesia, and are commonly used as a spice, flavoring, or fragrance in consumer products, such as toothpaste, soaps, or cosmetics. Freshly harvested cloves are available throughout the year owing to different harvest seasons across various countries."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-cloves"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cloves"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Dutch cuisine","cuisine/dutch-cuisine",[["Pepernoot","dish/pepernoot"]]],["Indonesian cuisine","cuisine/indonesian-cuisine",[["Semur (Indonesian stew)","dish/semur-indonesian-stew"]]]]},{"h":"Where it's grown","grown":{"what":"Cloves (whole stems), raw","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":190069,"top":[["Indonesia","cuisine/indonesian-cuisine",140044],["Madagascar","cuisine/malagasy-cuisine",24420],["Tanzania","cuisine/tanzanian-cuisine",8581],["Comoros","cuisine/comorian-cuisine",7308],["Sri Lanka","cuisine/sri-lankan-cuisine",5970],["Kenya","cuisine/kenyan-cuisine",2142],["China","cuisine/chinese-cuisine",1343],["Malaysia","cuisine/malaysian-cuisine",225],["Grenada","cuisine/culture-of-grenada-cuisine",36]]}},{"h":"Often cooked with","links":[["Cinnamon","ingredient/cinnamon"],["Nutmeg","ingredient/nutmeg"],["Peppercorn","ingredient/peppercorn"],["Anise","ingredient/anise"],["Butter","ingredient/butter"],["Honey","ingredient/honey"],["Rye flour","ingredient/rye-flour"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"],["Beef","ingredient/beef"],["Chicken","ingredient/chicken"],["Fish","ingredient/fish"],["Garlic","ingredient/garlic"],["Ginger","ingredient/ginger"],["Offal","ingredient/offal"],["Potato","ingredient/potato"]]}],"img":{"src":"/labs/cuisines/img/4/4b/Syzygium_aromaticum_-_K%C3%B6hler%E2%80%93s_Medizinal-Pflanzen-030.jpg","w":500,"h":651,"by":"Franz Eugen Köhler, Köhler's Medizinal-Pflanzen","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Syzygium_aromaticum_-_K%C3%B6hler%E2%80%93s_Medizinal-Pflanzen-030.jpg"}},"ingredient/livestock":{"t":"ingredient","r":"ingredient/livestock","n":"Livestock","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Livestock are the domesticated animals that are raised in an agricultural setting mainly to provide labor and produce diversified animal products for human consumption such as meat, eggs, milk, fur, leather, and wool. The term is sometimes used to refer solely to animals which are raised for consumption, and sometimes used to refer solely to farmed ruminants, such as cattle, sheep, and goats."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-livestock"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Livestock"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Scottish cuisine","cuisine/scottish-cuisine",[["Stornoway black pudding","dish/stornoway-black-pudding"]]]]},{"h":"Often cooked with","links":[["Avena","ingredient/avena"],["Blood as food","ingredient/blood-as-food"],["Liver as food","ingredient/liver-as-food"],["Oatmeal","ingredient/oatmeal"],["Onion","ingredient/onion"],["Suet","ingredient/suet"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e8/20150728_xl_P1000804_Leck_mich_Zaertlichkeit_der_Rinder.JPG/500px-20150728_xl_P1000804_Leck_mich_Zaertlichkeit_der_Rinder.JPG","w":500,"h":375,"by":"Molgreen","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:20150728_xl_P1000804_Leck_mich_Zaertlichkeit_der_Rinder.JPG"}},"dish/tave-kosi":{"t":"dish","r":"dish/tave-kosi","n":"Tavë kosi","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Albanian cuisine","dot":"#cf5f87","intro":[["Tavë kosi (\"yogurt casserole\"), also known as Tavë Elbasani, is a traditional Albanian baked dish consisting of mutton and rice covered with a mixture of yogurt, eggs, butter and flour before being baked in the oven. Chicken may be used as an alternative to mutton, in which case the dish is known as \"tavë kosi me mish pule\". It is commonly seasoned with ingredients such as salt, black pepper, garlic and oregano."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-tave-kosi"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tav%C3%AB_kosi"}],"sections":[{"h":"Where it's from","links":[["Albanian cuisine","cuisine/cuisine-of-albania"]]},{"h":"Ingredients","count":6,"links":[["Butter","ingredient/butter"],["Egg","ingredient/egg"],["Lamb","ingredient/lamb"],["Soured milk","ingredient/soured-milk"],["Wheat flour","ingredient/wheat-flour"],["Yogurt","ingredient/yogurt"]]},{"h":"Cook it","rows":[{"name":"My Albanian Food","ref":"site/myalbanianfood-com","color":"#55b8ad","shape":"site","sub":"myalbanianfood.com","note":"Albanian home recipes shared by an Albanian cook.","url":"https://www.myalbanianfood.com/?p=936","suggested":true,"kind":"blog"}]},{"h":"More from Albanian cuisine","links":[["Cabbage roll","dish/cabbage-roll"],["İmam bayıldı","dish/imam-bay-ld"],["Kabuni","dish/kabuni"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/28/TAVE_KOSI-_agnello_allo_yogurt_albanese.jpg/500px-TAVE_KOSI-_agnello_allo_yogurt_albanese.jpg","w":500,"h":320,"by":"fugzu","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:TAVE_KOSI-_agnello_allo_yogurt_albanese.jpg"}},"cookbook/japan-the-cookbook":{"t":"book","r":"cookbook/japan-the-cookbook","n":"Japan: The Cookbook","c":"#f0b340","crumb":[["Cookbooks","cookbooks"]],"sub":"Cookbook by Nancy Singleton Hachisu, 2018","square":true,"suggested":true,"intro":[["Large Phaidon compendium of Japanese home recipes by a writer who has lived on a farm in Japan for decades."]],"actions":[{"kind":"out","url":"https://www.phaidon.com/en-us/products/japan-the-cookbook","label":"Publisher or book page"}],"sections":[{"h":"Cuisines it covers","count":1,"links":[["Japanese cuisine","cuisine/japanese-cuisine"]]}]},"site/akit