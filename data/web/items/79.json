pedia","actions":[{"kind":"globe","hash":"ingredient-bakso"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bakso"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Mie kocok","dish/mie-kocok"]]]]},{"h":"Often cooked with","links":[["Bean sprout","ingredient/bean-sprout"],["Beef","ingredient/beef"],["Broth","ingredient/broth"],["Celery","ingredient/celery"],["Ginger","ingredient/ginger"],["Lemongrass","ingredient/lemongrass"],["Meatball","ingredient/meatball"],["Mung bean sprout","ingredient/mung-bean-sprout"],["Mustard plant","ingredient/mustard-plant"],["Noodle","ingredient/noodle"],["Noodles","ingredient/noodles"],["Scallion","ingredient/scallion"],["Shallot","ingredient/shallot"],["Surimi","ingredient/surimi"],["Tendon as food","ingredient/tendon-as-food"]]}]},"ingredient/cloves":{"t":"ingredient","r":"ingredient/cloves","n":"Cloves","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Cloves are the aromatic flower buds of a tree in the family Myrtaceae, Syzygium aromaticum (). They are native to the Maluku Islands, or Moluccas, in Indonesia, and are commonly used as a spice, flavoring, or fragrance in consumer products, such as toothpaste, soaps, or cosmetics. Freshly harvested cloves are available throughout the year owing to different harvest seasons across various countries."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-cloves"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cloves"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Dutch cuisine","cuisine/dutch-cuisine",[["Pepernoot","dish/pepernoot"]]],["Indonesian cuisine","cuisine/indonesian-cuisine",[["Semur (Indonesian stew)","dish/semur-indonesian-stew"]]]]},{"h":"Where it's grown","grown":{"what":"Cloves (whole stems), raw","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":190069,"top":[["Indonesia","cuisine/indonesian-cuisine",140044],["Madagascar","cuisine/malagasy-cuisine",24420],["Tanzania","cuisine/tanzanian-cuisine",8581],["Comoros","cuisine/comorian-cuisine",7308],["Sri Lanka","cuisine/sri-lankan-cuisine",5970],["Kenya","cuisine/kenyan-cuisine",2142],["China","cuisine/chinese-cuisine",1343],["Malaysia","cuisine/malaysian-cuisine",225],["Grenada","cuisine/culture-of-grenada-cuisine",36]]}},{"h":"Often cooked with","links":[["Cinnamon","ingredient/cinnamon"],["Nutmeg","ingredient/nutmeg"],["Peppercorn","ingredient/peppercorn"],["Anise","ingredient/anise"],["Butter","ingredient/butter"],["Honey","ingredient/honey"],["Rye flour","ingredient/rye-flour"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"],["Beef","ingredient/beef"],["Chicken","ingredient/chicken"],["Fish","ingredient/fish"],["Garlic","ingredient/garlic"],["Ginger","ingredient/ginger"],["Offal","ingredient/offal"],["Potato","ingredient/potato"]]}]},"ingredient/livestock":{"t":"ingredient","r":"ingredient/livestock","n":"Livestock","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Livestock are the domesticated animals that are raised in an agricultural setting mainly to provide labor and produce diversified animal products for human consumption such as meat, eggs, milk, fur, leather, and wool. The term is sometimes used to refer solely to animals which are raised for consumption, and sometimes used to refer solely to farmed ruminants, such as cattle, sheep, and goats."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-livestock"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Livestock"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Scottish cuisine","cuisine/scottish-cuisine",[["Stornoway black pudding","dish/stornoway-black-pudding"]]]]},{"h":"Often cooked with","links":[["Avena","ingredient/avena"],["Blood as food","ingredient/blood-as-food"],["Liver as food","ingredient/liver-as-food"],["Oatmeal","ingredient/oatmeal"],["Onion","ingredient/onion"],["Suet","ingredient/suet"]]}]},"dish/tave-kosi":{"t":"dish","r":"dish/tave-kosi","n":"Tavë kosi","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Albanian cuisine","dot":"#cf5f87","intro":[["Tavë kosi (\"yogurt casserole\"), also known as Tavë Elbasani, is a traditional Albanian baked dish consisting of mutton and rice covered with a mixture of yogurt, eggs, butter and flour before being baked in the oven. Chicken may be used as an alternative to mutton, in which case the dish is known as \"tavë kosi me mish pule\". It is commonly seasoned with ingredients such as salt, black pepper, garlic and oregano."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-tave-kosi"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tav%C3%AB_kosi"}],"sections":[{"h":"Where it's from","links":[["Albanian cuisine","cuisine/cuisine-of-albania"]]},{"h":"Ingredients","count":6,"links":[["Butter","ingredient/butter"],["Egg","ingredient/egg"],["Lamb","ingredient/lamb"],["Soured milk","ingredient/soured-milk"],["Wheat flour","ingredient/wheat-flour"],["Yogurt","ingredient/yogurt"]]},{"h":"Cook it","rows":[{"name":"My Albanian Food","ref":"site/myalbanianfood-com","color":"#55b8ad","shape":"site","sub":"myalbanianfood.com","note":"Albanian home recipes shared by an Albanian cook.","url":"https://www.myalbanianfood.com/?p=936","suggested":true}]},{"h":"More from Albanian cuisine","links":[["Cabbage roll","dish/cabbage-roll"],["İmam bayıldı","dish/imam-bay-ld"],["Kabuni","dish/kabuni"]]}]},"dish/umu-restaurant":{"t":"dish","r":"dish/umu-restaurant","n":"Umu (restaurant)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Umu is a Michelin-starred Japanese restaurant in London, United Kingdom."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-umu-restaurant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Umu_(restaurant)"}],"