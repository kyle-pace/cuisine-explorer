uisine/wampanoag-foodways",[["Succotash","dish/succotash"]]]]},{"h":"Often cooked with","links":[["Wheat flour","ingredient/wheat-flour"],["Bell peppers","ingredient/bell-peppers"],["Black pepper","ingredient/black-pepper"],["Butter","ingredient/butter"],["Edible salt","ingredient/edible-salt"],["Lima bean","ingredient/lima-bean"],["Sweet corn","ingredient/sweet-corn"],["Tomatoes","ingredient/tomatoes"]]}],"img":{"src":"/world-cuisine/img/thumb/7/79/VegCorn.jpg/500px-VegCorn.jpg","w":500,"h":329,"by":"The original Uploader was wstoakLL at English Wikipedia","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:VegCorn.jpg"}},"dish/egg-puffs-and-soup-pearls":{"t":"dish","r":"dish/egg-puffs-and-soup-pearls","n":"Egg puffs and soup pearls","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 4 cuisines","dot":"#cf5f87","intro":[["Egg puffs and soup pearls are choux-pastry pellets, resembling chickpea seeds, that are popular in Central Europe. They are typically used to garnish soups, but can be used to decorate other kinds of food, including desserts, or eaten alone as snacks. Egg puffs are baked, whereas soup pearls are deep-fried."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-egg-puffs-and-soup-pearls"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Egg_puffs_and_soup_pearls"}],"sections":[{"h":"Where it's from","links":[["Austrian cuisine","cuisine/austrian-cuisine"],["German cuisine","cuisine/german-cuisine"],["Thuringian cuisine","cuisine/german-cuisine-thuringia"],["Swiss cuisine","cuisine/swiss-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Egg","ingredient/egg"],["Milk","ingredient/milk"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Vienna Sunday Kitchen","color":"#55b8ad","shape":"site","sub":"vienna-sunday.kitchen","note":"Viennese food blog of Austrian home cooking and pastries, with English-language recipes.","url":"https://www.vienna-sunday.kitchen/newest-recipes/","suggested":true,"kind":"blog"},{"name":"Lil Vienna","color":"#55b8ad","shape":"site","sub":"lilvienna.com","note":"Austrian recipes from Ursula and David, two Austrians living in Boston.","url":"https://www.lilvienna.com/?p=1366","suggested":true,"kind":"blog"},{"name":"Quick German Recipes","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Long-running site by German-born cook Gerhild Fulson (Oma) with traditional German home recipes.","url":"https://www.quick-german-recipes.com/about-me.html","suggested":true,"kind":"blog"},{"name":"Dirndl Kitchen","color":"#55b8ad","shape":"site","sub":"dirndlkitchen.com","note":"Blog of German and Bavarian recipes, from main dishes to holiday baking.","url":"https://dirndlkitchen.com","suggested":true,"kind":"blog"}]},{"h":"More from Austrian cuisine","links":[["Blini","dish/blini"],["Cabbage roll","dish/cabbage-roll"],["Chicken paprikash","dish/chicken-paprikash"],["Dampfnudel","dish/dampfnudel"],["Gulyásleves","dish/gulyasleves"],["Leberkäse","dish/leberkase"],["Liptauer","dish/liptauer"],["Pancake","dish/pancake"],["Potato salad","dish/potato-salad"],["Sachertorte","dish/sachertorte"],["Spätzle","dish/spatzle"],["Strudel","dish/strudel"],["Tarhonya","dish/tarhonya"],["Zopf","dish/zopf"]]}],"img":{"src":"/world-cuisine/img/thumb/8/86/Backerbsen-1.jpg/500px-Backerbsen-1.jpg","w":500,"h":383,"by":"Kobako","lic":"CC BY-SA 2.5","licUrl":"https://creativecommons.org/licenses/by-sa/2.5","page":"https://commons.wikimedia.org/wiki/File:Backerbsen-1.jpg"}},"ingredient/pork-jowl":{"t":"ingredient","r":"ingredient/pork-jowl","n":"Pork jowl","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Pork jowl is a cut of pork from a pig's cheek. Different food traditions have used it as a fresh cut or as a cured pork product (with smoke and/or curing salt). As a cured and smoked meat in America, it is called jowl bacon or, especially in the Southern United States, hog jowl, joe bacon, or joe meat. In the US, hog jowl is a staple of soul food. Outside the United States, there is a longer culinary tradition: the cured, non-smoked Italian variant is called guanciale."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-pork-jowl"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pork_jowl"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Italian cuisine","cuisine/italian-cuisine",[["Guanciale","dish/guanciale"]]]]},{"h":"Often cooked with","links":[["Chili pepper","ingredient/chili-pepper"],["Peppercorn","ingredient/peppercorn"],["Sugar","ingredient/sugar"],["Thyme","ingredient/thyme"]]}],"img":{"src":"/world-cuisine/img/thumb/2/2a/Jowl_bacon.jpg/500px-Jowl_bacon.jpg","w":500,"h":483,"by":"Drmies at English Wikipedia","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Jowl_bacon.jpg"}},"dish/hamburger-helper":{"t":"dish","r":"dish/hamburger-helper","n":"Hamburger Helper","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["Hamburger Helper is a boxed food product manufactured by Eagle Foods, consisting of a dried carbohydrate (either pasta, rice, or potato), plus a packet of powdered seasonings; both are to be combined with browned ground beef (also known as \"hamburger\"), water, milk, and sometimes mayonnaise to create a complete one-dish meal."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-hamburger-helper"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hamburger_Helper"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Pasta","ingredient/pasta"],["Rice","ingredient/rice"]]},{"h":"More from American cuisine","links":[["Angel food cake","dish/angel-food-cake"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","di