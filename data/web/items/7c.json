panese noodles","dish/japanese-noodles"],["Japanese restaurant","dish/japanese-restaurant"],["Japanese tea","dish/japanese-tea"],["Jingisukan","dish/jingisukan"],["Jinya Ramen Bar","dish/jinya-ramen-bar"],["Kadowaki (restaurant)","dish/kadowaki-restaurant"],["Kaki furai","dish/kaki-furai"],["Kamaboko","dish/kamaboko"],["Kanda (restaurant)","dish/kanda-restaurant"]]}]},"ingredient/pork-jowl":{"t":"ingredient","r":"ingredient/pork-jowl","n":"Pork jowl","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Pork jowl is a cut of pork from a pig's cheek. Different food traditions have used it as a fresh cut or as a cured pork product (with smoke and/or curing salt). As a cured and smoked meat in America, it is called jowl bacon or, especially in the Southern United States, hog jowl, joe bacon, or joe meat. In the US, hog jowl is a staple of soul food. Outside the United States, there is a longer culinary tradition: the cured, non-smoked Italian variant is called guanciale."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-pork-jowl"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pork_jowl"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Italian cuisine","cuisine/italian-cuisine",[["Guanciale","dish/guanciale"]]]]},{"h":"Often cooked with","links":[["Chili pepper","ingredient/chili-pepper"],["Peppercorn","ingredient/peppercorn"],["Sugar","ingredient/sugar"],["Thyme","ingredient/thyme"]]}]},"dish/hamburger-helper":{"t":"dish","r":"dish/hamburger-helper","n":"Hamburger Helper","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["Hamburger Helper is a boxed food product manufactured by Eagle Foods, consisting of a dried carbohydrate (either pasta, rice, or potato), plus a packet of powdered seasonings; both are to be combined with browned ground beef (also known as \"hamburger\"), water, milk, and sometimes mayonnaise to create a complete one-dish meal."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-hamburger-helper"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hamburger_Helper"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Pasta","ingredient/pasta"],["Rice","ingredient/rice"]]},{"h":"More from American cuisine","links":[["5-8 Club","dish/5-8-club"],["Altabira City Tavern","dish/altabira-city-tavern"],["Angel food cake","dish/angel-food-cake"],["Applebee's","dish/applebee-s"],["Arby's","dish/arby-s"],["Arnold's Bar and Grill","dish/arnold-s-bar-and-grill"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Be Our Guest Restaurant","dish/be-our-guest-restaurant"],["Beer cake","dish/beer-cake"],["Ben's Chili Bowl","dish/ben-s-chili-bowl"],["Benjy's","dish/benjy-s"],["Besaw's","dish/besaw-s"],["Better than sex cake","dish/better-than-sex-cake"],["Blackhawk (restaurant)","dish/blackhawk-restaurant"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Bobcat Bite","dish/bobcat-bite"],["Boiling Springs Tavern","dish/boiling-springs-tavern"],["Brix Tavern","dish/brix-tavern"],["Brown Betty (dessert)","dish/brown-betty-dessert"],["Brown Derby","dish/brown-derby"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Buona","dish/buona"],["Busboys and Poets","dish/busboys-and-poets"],["Butter cake","dish/butter-cake"],["Byways Cafe","dish/byways-cafe"],["Caesar salad","dish/caesar-salad"],["California Grill","dish/california-grill"],["Camp Washington Chili","dish/camp-washington-chili"],["Caramel apple","dish/caramel-apple"],["Carbonara","dish/carbonara"],["Carnation Cafe","dish/carnation-cafe"],["Cheesesteak","dish/cheesesteak"],["Chicago-style hot dog","dish/chicago-style-hot-dog"],["Chicken nugget","dish/chicken-nugget"],["Chiffon cake","dish/chiffon-cake"],["Chili con carne","dish/chili-con-carne"]]}]},"ingredient/cheese-sauce":{"t":"ingredient","r":"ingredient/cheese-sauce","n":"Cheese sauce","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Cheese sauce is a sauce made with cheese or processed cheese as a primary ingredient. Sometimes dried cheese or powdered cheese is used. Several varieties exist and it has many various culinary uses. Mass-produced commercial cheese sauces are also made by various companies, in both liquid and dry forms. These prepared sauces are used by consumers and restaurants, and commercial formulations are used in the production of various prepared foods, such as macaroni and cheese mixes and frozen meals."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-cheese-sauce"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cheese_sauce"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Mexican cuisine","cuisine/mexican-cuisine",[["Nachos","dish/nachos"]]]]},{"h":"Often cooked with","links":[["Cheese","ingredient/cheese"],["Tortilla chip","ingredient/tortilla-chip"],["Tortilla chips","ingredient/tortilla-chips"]]}]},"dish/smorgastarta":{"t":"dish","r":"dish/smorgastarta","n":"Smörgåstårta","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 4 cuisines","dot":"#cf5f87","intro":[["Smörgåstårta, or sandwich cake (Finnish: voileipäkakku; Estonian: võileivatort; Icelandic: brauðterta), is a savoury main dish, not a dessert, of Swedish origin, popular in Sweden, Finland, Estonia, and Iceland, etc. The name is quite literal, with the dish consisting of a cake-like dish, mainly festive, but composed of layers of bread bound with large amounts of sandwich filling and garnish, structurally similar to a layered cream cake, but culinarily more in line with Toast Skagen. When eaten, it is sliced and served like any other cake."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-smorgastarta"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sm%C3%B6rg%C3%A5st%C3%A5rta"}],"sections":[{"h":"Where it's from","links":[["Estonian cuisine","cuisine/estonian-cuisine"],["Finnish cuisine","cuisine/finnish-cuisine"],["Icelandic cuisine","cuisine/icelandic-cuisine"],["Swedish cuisine","cuisine/swedish-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Egg","ingredient/egg"],["Mayonnaise","ingredient/mayonnaise"],["Rye bread","ingredient/rye-bread"]]},{"h":"Cook it","rows":[{"name":"Estonian Cuisine","ref":"site/estoniancuisine-com","color":"#55b8ad","shape":"site","sub":"estoniancuisine.com","note":"English-language blog dedicated to Estonian home recipes.","url":"https://estoniancuisine.com/about-estonian-food-blog/","suggested":true},{"name":"Scandicuisine: Swedish recipes","ref":"site/scandicuisine-com","color":"#55b8ad","shape":"site","sub":"scandicuisine.com","note":"Traditional Swedish recipes from Cecilia, a cook from a Finnish-Swedish family on Åland.","url":"https://scandicuisine.com/category/swedish-recipes","suggested":true}]},{"h":"More from Estonian cuisine","links":[["Aspic","dish/aspic"],["Cabbage roll","dish/cabbage-roll"],["Egg butter","dish/egg-butter"],["Glögg","dish/glogg"],["Kvass","dish/kvass"]]}]},"dish/steak-tartare":{"t":"dish","r":"dish/steak-tartare","n":"Steak tartare","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 7 cuisines","dot":"#94bd5c","intro":[["Steak tartare, or tartar steak, is a French dish of raw ground (minced) beef. It is usually served with onions, capers, parsley or chive, salt, pepper, Worcestershire sauce and other seasonings, often presented separately, to be added to taste. It is commonly served topped with a raw egg yolk. It is similar to Piedmontese battuta al coltello, as well as Levantine kibbeh nayyeh, Ethiopian kitfo, Turkish çiğ köfte, German Mett and Korean yukhoe."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-steak-tartare"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Steak_tartare"