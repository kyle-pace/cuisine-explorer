ale","dish/tamale"],["Vallarta Supermarkets","dish/vallarta-supermarkets"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/d8/Dulce_de_membrillo.jpg/500px-Dulce_de_membrillo.jpg","w":500,"h":500,"by":"Asturnut at English Wikipedia","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Dulce_de_membrillo.jpg"}},"ingredient/gyokuro":{"t":"ingredient","r":"ingredient/gyokuro","n":"Gyokuro","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Gyokuro is a type of green tea from Japan. It differs from the standard sencha (a classic green tea grown in the sun) in being grown under the shade rather than the full sun. The name \"gyokuro\" translates as \"jewel dew\" (or \"jade dew\"). According to the Japan Tea Central Association, gyokuro is defined as \"a tea manufactured in the same manner as sencha from tea leaves picked from covered tea gardens that are almost completely shaded from sunlight for about 20 days using covering materials such as reed screens, straw, or shading nets, from the time when the new shoots of the first flush start to grow.\""]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-gyokuro"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Gyokuro"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Japanese cuisine","cuisine/japanese-cuisine",[["Sencha","dish/sencha"]]]]},{"h":"Often cooked with","links":[["Bancha","ingredient/bancha"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e0/Gyokuro_img_0067.jpg/500px-Gyokuro_img_0067.jpg","w":500,"h":500,"by":"Rama","lic":"CC BY-SA 2.0 fr","licUrl":"https://creativecommons.org/licenses/by-sa/2.0/fr/deed.en","page":"https://commons.wikimedia.org/wiki/File:Gyokuro_img_0067.jpg"}},"cookbook/cocina-criolla":{"t":"book","r":"cookbook/cocina-criolla","n":"Cocina criolla","c":"#f0b340","crumb":[["Cookbooks","cookbooks"]],"sub":"Cookbook by Carmen Aboy Valldejuli","square":true,"suggested":true,"intro":[["Long-standing reference of Puerto Rican cooking, also published in English as Puerto Rican Cookery."]],"actions":[{"kind":"out","url":"https://openlibrary.org/books/OL6181464M/Cocina_criolla.","label":"Publisher or book page"}],"sections":[{"h":"Cuisines it covers","count":1,"links":[["Puerto Rican cuisine","cuisine/puerto-rican-cuisine"]]}]},"cookbook/sicily-from-the-silver-spoon":{"t":"book","r":"cookbook/sicily-from-the-silver-spoon","n":"Sicily: From The Silver Spoon","c":"#f0b340","crumb":[["Cookbooks","cookbooks"]],"sub":"Cookbook by The Silver Spoon Kitchen","square":true,"suggested":true,"intro":[["Phaidon's regional Sicilian recipe collection."]],"actions":[{"kind":"out","url":"https://www.phaidon.com/en-us/products/sicily-from-the-silver-spoon","label":"Publisher or book page"}],"sections":[{"h":"Cuisines it covers","count":1,"links":[["Sicilian cuisine","cuisine/sicilian-cuisine"]]}]}}