{"cuisine/minnan-cuisine":{"t":"cuisine","r":"cuisine/minnan-cuisine","n":"Minnan cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Min cuisine","cuisine/fujian-cuisine"]],"sub":"Regional cuisine in China","intro":[],"src":null,"wiki":"Minnan cuisine","actions":[{"kind":"globe","hash":"minnan-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Minnan_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Min cuisine","cuisine/fujian-cuisine"]]},{"h":"Part of","links":[["Min cuisine","cuisine/fujian-cuisine"]]}],"cont":"Asian cuisine"},"cuisine/chinese-latin-american-cuisine":{"t":"cuisine","r":"cuisine/chinese-latin-american-cuisine","n":"Latin American Chinese cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Chinese cuisine","cuisine/chinese-cuisine"]],"sub":"Diaspora cuisine in China","intro":[["Chinese Latin American or Chino-Latino cuisine, associated with Asian Latin Americans of Chinese origin, combines elements of Chinese cuisine with other Latin American influences. It is found in Chinese communities and Chinatowns across Latin America, including Peru (where it is known as chifa) and Cuba. It has spread to the United States with the migration of Asian Latin Americans, particularly the migration of Chinese Cubans to New York City."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"chinese-latin-american-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chinese_Latin_American_cuisine"}],"sections":[{"h":"Recipe sites","count":2,"rows":[{"name":"Peru Delights","color":"#55b8ad","shape":"site","sub":"perudelights.com","note":"Chifa (Chinese Peruvian) recipes on a long-running Peruvian home cooking blog.","url":"https://perudelights.com/tag/chifa-recipes/","suggested":true,"kind":"blog"},{"name":"Cecilia Tupac: Chifa","color":"#55b8ad","shape":"site","sub":"en.ceciliatupac.com","note":"Chifa section on the site of Peruvian cook Cecilia Tupac.","url":"https://en.ceciliatupac.com/chifa-peruano","suggested":true,"kind":"site"}]},{"h":"Part of","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Within Latin American Chinese cooking","count":4,"links":[["Cuban Chinese cuisine","cuisine/chinese-latin-american-cuisine-cuba"],["Mexican Chinese cuisine","cuisine/mexican-chinese-cuisine"],["Peruvian-Chinese cuisine","cuisine/chifa"],["Puerto Rican Chinese cuisine","cuisine/puerto-rican-chinese-cuisine"]]}],"cont":"Asian cuisine"},"cuisine/scottish-cuisine":{"t":"cuisine","r":"cuisine/scottish-cuisine","n":"Scottish cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["British cuisine","cuisine/british-cuisine"]],"sub":"Regional cuisine in United Kingdom","intro":[["Scottish cuisine encompasses the cooking styles, traditions and recipes associated with Scotland. It has distinctive attributes and recipes of its own, but also shares much with other British and wider European cuisine as a result of local, regional, and continental influences — both ancient and modern."],["Scotland's natural larder of vegetables, fruit, oats, fish and other seafood, dairy products and game is the chief factor in traditional Scottish cooking, with a high reliance on simplicity, generally without the use of rare (and historically expensive) spices found abroad."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"scottish-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Scottish_cuisine"}],"sections":[{"h":"Dishes","count":12,"links":[["Clootie dumpling","dish/clootie-dumpling"],["Cock-a-leekie","dish/cock-a-leekie"],["Finnan haddie","dish/finnan-haddie"],["Haggis","dish/haggis"],["Haggis pakora","dish/haggis-pakora"],["Hobnob biscuit","dish/hobnob-biscuit"],["Lorne sausage","dish/lorne-sausage"],["Mince and tatties","dish/mince-and-tatties"],["Rumbledethumps","dish/rumbledethumps"],["Scotch broth","dish/scotch-broth"],["Skirlie","dish/skirlie"],["Stornoway black pudding","dish/stornoway-black-pudding"]]},{"h":"Recipe sites","count":2,"rows":[{"name":"Scottish Scran","color":"#55b8ad","shape":"site","sub":"scottishscran.com","note":"Blog working through traditional Scottish dishes one recipe at a time.","url":"https://scottishscran.com","suggested":true,"kind":"blog"},{"name":"Something Sweet Something Savoury: Scottish recipes","color":"#55b8ad","shape":"site","sub":"somethingsweetsomethingsavoury.com","note":"Scottish home baking and cooking section of a UK food blog.","url":"https://somethingsweetsomethingsavoury.com/category/scottish-recipes/","suggested":true,"kind":"blog"}]},{"h":"Cookbooks","count":1,"rows":[{"name":"The Scots Kitchen","color":"#f0b340","shape":"book","sub":"F. Marian McNeill, 1929","note":"Classic history of Scottish food traditions with recipes.","url":"","suggested":true}]},{"h":"Key ingredients","links":[["Suet","ingredient/suet"],["Onion","ingredient/onion"],["Oatmeal","ingredient/oatmeal"],["Offal","ingredient/offal"],["Dried fruit","ingredient/dried-fruit"],["Milk","ingredient/milk"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"],["Broth","ingredient/broth"],["Chicken stock","ingredient/chicken-stock"],["Leek","ingredient/leek"],["Haddock","ingredient/haddock"],["Sausage casing","ingredient/sausage-casing"],["Besan","ingredient/besan"],["Gram flour","ingredient/gram-flour"],["Haggis","ingredient/haggis"],["Yogurt","ingredient/yogurt"],["Rolled oats","ingredient/rolled-oats"],["Ground meat","ingredient/ground-meat"],["Zwieback","ingredient/zwieback"],["Mashed potatoes","ingredient/mashed-potatoes"],["Minced beef","ingredient/minced-beef"],["Cabbage","ingredient/cabbage"],["Cheese","ingredient/cheese"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["British cuisine","cuisine/british-cuisine"]]}],"cont":"European cuisine","img":{"src":"/labs/cuisines/img/thumb/6/6d/Burns_Supper_-_January_25th_2024.jpg/500px-Burns_Supper_-_January_25th_2024.jpg","w":500,"h":500,"by":"Evelyn Hollow","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Burns_Supper_-_January_25th_2024.jpg"}},"cuisine/haudenosaunee-foodways":{"t":"cuisine","r":"cuisine/haudenosaunee-foodways","n":"Haudenosaunee foodways","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Native American cuisine","cuisine/native-american-cuisine"]],"sub":"Indigenous foodways, Upstate New York and the eastern Great Lakes","names":"Haudenosaunee","intro":[["For the Haudenosaunee, among them the Seneca, Mohawk, Oneida, Onondaga and Tuscarora, white corn has been prized for about a thousand years. It grows with beans and squash as the ",["Three Sisters","ingredient/three-sisters-agriculture"],", and women have long led nearly every step of growing and preparing it."],["The corn is planted, picked and husked by hand, braided and hung to dry, then hulled, traditionally with hardwood ash, into ",["hulled corn","ingredient/hominy"]," for soups and stews. Roasted and stone ground, it becomes a nutty flour for mush, bread and baking. At Ganondagan in Victor, New York, the Iroquois White Corn Project grows it and encourages Haudenosaunee families to eat it every day, not only on special occasions."]],"src":"note","sources":[{"name":"Ganondagan, About the White Corn Project","url":"https://ganondagan.org/whitecorn/about"},{"name":"Cornell Small Farms Program, An Indigenous corn makes a comeback","url":"https://smallfarms.cornell.edu/2018/06/an-indigenous-corn-makes-a-comeback"}],"actions":[{"kind":"globe","hash":"haudenosaunee-foodways"}],"sections":[{"h":"Recipe sites","count":1,"rows":[{"name":"Iroquois White Corn Project","color":"#55b8ad","shape":"site","sub":"ganondagan.org","note":"Hand-grown white corn, hulled corn and roasted corn flour from Ganondagan, with recipes.","url":"https://ganondagan.org/whitecorn/about","suggested":true}]},{"h":"Part of","links":[["Native American cuisine","cuisine/native-american-cuisine"]]}],"cont":"Cuisine of the Americas"},"ingredient/mango-pickle":{"t":"ingredient","r":"ingredient/mango-pickle","n":"Mango pickle","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Mango pickle is a variety of pickle prepared using mango. It is very popular in South and Southeast Asia. These sour/spicy pickles are also available commercially."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-mango-pickle"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mango_pickle"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indian cuisine","cuisine/indian-cuisine",[["Amba (condiment)","dish/amba-condiment"]]]]},{"h":"Often cooked with","links":[["Mango","ingredient/mango"]]}]},"dish/buuz":{"t":"dish","r":"dish/buuz","n":"Buuz","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Buuz are a type of Mongolian steamed dumpling filled with meat. An example of authentic Mongolian and Buryatian cuisine, the dish is traditionally eaten at home during Tsagaan Sar, the Lunar New Year. In modern times it is also offered at restaurants and small cafes (\"guanz\") throughout the capital city of Ulaanbaatar, sometimes eaten with soy sauce."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-buuz"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Buuz"}],"sections":[{"h":"Where it's from","links":[["Buryat cuisine","cuisine/buryat-cuisine"],["Mongolian cuisine","cuisine/mongolian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Beef","ingredient/beef"],["Lamb","ingredient/lamb"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b1/Buuza_01.jpg/500px-Buuza_01.jpg","w":500,"h":359,"by":"Аркадий Зарубин","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Buuza_01.jpg"}},"dish/esterhazy-torte":{"t":"dish","r":"dish/esterhazy-torte","n":"Esterházy torte","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Hungarian cuisine","dot":"#cf5f87","intro":[["Esterházy torta is a Hungarian cake (torte) named after Prince Paul III Anton Esterházy de Galántha (1786–1866), a member of the Esterházy dynasty and diplomat of the Austrian Empire. It was invented by Budapest confectioners in the late 19th century and soon became one of the most famous cakes in the lands of the Austro-Hungarian Monarchy."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-esterhazy-torte"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Esterh%C3%A1zy_torte"}],"sections":[{"h":"Where it's from","links":[["Hungarian cuisine","cuisine/hungarian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Zsuzsa Is in the Kitchen","color":"#55b8ad","shape":"site","sub":"zsuzsaisinthekitchen.blogspot.com","note":"Hungarian-born home cook's blog of traditional Hungarian recipes.","url":"https://zsuzsaisinthekitchen.blogspot.com/2010/01","suggested":true,"kind":"blog"}]},{"h":"More from Hungarian cuisine","links":[["Arany galuska","dish/arany-galuska"],["Cabbage roll","dish/cabbage-roll"],["Chicken paprikash","dish/chicken-paprikash"],["Goulash","dish/goulash"],["Gulyásleves","dish/gulyasleves"],["Jókai bean soup","dish/jokai-bean-soup"],["Kürtőskalács","dish/kurtoskalacs"],["Lecsó","dish/lecso"],["Liptauer","dish/liptauer"],["Palóc soup","dish/paloc-soup"],["Pörkölt","dish/porkolt"],["Rakott krumpli","dish/rakott-krumpli"],["Rigójancsi","dish/rigojancsi"],["Sour cherry soup","dish/sour-cherry-soup"],["Speckkuchen","dish/speckkuchen"],["Székelykáposzta","dish/szekelykaposzta"],["Tarhonya","dish/tarhonya"],["Trdelník","dish/trdelnik"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e1/Eszterh%C3%A1zy_Torte.JPG/500px-Eszterh%C3%A1zy_Torte.JPG","w":500,"h":429,"by":"Magellan","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Eszterh%C3%A1zy_Torte.JPG"}},"ingredient/baguette":{"t":"ingredient","r":"ingredient/baguette","n":"Baguette","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 2 cuisines","intro":[["A baguette is a long, thin type of bread commonly made from basic lean dough. The dough of the traditional baguette is defined by French law. It is distinguishable by its length and crisp crust."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-baguette"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Baguette"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Italian-American cuisine","cuisine/italian-american-cuisine",[["Garlic bread","dish/garlic-bread"],["Italian beef","dish/italian-beef"]]],["Polish cuisine","cuisine/polish-cuisine",[["Zapiekanka","dish/zapiekanka"]]]]},{"h":"Often cooked with","links":[["Butter","ingredient/butter"],["Garlic","ingredient/garlic"],["Olive oil","ingredient/olive-oil"],["Au jus","ingredient/au-jus"],["Bread roll","ingredient/bread-roll"],["Giardiniera","ingredient/giardiniera"],["Roast beef","ingredient/roast-beef"],["Agaricus bisporus","ingredient/agaricus-bisporus"],["Cheese","ingredient/cheese"],["Fungus","ingredient/fungus"],["Ketchup","ingredient/ketchup"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/86/Baguettes%2C_Paris%2C_France_-_panoramio.jpg/500px-Baguettes%2C_Paris%2C_France_-_panoramio.jpg","w":500,"h":375,"by":"Nick Thweatt","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Baguettes%2C_Paris%2C_France_-_panoramio.jpg"}},"ingredient/tapioca-starch":{"t":"ingredient","r":"ingredient/tapioca-starch","n":"Tapioca starch","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Tapioca is a starch extracted from the tubers of the cassava plant (Manihot esculenta, also known as manioc), a species native to the North and Northeast regions of Brazil, but which is now found in West Africa, Southeast Asia, and elsewhere. It is a perennial shrub adapted to the hot conditions of tropical lowlands. Cassava copes better with poor soils than many other food plants."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tapioca-starch"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tapioca_starch"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Malay cuisine","cuisine/malay-cuisine",[["Lekor","dish/lekor"]]]]},{"h":"Often cooked with","links":[["Fish","ingredient/fish"],["Rastrelliger kanagurta","ingredient/rastrelliger-kanagurta"],["Round sardinella","ingredient/round-sardinella"],["Sago","ingredient/sago"],["Silver-stripe round herring","ingredient/silver-stripe-round-herring"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/4e/Tepung_casava.jpg/500px-Tepung_casava.jpg","w":500,"h":336,"by":"36Lilis","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Tepung_casava.jpg"}},"dish/maldives-fish":{"t":"dish","r":"dish/maldives-fish","n":"Maldives fish","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Maldives fish is cured tuna traditionally produced in Maldives. It is a staple of the Maldivian cuisine, Sri Lankan cuisine, and the cuisine of the Southern Indian states and territories of Lakshadweep, Kerala and Tamil Nadu, and in the past it was one of the main exports from Maldives to Sri Lanka, where it is known as umbalakaḍa (උම්බලකඩ) in Sinhala and masikkaruvadu (மாசிக் கருவாடு) in Tamil. It is also produced in small scale using traditional methods in Lakshadweep Islands in India. It is known as massmin in Lakshadweep."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-maldives-fish"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Maldives_fish"}],"sections":[{"h":"Where it's from","links":[["Maldivian cuisine","cuisine/maldivian-cuisine"],["Sri Lankan cuisine","cuisine/sri-lankan-cuisine"]]},{"h":"Cook it","rows":[{"name":"Lonumedhu","color":"#55b8ad","shape":"site","sub":"lonumedhu.com","note":"Maldivian recipe and food culture site, including reviews of Maldivian cookbooks.","url":"https://lonumedhu.com/node/346","suggested":true,"kind":"site"}]},{"h":"More from Maldivian cuisine","links":[["Thali","dish/thali"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/77/Maldive_fish91.JPG/500px-Maldive_fish91.JPG","w":500,"h":366,"by":"Xavier Romero-Frias","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Maldive_fish91.JPG"}},"ingredient/lima-beans":{"t":"ingredient","r":"ingredient/lima-beans","n":"Lima beans","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A lima bean (Phaseolus lunatus), also commonly known as butter bean, sieva bean, double bean or Madagascar bean, is a legume grown for its edible seeds or beans."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-lima-beans"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lima_beans"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Valencian cuisine","cuisine/valencian-cuisine",[["Paella","dish/paella"]]]]},{"h":"Often cooked with","links":[["Chicken","ingredient/chicken"],["Green bean","ingredient/green-bean"],["Lima bean","ingredient/lima-bean"],["Olive oil","ingredient/olive-oil"],["Rabbit meat","ingredient/rabbit-meat"],["Rice","ingredient/rice"],["Rice as food","ingredient/rice-as-food"],["Saffron","ingredient/saffron"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/9b/Phaseoulus_lunatus.jpg/500px-Phaseoulus_lunatus.jpg","w":500,"h":326,"by":"Howard F. Schwartz, Colorado State University, Bugwood.org","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Phaseoulus_lunatus.jpg"}},"ingredient/rice-as-food":{"t":"ingredient","r":"ingredient/rice-as-food","n":"Rice as food","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Rice is commonly consumed as food around the world. It occurs in long-, medium-, and short-grained types. It is the staple food of over half the world's population."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-rice-as-food"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rice_as_food"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Valencian cuisine","cuisine/valencian-cuisine",[["Paella","dish/paella"]]]]},{"h":"Often cooked with","links":[["Chicken","ingredient/chicken"],["Green bean","ingredient/green-bean"],["Lima bean","ingredient/lima-bean"],["Lima beans","ingredient/lima-beans"],["Olive oil","ingredient/olive-oil"],["Rabbit meat","ingredient/rabbit-meat"],["Rice","ingredient/rice"],["Saffron","ingredient/saffron"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/d6/Meshi_001.jpg/500px-Meshi_001.jpg","w":500,"h":476,"by":"Ocdp","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Meshi_001.jpg"}},"ingredient/consomme":{"t":"ingredient","r":"ingredient/consomme","n":"Consommé","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Consommé (French: [kɔ̃sɔme] () is a type of clear soup made from richly flavoured stock or broth that has been clarified, a process that traditionally uses egg whites to remove fat and sediment. A later technique for clarification employs gelatin filtration. Consommés are most commonly made from beef or veal, but chicken, fish and game variants are recognised in French cuisine. They may be served on their own – hot or chilled – or be used as the basis of many soups, sauces and stews."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-consomme"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Consomm%C3%A9"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Mexican cuisine","cuisine/mexican-cuisine",[["Quesabirria","dish/quesabirria"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Cheese","ingredient/cheese"],["Tortilla","ingredient/tortilla"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/43/Consomme_de_volaille.jpg/500px-Consomme_de_volaille.jpg","w":500,"h":357,"by":"Kui-Doraku","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Consomme_de_volaille.jpg"}},"ingredient/apricots":{"t":"ingredient","r":"ingredient/apricots","n":"Apricots","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["An apricot is a fruit, or the tree that bears the fruit, of several species in the genus Prunus. Usually an apricot is from the species Prunus armeniaca, but the fruits of the other species in Prunus sect. Armeniaca are also called apricots. In 2023, world production of apricots was 3.7 million tonnes, led by Turkey with 20% of the total."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-apricots"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Apricots"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Algerian cuisine","cuisine/algerian-cuisine",[["Tajine lham-lahlou","dish/tajine-lham-lahlou"]]],["Moroccan cuisine","cuisine/moroccan-cuisine",[["Tajine lham-lahlou","dish/tajine-lham-lahlou"]]]]},{"h":"Often cooked with","links":[["Prunes","ingredient/prunes"]]}]},"ingredient/strained-yogurt":{"t":"ingredient","r":"ingredient/strained-yogurt","n":"Strained yogurt","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 4 cuisines","intro":[["Strained yogurt, Labneh, Greek or Greek-style yogurt, yogurt cheese, sack yogurt, hung curd, or kerned yogurt is yogurt (or \"yoghurt\") that has been strained to remove most of its whey, making it thicker while preserving its sour taste. In Europe and North America, it is often made from low-fat or fat-free cow's milk. In Iceland a similar product named skyr is made. Labneh is a strained yogurt thicker than Greek yogurt."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-strained-yogurt"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Strained_yogurt"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Balkan cuisine","cuisine/balkan-cuisine",[["Tarator","dish/tarator"]]],["Bulgarian cuisine","cuisine/bulgarian-cuisine",[["Tarator","dish/tarator"]]],["Greek cuisine","cuisine/greek-cuisine",[["Tzatziki","dish/tzatziki"]]],["Macedonian cuisine","cuisine/macedonian-cuisine",[["Tarator","dish/tarator"]]]]},{"h":"Often cooked with","links":[["Cucumber","ingredient/cucumber"],["Olive oil","ingredient/olive-oil"],["Garlic","ingredient/garlic"],["Juglans regia","ingredient/juglans-regia"],["Qatiq","ingredient/qatiq"],["Walnut","ingredient/walnut"],["Yogurt","ingredient/yogurt"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/2c/Labneh01.jpg/500px-Labneh01.jpg","w":500,"h":375,"by":"No machine-readable author provided. Omernos~commonswiki assumed (based on copyright…","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Labneh01.jpg"}},"ingredient/fish-cake":{"t":"ingredient","r":"ingredient/fish-cake","n":"Fish cake","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["A fishcake (sometimes written as fish cake) is a culinary dish consisting of filleted fish or other seafood minced or ground, mixed with a starchy ingredient, and fried until golden. They can also frequently be oven-baked."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-fish-cake"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fish_cake"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Tekwan","dish/tekwan"]]],["Palembang cuisine","cuisine/palembang-cuisine",[["Tekwan","dish/tekwan"]]]]},{"h":"Often