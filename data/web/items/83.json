gredients"]],"sub":"Ingredient in 3 dishes across 5 cuisines","intro":[["A crouton or croûton () is a toasted or fried cube or slice of bread. Croutons are used in salads, as garnishes for soups and stews, and as a snack food."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-crouton"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Crouton"}],"sections":[{"h":"Where it's cooked with","count":5,"groups":[["French cuisine","cuisine/french-cuisine",[["Bouillabaisse","dish/bouillabaisse"],["French onion soup","dish/french-onion-soup"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Bouillabaisse","dish/bouillabaisse"],["French onion soup","dish/french-onion-soup"]]],["American cuisine","cuisine/american-cuisine",[["Caesar salad","dish/caesar-salad"]]],["Italian cuisine","cuisine/italian-cuisine",[["Caesar salad","dish/caesar-salad"]]],["Russian cuisine","cuisine/russian-cuisine",[["Caesar salad","dish/caesar-salad"]]]]},{"h":"Often cooked with","links":[["Olive oil","ingredient/olive-oil"],["European conger","ingredient/european-conger"],["Fish","ingredient/fish"],["Rouille","ingredient/rouille"],["Scorpionfish","ingredient/scorpionfish"],["Sea robin","ingredient/sea-robin"],["Tomato","ingredient/tomato"],["White wine","ingredient/white-wine"],["Wine","ingredient/wine"],["Anchovy","ingredient/anchovy"],["Black pepper","ingredient/black-pepper"],["Dijon mustard","ingredient/dijon-mustard"],["Egg","ingredient/egg"],["Lemon juice","ingredient/lemon-juice"],["Parmesan","ingredient/parmesan"],["Parmigiano-Reggiano","ingredient/parmigiano-reggiano"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e3/Croutons_on_a_salad.jpg/500px-Croutons_on_a_salad.jpg","w":500,"h":281,"by":"Josh Truelson","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Croutons_on_a_salad.jpg"}},"dish/bulemas":{"t":"dish","r":"dish/bulemas","n":"Bulemas","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Sephardic Jewish cuisine","dot":"#f0b340","intro":[["Bulemas or boulemas, also rodanches or burmaikos, are a traditional baked pastry in Sephardic Jewish cuisine. They are made from a thinly stretched yeast dough, filled with a savory mixture, and then rolled into a spiral shape. Once baked, the pastry has a delicate and flaky texture akin to that of phyllo-based pastries, like the Turkish Kol böreği and the Greek spanakopita."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-bulemas"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bulemas"}],"sections":[{"h":"Where it's from","links":[["Sephardic Jewish cuisine","cuisine/sephardic-jewish-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Feta cheese","ingredient/feta-cheese"],["Kashkaval","ingredient/kashkaval"]]},{"h":"More from Sephardic Jewish cuisine","links":[["Apio (appetizer)","dish/apio-appetizer"],["Fritas de prasa","dish/fritas-de-prasa"]]}]},"dish/carbonara":{"t":"dish","r":"dish/carbonara","n":"Carbonara","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#94bd5c","intro":[["Carbonara is a pasta dish made with cured pork, hard cheese, eggs, salt, and black pepper. It is typical of the Lazio region of Italy. The dish took its modern form and name in the middle of the 20th century."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-carbonara"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Carbonara"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"],["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Ingredients","count":9,"links":[["Black pepper","ingredient/black-pepper"],["Egg","ingredient/egg"],["Guanciale","ingredient/guanciale"],["Pancetta","ingredient/pancetta"],["Pasta","ingredient/pasta"],["Pecorino","ingredient/pecorino"],["Pecorino romano","ingredient/pecorino-romano"],["Peppercorn","ingredient/peppercorn"],["Spaghetti","ingredient/spaghetti"]]},{"h":"Cook it","rows":