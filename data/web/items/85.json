edia","actions":[{"kind":"globe","hash":"dish-paensae"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Paensae"}],"sections":[{"h":"Where it's from","links":[["North Korean cuisine","cuisine/north-korean-cuisine"]]},{"h":"More from North Korean cuisine","links":[["Injo-gogi-bap","dish/injo-gogi-bap"],["Pyeonsu","dish/pyeonsu"],["Pyongyang Raengmyon","dish/pyongyang-raengmyon"],["Sungeo-guk","dish/sungeo-guk"]]}]},"dish/peremech":{"t":"dish","r":"dish/peremech","n":"Peremech","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 4 cuisines","dot":"#f0b340","intro":[["Peremech is an individual-sized fried dough pastry common in Volga Tatar and Bashkir cuisines. It is made from unleavened or leavened dough and usually filled with ground meat and chopped onion. Originally, finely chopped pre-cooked meat was used as a filling, but later raw ground meat became more common. Alternatively, peremech can be filled with potato or quark."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-peremech"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Peremech"}],"sections":[{"h":"Where it's from","links":[["Bashkir cuisine","cuisine/bashkir-cuisine"],["Kazakh cuisine","cuisine/kazakh-cuisine"],["Soviet cuisine","cuisine/soviet-cuisine"],["Tatar cuisine","cuisine/tatar-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Beef","ingredient/beef"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"More from Bashkir cuisine","links":[["Beshbarmak","dish/beshbarmak"],["Echpochmak","dish/echpochmak"],["Pilaf","dish/pilaf"],["Qazı","dish/qaz"],["Qistibi","dish/qistibi"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/de/Belyashi_2.jpg/500px-Belyashi_2.jpg","w":500,"h":336,"by":"Йоля @ nyam.ru ; cropped by Off-shell","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Belyashi_2.jpg"}},"dish/salsa-golf":{"t":"dish","r":"dish/salsa-golf","n":"Salsa golf","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Argentine cuisine","dot":"#94bd5c","intro":[["Salsa golf is a cold sauce of somewhat thick consistency, common in Argentina. It is made from mayonnaise with a smaller amount of tomato-based sauce such as ketchup, as well as seasonings including pimento, oregano, and cumin. The mixture can also include Worcestershire sauce and mustard."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-salsa-golf"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Salsa_golf"}],"sections":[{"h":"Where it's from","links":[["Argentine cuisine","cuisine/argentine-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Cumin","ingredient/cumin"],["Ketchup","ingredient/ketchup"],["Mayonnaise","ingredient/mayonnaise"],["Oregano","ingredient/oregano"],["Pimento","ingredient/pimento"]]},{"h":"Cook it","rows":[{"name":"Familia Kitchen: Argentina","color":"#55b8ad","shape":"site","sub":"familiakitchen.com","note":"Argentine recipes and stories on a Latino family cooking site.","url":"https://familiakitchen.com/destination/argentina/","suggested":true,"kind":"site"}]},{"h":"More from Argentine cuisine","links":[["Anticucho","dish/anticucho"],["Argentine pizza","dish/argentine-pizza"],["Asado","dish/asado"],["Bara brith","dish/bara-brith"],["Bondiola sandwich","dish/bondiola-sandwich"],["Cabbage roll","dish/cabbage-roll"],["Dulce de batata","dish/dulce-de-batata"],["Fugazza","dish/fugazza"],["Jesuita (sandwich)","dish/jesuita-sandwich"],["Jésuite","dish/jesuite"],["Matambre","dish/matambre"],["Puchero","dish/puchero"],["Rogel (cake)","dish/rogel-cake"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/53/Salsa_golf.jpg/500px-Salsa_golf.jpg","w":500,"h":750,"by":"dana robinson","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Salsa_golf.jpg"}},"dish/spanakorizo":{"t":"dish","r":"dish/spanakorizo","n":"Spanakorizo","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Greek cuisine","dot":"#cf5f87","intro":[["Spanakorizo is a Greek vegetarian dish of spinach and rice. A pilaf, it is described as a typical Greek country dish that may be eaten hot or cold."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-spanakorizo"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Spanakorizo"}],"sections":[{"h":"Where it's from","links":[["Greek cuisine","cuisine/greek-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Feta","ingredient/feta"],["Lemon","ingredient/lemon"],["Olive oil","ingredient/olive-oil"],["Peppercorn","ingredient/peppercorn"],["Rice","ingredient/rice"],["Spinach","ingredient/spinach"]]},{"h":"Cook it","rows":[{"name":"Dimitra's Dishes","color":"#55b8ad","shape":"site","sub":"dimitrasdishes.com","note":"Dimitra Alfieris's video channel and blog focused on classic Greek home cooking.","url":"https://dimitrasdishes.com","suggested":true,"kind":"youtube"}]},{"h":"More from Greek cuisine","links":[["Avgolemono","dish/avgolemono"],["Baba ghanoush","dish/baba-ghanoush"],["Bouyiourdi","dish/bouyiourdi"],["Cabbage roll","dish/cabbage-roll"],["Diples","dish/diples"],["Fasolada","dish/fasolada"],["Freddo cappuccino","dish/freddo-cappuccino"],["Greek restaurant","dish/greek-restaurant"],["Greek salad","dish/greek-salad"],["İmam bayıldı","dish/imam-bay-ld"],["Kakavia (soup)","dish/kakavia-soup"],["Kalitsounia","dish/kalitsounia"],["Karydopita","dish/karydopita"],["Keşkek","dish/keskek"],["Ladera","dish/ladera"],["Noumboulo","dish/noumboulo"],["Psarosoupa","dish/psarosoupa"],["Taramasalata","dish/taramasalata"],["Tzatziki","dish/tzatziki"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/ac/Spanakorizo.jpg/500px-Spanakorizo.jpg","w":500,"h":375,"by":"KaterinaStrak","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Spanakorizo.jpg"}},"dish/tahu-goreng":{"t":"dish","r":"dish/tahu-goreng","n":"Tahu goreng","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Malay cuisine","dot":"#f0b340","intro":[["Tahu goreng (Indonesian spelling) or tauhu goreng (Bruneian, Malaysian and Singaporean spelling) is a generic name for any type of fried tofu dish in the cuisines of Indonesia, Brunei, Malaysia and Singapore."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-tahu-goreng"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tahu_goreng"}],"sections":[{"h":"Where it's from","links":[["Malay cuisine","cuisine/malay-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Tofu","ingredient/tofu"]]},{"h":"More from Malay cuisine","links":[["Akok (food)","dish/akok-food"],["Ikan bakar","dish/ikan-bakar"],["Karas (food)","dish/karas-food"],["Ketupat","dish/ketupat"],["Lekor","dish/lekor"],["Mee siput","dish/mee-siput"],["Nasi Ayam","dish/nasi-ayam"],["Nasi kerabu","dish/nasi-kerabu"],["Nasi tumpang","dish/nasi-tumpang"],["Roti jala","dish/roti-jala"],["Sata (food)","dish/sata-food"],["Ulam (salad)","dish/ulam-salad"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/1d/Tahu_digoreng.JPG/500px-Tahu_digoreng.JPG","w":500,"h":375,"by":"Sakurai Midori","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Tahu_digoreng.JPG"}},"dish/tarator":{"t":"dish","r":"dish/tarator","n":"Tarator","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#cf5f87","intro":[["Tzatziki, also known as cacık (Turkish: [dʒaˈdʒɯk] ) or tarator, is a class of dip, soup, or sauce found in the cuisines of Southeastern Europe and West Asia. It is made of salted strained yogurt or diluted yogurt mixed with cucumbers, garlic, salt, olive oil, red wine vinegar, sometimes with lemon juice, and herbs such as dill, mint, parsley and thyme. It is served as a cold appetiser (meze), a side dish, and as a sauce for souvlaki and gyros sandwiches and other foods."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-tarator"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tarator"}],"sections":[{"h":"Where it's from","links":[["Balkan cuisine","cuisine/balkan-cuisine"],["Bulgarian cuisine","cuisine/bulgarian-cuisine"],["Macedonian cuisine","cuisine/macedonian-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Cucumber","ingredient/cucumber"],["Garlic","ingredient/garlic"],["Juglans regia","ingredient/juglans-regia"],["Olive oil","ingredient/olive-oil"],["Qatiq","ingredient/qatiq"],["Strained yogurt","ingredient/strained-yogurt"],["Walnut","ingredient/walnut"]]},{"h":"More from Balkan cuisine","links":[["Ajvar","dish/ajvar"],["Ayran","dish/ayran"],["Stuffed tomatoes","dish/stuffed-tomatoes"],["Torshi","dish/torshi"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/19/TaratorBg.jpg/500px-TaratorBg.jpg","w":500,"h":436,"by":"Ikonact","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:TaratorBg.jpg"}},"dish/vegetarianism":{"t":"dish","r":"dish/vegetarianism","n":"Vegetarianism","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Vegetarian cuisine","dot":"#a99fb5","intro":[["Vegetarianism is the practice of abstaining from the consumption of meat (red meat, poultry, seafood, freshwater fish, insects, and the flesh of any other animal). It may also include abstaining from eating all by-products of animal slaughter. A person who practices vegetarianism is known as a vegetarian."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-vegetarianism"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Vegetarianism"}],"sections":[{"h":"Where it's from","links":[["Vegetarian cuisine","cuisine/vegetarian-cuisine"]]},{"h":"More from Vegetarian cuisine","links":[["Morningstar Farms","dish/morningstar-farms"],["Plant-based food","dish/plant-based-food"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e9/Soy-whey-protein-diet.jpg/500px-Soy-whey-protein-diet.jpg","w":500,"h":327,"by":"Peggy Greb, USDA ARS","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Soy-whey-protein-diet.jpg"}}}