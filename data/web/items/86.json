,"dish/handpulled-noodle"],["Harbor City Restaurant","dish/harbor-city-restaurant"],["Heichinrou","dish/heichinrou"],["HK Cafe","dish/hk-cafe"],["Hog maw","dish/hog-maw"],["Hong dou tang","dish/hong-dou-tang"],["Hot dry noodles","dish/hot-dry-noodles"],["Hot pot","dish/hot-pot"],["Hotcha (company)","dish/hotcha-company"]]}]},"ingredient/protein-nutrient":{"t":"ingredient","r":"ingredient/protein-nutrient","n":"Protein_(nutrient)","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Proteins are essential nutrients for the human body. They are one of the constituents of body tissue and also serve as a fuel source. As fuel, proteins have the same energy density as carbohydrates: 17 kJ (4 kcal) per gram.  From a nutritional perspective, the defining characteristic of protein is its amino acid composition. Protein content in foods is commonly measured based on nitrogen content, as nitrogen is a fundamental component of amino acids."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-protein-nutrient"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Protein_(nutrient)"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["American cuisine","cuisine/american-cuisine",[["Taco","dish/taco"]]],["Mexican cuisine","cuisine/mexican-cuisine",[["Taco","dish/taco"]]]]},{"h":"Often cooked with","links":[["Corn tortilla","ingredient/corn-tortilla"],["Flour tortilla","ingredient/flour-tortilla"],["Tortilla","ingredient/tortilla"]]}]},"ingredient/rhizopus-oligosporus":{"t":"ingredient","r":"ingredient/rhizopus-oligosporus","n":"Rhizopus oligosporus","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Rhizopus oligosporus is a fungus of the family Mucoraceae and is a widely used starter culture for the production of tempeh at home and industrially. As the mold grows it produces fluffy, white mycelia, binding the beans together to create an edible \"cake\" of partly catabolized soybeans. The domestication of the microbe is thought to have occurred in Indonesia several centuries ago."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-rhizopus-oligosporus"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rhizopus_oligosporus"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Tempeh","dish/tempeh"]]]]},{"h":"Often cooked with","links":[["Acetic acid","ingredient/acetic-acid"],["Rhizopus","ingredient/rhizopus"],["Soybean","ingredient/soybean"]]}]},"ingredient/flammulina-filiformis":{"t":"ingredient","r":"ingredient/flammulina-filiformis","n":"Flammulina filiformis","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Flammulina filiformis, commonly called enoki mushroom or enokitake, is a species of agaric (gilled mushroom) in the family Physalacriaceae. Until recently, the species was considered to be conspecific with the European Flammulina velutipes, but DNA sequencing has shown that the two are distinct."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-flammulina-filiformis"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Flammulina_filiformis"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Japanese cuisine","cuisine/japanese-cuisine",[["Tempura","dish/tempura"]]]]},{"h":"Often cooked with","links":[["Bivalvia","ingredient/bivalvia"],["Egg","ingredient/egg"],["Shiitake","ingredient/shiitake"],["Shrimp","ingredient/shrimp"],["Squid","ingredient/squid"],["Wheat flour","ingredient/wheat-flour"]]}]},"dish/wo-hop":{"t":"dish","r":"dish/wo-hop","n":"Wo Hop","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Chinese cuisine","dot":"#f0b340","intro":[["Wo Hop is a Chinese restaurant in Manhattan's Chinatown that was named an American Classic in 2022 by the James Beard Foundation Award.  It is the second-oldest restaurant in Manhattan's Chinatown. The restaurant is located at 17 Mott Street, downstairs entrance."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-wo-hop"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Wo_Hop"}],"sections":[{"h":"Where it's from","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Cook it","rows":[{"name":"The Woks of Life","ref":"site/thewoksoflife-com","color":"#55b8ad","shape":"site","sub":"thewoksoflife.com","note":"Chinese and Chinese American recipes from the Leung family, running since 2013.","url":"https://thewoksoflife.com/","suggested":true},{"name":"Chinese Cooking Demystified","ref":"site/youtube-com","color":"#55b8ad","shape":"site","sub":"youtube.com","note":"Technique-heavy YouTube channel on regional Chinese home and restaurant cooking.","url":"https://www.youtube.com/@ChineseCookingDemystified","suggested":true},{"name":"Red House Spice","ref":"site/redhousespice-com","color":"#55b8ad","shape":"site","sub":"redhousespice.com","note":"Classic Chinese recipes from Wei Guo, who grew up in Gansu, blogging since 2017.","url":"https://redhousespice.com/about/","suggested":true}]},{"h":"More from Chinese cuisine","links":[["A+ Hong Kong Kitchen","dish/a-hong-kong-kitchen"],["Almond biscuit","dish/almond-biscuit"],["Banana roll","dish/banana-roll"],["Baozi","dish/baozi"],["Bear paw","dish/bear-paw"],["Black sesame roll","dish/black-sesame-roll"],["Century egg","dish/century-egg"],["Cha siu bao","dish/cha-siu-bao"],["Chinese restaurant","dish/chinese-restaurant"],["Chinese Tuxedo","dish/chinese-tuxedo"],["Chowking","dish/chowking"],["Classic Savory","dish/classic-savory"],["Country Dough","dish/country-dough"],["Cuisine AuntDai","dish/cuisine-auntdai"],["Dandan noodles","dish/dandan-noodles"],["Dapanji","dish/dapanji"],["Dim Sum King","dish/dim-sum-king"],["Dong'an chicken","dish/dong-an-chicken"],["Dongpo pork","dish/dongpo-pork"],["Donkey burger","dish/donkey-burger"],["Doujiang","dish/doujiang"],["Drunken shr