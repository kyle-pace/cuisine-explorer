{"cuisine/uzbek-cuisine":{"t":"cuisine","r":"cuisine/uzbek-cuisine","n":"Uzbek cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Cuisine"]],"sub":"National cuisine of Uzbekistan","intro":[["The cuisine of Uzbekistan, also known as Uzbek cuisine, encompasses all traditional and modern cuisines of Uzbekistan. It shares the culinary traditions of peoples across Central Asia. Grain farming is widespread in Uzbekistan, making breads and noodles an important part of the cuisine, which has been described as 'noodle‑rich'."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"uzbek-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Uzbek_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"Cookbooks","count":2,"rows":[{"name":"Samarkand: Recipes and Stories from Central Asia and the Caucasus","ref":"cookbook/samarkand-recipes-and-stories-from-central-asia-and-the-caucasus","color":"#f0b340","shape":"book","sub":"Caroline Eden and Eleanor Ford, 2016","note":"Recipes centered on Uzbekistan and the Silk Road region, with travel writing.","url":"https://openlibrary.org/isbn/9780857833273","suggested":true},{"name":"The Art of Uzbek Cooking","ref":"cookbook/the-art-of-uzbek-cooking","color":"#f0b340","shape":"book","sub":"Lynn Visson","note":"English-language collection of traditional Uzbek recipes.","url":"","suggested":true}]},{"h":"Dishes","count":15,"links":[["Beshbarmak","dish/beshbarmak"],["Bichak","dish/bichak"],["Boortsog","dish/boortsog"],["Chorba","dish/chorba"],["Dimlama","dish/dimlama"],["Dovga","dish/dovga"],["Kuurdak","dish/kuurdak"],["Mastava","dish/mastava"],["Naryn (dish)","dish/naryn-dish"],["Nisholda","dish/nisholda"],["Orama (dish)","dish/orama-dish"],["Pilaf","dish/pilaf"],["Qazı","dish/qaz"],["Samarkand non","dish/samarkand-non"],["Shakarap","dish/shakarap"]]},{"h":"Key ingredients","links":[["Onion","ingredient/onion"],["Wheat flour","ingredient/wheat-flour"],["Egg","ingredient/egg"],["Rice","ingredient/r