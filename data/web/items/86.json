log of traditional Czech home recipes by a Czech cook.","url":"https://cooklikeczechs.com/about/","suggested":true,"kind":"blog"}]},{"h":"More from Czech cuisine","links":[["Buchteln","dish/buchteln"],["Cabbage roll","dish/cabbage-roll"],["Kolach (bread)","dish/kolach-bread"],["Potato pancake","dish/potato-pancake"],["Potato salad","dish/potato-salad"],["Sauerkraut","dish/sauerkraut"],["Steak tartare","dish/steak-tartare"],["Strudel","dish/strudel"],["Székelykáposzta","dish/szekelykaposzta"]]}],"img":{"src":"/world-cuisine/img/thumb/4/40/Kulajda_%281%29.jpg/500px-Kulajda_%281%29.jpg","w":500,"h":375,"by":"Chmee2","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Kulajda_(1).jpg"}},"dish/naporitan":{"t":"dish","r":"dish/naporitan","n":"Naporitan","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Yoshoku","dot":"#f0b340","intro":[["Naporitan or Napolitan is a popular Japanese itameshi pasta dish. The dish consists of soft-cooked spaghetti, tomato ketchup, onion, button mushrooms, green peppers, sausage, bacon and optionally Tabasco sauce. Naporitan is claimed to be from Yokohama."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-naporitan"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Naporitan"}],"sections":[{"h":"Where it's from","links":[["Yoshoku","cuisine/yoshoku"]]},{"h":"Ingredients","count":6,"links":[["Agaricus bisporus","ingredient/agaricus-bisporus"],["Bacon","ingredient/bacon"],["Ketchup","ingredient/ketchup"],["Sausage","ingredient/sausage"],["Spaghetti","ingredient/spaghetti"],["Tabasco sauce","ingredient/tabasco-sauce"]]},{"h":"More from Yoshoku","links":[["Chicken katsu","dish/chicken-katsu"],["Cream stew","dish/cream-stew"],["Doria (food)","dish/doria-food"],["Hayashi rice","dish/hayashi-rice"],["Menchi-katsu","dish/menchi-katsu"],["Tonkatsu","dish/tonkatsu"],["Toruko rice","dish/toruko-rice"],["Volga rice","dish/volga-rice"]]}],"img":{"src":"/world-cuisine/img/thumb/e/e4/Spaghetti_Naporitan_001.jpg/500px-Spaghetti_Naporitan_001.jpg","w":500,"h":332,"by":"Ocdp","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Spaghetti_Naporitan_001.jpg"}},"ingredient/juglans-regia":{"t":"ingredient","r":"ingredient/juglans-regia","n":"Juglans regia","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 4 cuisines","intro":[["Juglans regia, known by various common names including the common walnut, English walnut,  or Persian walnut amongst other names, is a species of walnut. It is native to Eurasia in at least southwest and central Asia and southeast Europe, but its exact natural area is obscure due to its long history of cultivation."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-juglans-regia"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Juglans_regia"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Georgian cuisine","cuisine/georgian-cuisine",[["Nigvziani badrijani","dish/nigvziani-badrijani"],["Pkhali","dish/pkhali"]]],["Balkan cuisine","cuisine/balkan-cuisine",[["Tarator","dish/tarator"]]],["Bulgarian cuisine","cuisine/bulgarian-cuisine",[["Tarator","dish/tarator"]]],["Macedonian cuisine","cuisine/macedonian-cuisine",[["Tarator","dish/tarator"]]]]},{"h":"Often cooked with","links":[["Garlic","ingredient/garlic"],["Eggplant","ingredient/eggplant"],["Satsivi","ingredient/satsivi"],["Beta","ingredient/beta"],["Brassica","ingredient/brassica"],["Onion","ingredient/onion"],["Phaseolus","ingredient/phaseolus"],["Spinacia","ingredient/spinacia"],["Vinegar","ingredient/vinegar"],["Cucumber","ingredient/cucumber"],["Olive oil","ingredient/olive-oil"],["Qatiq","ingredient/qatiq"],["Strained yogurt","ingredient/strained-yogurt"],["Walnut","ingredient/walnut"]]}],"img":{"src":"/world-cuisine/img/thumb/7/74/Noyer_centenaire_en_automne.JPG/500px-Noyer_centenaire_en_automne.JPG","w":500,"h":375,"by":"Thesupermat","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Noyer_centenaire_en_automne.JPG"}},"dish/pasta-alla-norma":{"t":"dish","r":"dish/pasta-alla-norma","n":"Pasta alla Norma","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Sicilian cuisine","dot":"#cf5f87","intro":[["Pasta alla Norma, also called pasta con le melanzane (lit. 'pasta with eggplant'), is a pasta dish made from eggplant. It is typical of Sicilian cuisine, from Catania in particular."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pasta-alla-norma"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pasta_alla_Norma"}],"sections":[{"h":"Where it's from","links":[["Sicilian cuisine","cuisine/sicilian-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Basil","ingredient/basil"],["Eggplant","ingredient/eggplant"],["Garlic","ingredient/garlic"],["Olive oil","ingredient/olive-oil"],["Pasta","ingredient/pasta"],["Ricotta","ingredient/ricotta"],["Tomato sauce","ingredient/tomato-sauce"]]},{"h":"More from Sicilian cuisine","links":[["Busiate","dish/busiate"],["Cassatella di Agira","dish/cassatella-di-agira"],["Crocchè","dish/crocche"],["Iris (pastry)","dish/iris-pastry"],["Maccu","dish/maccu"],["Panella","dish/panella"],["Pani câ meusa","dish/pani-ca-meusa"],["Parmigiana","dish/parmigiana"],["Pasta con le sarde","dish/pasta-con-le-sarde"],["Pasta mollicata","dish/pasta-mollicata"],["Stigghiola","dish/stigghiola"]]}],"img":{"src":"/world-cuisine/img/thumb/e/e4/Pasta_alla_Norma_-_Wiki_Loves_Sicilia.jpg/500px-Pasta_alla_Norma_-_Wiki_Loves_Sicilia.jpg","w":500,"h":360,"by":"8w9d","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Pasta_alla_Norma_-_Wiki_Loves_Sicilia.jpg"}},"ingredient/protein-nutrient":{"t":"ingredient","r":"ingredient/protein-nutrient","n":"Protein_(nutrient)","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Proteins are essential nutrients for the human body. They are one of the constituents of body tissue and also serve as a fuel source. As fuel, proteins have the same energy density as carbohydrates: 17 kJ (4 kcal) per gram.  From a nutritional perspective, the defining characteristic of protein is its amino acid composition. Protein content in foods is commonly measured based on nitrogen content, as nitrogen is a fundamental component of amino acids."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-protein-nutrient"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Protein_(nutrient)"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["American cuisine","cuisine/american-cuisine",[["Taco","dish/taco"]]],["Mexican cuisine","cuisine/mexican-cuisine",[["Taco","dish/taco"]]]]},{"h":"Often cooked with","links":[["Corn tortilla","ingredient/corn-tortilla"],["Flour tortilla","ingredient/flour-tortilla"],["Tortilla","ingredient/tortilla"]]}]},"ingredient/rhizopus-oligosporus":{"t":"ingredient","r":"ingredient/rhizopus-oligosporus","n":"Rhizopus oligosporus","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Rhizopus oligosporus is a fungus of the family Mucoraceae and is a widely used starter culture for the production of tempeh at home and industrially. As the mold grows it produces fluffy, white mycelia, binding the beans together to create an edible \"cake\" of partly catabolized soybeans. The domestication of the microbe is thought to have occurred in Indonesia several centuries ago."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-rhizopus-oligosporus"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rhizopus_oligosporus"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Tempeh","dish/tempeh"]]]]},{"h":"Often cooked with","links":[["Acetic acid","ingredient/acetic-acid"],["Rhizopus","ingredient/rhizopus"],["Soybean","ingredient/soybean"]]}],"img":{"src":"/world-cuisine/img/thumb/e/e3/Tempeh_Rhizopus_oligosporus.JPG/500px-Tempeh_Rhizopus_oligosporus.JPG","w":500,"h":375,"by":"fisherjs","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Tempeh_Rhizopus_oligosporus.JPG"}},"ingredient/flammulina-filiformis":{"t":"ingredient","r":"ingredient/flammulina-filiformis","n":"Flammulina filiformis","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Flammulina filiformis, commonly called enoki mushroom or enokitake, is a species of agaric (gilled mushroom) in the family Physalacriaceae. Until recently, the species was considered to be conspecific with the European Flammulina velutipes, but DNA sequencing has shown that the two are distinct."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-flammulina-filiformis"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Flammulina_filiformis"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Japanese cuisine","cuisine/japanese-cuisine",[["Tempura","dish/tempura"]]]]},{"h":"Often cooked with","links":[["Bivalvia","ingredient/bivalvia"],["Egg","ingredient/egg"],["Shiitake","ingredient/shiitake"],["Shrimp","ingredient/shrimp"],["Squid","ingredient/squid"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/world-cuisine/img/thumb/0/04/Flammulina_velutipes_%28Enokitake%2C_winter_mushroom%29.jpg/500px-Flammulina_velutipes_%28Enokitake%2C_winter_mushroom%29.jpg","w":500,"h":761,"by":"frankenstoen","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Flammulina_velutipes_(Enokitake%2C_winter_mushroom).jpg"}}}