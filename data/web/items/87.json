ago-style-hot-dog":{"t":"dish","r":"dish/chicago-style-hot-dog","n":"Chicago-style hot dog","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["A Chicago-style hot dog, Chicago dog, or Chicago red hot is a hot dog made with a natural casing all-beef frankfurter (most often the Vienna Beef brand), that is typically served on a poppy seed bun and topped with yellow mustard, chopped white onions, neon relish, a dill pickle spear, tomato slices or wedges, pickled sport peppers, and a dash of celery salt. It originates from and is considered a defining symbol of Chicago, Illinois."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-chicago-style-hot-dog"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chicago-style_hot_dog"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"Ingredients","count":14,"links":[["Celery salt","ingredient/celery-salt"],["Chicago-style relish","ingredient/chicago-style-relish"],["Chili pepper","ingredient/chili-pepper"],["Hot dog","ingredient/hot-dog"],["Kosher dill pickle","ingredient/kosher-dill-pickle"],["Mustard","ingredient/mustard"],["Mustard (condiment)","ingredient/mustard-condiment"],["Pickled cucumber","ingredient/pickled-cucumber"],["Poppy seed","ingredient/poppy-seed"],["Sport peppers","ingredient/sport-peppers"],["Tomato","ingredient/tomato"],["Vienna Beef","ingredient/vienna-beef"],["Vienna sausage","ingredient/vienna-sausage"],["White onion","ingredient/white-onion"]]},{"h":"More from American cuisine","links":[["Angel food cake","dish/angel-food-cake"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Beer cake","dish/beer-cake"],["Better than sex cake","dish/better-than-sex-cake"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Brown Betty (dessert)","dish/brown-betty-dessert"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Butter cake","dish/butter-cake"],["Caesar salad","dish/caesar-salad"],["Caramel apple","dish/caramel-apple"],["Carbonara","dish/carbonara"],["Cheesesteak","dish/cheesesteak"],["Chicken nugget","dish/chicken-nugget"],["Chiffon cake","dish/chiffon-cake"],["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Chow-chow (food)","dish/chow-chow-food"],["Chowder","dish/chowder"],["Cioppino","dish/cioppino"],["Clam chowder","dish/clam-chowder"],["Clam dip","dish/clam-dip"],["Club sandwich","dish/club-sandwich"],["Cobb salad","dish/cobb-salad"],["Cobbler (food)","dish/cobbler-food"],["Cook's Corner","dish/cook-s-corner"],["Crab cake","dish/crab-cake"],["Croffle","dish/croffle"],["Dagwood Bumstead","dish/dagwood-bumstead"],["Dagwood sandwich","dish/dagwood-sandwich"],["Deep-dish pizza","dish/deep-dish-pizza"],["Desperation pie","dish/desperation-pie"],["Dirty rice","dish/dirty-rice"],["Donut hole","dish/donut-hole"],["Egg in the basket","dish/egg-in-the-basket"],["Fish and chips","dish/fish-and-chips"],["Fritter","dish/fritter"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/82/Chicago-style_hot_dog_2.jpg/500px-Chicago-style_hot_dog_2.jpg","w":500,"h":375,"by":"arnold inuyaki / Arnold Gatilao","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Chicago-style_hot_dog_2.jpg"}},"dish/coca-tea":{"t":"dish","r":"dish/coca-tea","n":"Coca tea","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#94bd5c","intro":[["Coca tea, also called mate de coca, is a herbal tea (infusion) made using the raw or dried leaves of the cocaine-containing coca plant, which is native to South America. It is made either by submerging the coca leaf or steeping a tea bag in hot water. The tea is most commonly consumed in the Andes mountain range, particularly Argentina, Bolivia, Colombia, Ecuador and especially in Peru, where it is consumed all around the country. It is greenish yellow in color and has a mild bitter flavor similar to green tea with a more organic sweetness."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-coca-tea"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Coca_tea"}],"sections":[{"h":"Where it's from","links":[["Bolivian cuisine","cuisine/bolivian-cuisine"],["Peruvian cuisine","cuisine/peruvian-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Coca leaf","ingredient/coca-leaf"]]},{"h":"Cook it","rows":[{"name":"Chipa by the Dozen","color":"#55b8ad","shape":"site","sub":"chipabythedozen.com","note":"Bolivian-American Lizet Bowen's bilingual blog of Bolivian recipes.","url":"https://chipabythedozen.com/en/category/bolivian-food-recipes-savory-sweet/","suggested":true,"kind":"blog"},{"name":"Peru Delights","color":"#55b8ad","shape":"site","sub":"perudelights.com","note":"Morena Cuadra's blog of Peruvian home recipes and food culture.","url":"https://perudelights.com/tag/peruvian-home-cooking/","suggested":true,"kind":"blog"},{"name":"Eat Peru","color":"#55b8ad","shape":"site","sub":"eatperu.com","note":"Guide to Peruvian dishes and ingredients with a recipe section.","url":"https://www.eatperu.com/category/recipes/?sf_paged=2","suggested":true,"kind":"site"}]},{"h":"More from Bolivian cuisine","links":[["Anticucho","dish/anticucho"],["Chola sandwich","dish/chola-sandwich"],["Locro","dish/locro"],["Salteña","dish/saltena"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/29/Mate_de_coca_Peru.jpg/500px-Mate_de_coca_Peru.jpg","w":500,"h":375,"by":"Anikó Reggel Dervaricsné","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Mate_de_coca_Peru.jpg"}},"dish/gefilte-fish":{"t":"dish","r":"dish/gefilte-fish","n":"Gefilte fish","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Jewish cuisine","dot":"#a99fb5","intro":[["Gefilte fish is a dish made from a poached mixture of ground deboned fish, such as carp, whitefish, or pike. It is traditionally served as an appetizer by Ashkenazi Jewish households. Popular on Shabbat and Jewish holidays such as Passover, it may be consumed throughout the year. It is typically garnished with a slice of cooked carrot on top."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-gefilte-fish"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Gefilte_fish"}],"sections":[{"h":"Where it's from","links":[["Jewish cuisine","cuisine/jewish-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Carrot","ingredient/carrot"],["Matzo meal","ingredient/matzo-meal"],["Whitefish","ingredient/whitefish"]]},{"h":"Cook it","rows":[{"name":"Tori Avey: Jewish Recipes","color":"#55b8ad","shape":"site","sub":"toriavey.com","note":"Tori Avey's Jewish recipe index, often paired with notes on each dish's history.","url":"https://toriavey.com/jewish-recipes/","suggested":true,"kind":"blog"},{"name":"The Nosher (My Jewish Learning)","color":"#55b8ad","shape":"site","sub":"myjewishlearning.com","note":"Recipe section of the nonprofit My Jewish Learning, covering Ashkenazi, Sephardi and Mizrahi home cooking and holiday food.","url":"https://www.myjewishlearning.com/recipes/","suggested":true,"kind":"site"}]},{"h":"More from Jewish cuisine","links":[["Appetizing store","dish/appetizing-store"],["Bagel","dish/bagel"],["Brisket (Jewish dish)","dish/brisket-jewish-dish"],["Cebularz","dish/cebularz"],["Challah","dish/challah"],["Forshmak","dish/forshmak"],["Gondi (food)","dish/gondi-food"],["Gribenes","dish/gribenes"],["Hamantash","dish/hamantash"],["Holishkes","dish/holishkes"],["Jewish deli","dish/jewish-deli"],["Lekach","dish/lekach"],["Mafrum","dish/mafrum"],["Matzah brei","dish/matzah-brei"],["Miodownik","dish/miodownik"],["Pizza dolce di Beridde","dish/pizza-dolce-di-beridde"],["Reuben sandwich","dish/reuben-sandwich"],["Shirin polo","dish/shirin-polo"],["Sorrel soup","dish/sorrel-soup"],["Teiglach","dish/teiglach"],["Tsvikli","dish/tsvikli"],["Tzimmes","dish/tzimmes"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/4a/Gefilte_Fish.jpg/500px-Gefilte_Fish.jpg","w":500,"h":266,"by":"Olaf.herfurth","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Gefilte_Fish.jpg"}},"ingredient/european-anchovy":{"t":"ingredient","r":"ingredient/european-anchovy","n":"European anchovy","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The European anchovy (Engraulis encrasicolus) is a forage fish somewhat related to the herring. It is a type of anchovy; anchovies are placed in the family Engraulidae. It lives off the coasts of Europe and Africa, including in the Mediterranean Sea, the Black Sea, and the Sea of Azov. It is fished by humans throughout much of its range."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-european-anchovy"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/European_anchovy"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Basque cuisine","cuisine/basque-cuisine",[["Gilda (snack)","dish/gilda-snack"]]]]},{"h":"Often cooked with","links":[["Chili pepper","ingredient/chili-pepper"],["Olive","ingredient/olive"],["Vinegar","ingredient/vinegar"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/9f/Ansjovis.jpg/500px-Ansjovis.jpg","w":500,"h":375,"by":"Jschop","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Ansjovis.jpg"}},"dish/pani-ca-meusa":{"t":"dish","r":"dish/pani-ca-meusa","n":"Pani câ meusa","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Sicilian cuisine","dot":"#cf5f87","intro":[["Pani câ meusa, also spelled pani câ mèusa (or less correctly pani ca meusa), is a Sicilian street food. Its Italianized name is panino con la milza. It is a dish typical of Palermo and it consists of a soft bread (locally called vastedda or vastella) topped with sesame, stuffed with chopped veal lung and spleen that have been boiled and then fried in lard. Caciocavallo or ricotta may also be added, in which case the pani câ meusa is called maritatu (lit. 'married'); if served without cheese, it is called schettu ('single') instead. It was created by Jewish butchers in Palermo, Sicily. It is sold mainly by street vendors (specifically indicated locally as meusari) in Palermo's main markets, such as the Vucciria and the Ballarò. The sandwich is a staple among locals in Palermo."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pani-ca-meusa"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pani_c%C3%A2_meusa"}],"sections":[{"h":"Where it's from","links":[["Sicilian cuisine","cuisine/sicilian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Lung","ingredient/lung"],["Spleen","ingredient/spleen"]]},{"h":"More from Sicilian cuisine","links":[["Busiate","dish/busiate"],["Cassatella di Agira","dish/cassatella-di-agira"],["Crocchè","dish/crocche"],["Iris (pastry)","dish/iris-pastry"],["Maccu","dish/maccu"],["Panella","dish/panella"],["Parmigiana","dish/parmigiana"],["Pasta alla Norma","dish/pasta-alla-norma"],["Pasta con le sarde","dish/pasta-con-le-sarde"],["Pasta mollicata","dish/pasta-mollicata"],["Stigghiola","dish/stigghiola"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e3/Pani_ca_meusa.jpg/500px-Pani_ca_meusa.jpg","w":500,"h":282,"by":"Popo le Chien","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Pani_ca_meusa.jpg"}},"dish/pathia":{"t":"dish","r":"dish/pathia","n":"Pathia","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Pathia is a form of curry in the United Kingdom, developed from a Parsi cuisine fish stew of the same name. It is sweet, sour, and subtly spicy."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pathia"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pathia"}],"sections":[{"h":"Where it's from","links":[["Indian cuisine","cuisine/indian-cuisine"],["Parsi cuisine","cuisine/parsi-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Chili pepper","ingredient/chili-pepper"],["Lime (fruit)","ingredient/lime-fruit"],["Tamarind","ingredient/tamarind"]]},{"h":"Cook it","rows":[{"name":"Swasthi's Recipes","color":"#55b8ad","shape":"site","sub":"indianhealthyrecipes.com","note":"Swasthi Shreekanth's long-running blog of everyday Indian home cooking from across the regions.","url":"https://www.indianhealthyrecipes.com/about/","suggested":true,"kind":"blog"},{"name":"Hari Ghotra","color":"#55b8ad","shape":"site","sub":"harighotra.co.uk","note":"UK-based cook Hari Ghotra's recipe library and videos of home-style Indian dishes.","url":"https://www.harighotra.co.uk/indian-recipes","suggested":true,"kind":"site"},{"name":"ParsiCuisine.com","color":"#55b8ad","shape":"site","sub":"parsicuisine.com","note":"Long-running community recipe site devoted to Parsi Zoroastrian cooking.","url":"https://www.parsicuisine.com/parsicuisine-com/","suggested":true,"kind":"site"}]},{"h":"More from Indian cuisine","links":[["Akuri","dish/akuri"],["Aloo paratha","dish/aloo-paratha"],["Amba (condiment)","dish/amba-condiment"],["Baingan bharta","dish/baingan-bharta"],["Bombay potato","dish/bombay-potato"],["Butter chicken","dish/butter-chicken"],["Chaat masala","dish/chaat-masala"],["Chicken Chettinad","dish/chicken-chettinad"],["Dahi vada","dish/dahi-vada"],["Dal dhokli","dish/dal-dhokli"],["Dal makhani","dish/dal-makhani"],["Fafda","dish/fafda"],["Falooda","dish/falooda"],["Fish and chips","dish/fish-and-chips"],["Handvo","dish/handvo"],["Hyderabadi haleem","dish/hyderabadi-haleem"],["Idli","dish/idli"],["Indian restaurant","dish/indian-restaurant"],["Kachumber","dish/kachumber"],["Kidyo","dish/kidyo"],["Kulfi","dish/kulfi"],["Masala chai","dish/masala-chai"],["Mirchi bada","dish/mirchi-bada"],["Mokthuk","dish/mokthuk"],["Naan","dish/naan"],["Osmania bi