,"suggested":true,"kind":"blog"}]},{"h":"More from Jewish cuisine","links":[["Appetizing store","dish/appetizing-store"],["Bagel","dish/bagel"],["Brisket (Jewish dish)","dish/brisket-jewish-dish"],["Cebularz","dish/cebularz"],["Challah","dish/challah"],["Forshmak","dish/forshmak"],["Gefilte fish","dish/gefilte-fish"],["Gondi (food)","dish/gondi-food"],["Gribenes","dish/gribenes"],["Hamantash","dish/hamantash"],["Holishkes","dish/holishkes"],["Jewish deli","dish/jewish-deli"],["Lekach","dish/lekach"],["Mafrum","dish/mafrum"],["Matzah brei","dish/matzah-brei"],["Miodownik","dish/miodownik"],["Pizza dolce di Beridde","dish/pizza-dolce-di-beridde"],["Reuben sandwich","dish/reuben-sandwich"],["Shirin polo","dish/shirin-polo"],["Sorrel soup","dish/sorrel-soup"],["Teiglach","dish/teiglach"],["Tzimmes","dish/tzimmes"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/eb/Pasha2008_080.jpg/500px-Pasha2008_080.jpg","w":500,"h":375,"by":"Kagor at the Ukrainian language Wikipedia","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Pasha2008_080.jpg"}},"ingredient/walleye":{"t":"ingredient","r":"ingredient/walleye","n":"Walleye","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["The walleye (Sander vitreus, synonym Stizostedion vitreum), also called the walleyed pike, yellow pike, yellow pikeperch or yellow pickerel, is a freshwater perciform fish native to most of Canada and to the Northern United States. It is a North American close relative of the European zander, also known as the pikeperch. The walleye is sometimes called the yellow walleye to distinguish it from the blue walleye, which is a color morph that was once found in the southern Ontario and Quebec regions, but is now presumed extinct. However, recent genetic analysis of a preserved (frozen) 'blue walleye' sample suggests that the blue and yellow walleye were simply phenotypes within the same species and do not merit separate taxonomic classification."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-walleye"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Walleye"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Canadian cuisine","cuisine/canadian-cuisine",[["Walleye sandwich","dish/walleye-sandwich"]]],["Minnesotan cuisine","cuisine/minnesotan-cuisine",[["Walleye sandwich","dish/walleye-sandwich"]]]]}],"img":{"src":"/labs/cuisines/img/thumb/4/41/Walleye_%28Sander_vitreus%29_%281%29.jpg/500px-Walleye_%28Sander_vitreus%29_%281%29.jpg","w":500,"h":167,"by":"USFWS Mountain Prairie","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Walleye_(Sander_vitreus)_(1).jpg"}},"dish/pemmican":{"t":"dish","r":"dish/pemmican","n":"Pemmican","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#94bd5c","intro":[["Dried meat, usually ",["Bison","ingredient/bison"],", pounded fine and mixed with fat and often dried berries. It keeps for months and travels well. The ",["Lakota","cuisine/lakota-foodways"]," make it as wasna, often with chokecherries, and it fed ",["Métis","cuisine/metis-foodways"]," voyageurs and winter travelers."]],"src":"note","sources":[{"name":"North Dakota Studies, The Lakota bison hunt","url":"https://www.ndstudies.gov/gr8/node/261"},{"name":"Gabriel Dumont Institute, Traditional Métis foods","url":"https://www.metismuseum.ca/media/document.php/14522.Traditional Metis Foods revised May 2018.pdf"}],"actions":[{"kind":"globe","hash":"dish-pemmican"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pemmican"}],"sections":[{"h":"Where it's from","links":[["Lakota foodways","cuisine/lakota-foodways"],["Métis foodways","cuisine/metis-foodways"]]},{"h":"Ingredients","count":3,"links":[["Animal fats and oils","ingredient/animal-fats-and-oils"],["Berry","ingredient/berry"],["Bison","ingredient/bison"]]},{"h":"Cook it","rows":[{"name":"Owamni","color":"#55b8ad","shape":"site","sub":"owamni.com","note":"Sean Sherman's Minneapolis restaurant, cooking only with Indigenous ingredients.","url":"https://owamni.com/","suggested":true}]},{"h":"More from Lakota foodways","links":[["Frybread","dish/frybread"],["Wojapi","dish/wojapi"]]},{"h":"Mentioned in","links":[["Rubaboo","dish/rubaboo"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/ae/Pemmican_ball.jpg/500px-Pemmican_ball.jpg","w":500,"h":375,"by":"Jen Arrr","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Pemmican_ball.jpg"}}}