,"dish/nasi-goreng"]]],["South Korean cuisine","cuisine/south-korean-cuisine",[["Jjolmyeon","dish/jjolmyeon"]]],["Valencian cuisine","cuisine/valencian-cuisine",[["Esgarrat","dish/esgarrat"]]]]},{"h":"Often cooked with","links":[["Chili pepper","ingredient/chili-pepper"],["Onion","ingredient/onion"],["Olive oil","ingredient/olive-oil"],["Tomato","ingredient/tomato"],["Ginger","ingredient/ginger"],["Chicken","ingredient/chicken"],["Lemongrass","ingredient/lemongrass"],["Black pepper","ingredient/black-pepper"],["Coriander","ingredient/coriander"],["Galangal","ingredient/galangal"],["Turmeric","ingredient/turmeric"],["Eggplant","ingredient/eggplant"],["Vinegar","ingredient/vinegar"],["Candlenut","ingredient/candlenut"],["Sugar","ingredient/sugar"],["Potato","ingredient/potato"]]}],"img":{"src":"/world-cuisine/img/3/39/Allium_sativum_Woodwill_1793.jpg","w":500,"h":827,"by":"Unknown author","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Allium_sativum_Woodwill_1793.jpg"}},"dish/boat-noodles":{"t":"dish","r":"dish/boat-noodles","n":"Boat noodles","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Thai cuisine","dot":"#f0b340","intro":[["Boat noodles is a Thai-style noodle dish with a strong flavor. It contains both pork and beef, as well as dark soy sauce, pickled bean curd, and some other spices, and it is normally served with meatballs and pig's liver. The soup is seasoned with pig or cow blood mixed with salt and spices (เลือดหมูสด (lueat mu sot) or เลือดเนื้อสด (lueat nuea sot)). The colour is similar to that of beef noodle soup (ก๋วยเตี๋ยวเนื้อ (kuaitiao nuea pueai)), but the soup is considerably thicker due to the added blood. It is commonly served in a small bowl."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-boat-noodles"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Boat_noodles"}],"sections":[{"h":"Where it's from","links":[["Thai cuisine","cuisine/thai-cuisine"]]},{"h":"Ingredients","count":12,"links":[["Bean sprouts","ingredient/bean-sprouts"],["Cinnamon","ingredient/cinnamon"],["Dark soy sauce","ingredient/dark-soy-sauce"],["Fermented bean curd","ingredient/fermented-bean-curd"],["Garlic","ingredient/garlic"],["Morning glory","ingredient/morning-glory"],["Paprika","ingredient/paprika"],["Parsley","ingredient/parsley"],["Pickled bean curd","ingredient/pickled-bean-curd"],["Pig blood","ingredient/pig-blood"],["Radish","ingredient/radish"],["Rice noodles","ingredient/rice-noodles"]]},{"h":"Cook it","rows":[{"name":"Hot Thai Kitchen","color":"#55b8ad","shape":"site","sub":"hot-thai-kitchen.com","note":"Pailin Chongchitnant's recipes and videos, with background on technique and ingredients.","url":"https://hot-thai-kitchen.com","suggested":true,"kind":"youtube"},{"name":"SheSimmers","color":"#55b8ad","shape":"site","sub":"shesimmers.com","note":"Bangkok-born writer Leela Punyaratabandhu's blog on Thai home cooking.","url":"https://shesimmers.com/who-is-shesimmers","suggested":true,"kind":"blog"}]},{"h":"More from Thai cuisine","links":[["Akhuni","dish/akhuni"],["American fried rice","dish/american-fried-rice"],["Drunken noodles","dish/drunken-noodles"],["Evil jungle prince","dish/evil-jungle-prince"],["Green curry","dish/green-curry"],["Hainanese chicken rice","dish/hainanese-chicken-rice"],["Khanom babin","dish/khanom-babin"],["Khanom chin","dish/khanom-chin"],["Khanom thuai","dish/khanom-thuai"],["Khao soi","dish/khao-soi"],["La tiang","dish/la-tiang"],["Mi krop","dish/mi-krop"],["Miang kham","dish/miang-kham"],["Nam ngiao","dish/nam-ngiao"],["Nam tok (food)","dish/nam-tok-food"],["Pad see ew","dish/pad-see-ew"],["Pad thai","dish/pad-thai"],["Rad naa","dish/rad-naa"],["Rice noodle roll","dish/rice-noodle-roll"],["Thai curry","dish/thai-curry"],["Thai fried rice","dish/thai-fried-rice"],["Thali","dish/thali"],["Thua nao","dish/thua-nao"],["Tom kha kai","dish/tom-kha-kai"],["Tom yum","dish/tom-yum"]]}],"img":{"src":"/world-cuisine/img/thumb/7/7c/Boat_noodles.jpg/500px-Boat_noodles.jpg","w":500,"h":334,"by":"Flickr user Alpha","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Boat_noodles.jpg"}},"dish/fukamushicha":{"t":"dish","r":"dish/fukamushicha","n":"Fukamushicha","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Fukamushi or fukamushicha (Japanese: 深蒸し茶, lit. 'deep-steamed tea') is a type of Japanese sencha which has been deeply steamed (meaning its raw leaves undergo a relatively long steaming process of 1 to 3 minutes). This process results in tea with a fine powdery texture, a dark green infusion, and a rich flavor. It is usually brewed with water between 70 and 90 degrees Celsius, and for roughly 30 seconds."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-fukamushicha"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fukamushicha"}],"sections":[{"h":"Where it's from","links":[["Japanese cuisine","cuisine/japanese-cuisine"]]},{"h":"Cook it","rows":[{"name":"Just One Cookbook","color":"#55b8ad","shape":"site","sub":"justonecookbook.com","note":"Namiko Chen's long-running blog and videos on Japanese home cooking.","url":"https://justonecookbook.com","suggested":true,"kind":"blog"},{"name":"RecipeTin Japan","color":"#55b8ad","shape":"site","sub":"japan.recipetineats.com","note":"Japanese home recipes from Yumiko, a Japan-born cook, sister site to RecipeTin Eats.","url":"https://japan.recipetineats.com/","suggested":true,"kind":"blog"}]},{"h":"More from Japanese cuisine","links":[["Bergh–Stoutenburgh House","dish/bergh-stoutenburgh-house"],["Chikuwa","dish/chikuwa"],["Curry bread","dish/curry-bread"],["Donburi","dish/donburi"],["Gyokuro","dish/gyokuro"],["Hitsumabushi","dish/hitsumabushi"],["Horumonyaki","dish/horumonyaki"],["Iekei ramen","dish/iekei-ramen"],["Inago no tsukudani","dish/inago-no-tsukudani"],["Itamae","dish/itamae"],["Izakaya","dish/izakaya"],["Japanese