Food_Processing%2C_LLC._(%E7%8B%97%E4%B8%8D%E7%90%86_-_%E7%94%B1_%E5%98%89%E5%98%89%E9%A3%9F%E5%93%81%E5%85%AC%E5%8F%B8_%E8%A3%BD%E5%82%99)%E3%80%82.png"}},"ingredient/wafers":{"t":"ingredient","r":"ingredient/wafers","n":"Wafers","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A wafer is a crisp, often sweet, very thin, flat, light biscuit, often used to decorate ice cream, and also used as a garnish on some sweet dishes. They frequently have a waffle surface pattern but may also be patterned with insignia of the food's manufacturer or may be patternless. Some chocolate bars, such as Kit Kat and Toffee Crisp, are wafers with chocolate in and around them. This adds an extra layer of texture which makes the dish it Is served with have a slight bit of crunch to it."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-wafers"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Wafers"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["American cuisine","cuisine/american-cuisine",[["Icebox cake","dish/icebox-cake"]]]]},{"h":"Often cooked with","links":[["Biscuit","ingredient/biscuit"],["Chocolate","ingredient/chocolate"],["Cookie","ingredient/cookie"],["Whipped cream","ingredient/whipped-cream"]]}],"img":{"src":"/world-cuisine/img/thumb/f/f7/Akbar_Mashti.JPG/500px-Akbar_Mashti.JPG","w":500,"h":366,"by":"IDangerMouse","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Akbar_Mashti.JPG"}},"ingredient/salmon":{"t":"ingredient","r":"ingredient/salmon","n":"Salmon","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 2 cuisines","intro":[["Salmon are any of several commercially important species of ray-finned fish that can live in either freshwater or saltwater from the genera Salmo and Oncorhynchus of the family Salmonidae, native to tributaries of the North Atlantic (Salmo) and North Pacific (Oncorhynchus) basins. Salmon is a colloquial or common name used for fish in this group, but is not a scientific name. Other closely related fish in the same family include trout, char, grayling, whitefish, lenok and taimen, all coldwater fish of the subarctic and cooler temperate regions with some sporadic endorheic populations in Central Asia."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-salmon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Salmon"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Finnish cuisine","cuisine/finnish-cuisine",[["Kalakukko","dish/kalakukko"],["Lohikeitto","dish/lohikeitto"]]],["American Jewish cuisine","cuisine/american-jewish-cuisine",[["Lox","dish/lox"]]]]},{"h":"Often cooked with","links":[["Coregonus albula","ingredient/coregonus-albula"],["European perch","ingredient/european-perch"],["Fish fillet","ingredient/fish-fillet"],["Pork belly","ingredient/pork-belly"],["Rye flour","ingredient/rye-flour"],["Leek","ingredient/leek"],["Milk","ingredient/milk"],["Potato","ingredient/potato"],["Salmon as food","ingredient/salmon-as-food"],["Wheat flour","ingredient/wheat-flour"],["Cured salmon","ingredient/cured-salmon"]]},{"h":"Mentioned in","links":[["Alaska Native foodways","cuisine/alaska-native-foodways"],["Alutiiq foodways","cuisine/alutiiq-foodways"],["Athabascan foodways","cuisine/athabascan-foodways"],["Coast Salish foodways","cuisine/coast-salish-foodways"],["Eyak foodways","cuisine/eyak-foodways"],["Haida foodways","cuisine/haida-foodways"],["Nuu-chah-nulth foodways","cuisine/nuu-chah-nulth-foodways"],["Tlingit cuisine","cuisine/tlingit-cuisine"],["Tsimshian foodways","cuisine/tsimshian-foodways"],["Unangax̂ foodways","cuisine/unangax-foodways"],["Yup'ik cuisine","cuisine/yup-ik-cuisine"]]}],"img":{"src":"/world-cuisine/img/thumb/3/39/Salmo_salar.jpg/500px-Salmo_salar.jpg","w":500,"h":163,"by":"Knepp, Timothy","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Salmo_salar.jpg"}},"ingredient/ketupat":{"t":"ingredient","r":"ingredient/ketupat","n":"Ketupat","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Ketupat is a type of compressed rice cake commonly found across Southeast Asia, particularly in Indonesia, Malaysia, Brunei, Singapore, Timor-Leste and southern Thailand. It is traditionally made by filling a pouch woven from young palm leaves with rice, which is then boiled until the grains expand and form a firm, compact mass. Ketupat is typically served as an accompaniment to meat, vegetable or coconut milk-based dishes and is widely prepared for festive and ceremonial occasions."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-ketupat"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ketupat"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Ketoprak (dish)","dish/ketoprak-dish"]]]]},{"h":"Often cooked with","links":[["Bean sprouts","ingredient/bean-sprouts"],["Cucumber","ingredient/cucumber"],["Kecap manis","ingredient/kecap-manis"],["Krupuk","ingredient/krupuk"],["Lontong","ingredient/lontong"],["Mung bean sprout","ingredient/mung-bean-sprout"],["Peanut sauce","ingredient/peanut-sauce"],["Rice cake","ingredient/rice-cake"],["Rice vermicelli","ingredient/rice-vermicelli"],["Shallot","ingredient/shallot"],["Soy sauce","ingredient/soy-sauce"],["Tofu","ingredient/tofu"]]}],"img":{"src":"/world-cuisine/img/thumb/e/e4/Ketupat2.jpg/500px-Ketupat2.jpg","w":500,"h":333,"by":"Meutia Chaerani","lic":"CC BY 2.5","licUrl":"https://creativecommons.org/licenses/by/2.5","page":"https://commons.wikimedia.org/wiki/File:Ketupat2.jpg"}},"dish/kue":{"t":"dish","r":"dish/kue","n":"Kue","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Kue are bite-sized snacks or desserts originally from what is now Indonesia but have since spread throughout Southeast Asia. Kue is a fairly broad term in Indonesian to describe a wide variety of snacks including cakes, cookies, fritters, pies, scones, and patisserie. Kue are made from a variety of ingredients in various forms; some are steamed, fried or baked. They are popular snacks in Indonesia, which has the largest variety of kue. Because of the countries' historical colonial ties, Koeé (kue) is also popular in the Netherlands."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kue"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kue"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true,"kind":"blog"}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}],"img":{"src":"/world-cuisine/img/thumb/4/44/Jajan_Pasar_in_Jakarta_edit.JPG/500px-Jajan_Pasar_in_Jakarta_edit.JPG","w":500,"h":415,"by":"Gunawan Kartapranata","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Jajan_Pasar_in_Jakarta_edit.JPG"}},"dish/megono":{"t":"dish","r":"dish/megono","n":"Megono","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Javanese cuisine","dot":"#f0b340","intro":[["Megono is a Javanese dish from the region of Central Java, Indonesia. Megono originally comes from the regency of Pekalongan on the north coast of Java, and consists of rice topped with chopped young jackfruit, mixed with grated coconut, along with other spices. Nasi megono is usually served with mendoan, a thin fried, half-cooked, starchy tempeh."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-megono"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Megono"}],"sections":[{"h":"Where it's from","links":[["Javanese cuisine","cuisine/javanese-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Chili pepper","ingredient/chili-pepper"],["Coconut","ingredient/coconut"],["Grated coconut","ingredient/grated-coconut"],["Rice","ingredient/rice"]]},{"h":"More from Javanese cuisine","links":[["Buntil","dish/buntil"],["Getuk goreng","dish/getuk-goreng"],["Javanese doughnut","dish/javanese-doughnut"],["Nasi ambeng","dish/nasi-ambeng"],["Nasi gandul","dish/nasi-gandul"]]}],"img":{"src":"/world-cuisine/img/thumb/c/c9/Nasi_megono.JPG/500px-Nasi_megono.JPG","w":500,"h":375,"by":"Sakurai Midori","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Nasi_megono.JPG"}},"ingredient/matzoon":{"t":"ingredient","r":"ingredient/matzoon","n":"Matzoon","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Matzoon or matsoni (Georgian: მაწონი, mats'oni) is a fermented milk product of Armenian origin found in Armenia and Georgia. The Caspian Sea yogurt commercialized in Japan is said to be the same type of yogurt as matzoon, but a comparison of microbiota and viscosity found that the two are entirely different. Georgian matsoni has been a protected geographical indication in Georgia since 24 January 2012."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-matzoon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Matzoon"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Armenian cuisine","cuisine/armenian-cuisine",[["Spas (soup)","dish/spas-soup"]]]]},{"h":"Often cooked with","links":[["Coriander","ingredient/coriander"],["Egg","ingredient/egg"],["Egg yolk","ingredient/egg-yolk"],["Parsley","ingredient/parsley"],["Triticum","ingredient/triticum"],["Wheat berry","ingredient/wheat-berry"]]}],"img":{"src":"/world-cuisine/img/thumb/e/ec/%D5%87%D5%A1%D5%AC%D5%B8%D5%BF%D5%B8%D5%BE_%D5%B4%D5%A1%D5%AE%D5%B8%D6%82%D5%B6_%D5%B6%D5%A1%D5%B6%D5%A1%D5%B5%D5%B8%D5%BE.JPG/500px-%D5%87%D5%A1%D5%AC%D5%B8%D5%BF%D5%B8%D5%BE_%D5%B4%D5%A1%D5%AE%D5%B8%D6%82%D5%B6_%D5%B6%D5%A1%D5%B6%D5%A1%D5%B5%D5%B8%D5%BE.JPG","w":500,"h":454,"by":"Chaojoker","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:%D5%87%D5%A1%D5%AC%D5%B8%D5%BF%D5%B8%D5%BE_%D5%B4%D5%A1%D5%AE%D5%B8%D6%82%D5%B6_%D5%B6%D5%A1%D5%B6%D5%A1%D5%B5%D5%B8%D5%BE.JPG"}}}