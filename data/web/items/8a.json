ce"],["Wheat flour","ingredient/wheat-flour"],["Nori","ingredient/nori"],["Broth","ingredient/broth"],["Dashi","ingredient/dashi"],["Onion","ingredient/onion"],["Aspergillus oryzae","ingredient/aspergillus-oryzae"],["Soybean","ingredient/soybean"],["Mirin","ingredient/mirin"],["Katsuobushi","ingredient/katsuobushi"],["Mayonnaise","ingredient/mayonnaise"],["Surimi","ingredient/surimi"],["Bread crumbs","ingredient/bread-crumbs"],["Japanese curry","ingredient/japanese-curry"],["Unagi","ingredient/unagi"],["Offal","ingredient/offal"],["Grasshopper","ingredient/grasshopper"],["Butter","ingredient/butter"],["Cheese","ingredient/cheese"],["Cream cheese","ingredient/cream-cheese"],["Sugar","ingredient/sugar"],["Lamb","ingredient/lamb"]],"note":"Most used across its dishes."},{"h":"Within Japanese cooking","count":9,"links":[["Ainu cuisine","cuisine/ainu-cuisine"],["Hawaiian cuisine","cuisine/cuisine-of-hawaii"],["Itameshi","cuisine/itameshi"],["Japanese Chinese cuisine","cuisine/japanese-chinese-cuisine"],["Japanese regional cuisine","cuisine/japanese-regional-cuisine"],["Japanese-American cuisine","cuisine/japanese-american-cuisine"],["Kaiseki","cuisine/kaiseki"],["Okinawan cuisine","cuisine/okinawan-cuisine"],["Yoshoku","cuisine/yoshoku"]]},{"h":"More from Japan","count":2,"links":[["Nagoya cuisine","cuisine/nagoya-cuisine"],["Shippoku","cuisine/shippoku"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/thumb/f/f7/Breakfast_at_Tamahan_Ryokan%2C_Kyoto.jpg/500px-Breakfast_at_Tamahan_Ryokan%2C_Kyoto.jpg","w":500,"h":294,"by":"MichaelMaggs","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Breakfast_at_Tamahan_Ryokan%2C_Kyoto.jpg"}},"cuisine/anhui-cuisine":{"t":"cuisine","r":"cuisine/anhui-cuisine","n":"Anhui cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Chinese cuisine","cuisine/chinese-cuisine"]],"sub":"Regional cuisine in China","intro":[["Anhui cuisine, alternatively referred to as Hui cuisine, is one of the Eight Culinary Traditions of Chinese cuisine. It is derived from the native cooking styles of the Huangshan region in southern Anhui Province."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"anhui-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Anhui_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Part of","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]}],"cont":"Asian cuisine"},"ingredient/banana":{"t":"ingredient","r":"ingredient/banana","n":"Banana","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 12 dishes across 10 cuisines","intro":[["A banana is an elongated, edible fruit that is botanically a berry produced by several kinds of large treelike herbaceous flowering plants in the genus Musa. In some countries, cooking bananas are called plantains, distinguishing them from dessert bananas. The fruit is variable in size, color and firmness, but is usually elongated and curved, with soft flesh rich in starch covered with a peel, which may have a variety of colors when ripe. It grows upward in clusters near the top of the plant. Almost all modern edible seedless (parthenocarp) cultivated bananas come from two wild species – Musa acuminata and Musa balbisiana, or their hybrids."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-banana"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Banana"}],"sections":[{"h":"Where it's cooked with","count":10,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Kolak (food)","dish/kolak-food"],["Kue bugis","dish/kue-bugis"],["Kue leker","dish/kue-leker"],["Rujak soto","dish/rujak-soto"],["Timphan","dish/timphan"]]],["American cuisine","cuisine/american-cuisine",[["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"]]],["Acehnese cuisine","cuisine/acehnese-cuisine",[["Timphan","dish/timphan"]]],["Filipino cui