{"dish/doria-food":{"t":"dish","r":"dish/doria-food","n":"Doria (food)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Yoshoku","dot":"#f0b340","intro":[["Doria is a type of rice gratin popular in Japan. Cooked white rice is topped with sautéed meat, such as chicken or shrimp, and vegetables, then topped with a béchamel sauce and cheese, and baked as a casserole. Doria is an example of yōshoku, Western food tailored to Japanese tastes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-doria-food"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Doria_(food)"}],"sections":[{"h":"Where it's from","links":[["Yoshoku","cuisine/yoshoku"]]},{"h":"Ingredients","count":5,"links":[["Béchamel","ingredient/bechamel"],["Béchamel sauce","ingredient/bechamel-sauce"],["Cheese","ingredient/cheese"],["Pilaf","ingredient/pilaf"],["Rice","ingredient/rice"]]},{"h":"More from Yoshoku","links":[["Chicken katsu","dish/chicken-katsu"],["Cream stew","dish/cream-stew"],["Hayashi rice","dish/hayashi-rice"],["Menchi-katsu","dish/menchi-katsu"],["Naporitan","dish/naporitan"],["Rengatei","dish/rengatei"],["Tonkatsu","dish/tonkatsu"],["Volga rice","dish/volga-rice"]]}]},"dish/garak-guksu":{"t":"dish","r":"dish/garak-guksu","n":"Garak-guksu","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Korean cuisine","dot":"#f0b340","intro":[["In Korean cuisine, garak-guksu are thick wheat noodles and noodle dishes made with thick noodles."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-garak-guksu"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Garak-guksu"}],"sections":[{"h":"Where it's from","links":[["Korean cuisine","cuisine/korean-cuisine"]]},{"h":"Cook it","rows":[{"name":"Maangchi","ref":"site/maangchi-com","color":"#55b8ad","shape":"site","sub":"maangchi.com","note":"Maangchi's Korean recipe site and YouTube channel, one of the best known English sources for Korean cooking.","url":"https://www.maangchi.com/","suggested":true},{"name":"Korean