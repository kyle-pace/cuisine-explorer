,"sections":[{"h":"Where it's from","links":[["Bhutanese cuisine","cuisine/bhutanese-cuisine"],["Nepalese cuisine","cuisine/nepalese-cuisine"],["Tibetan cuisine","cuisine/tibetan-cuisine"]]},{"h":"Cook it","rows":[{"name":"The Gundruk","color":"#55b8ad","shape":"site","sub":"thegundruk.com","note":"Blog dedicated to Nepali recipes and food culture.","url":"https://thegundruk.com","suggested":true,"kind":"blog"},{"name":"Simply Tibetan","color":"#55b8ad","shape":"site","sub":"simplytibetan.com","note":"Tibetan home recipes such as thukpa, momo and laphing from a Tibetan home cook.","url":"https://simplytibetan.com/about-me/","suggested":true,"kind":"blog"},{"name":"YoWangdu Tibetan Cookbook","color":"#55b8ad","shape":"site","sub":"yowangdu.com","note":"Free online collection of Tibetan home recipes by Tibetan cook Lobsang Wangdu, on a Tibet travel site.","url":"https://www.yowangdu.com/tibetan-food/tibetan-cookbook.html","suggested":true,"kind":"site"}]},{"h":"More from Bhutanese cuisine","links":[["Ema datshi","dish/ema-datshi"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/9a/Steamed_Momos_-_KOLKATA.jpg/500px-Steamed_Momos_-_KOLKATA.jpg","w":500,"h":333,"by":"TAPAS KUMAR HALDER","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Steamed_Momos_-_KOLKATA.jpg"}},"ingredient/coconut-sugar":{"t":"ingredient","r":"ingredient/coconut-sugar","n":"Coconut sugar","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Coconut sugar (also known as coco sugar, coconut palm sugar, coco sap sugar or coconut blossom sugar) is a palm sugar produced from the sap of the flower bud stem of the coconut palm."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-coconut-sugar"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Coconut_sugar"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Thai cuisine","cuisine/thai-cuisine",[["Pad thai","dish/pad-thai"]]]]},{"h":"Often cooked with","links":[["Bean sprouts","ingredient/bean-sprouts"],["Chili pepper","ingredient/chili-pepper"],["Dried shrimp","ingredient/dried-shrimp"],["Egg","ingredient/egg"],["Fish sauce","ingredient/fish-sauce"],["Garlic","ingredient/garlic"],["Jaggery","ingredient/jaggery"],["Lime (fruit)","ingredient/lime-fruit"],["Mung bean sprout","ingredient/mung-bean-sprout"],["Peanut","ingredient/peanut"],["Rice noodles","ingredient/rice-noodles"],["Shallots","ingredient/shallots"],["Shrimp","ingredient/shrimp"],["Tamarind juice","ingredient/tamarind-juice"],["Tofu","ingredient/tofu"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/4d/Gula_kelapa.jpg/500px-Gula_kelapa.jpg","w":500,"h":573,"by":"Edi Wibowo","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Gula_kelapa.jpg"}},"dish/pallubasa":{"t":"dish","r":"dish/pallubasa","n":"Pallubasa","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Pallubasa or Pallu basa is a traditional dish from Makassar, South Sulawesi, Indonesia. It is similar to coto Makassar; however, while both are primarily made from offal and/or meat of cattle or buffalo, the meat for pallubasa is cooked longer, and served with a creamy santan and sautéed grated coconut broth in a bowl. Pallubasa may be served with a raw egg (or alas) to make the broth even creamier, and lime juice to add zest to the broth. Unlike coto Makassar, which is eaten with ketupat, pallubasa is eaten with a plate of white rice. It was also eaten with burasa in the past."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pallubasa"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pallubasa"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Beef","ingredient/beef"],["Broth","ingredient/broth"],["Grated coconut","ingredient/grated-coconut"],["Offal","ingredient/offal"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true,"kind":"blog"}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/97/Pallubasa.jpg/500px-Pallubasa.jpg","w":500,"h":375,"by":"Cahyo Ramadhani","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Pallubasa.jpg"}},"dish/ramen":{"t":"dish","r":"dish/ramen","n":"Ramen","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Ramen () (拉麺, ラーメン or らあめん, rāmen; [ɾaꜜːmeɴ] ) is a Japanese-Chinese fusion noodle dish. It includes Chinese-style alkaline wheat noodles (中華麺, chūkamen) served in several flavors of hot broth. Common flavors are soy sauce and miso, with typical toppings including sliced pork (chāshū), nori (dried seaweed), lacto-fermented bamboo shoots (menma), narutomaki, and scallions. Nearly every region in Japan has its own variation of ramen, such as the tonkotsu (pork bone broth) ramen of Kyushu and the miso ramen of Hokkaido."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-ramen"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ramen"}],"sections":[{"h":"Where it's from","links":[["Japanese cuisine","cuisine/japanese-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Alkaline noodles","ingredient/alkaline-noodles"],["Broth","ingredient/broth"],["Japanese noodles","ingredient/japanese-noodles"],["Noodles","ingredient/noodles"],["Youmian","ingredient/youmian"]]},{"h":"Cook it","rows":[{"name":"Just One Cookbook","color":"#55b8ad","shape":"site","sub":"justonecookbook.com","note":"Namiko Chen's long-running blog and videos on Japanese home cooking.","url":"https://justonecookbook.com","suggested":true,"kind":"blog"},{"name":"RecipeTin Japan","color":"#55b8ad","shape":"site","sub":"japan.recipetineats.com","note":"Japanese home recipes from Yumiko, a Japan-born cook, sister site to RecipeTin Eats.","url":"https://japan.recipetineats.com/","suggested":true,"kind":"blog"}]},{"h":"More from Japanese cuisine","links":[["Bergh–Stoutenburgh House","dish/bergh-stoutenburgh-house"],["Chikuwa","dish/chikuwa"],["Curry bread","dish/curry-bread"],["Donburi","dish/donburi"],["Fukamushicha","dish/fukamushicha"],["Gyokuro","dish/gyokuro"],["Hitsumabushi","dish/hitsumabushi"],["Horumonyaki","dish/horumonyaki"],["Iekei ramen","dish/iekei-ramen"],["Inago no tsuk