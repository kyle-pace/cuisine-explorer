/italian-tomato"],["Itamae","dish/itamae"],["Itsu","dish/itsu"],["Ivan Ramen","dish/ivan-ramen"],["Izakaya","dish/izakaya"],["Izumi (restaurant)","dish/izumi-restaurant"],["Japanese cheesecake","dish/japanese-cheesecake"],["Japanese noodles","dish/japanese-noodles"],["Japanese restaurant","dish/japanese-restaurant"],["Japanese tea","dish/japanese-tea"],["Jingisukan","dish/jingisukan"],["Jinya Ramen Bar","dish/jinya-ramen-bar"],["Kadowaki (restaurant)","dish/kadowaki-restaurant"],["Kaki furai","dish/kaki-furai"],["Kamaboko","dish/kamaboko"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/25/Sushi_Taro.jpg/500px-Sushi_Taro.jpg","w":500,"h":375,"by":"Dclemens1971","lic":"CC BY 4.0","licUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:Sushi_Taro.jpg"}},"dish/walleye-sandwich":{"t":"dish","r":"dish/walleye-sandwich","n":"Walleye sandwich","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#94bd5c","intro":[["The walleye sandwich is an important part of Minnesotan and Canadian cuisine. It consists of a fried walleye fillet, on a burger bun or hard roll, it can also include lettuce, tomato, red onions, mayonnaise or tartar sauce. The sandwich originated in Minnesota, but is now popular throughout the Upper Midwest and Eastern Canada. Walleye sandwiches are offered across the state of Minnesota."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-walleye-sandwich"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Walleye_sandwich"}],"sections":[{"h":"Where it's from","links":[["Canadian cuisine","cuisine/canadian-cuisine"],["Minnesotan cuisine","cuisine/minnesotan-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Walleye","ingredient/walleye"]]},{"h":"Cook it","rows":[{"name":"Kitchen Frau: Canadian Food","ref":"site/kitchenfrau-com","color":"#55b8ad","shape":"site","sub":"kitchenfrau.com","note":"Canadian food section of an Alberta-based home cooking blog.","url":"https://www.kitchenfrau.com/canadian-food/","suggested":true}]},{"h":"More from Canadian cuisine","links":[["All-dressed","dish/all-dressed"],["Fish and chips","dish/fish-and-chips"],["Fritter","dish/fritter"],["Macaroni and cheese","dish/macaroni-and-cheese"],["Oasis Drive-In","dish/oasis-drive-in"]]}]}}