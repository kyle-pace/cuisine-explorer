ents"]],"sub":"Ingredient in 3 dishes across 7 cuisines","intro":[["Millets () are a highly varied group of small-seeded grasses, widely grown around the world as a staple cereal crop. Similar to maize and oats amongst other major staple grains, millet and millet-based products are used both as fodder for livestock and as food for humans. Most millets belong to the tribe Paniceae."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-millet"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Millet"}],"sections":[{"h":"Where it's cooked with","count":7,"groups":[["Russian cuisine","cuisine/russian-cuisine",[["Karelian pasty","dish/karelian-pasty"],["Kasha","dish/kasha"]]],["Belarusian cuisine","cuisine/belarusian-cuisine",[["Kasha","dish/kasha"]]],["Ghanaian cuisine","cuisine/ghanaian-cuisine",[["Pito (beer)","dish/pito-beer"]]],["Lithuanian cuisine","cuisine/lithuanian-cuisine",[["Kasha","dish/kasha"]]],["Polish cuisine","cuisine/polish-cuisine",[["Kasha","dish/kasha"]]],["Slovenian cuisine","cuisine/slovenian-cuisine",[["Kasha","dish/kasha"]]],["Ukrainian cuisine","cuisine/ukrainian-cuisine",[["Kasha","dish/kasha"]]]]},{"h":"Where it's grown","grown":{"what":"Millet","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":30771653,"top":[["India","cuisine/indian-cuisine",12593426],["Niger","cuisine/cuisine-of-niger",3262090],["China","cuisine/chinese-cuisine",2706136],["Mali","cuisine/malian-cuisine",1836216],["Nigeria","cuisine/nigerian-cuisine",1776520],["Sudan","cuisine/sudanese-cuisine",1193975],["Senegal","cuisine/senegalese-cuisine",1129691],["Ethiopia","cuisine/ethiopian-cuisine",1118668],["Burkina Faso","cuisine/burkinabe-cuisine",872498],["Chad","cuisine/chadian-cuisine",651030],["Russia","cuisine/russian-cuisine",367525],["Tanzania","cuisine/tanzanian-cuisine",320400],["Nepal","cuisine/nepalese-cuisine",319687],["United States of America","cuisine/american-cuisine",307292],["Pakistan","cuisine/pakistani-cuisine",258999]]}},{"h":"Often cooked with","links":[["Barley","ingredient/barley"],["Rye","ingredient/rye"],["Butter","ingredient/butter"],["Hordeum","ingredient/hordeum"],["Pearl barley","ingredient/pearl-barley"],["Potato","ingredient/potato"],["Potatoes","ingredient/potatoes"],["Rice","ingredient/rice"],["Rice pudding","ingredient/rice-pudding"],["Rye bread","ingredient/rye-bread"],["Rye flour","ingredient/rye-flour"],["Smetana","ingredient/smetana"],["Wheat flour","ingredient/wheat-flour"],["Buckwheat","ingredient/buckwheat"],["Oats","ingredient/oats"],["Wheat","ingredient/wheat"]]}]},"dish/lobiani":{"t":"dish","r":"dish/lobiani","n":"Lobiani","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Georgian cuisine","dot":"#f0b340","intro":[["Lobiani is a traditional Georgian dish of bean-filled bread. In Georgia the most popular is Rachuli Lobiani (რაჭული ლობიანი), like a Khachapuri, but with beans. It is often paired with Rachuli ham."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-lobiani"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lobiani"}],"sections":[{"h":"Where it's from","links":[["Georgian cuisine","cuisine/georgian-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Bean","ingredient/bean"],["Lobio","ingredient/lobio"],["Phaseolus","ingredient/phaseolus"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Georgian Recipes","ref":"site/georgianrecipes-net","color":"#55b8ad","shape":"site","sub":"georgianrecipes.net","note":"Recipe site dedicated to traditional Georgian dishes.","url":"https://georgianrecipes.net/about-georgian-recipes","suggested":true}]},{"h":"More from Georgian cuisine","links":[["Achma","dish/achma"],["Ajika","dish/ajika"],["Akhasheni","dish/akhasheni"],["Cabbage roll","dish/cabbage-roll"],["Chakapuli","dish/chakapuli"],["Chakhokhbili","dish/chakhokhbili"],["Chashushuli","dish/chashushuli"],["Chicken tabaka","dish/chicken-tabaka"],["Churchkhela","dish/churchkhela"],["Dambalkhacho","dish/damb