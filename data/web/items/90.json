dish/garibaldi-biscuit"],["Gidleigh Park","dish/gidleigh-park"],["Hot cross bun","dish/hot-cross-bun"],["Hovis biscuit","dish/hovis-biscuit"],["Jammie Dodgers","dish/jammie-dodgers"],["Melba toast","dish/melba-toast"],["Mince pie","dish/mince-pie"],["Phall","dish/phall"],["Pickled egg","dish/pickled-egg"],["Pie","dish/pie"],["Ploughman's lunch","dish/ploughman-s-lunch"],["Potted shrimps","dish/potted-shrimps"],["Prawn cocktail, steak and Black Forest gateau","dish/prawn-cocktail-steak-and-black-forest-gateau"],["Restaurant Andrew Fairlie","dish/restaurant-andrew-fairlie"],["Restaurant James Sommerin","dish/restaurant-james-sommerin"],["Rhodes Twenty Four","dish/rhodes-twenty-four"],["Rich tea","dish/rich-tea"],["Rose & Crown Pub & Dining Room","dish/rose-crown-pub-dining-room"],["Sausage roll","dish/sausage-roll"],["Shepherd's pie","dish/shepherd-s-pie"],["Soldiers (food)","dish/soldiers-food"]]}]},"dish/shawarma":{"t":"dish","r":"dish/shawarma","n":"Shawarma","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Arab cuisine","dot":"#f0b340","intro":[["Shawarma is a Middle Eastern food that originated in the Levant during the Ottoman Empire. It consists of meat cut into thin slices, stacked in an inverted cone, and roasted on a slow-turning vertical spit. Traditionally made with lamb or mutton, it may also be made with chicken, turkey meat, beef, falafel or veal. The surface of the rotisserie meat is routinely shaved off once it cooks and is ready to be served. Shawarma is a popular street food throughout the world."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-shawarma"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Shawarma"}],"sections":[{"h":"Where it's from","links":[["Arab cuisine","cuisine/arab-cuisine"]]},{"h":"Ingredients","count":16,"links":[["Beef","ingredient/beef"],["Cardamom","ingredient/cardamom"],["Chicken","ingredient/chicken"],["Cinnamon","ingredient/cinnamon"],["Laffa","ingredient/laffa"],["Lamb","ingredient/lamb"],["Lavash","ingredient/lavash"],["Mentha","ingredient/mentha"],["Morkovcha","ingredient/morkovcha"],["Paprika","ingredient/paprika"],["Pita","ingredient/pita"],["Syzygium","ingredient/syzygium"],["Taboon bread","ingredient/taboon-bread"],["Turkey meat","ingredient/turkey-meat"],["Veal","ingredient/veal"],["Wrap","ingredient/wrap"]]},{"h":"More from Arab cuisine","links":[["Baba ghanoush","dish/baba-ghanoush"],["Habib's","dish/habib-s"],["Kibbeh safarjaliyeh","dish/kibbeh-safarjaliyeh"],["Ma'amoul","dish/ma-amoul"],["Meghli","dish/meghli"],["Shakshouka","dish/shakshouka"],["Torshi","dish/torshi"]]}]},"dish/tempoyak":{"t":"dish","r":"dish/tempoyak","n":"Tempoyak","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Tempoyak, asam durian or pekasam is a Malay condiment made from fermented durian. It is usually consumed by the ethnic Malays in Maritime Southeast Asia, notably in Indonesia and Malaysia. Tempoyak is made by crushing durian flesh and mixing it with some salt and kept in room temperature from three to seven days for fermentation. Tempoyaks are usually made during the durian season, when the abundance of durian and excess production are made into fermented tempoyak."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-tempoyak"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tempoyak"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Durian","ingredient/durian"],["Durio","ingredient/durio"],["Durio zibethinus","ingredient/durio-zibethinus"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","ref":"site/dailycookingquest-com","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true}]},{"h":"More from Indonesian cuisine","links":[["Are