tps://en.wikipedia.org/wiki/Mofo_gasy"}],"sections":[{"h":"Where it's from","links":[["Malagasy cuisine","cuisine/malagasy-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Rice","ingredient/rice"]]}],"img":{"src":"/world-cuisine/img/thumb/3/3f/Mokary_Vary-anivorano_nord_Madagascar.jpg/500px-Mokary_Vary-anivorano_nord_Madagascar.jpg","w":500,"h":667,"by":"Chirocca77","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Mokary_Vary-anivorano_nord_Madagascar.jpg"}},"dish/pease-pudding":{"t":"dish","r":"dish/pease-pudding","n":"Pease pudding","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Polish cuisine","dot":"#cf5f87","intro":[["Pease pudding, also known as pease porridge, is a savoury pudding dish made of boiled legumes, typically split yellow peas, with water, salt and spices, and often cooked with a bacon or ham joint. A common dish in the north-east of England, it is consumed to a lesser extent in the rest of Britain. In Newfoundland, it retains its traditional name as part of the customary Jiggs dinner. In non-English speaking countries, similar dishes exist under different names."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pease-pudding"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pease_pudding"}],"sections":[{"h":"Where it's from","links":[["Polish cuisine","cuisine/polish-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Split pea","ingredient/split-pea"]]},{"h":"Cook it","rows":[{"name":"Polonist","color":"#55b8ad","shape":"site","sub":"polonist.com","note":"Polish recipes and food culture from a Polish-born writer living abroad.","url":"https://www.polonist.com/about/","suggested":true,"kind":"blog"},{"name":"Polish Your Kitchen","color":"#55b8ad","shape":"site","sub":"polishyourkitchen.com","note":"Long-running blog of traditional Polish home recipes.","url":"https://polishyourkitchen.com","suggested":true,"kind":"blog"}]},{"h":"More from 