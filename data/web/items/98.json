tlet":{"t":"ingredient","r":"ingredient/breaded-cutlet","n":"Breaded cutlet","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Breaded cutlet or braised cutlet is a dish made from coating a cutlet of meat with breading or batter and either frying or baking it."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-breaded-cutlet"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Breaded_cutlet"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Midwestern American cuisine","cuisine/cuisine-of-the-midwestern-united-states",[["Pork tenderloin sandwich","dish/pork-tenderloin-sandwich"]]],["Yoshoku","cuisine/yoshoku",[["Volga rice","dish/volga-rice"]]]]},{"h":"Often cooked with","links":[["Fried rice","ingredient/fried-rice"],["Omelette","ingredient/omelette"],["Omurice","ingredient/omurice"],["Tonkatsu","ingredient/tonkatsu"]]}]},"dish/rainbow-room":{"t":"dish","r":"dish/rainbow-room","n":"Rainbow Room","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["The Rainbow Room is a private event space on the 65th floor of 30 Rockefeller Plaza at Rockefeller Center in Midtown Manhattan, New York City. Run by Tishman Speyer, it is among the highest venues in New York City. The Rainbow Room was designed by architect Wallace K. Harrison and interior designer Elena Bachman Schmidt. Opened in 1934, it was a focal point for the city's elite, as well as one of the United States' highest restaurants above ground. The restaurant's interior is designated as a New York City landmark."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-rainbow-room"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rainbow_Room"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"More from American cuisine","links":[["5-8 Club","dish/5-8-club"],["Altabira City Tavern","dish/altabira-city-tavern"],[