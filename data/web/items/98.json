pedia.org/wiki/Piaparan"}],"sections":[{"h":"Where it's from","links":[["Filipino cuisine","cuisine/filipino-cuisine"],["Mindanao cuisine","cuisine/filipino-cuisine-mindanao"],["Visayan cuisine","cuisine/filipino-cuisine-visayas"]]},{"h":"Ingredients","count":4,"links":[["Coconut milk","ingredient/coconut-milk"],["Garlic","ingredient/garlic"],["Palapa (condiment)","ingredient/palapa-condiment"],["Turmeric","ingredient/turmeric"]]},{"h":"Cook it","rows":[{"name":"Panlasang Pinoy","color":"#55b8ad","shape":"site","sub":"panlasangpinoy.com","note":"Vanjo Merano's large library of Filipino recipes and cooking videos.","url":"https://panlasangpinoy.com/filipino-food/","suggested":true,"kind":"blog"},{"name":"Kawaling Pinoy","color":"#55b8ad","shape":"site","sub":"kawalingpinoy.com","note":"Lalaine Manalo's blog of Filipino home cooking.","url":"https://www.kawalingpinoy.com/about/","suggested":true,"kind":"blog"},{"name":"Flavours of Iloilo","color":"#55b8ad","shape":"site","sub":"flavoursofiloilo.blogspot.com","note":"Blog of Ilonggo home dishes from Iloilo in the Western Visayas.","url":"https://flavoursofiloilo.blogspot.com/2013/05/how-about-some-chicken-binakol.html","suggested":true,"kind":"blog"}]},{"h":"More from Filipino cuisine","links":[["Adobo (Filipino dish)","dish/adobo-filipino-dish"],["Aparon","dish/aparon"],["Banana ketchup","dish/banana-ketchup"],["Champorado","dish/champorado"],["Filipino barbecue","dish/filipino-barbecue"],["Food for the gods","dish/food-for-the-gods"],["Isaw","dish/isaw"],["Kadyos, baboy, kag langka","dish/kadyos-baboy-kag-langka"],["Kadyos, manok, kag ubad","dish/kadyos-manok-kag-ubad"],["Kumukunsi","dish/kumukunsi"],["Mango float","dish/mango-float"],["Palapa (condiment)","dish/palapa-condiment"],["Pastil","dish/pastil"],["Pilipit","dish/pilipit"],["Piyanggang manok","dish/piyanggang-manok"],["Sushi bake","dish/sushi-bake"],["Tortang talong","dish/tortang-talong"]]}],"img":{"src":"/world-cuisine/img/thumb/d/d1/Piaparan_a_Manok.jpg/500px-Piaparan_a_Manok.jpg","w":500,"h":500,"by":"Lokalpedia","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Piaparan_a_Manok.jpg"}},"ingredient/breaded-cutlet":{"t":"ingredient","r":"ingredient/breaded-cutlet","n":"Breaded cutlet","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Breaded cutlet or braised cutlet is a dish made from coating a cutlet of meat with breading or batter and either frying or baking it."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-breaded-cutlet"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Breaded_cutlet"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Midwestern American cuisine","cuisine/cuisine-of-the-midwestern-united-states",[["Pork tenderloin sandwich","dish/pork-tenderloin-sandwich"]]],["Yoshoku","cuisine/yoshoku",[["Volga rice","dish/volga-rice"]]]]},{"h":"Often cooked with","links":[["Fried rice","ingredient/fried-rice"],["Omelette","ingredient/omelette"],["Omurice","ingredient/omurice"],["Tonkatsu","ingredient/tonkatsu"]]}],"img":{"src":"/world-cuisine/img/thumb/6/62/Tonkatsu_by_ayustety_in_Tokyo.jpg/500px-Tonkatsu_by_ayustety_in_Tokyo.jpg","w":500,"h":375,"by":"ayustety from Tokyo, Japan","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Tonkatsu_by_ayustety_in_Tokyo.jpg"}},"ingredient/curry-powder":{"t":"ingredient","r":"ingredient/curry-powder","n":"Curry powder","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Curry powder is any of several spice mixes for curry, adapted from garam masala in Indian cuisine. It was first sold by Indian merchants to British traders during the period of Company rule in India. The first commercial curry powder product was sold by Sorlie's Perfumery in London in 1784. Brands such as Crosse & Blackwell and Sharwood's were established in the 18th and 19th centuries."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-curry-powder"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Curry_powder"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Swiss cuisine","cuisine/swiss-cuisine",[["Riz Casimir","dish/riz-casimir"]]]]},{"h":"Often cooked with","links":[["Almond","ingredient/almond"],["Banana","ingredient/banana"],["Rice","ingredient/rice"],["Veal","ingredient/veal"]]}],"img":{"src":"/world-cuisine/img/thumb/6/60/Curry_powder_in_the_spice-bazaar_in_Istanbul.jpg/500px-Curry_powder_in_the_spice-bazaar_in_Istanbul.jpg","w":500,"h":333,"by":"Thomas Steiner","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Curry_powder_in_the_spice-bazaar_in_Istanbul.jpg"}},"dish/shengjian-mantou":{"t":"dish","r":"dish/shengjian-mantou","n":"Shengjian mantou","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Chinese cuisine","dot":"#f0b340","intro":[["Shengjian mantou, shengjian bao, or shengjian for short, are small, pan-fried baozi (steamed buns) which are a specialty of Suzhou and Shanghai. The buns are typically filled with pork and gelatin that melts into liquid or soup when cooked. Within Shanghai, shengjian mantou typically have thin, crisp skins, while those sold elsewhere usually have thicker, bread-like skins. The buns originated and became popular in Suzhou at the beginning of the 20th century;  their popularity spread to the Yangtze River Delta. They have been one of the most common breakfast items in Shanghai since the early 1920s."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-shengjian-mantou"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Shengjian_mantou"}],"sections":[{"h":"Where it's from","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Gelatin","ingr