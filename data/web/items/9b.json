saltsa"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Intxaursaltsa"}],"sections":[{"h":"Where it's from","links":[["Basque cuisine","cuisine/basque-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Cinnamon","ingredient/cinnamon"],["Cream","ingredient/cream"],["Milk","ingredient/milk"],["Sugar","ingredient/sugar"]]},{"h":"More from Basque cuisine","links":[["Basque cheesecake","dish/basque-cheesecake"],["Gâteau Basque","dish/gateau-basque"],["Gilda (snack)","dish/gilda-snack"],["Goxua","dish/goxua"],["Pantxineta","dish/pantxineta"],["Pincho","dish/pincho"],["Piperade","dish/piperade"],["Stuffed peppers","dish/stuffed-peppers"],["Sukalki","dish/sukalki"],["Tuna pot","dish/tuna-pot"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/0f/Cuisine_of_the_Basque_Country-Intxaursaltsa_001.JPG/500px-Cuisine_of_the_Basque_Country-Intxaursaltsa_001.JPG","w":500,"h":318,"by":"Valdavia","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Cuisine_of_the_Basque_Country-Intxaursaltsa_001.JPG"}},"ingredient/vanilla-ice-cream":{"t":"ingredient","r":"ingredient/vanilla-ice-cream","n":"Vanilla ice cream","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Vanilla ice cream is a dessert flavoured with vanilla beans, vanilla extract, or synthetic vanillin that is especially common in North America, Asia, and Europe. The type of vanilla used varies by location: in North America and Europe for instance, prominent, smoky flavors are more common, while in Ireland, an anise-like flavor is more frequently used. Many people consider vanilla to be the \"default\" flavor of ice cream (see \"plain vanilla\"), although plain ice cream without any flavouring is also available."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-vanilla-ice-cream"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Vanilla_ice_cream"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["French cuisine","cuisine/french-cuisine",[["Peach Melba","dish/peach-melba"],["Profiterole","dish/profiterole"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Peach Melba","dish/peach-melba"],["Profiterole","dish/profiterole"]]]]},{"h":"Often cooked with","links":[["Ice cream","ingredient/ice-cream"],["Peach","ingredient/peach"],["Raspberry","ingredient/raspberry"],["Vanilla","ingredient/vanilla"],["Chouquette","ingredient/chouquette"],["Choux pastry","ingredient/choux-pastry"],["Custard","ingredient/custard"],["Ganache","ingredient/ganache"],["Whipped cream","ingredient/whipped-cream"]]}],"img":{"src":"/labs/cuisines/img/f/f3/Vanilla_Ice_Cream_Cone_at_Camp_Manitoulin.jpg","w":500,"h":749,"by":"Steven Depolo","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Vanilla_Ice_Cream_Cone_at_Camp_Manitoulin.jpg"}},"dish/slavonian-honey":{"t":"dish","r":"dish/slavonian-honey","n":"Slavonian honey","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Croatian cuisine","dot":"#cf5f87","intro":[["Slavonian honey is a specific type of honey producued in the Slavonia region of Croatia. As a food product, it is protected by a designation of geographical origin at the level of the European Union."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-slavonian-honey"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Slavonian_honey"}],"sections":[{"h":"Where it's from","links":[["Croatian cuisine","cuisine/croatian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Da mi je nešto slatko","color":"#55b8ad","shape":"site","sub":"damijenestoslatko.com","note":"Croatian baking and dessert blog with English versions of its recipes.","url":"https://www.damijenestoslatko.com/en/author/anamarija","suggested":true,"kind":"blog"}]},{"h":"More from Croatian cuisine","links":[["Cabbage roll","dish/cabbage-roll"]]}]},"dish/smetana-dairy-product":{"t":"dish","r":