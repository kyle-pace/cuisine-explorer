{"cuisine/jharkhandi-cuisine":{"t":"cuisine","r":"cuisine/jharkhandi-cuisine","n":"Jharkhandi cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["East Indian cuisine","cuisine/east-india-cuisine"]],"sub":"Regional cuisine in India","intro":[["Jharkhandi cuisine is the cuisine of the Indian state of Jharkhand. Staple foods are rice, dal, roti, and vegetables. Common meals often consist of vegetables that are cooked in various ways, such as curried, fried, roasted and boiled. Many traditional dishes of  Jharkhand may not be available at restaurants."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"jharkhandi-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Jharkhandi_cuisine"}],"sections":[{"h":"Recipe sites","count":1,"rows":[{"name":"Flavours of Jharkhand","ref":"site/flavoursandreceipesofindia-jharkhand-blogspot-com","color":"#55b8ad","shape":"site","sub":"flavoursandreceipesofindia-jharkhand.blogspot.com","note":"Blog dedicated to traditional Jharkhand dishes such as dhuska and chilka roti.","url":"https://flavoursandreceipesofindia-jharkhand.blogspot.com","suggested":true}]},{"h":"Dishes","count":1,"links":[["Red ant chutney","dish/red-ant-chutney"]]},{"h":"Key ingredients","links":[["Oecophylla smaragdina","ingredient/oecophylla-smaragdina"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["East Indian cuisine","cuisine/east-india-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/thumb/3/3b/Chhapra_Chutney_made_from_Red_Ant_a_food_of_Baster_region_at_Aadi_Mahotsav_MG_8684.jpg/500px-Chhapra_Chutney_made_from_Red_Ant_a_food_of_Baster_region_at_Aadi_Mahotsav_MG_8684.jpg","w":500,"h":333,"by":"Sumita Roy Dutta","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Chhapra_Chutney_made_from_Red_Ant_a_food_of_Baster_region_at_Aadi_Mahotsav_MG_8684.jpg","of":"Red ant chutney"}},"cuisine/catalan-cuisine":{"t":"cuisine","r":"cuisine/catalan-cuisine","n":"Catalan cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Spanish cuisine","cuisine/spanish-cuisine"]],"sub":"Regional cuisine in Spain","intro":[["Catalan cuisine is the cooking traditions and practices from Catalonia. It may also refer to the shared cuisine of Northern Catalonia and Andorra, the second of which has a similar cuisine to that of the neighbouring Alt Urgell and Cerdanya comarques, often referred to as \"Catalan mountain cuisine\". It is considered a part of western Mediterranean cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"catalan-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Catalan_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Spanish cuisine","cuisine/spanish-cuisine"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"Catalan Cuisine","ref":"cookbook/catalan-cuisine","color":"#f0b340","shape":"book","sub":"Colman Andrews, 1988","note":"Landmark English-language study of Catalan cooking and its history.","url":"https://openroadmedia.com/ebook/catalan-cuisine/9781909808362","suggested":true}]},{"h":"Dishes","count":8,"links":[["Arròs negre","dish/arros-negre"],["Can Jubany","dish/can-jubany"],["Cinc Sentits","dish/cinc-sentits"],["Crema catalana","dish/crema-catalana"],["Hisop","dish/hisop"],["Mató","dish/mato"],["Pa de pagès","dish/pa-de-pages"],["Samfaina","dish/samfaina"]]},{"h":"Key ingredients","links":[["Milk","ingredient/milk"],["Cephalopod ink","ingredient/cephalopod-ink"],["Cubanelle","ingredient/cubanelle"],["Cuttlefish","ingredient/cuttlefish"],["Rice","ingredient/rice"],["Squid as food","ingredient/squid-as-food"],["Cinnamon","ingredient/cinnamon"],["Egg","ingredient/egg"],["Egg yolk","ingredient/egg-yolk"],["Lemon zest","ingredient/lemon-zest"],["Sugar","ingredient/sugar"],["Goat milk","ingredient/goat-milk"],["Sheep milk","ingredient/sheep-milk"],["Wheat flour","ingredient/wheat-flour"],["Yeast","ingredient/yeast"],["Cucurbita pepo","ingredient/