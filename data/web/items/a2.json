A 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Jacques_Lameloise%2C_escab%C3%A8che_d'%C3%A9crevisses_sur_gaspacho_d'asperge_et_cresson.jpg"}},"dish/friterie":{"t":"dish","r":"dish/friterie","n":"Friterie","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Belgian cuisine","dot":"#cf5f87","intro":[["A friture, baraque à frites or friterie in French-speaking Belgium and Northern France, or frituur or frietkot in Flanders and the Netherlands, also fritkot in French-speaking Belgium and friture or frietkraam in the Netherlands, is a traditional restaurant, kiosk or van serving quick-service fast food, particularly fries from which they derive their name."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-friterie"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Friterie"}],"sections":[{"h":"Where it's from","links":[["Belgian cuisine","cuisine/belgian-cuisine"]]},{"h":"More from Belgian cuisine","links":[["Algérienne sauce","dish/algerienne-sauce"],["Belgian chocolate","dish/belgian-chocolate"],["Bickyburger","dish/bickyburger"],["Boûkète","dish/boukete"],["Flemish stew","dish/flemish-stew"],["Liège waffle","dish/liege-waffle"],["Moules-frites","dish/moules-frites"],["Paling in 't groen","dish/paling-in-t-groen"],["Samurai sauce","dish/samurai-sauce"],["Speculoos","dish/speculoos"],["Steak tartare","dish/steak-tartare"],["Waterzooi","dish/waterzooi"]]}],"img":{"src":"/world-cuisine/img/thumb/c/c4/Friterie_Tabora_in_Brussels_%28DSCF7283%29.jpg/500px-Friterie_Tabora_in_Brussels_%28DSCF7283%29.jpg","w":500,"h":408,"by":"Trougnouf (Benoit Brummer)","lic":"CC BY 4.0","licUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:Friterie_Tabora_in_Brussels_(DSCF7283).jpg"}},"ingredient/edible-flower":{"t":"ingredient","r":"ingredient/edible-flower","n":"Edible flower","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A number of plant species have flowers that can be consumed safely, in some cases only in small portions or specific parts. Otherwise they may be poisonous."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-edible-flower"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Edible_flower"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Korean cuisine","cuisine/korean-cuisine",[["Hwajeon","dish/hwajeon"]]]]},{"h":"Often cooked with","links":[["Glutinous rice","ingredient/glutinous-rice"],["Honey","ingredient/honey"],["Japonica rice","ingredient/japonica-rice"],["Jeon","ingredient/jeon"],["Rice flour","ingredient/rice-flour"]]}],"img":{"src":"/world-cuisine/img/thumb/3/3c/Starflower_1.jpg/500px-Starflower_1.jpg","w":500,"h":375,"by":"Yummifruitbat","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Starflower_1.jpg"}},"dish/jujeh-kabab":{"t":"dish","r":"dish/jujeh-kabab","n":"Jujeh kabab","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Iranian cuisine","dot":"#f0b340","intro":[["Jujeh kabab is a Persian dish that consists of grilled chunks of chicken which are sometimes with bone and other times without bone. It is one of the most common and popular dishes of Iran. It is common to marinate the chunks in minced onion, lemon juice and saffron."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-jujeh-kabab"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Jujeh_kabab"}],"sections":[{"h":"Where it's from","links":[["Iranian cuisine","cuisine/iranian-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Chicken","ingredient/chicken"]]},{"h":"Cook it","rows":[{"name":"Unicorns in the Kitchen","color":"#55b8ad","shape":"site","sub":"unicornsinthekitchen.com","note":"Iranian-born Shadi HasanzadeNemati's blog with a large Persian recipe section.","url":"https://www.unicornsinthekitchen.com/persian-recipes","suggested":true,"kind":"blog"}]},{"h":"More from Iranian cuisine","links":[["Akuri","dish/akuri"],["Cabbage roll","dish/cabbage-roll"],["Chelow kabab","dish/chelow-kabab"],["Doogh","dish/doogh"],["Falooda","dish/falooda"],["Kabab torsh","dish/kabab-torsh"],["Keşkek","dish/keskek"],["Khash (dish)","dish/khash-dish"],["Khoresh karafs","dish/khoresh-karafs"],["Lighvan cheese","dish/lighvan-cheese"],["Nisholda","dish/nisholda"],["Pilaf","dish/pilaf"],["Scorched rice","dish/scorched-rice"],["Sheermal","dish/sheermal"],["Shirazi salad","dish/shirazi-salad"],["Shirin polo","dish/shirin-polo"],["Sholezard","dish/sholezard"]]}],"img":{"src":"/world-cuisine/img/thumb/c/cf/Isfahan_1220532_nevit.jpg/500px-Isfahan_1220532_nevit.jpg","w":500,"h":375,"by":"Nevit Dilmen (talk)","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Isfahan_1220532_nevit.jpg"}},"ingredient/sattu":{"t":"ingredient","r":"ingredient/sattu","n":"Sattu","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Sattu or Satui is a type of flour, mainly used in Nepal, India and Tibet. Sattu is made up of dry-roasted and ground pulses and cereals. The dry powder is prepared in various ways as a principal or secondary ingredient of dishes. Satui is used in vegetarian cuisine as it can be a source of protein."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sattu"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sattu"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Bhojpuri cuisine","cuisine/bhojpuri-cuisine",[["Litti (dish)","dish/litti-dish"]]]]},{"h":"Often cooked with","links":[["Atta","ingredient/atta"],["Besan","ingredient/besan"],["Brinjal","ingredient/brinjal"],["Chili pepper","ingredient/chili-pepper"],["Cilantro","ingredient/cilantro"],["Ghee","ingredient/ghee"],["Gram flour","ingredient/gram-flour"],["Mustard oil","ingredient/mustard-oil"],["Onion","ingredient/onion"],["Wheat flour","ingredient/wheat-flour"]]}]},"ingredient/mincemeat":{"t":"ingredient","r":"ingredient/mincemeat","n":"Mincemeat","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Mincemeat is a mixture of chopped apples and dried fruit, distilled spirits or vinegar, spices, and optionally, meat and beef suet. Mincemeat is usually used as a pie or pastry filling. Traditional mincemeat recipes contain meat, notably beef or venison, as this was a way of preserving meat prior to modern preservation methods. Modern recipes often replace the suet with vegetable shortening or other oils (e.g., coconut oil) and/or omit the meat. However, many people continue to prepare and serve the traditional meat-based mincemeat for holidays."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-mincemeat"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mincemeat"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["American cuisine","cuisine/american-cuisine",[["Mince pie","dish/mince-pie"]]],["British cuisine","cuisine/british-cuisine",[["Mince pie","dish/mince-pie"]]]]},{"h":"Often cooked with","links":[["Shortcrust pastry","ingredient/shortcrust-pastry"]]}],"img":{"src":"/world-cuisine/img/thumb/4/46/Making_Mince_pies_-_tarts_in_baking_tray.jpg/500px-Making_Mince_pies_-_tarts_in_baking_tray.jpg","w":500,"h":667,"by":"Beck","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Making_Mince_pies_-_tarts_in_baking_tray.jpg"}},"dish/qaz":{"t":"dish","r":"dish/qaz","n":"Qazı","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 5 cuisines","dot":"#f0b340","intro":[["Qazı is a traditional sausage-like food of Bashkirs, Kazakhs, Tatars, Kyrgyz, Uzbeks and other Turkic or Central Asian ethnic groups. It is a common element on a dastarkhan, a table set for a festive meal. The taste has been described as smoky and earthy. Horse meat is usually used for Qazı."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-qaz"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Qaz%C4%B1"}],"sections":[{"h":"Where it's from","links":[["Bashkir cuisine","cuisine/bashkir-cuisine"],["Kazakh cuisine","cuisine/kazakh-cuisine"],["Kyrgyz cuisine","cuisine/kyrgyz-cuisine"],["Tatar cuisine","cuisine/tatar-cuisine"],["Uzbek cuisine","cuisine/uzbek-cuisine"]]},{"h":"More from Bashkir cuisine","links":[["Beshbarmak","dish/beshbarmak"],["Echpochmak","dish/echpochmak"],["Peremech","dish/peremech"],["Pilaf","dish/pilaf"],["Qistibi","dish/qistibi"]]}],"img":{"src":"/world-cuisine/img/thumb/3/3e/Horsemeat_platter.jpg/500px-Horsemeat_platter.jpg","w":500,"h":291,"by":"Sara Yeomans","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Horsemeat_platter.jpg"}},"ingredient/kofta":{"t":"ingredient","r":"ingredient/kofta","n":"Kofta","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Kofta is a family of meatball and meatloaf dishes found in South Asian, Central Asian, Balkan, Middle Eastern, North African, and South Caucasian cuisines. In the simplest form, koftas consist of balls of minced meat—usually beef, chicken, lamb or mutton, camel, seldom pork, or a mixture—mixed with spices and sometimes other ingredients. The earliest known recipes are found in early Arab cookbooks, as well as in the Byzantine Empire, and call for ground lamb."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-kofta"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kofta"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Mizrahi Jewish cuisine","cuisine/mizrahi-jewish-cuisine",[["Tehane","dish/tehane"]]],["Moroccan cuisine","cuisine/moroccan-cuisine",[["Tehane","dish/tehane"]]]]},{"h":"Often cooked with","links":[["Cow","ingredient/cow"],["Dromedary camel","ingredient/dromedary-camel"],["Kefta","ingredient/kefta"],["Spleen as food","ingredient/spleen-as-food"]]}],"img":{"src":"/world-cuisine/img/thumb/3/38/Koofteh_tabrizi.jpg/500px-Koofteh_tabrizi.jpg","w":500,"h":375,"by":"Fabienkhan","lic":"CC BY-SA 2.5","licUrl":"https://creativecommons.org/licenses/by-sa/2.5","page":"https://commons.wikimedia.org/wiki/File:Koofteh_tabrizi.jpg"}},"dish/undhiyu":{"t":"dish","r":"dish/undhiyu","n":"Undhiyu","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Gujarati cuisine","dot":"#f0b340","intro":[["Undhiyu is a Gujarati mixed-vegetable dish that is a regional specialty of Surat, Gujarat, India. The name of this dish comes from the Gujarati word undhu (Gujarati: ઊંધું), which translates to 'upside-down', since the dish is traditionally cooked upside-down underground in earthen pots called matlu (માટલું) that are fired from above. When made in matlu, the dish is called umbadiyu."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-undhiyu"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Undhiyu"}],"sections":[{"h":"Where it's from","links":[["Gujarati cuisine","cuisine/gujarati-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Banana","ingredient/banana"],["Coconut","ingredient/coconut"],["Sweet potato","ingredient/sweet-potato"],["Vegetables","ingredient/vegetables"]]},{"h":"Cook it","rows":[{"name":"Spice Up The Curry (Andhra)","color":"#55b8ad","shape":"site","sub":"spiceupthecurry.com","note":"Gujarati section of Kanan Patel's Indian vegetarian recipe blog.","url":"https://www.spiceupthecurry.com/category/recipes-by-region/gujarat/","suggested":true,"kind":"blog"}]},{"h":"More from Gujarati cuisine","links":[["Dhokla","dish/dhokla"],["Thepla","dish/thepla"]]}],"img":{"src":"/world-cuisine/img/thumb/5/5e/Undhiyu.jpg/500px-Undhiyu.jpg","w":500,"h":375,"by":"Jatan1992","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Undhiyu.jpg"}}}