],["Tomato","ingredient/tomato"],["Batter (cooking)","ingredient/batter-cooking"],["Basil","ingredient/basil"],["Eggplant","ingredient/eggplant"],["Extra virgin olive oil","ingredient/extra-virgin-olive-oil"],["Parmesan","ingredient/parmesan"],["Peppercorn","ingredient/peppercorn"],["Bell pepper","ingredient/bell-pepper"]]}],"img":{"src":"/world-cuisine/img/thumb/5/57/Mozzarella_di_bufala3.jpg/500px-Mozzarella_di_bufala3.jpg","w":500,"h":375,"by":"Popo le Chien","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Mozzarella_di_bufala3.jpg"}},"dish/brisket-jewish-dish":{"t":"dish","r":"dish/brisket-jewish-dish","n":"Brisket (Jewish dish)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Jewish cuisine","dot":"#a99fb5","intro":[["Brisket is a popular Ashkenazi Jewish dish of braised beef brisket, served hot and traditionally accompanied by potato or other non-dairy kugel, latkes, and often preceded by matzo ball soup. It is commonly served for Jewish holidays such as Hanukkah, Passover, Rosh Hashanah, and Shabbat. It is commonly found in Jewish communities worldwide, though it is most commonly associated with Jews in the United States, where it has been considered the most important and iconic Jewish main course since the early 20th century."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-brisket-jewish-dish"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Brisket_(Jewish_dish)"}],"sections":[{"h":"Where it's from","links":[["Jewish cuisine","cuisine/jewish-cuisine"]]},{"h":"Cook it","rows":[{"name":"Tori Avey: Jewish Recipes","color":"#55b8ad","shape":"site","sub":"toriavey.com","note":"Tori Avey's Jewish recipe index, often paired with notes on each dish's history.","url":"https://toriavey.com/jewish-recipes/","suggested":true,"kind":"blog"},{"name":"The Nosher (My Jewish Learning)","color":"#55b8ad","shape":"site","sub":"myjewishlearning.com","note":"Recipe section of the nonprofit My Jewish Learning, covering Ashkenazi, Sephardi and Mizrahi home cooking and holiday food.","url":"https://www.myjewishlearning.com/recipes/","suggested":true,"kind":"site"}]},{"h":"More from Jewish cuisine","links":[["Appetizing store","dish/appetizing-store"],["Bagel","dish/bagel"],["Cebularz","dish/cebularz"],["Challah","dish/challah"],["Forshmak","dish/forshmak"],["Gefilte fish","dish/gefilte-fish"],["Gondi (food)","dish/gondi-food"],["Gribenes","dish/gribenes"],["Hamantash","dish/hamantash"],["Holishkes","dish/holishkes"],["Jewish deli","dish/jewish-deli"],["Lekach","dish/lekach"],["Mafrum","dish/mafrum"],["Matzah brei","dish/matzah-brei"],["Miodownik","dish/miodownik"],["Pizza dolce di Beridde","dish/pizza-dolce-di-beridde"],["Reuben sandwich","dish/reuben-sandwich"],["Shirin polo","dish/shirin-polo"],["Sorrel soup","dish/sorrel-soup"],["Teiglach","dish/teiglach"],["Tsvikli","dish/tsvikli"],["Tzimmes","dish/tzimmes"]]}],"img":{"src":"/world-cuisine/img/thumb/a/a6/Brisket_1.jpg/500px-Brisket_1.jpg","w":500,"h":375,"by":"Edsel Little","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Brisket_1.jpg"}},"ingredient/mother-dough":{"t":"ingredient","r":"ingredient/mother-dough","n":"Mother dough","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A pre-ferment (also known as bread starter) is a fermentation starter used in indirect‍ methods of bread making. It may also be called mother dough."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-mother-dough"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mother_dough"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Balearic cuisine","cuisine/balearic-cuisine",[["Ensaïmada","dish/ensaimada"]]]]},{"h":"Often cooked with","links":[["Egg","ingredient/egg"],["Lard","ingredient/lard"],["Pork","ingredient/pork"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/world-cuisine/img/1/13/Pain-poolish1.JPG","w":500,"h":368,"by":"​French Wikipedia user F5ZV","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Pain-poolish1.JPG"}},"dish/french-restaurant":{"t":"dish","r":"dish/french-restaurant","n":"French restaurant","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["French cuisine is the cooking traditions and practices of France. In the 14th century, Guillaume Tirel, a court chef known as \"Taillevent\", wrote Le Viandier, one of the earliest recipe collections of medieval France. In the 17th and 18th centuries, chefs François Pierre La Varenne and Marie-Antoine Carême spearheaded movements that shifted French cooking away from its foreign influences such as from Italian cuisine and developed France's own indigenous style."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-french-restaurant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/French_restaurant"}],"sections":[{"h":"Where it's from","links":[["French cuisine","cuisine/french-cuisine"],["New Caledonian cuisine","cuisine/new-caledonian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Pardon Your French","color":"#55b8ad","shape":"site","sub":"pardonyourfrench.com","note":"Audrey Le Goff, a French cook, shares classic and regional French home recipes.","url":"https://pardonyourfrench.com","suggested":true,"kind":"blog"},{"name":"La Cuisine de Géraldine","color":"#55b8ad","shape":"site","sub":"lacuisinedegeraldine.fr","note":"French home cooking blog by Géraldine Leverd, also author of The New French Kitchen.","url":"https://lacuisinedegeraldine.fr/en/about-us","suggested":true,"kind":"blog"},{"name":"New Caledonia Tourism: Kanak cooking","color":"#55b8ad","shape":"site","sub":"newcaledonia.travel","note":"Official tourism board overview of Kanak food, including bo