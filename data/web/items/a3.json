so"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ros%C3%B3%C5%82"}],"sections":[{"h":"Where it's from","links":[["Polish cuisine","cuisine/polish-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Broth","ingredient/broth"],["Chicken","ingredient/chicken"],["Noodle","ingredient/noodle"]]},{"h":"Cook it","rows":[{"name":"Polonist","color":"#55b8ad","shape":"site","sub":"polonist.com","note":"Polish recipes and food culture from a Polish-born writer living abroad.","url":"https://www.polonist.com/about/","suggested":true,"kind":"blog"},{"name":"Polish Your Kitchen","color":"#55b8ad","shape":"site","sub":"polishyourkitchen.com","note":"Long-running blog of traditional Polish home recipes.","url":"https://polishyourkitchen.com","suggested":true,"kind":"blog"}]},{"h":"More from Polish cuisine","links":[["Baba (cake)","dish/baba-cake"],["Bagel","dish/bagel"],["Borscht","dish/borscht"],["Cabbage roll","dish/cabbage-roll"],["Cabbage soup","dish/cabbage-soup"],["Cebularz","dish/cebularz"],["Cold beet soup","dish/cold-beet-soup"],["Gołąbki","dish/go-abki"],["Gugelhupf","dish/gugelhupf"],["Kasha","dish/kasha"],["Kibinai","dish/kibinai"],["Kolach (bread)","dish/kolach-bread"],["Kotlet schabowy","dish/kotlet-schabowy"],["Krupnik (soup)","dish/krupnik-soup"],["Miodownik","dish/miodownik"],["Pancake","dish/pancake"],["Pease pudding","dish/pease-pudding"],["Pie","dish/pie"],["Potato pancake","dish/potato-pancake"],["Potato salad","dish/potato-salad"],["Racuchy","dish/racuchy"],["Šakotis","dish/sakotis"],["Salceson","dish/salceson"],["Sauerkraut","dish/sauerkraut"],["Sorrel soup","dish/sorrel-soup"],["Steak tartare","dish/steak-tartare"],["Streuselkuchen","dish/streuselkuchen"],["Székelykáposzta","dish/szekelykaposzta"],["Tsvikli","dish/tsvikli"],["Uszka","dish/uszka"],["Zapiekanka","dish/zapiekanka"],["Zrazy","dish/zrazy"]]}],"img":{"src":"/world-cuisine/img/thumb/6/67/09516_rosol_z_makaronem%2C_sanok.jpg/500px-09516_rosol_z_makaronem%2C_sanok.jpg","w":500,"h":375,"by":"Silar","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:09516_rosol_z_makaronem%2C_sanok.jpg"}},"ingredient/wheat-berry":{"t":"ingredient","r":"ingredient/wheat-berry","n":"Wheat berry","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A wheat berry, or wheatberry, is a whole wheat kernel, composed of the bran, germ, and endosperm, without the husk. Botanically, it is a type of fruit called a caryopsis. Wheat berries are eaten as a grain, have a tan to reddish-brown color, and can vary in gluten and protein content from 6–9% (\"soft\") to 10–14% (\"hard\"). They are often added to salads or baked into bread to add a chewy texture. If wheat berries are milled, whole-wheat flour is produced. Wheat berries are similar to barley, rye, and kamut."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-wheat-berry"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Wheat_berry"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Armenian cuisine","cuisine/armenian-cuisine",[["Spas (soup)","dish/spas-soup"]]]]},{"h":"Often cooked with","links":[["Coriander","ingredient/coriander"],["Egg","ingredient/egg"],["Egg yolk","ingredient/egg-yolk"],["Matzoon","ingredient/matzoon"],["Parsley","ingredient/parsley"],["Triticum","ingredient/triticum"]]}],"img":{"src":"/world-cuisine/img/thumb/d/d3/Wheatberries.jpg/500px-Wheatberries.jpg","w":500,"h":375,"by":"zandland","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Wheatberries.jpg"}},"dish/tvishi-wine":{"t":"dish","r":"dish/tvishi-wine","n":"Tvishi (wine)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Georgian cuisine","dot":"#f0b340","intro":[["Tvishi is a Georgian wine. It is an appellation for wines produced in a 15 km2 (3,700 acres) zone around Tvishi village in northwestern Georgia. The zone is on the right bank of the Rioni River and includes Alpana village."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-tvishi-wine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tvishi_(wine)"}],"sections":[{"h":"Where it's from","links":[["Georgian cuisine","cuisine/georgian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Georgian Recipes","color":"#55b8ad","shape":"site","sub":"georgianrecipes.net","note":"Recipe site dedicated to traditional Georgian dishes.","url":"https://georgianrecipes.net/about-georgian-recipes","suggested":true,"kind":"site"}]},{"h":"More from Georgian cuisine","links":[["Achma","dish/achma"],["Ajika","dish/ajika"],["Akhasheni","dish/akhasheni"],["Cabbage roll","dish/cabbage-roll"],["Chakapuli","dish/chakapuli"],["Chakhokhbili","dish/chakhokhbili"],["Chashushuli","dish/chashushuli"],["Chicken tabaka","dish/chicken-tabaka"],["Churchkhela","dish/churchkhela"],["Dambalkhacho","dish/dambalkhacho"],["Eggplant jam","dish/eggplant-jam"],["Gozinaki","dish/gozinaki"],["Khachapuri","dish/khachapuri"],["Kharcho","dish/kharcho"],["Khash (dish)","dish/khash-dish"],["Khvanchkara","dish/khvanchkara"],["Kindzmarauli","dish/kindzmarauli"],["Kubdari","dish/kubdari"],["Kuchmachi","dish/kuchmachi"],["Kvass","dish/kvass"],["Lobiani","dish/lobiani"],["Mchadi","dish/mchadi"],["Mujuretuli","dish/mujuretuli"],["Nadugi","dish/nadugi"],["Nigvziani badrijani","dish/nigvziani-badrijani"],["Pkhali","dish/pkhali"],["Shkmeruli","dish/shkmeruli"],["Tsolikouri","dish/tsolikouri"]]}]}}