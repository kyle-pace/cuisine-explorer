,"url":"https://dirndlkitchen.com","suggested":true,"kind":"blog"},{"name":"Quick German Recipes","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Thuringia page on German-born cook Gerhild Fulson's long-running German recipe site.","url":"https://www.quick-german-recipes.com/thuringia.html","suggested":true,"kind":"blog"}]},{"h":"More from German cuisine","links":[["Baumkuchen","dish/baumkuchen"],["Bockwurst","dish/bockwurst"],["Buchteln","dish/buchteln"],["Cabbage roll","dish/cabbage-roll"],["Chrain","dish/chrain"],["Dampfnudel","dish/dampfnudel"],["Egg puffs and soup pearls","dish/egg-puffs-and-soup-pearls"],["Eintopf","dish/eintopf"],["Flammekueche","dish/flammekueche"],["Gugelhupf","dish/gugelhupf"],["Hamburg steak","dish/hamburg-steak"],["Hedgehog slice","dish/hedgehog-slice"],["Kringle","dish/kringle"],["Labskaus","dish/labskaus"],["Landjäger","dish/landjager"],["Leberkäse","dish/leberkase"],["Mett","dish/mett"],["Mock turtle soup","dish/mock-turtle-soup"],["Potato pancake","dish/potato-pancake"],["Potato salad","dish/potato-salad"],["Rødgrød","dish/r-dgr-d"],["Sauerkraut","dish/sauerkraut"],["Spaghettieis","dish/spaghettieis"],["Speckkuchen","dish/speckkuchen"],["Spundekäs","dish/spundekas"],["Steckerlfisch","dish/steckerlfisch"],["Stippgrütze","dish/stippgrutze"],["Stollen","dish/stollen"],["Streuselkuchen","dish/streuselkuchen"],["Strudel","dish/strudel"],["Westfälische Rinderwurst","dish/westfalische-rinderwurst"],["Zopf","dish/zopf"]]}],"img":{"src":"/world-cuisine/img/thumb/8/8f/Hamburger_Aalsuppe_bei_Hamburger_Fischerstuben.jpg/500px-Hamburger_Aalsuppe_bei_Hamburger_Fischerstuben.jpg","w":500,"h":375,"by":"Zi Li","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Hamburger_Aalsuppe_bei_Hamburger_Fischerstuben.jpg"}},"dish/gozinaki":{"t":"dish","r":"dish/gozinaki","n":"Gozinaki","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Georgian cuisine","dot":"#f0b340","intro":[["Gozinaki is a traditional Georgian brittle confection made of caramelized nuts, usually walnuts, and fried in honey. In the western Georgian provinces of Imereti and Racha, it was sometimes called \"churchkhela\", a name more commonly applied to walnuts sewn onto a string, dipped in thickened white grape juice and dried. In several of Georgia's rural areas, both walnuts and honey used to have sacral associations. According to a long-established tradition, Gozinaki is served at special occasions, and is a mandatory component of New Year's Eve and Christmas celebrations."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-gozinaki"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Gozinaki"}],"sections":[{"h":"Where it's from","links":[["Georgian cuisine","cuisine/georgian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Caramel","ingredient/caramel"],["Honey","ingredient/honey"],["Walnut","ingredient/walnut"]]},{"h":"Cook it","rows":[{"name":"Georgian Recipes","color":"#55b8ad","shape":"site","sub":"georgianrecipes.net","note":"Recipe site dedicated to traditional Georgian dishes.","url":"https://georgianrecipes.net/about-georgian-recipes","suggested":true,"kind":"site"}]},{"h":"More from Georgian cuisine","links":[["Achma","dish/achma"],["Ajika","dish/ajika"],["Akhasheni","dish/akhasheni"],["Cabbage roll","dish/cabbage-roll"],["Chakapuli","dish/chakapuli"],["Chakhokhbili","dish/chakhokhbili"],["Chashushuli","dish/chashushuli"],["Chicken tabaka","dish/chicken-tabaka"],["Churchkhela","dish/churchkhela"],["Dambalkhacho","dish/dambalkhacho"],["Eggplant jam","dish/eggplant-jam"],["Khachapuri","dish/khachapuri"],["Kharcho","dish/kharcho"],["Khash (dish)","dish/khash-dish"],["Khvanchkara","dish/khvanchkara"],["Kindzmarauli","dish/kindzmarauli"],["Kubdari","dish/kubdari"],["Kuchmachi","dish/kuchmachi"],["Kvass","dish/kvass"],["Lobiani","dish/lobiani"],["Mchadi","dish/mchadi"],["Mujuretuli","dish/mujuretuli"],["Nadugi","dish/nadugi"],["Nigvziani badrijani","dish/nigvziani-badrijani"],["Pkhali","dish/pkhali"],["Shkmeruli","dish/shkmeruli"],["Tsolikouri","dish/tsolikouri"],["Tvishi (wine)","dish/tvishi-wine"]]}],"img":{"src":"/world-cuisine/img/thumb/0/0c/Gozinaki_with_walnuts.jpg/500px-Gozinaki_with_walnuts.jpg","w":500,"h":375,"by":"Georgia About","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Gozinaki_with_walnuts.jpg"}},"dish/idli":{"t":"dish","r":"dish/idli","n":"Idli","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indian cuisine","dot":"#f0b340","intro":[["Idli or idly is a South Indian rice cake popular as a breakfast food. The cakes are made by steaming a batter consisting of fermented hulled black lentils and rice. The fermentation process breaks down the starches so that they are more easily digested."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-idli"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Idli"}],"sections":[{"h":"Where it's from","links":[["Indian cuisine","cuisine/indian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Rice","ingredient/rice"],["Urad (bean)","ingredient/urad-bean"],["Vigna mungo","ingredient/vigna-mungo"]]},{"h":"Cook it","rows":[{"name":"Swasthi's Recipes","color":"#55b8ad","shape":"site","sub":"indianhealthyrecipes.com","note":"Swasthi Shreekanth's long-running blog of everyday Indian home cooking from across the regions.","url":"https://www.indianhealthyrecipes.com/about/","suggested":true,"kind":"blog"},{"name":"Hari Ghotra","color":"#55b8ad","shape":"site","sub":"harighotra.co.uk","note":"UK-based cook Hari Ghotra's recipe library and videos of home-style Indian dishes.","url":"https://www.harighotra.co.uk/indian-recipes","suggested":true,"kind":"site"}]},{"h":"More from Indian cuisine","links":[["Akuri","dish/akuri"],["Aloo paratha","dish/aloo-paratha"],["Amba (condiment)","dish/amba-condiment"],["Baingan bharta","dish/baingan-bharta"],["B