dish/pottage"],["Salchichón","dish/salchichon"],["Salmorejo","dish/salmorejo"],["Sobrassada","dish/sobrassada"],["Soldaditos de Pavía","dish/soldaditos-de-pavia"],["Somni","dish/somni"],["Sopa de gato","dish/sopa-de-gato"],["Spanish omelette","dish/spanish-omelette"],["Spanish restaurant","dish/spanish-restaurant"],["Stuffed peppers","dish/stuffed-peppers"],["Tapas","dish/tapas"],["Toro Bravo (restaurant)","dish/toro-bravo-restaurant"],["Turrón","dish/turron"]]}]},"ingredient/lathyrus-sativus":{"t":"ingredient","r":"ingredient/lathyrus-sativus","n":"Lathyrus sativus","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Lathyrus sativus, also known as grass pea, grasspea, peagrass, cicerchia, blue sweet pea, chickling pea, chickling vetch, Indian pea, white pea and white vetch, is a legume (family Fabaceae) commonly grown for human consumption and livestock feed in Asia and East Africa. It is a particularly important crop in areas that are prone to drought and famine, and is thought of as an 'insurance crop' as it produces reliable yields when all other crops fail. The seeds contain a neurotoxin that causes lathyrism, a neurodegenerative disease, if eaten as a primary protein source for a prolonged period."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-lathyrus-sativus"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lathyrus_sativus"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Andalusian cuisine","cuisine/andalusian-cuisine",[["Gachas","dish/gachas"]]]]},{"h":"Often cooked with","links":[["Maize","ingredient/maize"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/ae/Lathyrus_sativus_flowers_Bangladesh_cropped.JPG/500px-Lathyrus_sativus_flowers_Bangladesh_cropped.JPG","w":500,"h":667,"by":"Arr4 (talk)","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Lathyrus_sativus_flowers_Bangladesh_cropped.JPG"}},"dish/jesuite":{"t":"dish","r":"dish/jesuite","n":"Jésuite","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Argentine cuisine","dot":"#94bd5c","intro":[["A Jésuite is a triangular, Puff pastry filled with frangipane cream and topped with sliced almonds and powdered sugar. The pastry originated in France and the name refers to the triangular shape of a Jesuit's hat. A similarly-named sweet pastry known in Portugal and Spain, the jesuíta, consists of puff pastry filled with custard. In Germany, Jesuitermützen are a custard-filled pastry traditionally cut into triangles."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-jesuite"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/J%C3%A9suite"}],"sections":[{"h":"Where it's from","links":[["Argentine cuisine","cuisine/argentine-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Almond","ingredient/almond"],["Frangipane","ingredient/frangipane"],["Powdered sugar","ingredient/powdered-sugar"],["Puff pastry","ingredient/puff-pastry"]]},{"h":"Cook it","rows":[{"name":"Familia Kitchen: Argentina","ref":"site/familiakitchen-com","color":"#55b8ad","shape":"site","sub":"familiakitchen.com","note":"Argentine recipes and stories on a Latino family cooking site.","url":"https://familiakitchen.com/destination/argentina/","suggested":true,"kind":"site"}]},{"h":"More from Argentine cuisine","links":[["Anticucho","dish/anticucho"],["Argentine pizza","dish/argentine-pizza"],["Asado","dish/asado"],["Bara brith","dish/bara-brith"],["Bondiola sandwich","dish/bondiola-sandwich"],["Cabbage roll","dish/cabbage-roll"],["Dulce de batata","dish/dulce-de-batata"],["Fugazza","dish/fugazza"],["Jesuita (sandwich)","dish/jesuita-sandwich"],["Matambre","dish/matambre"],["Ox (Portland restaurant)","dish/ox-portland-restaurant"],["Puchero","dish/puchero"],["Rogel (cake)","dish/rogel-cake"],["Salsa golf","dish/salsa-golf"]]}],"img":{"src":"/labs/cuisines/img/thumb/c/c9/J%C3%A9suite_%288090911085%29.jpg/500px-J%C3%A9suite_%288090911085%29.jpg","w":500,"h":229,"by":"Stijn Nieuwendijk from Amsterdam, NL","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:J%C3%A9suite_(8090911085).jpg"}},"dish/khao-soi":{"t":"dish","r":"dish/khao-soi","n":"Khao soi","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#f0b340","intro":[["Khao soi or khao soy is a dish served in Northern Thailand. The dish is believed to have evolved from Chin Haw Muslim traders who plied the spice route when what is now modern-day northern Thailand was controlled by the Burmese. A comparable dish, ohn no khao swè, is widely served in Myanmar, most likely the precursor of khao soi. Traditionally, the dough for the wheat noodles is spread out on a cloth stretched over boiling water. After steaming, the sheet noodles are rolled and cut with scissors."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-khao-soi"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Khao_soi"}],"sections":[{"h":"Where it's from","links":[["Burmese cuisine","cuisine/burmese-cuisine"],["Lao cuisine","cuisine/lao-cuisine"],["Thai cuisine","cuisine/thai-cuisine"]]},{"h":"Cook it","rows":[{"name":"Saeng's Kitchen","ref":"site/saengskitchen-com","color":"#55b8ad","shape":"site","sub":"saengskitchen.com","note":"Lao-American cook Saeng Douangdara's recipes and videos of Lao home cooking.","url":"https://www.saengskitchen.com/","suggested":true,"kind":"youtube"},{"name":"Hot Thai Kitchen","ref":"site/hot-thai-kitchen-com","color":"#55b8ad","shape":"site","sub":"hot-thai-kitchen.com","note":"Pailin Chongchitnant's recipes and videos, with background on technique and ingredients.","url":"https://hot-thai-kitchen.com","suggested":true,"kind":"youtube"},{"name":"SheSimmers","ref":"site/shesimmers-com","color":"#55b8ad","shape":"site","sub":"shesimmers.com","note":"Bangkok-born writer Leela Punya