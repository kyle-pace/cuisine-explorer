ents","count":11,"links":[["Banana leaf","ingredient/banana-leaf"],["Caraway seed","ingredient/caraway-seed"],["Chili pepper","ingredient/chili-pepper"],["Coconut","ingredient/coconut"],["Coconut milk","ingredient/coconut-milk"],["Egg","ingredient/egg"],["Galangal","ingredient/galangal"],["Ginger","ingredient/ginger"],["Milkfish","ingredient/milkfish"],["Skewer","ingredient/skewer"],["Tamarind","ingredient/tamarind"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true,"kind":"blog"}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/73/Sate_Bandeng_2.jpg/500px-Sate_Bandeng_2.jpg","w":500,"h":375,"by":"Gunawan Kartapranata","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Sate_Bandeng_2.jpg"}},"ingredient/provolone":{"t":"ingredient","r":"ingredient/provolone","n":"Provolone","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Provolone is an Italian semi-hard cheese made from cow's milk. It is an aged pasta filata ('stretched-curd') cheese originating in the Campania region, near Vesuvius, where it is still produced in pear, sausage, or cone shapes 10 to 15 cm (4 to 6 in) long. Provolone-type cheeses are also produced in other countries. The most important provolone production region today is northwestern Italy and, in particular, the city of Cremona. Provolone, provola, and provoleta are versions of the same basic cheese. Some versions of provolone are smoked."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-provolone"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Provolone"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Italian cuisine","cuisine/italian-cuisine",[["Spaghetti alla Nerano","dish/spaghetti-alla-nerano"]]]]},{"h":"Often cooked with","links":[["Basil","ingredient/basil"],["Black pepper","ingredient/black-pepper"],["Extra virgin olive oil","ingredient/extra-virgin-olive-oil"],["Garlic","ingredient/garlic"],["Parmesan","ingredient/parmesan"],["Spaghetti","ingredient/spaghetti"],["Zucchini","ingredient/zucchini"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a0/Provolone_watermelon_shape.jpg/500px-Provolone_watermelon_shape.jpg","w":500,"h":667,"by":"like the grand canyon","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Provolone_watermelon_shape.jpg"}},"dish/sufganiyah":{"t":"dish","r":"dish/sufganiyah","n":"Sufganiyah","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Israeli cuisine","dot":"#f0b340","intro":[["Sufganiyah is a round, jelly doughnut–like pastry, eaten around the world during the Jewish festival of Hanukkah. The doughnut is deep-fried, injected with jam or custard, and then topped with powdered sugar. The doughnut recipe originated in Europe in the 16th century, and by the 19th century was known as a Berliner in Germany and a Religieuse in France. Polish Jews, who called them ponchki, fried the doughnuts in schmaltz rather than lard due to kashrut laws. The ponchik was brought to Israel by Polish Jewish immigrants, where it was renamed the sufganiyah based on the Talmud's description of a \"spongy dough\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-sufganiyah"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sufganiyah"}],"sections":[{"h":"Where it's from","links":[["Israeli cuisine","cuisine/israeli-cuisine"]]},{"h":"More from Israeli cuisine","links":[["Baba ghanoush","dish/baba-ghanoush"],["Cabbage roll","dish/cabbage-roll"],["Hummus","dish/hummus"],["Lahoh","dish/lahoh"],["Sabich","dish/sabich"],["Taboon bread","dish/taboon-bread"],["Ziva (dish)","dish/ziva-dish"]]}],"img":{"src":"/labs/cuisines/img/thumb/c/c3/Classic_Hanukkah_sufganiyot.JPG/500px-Classic_Hanukkah_sufganiyot.JPG","w":500,"h":375,"by":"Noam Furer","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Classic_Hanukkah_sufganiyot.JPG"}},"ingredient/tempura":{"t":"ingredient","r":"ingredient/tempura","n":"Tempura","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Tempura is a Japanese dish that usually consists of seafood and vegetables that have been coated in a thin batter and deep-fried. Tempura originated in the 16th century, when Portuguese Jesuits brought the Western-style cooking method of coating foods with flour and frying, via Nanban trade."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tempura"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tempura"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Japanese cuisine","cuisine/japanese-cuisine",[["Takoyaki","dish/takoyaki"]]]]},{"h":"Often cooked with","links":[["Allium fistulosum","ingredient/allium-fistulosum"],["Batter (cooking)","ingredient/batter-cooking"],["Beni shoga","ingredient/beni-shoga"],["Beni shōga","ingredient/beni-shoga"],["Egg","ingredient/egg"],["Green laver","ingredient/green-laver"],["Katsuobushi","ingredient/katsuobushi"],["Mayonnaise","ingredient/mayonnaise"],["Octopus","ingredient/octopus"],["Octopus as food","ingredient/octopus-as-food"],["Welsh onion","ingredient/welsh-onion"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/2e/Tempura_01.jpg/500px-Tempura_01.jpg","w":500,"h":667,"by":"Yaco*","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Tempura_01.jpg"}}}