wikimedia.org/wiki/File:Pantxineta_-_2011.JPG"}},"dish/rollatini":{"t":"dish","r":"dish/rollatini","n":"Rollatini","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian-American cuisine","dot":"#94bd5c","intro":[["Rollatini (sometimes spelled rolatini or rolletini) or involtini is an Italian-style dish (called rollatini di melanzane in faux Italian) that is usually made with thin slices of eggplants, which are dusted in wheat flour or lightly breaded and covered with ricotta and often other cheeses and seasonings, then rolled up and baked. Alternatively, veal, chicken, or fish may be used in place of the eggplant."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-rollatini"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rollatini"}],"sections":[{"h":"Where it's from","links":[["Italian-American cuisine","cuisine/italian-american-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Chicken","ingredient/chicken"],["Eggplant","ingredient/eggplant"],["Fish","ingredient/fish"],["Ricotta","ingredient/ricotta"],["Veal","ingredient/veal"]]},{"h":"More from Italian-American cuisine","links":[["Chicken Francese","dish/chicken-francese"],["Fettuccine Alfredo","dish/fettuccine-alfredo"],["Garlic bread","dish/garlic-bread"],["Italian beef","dish/italian-beef"],["Italian tomato pie","dish/italian-tomato-pie"],["Spaghetti and meatballs","dish/spaghetti-and-meatballs"],["Stromboli (food)","dish/stromboli-food"],["Tetrazzini","dish/tetrazzini"],["Vodka sauce","dish/vodka-sauce"]]}],"img":{"src":"/labs/cuisines/img/d/da/Eggplant_rollatini.jpg","w":500,"h":374,"by":"Jennifer","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Eggplant_rollatini.jpg"}},"ingredient/israeli-salad":{"t":"ingredient","r":"ingredient/israeli-salad","n":"Israeli salad","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Israeli salad is a chopped salad of finely diced tomato, onion, cucumber, and bell or chili peppers. It has been described as the \"most well-known national dish of Israel\", and is a standard accompaniment to most Israeli meals. Salads following similar recipes, with different names, are widespread and popular throughout the Eastern Mediterranean."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-israeli-salad"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Israeli_salad"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Israeli cuisine","cuisine/israeli-cuisine",[["Sabich","dish/sabich"]]]]},{"h":"Often cooked with","links":[["Amba","ingredient/amba"],["Amba (condiment)","ingredient/amba-condiment"],["Egg","ingredient/egg"],["Eggplant","ingredient/eggplant"],["Hummus","ingredient/hummus"],["Laffa","ingredient/laffa"],["Parsley","ingredient/parsley"],["Pita","ingredient/pita"],["Salad","ingredient/salad"],["Tahini","ingredient/tahini"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/04/Salad.jpg/500px-Salad.jpg","w":500,"h":473,"by":"Gila Brand","lic":"CC BY 2.5","licUrl":"https://creativecommons.org/licenses/by/2.5","page":"https://commons.wikimedia.org/wiki/File:Salad.jpg"}},"dish/salchichon":{"t":"dish","r":"dish/salchichon","n":"Salchichón","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Spanish cuisine","dot":"#cf5f87","intro":[["Salchichón is a Spanish summer sausage that is made by smoking, drying, cooking, or some combination. It is made with pork, although some recipes use other meats including ox, veal, or horse."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-salchichon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Salchich%C3%B3n"}],"sections":[{"h":"Where it's from","links":[["Spanish cuisine","cuisine/spanish-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Nutmeg","ingredient/nutmeg"],["Oregano","ingredient/oregano"],["Pork","ingredient/pork"]]},{"h":"Cook it","rows":[{"name":"Spain on a Fork","color":"#55b8ad