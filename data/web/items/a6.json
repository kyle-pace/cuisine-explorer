atsu"],["List of Japanese restaurants","dish/list-of-japanese-restaurants"],["Makizushi","dish/makizushi"],["Miso","dish/miso"],["Miso soup","dish/miso-soup"],["Monjayaki","dish/monjayaki"],["Nikujaga","dish/nikujaga"],["Nimono","dish/nimono"],["Oden","dish/oden"],["Onigiri","dish/onigiri"],["Osechi","dish/osechi"],["Oyakodon","dish/oyakodon"],["Rainbow roll","dish/rainbow-roll"],["Ramen","dish/ramen"],["Ryōtei","dish/ryotei"],["Sashimi","dish/sashimi"],["Sencha","dish/sencha"],["Shizuoka oden","dish/shizuoka-oden"],["Sumiso","dish/sumiso"],["Sushi","dish/sushi"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/24/Bergh-Stoutenburgh_House%2C_angular_view_2013.jpg/500px-Bergh-Stoutenburgh_House%2C_angular_view_2013.jpg","w":500,"h":330,"by":"Daniel Case","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Bergh-Stoutenburgh_House%2C_angular_view_2013.jpg"}},"dish/chicken-nugget":{"t":"dish","r":"dish/chicken-nugget","n":"Chicken nugget","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["A chicken nugget is a food product consisting of a small piece of deboned chicken meat that is breaded or battered, then deep-fried or baked. Developed in the 1950s by finding a way to make a coating adhere, chicken nuggets have become a popular fast food restaurant item, and are widely sold frozen for home use. There are also vegetarian \"chicken\" versions made from meat alternatives that are coated in bread as the standard ones are."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-chicken-nugget"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chicken_nugget"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Breadcrumbs","ingredient/breadcrumbs"],["Chicken","ingredient/chicken"]]},{"h":"More from American cuisine","links":[["Angel food cake","dish/angel-food-cake"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Beer cake","dish/beer-cake"],["Better than sex cake","dish/better-than-sex-cake"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Brown Betty (dessert)","dish/brown-betty-dessert"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Butter cake","dish/butter-cake"],["Caesar salad","dish/caesar-salad"],["Caramel apple","dish/caramel-apple"],["Carbonara","dish/carbonara"],["Cheesesteak","dish/cheesesteak"],["Chicago-style hot dog","dish/chicago-style-hot-dog"],["Chiffon cake","dish/chiffon-cake"],["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Chow-chow (food)","dish/chow-chow-food"],["Chowder","dish/chowder"],["Cioppino","dish/cioppino"],["Clam chowder","dish/clam-chowder"],["Clam dip","dish/clam-dip"],["Club sandwich","dish/club-sandwich"],["Cobb salad","dish/cobb-salad"],["Cobbler (food)","dish/cobbler-food"],["Cook's Corner","dish/cook-s-corner"],["Crab cake","dish/crab-cake"],["Croffle","dish/croffle"],["Dagwood Bumstead","dish/dagwood-bumstead"],["Dagwood sandwich","dish/dagwood-sandwich"],["Deep-dish pizza","dish/deep-dish-pizza"],["Desperation pie","dish/desperation-pie"],["Dirty rice","dish/dirty-rice"],["Donut hole","dish/donut-hole"],["Egg in the basket","dish/egg-in-the-basket"],["Fish and chips","dish/fish-and-chips"],["Fritter","dish/fritter"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/d1/A_bowl_of_chicken_nuggets.jpg/500px-A_bowl_of_chicken_nuggets.jpg","w":500,"h":357,"by":"Rye-96","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:A_bowl_of_chicken_nuggets.jpg"}},"dish/dugun-corbas":{"t":"dish","r":"dish/dugun-corbas","n":"Düğün çorbası","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Turkish cuisine","dot":"#f0b340","intro":[["Düğün çorbası is the Turkish cuisine soup on lamb or beef broth. Now is a popular dish for every day, mainly in the cold season, but initially the hearty soup Düğün çorbası was the opening meal on a wedding feast in the village, which could continue according to tradition for forty days and forty nights."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-dugun-corbas"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/D%C3%BC%C4%9F%C3%BCn_%C3%A7orbas%C4%B1"}],"sections":[{"h":"Where it's from","links":[["Turkish cuisine","cuisine/turkish-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Carrot","ingredient/carrot"],["Paprika","ingredient/paprika"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Ozlem's Turkish Table","color":"#55b8ad","shape":"site","sub":"ozlemsturkishtable.com","note":"Turkish-born cook and teacher Ozlem Warren's blog of home-style Turkish recipes.","url":"https://ozlemsturkishtable.com/tag/turkish-recipes/page/9","suggested":true,"kind":"blog"}]},{"h":"More from Turkish cuisine","links":[["Adana kebabı","dish/adana-kebab"],["Baba ghanoush","dish/baba-ghanoush"],["Bici bici","dish/bici-bici"],["Boortsog","dish/boortsog"],["Cabbage roll","dish/cabbage-roll"],["Çiğ köfte","dish/cig-kofte"],["Çökertme kebabı","dish/cokertme-kebab"],["Doner kebab","dish/doner-kebab"],["Eggplant jam","dish/eggplant-jam"],["İmam bayıldı","dish/imam-bay-ld"],["İskender kebap","dish/iskender-kebap"],["Kavurma","dish/kavurma"],["Keşkek","dish/keskek"],["Kuru fasulye","dish/kuru-fasulye"],["Kyopolou","dish/kyopolou"],["Mesir macunu","dish/mesir-macunu"],["Nevzine tatlısı","dish/nevzine-tatl-s"],["Ntolmás","dish/ntolmas"],["Pilaf","dish/pilaf"],["Piyaz","dish/piyaz"],["Qatlama","dish/qatlama"],["Rakı","dish/rak"],["Şıllık","dish/s-ll-k"],["Stuffed leaves","dish/stuffed-leaves"],["Stuffed peppers","dish/stuffed-peppers"],["Stuffed squash","dish/stuffed-squash"],["Stuffed tomatoes","dish/stuffed-tomatoes"],["Taramasalata","dish/taramasalata"],["Yayla çorbası","dish/yayla-corbas"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b2/Wedding_soup_from_the_Turkish_cuisine.jpg/500px-Wedding_soup_from_the_Turkish_cuisine.jpg","w":500,"h":375,"by":"E4024","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Wedding_soup_from_the_Turkish_cuisine.jpg"}},"dish/freddo-cappuccino":{"t":"dish","r":"dish/freddo-cappuccino","n":"Freddo cappuccino","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Greek cuisine","dot":"#cf5f87","intro":[["Coffee drinks are made by brewing water with ground coffee beans. The brewing is either done slowly, by drip, filter, French press, moka pot or percolator, or done very quickly, under pressure, by an espresso machine. When put under the pressure of an espresso machine, the coffee is termed espresso, while slow-brewed coffees are generally termed brewed coffee. While all coffee drinks are based on either coffee or espresso, some drinks add milk or cream, some are made with steamed milk or non-dairy milks, or add water (like the americano). Upon milk additions, coffee's flavor can vary with different syrups or sweeteners, alcoholic liqueurs, and even combinations of coffee with espresso or tea. There are many variations to the basic coffee or espresso bases."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-freddo-cappuccino"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Freddo_cappuccino"}],"sections":[{"h":"Where it's from","links":[["Greek cuisine","cuisine/greek-cuisine"]]},{"h":"Cook it","rows":[{"name":"Dimitra's Dishes","color":"#55b8ad","shape":"site","sub":"dimitrasdishes.com","note":"Dimitra Alfieris's video channel and blog focused on classic Greek home cooking.","url":"https://dimitrasdishes.com","suggested":true,"kind":"youtube"}]},{"h":"More from Greek cuisine","links":[["Avgolemono","dish/avgolemono"],["Baba ghanoush","dish/baba-ghanoush"],["Bouyiourdi","dish/bouyiourdi"],["Cabbage roll","dish/cabbage-roll"],["Diples","dish/diples"],["Fasolada","dish/fasolada"],["Greek restaurant","dish/greek-restaurant"],["Greek salad","dish/greek-salad"],["İmam bayıldı","dish/imam-bay-ld"],["Kakavia (soup)","dish/kakavia-soup"],["Kalitsounia","dish/kalitsounia"],["Karydopita","dish/karydopita"],["Keşkek","dish/keskek"],["Ladera","dish/ladera"],["Noumboulo","dish/noumboulo"],["Psarosoupa","dish/psarosoupa"],["Spanakorizo","dish/spanakorizo"],["Taramasalata","dish/taramasalata"],["Tzatziki","dish/tzatziki"]]}]},"dish/fregula":{"t":"dish","r":"dish/fregula","n":"Fregula","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Sardinian cuisine","dot":"#cf5f87","intro":[["Fregula (often written fregola) is a type of semolina  pasta from the Sardinia region of Italy."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-fregula"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fregula"}],"sections":[{"h":"Where it's from","links":[["Sardinian cuisine","cuisine/cuisine-of-sardinia"]]},{"h":"Ingredients","count":1,"links":[["Semolina","ingredient/semolina"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/29/UncookedFregula.jpg/500px-UncookedFregula.jpg","w":500,"h":376,"by":"Emily Parkhurst","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:UncookedFregula.jpg"}},"ingredient/lotus-plant":{"t":"ingredient","r":"ingredient/lotus-plant","n":"Lotus (plant)","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Lotus identifies various plant taxa:"]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-lotus-plant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lotus_(plant)"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Jian dui","dish/jian-dui"]]]]},{"h":"Often cooked with","links":[["Adzuki bean","ingredient/adzuki-bean"],["Black adzuki bean","ingredient/