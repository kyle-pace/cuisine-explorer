"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:02016_07_Schweinskotelett_mit_Gem%C3%BCse_und_R%C3%B6sterd%C3%A4pfel.jpg"}},"cuisine/asturian-cuisine":{"t":"cuisine","r":"cuisine/asturian-cuisine","n":"Asturian cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Spanish cuisine","cuisine/spanish-cuisine"]],"sub":"Regional cuisine in Spain","intro":[["Asturian cuisine refers to the typical dishes and ingredients found in the cuisine of the Asturias region of Spain."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"asturian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Asturian_cuisine"}],"sections":[{"h":"Dishes","count":2,"links":[["Embutido","dish/embutido"],["Tocino de cielo","dish/tocino-de-cielo"]]},{"h":"Recipe sites","empty":"None yet","tryLinks":[["Spanish cuisine","cuisine/spanish-cuisine"]]},{"h":"Key ingredients","links":[["Egg yolk","ingredient/egg-yolk"],["Egg yolks","ingredient/egg-yolks"],["Sugar","ingredient/sugar"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["Spanish cuisine","cuisine/spanish-cuisine"]]}],"cont":"European cuisine","img":{"src":"/labs/cuisines/img/thumb/c/c1/Cocido_de_Fabes-01.JPG/500px-Cocido_de_Fabes-01.JPG","w":500,"h":333,"by":"Tamorlan","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Cocido_de_Fabes-01.JPG"}},"ingredient/glass-noodles":{"t":"ingredient","r":"ingredient/glass-noodles","n":"Glass noodles","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Glass noodles, or fensi, sometimes called cellophane noodles, are a type of transparent noodle made from starch (such as mung bean starch, potato starch, sweet potato starch, tapioca, or canna starch) and water. They originated in China. A stabilizer such as chitosan or alum (illegal in some jurisdictions) may also be used."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-glass-noodles"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Glass_noodles"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Koryo-saram cuisine","cuisine/koryo-saram-cuisine",[["Funchoza","dish/funchoza"]]],["Taiwan cuisine","cuisine/taiwan-cuisine",[["Ageh (food)","dish/ageh-food"]]]]},{"h":"Often cooked with","links":[["Cellophane noodles","ingredient/cellophane-noodles"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/90/Cooked_dangmyeon.jpg/500px-Cooked_dangmyeon.jpg","w":500,"h":281,"by":"토리랑","lic":"CC BY 4.0","licUrl":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:Cooked_dangmyeon.jpg"}},"ingredient/capsicum-chinense":{"t":"ingredient","r":"ingredient/capsicum-chinense","n":"Capsicum chinense","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 4 cuisines","intro":[["Capsicum chinense, commonly known as a \"habanero-type pepper\", is a species of chili pepper native to the Americas. C. chinense varieties are well known for their unique flavors and, in many cases, exceptional heat. The hottest peppers in the world are members of this species, with a Scoville heat unit score of 2.69 million measured in the C. chinense cultivar Pepper X in 2023."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-capsicum-chinense"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Capsicum_chinense"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Argentine cuisine","cuisine/argentine-cuisine",[["Anticucho","dish/anticucho"]]],["Bolivian cuisine","cuisine/bolivian-cuisine",[["Anticucho","dish/anticucho"]]],["Chilean cuisine","cuisine/chilean-cuisine",[["Anticucho","dish/anticucho"]]],["Peruvian cuisine","cuisine/peruvian-cuisine",[["Anticucho","dish/anticucho"]]]]},{"h":"Often cooked with","links":[["Offal","ingredient/offal"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/da/Habanero_chile_-_fruits_%28aka%29.jpg/500px-Habanero_chile_-_fruits_%28aka%29.jpg","w":500,"h":378,"by":"André Karwath aka Aka","lic":"CC BY-SA 2.5","licUrl":"https://creativecommons.org/licenses/by-sa/2.5","page":"https://commons.wikimedia.org/wiki/File:Habanero_chile_-_fruits_(aka).jpg"}},"ingredient/golden-syrup":{"t":"ingredient","r":"ingredient/golden-syrup","n":"Golden syrup","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Golden syrup or light treacle is a thick, amber-coloured form of inverted sugar syrup made by the process of refining sugar cane or sugar beet juice into sugar.  It is used in a variety of baking recipes and desserts. It has an appearance and consistency similar to honey, and is often used as a substitute where honey is unavailable."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-golden-syrup"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Golden_syrup"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Australian cuisine","cuisine/australian-cuisine",[["Anzac biscuit","dish/anzac-biscuit"]]],["New Zealand cuisine","cuisine/new-zealand-cuisine",[["Anzac biscuit","dish/anzac-biscuit"]]]]},{"h":"Often cooked with","links":[["Butter","ingredient/butter"],["Rolled oats","ingredient/rolled-oats"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/45/Golden_Syrup.JPG/500px-Golden_Syrup.JPG","w":500,"h":375,"by":"Londonsista","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Golden_Syrup.JPG"}},"ingredient/bacalhau":{"t":"ingredient","r":"ingredient/bacalhau","n":"Bacalhau","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 8 dishes across 3 cuisines","intro":[["Bacalhau is the Portuguese word for cod and—in a culinary context—dried and salted cod. Fresh (unsalted) cod is referred to as bacalhau fresco (fresh cod)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-bacalhau"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bacalhau"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Portuguese cuisine","cuisine/portuguese-cuisine",[["Bacalhau à Brás","dish/bacalhau-a-bras"],["Bacalhau à Gomes de Sá","dish/bacalhau-a-gomes-de-sa"],["Bacalhau à minhota","dish/bacalhau-a-minhota"],["Bacalhau à Narcisa","dish/bacalhau-a-narcisa"],["Bacalhau à Zé do Pipo","dish/bacalhau-a-ze-do-pipo"],["Bacalhau com natas","dish/bacalhau-com-natas"]]],["Spanish cuisine","cuisine/spanish-cuisine",[["Soldaditos de Pavía","dish/soldaditos-de-pavia"]]],["Valencian cuisine","cuisine/valencian-cuisine",[["Esgarrat","dish/esgarrat"]]]]},{"h":"Often cooked with","links":[["Salt cod","ingredient/salt-cod"],["Olive oil","ingredient/olive-oil"],["Olive","ingredient/olive"],["Fried potatoes","ingredient/fried-potatoes"],["Fries","ingredient/fries"],["Onions","ingredient/onions"],["Egg","ingredient/egg"],["Parsley","ingredient/parsley"],["Olives","ingredient/olives"],["Onion","ingredient/onion"],["Chili pepper","ingredient/chili-pepper"],["Cream","ingredient/cream"],["Double cream","ingredient/double-cream"],["Atlantic cod","ingredient/atlantic-cod"],["Potato","ingredient/potato"],["Grelos","ingredient/grelos"]]}],"img":{"src":"/labs/cuisines/img/thumb/c/ce/Klippfisk.jpg/500px-Klippfisk.jpg","w":500,"h":667,"by":"Karl Ragnar Gjertsen Krg This photo was taken by Karl Ragnar Gjertsen. Please credit…","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Klippfisk.jpg"}},"ingredient/pork-chop":{"t":"ingredient","r":"ingredient/pork-chop","n":"Pork chop","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A pork chop is a thick slice of meat cut from the domestic pig, particularly one adjacent to a rib and usually served with it. It may be cooked in many ways, the simplest being fried or grilled, plain or coated with flour and dipped in egg and breadcrumbs. Numerous combinations of vegetables, fruits, spices and herbs are cooked with pork chops in the cuisines of many countries, including Austria, Britain, China, France, Germany, Italy, Spain and the US."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-pork-chop"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pork_chop"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Hong Kong cuisine","cuisine/hong-kong-cuisine",[["Baked pork chop rice","dish/baked-pork-chop-rice"]]]]},{"h":"Often cooked with","links":[["Cheese","ingredient/cheese"],["Pork chops","ingredient/pork-chops"],["Rice","ingredient/rice"],["Tomato sauce","ingredient/tomato-sauce"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/2b/Pork_chops_167541218.jpg/500px-Pork_chops_167541218.jpg","w":500,"h":375,"by":"penny from Oakland, California, USA","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Pork_chops_167541218.jpg"}},"dish/concha":{"t":"dish","r":"dish/concha","n":"Concha","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Mexican cuisine","dot":"#94bd5c","intro":[["A concha is a traditional Mexican sweet bread (pan dulce) with similar consistency to a brioche. Conchas get their name from their round shape and their striped, seashell-like appearance. A concha consists of two parts: a sweetened bread roll, and a crunchy topping (composed of flour, butter, and sugar), the most common topping flavors being chocolate, vanilla, and strawberry. Conchas are commonly found throughout Mexico, Guatemala, and their diasporas in panaderias (bakeries). They can also be found in grocery stores and bakeries across the United States."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-concha"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Concha"}],"sections":[{"h":"Where it's from","links":[["Mexican cuisine","cuisine/mexican-cuisine"]]},{"h":"Cook it","rows":[{"name":"Mexico in My Kitchen","color":"#55b8ad","shape":"site","sub":"mexicoinmykitchen.com","note":"Mely Martínez's long-running blog of Mexican home-style recipes.","url":"https://www.mexicoinmykitchen.com/","suggested":true,"kind":"blog"},{"name":"Pati Jinich","color":"#55b8ad","shape":"site","sub":"patijinich.com","note":"Recipe archive from the Mexican-born chef and host of the PBS series Pati's Mexican Table.","url":"https://patijinich.com/recipes/","suggested":true,"kind":"site"}]},{"h":"More from Mexican cuisine","links":[["Chile con queso","dish/chile-con-queso"],["Chili con carne","dish/chili-con-carne"],["Chimichanga","dish/chimichanga"],["Discada","dish/discada"],["El Adobe de Capistrano","dish/el-adobe-de-capistrano"],["Guacamole","dish/guacamole"],["Huevos rancheros","dish/huevos-rancheros"],["List of Mexican restaurants","dish/list-of-mexican-restaurants"],["Mexican juice bar","dish/mexican-juice-bar"],["Mexican restaurant","dish/mexican-restaurant"],["Nachos","dish/nachos"],["Pico de gallo","dish/pico-de-gallo"],["Pozole","dish/pozole"],["Quesabirria","dish/quesabirria"],["Quesadilla","dish/quesadilla"],["Real Mex Restaurants","dish/real-mex-restaurants"],["Relleno negro","dish/relleno-negro"],["Sopa de lima","dish/sopa-de-lima"],["Taco","dish/taco"],["Taquería","dish/taqueria"],["Tortilla soup","dish/tortilla-soup"],["Walnut soup","dish/walnut-soup"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/bd/Concha_%28pan_dulce_mexicano%29_02.JPG/500px-Concha_%28pan_dulce_mexicano%29_02.JPG","w":500,"h":333,"by":"ProtoplasmaKid","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Concha_(pan_dulce_mexicano)_02.JPG"}},"dish/fuqi-feipian":{"t":"dish","r":"dish/fuqi-feipian","n":"Fuqi feipian","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Chinese cuisine","dot":"#f0b340","intro":[["Fuqi feipian is a popular Sichuan dish, served cold or at room temperature, which is made of thinly sliced beef and beef offal. Common ingredients in the modern version include beef heart, tongue and tripe, and a generous amount of various spices, including Sichuan pepper. True to its Sichuan roots, the desired taste should be both spicy and mouth-numbing. Despite its name, actual lung is rarely used."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-fuqi-feipian"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fuqi_feipian"}],"sections":[{"h":"Where it's from","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Cook it","rows":[{"name":"The Woks of Life","color":"#55b8ad","shape":"site","sub":"thewoksoflife.com","note":"Chinese and Chinese American recipes from the Leung family, running since 2013.","url":"https://thewoksoflife.com/","suggested":true,"kind":"blog"},{"name":"Chinese Cooking Demystified","color":"#55b8ad","shape":"site","sub":"youtube.com","note":"Technique-heavy YouTube channel on regional Chinese home and restaurant cooking.","url":"https://www.youtube.com/@ChineseCookingDemystified","suggested":true,"kind":"youtube"},{"name":"Red House Spice","color":"#55b8ad","shape":"site","sub":"redhousespice.com","note":"Classic Chinese recipes from Wei Guo, who grew up in Gansu, blogging since 2017.","url":"https://redhousespice.com/about/","suggested":true,"kind":"blog"}]},{"h":"More from Chinese cuisine","links":[["Almond biscuit","dish/almond-biscuit"],["Banana roll","dish/banana-roll"],["Baozi","dish/baozi"],["Bear paw","dish/bear-paw"],["Black sesame roll","dish/black-sesame-roll"],["Century egg","dish/century-egg"],["Cha siu bao","dish/cha-siu-bao"],["Chinese restaurant","dish/chinese-restaurant"],["Dandan noodles","dish/dandan-noodles"],["Dapanji","dish/dapanji"],["Dong'an chicken","dish/dong-an-chicken"],["Dongpo pork","dish/dongpo-pork"],["Donkey burger","dish/donkey-burger"],["Doujiang","dish/doujia