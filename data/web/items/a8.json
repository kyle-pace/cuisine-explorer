"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Chinese cuisine","dot":"#f0b340","intro":[["Fuqi feipian is a popular Sichuan dish, served cold or at room temperature, which is made of thinly sliced beef and beef offal. Common ingredients in the modern version include beef heart, tongue and tripe, and a generous amount of various spices, including Sichuan pepper. True to its Sichuan roots, the desired taste should be both spicy and mouth-numbing. Despite its name, actual lung is rarely used."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-fuqi-feipian"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fuqi_feipian"}],"sections":[{"h":"Where it's from","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Cook it","rows":[{"name":"The Woks of Life","ref":"site/thewoksoflife-com","color":"#55b8ad","shape":"site","sub":"thewoksoflife.com","note":"Chinese and Chinese American recipes from the Leung family, running since 2013.","url":"https://thewoksoflife.com/","suggested":true},{"name":"Chinese Cooking Demystified","ref":"site/youtube-com","color":"#55b8ad","shape":"site","sub":"youtube.com","note":"Technique-heavy YouTube channel on regional Chinese home and restaurant cooking.","url":"https://www.youtube.com/@ChineseCookingDemystified","suggested":true},{"name":"Red House Spice","ref":"site/redhousespice-com","color":"#55b8ad","shape":"site","sub":"redhousespice.com","note":"Classic Chinese recipes from Wei Guo, who grew up in Gansu, blogging since 2017.","url":"https://redhousespice.com/about/","suggested":true}]},{"h":"More from Chinese cuisine","links":[["A+ Hong Kong Kitchen","dish/a-hong-kong-kitchen"],["Almond biscuit","dish/almond-biscuit"],["Banana roll","dish/banana-roll"],["Baozi","dish/baozi"],["Bear paw","dish/bear-paw"],["Black sesame roll","dish/black-sesame-roll"],["Century egg","dish/century-egg"],["Cha siu bao","dish/cha-siu-bao"],["Chinese restaurant","dish/chinese-restaurant"],["Chinese Tuxedo","dish/chinese-tuxedo