ope"],["Spanish cuisine","cuisine/spanish-cuisine"]],"sub":"Regional cuisine in Spain","intro":[["Asturian cuisine refers to the typical dishes and ingredients found in the cuisine of the Asturias region of Spain."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"asturian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Asturian_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Spanish cuisine","cuisine/spanish-cuisine"]]},{"h":"Dishes","count":2,"links":[["Embutido","dish/embutido"],["Tocino de cielo","dish/tocino-de-cielo"]]},{"h":"Key ingredients","links":[["Egg yolk","ingredient/egg-yolk"],["Egg yolks","ingredient/egg-yolks"],["Sugar","ingredient/sugar"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["Spanish cuisine","cuisine/spanish-cuisine"]]}],"cont":"European cuisine"},"ingredient/glass-noodles":{"t":"ingredient","r":"ingredient/glass-noodles","n":"Glass noodles","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Glass noodles, or fensi, sometimes called cellophane noodles, are a type of transparent noodle made from starch (such as mung bean starch, potato starch, sweet potato starch, tapioca, or canna starch) and water. They originated in China. A stabilizer such as chitosan or alum (illegal in some jurisdictions) may also be used."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-glass-noodles"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Glass_noodles"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Koryo-saram cuisine","cuisine/koryo-saram-cuisine",[["Funchoza","dish/funchoza"]]],["Taiwan cuisine","cuisine/taiwan-cuisine",[["Ageh (food)","dish/ageh-food"]]]]},{"h":"Often cooked with","links":[["Cellophane noodles","ingredient/cellophane-noodles"]]}]},"ingredient/capsicum-chinense":{"t":"ingredient","r":"ingredient/capsicum-chinense","n":"Capsicum chinense","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 4 cuisines","intro":[["Capsicum chinense, commonly known as a \"habanero-type pepper\", is a species of chili pepper native to the Americas. C. chinense varieties are well known for their unique flavors and, in many cases, exceptional heat. The hottest peppers in the world are members of this species, with a Scoville heat unit score of 2.69 million measured in the C. chinense cultivar Pepper X in 2023."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-capsicum-chinense"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Capsicum_chinense"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Argentine cuisine","cuisine/argentine-cuisine",[["Anticucho","dish/anticucho"]]],["Bolivian cuisine","cuisine/bolivian-cuisine",[["Anticucho","dish/anticucho"]]],["Chilean cuisine","cuisine/chilean-cuisine",[["Anticucho","dish/anticucho"]]],["Peruvian cuisine","cuisine/peruvian-cuisine",[["Anticucho","dish/anticucho"]]]]},{"h":"Often cooked with","links":[["Offal","ingredient/offal"]]}]},"ingredient/golden-syrup":{"t":"ingredient","r":"ingredient/golden-syrup","n":"Golden syrup","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Golden syrup or light treacle is a thick, amber-coloured form of inverted sugar syrup made by the process of refining sugar cane or sugar beet juice into sugar.  It is used in a variety of baking recipes and desserts. It has an appearance and consistency similar to honey, and is often used as a substitute where honey is unavailable."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-golden-syrup"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Golden_syrup"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Australian cuisine","cuisine/australian-cuisine",[["Anzac biscuit","dish/anzac-biscuit"]]],["New Zealand cuisine","cuisine/new-zealand-cuisine",[["Anzac biscuit","dish/anzac-biscuit"]]]]},{"h":"Often cooked with","links":[["Butter","ingredient/butter"],["Rolled oats","ingredient/rolled-oats"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]}]},"ingredient/bacalhau":{"t":"ingredient","r":"ingredient/bacalhau","n":"Bacalhau","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 8 dishes across 3 cuisines","intro":[["Bacalhau is the Portuguese word for cod and—in a culinary context—dried and salted cod. Fresh (unsalted) cod is referred to as bacalhau fresco (fresh cod)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-bacalhau"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bacalhau"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Portuguese cuisine","cuisine/portuguese-cuisine",[["Bacalhau à Brás","dish/bacalhau-a-bras"],["Bacalhau à Gomes de Sá","dish/bacalhau-a-gomes-de-sa"],["Bacalhau à minhota","dish/bacalhau-a-minhota"],["Bacalhau à Narcisa","dish/bacalhau-a-narcisa"],["Bacalhau à Zé do Pipo","dish/bacalhau-a-ze-do-pipo"],["Bacalhau com natas","dish/bacalhau-com-natas"]]],["Spanish cuisine","cuisine/spanish-cuisine",[["Soldaditos de Pavía","dish/soldaditos-de-pavia"]]],["Valencian cuisine","cuisine/valencian-cuisine",[["Esgarrat","dish/esgarrat"]]]]},{"h":"Often cooked with","links":[["Salt cod","ingredient/salt-cod"],["Olive oil","ingredient/olive-oil"],["Olive","ingredient/olive"],["Fried potatoes","ingredient/fried-potatoes"],["Fries","ingredient/fries"],["Onions","ingredient/onions"],["Egg","ingredient/egg"],["Parsley","ingredient/parsley"],["Olives","ingredient/olives"],["Onion","ingredient/onion"],["Chili pepper","ingredient/chili-pepper"],["Cream","ingredient/cream"],["Double cream","ingredient/double-cream"],["Atlantic cod","ingredient/atlantic-cod"],["Potato","ingredient/potato"],["Grelos","ingredient/grelos"]]}]},"ingredient/pork-chop":{"t":"ingredient","r":"ingredient/pork-chop","n":"Pork chop","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A pork chop is a thick slice of meat cut from the domestic pig, particularly one adjacent to a rib and usually served with it. It may be cooked in many ways, the simplest being fried or grilled, plain or coated with flour and dipped in egg and breadcrumbs. Numerous combinations of vegetables, fruits, spices and herbs are cooked with pork chops in the cuisines of many countries, including Austria, Britain, China, France, Germany, Italy, Spain and the US."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-pork-chop"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pork_chop"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Hong Kong cuisine","cuisine/hong-kong-cuisine",[["Baked pork chop rice","dish/baked-pork-chop-rice"]]]]},{"h":"Often cooked with","links":[["Cheese","ingredient/cheese"],["Pork chops","ingredient/pork-chops"],["Rice","ingredient/rice"],["Tomato sauce","ingredient/tomato-sauce"]]}]},"dish/besaw-s":{"t":"dish","r":"dish/besaw-s","n":"Besaw's","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["Besaw's is restaurant serving American cuisine in Portland, Oregon's Northwest District, in the United States."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-besaw-s"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Besaw's"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"More from American cuisine","links":[["5-8 Club","dish/5-8-club"],["Altabira City Tavern","dish/altabira-city-tavern"],["Angel food cake","dish/angel-food-cake"],["Applebee's","dish/applebee-s"],["Arby's","dish/arby-s"],["Arnold's Bar and Grill","dish/arnold-s-bar-and-grill"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Be Our Guest Restaurant","dish/be-our-guest-restaurant"],["Beer cake"