ts","ingredients"]],"sub":"Ingredient in 5 dishes across 6 cuisines","intro":[["A lime is the fruit of several species of citrus, most of which are hybrids within the genus Citrus (family Rutaceae). Limes are generally small, round to oval fruits with green flesh and skin and a distinctly sour taste due to their high citric acid content. They are widely cultivated in tropical and subtropical regions for culinary, medicinal, and ornamental purposes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-lime-fruit"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lime_(fruit)"}],"sections":[{"h":"Where it's cooked with","count":6,"groups":[["Thai cuisine","cuisine/thai-cuisine",[["Pad thai","dish/pad-thai"],["Tom yum","dish/tom-yum"]]],["Indian cuisine","cuisine/indian-cuisine",[["Pathia","dish/pathia"]]],["Iranian cuisine","cuisine/iranian-cuisine",[["Shirazi salad","dish/shirazi-salad"]]],["Mexican cuisine","cuisine/mexican-cuisine",[["Guacamole","dish/guacamole"]]],["Parsi cuisine","cuisine/parsi-cuisine",[["Pathia","dish/pathia"]]],["Tex-Mex cuisine","cuisine/tex-mex-cuisine",[["Guacamole","dish/guacamole"]]]]},{"h":"Often cooked with","links":[["Chili pepper","ingredient/chili-pepper"],["Onion","ingredient/onion"],["Fish sauce","ingredient/fish-sauce"],["Avocado","ingredient/avocado"],["Edible salt","ingredient/edible-salt"],["Jalapeño","ingredient/jalapeno"],["Bean sprouts","ingredient/bean-sprouts"],["Coconut sugar","ingredient/coconut-sugar"],["Dried shrimp","ingredient/dried-shrimp"],["Egg","ingredient/egg"],["Garlic","ingredient/garlic"],["Jaggery","ingredient/jaggery"],["Mung bean sprout","ingredient/mung-bean-sprout"],["Peanut","ingredient/peanut"],["Rice noodles","ingredient/rice-noodles"],["Shallots","ingredient/shallots"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/8b/Lime_Blossom.jpg/500px-Lime_Blossom.jpg","w":500,"h":375,"by":"Prosthetic Head","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Lime_Blossom.jpg"}},"dish/jjajangmyeon":{"t":"dish","r":"dish/jjajangmyeon","n":"Jjajangmyeon","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Korean Chinese cuisine","dot":"#f0b340","intro":[["Jjajangmyeon or Jajangmyeon (자장면)  is a Korean Chinese noodle dish topped with a thick sauce made of chunjang, diced pork, and vegetables. It is a variation of the Chinese dish zhajiangmian; it developed in the late 19th century, during the Joseon period, when Chinese migrant workers from Shandong arrived in Incheon. The Korean variant of the dish uses a darker and sweeter sauce than the Chinese version. Variants of the dish use seafood, or other meats."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-jjajangmyeon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Jjajangmyeon"}],"sections":[{"h":"Where it's from","links":[["Korean Chinese cuisine","cuisine/korean-chinese-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Cumian","ingredient/cumian"],["Noodles","ingredient/noodles"],["Sweet bean sauce","ingredient/sweet-bean-sauce"]]},{"h":"Cook it","rows":[{"name":"Korean Bapsang","color":"#55b8ad","shape":"site","sub":"koreanbapsang.com","note":"Korean Bapsang's section on Korean Chinese dishes such as jjajangmyeon and jjamppong.","url":"https://www.koreanbapsang.com/category/korean-chinese","suggested":true,"kind":"blog"}]},{"h":"More from Korean Chinese cuisine","links":[["Hotteok","dish/hotteok"],["Jjamppong","dish/jjamppong"],["Jungguk-naengmyeon","dish/jungguk-naengmyeon"],["Ulmyeon","dish/ulmyeon"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a0/Korean_black_bean_noodle_dish-Jaengban_Jajangmyeon-01.jpg/500px-Korean_black_bean_noodle_dish-Jaengban_Jajangmyeon-01.jpg","w":500,"h":332,"by":"by 아침꿀물 at Flickr","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Korean_black_bean_noodle_dish-Jaengban_Jajangmyeon-01.jpg"}},"dish/khorovat