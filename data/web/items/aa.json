{"cuisine/pashtun-cuisine":{"t":"cuisine","r":"cuisine/pashtun-cuisine","n":"Pashtun cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Afghan cuisine","cuisine/afghan-cuisine"],["Pakistani cuisine","cuisine/pakistani-cuisine"]],"sub":"Regional cuisine in Afghanistan","intro":[["Pashtun cuisine or Afghan cuisine refers to the cuisine of the Pashtun people and is covered under Afghan, Central Asian and South Asian cuisines. It is largely based on meat dishes including mutton, beef, chicken, and fish, as well as rice and some other vegetables. Accompanying these staples are dairy products (yogurt, whey, cheeses), various nuts, local vegetables, and fresh and dried fruits. Peshawar, Kabul, Herat, Bannu, Quetta, Mardan, Mardan, Mianwali and Attock are centers of Pashtun cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"pashtun-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pashtun_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Afghan cuisine","cuisine/afghan-cuisine"],["Pakistani cuisine","cuisine/pakistani-cuisine"]]},{"h":"Part of","links":[["Afghan cuisine","cuisine/afghan-cuisine"],["Pakistani cuisine","cuisine/pakistani-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/thumb/c/c1/Afghan_cuisine.jpg/500px-Afghan_cuisine.jpg","w":500,"h":449,"by":"Officer","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Afghan_cuisine.jpg"}},"dish/ageh-food":{"t":"dish","r":"dish/ageh-food","n":"Ageh (food)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Taiwan cuisine","dot":"#f0b340","intro":[["Ageh or Tamsui ageh (Chinese: 淡水阿給; Pe̍h-ōe-jī: Tām-súi á-geh) is a speciality food originating from Tamsui District of New Taipei City and consists of a piece of fried tofu, stuffed with cooked cellophane noodles, and sealed with surimi, which is widely sold by vendors in the district. The name ageh was derived from aburaage (aburaage (油揚げ), age (あげ)), a fried and stewed Japanese tofu packet from which the ageh is made."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-ageh-food"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ageh_(food)"}],"sections":[{"h":"Where it's from","links":[["Taiwan cuisine","cuisine/taiwan-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Glass noodles","ingredient/glass-noodles"]]},{"h":"Cook it","rows":[{"name":"Cooking in Chinglish","ref":"site/cookinginchinglish-com","color":"#55b8ad","shape":"site","sub":"cookinginchinglish.com","note":"Taiwanese home recipes from Edwina, who grew up in Taiwan.","url":"https://cookinginchinglish.com","suggested":true},{"name":"Tiny Urban Kitchen: Taiwanese Recipes","ref":"site/tinyurbankitchen-com","color":"#55b8ad","shape":"site","sub":"tinyurbankitchen.com","note":"Small set of Taiwanese recipes from Jen Che, a Taiwanese American blogger in Hong Kong.","url":"https://tinyurbankitchen.com/taiwanese-recipes/","suggested":true}]},{"h":"More from Taiwan cuisine","links":[["886 (restaurant)","dish/886-restaurant"],["Alivongvong","dish/alivongvong"],["Alkemē","dish/alkeme"],["Apple bread","dish/apple-bread"],["Bah-uân","dish/bah-uan"],["Braised pork rice","dish/braised-pork-rice"],["Coffin bread","dish/coffin-bread"],["Doujiang","dish/doujiang"],["Egg yolk pastry","dish/egg-yolk-pastry"],["Iron egg","dish/iron-egg"],["Kato (restaurant)","dish/kato-restaurant"],["Kiâm-piánn","dish/kiam-piann"],["Ló͘-bah-pn̄g","dish/lo-bah-png"],["Mongolian barbecue","dish/mongolian-barbecue"],["Peanut ice cream roll","dish/peanut-ice-cream-roll"],["Penglai rice","dish/penglai-rice"],["Pineapple cake","dish/pineapple-cake"],["Pineapple shrimp balls","dish/pineapple-shrimp-balls"],["Pork ball","dish/pork-ball"],["Rechao","dish/rechao"],["Shuangbaotai","dish/shuangbaotai"],["Small sausage in large sausage","dish/small-sausage-in-large-sausage"],["Taiwanese beef noodle soup","dish/taiwanese-beef-noodle-soup"],["Taiwanese fried chicken","dish/taiwanese-fried-chi