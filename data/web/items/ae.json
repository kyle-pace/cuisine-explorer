":[{"h":"Where it's cooked with","count":4,"groups":[["Belarusian cuisine","cuisine/belarusian-cuisine",[["Zatiruha","dish/zatiruha"]]],["Belgian cuisine","cuisine/belgian-cuisine",[["Boûkète","dish/boukete"]]],["French cuisine","cuisine/french-cuisine",[["Kig ha farz","dish/kig-ha-farz"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Kig ha farz","dish/kig-ha-farz"]]]]},{"h":"Often cooked with","links":[["Lard","ingredient/lard"],["Broth","ingredient/broth"],["Egg","ingredient/egg"],["Milk","ingredient/milk"],["Raisin","ingredient/raisin"],["Buckwheat","ingredient/buckwheat"],["Pudding","ingredient/pudding"],["Noodle","ingredient/noodle"],["Rye flour","ingredient/rye-flour"],["Starch","ingredient/starch"],["Wheat flour","ingredient/wheat-flour"]]}]},"ingredient/durum-wheat":{"t":"ingredient","r":"ingredient/durum-wheat","n":"Durum wheat","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 1 cuisine","intro":[["Durum (), also called pasta wheat or macaroni wheat (Triticum durum or Triticum turgidum subsp. durum), is a tetraploid species of wheat. It is the second-most cultivated species of wheat after common wheat, although it represents only 5 to 8% of global wheat production. It was developed by artificial selection of the domesticated emmer wheat strains formerly grown in Central Europe and the Near East around 7000 BC, which developed a naked, free-threshing form. Like emmer, durum is awned (with bristles). It is the predominant wheat grown in the Middle East."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-durum-wheat"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Durum_wheat"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Italian cuisine","cuisine/italian-cuisine",[["Capellini","dish/capellini"],["Paccheri","dish/paccheri"],["Tagliatelle","dish/tagliatelle"]]]]},{"h":"Often cooked with","links":[["Egg","ingredient/egg"],["Semolina","ingredient/semolina"],["Whea