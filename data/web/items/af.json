img":{"src":"/labs/cuisines/img/thumb/c/cf/Frankies_457_Spuntino.jpg/500px-Frankies_457_Spuntino.jpg","w":500,"h":375,"by":"Transpoman","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Frankies_457_Spuntino.jpg"}},"dish/karas-food":{"t":"dish","r":"dish/karas-food","n":"Karas (food)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Malay cuisine","dot":"#f0b340","intro":[["Karas or Kuih Karas is a traditional food in Kedah. It is usually found in Kota Setar District. It is suitable to eat during tea time with a cup of hot coffee."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-karas-food"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Karas_(food)"}],"sections":[{"h":"Where it's from","links":[["Malay cuisine","cuisine/malay-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Rice flour","ingredient/rice-flour"],["Sugar","ingredient/sugar"]]},{"h":"More from Malay cuisine","links":[["Akok (food)","dish/akok-food"],["Ikan bakar","dish/ikan-bakar"],["Ketupat","dish/ketupat"],["Lekor","dish/lekor"],["Mee siput","dish/mee-siput"],["Nasi Ayam","dish/nasi-ayam"],["Nasi kerabu","dish/nasi-kerabu"],["Nasi tumpang","dish/nasi-tumpang"],["Roti jala","dish/roti-jala"],["Sata (food)","dish/sata-food"],["Tahu goreng","dish/tahu-goreng"],["Ulam (salad)","dish/ulam-salad"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/d0/Karas_%28food%29.jpg/500px-Karas_%28food%29.jpg","w":500,"h":667,"by":"Senior Staff01","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Karas_(food).jpg"}},"dish/la-ferme-de-mon-pere":{"t":"dish","r":"dish/la-ferme-de-mon-pere","n":"La Ferme de Mon Père","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["La Ferme de Mon Père (French for \"My Father's Farm\") was a restaurant in Megève, France, owned by the French chef Marc Veyrat. It was famous for being one of two restaurants, both owned by Veyrat, to receive a perfect score (20/20) from the French food guidebook Gault Millau. No restaurant had earned a perfect score of 20 before because the authors of Gault Millau had thought perfection was impossible to achieve. It combined an inn with the restaurant, both operating under the same name in a reconstructed farmhouse. The restaurant also had a three-star rating from the Michelin Guide. One of the most unusual aspects of the design of the restaurant was the presence of farm animals inside the building and visible from the dining area.  During your meal you could look through interior windows placed in the walls and at least one window in the floor and watch bucolic scenes from a barn includ"]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-la-ferme-de-mon-pere"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/La_Ferme_de_Mon_P%C3%A8re"}],"sections":[{"h":"Where it's from","links":[["French cuisine","cuisine/french-cuisine"],["New Caledonian cuisine","cuisine/new-caledonian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Pardon Your French","ref":"site/pardonyourfrench-com","color":"#55b8ad","shape":"site","sub":"pardonyourfrench.com","note":"Audrey Le Goff, a French cook, shares classic and regional French home recipes.","url":"https://pardonyourfrench.com","suggested":true},{"name":"La Cuisine de Géraldine","ref":"site/lacuisinedegeraldine-fr","color":"#55b8ad","shape":"site","sub":"lacuisinedegeraldine.fr","note":"French home cooking blog by Géraldine Leverd, also author of The New French Kitchen.","url":"https://lacuisinedegeraldine.fr/en/about-us","suggested":true},{"name":"New Caledonia Tourism: Kanak cooking","ref":"site/newcaledonia-travel","color":"#55b8ad","shape":"site","sub":"newcaledonia.travel","note":"Official tourism board overview of Kanak food, including bougna cooked in an earth oven.","url":"https://www.newcaledonia.travel/nz/gastronomy-wine/gastronomy/kanak-cook