{"cuisine/surinamese-cuisine":{"t":"cuisine","r":"cuisine/surinamese-cuisine","n":"Surinamese cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Cuisine"]],"sub":"National cuisine of Suriname","intro":[["Surinamese culture has strong Asian, African and European influences. The population is mainly composed of the contribution of people from India, Africa, China, Europe, and Indonesia, as well as indigenous peoples who lived in the area, before the arrival of European settlers."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"surinamese-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Surinamese_cuisine"}],"sections":[{"h":"Recipe sites","count":2,"rows":[{"name":"By Andrea Janssen","ref":"site/byandreajanssen-com","color":"#55b8ad","shape":"site","sub":"byandreajanssen.com","note":"Surinamese recipes section on a Dutch food blogger's site.","url":"https://www.byandreajanssen.com/dutch-recipes/surinamese-recipes/","suggested":true},{"name":"Multiculticooking: Suriname","ref":"site/multiculticooking-com","color":"#55b8ad","shape":"site","sub":"multiculticooking.com","note":"Netherlands-based blog with many Surinamese, including Surinamese-Javanese, recipes.","url":"https://multiculticooking.com/category/cuisines/americas/suriname/page/4/","suggested":true}]},{"h":"Cookbooks","count":1,"rows":[{"name":"The Taste of Suriname","ref":"cookbook/the-taste-of-suriname","color":"#f0b340","shape":"book","sub":"Diana Dubois","note":"Dutch-published cookbook of Surinamese home cooking.","url":"https://openlibrary.org/isbn/9789075812084","suggested":true}]}],"cont":"Cuisine of the Americas"},"cuisine/cuisine-of-dominica":{"t":"cuisine","r":"cuisine/cuisine-of-dominica","n":"Dominica cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Cuisine"]],"sub":"National cuisine of Dominica","intro":[["Dominica cuisine is the cuisine of the island nation of Dominica.  The cuisine is rooted in Caribbean creole techniques with local produce flavored by spices found on the island. Dominica's cuisine is a mixture of indigenous Kalinago, African, French, and English influences."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"cuisine-of-dominica"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cuisine_of_Dominica"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"More from Dominica","count":1,"links":[["Dominican Republic cuisine","cuisine/dominican-republic-cuisine"]]}],"cont":"Cuisine of the Americas"},"cuisine/betawi-cuisine":{"t":"cuisine","r":"cuisine/betawi-cuisine","n":"Betawi cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Javanese cuisine","cuisine/javanese-cuisine"]],"sub":"Regional cuisine in Indonesia","intro":[["Betawi cuisine draws from a range of culinary traditions. This comes from the Betawi people being composed of regional immigrants from areas in the Indonesian archipelago, as well as Chinese, Indian, Arab, and European traders, visitors and immigrants that were attracted to the port city of Batavia (today modern Jakarta)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"betawi-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Betawi_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Javanese cuisine","cuisine/javanese-cuisine"]]},{"h":"Dishes","count":1,"links":[["Bir pletok","dish/bir-pletok"]]},{"h":"Key ingredients","links":[["Biancaea sappan","ingredient/biancaea-sappan"],["Cardamom","ingredient/cardamom"],["Cinnamon","ingredient/cinnamon"],["Ginger","ingredient/ginger"],["Illicium verum","ingredient/illicium-verum"],["Lemongrass","ingredient/lemongrass"],["Nigella sativa","ingredient/nigella-sativa"],["Pandan","ingredient/pandan"],["Piper retrofractum","ingredient/piper-retrofractum"],["Sugar","ingredient/sugar"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["Javanese cuisine","cuisine/javanese-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisine