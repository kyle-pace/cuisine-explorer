kipedia","actions":[{"kind":"globe","hash":"ingredient-tapioca-flour"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tapioca_flour"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Kemplang","dish/kemplang"]]]]},{"h":"Often cooked with","links":[["Spanish mackerel","ingredient/spanish-mackerel"],["Wahoo","ingredient/wahoo"]]}]},"dish/mortadella-di-campotosto":{"t":"dish","r":"dish/mortadella-di-campotosto","n":"Mortadella di Campotosto","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Abruzzese and Molisan cuisine","dot":"#cf5f87","intro":[["Mortadella di Campotosto (popularly called coglioni di mulo) is a salami produced in limited quantities in the territory of the comune (municipality) of Campotosto, in the province of L'Aquila, Abruzzo. It is listed as a prodotto agroalimentare tradizionale (PAT) by the Italian Ministry of Agricultural, Food and Forestry Policies."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-mortadella-di-campotosto"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mortadella_di_Campotosto"}],"sections":[{"h":"Where it's from","links":[["Abruzzese and Molisan cuisine","cuisine/cuisine-of-abruzzo"]]},{"h":"Cook it","rows":[{"name":"Great Italian Chefs: Abruzzese recipes","ref":"site/greatitalianchefs-com","color":"#55b8ad","shape":"site","sub":"greatitalianchefs.com","note":"Collection of dishes from Abruzzo by Italian chefs on an established recipe site.","url":"https://www.greatitalianchefs.com/collections/abruzzese-recipes","suggested":true,"kind":"site"},{"name":"The Pasta Project: Abruzzo","ref":"site/the-pasta-project-com","color":"#55b8ad","shape":"site","sub":"the-pasta-project.com","note":"Italy-based pasta blog's section on regional pasta dishes from Abruzzo.","url":"https://www.the-pasta-project.com/abruzzo/","suggested":true,"kind":"blog"}]},{"h":"More from Abruzzese and Molisan cuisine","links":[["Arrosticini","dish/arrosticini"],["Aurum (liqueur)","dish/aurum-liqueur"],["Brodetto alla vastese","dish/brodetto-alla-vastese"],["Centerbe","dish/centerbe"],["Confetti di Sulmona","dish/confetti-di-sulmona"],["Fiadone","dish/fiadone"],["Pecora alla callara","dish/pecora-alla-callara"],["Torrone Nurzia","dish/torrone-nurzia"],["Vino cotto","dish/vino-cotto"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/25/Tre_piccoli_coglioni_di_mulo.jpg/500px-Tre_piccoli_coglioni_di_mulo.jpg","w":500,"h":375,"by":"Florixc","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Tre_piccoli_coglioni_di_mulo.jpg"}},"dish/oysters-kirkpatrick":{"t":"dish","r":"dish/oysters-kirkpatrick","n":"Oysters Kirkpatrick","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#94bd5c","intro":[["Oysters Kirkpatrick, also called oysters Kilpatrick, or Kirkpatrick and oysters, or oysters Philpatrick, is a dish of oysters topped with cooked bacon, seasoned with Worcestershire sauce, ketchup, or other flavorings, then broiled."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-oysters-kirkpatrick"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Oysters_Kirkpatrick"}],"sections":[{"h":"Where it's from","links":[["Cuisine of California","cuisine/cuisine-of-california"],["Cali-Mex cuisine","cuisine/cuisine-of-california-latino-and-hispanic-influence"]]},{"h":"Ingredients","count":5,"links":[["Bacon","ingredient/bacon"],["Cheese","ingredient/cheese"],["Chili pepper","ingredient/chili-pepper"],["Oyster","ingredient/oyster"],["Scallion","ingredient/scallion"]]},{"h":"More from Cuisine of California","links":[["Celery Victor","dish/celery-victor"],["Green goddess dressing","dish/green-goddess-dressing"],["Hangtown fry","dish/hangtown-fry"]]}]},"ingredient/grape-leaves":{"t":"ingredient","r":"ingredient/grape-leaves","n":"Grape leaves","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 6 cuisines","intro":[["Grape leaves, the leaves of the grapevine plant, are used in the cuisines of a number of cultures. They may be obtained fresh, or preserved in jars or cans. The leaves are commonly rolled or stuffed with mixtures of meat and rice to produce dolma (often, sarma), found widely in the Mediterranean, Caucasus, Balkans, and Middle East. They may also be used in various other recipes and dishes.  When cut into smaller pieces they are used as a savory addition to soups that include greens and cabbage."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-grape-leaves"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Grape_leaves"}],"sections":[{"h":"Where it's cooked with","count":6,"groups":[["Cretan cuisine","cuisine/cretan-cuisine",[["Stuffed leaves","dish/stuffed-leaves"]]],["Crimean Tatar cuisine","cuisine/crimean-tatar-cuisine",[["Stuffed leaves","dish/stuffed-leaves"]]],["Moldovan cuisine","cuisine/moldovan-cuisine",[["Sarmale","dish/sarmale"]]],["Romanian cuisine","cuisine/romanian-cuisine",[["Sarmale","dish/sarmale"]]],["Serbian cuisine","cuisine/serbian-cuisine",[["Stuffed leaves","dish/stuffed-leaves"]]],["Turkish cuisine","cuisine/turkish-cuisine",[["Stuffed leaves","dish/stuffed-leaves"]]]]},{"h":"Often cooked with","links":[["Cabbage","ingredient/cabbage"],["Ground meat","ingredient/ground-meat"],["Rice","ingredient/rice"],["Chili pepper","ingredient/chili-pepper"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/58/Merchant_selling_grape_leaves%2C_Al-Hamidiyah_Souq%2C_Damascus%2C_Syria.jpg/500px-Merchant_selling_grape_leaves%2C_Al-Hamidiyah_Souq%2C_Damascus%2C_Syria.jpg","w":500,"h":754,"by":"James Gordon from Los Angeles, California, USA","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Merchant_selling_grape_leaves%2C_Al-Hamidiyah_Souq%2C_Damascus%2C_Syria.jpg"}},"ingredient/wheat-bread":{"t":"ingredient","r":"ingredient/wheat-bread","n":"Wheat bread","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Brown bread, in contrast to  white bread, is bread made with significant amounts of whole grain flours, usually wheat sometimes with corn and or rye flours. In some countries brown breads often get their characteristic dark color from ingredients such as molasses or coffee. In Canada, the UK, Ireland and South Africa, it is a blend of white flour and whole wheat flour. Wholemeal bread within the UK must be made solely from whole wheat flour. In New England and the Maritimes, brown bread is bread sweetened with molasses."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-wheat-bread"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Wheat_bread"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Finnish cuisine","cuisine/finnish-cuisine",[["Semla","dish/semla"]]],["Swedish cuisine","cuisine/swedish-cuisine",[["Semla","dish/semla"]]]]},{"h":"Often cooked with","links":[["Almond paste","ingredient/almond-paste"],["Jam","ingredient/jam"],["Whipped cream","ingredient/whipped-cream"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/8b/Kommissbrot.jpg/500px-Kommissbrot.jpg","w":500,"h":507,"by":"Rainer Zenz","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Kommissbrot.jpg"}},"dish/steak-and-eggs":{"t":"dish","r":"dish/steak-and-eggs","n":"Steak and eggs","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Australian cuisine","dot":"#55b8ad","intro":[["Steak and eggs is a dish of beefsteak and fried eggs. It is most typically served as a breakfast or brunch food."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-steak-and-eggs"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Steak_and_eggs"}],"sections":[{"h":"Where it's from","links":[["Australian cuisine","cuisine/australian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Beefst