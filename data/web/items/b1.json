4/Buchteln.jpg/500px-Buchteln.jpg","w":500,"h":411,"by":"Gerhard Juengling","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Buchteln.jpg"}},"dish/forshmak":{"t":"dish","r":"dish/forshmak","n":"Forshmak","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#cf5f87","intro":[["Forshmak, or vorschmack, from German Vorgeschmack (\"foretaste\") or Vorspeise (\"appetizer\"), also known as chopped herring, is a traditional dish of Ashkenazi Jewish cuisine, particularly associated with the Jewish communities of Eastern Europe, including Poland, Lithuania, Ukraine, and Russia. It is a savory appetizer made primarily from chopped salted herring, hard-boiled eggs, onions, apples or potatoes, and bread or soaked matzah, often seasoned with vinegar or oil. The dish is typically served cold, often spread on rye bread or crackers."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-forshmak"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Forshmak"}],"sections":[{"h":"Where it's from","links":[["Brandenburg cuisine","cuisine/brandenburg-cuisine"],["Jewish cuisine","cuisine/jewish-cuisine"],["Russian cuisine","cuisine/russian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Ground meat","ingredient/ground-meat"],["Herring","ingredient/herring"]]},{"h":"Cook it","rows":[{"name":"Tori Avey: Jewish Recipes","ref":"site/toriavey-com","color":"#55b8ad","shape":"site","sub":"toriavey.com","note":"Tori Avey's Jewish recipe index, often paired with notes on each dish's history.","url":"https://toriavey.com/jewish-recipes/","suggested":true,"kind":"blog"},{"name":"The Nosher (My Jewish Learning)","ref":"site/myjewishlearning-com","color":"#55b8ad","shape":"site","sub":"myjewishlearning.com","note":"Recipe section of the nonprofit My Jewish Learning, covering Ashkenazi, Sephardi and Mizrahi home cooking and holiday food.","url":"https://www.myjewishlearning.com/recipes/","suggested":true,"kind":"site"},{"name":"Olga's Flavor Factory","ref":"site/olgasflavorfactory-com","color":"#55b8ad","shape":"site","sub":"olgasflavorfactory.com","note":"Russian-born home cook Olga's blog, with a dedicated Russian recipes category.","url":"https://www.olgasflavorfactory.com/category/russianrecipes/","suggested":true,"kind":"blog"}]}],"img":{"src":"/labs/cuisines/img/thumb/1/1d/Forshmak.jpg/500px-Forshmak.jpg","w":500,"h":375,"by":"Анютка ; reprocessed by Off-shell (removed watermarks, color processing)","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Forshmak.jpg"}},"dish/kamaboko":{"t":"dish","r":"dish/kamaboko","n":"Kamaboko","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Kamaboko is a type of cured surimi, a processed seafood product common in Japanese cuisine. It was initially made in the year 1115."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kamaboko"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kamaboko"}],"sections":[{"h":"Where it's from","links":[["Japanese cuisine","cuisine/japanese-cuisine"]]},{"h":"Cook it","rows":[{"name":"Just One Cookbook","ref":"site/justonecookbook-com","color":"#55b8ad","shape":"site","sub":"justonecookbook.com","note":"Namiko Chen's long-running blog and videos on Japanese home cooking.","url":"https://justonecookbook.com","suggested":true,"kind":"blog"},{"name":"RecipeTin Japan","ref":"site/japan-recipetineats-com","color":"#55b8ad","shape":"site","sub":"japan.recipetineats.com","note":"Japanese home recipes from Yumiko, a Japan-born cook, sister site to RecipeTin Eats.","url":"https://japan.recipetineats.com/","suggested":true,"kind":"blog"}]},{"h":"More from Japanese cuisine","links":[["Bergh–Stoutenburgh House","dish/bergh-stoutenburgh-house"],["Chikuwa","dish/chikuwa"],["Curry bread","dish/curry-bread"],["Donburi","dish/donburi"],["Fukamushicha","d