{"cuisine/cuisine-of-pittsburgh":{"t":"cuisine","r":"cuisine/cuisine-of-pittsburgh","n":"Cuisine of Pittsburgh","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Cuisine of the Mid-Atlantic United States","cuisine/cuisine-of-the-mid-atlantic-united-states"]],"sub":"Regional cuisine in United States of America","intro":[["The culture of Pittsburgh stems from the city's long history as a center for cultural philanthropy, as well as its rich ethnic traditions.  In the 19th and 20th centuries, wealthy businessmen such as Andrew Carnegie, Henry J. Heinz, Henry Clay Frick, and nonprofit organizations such as the Carnegie Foundation donated millions of dollars to create educational and cultural institutions."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"cuisine-of-pittsburgh"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cuisine_of_Pittsburgh"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Cuisine of the Mid-Atlantic United States","cuisine/cuisine-of-the-mid-atlantic-united-states"]]},{"h":"Part of","links":[["Cuisine of the Mid-Atlantic United States","cuisine/cuisine-of-the-mid-atlantic-united-states"]]}],"cont":"Cuisine of the Americas"},"cuisine/haitian-cuisine":{"t":"cuisine","r":"cuisine/haitian-cuisine","n":"Haitian cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Cuisine"]],"sub":"National cuisine of Haiti","intro":[["Haitian cuisine is a Creole cuisine that originates from a blend of several culinary styles that populated the western portion of the island of Hispaniola, namely African, French, Indigenous, Spanish, and Levantine influences. Haitian cuisine has some similarities with  \"criollo\" (Spanish for 'creole') cooking and similar to other Caribbean cuisine, but differs in several ways from its regional counterparts. Flavors are bold and spicy, demonstrating African and French influences, with notable derivatives coming from Indigenous and Spanish techniques."],["Levantine influences have made their way into the mainstream culture, due to an Arab migration over the years forming a community of shared Arab descent. Years of adaptation have led to these cuisines to merge into Haitian cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"haitian-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Haitian_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"Cookbooks","count":1,"rows":[{"name":"A Taste of Haiti","ref":"cookbook/a-taste-of-haiti","color":"#f0b340","shape":"book","sub":"Mirta Yurnet-Thomas","note":"Haitian home recipes with background on the country's food culture.","url":"https://www.hippocrenebooks.com/store/p463/A_Taste_of_Haiti.html","suggested":true}]},{"h":"Dishes","count":3,"links":[["Haitian patty","dish/haitian-patty"],["Le Soleil (restaurant)","dish/le-soleil-restaurant"],["Soup joumou","dish/soup-joumou"]]},{"h":"Key ingredients","links":[["Puff pastry","ingredient/puff-pastry"],["Beef","ingredient/beef"],["Calabaza","ingredient/calabaza"],["Potato","ingredient/potato"]],"note":"Most used across its dishes."}],"cont":"Cuisine of the Americas"},"cuisine/northern-irish-cuisine":{"t":"cuisine","r":"cuisine/northern-irish-cuisine","n":"Northern Irish cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["British cuisine","cuisine/british-cuisine"]],"sub":"Regional cuisine in United Kingdom","intro":[["Northern Irish cuisine encompasses the cooking styles, traditions and recipes associated with Northern Ireland. It has distinctive attributes of its own, but has also drawn heavily from Irish and British cuisines."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"northern-irish-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Northern_Irish_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["British cuisine","cuisine/british-cuisine"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"Paula McIntyre's Down to Earth Cookbook","ref":"cookbook/paula-mcintyre-s-down-to-earth-cookbook","color":"#f0b340","shape":"book","sub":"Paula McIntyre","note":"Recipes built on Northern Irish produce by a Northern Irish chef and broadcaster.","url":"https://openlibrary.org/isbn/9781780730967","suggested":true}]},{"h":"Part of","links":[["British cuisine","cuisine/british-cuisine"]]}],"cont":"European cuisine","img":{"src":"/labs/cuisines/img/f/f7/St_George%27s_Market%2C_Belfast_%2810%29_-_geograph.org.uk_-_735666.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","w":500,"h":667,"by":"Ross","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:St_George's_Market%2C_Belfast_(10)_-_geograph.org.uk_-_735666.jpg"}},"dish/adare-manor":{"t":"dish","r":"dish/adare-manor","n":"Adare Manor","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Irish cuisine","dot":"#cf5f87","intro":[["Adare Manor is a manor house located on the banks of the River Maigue in the village of Adare, County Limerick, Ireland, the former seat of the Earl of Dunraven and Mount-Earl. The present house was built in the early 19th century, though retaining some of the walls of the 17th-century structure. It is now one of Europe’s great sporting and country estates. A luxury Forbes 5 Star hotel, the property boasts Three MICHELIN Keys, a MICHELIN-starred restaurant, and will be the host of the centenery 2027 Ryder Cup in September 2027."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-adare-manor"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Adare_Manor"}],"sections":[{"h":"Where it's from","links":[["Irish cuisine","cuisine/irish-cuisine"]]},{"h":"Cook it","rows":[{"name":"Irish American Mom","ref":"site/irishamericanmom-com","color":"#55b8ad","shape":"site","sub":"irishamericanmom.com","note":"Irish-born cook living in the US sharing traditional Irish recipes.","url":"https://www.irishamericanmom.com/recipes/","suggested":true}]},{"h":"More from Irish cuisine","links":[["Aimsir","dish/aimsir"],["Bacon and cabbage","dish/bacon-and-cabbage"],["Black pudding","dish/black-pudding"],["Croffle","dish/croffle"],["Crumble","dish/crumble"],["Eipic (restaurant)","dish/eipic-restaurant"],["Fish and chips","dish/fish-and-chips"],["L'Ecrivain","dish/l-ecrivain"],["Leo's Tavern","dish/leo-s-tavern"],["Loam (restaurant)","dish/loam-restaurant"],["Mews (restaurant)","dish/mews-restaurant"],["Ox (Belfast restaurant)","dish/ox-belfast-restaurant"],["Potato salad","dish/potato-salad"],["Restaurant Chestnut","dish/restaurant-chestnut"],["Sausage roll","dish/sausage-roll"],["The Muddlers Club","dish/the-muddlers-club"],["Timoleague Brown Pudding","dish/timoleague-brown-pudding"]]}]},"dish/bagharj":{"t":"dish","r":"dish/bagharj","n":"Bagharj","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Armenian cuisine","dot":"#f0b340","intro":[["Bagharj is a traditional Armenian bread with both ritual and everyday uses. Depending on the recipe, it can be either salty, unsalted, or sweet. In Armenian folk culture, bagharj is attributed with symbolic and magical meanings."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-bagharj"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bagharj"}],"sections":[{"h":"Where it's from","links":[["Armenian cuisine","cuisine/armenian-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Butter","ingredient/butter"],["Egg","ingredient/egg"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"],["Yeast","ingredient/yeast"]]},{"h":"Cook it","rows":[{"name":"The Armenian Kitchen","ref":"site/thearmeniankitchen-com","color":"#55b8ad","shape":"site","sub":"thearmeniankitchen.com","note":"Armenian-American blog of family recipes and reviews of Armenian cookbooks.","url":"https://www.thearmeniankitchen.com/classic-armenian-recipes-another/","suggested":true}]},{"h":"More from Armenian cuisine","links":[["Alani (dried fruit)","dish/alani-dried-fruit"],["Baba ghanoush","dish/baba-ghanoush"],["Cabbage roll","dish/cabbage-roll"],["İmam bayıldı","dish/imam-bay-ld"],["Khash (dish)","dish/khash-dish"],["Khorovats","dish/khorovats"],["Lavash","dish/lavash"],["Matnakash","dish/matnakash"],["Mikado cake","dish/mikado-cake"],["Pilaf","dish/pilaf"],["Pirozhki","dish/pirozhki"],["Spas (soup)","dish/spas-soup"],["Tjvjik (food)","dish/tjvjik-food"]]}]},"ingredient/cream-cheese":{"t":"ingredient","r":"ingredient/cream-cheese","n":"Cream cheese","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 7 dishes across 8 cuisines","intro":[["Cream cheese is a soft, usually mild-tasting fresh cheese made from milk and cream.  Cream cheese is not naturally matured and is meant to be consumed fresh, so it differs from other soft cheeses, such as Brie and Neufchâtel. It is more comparable in taste, texture, and production methods to Boursin and mascarpone. Stabilizers, such as carob bean gum and carrageenan, are often added in industrial production. It can also come in several flavors."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-cream-cheese"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cream_cheese"}],"sections":[{"h":"Where it's cooked with","count":8,"groups":[["American cuisine","cuisine/american-cuisine",[["Clam dip","dish/clam-dip"],["Strawberry delight","dish/strawberry-delight"]]],["Basque cuisine","cuisine/basque-cuisine",[["Basque cheesecake","dish/basque-cheesecake"]]],["Japanese cuisine","cuisine/japanese-cuisine",[["Japanese cheesecake","dish/japanese-cheesecake"]]],["Mexican cuisine","cuisine/mexican-cuisine",[["Chile con queso","dish/chile-con-queso"]]],["Minnesotan cuisine","cuisine/minnesotan-cuisine",[["Minnesota sushi","dish/minnesota-sushi"]]],["Pacific Northwest cuisine","cuisine/pacific-northwest-cuisine",[["Seattle-style hot dog","dish/seattle-style-hot-dog"]]],["Tex-Mex cuisine","cuisine/tex-mex-cuisine",[["Chile con queso","dish/chile-con-queso"]]],["Western American cuisine","cuisine/cuisine-of-the-western-united-states",[["Seattle-style hot dog","dish/seattle-style-hot-dog"]]]]},{"h":"Often cooked with","links":[["Cream","ingredient/cream"],["Egg","ingredient/egg"],["Sugar","ingredient/sugar"],["Cheese","ingredient/cheese"],["Butter","ingredient/butter"],["Wheat flour","ingredient/wheat-flour"],["Chili pepper","ingredient/chili-pepper"],["Monterey Jack","ingredient/monterey-jack"],["Processed cheese","ingredient/processed-cheese"],["Velveeta","ingredient/velveeta"],["Clam","ingredient/clam"],["Sour cream","ingredient/sour-cream"],["Ham","ingredient/ham"],["Pickled cucumber","ingredient/pickled-cucumber"],["Bialy","ingredient/bialy"],["Bialy (bread)","ingredient/bialy-bread"]]}]},"ingredient/long-beans":{"t":"ingredient","r":"ingredient/long-beans","n":"Long beans","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The asparagus bean (Vigna unguiculata subsp. sesquipedalis) is a legume cultivated for its edible green pods containing immature seeds, like the green bean. It is also known as yardlong bean, pea bean, long-podded cowpea, Chinese long bean, snake bean, bodi, bora, and kosbanti (kousenband). Despite the common name of \"yardlong\", the pods are actually only about half a yard long, so the subspecies name sesquipedalis (one-and-a-half-foot-long; 1.5 feet (0.50 yd)) is a more accurate approximation."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-long-beans"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Long_beans"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Bubur pedas","dish/bubur-pedas"]]]]},{"h":"Often cooked with","links":[["Anchovy","ingredient/anchovy"],["Bamboo shoot","ingredient/bamboo-shoot"],["Bean curd","ingredient/bean-curd"],["Bumbu (seasoning)","ingredient/bumbu-seasoning"],["Caraway seed","ingredient/caraway-seed"],["Carrots","ingredient/carrots"],["Chili pepper","ingredient/chili-pepper"],["Coconut","ingredient/coconut"],["Dried shrimp","ingredient/dried-shrimp"],["Galangal","ingredient/galangal"],["Garlic","ingredient/garlic"],["Ginger","ingredient/ginger"],["Leafy greens","ingredient/leafy-greens"],["Lemongrass","ingredient/lemongrass"],["Onions","ingredient/onions"],["Potato","ingredient/potato"]]}]},"dish/jinju-bibimbap":{"t":"dish","r":"dish/jinju-bibimbap","n":"Jinju bibimbap","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from South Korean cuisine","dot":"#f0b340","intro":[["Bibimbap, sometimes romanised as bi bim bap or bi bim bop, is a Korean rice dish. It is served as a bowl of warm white rice topped with namul (sautéed or blanched seasoned vegetables) and gochujang (chili pepper paste). Egg and sliced meat (usually beef) are common additions, stirred together thoroughly just before eating. The term bibim means \"mixing\" and bap is cooked rice."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-jinju-bibimbap"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Jinju_bibimbap"}],"sections":[{"h":"Where it's from","links":[["South Korean cuisine","cuisine/south-korean-cuisine"]]},{"h":"Cook it","rows":[{"name":"Korean Bapsang","ref":"site/koreanbapsang-com","color":"#55b8ad","shape":"site","sub":"koreanbapsang.com","note":"Home-style Korean recipes from Hyosun, a Korean-American mom.","url":"https://www.koreanbapsang.com/category/recipes/","suggested":true}]},{"h":"More from South Korean cuisine","links":[["Chalbori-ppang","dish/chalbori-ppang"],["Chimaek","dish/chimaek"],["Croffle","dish/croffle"],["Dak-galbi","dish/dak-galbi"],["Gilgeori toast","dish/gilgeori-toast"],["Hodu-gwaja","dish/hodu-gwaja"],["Hwangnam-ppang","dish/hwangnam-ppang"],["Jjolmyeon","dish/jjolmyeon"],["Kkulppang","dish/kkulppang"],["Milmyeon","dish/milmyeon"],["Rabokki","dish/rabokki"],["So-tteok-so-tteok","dish/so-tteok-so-tteok"],["Tornado potato","dish/tornado-potato"],["Ttongppang","dish/ttongppang"],["Yangnyeom chicken","dish/yangnyeom-chicken"]]}]},"ingredient/falukorv":{"t":"ingredient","r":"ingredient/falukorv","n":"Falukorv","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Falukorv, or Falu sausage in English, is a type of sausage (korv in Swedish) that originates from Falun, Sweden. It is made from a mixture of smoked pork and beef or veal, blended with potato starch flour, onion, salt, and mild spices. Falukorv is pre-cooked, which means it can be eaten cold without any further preparation."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-falukorv"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Falukorv"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Swedish cuisine","cuisine/swedish-cuisine",[["Korv stroganoff","dish/korv-stroganoff"]]]]}]},"ingredient/fried-egg":{"t":"ingredient","r":"ingredient/fried-egg","n":"Fried egg","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["A fried egg is a dish made from one or more eggs which are removed from their shells, placed into a frying pan and cooked. They are traditionally eaten for breakfast or brunch in many countries but may also be served at other times of the day."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-fried-egg"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fried_egg"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Cambodian Chinese cuisine","cuisine/cambodian-chinese-cuisine",[["Lort cha","dish/lort-cha"]]],["Dutch cuisine","cuisine/dutch-cuisine",[["Uitsmijter","dish/uitsmijter"]]]]},{"h":"Often cooked with","links":[["Bean sprouts","ingredient/bean-sprouts"],["Chives","ingredient/chives"],["Dark soy sauce","ingredient/dark-soy-sauce"],["Fish sauce","ingredient/fish-sauce"],["Garlic","ingredient/garlic"],["Palm sugar","ingredient/palm-sugar"],["Scallions","ingredi