rumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 3 cuisines","intro":[["Lobsters are malacostracan decapod crustaceans of the family Nephropidae or its synonym Homaridae. They have long bodies with muscular tails and live in crevices or burrows on the sea floor. Three of their five pairs of legs have claws, including the first pair, which are usually much larger than the others. Highly prized as seafood, lobsters are economically important and are often one of the most profitable commodities in the coastal areas they populate."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-lobster-meat"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lobster_meat"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["French cuisine","cuisine/french-cuisine",[["Bisque (food)","dish/bisque-food"],["Lobster Thermidor","dish/lobster-thermidor"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Bisque (food)","dish/bisque-food"],["Lobster Thermidor","dish/lobster-thermidor"]]],["American cuisine","cuisine/american-cuisine",[["Lobster Thermidor","dish/lobster-thermidor"]]]]},{"h":"Often cooked with","links":[["Crab meat","ingredient/crab-meat"],["Crayfish as food","ingredient/crayfish-as-food"],["Crustacean","ingredient/crustacean"],["Langoustine","ingredient/langoustine"],["Rice","ingredient/rice"],["Shrimp","ingredient/shrimp"],["White wine","ingredient/white-wine"],["Brandy","ingredient/brandy"],["Egg","ingredient/egg"],["Egg yolk","ingredient/egg-yolk"],["Mustard (condiment)","ingredient/mustard-condiment"],["Sherry","ingredient/sherry"]]}]},"dish/chikuwa":{"t":"dish","r":"dish/chikuwa","n":"Chikuwa","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Chikuwa is a Japanese fishcake product made from fish surimi. After being mixed well, they are wrapped around a bamboo or metal stick and steamed or broiled. The word chikuwa (\"bamboo ring\") comes from the 