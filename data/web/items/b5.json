oks","count":2,"rows":[{"name":"Coconut & Sambal: Recipes from My Indonesian Kitchen","color":"#f0b340","shape":"book","sub":"Lara Lee, 2020","note":"Indonesian home cooking by an Australian-Indonesian chef, published by Bloomsbury.","url":"https://openlibrary.org/isbn/9781526603517","suggested":true,"isbn":"9781526603517"},{"name":"Sri Owen's Indonesian Food","color":"#f0b340","shape":"book","sub":"Sri Owen","note":"Broad survey of Indonesian regional cooking by a longtime authority on the cuisine.","url":"https://openlibrary.org/isbn/9781623717186","suggested":true,"isbn":"9781623717186"}]},{"h":"Key ingredients","links":[["Sugar","ingredient/sugar"],["Coconut milk","ingredient/coconut-milk"],["Ginger","ingredient/ginger"],["Lemongrass","ingredient/lemongrass"],["Chili pepper","ingredient/chili-pepper"],["Galangal","ingredient/galangal"],["Rice","ingredient/rice"],["Egg","ingredient/egg"],["Coconut","ingredient/coconut"],["Palm sugar","ingredient/palm-sugar"],["Wheat flour","ingredient/wheat-flour"],["Candlenut","ingredient/candlenut"],["Chicken","ingredient/chicken"],["Beef","ingredient/beef"],["Turmeric","ingredient/turmeric"],["Rice flour","ingredient/rice-flour"],["Shallot","ingredient/shallot"],["Scallion","ingredient/scallion"],["Garlic","ingredient/garlic"],["Black pepper","ingredient/black-pepper"],["Banana leaf","ingredient/banana-leaf"],["Pandan","ingredient/pandan"],["Lime","ingredient/lime"],["Mung bean sprout","ingredient/mung-bean-sprout"]],"note":"Most used across its dishes."},{"h":"Within Indonesian cooking","count":13,"links":[["Acehnese cuisine","cuisine/acehnese-cuisine"],["Balinese cuisine","cuisine/balinese-cuisine"],["Banjar cuisine","cuisine/banjar-cuisine"],["Batak cuisine","cuisine/batak-cuisine"],["Indo cuisine","cuisine/indo-cuisine"],["Indonesian Arab cuisine","cuisine/indonesian-arab-cuisine"],["Indonesian Chinese cuisine","cuisine/indonesian-chinese-cuisine"],["Indonesian Indian cuisine","cuisine/indonesian-indian-cuisine"],["Javanese cuisine","cuisine/javanese-cuisine"],["Makassar cuisine","cuisine/makassar-cuisine"],["Malay cuisine","cuisine/malay-cuisine"],["Manado cuisine","cuisine/manado-cuisine"],["Padang food","cuisine/padang-food"]]},{"h":"More from Indonesia","count":5,"links":[["Betawi cuisine","cuisine/betawi-cuisine"],["Indonesian Chinese cuisine","cuisine/chinese-indonesian-cuisine"],["Madurese cuisine","cuisine/madurese-cuisine"],["Palembang cuisine","cuisine/palembang-cuisine"],["Sundanese cuisine","cuisine/sundanese-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/world-cuisine/img/thumb/8/8b/2016_0421_Gado_gado_NL.jpg/500px-2016_0421_Gado_gado_NL.jpg","w":500,"h":643,"by":"Takeaway","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:2016_0421_Gado_gado_NL.jpg"}},"ingredient/caraway-seed":{"t":"ingredient","r":"ingredient/caraway-seed","n":"Caraway seed","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 8 dishes across 8 cuisines","intro":[["Caraway (Carum carvi), also known as meridian fennel, is a biennial plant in the family Apiaceae, native to western Asia, Europe, and North Africa."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-caraway-seed"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Caraway_seed"}],"sections":[{"h":"Where it's cooked with","count":8,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Bubur pedas","dish/bubur-pedas"],["Mie aceh","dish/mie-aceh"],["Nasi gandul","dish/nasi-gandul"],["Otak-otak","dish/otak-otak"],["Sate bandeng","dish/sate-bandeng"],["Sate klatak","dish/sate-klatak"]]],["Acehnese cuisine","cuisine/acehnese-cuisine",[["Mie aceh","dish/mie-aceh"]]],["Arab cuisine","cuisine/arab-cuisine",[["Meghli","dish/meghli"]]],["Javanese cuisine","cuisine/javanese-cuisine",[["Nasi gandul","dish/nasi-gandul"]]],["Latvian cuisine","cuisine/latvian-cuisine",[["Sklandrausis","dish/sklandrausis"]]],["Lebanese cuisine","cuisine/lebanese-cuisine",[["Meghli","dish/meghli"]]],["Levantine cuisine","cuisine/levantine-cuisine",[["Meghli","dish/meghli"]]],["Palestinian cuisine","cuisine/palestinian-cuisine",[["Meghli","dish/meghli"]]]]},{"h":"Often cooked with","links":[["Chili pepper","ingredient/chili-pepper"],["Ginger","ingredient/ginger"],["Galangal","ingredient/galangal"],["Coconut milk","ingredient/coconut-milk"],["Coconut","ingredient/coconut"],["Lemongrass","ingredient/lemongrass"],["Turmeric","ingredient/turmeric"],["Sweet soy sauce","ingredient/sweet-soy-sauce"],["Candlenut","ingredient/candlenut"],["Tamarind","ingredient/tamarind"],["Potato","ingredient/potato"],["Rice","ingredient/rice"],["Caraway","ingredient/caraway"],["Cinnamon","ingredient/cinnamon"],["Beef","ingredient/beef"],["Black pepper","ingredient/black-pepper"]]}],"img":{"src":"/world-cuisine/img/4/42/Carum_carvi_-_K%C3%B6hler%E2%80%93s_Medizinal-Pflanzen-172.jpg","w":500,"h":596,"by":"Franz Eugen Köhler, Köhler's Medizinal-Pflanzen","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Carum_carvi_-_K%C3%B6hler%E2%80%93s_Medizinal-Pflanzen-172.jpg"}},"ingredient/feta-cheese":{"t":"ingredient","r":"ingredient/feta-cheese","n":"Feta cheese","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Feta is a Greek white brined cheese made from sheep's milk or from a mixture of sheep and goat's milk. It is soft, with small or no holes, and no skin. Crumbly with a slightly grainy texture, it is formed into large blocks and aged in brine. Its flavour is tangy and salty, ranging from mild to sharp. Feta is used in salads, such as Greek salad, and in pastries, notably the filo-based Greek dishes spanakopita 'spinach pie', and tyropita 'cheese pie'. It is often served with olive oil or olives, and sprinkled with aromatic herbs such as oregano. It can also be served cooked (often grilled), as part of a sandwich, in omelettes, and many other dishes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-feta-cheese"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Feta_cheese"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Sephardic Jewish cuisine","cuisine/sephardic-jewish-cuisine",[["Bulemas","dish/bulemas"]]]]},{"h":"Often cooked with","links":[["Kashkaval","ingredient/kashkaval"]]}],"img":{"src":"/world-cuisine/img/thumb/2/28/Feta_Cheese.jpg/500px-Feta_Cheese.jpg","w":500,"h":400,"by":"JJ Harrison (https://www.jjharrison.com.au/)","lic":"CC BY-SA 2.5","licUrl":"https://creativecommons.org/licenses/by-sa/2.5","page":"https://commons.wikimedia.org/wiki/File:Feta_Cheese.jpg"}},"ingredient/fortified-wine":{"t":"ingredient","r":"ingredient/fortified-wine","n":"Fortified wine","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Fortified wine is a wine to which a distilled spirit, usually brandy, has been added. In the course of some centuries, winemakers have developed many different styles of fortified wine, including  port, sherry,  madeira,  Marsala, Commandaria wine, and the aromatised wine vermouth."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-fortified-wine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fortified_wine"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Cantonese cuisine","cuisine/cantonese-cuisine",[["Char siu","dish/char-siu"]]]]},{"h":"Often cooked with","links":[["Dark soy sauce","ingredient/dark-soy-sauce"],["Fermented bean curd","ingredient/fermented-bean-curd"],["Five-spice powder","ingredient/five-spice-powder"],["Hoisin sauce","ingredient/hoisin-sauce"],["Honey","ingredient/honey"],["Maltose","ingredient/maltose"],["Pork","ingredient/pork"],["Rice wine","ingredient/rice-wine"]]}],"img":{"src":"/world-cuisine/img/thumb/5/57/Port_wine.jpg/500px-Port_wine.jpg","w":500,"h":375,"by":"Jon Sullivan","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Port_wine.jpg"}},"dish/conecuh-sausage":{"t":"dish","r":"dish/conecuh-sausage","n":"Conecuh Sausage","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Southern American cuisine","dot":"#94bd5c","intro":[["Conecuh Sausage is a brand of hickory smoked pork sausage made in Conecuh County, Alabama."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-conecuh-sausage"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Conecuh_Sausage"}],"sections":[{"h":"Where it's from","links":[["Southern American cuisine","cuisine/cuisine-of-the-southern-united-states"]]},{"h":"Cook it","rows":[{"name":"Lana's Cooking","color":"#55b8ad","shape":"site","sub":"lanascooking.com","note":"Lana Stuart's blog of Southern home cooking from Georgia.","url":"https://www.lanascooking.com/about/","suggested":true,"kind":"blog"},{"name":"A Southern Soul: Southern Classics","color":"#55b8ad","shape":"site","sub":"asouthernsoul.com","note":"Collection of classic Southern recipes on a Southern home cooking blog.","url":"https://asouthernsoul.com/recipes/southern-classics","suggested":true,"kind":"blog"}]},{"h":"More from Southern American cuisine","links":[["Ambrosia (fruit salad)","dish/ambrosia-fruit-salad"],["Barbecue bologna","dish/barbecue-bologna"],["Chess pie","dish/chess-pie"],["Chicken Maryland","dish/chicken-maryland"],["Chitlins","dish/chitlins"],["Grape hull pie","dish/grape-hull-pie"],["Hash (stew)","dish/hash-stew"],["Lemon pepper wings","dish/lemon-pepper-wings"],["Mississippi mud pie","dish/mississippi-mud-pie"],["Monroe Sausage","dish/monroe-sausage"],["Moon Pie","dish/moon-pie"]]}]},"dish/jesuita-sandwich":{"t":"dish","r":"dish/jesuita-sandwich","n":"Jesuita (sandwich)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Argentine cuisine","dot":"#94bd5c","intro":[["A jesuita (as known in Uruguay) or fosforito (Argentina, lit. \"matchstick\") is a baked sandwich commonly eaten in parts of South America and considered a classic of Argentinian cuisine. It consists of two pieces of puff pastry filled with thin slices of ham and cheese."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-jesuita-sandwich"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Jesuita_(sandwich)"}],"sections":[{"h":"Where it's from","links":[["Argentine cuisine","cuisine/argentine-cuisine"]]},{"h":"Cook it","rows":[{"name":"Familia Kitchen: Argentina","color":"#55b8ad","shape":"site","sub":"familiakitchen.com","note":"Argentine recipes and stories on a Latino family cooking site.","url":"https://familiakitchen.com/destination/argentina/","suggested":true,"kind":"site"}]},{"h":"More from Argentine cuisine","links":[["Anticucho","dish/anticucho"],["Argentine pizza","dish/argentine-pizza"],["Asado","dish/asado"],["Bara brith","dish/bara-brith"],["Bondiola sandwich","dish/bondiola-sandwich"],["Cabbage roll","dish/cabbage-roll"],["Dulce de batata","dish/dulce-de-batata"],["Fugazza","dish/fugazza"],["Jésuite","dish/jesuite"],["Matambre","dish/matambre"],["Puchero","dish/puchero"],["Rogel (cake)","dish/rogel-cake"],["Salsa golf","dish/salsa-golf"]]}],"img":{"src":"/world-cuisine/img/thumb/8/8d/Jesuitas_%28postre%29.jpg/500px-Jesuitas_%28postre%29.jpg","w":500,"h":247,"by":"PachuliYo","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Jesuitas_(postre).jpg"}},"ingredient/plantain-cooking":{"t":"ingredient","r":"ingredient/plantain-cooking","n":"Plantain (cooking)","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Cooking bananas are a group of banana cultivars in the genus Musa whose fruits are generally used in cooking. They are not eaten raw and are generally starchy. Many cooking bananas are referred to as plantains or green bananas. In botanical usage, the term plantain is used only for true plantains, while other starchy cultivars used for cooking are called cooking bananas. True plantains are cooking cultivars belonging to the AAB group, while cooking bananas are any cooking cultivar belonging to the AAB, AAA, ABB, or BBB groups. The currently accepted scientific name for all such cultivars in these groups is Musa × paradisiaca. Fe'i bananas (Musa × troglodytarum) from the Pacific Islands are often eaten roasted or boiled, and are thus informally referred to as mountain plantains, although they do not belong to any of the species from which all modern banana cultivars are descended."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-plantain-cooking"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Plantain_(cooking)"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["American cuisine","cuisine/american-cuisine",[["Jibarito","dish/jibarito"]]],["Garifuna foodways","cuisine/garifuna-foodways",[["Hudut","dish/hudut"]]]]},{"h":"Often cooked with","links":[["Cheese","ingredient/cheese"],["Cooking banana","ingredient/cooking-banana"],["Garlic","ingredient/garlic"],["Lettuce","ingredient/lettuce"],["Mayonnaise","ingredient/mayonnaise"],["Tomato","ingredient/tomato"],["Coconut milk","ingredient/coconut-milk"],["Fish","ingredient/fish"]]},{"h":"Mentioned in","links":[["Garifuna foodways","cuisine/garifuna-foodways"],["Guna foodways","cuisine/guna-foodways"]]}],"img":{"src":"/world-cuisine/img/thumb/8/86/Mega_racimos_de_guineos.jpg/500px-Mega_racimos_de_guineos.jpg","w":500,"h":750,"by":"J & E","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Mega_racimos_de_guineos.jpg"}},"dish/kara-or-eva-snicla":{"t":"dish","r":"dish/kara-or-eva-snicla","n":"Karađorđeva šnicla","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Serbian cuisine","dot":"#cf5f87","intro":[["Karađorđeva šnicla is a breaded cutlet dish named after the Serbian revolutionary Karađorđe. The dish consists of a rolled veal, pork, or chicken steak, stuffed with kaymak, which is then breaded and fried. It is served with tartar sauce and a slice of lemon on the side, and sometimes french fries or steamed vegetables. Created by Josip Broz Tito's chef Mića Stojanović in 1956 or 1957 as an improvisation of chicken Kiev, it has become a regular staple in Serbian cuisine. Stojanović unsuccessfully tried to patent his original recipe, which has since been adapted to several variations."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kara-or-eva-snicla"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kara%C4%91or%C4%91eva_%C5%A1nicla"}],"sections":[{"h":"Where it's from","links":[["Serbian cuisine","cuisine/serbian-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Bread crumbs","ingredient/bread-crumbs"],["Egg","ingredient/egg"],["Kaymak","ingredient/kaymak"],["Schnitzel","ingredient/schnitzel"],["Steak","ingredient/steak"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Balkan Lunchbox: Kosovo recipes","color":"#55b8ad","shape":"site","sub":"balkanlunchbox.com","note":"Balkan home cooking blog with a section of Serbian dishes.","url":"https://balkanlunchbox.com/category/country/serbian-recipes/page/3","suggested":true,"kind":"blog"}]},{"h":"More from Serbian cuisine","links":[["Cabbage roll","dish/cabbage-roll"],["Pasulj","dish/pasulj"],["Pindjur","dish/pindjur"],["Pljeskavica","dish/pljeskavica"],["Stuffed leaves","dish/stuffed-leaves"]]}],"img":{"src":"/world-cuisine/img/thumb/0/03/Traditional_Serbian_Karadjordje%E2%80%99s_Steak_%2849153311933%29.jpg/500px-Traditional_Serbian_Karadjordje%E2%80%99s_Steak_%2849153311933%29.jpg","w":500,"h":321,"by":"Nenad Stojkovic from Srbija","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Traditional_Serbian_Karadjordje%E2%80%99s_Steak_(49153311933).jpg"}},"ingredient/walnuts":{"t":"ingredient","r":"ingredient/walnuts","n":"Walnuts","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["A walnut is the edible seed of any tree of the genus Juglans (family Juglandaceae), most often the Persian or English walnut, Juglans regia. They are accessory fruit because the outer covering of the fruit is technically an involucre and thus not morphologically part of the carpel; this means it cannot be a drupe but is instead a drupe-like nut."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-walnuts"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Walnuts"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Arab cuisine","cuisine/arab-cuisine",[["Ma'amoul","dish/ma-amoul"]]]]},{"h":"Where it's grown","grown":{"what":"Walnuts, in shell","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":4033999,"top":[["China","cuisine/chinese-cuisine",1250000],["United States of America","cuisine/american-cuisine",673494],["Iran","cuisine/iranian-cuisine",378695],["Turkey","cuisine/turkish-cuisine",346541],["India","cuisine/indian-cuisine",298123],["Chile","cuisine/chilean-cuisine",168680],["Mexico","cuisine/mexican-cuisine",163154],["Burkina Faso","cuisine/burkinabe-cuisine",135966],["Ukraine","cuisine/ukrainian-cuisine",109884],["Greece","cuisine/greek-cuisine",60132],["Romania","cuisine/romani-cuisine",53358],["Uzbekistan","cuisine/uzbek-cuisine",49299],["France","cuisine/french-cuisine",36914],["Egypt","cuisine/egyptian-cuisine",23604],["Afghanistan","cuisine/afghan-cuisine",22464]]}},{"h":"Often cooked with","links":[["Phoenix dactylifera","ingredient/phoenix-dactylifera"],["Pistachios","ingredient/pistachios"]]}],"img":{"src":"/world-cuisine/img/thumb/b/b2/Walnuts_-_whole_and_open_with_halved_kernel.jpg/500px-Walnuts_-_whole_and_open_with_halved_kernel.jpg","w":500,"h":333,"by":"Ivar Leidus","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Walnuts_-_whole_and_open_with_halved_kernel.jpg"}},"ingredient/fermentation":{"t":"ingredient","r":"ingredient/fermentation","n":"Fermentation","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["In food processing, fermentation is the conversion of carbohydrates to alcohol or organic acids using microorganisms—yeasts or bacteria—without an oxidizing agent being used in the reaction. Fermentation usually implies that the action of microorganisms is desired. The science of fermentation is known as zymology or zymurgy."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-fermentation"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fermentation_(food)"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Japanese cuisine","cuisine/japanese-cuisine",[["Miso","dish/miso"]]],["Vietnamese cuisine","cuisine/vietnamese-cuisine",[["Tương","dish/tuong"]]]]},{"h":"Often cooked with","links":[["Soybean","ingredient/soybean"],["Aspergillus oryzae","ingredient/aspergillus-oryzae"]]}],"img":{"src":"/world-cuisine/img/thumb/2/22/Tomb_of_Nakht_%2813%29.jpg/500px-Tomb_of_Nakht_%2813%29.jpg","w":500,"h":534,"by":"Unknown authorUnknown author","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Tomb_of_Nakht_(13).jpg"}},"ingredient/daucus-carota-subsp-sativus":{"t":"ingredient","r":"ingredient/daucus-carota-subsp-sativus","n":"Daucus carota subsp. sativus","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The carrot (Daucus carota subsp. sativus) is a root vegetable in the umbellifer family Apiaceae. Carrots are typically orange in colour due to their beta-carotene content, which makes them a rich source of vitamin A. Heirloom variants may be white, yellow, red, purple, or black. They are biennial plants."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-daucus-carota-subsp-sativus"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Daucus_carota_subsp._sativus"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Korean cuisine","cuisine/korean-cuisine",[["Morkovcha","dish/morkovcha"]]]]},{"h":"Often cooked with","links":[["Carrot","ingredient/carrot"],["Daucus","ingredient/daucus"],["Garlic","ingredient/garlic"],["Sunflower oil","ingredient/sunflower-oil"]]}],"img":{"src":"/world-cuisine/img/thumb/a/a2/Vegetable-Carrot-Bundle-wStalks.jpg/500px-Vegetable-Carrot-Bundle-wStalks.jpg","w":500,"h":284,"by":"Evan-Amos","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Vegetable-Carrot-Bundle-wStalks.jpg"}},"dish/nasi-padang":{"t":"dish","r":"dish/nasi-padang","n":"Nasi padang","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Nasi padang, sometimes referred to as Padang rice, is a Minangkabau dish of steamed rice served with various choices of pre-cooked dishes originating from West Sumatra, Indonesia. It is named after the city of Padang, the capital of the West Sumatra province. A miniature banquet of meats, fish, vegetables, and spicy sambals eaten with plain white rice, it is Sumatra's most famous export and the Minangkabau people's primary contribution to Indonesian cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-nasi-padang"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Nasi_padang"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"],["Padang food","cuisine/padang-food"]]},{"h":"Ingredients","count":4,"links":[["Chicken","ingredient/chicken"],["Galangal","ingredient/galangal"],["Lemongrass","ingredient/lemongrass"],["Rice","ingredient/rice"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true,"kind":"blog"}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}],"img":{"src":"/world-cuisine/img/thumb/9/93/Nasi_padang.jpg/500px-Nasi_padang.jpg","w":500,"h":281,"by":"ProjectManhattan","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Nasi_padang.jpg"}},"dish/pyongyang-raengmyon":{"t":"dish","r":"dish/pyongyang-raengmyon","n":"Pyongyang Raengmyon","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from North Korean cuisine","dot":"#f0b340","intro":[["Naengmyeaon or raengmyŏn (랭면, in North Korea) is a noodle dish of North Korean origin which consists of long and thin handmade noodles made from the flour and starch of various ingredients, including most commonly buckwheat (메밀, memil) but also potatoes, sweet potatoes, arrowroot starch (darker color and chewier than buckwheat noodles), and kudzu (칡, chik). Other varieties of naengmyeon are made from ingredients such as seaweed and green tea."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pyongyang-raengmyon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pyongyang_Raengmyon"}],"sections":[{"h":"Where it's from","links":[["North Korean cuisine","cuisine/north-korean-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Buckwheat","ingredient/buckwheat"],["Noodle","ingredient/noodle"],["Potato","ingredient/potato"],["Sweet potato","ingredient/sweet-potato"]]},{"h":"More from North Korean cuisine","links":[["Injo-gogi-bap","dish/injo-gogi-bap"],["Paensae","dish/paensae"],["Pyeonsu","dish/pyeonsu"],["Sungeo-guk","dish/sungeo-guk"]]}],"img":{"src":"/world-cuisine/img/thumb/e/e7/Cold_Noodles_at_Famous_Okryu_Restaurant_%2810108835864%29.jpg/500px-Cold_Noodles_at_Famous_Okryu_Restaurant_%2810108835864%29.jpg","w":500,"h":375,"by":"Uri Tours (uritours.com)","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Cold_Noodles_at_Famous_Okryu_Restaurant_(10108835864).jpg"}},"ingredient/masa":{"t":"ingredient","r":"ingredient/masa","n":"Masa","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 5 cuisines","intro":[["Dough of ",["nixtamalized","ingredient/nixtamalization"]," corn, ground wet. ",["Maya","cuisine/maya-cuisine"]," families in Yucatán wrap it around a filling for ",["Pib","dish/piib"],", ",["Zapotec","cuisine/zapotec-foodways"]," women grind corn with cacao for ",["Tejate","dish/tejate"],", and ",["Nahua","cuisine/nahua-foodways"]," cooks in Zongolica roll it into little balls for tesmole."]],"src":"note","sources":[{"name":"Uno TV, El pib, la tradición yucateca que se cocina bajo tierr