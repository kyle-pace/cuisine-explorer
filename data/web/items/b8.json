nses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Chicken_satay_on_banana_leaf_in_Java.jpg"}},"ingredient/chicken-tenders":{"t":"ingredient","r":"ingredient/chicken-tenders","n":"Chicken tenders","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 3 cuisines","intro":[["Chicken tenders (also known as  chicken goujons, chicken strips, chicken fingers, or chicken fillets) are chicken meat prepared from the pectoralis minor muscles of the bird. These strips of white meat are located on either side of the breastbone, under the breast meat (pectoralis major). They may also be made with similarly shaped pieces cut from chicken meat, usually the breast, or sometimes just pulverized chicken flesh."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-chicken-tenders"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chicken_tenders"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Satay","dish/satay"]]],["Singaporean Chinese cuisine","cuisine/singaporean-cuisine-chinese-inspired",[["Satay","dish/satay"]]],["Singaporean cuisine","cuisine/singaporean-cuisine",[["Satay","dish/satay"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Chicken","ingredient/chicken"],["Fish","ingredient/fish"],["Goat","ingredient/goat"],["Lime","ingredient/lime"],["Offal","ingredient/offal"],["Shallot","ingredient/shallot"],["Soy sauce","ingredient/soy-sauce"],["Sticks","ingredient/sticks"]]}],"img":{"src":"/labs/cuisines/img/thumb/2/21/Crispy_Chicken_Strips_-_FotoosVanRobin.jpg/500px-Crispy_Chicken_Strips_-_FotoosVanRobin.jpg","w":500,"h":314,"by":"FotoosVanRobin from Netherlands","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Crispy_Chicken_Strips_-_FotoosVanRobin.jpg"}},"dish/taboon-bread":{"t":"dish","r":"dish/taboon-bread","n":"Taboon bread","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 5 cuisines","dot":"#f0b340","intro":[["A tabun oven, or simply tabun, is a portable clay oven, shaped like a truncated cone. While all were made with a top opening, which could be used as a small stove top, some were made with an opening at the bottom from which to stoke the fire. Built and used even before biblical times as the family, neighbourhood, or village oven, tabun ovens continue to be built and used in parts of the Middle East today. Tabun ovens are distinct from tandoors, but are often mistaken for tandoors. Unlike a tandoor, bread inside the oven is placed on a bed of hot stones, rather than being slapped into walls of the oven. In modern times, this form of oven is common in Jordan and Palestine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-taboon-bread"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Taboon_bread"}],"sections":[{"h":"Where it's from","links":[["Israeli cuisine","cuisine/israeli-cuisine"],["Jordanian cuisine","cuisine/jordanian-cuisine"],["Levantine cuisine","cuisine/levantine-cuisine"],["Palestinian cuisine","cuisine/palestinian-cuisine"],["Syrian cuisine","cuisine/syrian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Wheat flour","ingredient/wheat-flour"],["Yeast","ingredient/yeast"]]},{"h":"More from Israeli cuisine","links":[["Baba ghanoush","dish/baba-ghanoush"],["Cabbage roll","dish/cabbage-roll"],["Hummus","dish/hummus"],["Lahoh","dish/lahoh"],["Sabich","dish/sabich"],["Sufganiyah","dish/sufganiyah"],["Ziva (dish)","dish/ziva-dish"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/1b/Lch_%2820%29.JPEG/500px-Lch_%2820%29.JPEG","w":500,"h":334,"by":"Basel15 at English Wikipedia (Original text: Bazel)","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Lch_(20).JPEG"}},"dish/sakotis":{"t":"dish","r":"dish/sakotis","n":"Šakotis","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#cf5f87","intro":[["Šakotis (\"tree cake\") (Polish: sękacz [ˈsɛŋkat͡ʂ], Belarusian: банкуха, romanized: bankukha) is a spit cake. It is a national Lithuanian, local Polish (northeasternmost part of Poland), and local westernmost Belarusian traditional spit cake, made of butter, egg whites and yolks, flour, sugar, and cream, cooked on a rotating spit in an oven or over an open fire."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-sakotis"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/%C5%A0akotis"}],"sections":[{"h":"Where it's from","links":[["Belarusian cuisine","cuisine/belarusian-cuisine"],["Lithuanian cuisine","cuisine/lithuanian-cuisine"],["Polish cuisine","cuisine/polish-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Egg","ingredient/egg"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Polonist","ref":"site/polonist-com","color":"#55b8ad","shape":"site","sub":"polonist.com","note":"Polish recipes and food culture from a Polish-born writer living abroad.","url":"https://www.polonist.com/about/","suggested":true,"kind":"blog"},{"name":"Polish Your Kitchen","ref":"site/polishyourkitchen-com","color":"#55b8ad","shape":"site","sub":"polishyourkitchen.com","note":"Long-running blog of traditional Polish home recipes.","url":"https://polishyourkitchen.com","suggested":true,"kind":"blog"}]},{"h":"More from Belarusian cuisine","links":[["Angel wings","dish/angel-wings"],["Aspic","dish/aspic"],["Baba (cake)","dish/baba-cake"],["Borscht","dish/borscht"],["Cabbage roll","dish/cabbage-roll"],["Cold beet soup","dish/cold-beet-soup"],["Gugelhupf","dish/gugelhupf"],["Kalduny","dish/kalduny"],["Kasha","dish/kasha"],["Krupnik (soup)","dish/krupnik-soup"],["Medovukha","dish/medovukha"],["Mimosa salad","dish/mimosa-salad"],["Paska (bread)","dish/paska-bread"],["Potato pancake","dish/potato-pancake"],["Salceson","dish/salceson"],["Solyanka","dish/solyanka"],["Sorrel soup","dish/sorrel-soup"],["Syrniki","dish/syrniki"],["Zatiruha","dish/zatiruha"],["Zrazy",