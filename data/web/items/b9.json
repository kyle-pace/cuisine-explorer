{"cuisine/cuisine-of-lesotho":{"t":"cuisine","r":"cuisine/cuisine-of-lesotho","n":"Lesotho cuisine","c":"#e46a3f","crumb":[["Africa","cuisines#africa"],["Cuisine"]],"sub":"National cuisine of Lesotho","intro":[["Basotho (people of Lesotho) cuisine features African traditions and British influence. Lesotho is surrounded by South Africa and it shares culinary practices with its neighbor."],["Lesotho's food culture features likhobe (a stew with beans, berries, and sorghum), meat, and vegetables. Corn-based dishes include papa and motoho (fermented sorghum porridge)."],["Basotho cuisine includes sauces, generally less spicy than other African countries. Beetroot and carrot salads are common side dishes."],["British desserts can be found."],["Other traditional foods include:"],["Oxtail stew"],["Curries"],["Kebabs"]],"src":"wikipedia","actions":[{"kind":"globe","hash":"cuisine-of-lesotho"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cuisine_of_Lesotho"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]}],"cont":"African cuisine"},"ingredient/onions":{"t":"ingredient","r":"ingredient/onions","n":"Onions","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 5 dishes across 5 cuisines","intro":[["The onion (Allium cepa L.Tooltip Carl Linnaeus, from Latin cepa), also known as the bulb onion or common onion, is a vegetable that is the most widely cultivated species of the genus Allium. The shallot is a botanical variety of the onion which was classified as a separate species until 2011. The onion's close relatives include garlic, scallion, leek, and chives."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-onions"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Onions"}],"sections":[{"h":"Where it's cooked with","count":5,"groups":[["Portuguese cuisine","cuisine/portuguese-cuisine",[["Bacalhau à Brás","dish/bacalhau-a-bras"],["Bacalhau com natas","dish/bacalhau-com-natas"]]],["Argentine cuisine","cuisine/argentine-cuisine",[["Fugazza","dish/fugazza"]]],["Indonesian cuisine","cuisine/indonesian-cuisine",[["Bubur pedas","dish/bubur-pedas"]]],["Jewish cuisine","cuisine/jewish-cuisine",[["Gondi (food)","dish/gondi-food"]]],["Mizrahi Jewish cuisine","cuisine/mizrahi-jewish-cuisine",[["Gondi (food)","dish/gondi-food"]]]]},{"h":"Often cooked with","links":[["Bacalhau","ingredient/bacalhau"],["Fried potatoes","ingredient/fried-potatoes"],["Garlic","ingredient/garlic"],["Cream","ingredient/cream"],["Double cream","ingredient/double-cream"],["Fries","ingredient/fries"],["Salt cod","ingredient/salt-cod"],["Atlantic cod","ingredient/atlantic-cod"],["Egg","ingredient/egg"],["Anchovy","ingredient/anchovy"],["Bamboo shoot","ingredient/bamboo-shoot"],["Bean curd","ingredient/bean-curd"],["Bumbu (seasoning)","ingredient/bumbu-seasoning"],["Caraway seed","ingredient/caraway-seed"],["Carrots","ingredient/carrots"],["Chili pepper","ingredient/chili-pepper"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a2/Mixed_onions.jpg/500px-Mixed_onions.jpg","w":500,"h":500,"by":"© User:Colin / Wikimedia Commons","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Mixed_onions.jpg"}},"ingredient/chicken-wings-as-food":{"t":"ingredient","r":"ingredient/chicken-wings-as-food","n":"Chicken wings as food","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Chicken is the most common type of poultry and the second most consumed meat in the world, after pork. Owing to the relative ease and low cost of raising chickens—in comparison to mammals such as cattle or pigs—chicken meat (commonly called just \"chicken\") and chicken eggs have become prevalent in numerous cuisines."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-chicken-wings-as-food"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chicken_wings_as_food"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["American cuisine","cuisine/american-cuisine",[["Buffalo wing","dish/buffalo-wing"]]]]},{"h":"Often cooked with","links":[["Butter","ingredient/butter"],["Cayenne pepper","ingredient/cayenne-pepper"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/57/Chickens_in_market.jpg/500px-Chickens_in_market.jpg","w":500,"h":408,"by":"Tomás Castelazo","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Chickens_in_market.jpg"}},"ingredient/biscuit-bread":{"t":"ingredient","r":"ingredient/biscuit-bread","n":"Biscuit (bread)","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["In the United States and Canada, a biscuit is a variety of quick bread with a firm, dry exterior and a soft, moist, crumbly interior, usually made on the spot for prompt eating. It is made with baking powder, baking soda, or a combination of the two as a leavening agent rather than yeast, and at times is called a baking powder biscuit to differentiate it from other types. Biscuits are often served with butter or other condiments, flavored with other ingredients, or combined with other types of food to make sandwiches or other dishes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-biscuit-bread"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Biscuit_(bread)"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["American cuisine","cuisine/american-cuisine",[["Cobbler (food)","dish/cobbler-food"]]],["British cuisine","cuisine/british-cuisine",[["Cobbler (food)","dish/cobbler-food"]]]]},{"h":"Often cooked with","links":[["Batter (cooking)","ingredient/batter-cooking"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/be/Loveless_Cafe_Biscuits.jpg/500px-Loveless_Cafe_Biscuits.jpg","w":500,"h":667,"by":"Dale Cruse","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Loveless_Cafe_Biscuits.jpg"}},"ingredient/chicken-stock":{"t":"ingredient","r":"ingredient/chicken-stock","n":"Chicken stock","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Stock, sometimes called bone broth, is a savory cooking liquid that forms the basis of many dishes – particularly soups, stews, and sauces. Making stock involves simmering animal bones, meat, seafood, or vegetables in water or wine, often for an extended period. Mirepoix or other aromatics may be added for more flavor."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-chicken-stock"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chicken_stock"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Scottish cuisine","cuisine/scottish-cuisine",[["Cock-a-leekie","dish/cock-a-leekie"]]]]},{"h":"Often cooked with","links":[["Broth","ingredient/broth"],["Leek","ingredient/leek"]]}]},"dish/daube":{"t":"dish","r":"dish/daube","n":"Daube","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Daube is a French slow-cooked stew, usually of beef, but other meat is sometimes used. The best-known is the bœuf en daube à la provençale, a Provençal stew made with cheaper cuts of beef braised in wine, with vegetables, garlic and herbs, and traditionally cooked in a daubière–a braising pot."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-daube"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Daube"}],"sections":[{"h":"Where it's from","links":[["French cuisine","cuisine/french-cuisine"],["New Caledonian cuisine","cuisine/new-caledonian-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Beef","ingredient/beef"]]},{"h":"Cook it","rows":[{"name":"Pardon Your French","color":"#55b8ad","shape":"site","sub":"pardonyourfrench.com","note":"Audrey Le Goff, a French cook, shares classic and regional French home recipes.","url":"https://pardonyourfrench.com","