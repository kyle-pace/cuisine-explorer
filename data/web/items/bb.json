,{"h":"Ingredients","count":2,"links":[["Barley","ingredient/barley"],["Wheat","ingredient/wheat"]]},{"h":"Cook it","rows":[{"name":"Eleni's Kitchen Blog","ref":"site/eleniskitchen-com","color":"#55b8ad","shape":"site","sub":"eleniskitchen.com","note":"Recipes from Ethiopian-born caterer and cooking instructor Eleni Woldeyes near Portland; also promotes her spice and sauce shop.","url":"https://www.eleniskitchen.com/blog","suggested":true}]},{"h":"More from Eritrean cuisine","links":[["Bar Zilli","dish/bar-zilli"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/d8/Ga%27at_food.jpg/500px-Ga%27at_food.jpg","w":500,"h":335,"by":"Stefan Alfons Tzeggai","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Ga'at_food.jpg"}},"dish/goshtaab":{"t":"dish","r":"dish/goshtaab","n":"Goshtaab","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Kashmiri cuisine","dot":"#f0b340","intro":[["Goshtaab, also spelled goshtaba, is a traditional Kashmiri dish that holds a significant place in the region's culinary heritage. Often referred to as the \"king of Kashmiri wazwan,\" goshtab is a rich and aromatic meatball curry made from finely minced mutton, yogurt, and a blend of spices. It is typically served as a final course in the traditional multi-course Kashmiri feast known as wazwan."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-goshtaab"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Goshtaab"}],"sections":[{"h":"Where it's from","links":[["Kashmiri cuisine","cuisine/kashmiri-cuisine"]]},{"h":"Cook it","rows":[{"name":"iKashmir Cookbook","ref":"site/ikashmir-net","color":"#55b8ad","shape":"site","sub":"ikashmir.net","note":"Kashmiri Pandit community site with a collection of traditional recipes.","url":"https://ikashmir.net/cookbook/recipes/index.html","suggested":true}]},{"h":"More from Kashmiri cuisine","links":[["Katlam","dish/katlam"],["Wazwan","dish/wazwan"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/ac/Goshtaba_wazwan.jpg/500px-Goshtaba_wazwan.jpg","w":500,"h":375,"by":"Oniongas","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Goshtaba_wazwan.jpg"}},"dish/kibbeh":{"t":"dish","r":"dish/kibbeh","n":"Kibbeh","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Palestinian cuisine","dot":"#f0b340","intro":[["Kibbeh is a popular dish in the Arab world and the Levant in particular, made of spiced lean ground meat and bulgur wheat. Kibbeh is considered to be a national dish of Lebanon and Syria."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kibbeh"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kibbeh"}],"sections":[{"h":"Where it's from","links":[["Palestinian cuisine","cuisine/palestinian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Bulgur","ingredient/bulgur"],["Ground meat","ingredient/ground-meat"],["Levantine cuisine","ingredient/levantine-cuisine"]]},{"h":"More from Palestinian cuisine","links":[["Jibneh Arabieh","dish/jibneh-arabieh"],["Maltout","dish/maltout"],["Maqluba","dish/maqluba"],["Meghli","dish/meghli"],["Musakhan","dish/musakhan"],["Ntolmás","dish/ntolmas"],["Qalayet bandora","dish/qalayet-bandora"],["Qatayef","dish/qatayef"],["Stuffed squash","dish/stuffed-squash"],["Stuffed turnips","dish/stuffed-turnips"],["Taboon bread","dish/taboon-bread"],["Zalabiyeh","dish/zalabiyeh"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/88/Kibbeh3.jpg/500px-Kibbeh3.jpg","w":500,"h":375,"by":"Basel15 at the English Wikipedia","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Kibbeh3.jpg"}},"dish/ladera":{"t":"dish","r":"dish/ladera","n":"Ladera","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Greek cuisine","dot":"#cf5f87","intro":[["Ladera, zeytinyağlı  (yemekler) (Turkish), or bil zayt (Arabic بالزيت) is a category of vegetable dishes cooked in olive oil in Greek, Turkish, and Arabic cuisines. The name in all these languages means \"with (olive) oil\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-ladera"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ladera"}],"sections":[{"h":"Where it's from","links":[["Greek cuisine","cuisine/greek-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Olive oil","ingredient/olive-oil"]]},{"h":"Cook it","rows":[{"name":"Dimitra's Dishes","ref":"site/dimitrasdishes-com","color":"#55b8ad","shape":"site","sub":"dimitrasdishes.com","note":"Dimitra Alfieris's video channel and blog focused on classic Greek home cooking.","url":"https://dimitrasdishes.com","suggested":true}]},{"h":"More from Greek cuisine","links":[["Alexis Restaurant","dish/alexis-restaurant"],["Avgolemono","dish/avgolemono"],["Baba ghanoush","dish/baba-ghanoush"],["Bouyiourdi","dish/bouyiourdi"],["Cabbage roll","dish/cabbage-roll"],["Dametra Cafe","dish/dametra-cafe"],["Diples","dish/diples"],["Fasolada","dish/fasolada"],["Freddo cappuccino","dish/freddo-cappuccino"],["Greek restaurant","dish/greek-restaurant"],["Greek salad","dish/greek-salad"],["İmam bayıldı","dish/imam-bay-ld"],["Kakavia (soup)","dish/kakavia-soup"],["Kalitsounia","dish/kalitsounia"],["Karydopita","dish/karydopita"],["Keşkek","dish/keskek"],["Noumboulo","dish/noumboulo"],["Pithari Taverna","dish/pithari-taverna"],["Psarosoupa","dish/psarosoupa"],["Spanakorizo","dish/spanakorizo"],["Taramasalata","dish/taramasalata"],["Tzatziki","dish/tzatziki"],["Yia Yia Mary's","dish/yia-yia-mary-s"]]}],"img":{"src":"/labs/cuisines/img/thumb/6/60/Turkey2002_img_0137.jpg/500px-Turkey2002_img_0137.jpg","w":500,"h":375,"by":"Gürkan Sengün","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Turkey2002_img_0137.jpg"}},"dish/limpa":{"t":"dish","r":"dish/limpa","n":"Limpa","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Swedish cuisine","dot":"#cf5f87","intro":[["Wort bread (Swedish “Vörtbröd\") is a sweet Scandinavian rye bread, associated with Swedish cuisine.   It is a yeast-leavened spice loaf, sweetened with brown sugar and molasses which comes in a large variety in regard to whether or not butter-enriched, and if spices are being used. Traditional bread spices are anise, caraway, fennel seeds, and bitter orange."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-limpa"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Limpa"}],"sections":[{"h":"Where it's from","links":[["Swedish cuisine","cuisine/swedish-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Butter","ingredient/butter"],["Maltodextrin","ingredient/maltodextrin"],["Rye flour","ingredient/rye-flour"],["Sugar","ingredient/sugar"],["Yeast","ingredient/yeast"]]},{"h":"Cook it","rows":[{"name":"Scandicuisine: Swedish recipes","ref":"site/scandicuisine-com","color":"#55b8ad","shape":"site","sub":"scandicuisine.com","note":"Traditional Swedish recipes from Cecilia, a cook from a Finnish-Swedish family on Åland.","url":"https://scandicuisine.com/category/swedish-recipes","suggested":true}]},{"h":"More from Swedish cuisine","links":[["Biff à la Lindström","dish/biff-a-la-lindstrom"],["Blåbärssoppa","dish/blabarssoppa"],["Blodpalt","dish/blodpalt"],["Cabbage roll","dish/cabbage-roll"],["Flying Jacob","dish/flying-jacob"],["Fruktsoppa","dish/fruktsoppa"],["Glögg","dish/glogg"],["Hasselback potatoes","dish/hasselback-potatoes"],["Isterband","dish/isterband"],["Kebab pizza","dish/kebab-pizza"],["Korv stroganoff","dish/korv-stroganoff"],["Kroppkaka","dish/kroppkaka"],["Lutefisk","dish/lutefisk"],["Oatmeal ball","dish/oatmeal-ball"],["Ostkaka","dish/ostkaka"],["Rødgrød","dish/r-dgr-d"],["Semla","dish/semla"],["Smörgåstårta","dish/smorgastarta"],["Strong beer","dish/strong-beer"],["Surströmming","dish/surstromming"],["Swedish meatballs","dish/swedish-meatballs"]]}],"img":{"src":"/labs/cuisines/img/thumb/c/cb/Vortbrod.jpg/500px-Vortbrod.jpg","w":500,"h":500,"by":"Per Bolmstedt","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Vortbrod.jpg"}},"ingredient/side-dish":{"t":"ingredient","r":"ingredient/side-dish","n":"Side dish","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["A side dish, sometimes referred to as a side order, side item, or simply a side, is a food item that accompanies the entrée or main course at a meal."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-side-dish"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Side_dish"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Nasi kapau","dish/nasi-kapau"]]],["Padang food","cuisine/padang-food",[["Nasi kapau","dish/nasi-kapau"]]]]},{"h":"Often cooked with","links":[["Rice","ingredient/rice"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/9b/Flickr_stuart_spivack_173603796--Macaroni_and_cheese.jpg/500px-Flickr_stuart_spivack_173603796--Macaroni_and_cheese.jpg","w":500,"h":375,"by":"Stuart Spivack from Cleveland, Ohio, USA","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Flickr_stuart_spivack_173603796--Macaroni_and_cheese.jpg"}},"dish/panella":{"t":"dish","r":"dish/panella","n":"Panella","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Sicilian cuisine","dot":"#cf5f87","intro":[["Panella is a Sicilian fritter made with chickpea flour and other ingredients, usually including water, salt, pepper, olive oil, and finely chopped parsley. They are a popular street food in the city of Palermo and are often eaten between slices of bread or on a sesame roll, like a sandwich. Called pane e panelle, these sandwiches are usually served with a slice of lemon to be squeezed over panelle."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-panella"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Panella"}],"sections":[{"h":"Where it's from","links":[["Sicilian cuisine","cuisine/sicilian-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Chickpea flour","ingredient/chickpea-flour"]]},{"h":"More from Sicilian cuisine","links":[["Busiate","dish/busiate"],["Cassatella di Agira","dish/cassatella-di-agira"],["Crocchè","dish/crocche"],["Iris (pastry)","dish/iris-pastry"],["Maccu","dish/maccu"],["Pani câ meusa","dish/pani-ca-meusa"],["Parmigiana","dish/parmigiana"],["Pasta alla Norma","dish/pasta-alla-norma"],["Pasta con le sarde","dish/pasta-con-le-sarde"],["Pasta mollicata","dish/pasta-mollicata"],["Stigghiola","dish/stigghiola"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/7f/Panelle_in_Caltanissetta.jpg/500px-Panelle_in_Caltanissetta.jpg","w":500,"h":666,"by":"Auregann","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Panelle_in_Caltanissetta.jpg"}},"ingredient/cucurbita-maxima":{"t":"ingredient","r":"ingredient/cucurbita-maxima","n":"Cucurbita maxima","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Cucurbita maxima, one of at least five species of cultivated squash, is one of the most diverse domesticated species. This species originated in South America from the wild subspecies Cucurbita maxima subsp. andreana over 4,000 years ago. Cucurbita maxima, known for modern varieties as Hubbard, Delicious, Marblehead, Boston Marrow, and Turks Turban, originated in northern Argentina near the Andes or in certain Andean valleys. Secondary centers of diversity include India, Bangladesh, Myanmar, and the southern Appalachians."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-cucurbita-maxima"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cucurbita_maxima"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Peruvian cuisine","cuisine/peruvian-cuisine",[["Picarones","dish/picarones"]]]]},{"h":"Often cooked with","links":[["Chancaca","ingredient/chancaca"],["Fig","ingredient/fig"],["Panela","ingredient/panela"],["Squash (plant)","ingredient/squash-plant"],["Sweet potato","ingredient/sweet-potato"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/labs/cuisines/img/thumb/3/3a/Cucurbita_maxima_Blanco2.320.png/500px-Cucurbita_maxima_Blanco2.320.png","w":500,"h":716,"by":"Francisco Manuel Blanco (1778 – 1845) (O.S.A.)","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Cucurbita_maxima_Blanco2.320.png"}},"dish/roti-jala":{"t":"dish","r":"dish/roti-jala","n":"Roti jala","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Malay cuisine","dot":"#f0b340","intro":[["Roti jala, roti kirai or roti renjis is a popular Malay, Minangkabau, and Acehnese tea time snack served with curry dishes which can be found in Indonesia, Malaysia and Singapore. This is a very traditional Malay dish that is usually homemade and served at events such as weddings and festivals. It is usually eaten in sets of three to four pieces with curries, especially chicken curry, as a substitute for rice."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-roti-jala"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Roti_jala"}],"sections":[{"h":"Where it's from","links":[["Malay cuisine","cuisine/malay-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Coconut milk","ingredient/coconut-milk"],["Egg","ingredient/egg"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"More from Malay cuisine","links":[["Akok (food)","dish/akok-food"],["Ikan bakar","dish/ikan-bakar"],["Karas (food)","dish/karas-food"],["Ketupat","dish/ketupat"],["Lekor","dish/lekor"],["Mee siput","dish/mee-siput"],["Nasi Ayam","dish/nasi-ayam"],["Nasi kerabu","dish/nasi-kerabu"],["Nasi tumpang","dish/nasi-tumpang"],["Sata (food)","dish/sata-food"],["Tahu goreng","dish/tahu-goreng"],["Ulam (salad)","dish/ulam-salad"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/d6/Bazar_Ramadan_Sejati_Walk_20250304_05_roti_jala.jpg/500px-Bazar_Ramadan_Sejati_Walk_20250304_05_roti_jala.jpg","w":500,"h":375,"by":"Taufik","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Bazar_Ramadan_Sejati_Walk_20250304_05_roti_jala.jpg"}},"dish/saizeriya":{"t":"dish","r":"dish/saizeriya","n":"Saizeriya","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Italian cuisine","dot":"#cf5f87","intro":[["Saizeriya is a Japanese chain of family-style Italian yōshoku restaurants, commonly abbreviated as \"Saize\" (サイゼ). It is managed by Saizeriya Co. (株式会社サイゼリヤ, Kabushiki-gaisha Saizeriya). Its headquarters are in Yoshikawa, Saitama. Beyond Japan, the restaurant also has a presence in China, Hong Kong, Taiwan, and Singapore, and has a factory in Melton, Victoria, Australia."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-saizeriya"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Saizeriya"}],"sections":[{"h":"Where it's from","links":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","ref":"site/pastagrannies-substack-com","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's long-running video series filming Italian grandmothers making regional pasta by hand.","url":"https://pastagrannies.substack.com/p/pasta-grannies-is-now-on-substack","suggested":true},{"name":"Recipes from Italy","ref":"site/recipesfromitaly-com","color":"#55b8ad","shape":"site","sub":"recipesfromitaly.com","note":"Traditional Italian recipes written by Italian home cooks, organized by region and course.","url":"https://recipesfromitaly.com","suggested":true},{"name":"Manu's Menu","ref":"site/manusmenu-com","color":"#55b8ad","shape":"site","sub":"manusmenu.com","note":"Italian-born home cook Manuela sharing classic family and regional Italian dishes.","url":"https://www.manusmenu.com/about/about-this-site","suggested