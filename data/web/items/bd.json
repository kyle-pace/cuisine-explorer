e","dot":"#94bd5c","intro":[["The Parish was a Cajun, Louisiana Creole, and seafood restaurant in Portland, Oregon's Pearl District, in the United States. It was opened by Tobias Hogan and Ethan Powell in 2012, and became known for its oysters. In 2015, the restaurant was split in half, and one side of the space began serving brunch, lunch, and happy hour as the Palmetto Cafe. The Palmetto was converted into a private event space and pop-up restaurant in February 2016, and The Parish closed abruptly in September of that year."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-the-parish"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/The_Parish"}],"sections":[{"h":"Where it's from","links":[["Cajun cuisine","cuisine/cajun-cuisine"]]},{"h":"Cook it","rows":[{"name":"Kenneth Temple: Cajun and Creole","ref":"site/kennethtemple-com","color":"#55b8ad","shape":"site","sub":"kennethtemple.com","note":"Cajun and Creole recipes from a New Orleans-based cook and video creator.","url":"https://kennethtemple.com/recipes/cajun-creole/","suggested":true,"kind":"blog"}]},{"h":"More from Cajun cuisine","links":[["Acadia: A New Orleans Bistro","dish/acadia-a-new-orleans-bistro"],["Blue Bayou Restaurant","dish/blue-bayou-restaurant"],["Delta Cafe","dish/delta-cafe"],["Gumbo","dish/gumbo"],["Le Bistro Montage","dish/le-bistro-montage"],["New Orleans hot sausage","dish/new-orleans-hot-sausage"]]}]},"dish/akutaq":{"t":"dish","r":"dish/akutaq","n":"Akutaq","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 4 cuisines","dot":"#94bd5c","intro":[["Akutaq, a Yup'ik word for \"mixed together,\" is fat whipped by hand until it's light and creamy, then folded with berries, and sometimes fish or meat. What goes in depends on the place and the season: ",["Seal oil","ingredient/seal-oil"]," and sea mammal fat on the coast, ",["Caribou","ingredient/reindeer"]," or ",["Moose","ingredient/moose"]," fat inland. It's made for gatherings, potlatches and holidays."]],"src":"note","sources":[{"name":"Alaska Native Tribal Health Consortium, Nellie's Recipes","url":"https://anthc.org/wp-content/uploads/2024/11/Nellie-final-2024.pdf"}],"actions":[{"kind":"globe","hash":"dish-akutaq"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Akutaq"}],"sections":[{"h":"Where it's from","links":[["Yup'ik cuisine","cuisine/yup-ik-cuisine"],["Iñupiaq foodways","cuisine/inupiaq-foodways"],["Athabascan foodways","cuisine/athabascan-foodways"],["Alaska Native foodways","cuisine/alaska-native-foodways"]]},{"h":"Ingredients","count":4,"links":[["Animal fats and oils","ingredient/animal-fats-and-oils"],["Berry","ingredient/berry"],["Seal oil","ingredient/seal-oil"],["Whitefish","ingredient/whitefish"]]},{"h":"Cook it","rows":[{"name":"ANTHC healthy recipes","ref":"site/anthc-org","color":"#55b8ad","shape":"site","sub":"anthc.org","note":"Recipe cards from the Alaska Native Tribal Health Consortium, like seal posole.","url":"https://anthc.org/wp-content/uploads/2020/10/Recipe_Seal-Posole.pdf","suggested":true},{"name":"USDA FDPIR recipes and cookbooks","ref":"site/fna-usda-gov","color":"#55b8ad","shape":"site","sub":"fna.usda.gov","note":"Tribal cookbooks and Indigenous chefs' recipes gathered by the USDA.","url":"https://www.fna.usda.gov/fdpir/sharing-gallery/recipes-cookbooks","suggested":true},{"name":"NĀTIFS Indigenous Food Sovereignty recipes","ref":"site/natifs-org","color":"#55b8ad","shape":"site","sub":"natifs.org","note":"Recipes and videos from the Indigenous Food Lab and partner Indigenous chefs.","url":"https://natifs.org/indigenous-food-sovereignty-initiative-usda-fdpir/","suggested":true}]}],"img":{"src":"/labs/cuisines/img/thumb/a/a8/Iced_Akutaq.jpg/500px-Iced_Akutaq.jpg","w":500,"h":375,"by":"Matyáš Havel","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Iced_Akutaq.jpg"}},"cookbook/fast-and-fresh-cal-mex-cooking-west-coast-inspired-dinners-in-30-minutes-or-less":