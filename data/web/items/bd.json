s://commons.wikimedia.org/wiki/File:Nangua_Baozi_(chinese_dumplings).jpg"}},"ingredient/tomato-puree":{"t":"ingredient","r":"ingredient/tomato-puree","n":"Tomato purée","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Tomato purée is a thick liquid made by cooking and straining tomatoes. The main difference between tomato paste, tomato purée, and tomato sauce is consistency; tomato puree has a thicker consistency and a deeper flavour than sauce."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tomato-puree"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tomato_pur%C3%A9e"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["American cuisine","cuisine/american-cuisine",[["Barbecue sauce","dish/barbecue-sauce"]]]]},{"h":"Often cooked with","links":[["Ketchup","ingredient/ketchup"],["Sugar","ingredient/sugar"],["Tomato paste","ingredient/tomato-paste"],["Vinegar","ingredient/vinegar"]]}],"img":{"src":"/world-cuisine/img/thumb/9/94/Tomato_passata.jpg/500px-Tomato_passata.jpg","w":500,"h":343,"by":"Tabby","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Tomato_passata.jpg"}},"dish/belgian-chocolate":{"t":"dish","r":"dish/belgian-chocolate","n":"Belgian chocolate","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Belgian cuisine","dot":"#cf5f87","intro":[["Belgian chocolate is chocolate produced in Belgium. A major industry since the 19th century, today it forms an important part of the nation's economy and culture."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-belgian-chocolate"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Belgian_chocolate"}],"sections":[{"h":"Where it's from","links":[["Belgian cuisine","cuisine/belgian-cuisine"]]},{"h":"More from Belgian cuisine","links":[["Algérienne sauce","dish/algerienne-sauce"],["Bickyburger","dish/bickyburger"],["Boûkète","dish/boukete"],["Flemish stew","dish/flemish-stew"],["Friterie","dish/friterie"],["Liège waffle","dish/liege-waffle"],["Moules-frites","dish/moules-frites"],["Paling in 't groen","dish/paling-in-t-groen"],["Samurai sauce","dish/samurai-sauce"],["Speculoos","dish/speculoos"],["Steak tartare","dish/steak-tartare"],["Waterzooi","dish/waterzooi"]]}],"img":{"src":"/world-cuisine/img/thumb/8/86/Schokolade-weiss.jpg/500px-Schokolade-weiss.jpg","w":500,"h":228,"by":"Simon A. Eugster","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Schokolade-weiss.jpg"}},"ingredient/fried-chicken":{"t":"ingredient","r":"ingredient/fried-chicken","n":"Fried chicken","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 3 cuisines","intro":[["Fried chicken, more formally known as Southern fried chicken, is a dish consisting of chicken pieces,"]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-fried-chicken"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fried_chicken"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Tumpeng","dish/tumpeng"]]],["Taiwan cuisine","cuisine/taiwan-cuisine",[["Taiwanese fried chicken cutlet","dish/taiwanese-fried-chicken-cutlet"]]],["Yoshoku","cuisine/yoshoku",[["Chicken katsu","dish/chicken-katsu"]]]]},{"h":"Often cooked with","links":[["Chicken","ingredient/chicken"],["Japanese rice","ingredient/japanese-rice"],["Panko","ingredient/panko"],["Anchovy","ingredient/anchovy"],["Egg","ingredient/egg"],["Rice","ingredient/rice"],["Tempeh","ingredient/tempeh"],["Urab","ingredient/urab"]]}],"img":{"src":"/world-cuisine/img/thumb/2/2c/Fried-Chicken-Set.jpg/500px-Fried-Chicken-Set.jpg","w":500,"h":346,"by":"Evan-Amos","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Fried-Chicken-Set.jpg"}},"ingredient/rice-cake":{"t":"ingredient","r":"ingredient/rice-cake","n":"Rice cake","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 1 cuisine","intro":[["A rice cake may be any kind of food item made from rice that has been shaped, condensed, or otherwise combined into a single object. A wide variety of rice cakes exist in many different cultures in which rice is eaten. Common variations include cakes made with rice flour, those made from ground rice, and those made from whole grains of rice compressed together or combined with some other binding substance."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-rice-cake"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rice_cake"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Gado-gado","dish/gado-gado"],["Ketoprak (dish)","dish/ketoprak-dish"],["Klepon","dish/klepon"]]]]},{"h":"Often cooked with","links":[["Cucumber","ingredient/cucumber"],["Krupuk","ingredient/krupuk"],["Lontong","ingredient/lontong"],["Palm sugar","ingredient/palm-sugar"],["Peanut sauce","ingredient/peanut-sauce"],["Tofu","ingredient/tofu"],["Egg","ingredient/egg"],["Ghost pepper","ingredient/ghost-pepper"],["Ipomoea aquatica","ingredient/ipomoea-aquatica"],["Rice","ingredient/rice"],["Seedling","ingredient/seedling"],["Tamarind","ingredient/tamarind"],["Tempeh","ingredient/tempeh"],["Bean sprouts","ingredient/bean-sprouts"],["Kecap manis","ingredient/kecap-manis"],["Ketupat","ingredient/ketupat"]]}],"img":{"src":"/world-cuisine/img/thumb/9/98/Pink_seolgitteok_cake.jpg/500px-Pink_seolgitteok_cake.jpg","w":500,"h":750,"by":"Hyeon-Jeong Suk","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Pink_seolgitteok_cake.jpg"}},"dish/hodu-gwaja":{"t":"dish","r":"dish/hodu-gwaja","n":"Hodu-gwaja","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from South Korean cuisine","dot":"#f0b340","intro":[["Hodu-gwaja, commonly translated as walnut cookies, walnut cakes, and walnut pastries, is a type of cookie originated from Cheonan, South Korea. It is also known by the name hodo-gwaja (호도과자; which is not the Standard Korean spelling but the name used by Hakhwa walnut cookies, the company that first produced the confection) in and outside Korea."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-hodu-gwaja"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hodu-gwaja"}],"sections":[{"h":"Where it's from","links":[["South Korean cuisine","cuisine/south-korean-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Red bean paste","ingredient/red-bean-paste"],["Walnut","ingredient/walnut"]]},{"h":"Cook it","rows":[{"name":"Korean Bapsang","color":"#55b8ad","shape":"site","sub":"koreanbapsang.com","note":"Home-style Korean recipes from Hyosun, a Korean-American mom.","url":"https://www.koreanbapsang.com/category/recipes/","suggested":true,"kind":"blog"}]},{"h":"More from South Korean cuisine","links":[["Chalbori-ppang","dish/chalbori-ppang"],["Chimaek","dish/chimaek"],["Croffle","dish/croffle"],["Dak-galbi","dish/dak-galbi"],["Gilgeori toast","dish/gilgeori-toast"],["Hwangnam-ppang","dish/hwangnam-ppang"],["Jinju bibimbap","dish/jinju-bibimbap"],["Jjolmyeon","dish/jjolmyeon"],["Kkulppang","dish/kkulppang"],["Milmyeon","dish/milmyeon"],["Rabokki","dish/rabokki"],["Ramyeon","dish/ramyeon"],["So-tteok-so-tteok","dish/so-tteok-so-tteok"],["Tornado potato","dish/tornado-potato"],["Ttongppang","dish/ttongppang"],["Yangnyeom chicken","dish/yangnyeom-chicken"]]}],"img":{"src":"/world-cuisine/img/thumb/4/4a/Hodugwaja.jpg/500px-Hodugwaja.jpg","w":500,"h":323,"by":"parkyang1021","lic":"CC BY 2.0 kr","licUrl":"https://creativecommons.org/licenses/by/2.0/kr/deed.en","page":"https://commons.wikimedia.org/wiki/File:Hodugwaja.jpg"}},"dish/parrot-pie":{"t":"dish","r":"dish/parrot-pie","n":"Parrot pie","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Australian cuisine","dot":"#55b8ad","intro":[["Parrot pie is a dish that was eaten in Australia into the early 20th century."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-parrot-pie"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Parrot_pie"}],"sections":[{"h":"Where it's from","links":[["Australian cuisine","cuisine/australian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Bird meat","ingredient/bird-meat"],["Parrot","ingredient/parrot"]]},{"h":"Cook it","rows":[{"name":"Belly Rumbles: Australian Recipes","color":"#55b8ad","shape":"site","sub":"bellyrumbles.com","note":"Sara McCleary's collection of Australian classics such as Anzac biscuits, pavlova, sausage rolls and native-ingredient bakes.","url":"https://bellyrumbles.com/category/australian-recipes/","suggested":true,"kind":"blog"},{"name":"RecipeTin Eats","color":"#55b8ad","shape":"site","sub":"recipetineats.com","note":"Sydney-based Nagi Maehashi's widely used recipe site; broad in scope, but a staple of Australian home cooking.","url":"https://www.recipetineats.com/home/","suggested":true,"kind":"blog"}]},{"h":"More from Australian cuisine","links":[["Anzac biscuit","dish/anzac-biscuit"],["Fish and chips","dish/fish-and-chips"],["Flake (fish)","dish/flake-fish"],["Kangaroo meat","dish/kangaroo-meat"],["Pavlova","dish/pavlova"],["Sausage sizzle","dish/sausage-sizzle"],["Steak and eggs","dish/steak-and-eggs"],["Zucchini slice","dish/zucchini-slice"]]}],"img":{"src":"/world-cuisine/img/4/44/Mrs._Beeton%27s_parrot_pie_%28cropped%29.jpg","w":500,"h":367,"by":"Isabella Beeton","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Mrs._Beeton's_parrot_pie_(cropped).jpg"}},"dish/takoyaki":{"t":"dish","r":"dish/takoyaki","n":"Takoyaki","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Takoyaki is a ball-shaped Japanese snack made of a wheat flour–based batter and cooked in a special molded pan. It is typically filled with minced or diced octopus (tako), tempura scraps (tenkasu), pickled ginger (beni shoga), and green onion (negi). The balls are brushed with takoyaki sauce and mayonnaise, and then sprinkled with green laver (aonori) and shavings of dried bonito (katsuobushi)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-takoyaki"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Takoyaki"}],"sections":[{"h":"Where it's from","links":[["Japanese cuisine","cuisine/japanese-cuisine"]]},{"h":"Ingredients","count":13,"links":[["Allium fistulosum","ingredient/allium-fistulosum"],["Batter (cooking)","ingredient/batter-cooking"],["Beni shoga","ingredient/beni-shoga"],["Beni shōga","ingredient/beni-shoga"],["Egg","ingredient/egg"],["Green laver","ingredient/green-laver"],["Katsuobushi","ingredient/katsuobushi"],["Mayonnaise","ingredient/mayonnaise"],["Octopus","ingredient/octopus"],["Octopus as food","ingredient/octopus-as-food"],["Tempura","ingredient/tempura"],["Welsh onion","ingredient/welsh-onion"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Just One Cookbook","color":"#55b8ad","shape":"site","sub":"justonecookbook.com","note":"Namiko Chen's long-running blog and videos on Japanese home cooking.","url":"https://justonecookbook.com","suggested":true,"kind":"blog"},{"name":"RecipeTin Japan","color":"#55b8ad","shape":"site","sub":"japan.recipetineats.com","note":"Japanese home recipes from Yumiko, a Japan-born cook, sister site to RecipeTin Eats.","url":"https://japan.recipetineats.com/","suggested":true,"kind":"blog"}]},{"h":"More from Japanese cuisine","links":[["Bergh–Stoutenburgh House","dish/bergh-stoutenburgh-house"],["Chikuwa","dish/chikuwa"],["Curry bread","dish/curry-bread"],["Donburi","dish/donburi"],["Fukamushicha","dish/fukamushicha"],["Gyokuro","dish/gyokuro"],["Hitsumabushi","dish/hitsumabushi"],["Horumonyaki","dish/horumonyaki"],["Iekei ramen","dish/iekei-ramen"],["Inago no tsukudani","dish/inago-no-tsukudani"],["Itamae","dish/itamae"],["Izakaya","dish/izakaya"],["Japanese cheesecake","dish/japanese-cheesecake"],["Japanese noodles","dish/japanese-noodles"],["Japanese restaurant","dish/japanese-restaurant"],["Japanese tea","dish/japanese-tea"],["Jingisukan","dish/jingisukan"],["Kaki furai","dish/kaki-furai"],["Kamaboko","dish/kamaboko"],["Kōji (food)","dish/koji-food"],["Kusa mochi","dish/kusa-mochi"],["Kushikatsu","dish/kushikatsu"],["List of Japanese restaurants","dish/list-of-japanese-restaurants"],["Makizushi","dish/makizushi"],["Miso","dish/miso"],["Miso soup","dish/miso-soup"],["Monjayaki","dish/monjayaki"],["Nikujaga","dish/nikujaga"],["Nimono","dish/nimono"],["Oden","dish/oden"],["Onigiri","dish/onigiri"],["Osechi","dish/osechi"],["Oyakodon","dish/oyakodon"],["Rainbow roll","dish/rainbow-roll"],["Ramen","dish/ramen"],["Ryōtei","dish/ryotei"],["Sashimi","dish/sashimi"],["Sencha","dish/sencha"],["Shizuoka oden","dish/shizuoka-oden"],["Sumiso","dish/sumiso"]]}],"img":{"src":"/world-cuisine/img/thumb/d/d8/Takoyaki_by_yomi955.jpg/500px-Takoyaki_by_yomi955.jpg","w":500,"h":375,"by":"heiwa4126","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Takoyaki_by_yomi955.jpg"}},"dish/akutaq":{"t":"dish","r":"dish/akutaq","n":"Akutaq","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 4 cuisines","dot":"#94bd5c","intro":[["Akutaq, a Yup'ik word for \"mixed together,\" is fat whipped by hand until it's light and creamy, then folded with berries, and sometimes fish or meat. What goes in depends on the place and the season: ",["Seal oil","ingredient/seal-oil"]," and sea mammal fat on the coast, ",["Caribou","ingredient/reindeer"]," or ",["Moose","ingredient/moose"]," fat inland. It's made for gatherings, potlatches and holidays."]],"src":"note","sources":[{"name":"Alaska Native Tribal Health Consortium, Nellie's Recipes","url":"https://anthc.org/wp-content/uploads/2024/11/Nellie-final-2024.pdf"}],"actions":[{"kind":"globe","hash":"dish-akutaq"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Akutaq"}],"sections":[{"h":"Where it's from","links":[["Yup'ik cuisine","cuisine/yup-ik-cuisine"],["Iñupiaq foodways","cuisine/inupiaq-foodways"],["Athabascan foodways","cuisine/athabascan-foodways"],["Alaska Native foodways","cuisine/alaska-native-foodways"]]},{"h":"Ingredients","count":4,"links":[["Animal fats and oils","ingredient/animal-fats-and-oils"],["Berry","ingredient/berry"],["Seal oil","ingredient/seal-oil"],["Whitefish","ingredient/whitefish"]]},{"h":"Cook it","rows":[{"name":"ANTHC healthy recipes","color":"#55b8ad","shape":"site","sub":"anthc.org","note":"Recipe cards from the Alaska Native Tribal Health Consortium, like seal posole.","url":"https://anthc.org/wp-content/uploads/2020/10/Recipe_Seal-Posole.pdf","suggested":true},{"name":"USDA FDPIR recipes and cookbooks","color":"#55b8ad","shape":"site","sub":"fna.usda.gov","note":"Tribal cookbooks and Indigenous chefs' recipes gathered by the USDA.","url":"https://www.fna.usda.gov/fdpir/sharing-gallery/recipes-cookbooks","suggested":true},{"name":"NĀTIFS Indigenous Food Sovereignty recipes","color":"#55b8ad","shape":"site","sub":"natifs.org","note":"Recipes and videos from the Indigenous Food Lab and partner Indigenous chefs.","url":"https://natifs.org/indigenous-food-sovereignty-initiative-usda-fdpir/","suggested":true}]}],"img":{"src":"/world-cuisine/img/thumb/a/a8/Iced_Akutaq.jpg/500px-Iced_Akutaq.jpg","w":500,"h":375,"by":"Matyáš Havel","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Iced_Akutaq.jpg"}}}