fada rice","dish/ofada-rice"],["Palm nut soup","dish/palm-nut-soup"],["Sinasir","dish/sinasir"],["Suya","dish/suya"]]}]},"ingredient/suan-cai":{"t":"ingredient","r":"ingredient/suan-cai","n":"Suan cai","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Suancai is traditional Chinese pickles made from Chinese cabbage (napa cabbage) or Chinese mustard. Suancai is a unique form of paocai, due to the ingredients used and the method of production."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-suan-cai"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Suan_cai"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Sichuan cuisine","cuisine/sichuan-cuisine",[["Fish with pickled mustard greens","dish/fish-with-pickled-mustard-greens"]]]]}]},"dish/joelia":{"t":"dish","r":"dish/joelia","n":"Joelia","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Joelia is a restaurant in Rotterdam, Netherlands. The restaurant received a Michelin star in 2016. The Dutch royal couple Willem-Alexander of the Netherlands and Queen Máxima of the Netherlands celebrated their fifteenth wedding anniversary in Joelia. During the corona pandemic, the restaurant devised a way to welcome diners despite the new corona rules for restaurants and cafes. For a tenner extra, they were registered as hotel guests of the Hilton Hotel located above. Guests could enter the one-star restaurant through the hotel lobby. It caused many negative reactions. It was then decided to keep the restaurant's doors closed for the next four weeks anyway. This decision was taken in consultation with the municipality of Rotterdam."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-joelia"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Joelia"}],"sections":[{"h":"Where it's from","links":[["French cuisine","cuisine/french-cuisine"],["New Caledonian cuisine","cuisine/