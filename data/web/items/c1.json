ipes-com","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Long-running site by German-born cook Gerhild Fulson (Oma) with traditional German home recipes.","url":"https://www.quick-german-recipes.com/about-me.html","suggested":true},{"name":"Dirndl Kitchen","ref":"site/dirndlkitchen-com","color":"#55b8ad","shape":"site","sub":"dirndlkitchen.com","note":"Blog of German and Bavarian recipes, from main dishes to holiday baking.","url":"https://dirndlkitchen.com","suggested":true},{"name":"Quick German Recipes","ref":"site/quick-german-recipes-com","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Thuringia page on German-born cook Gerhild Fulson's long-running German recipe site.","url":"https://www.quick-german-recipes.com/thuringia.html","suggested":true}]},{"h":"More from German cuisine","links":[["Baumkuchen","dish/baumkuchen"],["Berlin Inn","dish/berlin-inn"],["Bockwurst","dish/bockwurst"],["Buchteln","dish/buchteln"],["Cabbage roll","dish/cabbage-roll"],["Chrain","dish/chrain"],["Dampfnudel","dish/dampfnudel"],["Der Rheinlander","dish/der-rheinlander"],["Eel soup","dish/eel-soup"],["Egg puffs and soup pearls","dish/egg-puffs-and-soup-pearls"],["Eintopf","dish/eintopf"],["Flammekueche","dish/flammekueche"],["Gugelhupf","dish/gugelhupf"],["Hamburg steak","dish/hamburg-steak"],["Hedgehog slice","dish/hedgehog-slice"],["Herman ze German","dish/herman-ze-german"],["Horcher (restaurant)","dish/horcher-restaurant"],["Kringle","dish/kringle"],["Labskaus","dish/labskaus"],["Landjäger","dish/landjager"],["Leberkäse","dish/leberkase"],["Mett","dish/mett"],["Mock turtle soup","dish/mock-turtle-soup"],["Potato pancake","dish/potato-pancake"],["Potato salad","dish/potato-salad"],["Rødgrød","dish/r-dgr-d"],["Sauerkraut","dish/sauerkraut"],["Spaghettieis","dish/spaghettieis"],["Speckkuchen","dish/speckkuchen"],["Spundekäs","dish/spundekas"],["Steckerlfisch","dish/steckerlfisch"],["Stippgrütze","dish/stippgrutze"],["Stollen","dish/stollen"],["Streuselkuchen","dish/streuselkuchen"],["Strudel","dish/strudel"],["The Student Prince (restaurant)","dish/the-student-prince-restaurant"],["Westfälische Rinderwurst","dish/westfalische-rinderwurst"],["Zopf","dish/zopf"],["Zum Zum","dish/zum-zum"]]}]},"dish/sm-rrebr-d":{"t":"dish","r":"dish/sm-rrebr-d","n":"Smørrebrød","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Danish cuisine","dot":"#cf5f87","intro":[["Smørrebrød, smørbrød \"butter bread\" (Norwegian), or smörgås [ˈsmœrˌɡoːs] \"butter goose\" (Swedish), is a traditional open-faced sandwich in the cuisines of Denmark, Norway and Sweden that usually consists of a piece of buttered rugbrød (a dense, dark rye bread) topped with commercial or homemade cold cuts, pieces of meat or fish, cheese or spreads, and garnishes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-sm-rrebr-d"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sm%C3%B8rrebr%C3%B8d"}],"sections":[{"h":"Where it's from","links":[["Danish cuisine","cuisine/danish-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Butter","ingredient/butter"],["Cheese","ingredient/cheese"],["Cold cut","ingredient/cold-cut"],["Garnish (cooking)","ingredient/garnish-cooking"],["Lunch meat","ingredient/lunch-meat"],["Rugbrød","ingredient/rugbr-d"],["Spread","ingredient/spread"]]},{"h":"More from Danish cuisine","links":[["Æbleflæsk","dish/blefl-sk"],["Æbleskiver","dish/bleskiver"],["Danish pastry","dish/danish-pastry"],["Glögg","dish/glogg"],["Hvidsten Inn","dish/hvidsten-inn"],["Kokkeriet","dish/kokkeriet"],["Kransekage","dish/kransekage"],["Kringle","dish/kringle"],["Labskaus","dish/labskaus"],["Risalamande","dish/risalamande"],["Rødgrød","dish/r-dgr-d"]]}]},"ingredient/tagliatelle":{"t":"ingredient","r":"ingredient/tagliatelle","n":"Tagliatelle","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Tagliatelle are a traditional type of pasta from the Italian regions of Emilia-Romagna and Marche. Individual pieces of tagliatelle are long, flat ribbons that are similar in shape to fettuccine and are traditionally about 6 mm (1⁄4 in) wide. Tagliatelle can be served with a variety of sauces, though the classic is a meat sauce or Bolognese sauce."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tagliatelle"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tagliatelle"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Basilicatan (Lucanian) cuisine","cuisine/cuisine-of-basilicata",[["Tumact me tulez","dish/tumact-me-tulez"]]]]},{"h":"Often cooked with","links":[["Anchovies as food","ingredient/anchovies-as-food"],["Breadcrumbs","ingredient/breadcrumbs"],["Pasta","ingredient/pasta"],["Tomato","ingredient/tomato"],["Walnut","ingredient/walnut"]]}]},"site/chileanfoodandgarden-com":{"t":"site","r":"site/chileanfoodandgarden-com","n":"Pilar's Chilean Food & Garden","c":"#55b8ad","crumb":[["Recipe sites","sites"]],"sub":"Recipe site, chileanfoodandgarden.com","square":true,"suggested":true,"intro":[["Chilean home cooking blog by Pilar Hernández."]],"actions":[{"kind":"out","url":"https://chileanfoodandgarden.com","label":"Visit chileanfoodandgarden.com"}],"sections":[{"h":"Cuisines it covers","count":1,"rows":[{"name":"Chilean cuisine","ref":"cuisine/chilean-cuisine","color":"#94bd5c","shape":"cuisine","sub":"Pilar's Chilean Food & Garden","url":"https://www.chileanfoodandgarden.com/?p=37406"}]}]},"site/saintcooks-com":{"t":"site","r":"site/saintcooks-com","n":"The Saint Cooks","c":"#55b8ad","crumb":[["Recipe sites","sites"]],"sub":"Recipe site, saintcooks.com","square":true,"suggested":true,"intro":[["St Helena island recipes such as plo and fishcakes from Robin and Emma-Jane, who are writing a St Helena cookbook."]],"actions":[{"kind":"out","url":"https://saintcooks.com","label":"Visit saintcooks.com"}],"sections":[{"h":"Cuisines it covers","count":1,"rows":[{"name":"Saint Helenian cuisine","ref":"cuisin