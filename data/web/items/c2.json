ish/lo-mai-chi"],["Mao xue wang","dish/mao-xue-wang"],["Mapo tofu","dish/mapo-tofu"],["Mianwo","dish/mianwo"],["Miso soup","dish/miso-soup"],["Orange cuttlefish","dish/orange-cuttlefish"],["Osmanthus cake","dish/osmanthus-cake"],["Pickled egg","dish/pickled-egg"],["Pilaf","dish/pilaf"]]}],"img":{"src":"/labs/cuisines/img/thumb/d/dd/Arranged_century_egg_on_a_plate.jpg/500px-Arranged_century_egg_on_a_plate.jpg","w":500,"h":375,"by":"irrational_cat","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Arranged_century_egg_on_a_plate.jpg"}},"ingredient/mala":{"t":"ingredient","r":"ingredient/mala","n":"Mala","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Mala is a numbing and pungent seasoning derived from Sichuan peppercorn and chili. Most commonly, mala is made into a sauce by simmering it in oil and other spices.  Characteristic of Sichuan cuisine, particularly Chongqing cuisine, it has become one of the most popular and synthesized ingredients in Chinese cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-mala"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mala_(seasoning)"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Chinese cuisine","cuisine/chinese-cuisine",[["Dandan noodles","dish/dandan-noodles"]]]]},{"h":"Often cooked with","links":[["Chili oil","ingredient/chili-oil"],["Chili pepper","ingredient/chili-pepper"],["Chinese noodles","ingredient/chinese-noodles"],["Coriander","ingredient/coriander"],["Noodles","ingredient/noodles"],["Sesame","ingredient/sesame"]]}],"img":{"src":"/labs/cuisines/img/thumb/f/f2/JiaoMaJi.png/500px-JiaoMaJi.png","w":500,"h":473,"by":"Bigvocab","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:JiaoMaJi.png"}},"ingredient/thua-nao":{"t":"ingredient","r":"ingredient/thua-nao","n":"Thua nao","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Thua nao, also known as pè bok (Burmese: ပဲပုပ်; lit. 'rotten beans'), is a fermented soybean product used in Burmese and Thai cuisine, particularly by the Shan, Tai Lue, and Northern Thai peoples as a cooking ingredient or condiment. Thua nao is created by fermenting cooked soybeans with naturally occurring microbes."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-thua-nao"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Thua_nao"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Thai cuisine","cuisine/thai-cuisine",[["Nam ngiao","dish/nam-ngiao"]]]]},{"h":"Often cooked with","links":[["Galangal","ingredient/galangal"],["Khanom chin","ingredient/khanom-chin"],["Pork","ingredient/pork"]]}],"img":{"src":"/labs/cuisines/img/thumb/4/45/2017_0419_Thanin_market_tua_nao.jpg/500px-2017_0419_Thanin_market_tua_nao.jpg","w":500,"h":500,"by":"Takeaway","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:2017_0419_Thanin_market_tua_nao.jpg"}},"dish/nasi-kerabu":{"t":"dish","r":"dish/nasi-kerabu","n":"Nasi kerabu","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Malay cuisine","dot":"#f0b340","intro":[["Nasi kerabu is a type of nasi ulam in essence a Malay rice dish in which rice naturally coloured with butterfly pea flowers (Clitoria ternatea) served with sides of dried fish or fried chicken, stuffed peppers (solok lada), fried crackers and other herbs and greens; all of these side dishes often times mixed akin to a salad before eaten. The blue rice can also be plain white rice or rice cooked using turmeric."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-nasi-kerabu"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Nasi_kerabu"}],"sections":[{"h":"Where it's from","links":[["Malay cuisine","cuisine/malay-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Budu (sauce)","ingredient/budu-sauce"],["Clitoria ternatea","ingredient/clitoria-ternatea"],["Coconut","ingredient/coconut"],["Fish","ingredient/fish"],["Rice","ingredient/rice"],["Sambal","ingredient/sambal"],["Turmeric","ingredient/turmeric"]]},{"h":"More from Malay cuisine","links":[["Akok (food)","dish/akok-food"],["Ikan bakar","dish/ikan-bakar"],["Karas (food)","dish/karas-food"],["Ketupat","dish/ketupat"],["Lekor","dish/lekor"],["Mee siput","dish/mee-siput"],["Nasi Ayam","dish/nasi-ayam"],["Nasi tumpang","dish/nasi-tumpang"],["Roti jala","dish/roti-jala"],["Sata (food)","dish/sata-food"],["Tahu goreng","dish/tahu-goreng"],["Ulam (salad)","dish/ulam-salad"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e9/Nasi_kerabu.jpg/500px-Nasi_kerabu.jpg","w":500,"h":336,"by":"amrufm from Shah Alam, Malaysia","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Nasi_kerabu.jpg"}},"dish/udon":{"t":"dish","r":"dish/udon","n":"Udon","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Udon is a thick noodle made from wheat flour, used in Japanese cuisine. There are a variety of ways it is prepared and served. Its simplest form is in a soup as kake udon with a mild broth called kakejiru made from dashi, soy sauce, and mirin. It is usually topped with thinly chopped scallions. Other common toppings include prawn tempura, kakiage (mixed tempura fritter), abura-age (sweet, deep-fried tofu pouches), kamaboko (sliced fish cake), and shichimi spice added to taste."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-udon"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Udon"}],"sections":[{"h":"Where it's from","links":[["Japanese cuisine","cuisine/japanese-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Just One Cookbook","color":"#