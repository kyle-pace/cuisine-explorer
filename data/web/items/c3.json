,["Panna cotta","dish/panna-cotta"],["Passatelli","dish/passatelli"],["Pecorino","dish/pecorino"]]}]},"ingredient/ver-jus":{"t":"ingredient","r":"ingredient/ver-jus","n":"Ver jus","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Verjuice is a highly acidic juice made by pressing unripe grapes, crab-apples or other sour fruit. Sometimes lemon or sorrel juice, herbs or spices are added to change the flavor. It also goes by the name verjus."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-ver-jus"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ver_jus"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Iranian cuisine","cuisine/iranian-cuisine",[["Khoresh karafs","dish/khoresh-karafs"]]]]},{"h":"Often cooked with","links":[["Celery","ingredient/celery"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/8a/Fabrication_du_verjus_BnF_Latin_9333_fol._83.jpg/500px-Fabrication_du_verjus_BnF_Latin_9333_fol._83.jpg","w":500,"h":571,"by":"The original uploader was BorgQueen at English Wikipedia.","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Fabrication_du_verjus_BnF_Latin_9333_fol._83.jpg"}},"dish/lavash":{"t":"dish","r":"dish/lavash","n":"Lavash","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Armenian cuisine","dot":"#f0b340","intro":[["Lavash is a thin flatbread made of leavened or unleavened wheat dough, baked in a tandoor (a type of clay oven) or on a saj griddle. Some forms are sourdough fermented with dough from previous batches. Lavash cooks very quickly in a tandoor, being placed on the sides using a cushion. It is large and thin, though there are many variations in size and shape. It is soft when fresh but is often dried. Lavash is common to the cuisines of South Caucasus and West Asia. It is a staple food in Armenia, eastern Georgia, and parts of Iran."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-lavash"},{"k