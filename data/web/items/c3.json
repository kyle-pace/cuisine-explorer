t":"#cf5f87","intro":[["Hvidsten Inn is a historic, listed inn, formerly a coaching inn located in Hvidsten between Randers and Mariager."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-hvidsten-inn"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hvidsten_Inn"}],"sections":[{"h":"Where it's from","links":[["Danish cuisine","cuisine/danish-cuisine"]]},{"h":"More from Danish cuisine","links":[["Æbleflæsk","dish/blefl-sk"],["Æbleskiver","dish/bleskiver"],["Danish pastry","dish/danish-pastry"],["Glögg","dish/glogg"],["Kokkeriet","dish/kokkeriet"],["Kransekage","dish/kransekage"],["Kringle","dish/kringle"],["Labskaus","dish/labskaus"],["Risalamande","dish/risalamande"],["Rødgrød","dish/r-dgr-d"],["Smørrebrød","dish/sm-rrebr-d"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/05/Hvidsten-kro-2002.jpg/500px-Hvidsten-kro-2002.jpg","w":500,"h":379,"by":"Hansjorn at the Danish language Wikipedia","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Hvidsten-kro-2002.jpg"}},"ingredient/ver-jus":{"t":"ingredient","r":"ingredient/ver-jus","n":"Ver jus","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Verjuice is a highly acidic juice made by pressing unripe grapes, crab-apples or other sour fruit. Sometimes lemon or sorrel juice, herbs or spices are added to change the flavor. It also goes by the name verjus."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-ver-jus"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ver_jus"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Iranian cuisine","cuisine/iranian-cuisine",[["Khoresh karafs","dish/khoresh-karafs"]]]]},{"h":"Often cooked with","links":[["Celery","ingredient/celery"]]}],"img":{"src":"/labs/cuisines/img/thumb/8/8a/Fabrication_du_verjus_BnF_Latin_9333_fol._83.jpg/500px-Fabrication_du_verjus_BnF_Latin_9333_fol._83.jpg","w":500,"h":571,"by":"The original uploader was BorgQueen at English Wikipedia.","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Fabrication_du_verjus_BnF_Latin_9333_fol._83.jpg"}},"dish/lavash":{"t":"dish","r":"dish/lavash","n":"Lavash","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Armenian cuisine","dot":"#f0b340","intro":[["Lavash is a thin flatbread made of leavened or unleavened wheat dough, baked in a tandoor (a type of clay oven) or on a saj griddle. Some forms are sourdough fermented with dough from previous batches. Lavash cooks very quickly in a tandoor, being placed on the sides using a cushion. It is large and thin, though there are many variations in size and shape. It is soft when fresh but is often dried. Lavash is common to the cuisines of South Caucasus and West Asia. It is a staple food in Armenia, eastern Georgia, and parts of Iran."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-lavash"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lavash"}],"sections":[{"h":"Where it's from","links":[["Armenian cuisine","cuisine/armenian-cuisine"]]},{"h":"Cook it","rows":[{"name":"The Armenian Kitchen","ref":"site/thearmeniankitchen-com","color":"#55b8ad","shape":"site","sub":"thearmeniankitchen.com","note":"Armenian-American blog of family recipes and reviews of Armenian cookbooks.","url":"https://www.thearmeniankitchen.com/classic-armenian-recipes-another/","suggested":true,"kind":"blog"}]},{"h":"More from Armenian cuisine","links":[["Alani (dried fruit)","dish/alani-dried-fruit"],["Baba ghanoush","dish/baba-ghanoush"],["Bagharj","dish/bagharj"],["Cabbage roll","dish/cabbage-roll"],["İmam bayıldı","dish/imam-bay-ld"],["Khash (dish)","dish/khash-dish"],["Khorovats","dish/khorovats"],["Matnakash","dish/matnakash"],["Mikado cake","dish/mikado-cake"],["Pilaf","dish/pilaf"],["Pirozhki","dish/pirozhki"],["Spas (soup)","dish/spas-soup"],["Tjvjik (food)","dish/tjvjik-food"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b9/Pan_armenio_en_el_mercado_de_Yerevan.JPG/500px-Pan_armenio_en_el_mercado_de_Yerevan.JPG","w":500,"h":375,"by":"Wiquijote","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Pan_armenio_en_el_mercado_de_Yerevan.JPG"}},"dish/phnom-penh-noodle-house":{"t":"dish","r":"dish/phnom-penh-noodle-house","n":"Phnom Penh Noodle House","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Cambodian cuisine","dot":"#f0b340","intro":[["Phnom Penh Noodle House is a Cambodian restaurant in Seattle, in the U.S. state of Washington."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-phnom-penh-noodle-house"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Phnom_Penh_Noodle_House"}],"sections":[{"h":"Where it's from","links":[["Cambodian cuisine","cuisine/cambodian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Chef Nak","ref":"site/chefnak-com","color":"#55b8ad","shape":"site","sub":"chefnak.com","note":"Site of Cambodian chef and cookbook author Chef Nak, with notes on Khmer cookbooks.","url":"https://www.chefnak.com/nhum","suggested":true,"kind":"site"}]},{"h":"More from Cambodian cuisine","links":[["Cha kroeung","dish/cha-kroeung"],["Chha kh'nhei","dish/chha-kh-nhei"],["Grilled honeycomb","dish/grilled-honeycomb"],["Kampot pepper crab","dish/kampot-pepper-crab"],["Thali","dish/thali"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/9c/October_2023%2C_Seattle%2C_Washington%2C_US_-_65.jpg/500px-October_2023%2C_Seattle%2C_Washington%2C_US_-_65.jpg","w":500,"h":375,"by":"Another Believer","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:October_2023%2C_Seattle%2C_Washington%2C_US_-_65.jpg"}},"dish/picatostes":{"t":"dish","r":"dish/picatostes","n":"Picatostes","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Spanish cuisine","dot":"#cf5f87","intro":[["Picatostes are slices of fried bread, from loaves fried with lard or olive oil. They are typical of Madrid, Spain. They are usually sweetened with granules of refined sugar on the outside. They are most commonly eaten for breakfast or a quick lunch (merienda), accompanied by coffee. They are also sometimes eaten as a substitute for chocolate and churros (as a late night snack). They can be eaten hot or cold. As a cheap staple food, they are also a common accompaniment to beverages in the traditional cafés of Madrid where tertulias are held."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-picatostes"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Picatostes"}],"sections":[{"h":"Where it's from","links":[["Spanish cuisine","cuisine/spanish-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Olive oil","ingredient/olive-oil"]]},{"h":"Cook it","rows":[{"name":"Spain on a Fork","ref":"site/spainonafork-com","color":"#55b8ad","shape":"site","sub":"spainonafork.com","note":"Albert Bevia's video channel and site of traditional and everyday Spanish recipes.","url":"https://spainonafork.com/welcome2/","suggested":true,"kind":"youtube"}]},{"h":"More from Spanish cuisine","links":[["Andrajos","dish/andrajos"],["Ataula","dish/ataula"],["Bolinhos de bacalhau","dish/bolinhos-de-bacalhau"],["Buñuelo","dish/bunuelo"],["Caldo galego","dish/caldo-galego"],["Chistorra","dish/chistorra"],["Churro","dish/churro"],["Cocido","dish/cocido"],["Cuajada","dish/cuajada"],["El Quijote (restaurant)","dish/el-quijote-restaurant"],["El Willy","dish/el-willy"],["Embutido","dish/embutido"],["Esquina Común","dish/esquina-comun"],["Gazpacho","dish/gazpacho"],["Hojuela","dish/hojuela"],["Jamón","dish/jamon"],["Migas","dish/migas"],["Mojo (sauce)","dish/mojo-sauce"],["Ogasawara-Hakushaku-Tei","dish/ogasawara-hakushaku-tei"],["Patatas a lo pobre","dish/patatas-a-lo-pobre"],["Patatas bravas","dish/patatas-bravas"],["Pincho","dish/pincho"],["Pottage","dish/pottage"],["Salchichón","dish/salchichon"],["Salmorejo","dish/salmorejo"],["Sobrassada","dish/sobrassada"],["Soldaditos de Pavía","dish/