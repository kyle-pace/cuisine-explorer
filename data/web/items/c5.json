"ingredient/amaranth":{"t":"ingredient","r":"ingredient/amaranth","n":"Amaranth","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Amaranthus is a genus of plants commonly known as amaranths. Some species are known by variants of the common name \"pigweed\". Some members are annual and others are perennial. The plant can grow from 1 to 2.5 metres (3 to 8 feet) tall with a succulent, hollow stem. Parts of the plant vary from green to reddish. Catkin-like cymes of densely packed flowers grow in the summer or fall."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-amaranth"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Amaranth"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Nasi tempong","dish/nasi-tempong"]]]]},{"h":"Often cooked with","links":[["Bakwan","ingredient/bakwan"],["Bird's eye chili","ingredient/bird-s-eye-chili"],["Cosmos","ingredient/cosmos"],["Holy basil","ingredient/holy-basil"],["Ikan goreng","ingredient/ikan-goreng"],["Peanut sauce","ingredient/peanut-sauce"],["Rice","ingredient/rice"],["Tahu goreng","ingredient/tahu-goreng"],["Tomato","ingredient/tomato"]]},{"h":"Mentioned in","links":[["Quechua foodways","cuisine/quechua-foodways"]]}]},"dish/pindang":{"t":"dish","r":"dish/pindang","n":"Pindang","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Indonesian cuisine","dot":"#f0b340","intro":[["Pindang refers to a cooking method in the Indonesian and Malay language of boiling ingredients in brine or acidic solutions. Usually employed to cook fish or egg, the technique is native to Sumatra especially in Palembang, but has spread to Java and Kalimantan. The term also could refer to a specific sour and spicy fish soup which employs seasonings like tamarind. Pindang has food preservation properties, which extends the shelf life of fish products."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pindang"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pindang"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Fish","ingredient/fish"]]},{"h":"Cook it","rows":[{"name":"Daily Cooking Quest","ref":"site/dailycookingquest-com","color":"#55b8ad","shape":"site","sub":"dailycookingquest.com","note":"Indonesian home cook Anita's blog with a large archive of Indonesian recipes.","url":"https://dailycookingquest.com/cuisines/indonesian.html","suggested":true}]},{"h":"More from Indonesian cuisine","links":[["Arem-arem","dish/arem-arem"],["Arsik","dish/arsik"],["Asam pedas","dish/asam-pedas"],["Ayam goreng","dish/ayam-goreng"],["Ayam goreng kalasan","dish/ayam-goreng-kalasan"],["Ayam panggang","dish/ayam-panggang"],["Ayam Taliwang","dish/ayam-taliwang"],["Bajigur","dish/bajigur"],["Bakakak hayam","dish/bakakak-hayam"],["Bakpia","dish/bakpia"],["Bakwan","dish/bakwan"],["Bekasang","dish/bekasang"],["Betutu","dish/betutu"],["Bika ambon","dish/bika-ambon"],["Binte biluhuta","dish/binte-biluhuta"],["Bir pletok","dish/bir-pletok"],["Bolu kukus","dish/bolu-kukus"],["Botok","dish/botok"],["Brem","dish/brem"],["Bubur kacang hijau","dish/bubur-kacang-hijau"],["Bubur ketan hitam","dish/bubur-ketan-hitam"],["Bubur pedas","dish/bubur-pedas"],["Buntil","dish/buntil"],["Burgo (food)","dish/burgo-food"],["Cendol","dish/cendol"],["Cenil","dish/cenil"],["Cilok","dish/cilok"],["Cimpa","dish/cimpa"],["Corn fritter","dish/corn-fritter"],["Coto makassar","dish/coto-makassar"],["Dadar gulung","dish/dadar-gulung"],["Dadiah","dish/dadiah"],["Dengke mas naniura","dish/dengke-mas-naniura"],["Empal gentong","dish/empal-gentong"],["Emping","dish/emping"],["Es buah","dish/es-buah"],["Es doger","dish/es-doger"],["Es goyobod","dish/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}]},"ingredient/spinacia":{"t":"ingredient","r":"ingredient/spinacia","n":"Spinacia","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Spinacia is a flowering plant genus in the subfamily Chenopodioideae of the family Amaranthaceae. The most common member is spinach."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-spinacia"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Spinacia"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Georgian cuisine","cuisine/georgian-cuisine",[["Pkhali","dish/pkhali"]]]]},{"h":"Often cooked with","links":[["Beta","ingredient/beta"],["Brassica","ingredient/brassica"],["Eggplant","ingredient/eggplant"],["Garlic","ingredient/garlic"],["Juglans regia","ingredient/juglans-regia"],["Onion","ingredient/onion"],["Phaseolus","ingredient/phaseolus"],["Vinegar","ingredient/vinegar"]]}]},"dish/prego-portuguese-sandwich":{"t":"dish","r":"dish/prego-portuguese-sandwich","n":"Prego (Portuguese sandwich)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Portuguese cuisine","dot":"#cf5f87","intro":[["The prego, also known as bitoque do prego, called prego no prato when served as a dish or prego no pão when served as a sandwich, is a typical Portuguese dish. It consists of a small beef patty which is normally served as a standalone dish or a sandwich, sometimes on a bolo do caco."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-prego-portuguese-sandwich"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Prego_(Portuguese_sandwich)"}],"sections":[{"h":"Where it's from","links":[["Portuguese cuisine","cuisine/portuguese-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Beef","ingredient/beef"],["Bread roll","ingredient/bread-roll"],["Steak","ingredient/steak"],["Wine","ingredient/wine"]]},{"h":"Cook it","rows":[{"name":"Food From Portugal","ref":"site/foodfromportugal-com","color":"#55b8ad","shape":"site","sub":"foodfromportugal.com","note":"Portuguese-run recipe site and video channel of traditional Portuguese dishes.","