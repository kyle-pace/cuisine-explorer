wikimedia.org/wiki/File:Illustration_Spinacia_oleracea1.jpg"}},"dish/prego-portuguese-sandwich":{"t":"dish","r":"dish/prego-portuguese-sandwich","n":"Prego (Portuguese sandwich)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Portuguese cuisine","dot":"#cf5f87","intro":[["The prego, also known as bitoque do prego, called prego no prato when served as a dish or prego no pão when served as a sandwich, is a typical Portuguese dish. It consists of a small beef patty which is normally served as a standalone dish or a sandwich, sometimes on a bolo do caco."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-prego-portuguese-sandwich"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Prego_(Portuguese_sandwich)"}],"sections":[{"h":"Where it's from","links":[["Portuguese cuisine","cuisine/portuguese-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Beef","ingredient/beef"],["Bread roll","ingredient/bread-roll"],["Steak","ingredient/steak"],["Wine","ingredient/wine"]]},{"h":"Cook it","rows":[{"name":"Food From Portugal","color":"#55b8ad","shape":"site","sub":"foodfromportugal.com","note":"Portuguese-run recipe site and video channel of traditional Portuguese dishes.","url":"https://www.foodfromportugal.com/","suggested":true,"kind":"site"}]},{"h":"More from Portuguese cuisine","links":[["Alheira","dish/alheira"],["Amêijoas à Bulhão Pato","dish/ameijoas-a-bulhao-pato"],["Arroz de marisco","dish/arroz-de-marisco"],["Bacalhau à Brás","dish/bacalhau-a-bras"],["Bacalhau à Gomes de Sá","dish/bacalhau-a-gomes-de-sa"],["Bacalhau à minhota","dish/bacalhau-a-minhota"],["Bacalhau à Narcisa","dish/bacalhau-a-narcisa"],["Bacalhau à Zé do Pipo","dish/bacalhau-a-ze-do-pipo"],["Bacalhau com natas","dish/bacalhau-com-natas"],["Batatas a murro","dish/batatas-a-murro"],["Bolinhos de bacalhau","dish/bolinhos-de-bacalhau"],["Bolo de bolacha","dish/bolo-de-bolacha"],["Canja de galinha","dish/canja-de-galinha"],["Cocido","dish/cocido"],["Embutido","dish/embutido"],["Enc