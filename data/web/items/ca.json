h","r":"dish/maido-restaurant","n":"Maido (restaurant)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#94bd5c","intro":[["Maido  is a fusion restaurant opened in October 2009 in Miraflores, Lima, Peru. It is owned and headed by chef Mitsuharu \"Micha\" Tsumura. Maido's dishes are rooted in Nikkei cuisine, which blends Peruvian and Japanese cuisines. Maido was ranked first in the World's 50 Best Restaurants in 2025."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-maido-restaurant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Maido_(restaurant)"}],"sections":[{"h":"Where it's from","links":[["Peruvian-Japanese cuisine","cuisine/nikkei-cuisine"],["Peruvian cuisine","cuisine/peruvian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Peru Delights","ref":"site/perudelights-com","color":"#55b8ad","shape":"site","sub":"perudelights.com","note":"Morena Cuadra's blog of Peruvian home recipes and food culture.","url":"https://perudelights.com/tag/peruvian-home-cooking/","suggested":true},{"name":"Eat Peru","ref":"site/eatperu-com","color":"#55b8ad","shape":"site","sub":"eatperu.com","note":"Guide to Peruvian dishes and ingredients with a recipe section.","url":"https://www.eatperu.com/category/recipes/?sf_paged=2","suggested":true}]}],"img":{"src":"/labs/cuisines/img/thumb/6/60/Maido%2C_Lima.jpg/500px-Maido%2C_Lima.jpg","w":500,"h":750,"by":"Lindblom","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Maido%2C_Lima.jpg"}},"dish/ntolmas":{"t":"dish","r":"dish/ntolmas","n":"Ntolmás","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Dolma(literally: \"stuffed\" in Turkish) is a family of stuffed dishes largely associated with Ottoman cuisine. It mainly includes vegetables and leaves, and occasionally seafood, offal, fruits, and meats, that are hollowed out or wrapped, then filled with a mixture of rice, minced meat, herbs, and spices. The leaf-wrapped type can be specifically known as sarma, but colloquially dolma is used for both."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-ntolmas"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ntolm%C3%A1s"}],"sections":[{"h":"Where it's from","links":[["Palestinian cuisine","cuisine/palestinian-cuisine"],["Turkish cuisine","cuisine/turkish-cuisine"]]},{"h":"Cook it","rows":[{"name":"Ozlem's Turkish Table","ref":"site/ozlemsturkishtable-com","color":"#55b8ad","shape":"site","sub":"ozlemsturkishtable.com","note":"Turkish-born cook and teacher Ozlem Warren's blog of home-style Turkish recipes.","url":"https://ozlemsturkishtable.com/tag/turkish-recipes/page/9","suggested":true}]},{"h":"More from Palestinian cuisine","links":[["Jibneh Arabieh","dish/jibneh-arabieh"],["Kibbeh","dish/kibbeh"],["Maltout","dish/maltout"],["Maqluba","dish/maqluba"],["Meghli","dish/meghli"],["Musakhan","dish/musakhan"],["Qalayet bandora","dish/qalayet-bandora"],["Qatayef","dish/qatayef"],["Stuffed squash","dish/stuffed-squash"],["Stuffed turnips","dish/stuffed-turnips"],["Taboon bread","dish/taboon-bread"],["Zalabiyeh","dish/zalabiyeh"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a8/Etli_yaprak_sarma_in_Turkey.jpg/500px-Etli_yaprak_sarma_in_Turkey.jpg","w":500,"h":375,"by":"E4024","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Etli_yaprak_sarma_in_Turkey.jpg"}},"dish/olivio-restaurant":{"t":"dish","r":"dish/olivio-restaurant","n":"Olivio (restaurant)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Olivio is a defunct restaurant in Harderwijk, Netherlands. It was a fine dining restaurant that was awarded one Michelin star in 2002 and retained that rating until 2005."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-olivio-restaurant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Oli