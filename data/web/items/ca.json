thia"],["Semma (restaurant)","dish/semma-restaurant"],["Shemai","dish/shemai"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/bb/Homemade_Rabri.jpg/500px-Homemade_Rabri.jpg","w":500,"h":362,"by":"Ravi Talwar","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Homemade_Rabri.jpg"}},"ingredient/marjoram":{"t":"ingredient","r":"ingredient/marjoram","n":"Marjoram","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Marjoram (, Origanum majorana, syn. Majorana hortensis Moench) is a cold-sensitive perennial herb or undershrub with sweet pine and citrus flavours. In some Middle Eastern countries, marjoram is synonymous with oregano, and there the names sweet marjoram and knotted marjoram are used to distinguish it from other plants of the genus Origanum. It is also called pot marjoram, although this name is also used for other cultivated species of Origanum."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-marjoram"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Marjoram"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["French cuisine","cuisine/french-cuisine",[["Ratatouille","dish/ratatouille"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Ratatouille","dish/ratatouille"]]]]},{"h":"Often cooked with","links":[["Aubergine","ingredient/aubergine"],["Basil","ingredient/basil"],["Bay leaves","ingredient/bay-leaves"],["Bell pepper","ingredient/bell-pepper"],["Courgette","ingredient/courgette"],["Fennel","ingredient/fennel"],["Garlic","ingredient/garlic"],["Onion","ingredient/onion"],["Thyme","ingredient/thyme"],["Tomato","ingredient/tomato"],["Zucchini","ingredient/zucchini"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/5c/Origanum_majorana_002.JPG/500px-Origanum_majorana_002.JPG","w":500,"h":666,"by":"H. Zell","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Origanum_majorana_002.JPG"}},"dish/samurai-sauce":{"t":"dish","r":"dish/samurai-sauce","n":"Samurai sauce","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Belgian cuisine","dot":"#cf5f87","intro":[["Samurai sauce is a Belgian condiment prepared from mayonnaise, ketchup, and harissa or sambal oelek commonly served with French fries. The sauce is also popular and widely used throughout France, and is not to be confused with the also popular Algerian sauce. There is indeed a version also called Algerian sauce which is similar to Samurai sauce, but with onions. According to Harry Pearson, author of A Tall Man In A Low Land: Some Time Among the Belgians, mobile friteries in Belgium often have samurai sauce, with some making it their special item. In addition, many kebab restaurants have Samurai sauce as an available condiment."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-samurai-sauce"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Samurai_sauce"}],"sections":[{"h":"Where it's from","links":[["Belgian cuisine","cuisine/belgian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Harissa","ingredient/harissa"],["Ketchup","ingredient/ketchup"],["Mayonnaise","ingredient/mayonnaise"]]},{"h":"More from Belgian cuisine","links":[["'t Fornuis","dish/t-fornuis"],["Algérienne sauce","dish/algerienne-sauce"],["Belgian chocolate","dish/belgian-chocolate"],["Belgo","dish/belgo"],["Bickyburger","dish/bickyburger"],["Boûkète","dish/boukete"],["Flemish stew","dish/flemish-stew"],["Friterie","dish/friterie"],["Hertog Jan (restaurant)","dish/hertog-jan-restaurant"],["Hof van Cleve","dish/hof-van-cleve"],["Liège waffle","dish/liege-waffle"],["Moules-frites","dish/moules-frites"],["Paling in 't groen","dish/paling-in-t-groen"],["Speculoos","dish/speculoos"],["Steak tartare","dish/steak-tartare"],["Waterzooi","dish/waterzooi"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a8/Samurai_sauce.jpg/500px-Samurai_sauce.jpg","w":500,"h":568,"by":"Ibu","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Samurai_sauce.jpg"}},"dish/vada-pav":{"t":"dish","r":"dish/vada-pav","n":"Vada pav","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Maharashtrian cuisine","dot":"#f0b340","intro":[["Vada pav, alternatively spelt wada pao, () is a vegetarian fast food dish native to the Indian state of Maharashtra. The dish consists of a deep-fried potato dumpling placed inside a bread bun (pav) sliced almost in half through the middle. It is generally accompanied by one or more chutneys and a green chili pepper. Although it originated as an affordable street food in Mumbai, it is now served in food stalls and restaurants across India. It is also called Bombay burger in keeping with its origins and its resemblance in physical form to a burger."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-vada-pav"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Vada_pav"}],"sections":[{"h":"Where it's from","links":[["Maharashtrian cuisine","cuisine/maharashtrian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Batata vada","ingredient/batata-vada"],["Bread roll","ingredient/bread-roll"]]},{"h":"Cook it","rows":[{"name":"Shweta in the Kitchen (Maharashtrian)","ref":"site/shwetainthekitchen-com","color":"#55b8ad","shape":"site","sub":"shwetainthekitchen.com","note":"Maharashtrian section of an Indian home cooking blog.","url":"https://shwetainthekitchen.com/category/maharashtrian/","suggested":true},{"name":"Tarla Dalal (Maharashtrian)","ref":"site/tarladalal-com","color":"#55b8ad","shape":"site","sub":"tarladalal.com","note":"Maharashtrian category on Tarla Dalal's long-running recipe site.","url":"https://www.tarladalal.com/recipes/category/Maharashtrian/?page=3","suggested":true}]},{"h":"More from Maharashtrian cuisine","links":[["Pav bhaji","dish/pav-bhaji"],["Usal","dish/usal"]]}],"img":{"src":"/labs/c