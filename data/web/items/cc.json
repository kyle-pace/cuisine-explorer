o"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/7a/Various_sushi%2C_beautiful_October_night_at_midnight.jpg/500px-Various_sushi%2C_beautiful_October_night_at_midnight.jpg","w":500,"h":335,"by":"Yumi Kimura","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Various_sushi%2C_beautiful_October_night_at_midnight.jpg"}},"dish/uszka":{"t":"dish","r":"dish/uszka","n":"Uszka","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 4 cuisines","dot":"#cf5f87","intro":[["Uszka, ushka or vushka (Ukrainian: вушка [ˈwuʃkɐ]; Belarusian: вушкі [ˈvuʂkʲi]; lit. 'little ears') are small dumplings (a very small and twisted version of pierogi) usually filled with flavourful wild forest mushrooms and/or minced meat. They are usually served with borscht, though they can be eaten simply with melted butter and herbs (usually chives) sprinkled over. When vegetarian (filled only with mushrooms or onion) they are a part of traditional Christmas Eve dishes in Poland, Belarus, and western Ukraine, and are either added to the soup or eaten as a side dish."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-uszka"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Uszka"}],"sections":[{"h":"Where it's from","links":[["Lithuanian cuisine","cuisine/lithuanian-cuisine"],["Polish cuisine","cuisine/polish-cuisine"],["Russian cuisine","cuisine/russian-cuisine"],["Ukrainian cuisine","cuisine/ukrainian-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Ground meat","ingredient/ground-meat"]]},{"h":"Cook it","rows":[{"name":"Polonist","color":"#55b8ad","shape":"site","sub":"polonist.com","note":"Polish recipes and food culture from a Polish-born writer living abroad.","url":"https://www.polonist.com/about/","suggested":true,"kind":"blog"},{"name":"Polish Your Kitchen","color":"#55b8ad","shape":"site","sub":"polishyourkitchen.com","note":"Long-running blog of traditional Polish home recipes.","url":"https://polishyourkitchen.com","suggested":true,"kind":"blog"},{"name":"Olga's Flavor Factory","color":"#55b8ad","shape":"site","sub":"olgasflavorfactory.com","note":"Russian-born home cook Olga's blog, with a dedicated Russian recipes category.","url":"https://www.olgasflavorfactory.com/category/russianrecipes/","suggested":true,"kind":"blog"},{"name":"Savas Kitchen: Ukrainian recipes","color":"#55b8ad","shape":"site","sub":"savaskitchen.com","note":"Ukrainian-born home cook Nataliia Savas's section of family Ukrainian recipes.","url":"https://savaskitchen.com/category/ukrainian-recipes","suggested":true,"kind":"blog"}]},{"h":"More from Lithuanian cuisine","links":[["Aspic","dish/aspic"],["Borscht","dish/borscht"],["Cabbage roll","dish/cabbage-roll"],["Cold beet soup","dish/cold-beet-soup"],["Kasha","dish/kasha"],["Kibinai","dish/kibinai"],["Kvass","dish/kvass"],["Šakotis","dish/sakotis"],["Zrazy","dish/zrazy"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/13/Uszka-aasica.jpg/500px-Uszka-aasica.jpg","w":500,"h":375,"by":"http://en.wikipedia.org/wiki/User:Vegalabs","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Uszka-aasica.jpg"}}}