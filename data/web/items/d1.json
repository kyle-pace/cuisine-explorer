y Victor","dish/celery-victor"]]],["Cuisine of New Orleans","cuisine/cuisine-of-new-orleans",[["Red beans and rice","dish/red-beans-and-rice"]]],["German cuisine","cuisine/german-cuisine",[["Eintopf","dish/eintopf"]]],["Iranian cuisine","cuisine/iranian-cuisine",[["Khoresh karafs","dish/khoresh-karafs"]]],["Italian cuisine","cuisine/italian-cuisine",[["Coda alla vaccinara","dish/coda-alla-vaccinara"]]],["Lazian or Roman","cuisine/roman-cuisine",[["Coda alla vaccinara","dish/coda-alla-vaccinara"]]],["Louisiana Creole cuisine","cuisine/louisiana-creole-cuisine",[["Red beans and rice","dish/red-beans-and-rice"]]],["Minnesotan cuisine","cuisine/minnesotan-cuisine",[["South American (sandwich)","dish/south-american-sandwich"]]],["Palembang cuisine","cuisine/palembang-cuisine",[["Tekwan","dish/tekwan"]]],["Sephardic Jewish cuisine","cuisine/sephardic-jewish-cuisine",[["Apio (appetizer)","dish/apio-appetizer"]]],["Soul food","cuisine/soul-food",[["Red beans and rice","dish/red-beans-and-rice"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Eintopf","dish/eintopf"]]]]},{"h":"Often cooked with","links":[["Scallion","ingredient/scallion"],["Broth","ingredient/broth"],["Beef","ingredient/beef"],["Ginger","ingredient/ginger"],["Chili pepper","ingredient/chili-pepper"],["Shrimp","ingredient/shrimp"],["Mung bean sprout","ingredient/mung-bean-sprout"],["Shallot","ingredient/shallot"],["Carrot","ingredient/carrot"],["Black pepper","ingredient/black-pepper"],["Galangal","ingredient/galangal"],["Lemongrass","ingredient/lemongrass"],["Onion","ingredient/onion"],["Noodles","ingredient/noodles"],["Noodle","ingredient/noodle"],["Candlenut","ingredient/candlenut"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/0d/Celery_1.jpg/500px-Celery_1.jpg","w":500,"h":375,"by":"Lombroso","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Celery_1.jpg"}},"ingredient/channa-striata":{"t":"ingredient","r":"ingredient/channa-striata","n":"Channa striata","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Channa striata, the striped snakehead, is a species of snakehead fish. It is also known as the common snakehead, chevron snakehead, or snakehead murrel and generally referred simply as mudfish. It is native to South and Southeast Asia, and has been introduced to some Pacific Islands. Reports from Madagascar and Hawaii are misidentifications of C. maculata."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-channa-striata"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Channa_striata"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Burgo (food)","dish/burgo-food"]]]]},{"h":"Often cooked with","links":[["Candlenut","ingredient/candlenut"],["Coconut milk","ingredient/coconut-milk"],["Coriander","ingredient/coriander"],["Galangal","ingredient/galangal"],["Garlic","ingredient/garlic"],["Kencur","ingredient/kencur"],["Rice flour","ingredient/rice-flour"],["Tapioca","ingredient/tapioca"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/05/Gabus_070909_0074_rwg.jpg/500px-Gabus_070909_0074_rwg.jpg","w":500,"h":216,"by":"Wie146","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Gabus_070909_0074_rwg.jpg"}},"ingredient/red-bean-paste":{"t":"ingredient","r":"ingredient/red-bean-paste","n":"Red bean paste","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 7 dishes across 3 cuisines","intro":[["Red bean paste or red bean jam, also called adzuki bean paste or anko (a Japanese word), is a paste made of red beans (also called \"adzuki beans\"), used in East Asian cuisine. The paste is prepared by boiling the beans, then mashing or grinding them."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-red-bean-paste"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Red_bean_paste"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["South Korean cuisine","cuisine/south-korean-cuisine",[["Chalbori-ppang","dish/chalbori-ppang"],["Hodu-gwaja","dish/hodu-gwaja"],["Hwangnam-ppang","dish/hwangnam-ppang"],["Kkulppang","dish/kkulppang"],["Ttongppang","dish/ttongppang"]]],["Japanese cuisine","cuisine/japanese-cuisine",[["Kusa mochi","dish/kusa-mochi"]]],["Taiwan cuisine","cuisine/taiwan-cuisine",[["Egg yolk pastry","dish/egg-yolk-pastry"]]]]},{"h":"Often cooked with","links":[["Wheat flour","ingredient/wheat-flour"],["Egg","ingredient/egg"],["Walnut","ingredient/walnut"],["Glutinous barley","ingredient/glutinous-barley"],["Milk","ingredient/milk"],["Lard","ingredient/lard"],["Red bean","ingredient/red-bean"],["Sugar","ingredient/sugar"],["Syrup","ingredient/syrup"],["Mochi","ingredient/mochi"],["Yomogi","ingredient/yomogi"]]}],"img":{"src":"/labs/cuisines/img/thumb/3/3f/Red_bean_paste_anko.JPG/500px-Red_bean_paste_anko.JPG","w":500,"h":375,"by":"Midori","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Red_bean_paste_anko.JPG"}},"ingredient/chili-oil":{"t":"ingredient","r":"ingredient/chili-oil","n":"Chili oil","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 4 dishes across 3 cuisines","intro":[["Chili oil or chile oil is a condiment made from vegetable oil that has been infused with chili peppers. Different types of oil and hot peppers are used, and other components may also be included. It is commonly used in Chinese cuisine, Mexico, Italy, and elsewhere. It is particularly popular in Chinese cuisine, especially western Chinese cuisines, such as Sichuan cuisine, Hunan cuisine, Guizhou cuisine, and Shaanxi cuisine, where it is used as an ingredient in cooked dishes, as well as a condiment. It is sometimes used as a dip for meat and dim sum. It is also employed in the Korean Chinese noodle soup dish jjamppong. A closely related condiment in Chinese cuisine is chili crisp, which contains edible chunks of food and chilis in oil."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-chili-oil"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chili_oil"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Chinese cuisine","cuisine/chinese-cuisine",[["Dandan noodles","dish/dandan-noodles"],["Hot dry noodles","dish/hot-dry-noodles"],["Mao xue wang","dish/mao-xue-wang"]]],["Hubei cuisine","cuisine/hubei-cuisine",[["Hot dry noodles","dish/hot-dry-noodles"]]],["Sichuan cuisine","cuisine/sichuan-cuisine",[["Suan la fen","dish/suan-la-fen"]]]]},{"h":"Often cooked with","links":[["Chili pepper","ingredient/chili-pepper"],["Chinese noodles","ingredient/chinese-noodles"],["Coriander","ingredient/coriander"],["Mala","ingredient/mala"],["Noodles","ingredient/noodles"],["Sesame","ingredient/sesame"],["Alkaline noodles","ingredient/alkaline-noodles"],["Garlic","ingredient/garlic"],["Pickled carrots","ingredient/pickled-carrots"],["Sesame paste","ingredient/sesame-paste"],["Soy sauce","ingredient/soy-sauce"],["Blood curd","ingredient/blood-curd"],["Mala (seasoning)","ingredient/mala-seasoning"],["Kuanfen noodles","ingredient/kuanfen-noodles"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b8/Chilioil.jpg/500px-Chilioil.jpg","w":500,"h":375,"by":"Alpha","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Chilioil.jpg"}},"dish/eintopf":{"t":"dish","r":"dish/eintopf","n":"Eintopf","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["A stew is a combination of solid food ingredients that have been cooked in liquid and served in the resultant gravy. Ingredients can include any combination of vegetables and may include meat, especially tougher meats suitable for slow-cooking, such as beef, pork, venison, rabbit, lamb, poultry, sausages, and seafood. While water can be used as the stew-cooking liquid, stock is also common. A small amount of red wine or other alcohol is sometimes added for flavour. Seasonings and flavourings may also be added. Stews are typically cooked at a relatively low temperature (simmered, not boiled), allowing flavours to mingle."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-eintopf"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Eintopf"}],"sections":[{"h":"Where it's from","links":[["German cuisine","cuisine/german-cuisine"],["Thuringian cuisine","cuisine/german-cuisine-thuringia"]]},{"h":"Ingredients","count":10,"links":[["Bean","ingredient/bean"],["Beef","ingredient/beef"],["Beer","ingredient/beer"],["Broth","ingredient/broth"],["Carrot","ingredient/carrot"],["Celery","ingredient/celery"],["Onion","ingredient/onion"],["Parsnip","ingredient/parsnip"],["Potato","ingredient/potato"],["Wine","ingredient/wine"]]},{"h":"Cook it","rows":[{"name":"Quick German Recipes","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Long-running site by German-born cook Gerhild Fulson (Oma) with traditional German home recipes.","url":"https://www.quick-german-recipes.com/about-me.html","suggested":true,"kind":"blog"},{"name":"Dirndl Kitchen","color":"#55b8ad","shape":"site","sub":"dirndlkitchen.com","note":"Blog of German and Bavarian recipes, from main dishes to holiday baking.","url":"https://dirndlkitchen.com","suggested":true,"kind":"blog"},{"name":"Quick German Recipes","color":"#55b8ad","shape":"site","sub":"quick-german-recipes.com","note":"Thuringia page on German-born cook Gerhild Fulson's long-running German recipe site.","url":"https://www.quick-german-recipes.com/thuringia.html","suggested":true,"kind":"blog"}]},{"h":"More from German cuisine","links":[["Baumkuchen","dish/baumkuchen"],["Bockwurst","dish/bockwurst"],["Buchteln","dish/buchteln"],["Cabbage roll","dish/cabbage-roll"],["Chrain","dish/chrain"],["Dampfnudel","dish/dampfnudel"],["Eel soup","dish/eel-soup"],["Egg 