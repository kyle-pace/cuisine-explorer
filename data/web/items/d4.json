https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Dried_Meat_Yak_store%2C_Square_Street_2.JPG"}},"ingredient/fromage-frais":{"t":"ingredient","r":"ingredient/fromage-frais","n":"Fromage frais","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 4 cuisines","intro":[["Fromage blanc and fromage frais are acid-coagulated fresh cheeses originating from the north of France and southern Belgium. The name \"fromage blanc\" means \"white cheese\" in French. Fromage blanc is closely related to fromage frais (\"fresh cheese\") with the only difference being that, according to French legislation, fromage frais must contain live cultures when sold, whereas with fromage blanc, fermentation has been halted."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-fromage-frais"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fromage_frais"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["French cuisine","cuisine/french-cuisine",[["Cervelle de canut","dish/cervelle-de-canut"],["Flammekueche","dish/flammekueche"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Cervelle de canut","dish/cervelle-de-canut"],["Flammekueche","dish/flammekueche"]]],["German cuisine","cuisine/german-cuisine",[["Flammekueche","dish/flammekueche"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Flammekueche","dish/flammekueche"]]]]},{"h":"Often cooked with","links":[["Black pepper","ingredient/black-pepper"],["Olive oil","ingredient/olive-oil"],["Saveur","ingredient/saveur"],["Shallot","ingredient/shallot"],["Vinegar","ingredient/vinegar"],["Bacon","ingredient/bacon"],["Cream","ingredient/cream"],["Crème fraîche","ingredient/creme-fraiche"],["Lardon","ingredient/lardon"],["Onion","ingredient/onion"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/7e/Fromage-blanc1_cropped.jpg/500px-Fromage-blanc1_cropped.jpg","w":500,"h":333,"by":"Pancrat","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Fromage-blanc1_cropped.jpg"}},"dish/maltout":{"t":"dish","r":"dish/maltout","n":"Maltout","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Palestinian cuisine","dot":"#f0b340","intro":[["Maltout is a traditional Palestinian flatbread flavored with olive oil. Commonly associated with rural Palestinian cuisine, it is especially popular during the olive harvest season and is typically served warm for breakfast alongside za'atar, tea, or yogurt. It is traditionally prepared in a taboon oven. Its preparation is associated with communal farming traditions."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-maltout"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Maltout"}],"sections":[{"h":"Where it's from","links":[["Palestinian cuisine","cuisine/palestinian-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Extra virgin olive oil","ingredient/extra-virgin-olive-oil"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"More from Palestinian cuisine","links":[["Jibneh Arabieh","dish/jibneh-arabieh"],["Kibbeh","dish/kibbeh"],["Maqluba","dish/maqluba"],["Meghli","dish/meghli"],["Musakhan","dish/musakhan"],["Ntolmás","dish/ntolmas"],["Qalayet bandora","dish/qalayet-bandora"],["Qatayef","dish/qatayef"],["Stuffed squash","dish/stuffed-squash"],["Stuffed turnips","dish/stuffed-turnips"],["Taboon bread","dish/taboon-bread"],["Zalabiyeh","dish/zalabiyeh"]]}],"img":{"src":"/labs/cuisines/img/thumb/e/e1/%D8%AE%D8%A8%D8%B2_%D9%85%D9%84%D8%AA%D9%88%D8%AA.jpg/500px-%D8%AE%D8%A8%D8%B2_%D9%85%D9%84%D8%AA%D9%88%D8%AA.jpg","w":500,"h":591,"by":"M sh شراونة محمد","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%D8%AE%D8%A8%D8%B2_%D9%85%D9%84%D8%AA%D9%88%D8%AA.jpg"}},"dish/pizza-dolce-di-beridde":{"t":"dish","r":"dish/pizza-dolce-di-beridde","n":"Pizza dolce di Beridde","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Pizza dolce di Beridde, also known as pizza ebraica (lit. 'Hebrew pizza') or diamanti romani (lit. 'Roman diamonds'), is an unleavened sweet bread associated with the city of Rome, in the Lazio region of Italy. The Roman Jewish community prepares this traditional dessert on the occasion of a brit milah (ceremony of circumcision)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pizza-dolce-di-beridde"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pizza_dolce_di_Beridde"}],"sections":[{"h":"Where it's from","links":[["Italian cuisine","cuisine/italian-cuisine"],["Jewish cuisine","cuisine/jewish-cuisine"]]},{"h":"Ingredients","count":8,"links":[["Almond","ingredient/almond"],["Candied fruit","ingredient/candied-fruit"],["Olive oil","ingredient/olive-oil"],["Pine nut","ingredient/pine-nut"],["Raisin","ingredient/raisin"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"],["White wine","ingredient/white-wine"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","ref":"site/pastagrannies-substack-com","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's long-running video series filming Italian grandmothers making regional pasta by hand.","url":"https://pastagrannies.substack.com/p/pasta-grannies-is-now-on-substack","suggested":true,"kind":"youtube"},{"name":"Recipes from Italy","ref":"site/recipesfromitaly-com","color":"#55b8ad","shape":"site","sub":"recipesfromitaly.com","note":"Traditional Italian recipes written by Italian home cooks, organized by region and course.","url":"https://recipesfromitaly.com","suggested":true,"kind":"blog"},{"name":"Manu's Menu","ref":"site/manusmenu-com","color":"#55b8ad","shape":"site","sub":"manusmenu.com","note":"Italian-born home cook Manuela sharing classic family and regional Italian dishes.","url":"https://www.manusmenu.com/about/about-this-site","suggested":true,"kind":"blo