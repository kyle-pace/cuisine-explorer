{"cuisine/rocky-mountain-cuisine":{"t":"cuisine","r":"cuisine/rocky-mountain-cuisine","n":"Rocky Mountain cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Western American cuisine","cuisine/cuisine-of-the-western-united-states"]],"sub":"Regional cuisine in United States of America","intro":[["Rocky Mountain cuisine is a cuisine of Alberta and British Columbia in Canada; Idaho, Colorado, Wyoming, Utah and Montana in the United States. Some distinguishing dishes include bison and Rocky Mountain oysters, or prairie oysters as they are known in Canada."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"rocky-mountain-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rocky_Mountain_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Western American cuisine","cuisine/cuisine-of-the-western-united-states"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"Open Range: Steaks, Chops, and More from Big Sky Country","ref":"cookbook/open-range-steaks-chops-and-more-from-big-sky-country","color":"#f0b340","shape":"book","sub":"Jay Bentley","note":"Montana-style ranch and meat cooking.","url":"https://perseusbooks.com/titles/jay-bentley/open-range/9780762441532","suggested":true,"isbn":"9780762441532"}]},{"h":"Part of","links":[["Western American cuisine","cuisine/cuisine-of-the-western-united-states"]]}],"cont":"Cuisine of the Americas"},"cuisine/bashkir-cuisine":{"t":"cuisine","r":"cuisine/bashkir-cuisine","n":"Bashkir cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Russian cuisine","cuisine/russian-cuisine"]],"sub":"Regional cuisine in Russia","intro":[["Bashkir cuisine is the traditional cuisine of the Bashkirs. Their way of life, and the predominance of cattle breeding contributed culture, traditions, and cuisine of the Bashkirs."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"bashkir-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bashkir_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Russian cuisine","cuisine/russian-cuisine"]]},{"h":"Dishes","count":6,"links":[["Beshbarmak","dish/beshbarmak"],["Echpochmak","dish/echpochmak"],["Peremech","dish/peremech"],["Pilaf","dish/pilaf"],["Qazı","dish/qaz"],["Qistibi","dish/qistibi"]]},{"h":"Key ingredients","links":[["Onion","ingredient/onion"],["Beef","ingredient/beef"],["Noodles","ingredient/noodles"],["Potato","ingredient/potato"],["Wheat flour","ingredient/wheat-flour"],["Animal fats and oils","ingredient/animal-fats-and-oils"],["Broth","ingredient/broth"],["Carrot","ingredient/carrot"],["Dried fruit","ingredient/dried-fruit"],["Lard","ingredient/lard"],["Rice","ingredient/rice"],["Stock (cooking)","ingredient/stock-cooking"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["Russian cuisine","cuisine/russian-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/thumb/9/9b/%D0%9D%D0%B0%D1%86%D0%B8%D0%BE%D0%BD%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5_%D0%B1%D0%BB%D1%8E%D0%B4%D0%B0_%D0%B1%D0%B0%D1%88%D0%BA%D0%B8%D1%80.jpg/500px-%D0%9D%D0%B0%D1%86%D0%B8%D0%BE%D0%BD%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5_%D0%B1%D0%BB%D1%8E%D0%B4%D0%B0_%D0%B1%D0%B0%D1%88%D0%BA%D0%B8%D1%80.jpg","w":500,"h":375,"by":"KseniyaL","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%D0%9D%D0%B0%D1%86%D0%B8%D0%BE%D0%BD%D0%B0%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5_%D0%B1%D0%BB%D1%8E%D0%B4%D0%B0_%D0%B1%D0%B0%D1%88%D0%BA%D0%B8%D1%80.jpg"}},"cuisine/kachin-cuisine":{"t":"cuisine","r":"cuisine/kachin-cuisine","n":"Kachin cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Chinese cuisine","cuisine/chinese-cuisine"]],"sub":"Regional cuisine in China","intro":[["Kachin cuisine is food indigenous to the Kachin peoples, who inhabit the northern areas of Myanmar, as well as parts of China and Arunachal Pradesh, associated with Kachin. Kachin restaurants have opened in Myanmar's commercial capital of Yangon, and Kachin migrants have brought the cuisine to other countries. Kachin cuisine is typified by its use of cold-climate ingredients like potatoes, wild game (e.g., venison and wild boar), and foraged herbs and vegetables. The traditional staple is rice, which is traditionally cultivated in hillside fields."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"kachin-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kachin_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Dishes","count":1,"links":[["Akhuni","dish/akhuni"]]},{"h":"Key ingredients","links":[["Soybean","ingredient/soybean"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/thumb/4/4a/Naga_Smoked_Pork_with_Axone_%28Fermented_Soyabeans%29.jpg/500px-Naga_Smoked_Pork_with_Axone_%28Fermented_Soyabeans%29.jpg","w":500,"h":348,"by":"Sumit Surai","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Naga_Smoked_Pork_with_Axone_(Fermented_Soyabeans).jpg","of":"Akhuni"}},"cuisine/sri-lankan-cuisine":{"t":"cuisine","r":"cuisine/sri-lankan-cuisine","n":"Sri Lankan cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Cuisine"]],"sub":"National cuisine of Sri Lanka","intro":[["Sri Lankan cuisine is known for its particular combinations of herbs, spices, fish, vegetables, rices, and fruits. The cuisine is highly centred around many varieties of rice, as well as coconut which is a ubiquitous plant throughout the country. Seafood also plays a significant role in the cuisine, be it fresh fish or preserved fish. As a country that was a hub in the historic oceanic silk road, contact with foreign traders brought new food items and cultural influences in addition to the local traditions of the country's ethnic groups, all of which have helped shape Sri Lankan cuisine. Influences from Indian (particularly South Indian), Indonesian and Dutch cuisines are most evident with Sri Lankan cuisine sharing close ties to other neighbouring South and Southeast Asian cuisines."],["Sri Lanka is historically famous for its cinnamon. The 'true cinnamon' tree, or Cinnamomum verum, used to be botanically named Cinnamomum zeylanicum to reflect its Sri Lankan origins. This is a widely utilised spice in Sri Lanka, and has a more delicate, sweet taste in comparison to Cinnamomum cassia, which is more common in some other Southeast Asian cuisines. Contrasting the local cuisine with those of neighbouring regions, Sri Lankan cuisine is characterised by unique spice blends with heavy use of Sri Lankan cinnamon and black pepper, as well as by the use of ingredients such as Maldives fish, goraka (Garcinia cambogia), pandan leaf, lemongrass, and jaggery made from kithul palm syrup. Sri Lanka is also a consumer of many varieties of red rice, some of which are considered heirloom rices in the country. Tea is also an important beverage throughout the country, and Sri Lanka is known for producing some of the world's finest tea."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"sri-lankan-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sri_Lankan_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]},{"h":"Cookbooks","count":2,"rows":[{"name":"Weligama: Recipes from Sri Lanka","ref":"cookbook/weligama-recipes-from-sri-lanka","color":"#f0b340","shape":"book","sub":"Emily Dobbs, 2017","note":"Sri Lankan home and street food from the founder of a London hopper stall.","url":"https://www.hachette.co.uk/titles/emily-dobbs/weligama/9781409171447/","suggested":true,"isbn":"9781409171447"},{"name":"Sri Lanka: The Cookbook","ref":"cookbook/sri-lanka-the-cookbook","color":"#f0b340","shape":"book","sub":"Prakash K. Sivanathan","note":"Broad collection of Sri Lankan curries, sambols and snacks.","url":"https://openlibrary.org/isbn/9781836008200","suggested":true,"isbn":"9781836008200"}]},{"h":"Dishes","count":2,"links":[["Maldives fish","dish/maldives-fish"],["Thali","dish/thali"]]},{"h":"Key ingredients","links":[["Groat","ingredient/groat"],["Rice","ingredient/rice"]],"note":"Most used across its dishes."}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/thumb/3/30/FoodAtUnawatuna_RiceAndPrawns.jpg/500px-FoodAtUnawatuna_RiceAndPrawns.jpg","w":500,"h":333,"by":"Shehal at English Wikipedia","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:FoodAtUnawatuna_RiceAndPrawns.jpg"}},"cuisine/malay-cuisine":{"t":"cuisine","r":"cuisine/malay-cuisine","n":"Malay cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Malaysian cuisine","cuisine/malaysian-cuisine"],["Indonesian cuisine","cuisine/indonesian-cuisine"]],"sub":"Regional cuisine in Malaysia","intro":[["Malay cuisine is the traditional food of the Malays."],["The main characteristic of traditional Malay cuisine is the generous use of spices: particularly a main combination of cinnamon, clove, star anise and cardamom known as the \"four siblings\" (empat beradik); lemongrass and galangal is also plentiful. Coconut milk is also important in giving Malay dishes their rich, creamy character.  The other foundation is belacan (prawn paste), used as a base for sambal, a rich sauce or condiment made from mixing with chilli peppers, onions and garlic."],["Nearly every Malay meal is served with a staple of rice, as is in many other Asian cultures. Although there are various types of dishes in a Malay meal, all are served at once, not in courses. A typical meal consists of a plate of rice for each person on the table. Dishes are meant to be shared among the diners; each dish is provided with a spoon, and each diner spoons the dishes of their choosing onto their rice plate."],["Food is eaten delicately with the fingers of the right hand, never with the left (which is used for personal ablutions); Malays rarely use utensils."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"malay-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Malay_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Malaysian cuisine","cuisine/malaysian-cuisine"],["Indonesian cuisine","cuisine/indonesian-cuisine"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"The Malay Cook: Everyday Malaysian Recipes from Grandma's Kitchen to Mine","ref":"cookbook/the-malay-cook-everyday-malaysian-recipes-from-grandma-s-kitchen-to-mine","color":"#f0b340","shape":"book","sub":"Ranie Saidi","note":"Malay family home cooking by a Malaysian-born cook.","url":"https://publishing.hardiegrant.com/en-au/books/the-malay-cook-by-ranie-saidi/9781788797481","suggested":true,"isbn":"9781788797481"}]},{"h":"Dishes","count":13,"links":[["Akok (food)","dish/akok-food"],["Ikan bakar","dish/ikan-bakar"],["Karas (food)","dish/karas-food"],["Ketupat","dish/ketupat"],["Lekor","dish/lekor"],["Mee siput","dish/mee-siput"],["Nasi Ayam","dish/nasi-ayam"],["Nasi kerabu","dish/nasi-kerabu"],["Nasi tumpang","dish/nasi-tumpang"],["Roti jala","dish/roti-jala"],["Sata (food)","dish/sata-food"],["Tahu goreng","dish/tahu-goreng"],["Ulam (salad)","dish/ulam-salad"]]},{"h":"Key ingredients","links":[["Rice","ingredient/rice"],["Wheat flour","ingredient/wheat-flour"],["Fish","ingredient/fish"],["Coconut milk","ingredient/coconut-milk"],["Egg","ingredient/egg"],["Sugar","ingredient/sugar"],["Chili pepper","ingredient/chili-pepper"],["Coconut","ingredient/coconut"],["Palm sugar","ingredient/palm-sugar"],["Pandan","ingredient/pandan"],["Banana leaf","ingredient/banana-leaf"],["Charcoal","ingredient/charcoal"],["Grilled","ingredient/grilled"],["Lemongrass","ingredient/lemongrass"],["Shallots","ingredient/shallots"],["Rice flour","ingredient/rice-flour"],["Rastrelliger kanagurta","ingredient/rastrelliger-kanagurta"],["Round sardinella","ingredient/round-sardinella"],["Sago","ingredient/sago"],["Silver-stripe round herring","ingredient/silver-stripe-round-herring"],["Tapioca starch","ingredient/tapioca-starch"],["Chicken","ingredient/chicken"],["Soy sauce","ingredient/soy-sauce"],["Budu (sauce)","ingredient/budu-sauce"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["Malaysian cuisine","cuisine/malaysian-cuisine"],["Indonesian cuisine","cuisine/indonesian-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/thumb/1/1a/Nasi_Himpit.jpg/500px-Nasi_Himpit.jpg","w":500,"h":667,"by":"CyberTroopers","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Nasi_Himpit.jpg"}},"ingredient/corned-beef":{"t":"ingredient","r":"ingredient/corned-beef","n":"Corned beef","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 7 cuisines","intro":[["Corned beef (called salt beef in Commonwealth countries) is a salt-cured piece of beef. The term comes from the treatment of the meat with large-grained rock salt, also called \"corns\" of salt. Sometimes, sugar and spices are added to corned beef recipes. Corned beef is featured as an ingredient in many cuisines."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-corned-beef"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Corned_beef"}],"sections":[{"h":"Where it's cooked with","count":7,"groups":[["American cuisine","cuisine/american-cuisine",[["Reuben sandwich","dish/reuben-sandwich"]]],["Danish cuisine","cuisine/danish-cuisine",[["Labskaus","dish/labskaus"]]],["German cuisine","cuisine/german-cuisine",[["Labskaus","dish/labskaus"]]],["Jewish cuisine","cuisine/jewish-cuisine",[["Reuben sandwich","dish/reuben-sandwich"]]],["Norwegian cuisine","cuisine/norwegian-cuisine",[["Labskaus","dish/labskaus"]]],["Slovak cuisine","cuisine/slovak-cuisine",[["Bryndzové halušky","dish/bryndzove-halusky"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Labskaus","dish/labskaus"]]]]},{"h":"Often cooked with","links":[["Bryndza","ingredient/bryndza"],["Halušky","ingredient/halusky"],["Potato","ingredient/potato"],["Wheat flour","ingredient/wheat-flour"],["Onion","ingredient/onion"],["Potatoes","ingredient/potatoes"],["Salted meat","ingredient/salted-meat"],["Russian dressing","ingredient/russian-dressing"],["Rye bread","ingredient/rye-bread"],["Sauerkraut","ingredient/sauerkraut"],["Swiss cheese (North America)","ingredient/swiss-cheese-north-america"],["Thousand Island dressing","ingredient/thousand-island-dressing"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/7b/Cooked_corned_beef.JPG/500px-Cooked_corned_beef.JPG","w":500,"h":375,"by":"BrokenSphere","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Cooked_corned_beef.JPG"}},"dish/dimlama":{"t":"dish","r":"dish/dimlama","n":"Dimlama","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#f0b340","intro":[["Dimlama or dymdama is an Uzbek stew made with various combinations of meat, potatoes, onions, vegetables, and sometimes fruits. Meat (lamb or sometimes veal or beef) and vegetables are cut into large pieces and placed in layers in a tightly sealed pot to simmer slowly in their own juices. Vegetables for dimlama may include, in addition to potatoes and onions, carrots, cabbage, eggplants, tomatoes, sweet peppers, spiced with garlic and a variety of herbs and condiments. Dimlama is usually cooked during spring and summer when there is a wide choice of vegetables. It is served on a large plate and eaten with a spoon."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-dimlama"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Dimlama"}],"sections":[{"h":"Where it's from","links":[["Kazakh cuisine","cuisine/kazakh-cuisine"],["Kyrgyz cuisine","cuisine/kyrgyz-cuisine"],["Uzbek cuisine","cuisine/uzbek-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Beef","ingredient/beef"],["Brassica oleracea","ingredient/brassica-oleracea"],["Carrot","ingredient/carrot"],["Lamb","ingredient/lamb"],["Onion","ingredient/onion"],["Potato","ingredient/potato"],["Veal","ingredient/veal"]]},{"h":"More from Kazakh cuisine","links":[["Beshbarmak","dish/beshbarmak"],["Boortsog","dish/boortsog"],["Chorba","dish/chorba"],["Kuurdak","dish/kuurdak"],["Naryn (dish)","dish/naryn-dish"],["Orama (dish)","dish/orama-dish"],["Peremech","dish/peremech"],["Pilaf","dish/pilaf"],["Qatlama","dish/qatlama"],["Qazı","dish/qaz"],["Shakarap","dish/shakarap"],["Shalgam","dish/shalgam"]]}],"img":{"src":"/labs/cuisines/img/thumb/f/fd/Dimlama_%2816425713838%29.jpg/500px-Dimlama_%2816425713838%29.jpg","w":500,"h":361,"by":"mismailovs from West Lafayette, US","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Dimlama_(16425713838).jpg"}},"dish/disanxian":{"t":"dish","r":"dish/disanxian","n":"Disanxian","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Northeastern Chinese cuisine","dot":"#f0b340","intro":[["Disanxian is a Chinese dish made of three kinds of nightshade vegetables: stir-fried potatoes, eggplant, and sweet peppers. Additional ingredients may include garlic, spring onion, and others. The name roughly translates to \"three treasures from the earth\" because it consists of the three key ingredients listed above. It is considered a classic dish in Northeastern Chinese cuisine, and is common in northern China."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-disanxian"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Disanxian"}],"sections":[{"h":"Where it's from","links":[["Northeastern Chinese cuisine","cuisine/northeastern-chinese-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Bell pepper","ingredient/bell-pepper"],["Eggplant","ingredient/eggplant"],["Potato","ingredient/potato"]]},{"h":"Cook it","rows":[{"name":"The Mala Market Blog","ref":"site/blog-themalamarket-com","color":"#55b8ad","shape":"site","sub":"blog.themalamarket.com","note":"Dongbei recipes and articles on a regional Chinese cooking blog from a US ingredient importer.","url":"https://blog.themalamarket.com/category/regional-chinese-cuisines/northeast/","suggested":true,"kind":"blog"}]}],"img":{"src":"/labs/cuisines/img/thumb/5/55/Disanxian.jpg/500px-Disanxian.jpg","w":500,"h":375,"by":"Riverhugger","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Disanxian.jpg"}},"dish/japanese-cheesecake":{"t":"dish","r":"dish/japanese-cheesecake","n":"Japanese cheesecake","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["Japanese cheesecake, also known as soufflé-style cheesecake, cotton cheesecake, or light cheesecake, is a variety of cheesecake that is usually lighter in texture and less sweet than North American varieties. It has a characteristically wobbly and airy texture similar to a soufflé when fresh out of the oven and a chiffon cake-like texture when chilled."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-japanese-cheesecake"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Japanese_cheesecake"}],"sections":[{"h":"Where it's from","links":[["Japanese cuisine","cuisine/japanese-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Butter","ingredient/butter"],["Cheese","ingredient/cheese"],["Cream cheese","ingredient/cream-cheese"],["Egg","ingredient/egg"],["Sugar","ingredient/sugar"]]},{"h":"Cook it","rows":[{"name":"Just One Cookbook","ref":"site/justonecookbook-com","color":"#55b8ad","shape":"site","sub":"justonecookbook.com","note":"Namiko Chen's long-running blog and videos on Japanese home cooking.","url":"https://justonecookbook.com","suggested":true,"kind":"blog"},{"name":"RecipeTin Japan","ref":"site/japan-recipetineats-com","color":"#55b8ad","shape":"site","sub":"japan.