sh/es-goyobod"],["Gado-gado","dish/gado-gado"],["Geplak","dish/geplak"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/13/Lamb_rendang.jpg/500px-Lamb_rendang.jpg","w":500,"h":332,"by":"Unknown author","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Lamb_rendang.jpg"}},"dish/stew-peas":{"t":"dish","r":"dish/stew-peas","n":"Stew peas","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Jamaican cuisine","dot":"#94bd5c","intro":[["Stew peas is a Jamaican stew made with beans, salted meat, coconut milk, herbs and spices. It is a common dish in Jamaica, however a number of variations and similar dishes are made throughout the Americas. With the main ingredients being legumes (beans/peas) and meats, stew peas is a good source of protein."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-stew-peas"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Stew_peas"}],"sections":[{"h":"Where it's from","links":[["Jamaican cuisine","cuisine/jamaican-cuisine"]]},{"h":"Cook it","rows":[{"name":"Jamaican Cookery","color":"#55b8ad","shape":"site","sub":"jamaicancookery.com","note":"Long-running blog of everyday Jamaican home recipes.","url":"https://www.jamaicancookery.com/p/about-me.html","suggested":true,"kind":"blog"},{"name":"Jamaican Foods and Recipes","color":"#55b8ad","shape":"site","sub":"jamaicanfoodsandrecipes.com","note":"Recipe site focused on traditional Jamaican dishes.","url":"https://jamaicanfoodsandrecipes.com/category-index/","suggested":true,"kind":"site"}]}],"img":{"src":"/labs/cuisines/img/thumb/0/00/Jamaican_stew_peas.jpg/500px-Jamaican_stew_peas.jpg","w":500,"h":396,"by":"Xaymacan","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Jamaican_stew_peas.jpg"}},"dish/suan-cai":{"t":"dish","r":"dish/suan-cai","n":"Suan cai","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Chinese cuis