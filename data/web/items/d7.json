shes"]],"sub":"Dish from Hmong cuisine","dot":"#f0b340","intro":[["Hmong sausage is a long thick pork sausage from Hmong culture seasoned with herbs like lemongrass and Thai chili pepper. The sausage is commonly served during Hmong New Year celebrations. The exact recipe varies depending on factors such as clan and individual immigration background."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-hmong-sausage"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hmong_sausage"}],"sections":[{"h":"Where it's from","links":[["Hmong cuisine","cuisine/hmong-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Galangal","ingredient/galangal"],["Ginger","ingredient/ginger"],["Lemongrass","ingredient/lemongrass"],["Pork","ingredient/pork"],["Thai chili","ingredient/thai-chili"]]},{"h":"Cook it","rows":[{"name":"ChawJ Creations","color":"#55b8ad","shape":"site","sub":"chawjcreations.com","note":"Hmong food and storytelling site by Cindy Her, a pastry chef in the Pacific Northwest.","url":"https://chawjcreations.com/tag/hmong/","suggested":true,"kind":"blog"}]}],"img":{"src":"/labs/cuisines/img/thumb/0/03/Hmong_cuisine_-_sausage_and_spring_roll_crop_2.jpg/500px-Hmong_cuisine_-_sausage_and_spring_roll_crop_2.jpg","w":500,"h":500,"by":"rochelle hartman https://www.flickr.com/photos/tinfoilraccoon/5714049514/","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Hmong_cuisine_-_sausage_and_spring_roll_crop_2.jpg"}},"dish/itamae":{"t":"dish","r":"dish/itamae","n":"Itamae","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Japanese cuisine","dot":"#f0b340","intro":[["An itamae is a cook in a Japanese kitchen or a chef of a large restaurant. The term can be translated literally as \"in front of the board,\" referring to a cutting board."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-itamae"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Itamae"}],"sections":[{"h":"Where it's from","links":[["Japanese cuisine","cuisine/japanese-cuisine"]]},{"h":"Cook it","rows":[{"name":"Just One Cookbook","color":"#55b8ad","shape":"site","sub":"justonecookbook.com","note":"Namiko Chen's long-running blog and videos on Japanese home cooking.","url":"https://justonecookbook.com","suggested":true,"kind":"blog"},{"name":"RecipeTin Japan","color":"#55b8ad","shape":"site","sub":"japan.recipetineats.com","note":"Japanese home recipes from Yumiko, a Japan-born cook, sister site to RecipeTin Eats.","url":"https://japan.recipetineats.com/","suggested":true,"kind":"blog"}]},{"h":"More from Japanese cuisine","links":[["Bergh–Stoutenburgh House","dish/bergh-stoutenburgh-house"],["Chikuwa","dish/chikuwa"],["Curry bread","dish/curry-bread"],["Donburi","dish/donburi"],["Fukamushicha","dish/fukamushicha"],["Gyokuro","dish/gyokuro"],["Hitsumabushi","dish/hitsumabushi"],["Horumonyaki","dish/horumonyaki"],["Iekei ramen","dish/iekei-ramen"],["Inago no tsukudani","dish/inago-no-tsukudani"],["Izakaya","dish/izakaya"],["Japanese cheesecake","dish/japanese-cheesecake"],["Japanese noodles","dish/japanese-noodles"],["Japanese restaurant","dish/japanese-restaurant"],["Japanese tea","dish/japanese-tea"],["Jingisukan","dish/jingisukan"],["Kaki furai","dish/kaki-furai"],["Kamaboko","dish/kamaboko"],["Kōji (food)","dish/koji-food"],["Kusa mochi","dish/kusa-mochi"],["Kushikatsu","dish/kushikatsu"],["List of Japanese restaurants","dish/list-of-japanese-restaurants"],["Makizushi","dish/makizushi"],["Miso","dish/miso"],["Miso soup","dish/miso-soup"],["Monjayaki","dish/monjayaki"],["Nikujaga","dish/nikujaga"],["Nimono","dish/nimono"],["Oden","dish/oden"],["Onigiri","dish/onigiri"],["Osechi","dish/osechi"],["Oyakodon","dish/oyakodon"],["Rainbow roll","dish/rainbow-roll"],["Ramen","dish/ramen"],["Ryōtei","dish/ryotei"],["Sashimi","dish/sashimi"],["Sencha","dish/sencha"],["Shizuoka oden","dish/shizuoka-oden"],["Sumiso","dish/sumiso"],["Sushi","dish/sushi"]]}]},"dish/mastava":{"t":"dish","r":"dish/mastava","n":"Mastava","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Māstāba, or mastava, is a traditional Uzbek and Tajik soup. Sometimes it is called \"liquid pilaf\"."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-mastava"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mastava"}],"sections":[{"h":"Where it's from","links":[["Tajik cuisine","cuisine/tajik-cuisine"],["Uzbek cuisine","cuisine/uzbek-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Rice","ingredient/rice"]]},{"h":"More from Tajik cuisine","links":[["Chorba","dish/chorba"],["Nisholda","dish/nisholda"],["Pilaf","dish/pilaf"],["Qurutob","dish/qurutob"],["Shakarap","dish/shakarap"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/bd/%D0%9C%D0%B0%D1%81%D1%82%D0%B0%D0%B2%D0%B0.jpg/500px-%D0%9C%D0%B0%D1%81%D1%82%D0%B0%D0%B2%D0%B0.jpg","w":500,"h":375,"by":"Sakateka","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%D0%9C%D0%B0%D1%81%D1%82%D0%B0%D0%B2%D0%B0.jpg"}},"ingredient/sake":{"t":"ingredient","r":"ingredient/sake","n":"Sake","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Sake, saké, or saki, also referred to as Japanese rice wine (specified as 日本酒 \"nihonshu\" in Japanese, as 酒 can refer to all alcohol), is an alcoholic beverage of Japanese origin made by fermenting rice that has been polished to remove the bran. Despite the name Japanese rice wine, sake, and indeed any East Asian rice wine (such as huangjiu and cheongju), is produced by a brewing process more akin to that of beer, where starch is converted into sugars that ferment into alcohol, whereas in wine, alcohol is produced by fermenting sugar that is naturally present in fruit, typically grapes, in a process known as multiple parallel fermentation."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sake"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sake"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Japanese cuisine","cuisine/japanese-cuisine",[["Nimono","dish/nimono"]]]]},{"h":"Often cooked with","links":[["Dashi","ingredient/dashi"],["Mirin","ingredient/mirin"],["Soy sauce","ingredient/soy-sauce"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/13/Overflowing_sake_glass_in_masu.jpg/500px-Overflowing_sake_glass_in_masu.jpg","w":500,"h":667,"by":"Intforce","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Overflowing_sake_glass_in_masu.jpg"}},"ingredient/gelatin":{"t":"ingredient","r":"ingredient/gelatin","n":"Gelatin","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 6 dishes across 5 cuisines","intro":[["Gelatin in American English or gelatine in British English (from the Latin gelatus, 'stiff, frozen') is a translucent, colorless, flavorless food ingredient, commonly derived from partial hydrolysis of collagen taken from animal body parts. It is brittle when dry, and rubbery when moist. It is commonly used as a gelling agent in food, beverages, medications, drug or vitamin capsules, photographic films, papers, and cosmetics. It may also be referred to as hydrolyzed collagen, collagen hydrolysate, gelatine hydrolysate, hydrolyzed gelatine, and collagen peptides after it has undergone further hydrolysis."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-gelatin"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Gelatin"}],"sections":[{"h":"Where it's cooked with","count":5,"groups":[["Chinese cuisine","cuisine/chinese-cuisine",[["Shengjian mantou","dish/shengjian-mantou"],["Xiaolongbao","dish/xiaolongbao"]]],["Italian cuisine","cuisine/italian-cuisine",[["Panna cotta","dish/panna-cotta"],["Stracciatella (ice cream)","dish/stracciatella-ice-cream"]]],["American cuisine","cuisine/american-cuisine",[["Strawberry delight","dish/strawberry-delight"]]],["Bolivian cuisine","cuisine/bolivian-cuisine",[["Salteña","dish/saltena"]]],["Taiwan cuisine","cuisine/taiwan-cuisine",[["Xiaolongbao","dish/xiaolongbao"]]]]},{"h":"Often cooked with","links":[["Pork","ingredient/pork"],["Cream","ingredient/cream"],["Sugar","ingredient/sugar"],["Vanilla","ingredient/vanilla"],["Beef","ingredient/beef"],["Chicken","ingredient/chicken"],["Chocolate","ingredient/chocolate"],["Egg yolk","ingredient/egg-yolk"],["Ice cream","ingredient/ice-cream"],["Milk","ingredient/milk"],["Milk chocolate","ingredient/milk-chocolate"],["Smetana","ingredient/smetana"],["Sodium alginate","ingredient/sodium-alginate"],["Butter","ingredient/butter"],["Cracker","ingredient/cracker"],["Cream cheese","ingredient/cream-cheese"]]}],"img":{"src":"/labs/cuisines/img/thumb/3/3f/Gelatine.png/500px-Gelatine.png","w":500,"h":351,"by":"Danielle dk","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Gelatine.png"}},"dish/rendang":{"t":"dish","r":"dish/rendang","n":"Rendang","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Rendang is a stir-fried meat dish or dry curry made of meat stewed in coconut milk and spices, widely popular across Indonesia, Malaysia, Singapore, Brunei, and the southern parts of the Philippines, where each version is considered local cuisine. It refers to both a cooking method of frying and the dish cooked in that way. The process involves slowly cooking meat in spiced coconut milk in an uncovered pot or pan until the oil separates, allowing the dish to fry in its own sauce, coating the meat in a rich, flavorful glaze."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-rendang"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rendang"}],"sections":[{"h":"Where it's from","links":[["Indonesian cuisine","cuisine/indonesian-cuisine"],["Padang food","cuisine/padang-food"]]},{"h":"In