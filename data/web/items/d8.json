{"cuisine/sammarinese-cuisine":{"t":"cuisine","r":"cuisine/sammarinese-cuisine","n":"Sammarinese cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Italian cuisine","cuisine/italian-cuisine"]],"sub":"National cuisine of San Marino","intro":[["As San Marino is a microstate completely landlocked by Italy, Sammarinese cuisine is very similar to Italian cuisine, especially that of the adjoining Emilia-Romagna and Marche regions. San Marino's primary agricultural products are cheese, wine and livestock, and cheesemaking is a primary economic activity in San Marino."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"sammarinese-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sammarinese_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Part of","links":[["Italian cuisine","cuisine/italian-cuisine"]]}],"cont":"European cuisine","img":{"src":"/world-cuisine/img/thumb/7/71/Bustrengo.jpg/500px-Bustrengo.jpg","w":500,"h":375,"by":"Peter Smith","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Bustrengo.jpg"}},"ingredient/smetana-dairy-product":{"t":"ingredient","r":"ingredient/smetana-dairy-product","n":"Smetana (dairy product)","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 6 cuisines","intro":[["Smetana is the English-language name for the different types of sour cream traditionally prevalent in Central, Eastern, and Southeastern Europe, and Central Asia. It is a dairy product produced by souring heavy cream. It is similar to crème fraîche, but nowadays mainly sold with 9% to 42% milkfat content depending on the country. Its cooking properties are different from crème fraîche and sour cream sold in the US, which contain 18% butterfat. It is widely used in cooking and baking."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-smetana-dairy-product"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Smetana_(dairy_product)"}],"sections":[{"h":"Where it's cooked with","count":6,"groups":[["Russian cuisine","cuisine/russian-cuisine",[["Beef Stroganoff","dish/beef-stroganoff"],["Solyanka","dish/solyanka"]]],["Ukrainian cuisine","cuisine/ukrainian-cuisine",[["Banosh","dish/banosh"],["Solyanka","dish/solyanka"]]],["Belarusian cuisine","cuisine/belarusian-cuisine",[["Solyanka","dish/solyanka"]]],["French cuisine","cuisine/french-cuisine",[["Beef Stroganoff","dish/beef-stroganoff"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Beef Stroganoff","dish/beef-stroganoff"]]],["Soviet cuisine","cuisine/soviet-cuisine",[["Solyanka","dish/solyanka"]]]]},{"h":"Often cooked with","links":[["Smetana","ingredient/smetana"],["Bryndza","ingredient/bryndza"],["Cornmeal","ingredient/cornmeal"],["Cream","ingredient/cream"],["Maize flour","ingredient/maize-flour"],["Beef","ingredient/beef"],["Sour cream","ingredient/sour-cream"],["Tomato paste","ingredient/tomato-paste"],["Boletus edulis","ingredient/boletus-edulis"],["Broth","ingredient/broth"],["Cabbage","ingredient/cabbage"],["Dill","ingredient/dill"],["Edible mushrooms","ingredient/edible-mushrooms"],["Fish","ingredient/fish"],["Lemon","ingredient/lemon"],["Olea europaea","ingredient/olea-europaea"]]}],"img":{"src":"/world-cuisine/img/thumb/a/a7/Borscht_served.jpg/500px-Borscht_served.jpg","w":500,"h":327,"by":"liz west from Boxborough, MA","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Borscht_served.jpg"}},"dish/birnbrot":{"t":"dish","r":"dish/birnbrot","n":"Birnbrot","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Swiss cuisine","dot":"#cf5f87","intro":[["Birnbrot (literally pear bread) or Birnweggen (literally pear buns) are a traditional baked good originating in Switzerland with a filling of dried pears. They exist throughout Switzerland and popular variations include \"Bündener Birnbrot\" (from the Kanton Graubünden), \"Glarner Birnbrot\" (from the Kanton Glarus), \"Toggenburger Birnbrot\" (from Toggenburg) and \"Luzerner Birnweggen\" (from Luzern)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-birnbrot"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Birnbrot"}],"sections":[{"h":"Where it's from","links":[["Swiss cuisine","cuisine/swiss-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Apple","ingredient/apple"],["Candied fruit","ingredient/candied-fruit"],["Common fig","ingredient/common-fig"],["Dried fruit","ingredient/dried-fruit"],["Pear","ingredient/pear"],["Raisin","ingredient/raisin"],["Walnut","ingredient/walnut"]]},{"h":"Cook it","rows":[{"name":"Helvetic Kitchen","color":"#55b8ad","shape":"site","sub":"helvetickitchen.com","note":"Andie Pilot's blog of Swiss home cooking and baking, with notes on Swiss cookbooks.","url":"https://www.helvetickitchen.com/recipes/retrospective","suggested":true,"kind":"blog"},{"name":"Cuisine Helvetica","color":"#55b8ad","shape":"site","sub":"cuisinehelvetica.com","note":"Heddi Nieuwsma's Swiss recipes and food culture from her life in Switzerland.","url":"https://cuisinehelvetica.com/swiss-recipes","suggested":true,"kind":"blog"}]},{"h":"More from Swiss cuisine","links":[["Älplermagronen","dish/alplermagronen"],["Basler Läckerli","dish/basler-lackerli"],["Bündnerfleisch","dish/bundnerfleisch"],["Cabbage roll","dish/cabbage-roll"],["Carac (pastry)","dish/carac-pastry"],["Cervelat","dish/cervelat"],["Cholera (food)","dish/cholera-food"],["Egg puffs and soup pearls","dish/egg-puffs-and-soup-pearls"],["Landjäger","dish/landjager"],["Leberkäse","dish/leberkase"],["Raclette","dish/raclette"],["Riz Casimir","dish/riz-casimir"],["Schenkele","dish/schenkele"],["Spätzle","dish/spatzle"],["Swiss sausages and cured meats","dish/swiss-sausages-and-cured-meats"],["Wähe","dish/wahe"],["Zopf","dish/zopf"],["Zuger Kirschtorte","dish/zuger-kirschtorte"],["Zürcher Geschnetzelte