g Lichun to celebrate the beginning spring."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-spring-pancake"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Spring_pancake"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Beijing cuisine","cuisine/beijing-cuisine",[["Peking duck","dish/peking-duck"]]]]},{"h":"Often cooked with","links":[["Allium fistulosum","ingredient/allium-fistulosum"],["Duck as food","ingredient/duck-as-food"],["Tianmianjiang","ingredient/tianmianjiang"]]}]},"ingredient/sorghum":{"t":"ingredient","r":"ingredient/sorghum","n":"Sorghum","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Sorghum () or broomcorn is a genus of about 28 species of flowering plants in the grass family (Poaceae). Sorghum bicolor is grown as a cereal for human consumption and as animal fodder."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sorghum"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sorghum_(genus)"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Ghanaian cuisine","cuisine/ghanaian-cuisine",[["Pito (beer)","dish/pito-beer"]]]]},{"h":"Where it's grown","grown":{"what":"Sorghum","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":59879526,"top":[["United States of America","cuisine/american-cuisine",8484752],["Nigeria","cuisine/nigerian-cuisine",6604894],["Mexico","cuisine/mexican-cuisine",4635596],["India","cuisine/indian-cuisine",4554702],["Ethiopia","cuisine/ethiopian-cuisine",4488944],["Sudan","cuisine/sudanese-cuisine",4046813],["Brazil","cuisine/brazilian-cuisine",3357490],["China","cuisine/chinese-cuisine",3092266],["Argentina","cuisine/argentine-cuisine",2427638],["Ashmore and Cartier Is.","cuisine/australian-cuisine",1890375],["Burkina Faso","cuisine/burkinabe-cuisine",1833837],["Niger","cuisine/cuisine-of-niger",1809982],["Mali","cuisine/malian-cuisine",1566920],["Cameroon","cuisine/cameroonian-cuisine",1172128],["Bolivia","cuisine/bolivian-cuisine",1150616]]}},{"h":"Often cooked with","links":[["Millet","ingredient/millet"]]}]},"dish/piyanggang-manok":{"t":"dish","r":"dish/piyanggang-manok","n":"Piyanggang manok","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#f0b340","intro":[["Piyanggang manok, also spelled pyanggang manuk, is a Filipino dish consisting of chicken braised in turmeric, onions, lemongrass, ginger, siling haba chilis, garlic, coconut milk, and ground burnt coconut. It originates from the Tausug people of Sulu. It is related to tiyula itum, another Tausug dish which uses burnt coconut. The dish is characteristically black in color. The meat may also be grilled before adding the marinade. It is a type of ginataan."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-piyanggang-manok"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Piyanggang_manok"}],"sections":[{"h":"Where it's from","links":[["Filipino cuisine","cuisine/filipino-cuisine"],["Mindanao cuisine","cuisine/filipino-cuisine-mindanao"],["Visayan cuisine","cuisine/filipino-cuisine-visayas"]]},{"h":"Ingredients","count":6,"links":[["Chicken","ingredient/chicken"],["Coconut milk","ingredient/coconut-milk"],["Garlic","ingredient/garlic"],["Lemongrass","ingredient/lemongrass"],["Siling haba","ingredient/siling-haba"],["Turmeric","ingredient/turmeric"]]},{"h":"Cook it","rows":[{"name":"Panlasang Pinoy","ref":"site/panlasangpinoy-com","color":"#55b8ad","shape":"site","sub":"panlasangpinoy.com","note":"Vanjo Merano's large library of Filipino recipes and cooking videos.","url":"https://panlasangpinoy.com/filipino-food/","suggested":true},{"name":"Kawaling Pinoy","ref":"site/kawalingpinoy-com","color":"#55b8ad","shape":"site","sub":"kawalingpinoy.com","note":"Lalaine Manalo's blog of Filipino home cooking.","url":"https://www.kawalingpinoy.com/about/","suggested":true},{"name":"Flavours of Iloilo","ref":"site/flavoursofiloilo-b