"t":"dish","r":"dish/hotteok","n":"Hotteok","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Korean Chinese cuisine","dot":"#f0b340","intro":[["Hotteok, sometimes called hoeddeok, is a type of filled pancake known as a popular street food in South Korea. It originated in Qing dynasty China and was first brought into Joseon Korea during the 19th century."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-hotteok"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Hotteok"}],"sections":[{"h":"Where it's from","links":[["Korean Chinese cuisine","cuisine/korean-chinese-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Brown sugar","ingredient/brown-sugar"],["Cinnamon","ingredient/cinnamon"],["Honey","ingredient/honey"],["Peanut","ingredient/peanut"],["Wheat flour","ingredient/wheat-flour"],["Yeast","ingredient/yeast"]]},{"h":"Cook it","rows":[{"name":"Korean Bapsang","color":"#55b8ad","shape":"site","sub":"koreanbapsang.com","note":"Korean Bapsang's section on Korean Chinese dishes such as jjajangmyeon and jjamppong.","url":"https://www.koreanbapsang.com/category/korean-chinese","suggested":true,"kind":"blog"}]},{"h":"More from Korean Chinese cuisine","links":[["Jjajangmyeon","dish/jjajangmyeon"],["Jjamppong","dish/jjamppong"],["Jungguk-naengmyeon","dish/jungguk-naengmyeon"],["Ulmyeon","dish/ulmyeon"]]}],"img":{"src":"/world-cuisine/img/thumb/9/97/Hotteok.jpg/500px-Hotteok.jpg","w":500,"h":334,"by":"Korea.net / Korean Culture and Information Service (Photographer name)","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Hotteok.jpg"}},"ingredient/spring-pancake":{"t":"ingredient","r":"ingredient/spring-pancake","n":"Spring pancake","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The spring pancake is a traditional Chinese flatbread unique to the northern regions. The pancake is prepared by rubbing oil between two thin layers of leavened dough; after steaming, the pancake can be peeled apart to add fillings. People eat spring pancakes during Lichun to celebrate the beginning spring."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-spring-pancake"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Spring_pancake"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Beijing cuisine","cuisine/beijing-cuisine",[["Peking duck","dish/peking-duck"]]]]},{"h":"Often cooked with","links":[["Allium fistulosum","ingredient/allium-fistulosum"],["Duck as food","ingredient/duck-as-food"],["Tianmianjiang","ingredient/tianmianjiang"]]}],"img":{"src":"/world-cuisine/img/thumb/a/af/Spring_Pancake.jpg/500px-Spring_Pancake.jpg","w":500,"h":378,"by":"Yoshi Canopus","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Spring_Pancake.jpg"}},"ingredient/sorghum":{"t":"ingredient","r":"ingredient/sorghum","n":"Sorghum","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Sorghum () or broomcorn is a genus of about 28 species of flowering plants in the grass family (Poaceae). Sorghum bicolor is grown as a cereal for human consumption and as animal fodder."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sorghum"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sorghum_(genus)"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Ghanaian cuisine","cuisine/ghanaian-cuisine",[["Pito (beer)","dish/pito-beer"]]]]},{"h":"Where it's grown","grown":{"what":"Sorghum","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":59879526,"top":[["United States of America","cuisine/american-cuisine",8484752],["Nigeria","cuisine/nigerian-cuisine",6604894],["Mexico","cuisine/mexican-cuisine",4635596],["India","cuisine/indian-cuisine",4554702],["Ethiopia","cuisine/ethiopian-cuisine",4488944],["Sudan","cuisine/sudanese-cuisine",4046813],["Brazil","cuisine/brazilian-cuisine",3357490],["China","cuisine/chinese-cuisine",3092266],["Argentina","cuisine/argentine-cuisine",2427638],["Ashmore and Cartier Is.","cuisine/australian-cuisine",1890375],["Burkina Faso","cuisine/burkinabe-cuisine",1833837],["Niger","cuisine/cuisine-of-niger",1809982],["Mali","cuisine/malian-cuisine",1566920],["Cameroon","cuisine/cameroonian-cuisine",1172128],["Bolivia","cuisine/bolivian-cuisine",1150616]]}},{"h":"Often cooked with","links":[["Millet","ingredient/millet"]]}],"img":{"src":"/world-cuisine/img/thumb/d/df/Sorghum.jpg/500px-Sorghum.jpg","w":500,"h":338,"by":"Larry Rana, USDA","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Sorghum.jpg"}},"dish/piyanggang-manok":{"t":"dish","r":"dish/piyanggang-manok","n":"Piyanggang manok","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#f0b340","intro":[["Piyanggang manok, also spelled pyanggang manuk, is a Filipino dish consisting of chicken braised in turmeric, onions, lemongrass, ginger, siling haba chilis, garlic, coconut milk, and ground burnt coconut. It originates from the Tausug people of Sulu. It is related to tiyula itum, another Tausug dish which uses burnt coconut. The dish is characteristically black in color. The meat may also be grilled before adding the marinade. It is a type of ginataan."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-piyanggang-manok"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Piyanggang_manok"}],"sections":[{"h":"Where it's from","links":[["Filipino cuisine","cuisine/filipino-cuisine"],["Mindanao cuisine","cuisine/filipino-cuisine-mindanao"],["Visayan cuisine","cuisine/filipino-cuisine-visayas"]]},{"h":"Ingredients","count":6,"links":[["Chicken","ingredient/chicken"],["Coconut milk","ingredient/coconut-milk"],["Garlic","ingredient/garlic"],["Lemongrass","ingredient/lemongrass"],["Siling haba","ingredient/siling-haba"],["Turmeric","ingredient/turmeric"]]},{"h":"Cook it","rows":[{"name":"Panlasang Pinoy","color":"#55b8ad","shape":"site","sub":"panlasangpinoy.com","note":"Vanjo Merano's large library of Filipino recipes and cooking videos.","url":"https://panlasangpinoy.com/filipino-food/","suggested":true,"kind":"blog"},{"name":"Kawaling Pinoy","color":"#55b8ad","shape":"site","sub":"kawalingpinoy.com","note":"Lalaine Manalo's blog of Filipino home cooking.","url":"https://www.kawalingpinoy.com/about/","suggested":true,"kind":"blog"},{"name":"Flavours of Iloilo","color":"#55b8ad","shape":"site","sub":"flavoursofiloilo.blogspot.com","note":"Blog of Ilonggo home dishes from Iloilo in the Western Visayas.","url":"https://flavoursofiloilo.blogspot.com/2013/05/how-about-some-chicken-binakol.html","suggested":true,"kind":"blog"}]},{"h":"More from Filipino cuisine","links":[["Adobo (Filipino dish)","dish/adobo-filipino-dish"],["Aparon","dish/aparon"],["Banana ketchup","dish/banana-ketchup"],["Champorado","dish/champorado"],["Filipino barbecue","dish/filipino-barbecue"],["Food for the gods","dish/food-for-the-gods"],["Isaw","dish/isaw"],["Kadyos, baboy, kag langka","dish/kadyos-baboy-kag-langka"],["Kadyos, manok, kag ubad","dish/kadyos-manok-kag-ubad"],["Kumukunsi","dish/kumukunsi"],["Mango float","dish/mango-float"],["Palapa (condiment)","dish/palapa-condiment"],["Pastil","dish/pastil"],["Piaparan","dish/piaparan"],["Pilipit","dish/pilipit"],["Sushi bake","dish/sushi-bake"],["Tortang talong","dish/tortang-talong"]]}]},"dish/soki":{"t":"dish","r":"dish/soki","n":"Soki","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Okinawan cuisine","dot":"#f0b340","intro":[["Sōki is an ingredient of Okinawan cuisine. Sōki are (usually boneless) stewed pork spare ribs, with the cartilage still attached. They are often served with Okinawa soba (called suba)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-soki"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Soki"}],"sections":[{"h":"Where it's from","links":[["Okinawan cuisine","cuisine/okinawan-cuisine"]]}],"img":{"src":"/world-cuisine/img/thumb/f/fa/Okinawa_soba_1.jpg/500px-Okinawa_soba_1.jpg","w":500,"h":375,"by":"Hiroshi Ishii","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Okinawa_soba_1.jpg"}},"ingredient/congee":{"t":"ingredient","r":"ingredient/congee","n":"Congee","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Congee is a form of savoury porridge, primarily made by boiling rice in large amount of water until it softens or dissolves, and commonly flavored with salt or mild broth. Depending on the rice–water ratio, the thickness of congee varies from a Western oatmeal porridge to a gruel. Congee is typically served with side dishes, or it can be topped with meat, fish, and pickled vegetables."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-congee"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Congee"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Tinutuan","dish/tinutuan"]]]]},{"h":"Often cooked with","links":[["Corncob","ingredient/corncob"],["Cucurbita","ingredient/cucurbita"],["Granulated sugar","ingredient/granulated-sugar"],["Holy basil","ingredient/holy-basil"],["Ipomoea aquatica","ingredient/ipomoea-aquatica"],["Rice","ingredient/rice"],["Salt-cured meat","ingredient/salt-cured-meat"],["Sweet potato","ingredient/sweet-potato"],["Tapioca","ingredient/tapioca"]]}],"img":{"src":"/world-cuisine/img/thumb/5/58/Chinese_rice_congee.jpg/500px-Chinese_rice_congee.jpg","w":500,"h":500,"by":"Daiju Azuma","lic":"CC BY-SA 2.5","licUrl":"https://creativecommons.org/licenses/by-sa/2.5","page":"https://commons.wikimedia.org/wiki/File:Chinese_rice_congee.jpg"}},"ingredient/tonkatsu":{"t":"ingredient","r":"ingredient/tonkatsu","n":"Tonkatsu","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 1 cuisine","intro":[["Tonkatsu is a type of Japanese cutlet (カツレツ, katsuretsu) made from pork. Slices of pork loin or fillet are coated with panko (bread crumbs) and then deep-fried in oil."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tonkatsu"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tonkatsu"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Yoshoku","cuisine/yoshoku",[["Toruko rice","dish/toruko-rice"],["Volga rice","dish/volga-rice"]]]]},{"h":"Often cooked with","links":[["Pilaf","ingredient/pilaf"],["Spaghetti","ingredient/spaghetti"],["Breaded cutlet","ingredient/breaded-cutlet"],["Fried rice","ingredient/fried-rice"],["Omelette","ingredient/omelette"],["Omurice","ingredient/omurice"]]}],"img":{"src":"/world-cuisine/img/thumb/9/93/%22Amai-Yuwaku%22_Special_Loin_Pork_Cutlet1.jpg/500px-%22Amai-Yuwaku%22_Special_Loin_Pork_Cutlet1.jpg","w":500,"h":374,"by":"ＫｏＺ","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%22Amai-Yuwaku%22_Special_Loin_Pork_Cutlet1.jpg"}},"ingredient/eulachon":{"t":"ingredient","r":"ingredient/eulachon","n":"Eulachon","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 0 dishes across 0 cuisines","intro":[["A small, oily smelt that runs up coastal rivers in spring. Tlingit, Tsimshian and other Northwest Coast peoples eat it fresh, smoked, or rendered into a prized oil."]],"src":"note","sources":[],"actions":[{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Eulachon"}],"sections":[{"h":"Mentioned in","links":[["Tlingit cuisine","cuisine/tlingit-cuisine"],["Tsimshian foodways","cuisine/tsimshian-foodways"]]}]}}