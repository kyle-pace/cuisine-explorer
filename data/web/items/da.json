],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Tyrolean speck is a distinctively juniper-flavored ham originally from Tyrol, a historical Austrian region that since 1918 partially lies in Italy. Its origins at the intersection of two culinary worlds are reflected in its synthesis of salt-curing and smoking."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tyrolean-speck"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tyrolean_speck"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["British cuisine","cuisine/british-cuisine",[["Black pudding","dish/black-pudding"]]],["Irish cuisine","cuisine/irish-cuisine",[["Black pudding","dish/black-pudding"]]]]},{"h":"Often cooked with","links":[["Blood as food","ingredient/blood-as-food"],["Butter","ingredient/butter"],["Cream","ingredient/cream"],["Egg yolk","ingredient/egg-yolk"],["Suet","ingredient/suet"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/labs/cuisines/img/thumb/6/66/Fresh_speck.jpg/500px-Fresh_speck.jpg","w":500,"h":667,"by":"Hagen + Tine Graf","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Fresh_speck.jpg"}},"ingredient/fish-stock":{"t":"ingredient","r":"ingredient/fish-stock","n":"Fish stock","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["Stock, sometimes called bone broth, is a savory cooking liquid that forms the basis of many dishes – particularly soups, stews, and sauces. Making stock involves simmering animal bones, meat, seafood, or vegetables in water or wine, often for an extended period. Mirepoix or other aromatics may be added for more flavor."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-fish-stock"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fish_stock_(food)"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["Andalusian cuisine","cuisine/andalusian-cuisine",[["Gazpachuelo","dish/gazpachuelo"]]]]},{"h":"Often cooked with","links":[["Egg yolk","ingredient/egg-yolk"],["Mayonnaise","ingredient/mayonnaise"],["Olive oil","ingredient/olive-oil"]]}]},"ingredient/sherry":{"t":"ingredient","r":"ingredient/sherry","n":"Sherry","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 4 cuisines","intro":[["Sherry is a fortified wine produced from white grapes grown around the city of Jerez de la Frontera in Andalusia, Spain. Sherry is a drink produced in a variety of styles made primarily from the Palomino grape, ranging from light versions similar to white table wines, such as Manzanilla and fino, to darker and heavier versions that have been allowed to oxidise as they age in barrel, such as Amontillado and oloroso. Sweet dessert wines are also made from Pedro Ximénez or Moscatel grapes, and are sometimes blended with Palomino-based sherries."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-sherry"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Sherry"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["American cuisine","cuisine/american-cuisine",[["Lobster Thermidor","dish/lobster-thermidor"]]],["French cuisine","cuisine/french-cuisine",[["Lobster Thermidor","dish/lobster-thermidor"]]],["Galician cuisine","cuisine/galician-cuisine",[["Tarta de Santiago","dish/tarta-de-santiago"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Lobster Thermidor","dish/lobster-thermidor"]]]]},{"h":"Often cooked with","links":[["Egg","ingredient/egg"],["Brandy","ingredient/brandy"],["Egg yolk","ingredient/egg-yolk"],["Lobster meat","ingredient/lobster-meat"],["Mustard (condiment)","ingredient/mustard-condiment"],["Almond","ingredient/almond"],["Almond meal","ingredient/almond-meal"],["Butter","ingredient/butter"],["Cinnamomum verum","ingredient/cinnamomum-verum"],["Powdered sugar","ingredient/powdered-sugar"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]}]},"dish/matnakash":{"t":"dish","r":"dish/matnakash","n":"Matnakash","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Armenian cuisine","dot":"#f0b340","intro":[["Matnakash is a leavened traditional Armenian bread. The word matnakash means \"finger draw\" or \"finger pull\", referring to the way the bread is prepared. It is made of wheat flour with yeast or sourdough starter. It is shaped into oval or round loaves with longitudinal or criss-crossed scoring. The characteristic golden or golden-brown color of its crust is achieved by coating the surface of the loaves with sweetened tea essence before baking."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-matnakash"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Matnakash"}],"sections":[{"h":"Where it's from","links":[["Armenian cuisine","cuisine/armenian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Sourdough starter","ingredient/sourdough-starter"],["Wheat flour","ingredient/wheat-flour"],["Yeast","ingredient/yeast"]]},{"h":"Cook it","rows":[{"name":"The Armenian Kitchen","color":"#55b8ad","shape":"site","sub":"thearmeniankitchen.com","note":"Armenian-American blog of family recipes and reviews of Armenian cookbooks.","url":"https://www.thearmeniankitchen.com/classic-armenian-recipes-another/","suggested":true,"kind":"blog"}]},{"h":"More from Armenian cuisine","links":[["Alani (dried fruit)","dish/alani-dried-fruit"],["Baba ghanoush","dish/baba-ghanoush"],["Bagharj","dish/bagharj"],["Cabbage roll","dish/cabbage-roll"],["İmam bayıldı","dish/imam-bay-ld"],["Khash (dish)","dish/khash-dish"],["Khorovats","dish/khorovats"],["Lavash","dish/lavash"],["Mikado cake","dish/mikado-cake"],["Pilaf","dish/pilaf"],["Pirozhki","dish/pirozhki"],["Spas (soup)","dish/spas-soup"],["Tjvjik (food)","dish/tjvjik-food"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a8/Matnakash.JPG/500px-Matnakash.JPG","w":500,"h":375,"by":"Narek75","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Matnakash.JPG"}},"dish/roti":{"t":"dish","r":"dish/roti","n":"Roti","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Bengali cuisine","dot":"#f0b340","intro":[["Roti is a round flatbread originating from the Indian subcontinent. It is commonly consumed in many South Asian, Southeast Asian, Caribbean, East African, and Southeast African countries."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-roti"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Roti"}],"sections":[{"h":"Where it's from","links":[["Bengali cuisine","cuisine/bengali-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Atta","ingredient/atta"],["Atta flour","ingredient/atta-flour"]]},{"h":"Cook it","rows":[{"name":"Playful Cooking (Bengali cuisine)","color":"#55b8ad","shape":"site","sub":"playfulcooking.com","note":"Bengali section of Kankana Saxena's home cooking blog.","url":"https://www.playfulcooking.com/category/bengali-cuisine","suggested":true,"kind":"blog"}]},{"h":"More from Bengali cuisine","links":[["Chutney","dish/chutney"],["Pilaf","dish/pilaf"],["Sarbhaja","dish/sarbhaja"]]}],"img":{"src":"/labs/cuisines/img/thumb/f/f8/Ruti_%28%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A6%BF%29.jpg/500px-Ruti_%28%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A6%BF%29.jpg","w":500,"h":375,"by":"HridoyKundu","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Ruti_(%E0%A6%B0%E0%A7%81%E0%A6%9F%E0%A6%BF).jpg"}},"ingredient/bouquet-garni":{"t":"ingredient","r":"ingredient/bouquet-garni","n":"Bouquet garni","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 1 cuisine","intro":[["The bouquet garni is a bundle of herbs usually tied with string and mainly used to prepare soup, stock, casseroles and various stews. The bouquet is cooked with the other ingredients and removed prior to consumption. Liquid remaining in the bouquet garni can be wrung out into the dish."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-bouquet-garni"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Bouquet_garni"}],"sections":[{"h":"Where it's cooked with","count":1,"groups":[["English cuisine","cuisine/english-cuisine",[["Windsor soup","dish/windsor-soup"]]]]},{"h":"Often cooked with","links":[["Broth","ingredient/broth"],["Carrot","ingredient/carrot"],["Madeira wine","ingredient/madeira-wine"],["Noodles","ingredient/noodles"],["Rice","ingredient/rice"]]}],"img":{"src":"/labs/cuisines/img/thumb/0/07/Bouquet_garni_p1150476_extracted.jpg/500px-Bouquet_garni_p1150476_extracted.jpg","w":500,"h":477,"by":"David Monniaux","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Bouquet_garni_p1150476_extracted.jpg"}}}