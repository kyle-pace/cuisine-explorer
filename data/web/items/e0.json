{"cuisine/liaoning-cuisine":{"t":"cuisine","r":"cuisine/liaoning-cuisine","n":"Liaoning cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Northeastern Chinese cuisine","cuisine/northeastern-chinese-cuisine"]],"sub":"Regional cuisine in China","intro":[["Liaoning cuisine is derived from the native cooking styles of the Liaoning Province in China. It is the most famous Northeastern Chinese cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"liaoning-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Liaoning_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Northeastern Chinese cuisine","cuisine/northeastern-chinese-cuisine"]]},{"h":"Part of","links":[["Northeastern Chinese cuisine","cuisine/northeastern-chinese-cuisine"]]}],"cont":"Asian cuisine"},"cuisine/southern-thai-cuisine":{"t":"cuisine","r":"cuisine/southern-thai-cuisine","n":"Southern Thai cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Thai cuisine","cuisine/thai-cuisine"]],"sub":"Regional cuisine in Thailand","intro":[],"src":null,"wiki":"Southern Thai cuisine","actions":[{"kind":"globe","hash":"southern-thai-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Southern_Thai_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Thai cuisine","cuisine/thai-cuisine"]]},{"h":"Cookbooks","count":2,"rows":[{"name":"Kalaya's Southern Thai Kitchen","ref":"cookbook/kalaya-s-southern-thai-kitchen","color":"#f0b340","shape":"book","sub":"Nok Suntaranon and Natalie Jesionka, 2024","note":"Southern Thai recipes from the chef of Kalaya in Philadelphia.","url":"https://openlibrary.org/isbn/9780593580875","suggested":true},{"name":"The Food of Southern Thailand","ref":"cookbook/the-food-of-southern-thailand","color":"#f0b340","shape":"book","sub":"Austin Bush","note":"Recipes and photography documenting southern Thai regional cooking.","url":"https://wwnorton.co.uk/books/9780393541694-the-food-of-southern-thailand","suggested":true}]},{"h":"Part of","links":[["Thai cuisine","cuisine/thai-cuisine"]]}],"cont":"Asian cuisine"},"cuisine/street-food":{"t":"cuisine","r":"cuisine/street-food","n":"Street food","c":"#a99fb5","crumb":[["Cuisine"]],"sub":"Style of cooking","intro":[["Street food is food sold by a hawker or vendor on a street or at another public place, such as a market, fair, or park. It is often sold from a portable food booth, food cart, or food truck and is meant for immediate consumption. Some street foods are regional, but many have spread beyond their regions of origin. Most street foods are classified as both finger food and fast food, and are generally cheaper than restaurant meals. The types of street food vary between regions and cultures in different countries around the world. According to a 2007 study from the Food and Agriculture Organization, 2.5 billion people eat street food every day.  While some cultures consider it to be rude to walk on the street while eating, a majority of middle- to high-income consumers rely on the quick access and affordability of street food for daily nutrition and job opportunities, particularly in developing countries."],["Today governments and other organizations are increasingly concerned with both the socioeconomic importance of street food and its associated risks. These risks include food safety, sanitation issues, illegal use of public or private areas, social problems, and traffic congestion."]],"src":"wikipedia","actions":[{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Street_food"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[]}],"cont":null},"cuisine/eeyou-cree-foodways":{"t":"cuisine","r":"cuisine/eeyou-cree-foodways","n":"Eeyou Cree foodways","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Native American cuisine","cuisine/native-american-cuisine"]],"sub":"Indigenous foodways, Eeyou Istchee, James Bay region, Quebec","names":"Eeyou, Cree","intro":[["For the Eeyou of Eeyou Istchee, in the James Bay region of Quebec, the year follows the hunt. In spring, goose break empties the towns as families head to their bush camps, children learn to call geese, and goose is roasted slowly over an open fire for hours, twisting on a cord as it cooks."],[["Moose","ingredient/moose"],", ",["Caribou","ingredient/reindeer"],", bear, beaver, snowshoe hare, ducks, ptarmigan and fish are all traditional foods, along with blueberries, cranberries, raspberries and strawberries. The Cree Nation Government and Cree Board of Health track how a changing climate affects each of them."]],"src":"note","sources":[{"name":"APTN News, Goose hunting in the Cree community of Waswanipi far from disappearing","url":"https://www.aptnnews.ca/national-news/goose-hunting-in-the-cree-community-of-waswanipi-far-from-disappearing/"},{"name":"Cree Nation Government and Cree Board of Health and Social Services of James Bay, Traditional food and climate change","url":"https://www.cngov.ca/wp-content/uploads/2026/08/traditional-food-and-climate-change-factsheet.pdf"}],"actions":[{"kind":"globe","hash":"eeyou-cree-foodways"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Native American cuisine","cuisine/native-american-cuisine"]]},{"h":"Part of","links":[["Native American cuisine","cuisine/native-american-cuisine"]]}],"cont":"Cuisine of the Americas"},"cuisine/guarani-foodways":{"t":"cuisine","r":"cuisine/guarani-foodways","n":"Guaraní foodways","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Native American cuisine","cuisine/native-american-cuisine"]],"sub":"Indigenous foodways, Paraguay, southern Brazil, northeastern Argentina and Bolivia","names":"Guaraní, among them Mbyá and Avá Guaraní","intro":[["For the Guaraní, ",["corn","ingredient/maize"],", avaxi, is sacred. Mbyá families in Brazil's Atlantic Forest keep old varieties like avaxi etei, and some foods are meant for certain times: one corn is recommended for new mothers, eaten with purple ",["sweet potato","ingredient/sweet-potato"],". Jera Guarani and community elders gathered corn recipes in a book called Ara Pyau, new time."],["Mbyá women pound corn into dough with a pestle for a corn cake baked in a clay pot over coals in a hole in the ground, covered with banana leaves, and they make ",["chipa","dish/chipa"]," too. Long before wheat arrived, the Guaraní relied on ",["manioc","ingredient/cassava"]," as much as on corn, and in Paraguay chipa of manioc flour is still baked in a tatakua, a brick and mud oven whose Guaraní name means fire hole."]],"src":"note","sources":[{"name":"Synchronicity Earth, A window into Guarani Mbyá food culture","url":"https://www.synchronicityearth.org/guarani-mbya-food-culture/"},{"name":"Slow Food Foundation, Ark of Taste, Guarani Mbya bolo de milho","url":"https://www.fondazioneslowfood.com/en/ark-of-taste-slow-food/guarani-mbya-bolo-de-milho/"},{"name":"Gastronomica, Making chipas in Paraguay","url":"https://gastronomica.org/2009/05/04/making-chipas-paraguay/"}],"actions":[{"kind":"globe","hash":"guarani-foodways"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Native American cuisine","cuisine/native-american-cuisine"]]},{"h":"Dishes","count":1,"links":[["Chipá","dish/chipa"]]},{"h":"Key ingredients","links":[["Cassava","ingredient/cassava"],["Lard","ingredient/lard"],["Egg","ingredient/egg"],["Milk","ingredient/milk"],["Anise","ingredient/anise"],["Cheese","ingredient/cheese"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["Native American cuisine","cuisine/native-american-cuisine"]]}],"cont":"Cuisine of the Americas"},"ingredient/skipjack-tuna":{"t":"ingredient","r":"ingredient/skipjack-tuna","n":"Skipjack tuna","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["The skipjack tuna (Katsuwonus pelamis) is a perciform fish in the tuna family, Scombridae, and is the only member of the genus Katsuwonus. It is a cosmopolitan pelagic fish found in tropical and warm-temperate waters. Skipjack tuna can grow up to 1.1 m (3 ft 7 in) in length, and is a very important species for fisheries."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-skipjack-tuna"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Skipjack_tuna"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Bekasang","dish/bekasang"],["Keumamah","dish/keumamah"]]],["Acehnese cuisine","cuisine/acehnese-cuisine",[["Keumamah","dish/keumamah"]]]]},{"h":"Often cooked with","links":[["Bird's eye chili","ingredient/bird-s-eye-chili"],["Black pepper","ingredient/black-pepper"],["Garlic","ingredient/garlic"],["Ginger","ingredient/ginger"],["Thunnus tonggol","ingredient/thunnus-tonggol"],["Tuna","ingredient/tuna"]]}],"img":{"src":"/labs/cuisines/img/d/d9/Katsuwonus_pelamis.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","w":500,"h":302,"by":"Unknown authorUnknown author","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Katsuwonus_pelamis.png"}},"ingredient/piper-retrofractum":{"t":"ingredient","r":"ingredient/piper-retrofractum","n":"Piper retrofractum","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["Piper retrofractum, the Balinese long pepper or Javanese long pepper, is a flowering vine in the family Piperaceae, cultivated for its fruit, which is usually dried and used as a spice and seasoning. This species is native to Java island in Indonesia."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-piper-retrofractum"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Piper_retrofractum"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Betawi cuisine","cuisine/betawi-cuisine",[["Bir pletok","dish/bir-pletok"]]],["Indonesian cuisine","cuisine/indonesian-cuisine",[["Bir pletok","dish/bir-pletok"]]]]},{"h":"Often cooked with","links":[["Biancaea sappan","ingredient/biancaea-sappan"],["Cardamom","ingredient/cardamom"],["Cinnamon","ingredient/cinnamon"],["Ginger","ingredient/ginger"],["Illicium verum","ingredient/illicium-verum"],["Lemongrass","ingredient/lemongrass"],["Nigella sativa","ingredient/nigella-sativa"],["Pandan","ingredient/pandan"],["Sugar","ingredient/sugar"]]}]},"ingredient/mirepoix":{"t":"ingredient","r":"ingredient/mirepoix","n":"Mirepoix","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 2 cuisines","intro":[["A mirepoix is a mixture of diced vegetables cooked with fat (usually butter) for a long time on low heat without colouring or browning. The ingredients are not sautéed or otherwise hard-cooked, because the intention is to sweeten rather than caramelise them. Historically including various meats before settling at its current meaning as a vegetable base, mirepoix is a long-standing part of French cuisine and is the flavour base for a wide variety of dishes, including stocks, soups, stews, and sauces."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-mirepoix"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Mirepoix"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["French cuisine","cuisine/french-cuisine",[["Blanquette de veau","dish/blanquette-de-veau"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Blanquette de veau","dish/blanquette-de-veau"]]]]},{"h":"Often cooked with","links":[["Mirepoix (cuisine)","ingredient/mirepoix-cuisine"],["Veal","ingredient/veal"]]}]},"ingredient/tapioca":{"t":"ingredient","r":"ingredient/tapioca","n":"Tapioca","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 11 dishes across 4 cuisines","intro":[["Tapioca is a starch extracted from the tubers of the cassava plant (Manihot esculenta, also known as manioc), a species native to the North and Northeast regions of Brazil, but which is now found in West Africa, Southeast Asia, and elsewhere. It is a perennial shrub adapted to the hot conditions of tropical lowlands. Cassava copes better with poor soils than many other food plants."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-tapioca"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tapioca"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Burgo (food)","dish/burgo-food"],["Cilok","dish/cilok"],["Kue gapit","dish/kue-gapit"],["Kue rangi","dish/kue-rangi"],["Kue talam","dish/kue-talam"],["Pempek","dish/pempek"],["Siomay","dish/siomay"],["Tinutuan","dish/tinutuan"]]],["Vietnamese cuisine","cuisine/vietnamese-cuisine",[["Bánh bột lọc","dish/banh-bot-loc"],["Bánh tráng","dish/banh-trang"]]],["Palembang cuisine","cuisine/palembang-cuisine",[["Pempek","dish/pempek"]]],["Thai cuisine","cuisine/thai-cuisine",[["Rad naa","dish/rad-naa"]]]]},{"h":"Often cooked with","links":[["Coconut milk","ingredient/coconut-milk"],["Rice flour","ingredient/rice-flour"],["Wheat flour","ingredient/wheat-flour"],["Egg","ingredient/egg"],["Palm sugar","ingredient/palm-sugar"],["Garlic","ingredient/garlic"],["Sweet potato","ingredient/sweet-potato"],["Peanut sauce","ingredient/peanut-sauce"],["Sugar","ingredient/sugar"],["Noodles","ingredient/noodles"],["Candlenut","ingredient/candlenut"],["Channa striata","ingredient/channa-striata"],["Coriander","ingredient/coriander"],["Galangal","ingredient/galangal"],["Kencur","ingredient/kencur"],["Pork belly","ingredient/pork-belly"]]}]},"dish/chutney":{"t":"dish","r":"dish/chutney","n":"Chutney","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["A chutney is a condiment associated with cuisines of the Indian subcontinent. Chutneys are made in a wide variety of forms, some raw such as with coriander, others cooked with sugar, like mango chutney. During the British Raj, Anglo-Indian cuisine adapted Indian chutney and brought it back to Britain, where green mango chutney in particular became popular. In the Western world, chutneys may be made with local fruits and vegetables, or purchased."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-chutney"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chutney"}],"sections":[{"h":"Where it's from","links":[["Bengali cuisine","cuisine/bengali-cuisine"],["Kerala cuisine","cuisine/kerala-cuisine"]]},{"h":"Ingredients","count":2,"links":[["Coconut","ingredient/coconut"],["Sodium chloride","ingredient/sodium-chloride"]]},{"h":"Cook it","rows":[{"name":"Playful Cooking (Bengali cuisine)","ref":"site/playfulcooking-com","color":"#55b8ad","shape":"site","sub":"playfulcooking.com","note":"Bengali section of Kankana Saxena's home cooking blog.","url":"https://www.playfulcooking.com/category/bengali-cuisine","suggested":true},{"name":"Yummy Tummy Aarthi (South Indian)","ref":"site/yummytummyaarthi-com","color":"#55b8ad","shape":"site","sub":"yummytummyaarthi.com","note":"Kerala section of Aarthi's large South Indian home cooking blog.","url":"https://yummytummyaarthi.com/recipes/kerala","suggested":true}]},{"h":"More from Bengali cuisine","links":[["Pilaf","dish/pilaf"],["Roti","dish/roti"],["Sarbhaja","dish/sarbhaja"]]}]},"dish/cobb-salad":{"t":"dish","r":"dish/cobb-salad","n":"Cobb salad","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from American cuisine","dot":"#94bd5c","intro":[["The Cobb salad is an American salad typically made with chopped salad greens (authentically romaine lettuce), tomato, bacon, chicken breast, hard-boiled eggs, avocado, chives, blue cheese (often Roquefort; some versions use other cheeses such as cheddar or Monterey Jack, or no cheese at all) and red wine vinaigrette. The ingredients are laid out separately, often in neat rows. It is served as a main course."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-cobb-salad"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cobb_salad"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"]]},{"h":"Ingredients","count":12,"links":[["Avocado","ingredient/avocado"],["Bacon","ingredient/bacon"],["Blue cheese","ingredient/blue-cheese"],["Cheese","ingredient/cheese"],["Chicken","ingredient/chicken"],["Chicken breast","ingredient/chicken-breast"],["Egg","ingredient/egg"],["Iceberg lettuce","ingredient/iceberg-lettuce"],["Lactuca","ingredient/lactuca"],["Romaine lettuce","ingredient/romaine-lettuce"],["Tomato","ingredient/tomato"],["Vinaigrette","ingredient/vinaigrette"]]},{"h":"More from American cuisine","links":[["5-8 Club","dish/5-8-club"],["Altabira City Tavern","dish/altabira-city-tavern"],["Angel food cake","dish/angel-food-cake"],["Applebee's","dish/applebee-s"],["Arby's","dish/arby-s"],["Arnold's Bar and Grill","dish/arnold-s-bar-and-grill"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Be Our Guest Restaurant","dish/be-our-guest-restaurant"],["Beer cake","dish/beer-cake"],["Ben's Chili Bowl","dish/ben-s-chili-bowl"],["Benjy's","dish/benjy-s"],["Besaw's","dish/besaw-s"],["Better than sex cake","dish/better-than-sex-cake"],["Blackhawk (restaurant)","dish/blackhawk-restaurant"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Bobcat Bite","dish/bobcat-bite"],["Boiling Springs Tavern","dish/boiling-springs-tavern"],["Brix Tavern","dish/brix-tavern"],["Brown Betty (dessert)","dish/brown-betty-dessert"],["Brown Derby","dish/brown-derby"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Buona","dish/buona"],["Busboys and Poets","dish/busboys-and-poets"],["Butter cake","dish/butter-cake"],["Byways Cafe","dish/byways-cafe"],["Caesar salad","dish/caesar-salad"],["California Grill","dish/california-grill"],["Camp Washington Chili","dish/camp-washington-chili"],["Caramel apple","dish/caramel-apple"],["Carbonara","dish/c