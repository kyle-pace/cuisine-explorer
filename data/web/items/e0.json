ested":true,"kind":"blog"},{"name":"Lil Vienna","color":"#55b8ad","shape":"site","sub":"lilvienna.com","note":"Austrian recipes from Ursula and David, two Austrians living in Boston.","url":"https://www.lilvienna.com/?p=1366","suggested":true,"kind":"blog"},{"name":"Zsuzsa Is in the Kitchen","color":"#55b8ad","shape":"site","sub":"zsuzsaisinthekitchen.blogspot.com","note":"Hungarian-born home cook's blog of traditional Hungarian recipes.","url":"https://zsuzsaisinthekitchen.blogspot.com/2010/01","suggested":true,"kind":"blog"},{"name":"Slovak Cooking","color":"#55b8ad","shape":"site","sub":"slovakcooking.com","note":"English-language site of Slovak home recipes started by a young Slovak cook.","url":"https://www.slovakcooking.com/about/","suggested":true,"kind":"blog"}]},{"h":"More from Austrian cuisine","links":[["Blini","dish/blini"],["Cabbage roll","dish/cabbage-roll"],["Chicken paprikash","dish/chicken-paprikash"],["Dampfnudel","dish/dampfnudel"],["Egg puffs and soup pearls","dish/egg-puffs-and-soup-pearls"],["Gulyásleves","dish/gulyasleves"],["Leberkäse","dish/leberkase"],["Liptauer","dish/liptauer"],["Pancake","dish/pancake"],["Potato salad","dish/potato-salad"],["Sachertorte","dish/sachertorte"],["Spätzle","dish/spatzle"],["Strudel","dish/strudel"],["Zopf","dish/zopf"]]}],"img":{"src":"/world-cuisine/img/thumb/6/63/Tarhonya-3.JPG/500px-Tarhonya-3.JPG","w":500,"h":449,"by":"Nillerdk","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Tarhonya-3.JPG"}},"dish/tzatziki":{"t":"dish","r":"dish/tzatziki","n":"Tzatziki","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Greek cuisine","dot":"#cf5f87","intro":[["Tzatziki, also known as cacık (Turkish: [dʒaˈdʒɯk] ) or tarator, is a class of dip, soup, or sauce found in the cuisines of Southeastern Europe and West Asia. It is made of salted strained yogurt or diluted yogurt mixed with cucumbers, garlic, salt, olive oil, red wine vinegar, sometimes with lemon juice, and herbs such as dill, mint, parsley and thyme. It is served as a cold appetiser (meze), a side dish, and as a sauce for souvlaki and gyros sandwiches and other foods."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-tzatziki"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tzatziki"}],"sections":[{"h":"Where it's from","links":[["Greek cuisine","cuisine/greek-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Cucumber","ingredient/cucumber"],["Olive oil","ingredient/olive-oil"],["Strained yogurt","ingredient/strained-yogurt"],["Yogurt","ingredient/yogurt"]]},{"h":"Cook it","rows":[{"name":"Dimitra's Dishes","color":"#55b8ad","shape":"site","sub":"dimitrasdishes.com","note":"Dimitra Alfieris's video channel and blog focused on classic Greek home cooking.","url":"https://dimitrasdishes.com","suggested":true,"kind":"youtube"}]},{"h":"More from Greek cuisine","links":[["Avgolemono","dish/avgolemono"],["Baba ghanoush","dish/baba-ghanoush"],["Bouyiourdi","dish/bouyiourdi"],["Cabbage roll","dish/cabbage-roll"],["Diples","dish/diples"],["Fasolada","dish/fasolada"],["Freddo cappuccino","dish/freddo-cappuccino"],["Greek restaurant","dish/greek-restaurant"],["Greek salad","dish/greek-salad"],["İmam bayıldı","dish/imam-bay-ld"],["Kakavia (soup)","dish/kakavia-soup"],["Kalitsounia","dish/kalitsounia"],["Karydopita","dish/karydopita"],["Keşkek","dish/keskek"],["Ladera","dish/ladera"],["Noumboulo","dish/noumboulo"],["Psarosoupa","dish/psarosoupa"],["Spanakorizo","dish/spanakorizo"],["Taramasalata","dish/taramasalata"]]}],"img":{"src":"/world-cuisine/img/thumb/8/8e/Tzatiki_%283656301454%29.jpg/500px-Tzatiki_%283656301454%29.jpg","w":500,"h":324,"by":"Vegan Feast Catering","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Tzatiki_(3656301454).jpg"}}}