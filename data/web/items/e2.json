"cuisine/indian-cuisine",9827541],["Russia","cuisine/russian-cuisine",2448353],["South Korea","cuisine/korean-cuisine",2433494],["Ukraine","cuisine/ukrainian-cuisine",1632598],["Japan","cuisine/japanese-cuisine",1444853],["Indonesia","cuisine/indonesian-cuisine",1440078],["Ethiopia","cuisine/ethiopian-cuisine",1208135],["Vietnam","cuisine/vietnamese-cuisine",1138065],["Kenya","cuisine/kenyan-cuisine",1066829],["United States of America","cuisine/american-cuisine",967245],["Turkey","cuisine/turkish-cuisine",915403],["Uzbekistan","cuisine/uzbek-cuisine",758011],["North Korea","cuisine/north-korean-cuisine",698170],["Germany","cuisine/german-cuisine",693686]]}},{"h":"Often cooked with","links":[["Onion","ingredient/onion"],["Potato","ingredient/potato"],["Scallion","ingredient/scallion"],["Chili pepper","ingredient/chili-pepper"],["Carrot","ingredient/carrot"],["Ground meat","ingredient/ground-meat"],["Rice","ingredient/rice"],["Broth","ingredient/broth"],["Pork","ingredient/pork"],["Beef","ingredient/beef"],["Bacon","ingredient/bacon"],["Brassica oleracea","ingredient/brassica-oleracea"],["Sauerkraut","ingredient/sauerkraut"],["Black pepper","ingredient/black-pepper"],["Celery","ingredient/celery"],["Goat","ingredient/goat"]]}]},"ingredient/beans":{"t":"ingredient","r":"ingredient/beans","n":"Beans","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 6 cuisines","intro":[["A bean is the seed of plants in many genera of the legume family (Fabaceae) used as a vegetable for human consumption or animal feed. The seeds are sold fresh or preserved through drying (a pulse). Beans have been cultivated since the seventh millennium BCE in Thailand, and since the second millennium BCE in Europe and in Peru. Most beans, with the exception of peas, are summer crops. As legumes, the plants fix nitrogen and form seeds with a high protein content. They are produced on a scale of millions of tons annually in many countries, with India as the largest producer."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-beans"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Beans"}],"sections":[{"h":"Where it's cooked with","count":6,"groups":[["Kazakh cuisine","cuisine/kazakh-cuisine",[["Chorba","dish/chorba"]]],["Kyrgyz cuisine","cuisine/kyrgyz-cuisine",[["Chorba","dish/chorba"]]],["Latin American cuisine","cuisine/latin-american-cuisine",[["Rice and beans","dish/rice-and-beans"]]],["Tajik cuisine","cuisine/tajik-cuisine",[["Chorba","dish/chorba"]]],["Turkmen cuisine","cuisine/turkmen-cuisine",[["Chorba","dish/chorba"]]],["Uzbek cuisine","cuisine/uzbek-cuisine",[["Chorba","dish/chorba"]]]]},{"h":"Where it's grown","grown":{"what":"Beans, dry","years":"2020 to 2024","url":"https://www.fao.org/faostat/en/#data/QCL","world":29765208,"top":[["India","cuisine/indian-cuisine",7880613],["Brazil","cuisine/brazilian-cuisine",2945451],["Myanmar","cuisine/burmese-cuisine",2629516],["Tanzania","cuisine/tanzanian-cuisine",1355270],["China","cuisine/chinese-cuisine",1322710],["United States of America","cuisine/american-cuisine",1222307],["Mexico","cuisine/mexican-cuisine",1006057],["Kenya","cuisine/kenyan-cuisine",791645],["Uganda","cuisine/ugandan-cuisine",788425],["Ethiopia","cuisine/ethiopian-cuisine",784771],["Argentina","cuisine/argentine-cuisine",667929],["Burundi","cuisine/burundian-cuisine",492940],["Mozambique","cuisine/mozambican-cuisine",477889],["Rwanda","cuisine/rwandan-cuisine",461773],["Canada","cuisine/canadian-cuisine",385905]]}},{"h":"Often cooked with","links":[["Legumes","ingredient/legumes"],["Vegetables","ingredient/vegetables"],["Rice","ingredient/rice"]]},{"h":"Mentioned in","links":[["Maya cuisine","cuisine/maya-cuisine"],["Mixtec foodways","cuisine/mixtec-foodways"],["Nahua foodways","cuisine/nahua-foodways"],["Purépecha foodways","cuisine/purepecha-foodways"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/a0/French_beans_J1.JPG/500px-French_beans_J1.JPG","w":500,"h":682,"by":"Jamain",