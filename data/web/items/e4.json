sh cuisine","dot":"#cf5f87","intro":[["Lanttulaatikko or kålrotslåda (swede casserole) is a swede (rutabaga) casserole that is a traditional Christmas dish in Finland. It is usually served with other casseroles at the Christmas table as a side dish to ham, fish or other meats."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-lanttulaatikko"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lanttulaatikko"}],"sections":[{"h":"Where it's from","links":[["Finnish cuisine","cuisine/finnish-cuisine"]]},{"h":"More from Finnish cuisine","links":[["Blodpalt","dish/blodpalt"],["Cabbage roll","dish/cabbage-roll"],["Egg butter","dish/egg-butter"],["Glögg","dish/glogg"],["Joulutorttu","dish/joulutorttu"],["Kalakukko","dish/kalakukko"],["Karelian hot pot","dish/karelian-hot-pot"],["Kesäkeitto","dish/kesakeitto"],["Kringle","dish/kringle"],["Kuivaliha","dish/kuivaliha"],["Lohikeitto","dish/lohikeitto"],["Lörtsy","dish/lortsy"],["Semla","dish/semla"],["Smörgåstårta","dish/smorgastarta"],["Strong beer","dish/strong-beer"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/bf/Lanttulaatikko.jpg/500px-Lanttulaatikko.jpg","w":500,"h":333,"by":"Terry Majamaki","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Lanttulaatikko.jpg"}},"dish/le-soleil-restaurant":{"t":"dish","r":"dish/le-soleil-restaurant","n":"Le Soleil (restaurant)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Haitian cuisine","dot":"#94bd5c","intro":[["Le Soleil is a Haitian restaurant located at 858 Tenth Avenue (between West 56th Street and West 57th Street) in the Hell's Kitchen neighborhood of Manhattan, New York City."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-le-soleil-restaurant"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Le_Soleil_(restaurant)"}],"sections":[{"h":"Where it's from","links":[["Haitian cuisine","cuisine/haitian-cuisine"]]},{"h":"More from Haitian cuisine","links":[["Haitian patty","dish/haitian-patty"],["Soup joumou","dish/soup-joumou"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b0/Le_Soleil_NYC.jpg/500px-Le_Soleil_NYC.jpg","w":500,"h":375,"by":"Transpoman","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Le_Soleil_NYC.jpg"}},"dish/ostropel":{"t":"dish","r":"dish/ostropel","n":"Ostropel","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Ostropel is a typical Romanian stew that is primarily made from chicken mixed with a thick tomato sauce. Additionally, garlic or spring onions can be added to the dish. Rabbit, lamb, or other types of meat are also sometimes used and, alternatively, vegetarian versions can be made during fasting periods."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-ostropel"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Ostropel"}],"sections":[{"h":"Where it's from","links":[["Moldovan cuisine","cuisine/moldovan-cuisine"],["Romanian cuisine","cuisine/romanian-cuisine"]]},{"h":"Ingredients","count":6,"links":[["Chicken","ingredient/chicken"],["Garlic","ingredient/garlic"],["Lamb","ingredient/lamb"],["Rabbit meat","ingredient/rabbit-meat"],["Scallion","ingredient/scallion"],["Tomato sauce","ingredient/tomato-sauce"]]},{"h":"Cook it","rows":[{"name":"Notes from Irina's Kitchen","color":"#55b8ad","shape":"site","sub":"irinageorgescu.substack.com","note":"Newsletter of Romanian recipes and food stories from cookbook author Irina Georgescu.","url":"https://irinageorgescu.substack.com/about","suggested":true,"kind":"blog"}]},{"h":"More from Moldovan cuisine","links":[["Blini","dish/blini"],["Borscht","dish/borscht"],["Cabbage roll","dish/cabbage-roll"],["Papanași","dish/papanasi"],["Sarmale","dish/sarmale"],["Scorcolga","dish/scorcolga"],["Stuffed peppers","dish/stuffed-peppers"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/bd/Ostrpel.png/500px-Ostrpel.png","w":500,"h":435