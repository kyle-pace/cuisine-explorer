inthekitchen.blogspot.com/2010/01","suggested":true,"kind":"blog"}]},{"h":"More from Hungarian cuisine","links":[["Cabbage roll","dish/cabbage-roll"],["Chicken paprikash","dish/chicken-paprikash"],["Esterházy torte","dish/esterhazy-torte"],["Goulash","dish/goulash"],["Gulyásleves","dish/gulyasleves"],["Jókai bean soup","dish/jokai-bean-soup"],["Kürtőskalács","dish/kurtoskalacs"],["Lecsó","dish/lecso"],["Liptauer","dish/liptauer"],["Palóc soup","dish/paloc-soup"],["Pörkölt","dish/porkolt"],["Rakott krumpli","dish/rakott-krumpli"],["Rigójancsi","dish/rigojancsi"],["Sour cherry soup","dish/sour-cherry-soup"],["Speckkuchen","dish/speckkuchen"],["Székelykáposzta","dish/szekelykaposzta"],["Tarhonya","dish/tarhonya"],["Trdelník","dish/trdelnik"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/56/Arany-galuska.jpg/500px-Arany-galuska.jpg","w":500,"h":332,"by":"Illustratedjc","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Arany-galuska.jpg"}},"ingredient/spread":{"t":"ingredient","r":"ingredient/spread","n":"Spread","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 3 cuisines","intro":[["A spread is a food that is spread, generally with a knife, onto foods such as bread or crackers. Spreads are added to food to enhance the flavor or texture of the food, which may be considered bland without it. Butter and soft cheeses are typical spreads."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-spread"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Spread_(food)"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Danish cuisine","cuisine/danish-cuisine",[["Smørrebrød","dish/sm-rrebr-d"]]],["French cuisine","cuisine/french-cuisine",[["Canapé","dish/canape"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Canapé","dish/canape"]]]]},{"h":"Often cooked with","links":[["Butter","ingredient/butter"],["Cracker","ingredient/cracker"],["Paste","ingredient/paste"],["Puff pastry","ingredient/puff-pastry"],["Toast","ingredient/toast"],["Cheese","ingredient/cheese"],["Cold cut","ingredient/cold-cut"],["Garnish (cooking)","ingredient/garnish-cooking"],["Lunch meat","ingredient/lunch-meat"],["Rugbrød","ingredient/rugbr-d"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/96/Buttered_crumpet.jpg/500px-Buttered_crumpet.jpg","w":500,"h":375,"by":"Unknown author","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Buttered_crumpet.jpg"}},"ingredient/surimi":{"t":"ingredient","r":"ingredient/surimi","n":"Surimi","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 3 cuisines","intro":[["Surimi is a paste made from fish or other meat. It can also be any of a number of East Asian foods that use that paste as their primary ingredient. It is available in many shapes, forms, and textures, and is often used to mimic the texture and color of the meat of lobster, crab, grilled Japanese eel, or shellfish."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-surimi"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Surimi"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Mie kocok","dish/mie-kocok"]]],["Japanese Chinese cuisine","cuisine/japanese-chinese-cuisine",[["Narutomaki","dish/narutomaki"]]],["Japanese cuisine","cuisine/japanese-cuisine",[["Chikuwa","dish/chikuwa"]]]]},{"h":"Often cooked with","links":[["Bakso","ingredient/bakso"],["Bean sprout","ingredient/bean-sprout"],["Beef","ingredient/beef"],["Broth","ingredient/broth"],["Celery","ingredient/celery"],["Ginger","ingredient/ginger"],["Lemongrass","ingredient/lemongrass"],["Meatball","ingredient/meatball"],["Mung bean sprout","ingredient/mung-bean-sprout"],["Mustard plant","ingredient/mustard-plant"],["Noodle","ingredient/noodle"],["Noodles","ingredient/noodles"],["Scallion","ingredient/scallion"],["Shallot","ingredient/shallot"],["Tendon as food","ingredient/tendon-as-food"]]}],"img":{"src":"/labs/cuisines/img/thumb/6/68/TubOfSurimi.jpg/500px-TubOfSurimi.jpg","w":500,"h":440,"by":"Sjschen (Sjschen)","lic":"CC BY 2.5","licUrl":"https://creativecommons.org/licenses/by/2.5","page":"https://commons.wikimedia.org/wiki/File:TubOfSurimi.jpg"}},"dish/cholado":{"t":"dish","r":"dish/cholado","n":"Cholado","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Colombian cuisine","dot":"#94bd5c","intro":[["Cholado, raspao, or raspado is an icy beverage with fresh fruit and sweetened condensed milk traditionally from Jamundí, in the region of Valle del Cauca, Colombia. It is made from crushed ice or shaved ice, chopped fruit, condensed milk, fruit syrup, and served with a wafer cookie. It is sometimes topped with whipped cream. Fruits that are commonly used in cholado preparation include banana, apple, kiwifruit, strawberry, papaya, pineapple, mango, and soursop."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-cholado"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cholado"}],"sections":[{"h":"Where it's from","links":[["Colombian cuisine","cuisine/colombian-cuisine"]]},{"h":"Cook it","rows":[{"name":"My Colombian Recipes","color":"#55b8ad","shape":"site","sub":"mycolombianrecipes.com","note":"Medellín-born Erica Dinho's blog of traditional Colombian recipes.","url":"https://www.mycolombianrecipes.com/about/","suggested":true,"kind":"blog"}]},{"h":"More from Colombian cuisine","links":[["Arepa","dish/arepa"],["Calentao","dish/calentao"],["Pandebono","dish/pandebono"],["Puchero","dish/puchero"]]}],"img":{"src":"/labs/cuisines/img/thumb/7/7e/Cholado_jamundi.jpg/500px-Cholado_jamundi.jpg","w":500,"h":668,"by":"C arango","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Cholado_jamundi.jpg"}},"ingredient/fried-fish":{"t":"ingredient","r":"ingredient/fried-fish","n":"Fried fish","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 10 cuisines","intro":[["Fried fish is any fish or shellfish that has been prepared by frying. Often, the fish is covered in batter, egg and breadcrumbs, flour, or herbs and spices before being fried and served, often with a slice of lemon."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-fried-fish"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fried_fish"}],"sections":[{"h":"Where it's cooked with","count":10,"groups":[["Afrikaner cuisine","cuisine/afrikaner-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["American cuisine","cuisine/american-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["Australian cuisine","cuisine/australian-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["Canadian cuisine","cuisine/canadian-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["English cuisine","cuisine/english-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["Indian cuisine","cuisine/indian-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["Irish cuisine","cuisine/irish-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["New Zealand cuisine","cuisine/new-zealand-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["Norwegian cuisine","cuisine/norwegian-cuisine",[["Fish and chips","dish/fish-and-chips"]]],["South African cuisine","cuisine/south-african-cuisine",[["Fish and chips","dish/fish-and-chips"]]]]},{"h":"Often cooked with","links":[["Atlantic cod","ingredient/atlantic-cod"],["Fish","ingredient/fish"],["French fries","ingredient/french-fries"],["Fries","ingredient/fries"],["Potato","ingredient/potato"]]}],"img":{"src":"/labs/cuisines/img/thumb/5/55/Fish%2C_chips_and_mushy_peas.jpg/500px-Fish%2C_chips_and_mushy_peas.jpg","w":500,"h":357,"by":"Charles Haynes from Bangalore, India","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Fish%2C_chips_and_mu