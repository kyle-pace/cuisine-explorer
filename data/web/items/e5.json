{"cuisine/chinese-american-cuisine":{"t":"cuisine","r":"cuisine/chinese-american-cuisine","n":"Chinese American cuisine","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Fusion cuisine","cuisine/fusion-cuisine"]],"sub":"Diaspora cuisine in United States of America","intro":[["American Chinese cuisine, also known as Sino-American cuisine and often referred to in American English as simply Chinese food, is a derivative of Chinese cuisine developed by Chinese Americans. The dishes served in North American Chinese restaurants are modified to suit customers' tastes and are often quite different from styles common in China. By the late 20th century, it was recognized as one of the many regional styles of Chinese cuisine."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"chinese-american-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Chinese_American_cuisine"}],"sections":[{"h":"Dishes","count":3,"links":[["Almond chicken","dish/almond-chicken"],["Beef and broccoli","dish/beef-and-broccoli"],["Chicken and broccoli","dish/chicken-and-broccoli"]]},{"h":"Recipe sites","count":1,"rows":[{"name":"I Heart Umami: Chinese American","color":"#55b8ad","shape":"site","sub":"iheartumami.com","note":"Chinese American takeout-style recipes on an Asian home cooking blog.","url":"https://iheartumami.com/category/cuisines/chinese-american","suggested":true,"kind":"blog"}]},{"h":"Cookbooks","count":1,"rows":[{"name":"The Chinese Takeout Cookbook","color":"#f0b340","shape":"book","sub":"Diana Kuan, 2012","note":"Home versions of American Chinese takeout dishes.","url":"https://openlibrary.org/isbn/9780345529121","suggested":true,"isbn":"9780345529121"}]},{"h":"Key ingredients","links":[["Almond","ingredient/almond"],["Chicken","ingredient/chicken"],["Beef","ingredient/beef"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["Fusion cuisine","cuisine/fusion-cuisine"]]}],"cont":"Cuisine of the Americas","img":{"src":"/labs/cuisines/img/thumb/c/c0/Chinese_buffet2.jpg/500px-Chinese_buffet2.jpg","w":500,"h":375,"by":"Unknown author","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Chinese_buffet2.jpg"}},"cuisine/iraqi-cuisine":{"t":"cuisine","r":"cuisine/iraqi-cuisine","n":"Iraqi cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Levantine cuisine","cuisine/levantine-cuisine"]],"sub":"National cuisine of Iraq","intro":[["Iraqi cuisine is a Middle Eastern cuisine that has its origins in the ancient Near East culture of the Fertile Crescent. Tablets found in ancient ruins in Iraq show recipes prepared in the temples during religious festivals—the first cookbooks in the world. Ancient Iraq's cultural sophistication extended to the culinary arts."],["The Iraqi kitchen reached its zenith in the Islamic Golden Age when Baghdad was the capital of the Abbasid Caliphate."],["In Northern Iraq pomegranate is added to  dolma. In Southern Iraq, fish is a staple. The center of the country is known  for its rice dishes and sweets."],["In terms of agriculture, Iraq harks back to ancient Mesopotamia, growing wheat and crops requiring winter chill such as apples and stone fruits. Lower Mesopotamia grows rice and barley, citrus fruits, and is responsible for Iraq's position as one of the world's largest producer of dates."],["Pork consumption is forbidden to Muslims in Iraq, in accordance with Sharia, the Islamic law."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"iraqi-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Iraqi_cuisine"}],"sections":[{"h":"Dishes","count":2,"links":[["Khubz al-ʾAbbas","dish/khubz-al-abbas"],["Qeema Najafi","dish/qeema-najafi"]]},{"h":"Recipe sites","count":1,"rows":[{"name":"The Iraqi Family Cookbook","color":"#55b8ad","shape":"site","sub":"iraqifamilycookbook.blogspot.com","note":"Long-running blog of Iraqi family recipes tied to the cookbook of the same name.","url":"https://iraqifamilycookbook.blogspot.com/2014","suggested":true,"kind":"blog"}]},{"h":"Cookbooks","count":3,"rows":[{"name":"Delights from the Garden of Eden: A Cookbook and History of the Iraqi Cuisine","color":"#f0b340","shape":"book","sub":"Nawal Nasrallah","note":"Scholarly and practical history of Iraqi cooking with recipes; link is the abridged second edition.","url":"https://prospectbooks.co.uk/products-page/current-titles/delights-from-the-garden-of-eden-abridged-2nd-edition","suggested":true},{"name":"The Iraqi Cookbook","color":"#f0b340","shape":"book","sub":"Lamees Ibrahim","note":"Traditional Iraqi home dishes, published in the US by Interlink.","url":"https://openlibrary.org/isbn/9781566567480","suggested":true,"isbn":"9781566567480"},{"name":"The Iraqi Table","color":"#f0b340","shape":"book","sub":"Raghad Al Safi","note":"Iraqi family recipes by an Iraqi-born, UK-based cook.","url":"","suggested":true}]},{"h":"Key ingredients","links":[["Wheat flour","ingredient/wheat-flour"],["Beef","ingredient/beef"],["Chickpea","ingredient/chickpea"],["Rice","ingredient/rice"],["Tomato paste","ingredient/tomato-paste"]],"note":"Most used across its dishes."},{"h":"Part of","links":[["Levantine cuisine","cuisine/levantine-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/labs/cuisines/img/0/0e/Babylon_relief.jpg","w":500,"h":687,"by":"Unknown author","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:Babylon_relief.jpg"}},"cuisine/unangax-foodways":{"t":"cuisine","r":"cuisine/unangax-foodways","n":"Unangax̂ foodways","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Alaska Native foodways","cuisine/alaska-native-foodways"]],"sub":"Indigenous foodways, Aleutian and Pribilof Islands, Alaska","names":"Unangax̂ (Aleut)","intro":[["The Unangax̂ have lived along the Aleutian chain and the Pribilof Islands for thousands of years, and their food comes from the water around them: ",["Salmon","ingredient/salmon"],", halibut and cod, seal and sea lion, sea urchins, and plants and berries from the islands. Russian contact also left its mark, so tea and fish pies sit alongside older foods."]],"src":"note","sources":[{"name":"Alaska Native Heritage Center","url":"https://www.alaskanative.net/"},{"name":"University of Alaska Museum of the North, Alaska Native cultures guide","url":"https://uaf.edu/museum/education/docents/pdfs/NC2-3_Intro_2014.pdf"}],"actions":[{"kind":"globe","hash":"unangax-foodways"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Alaska Native foodways","cuisine/alaska-native-foodways"]]},{"h":"Part of","links":[["Alaska Native foodways","cuisine/alaska-native-foodways"]]}],"cont":"Cuisine of the Americas"},"ingredient/raisin":{"t":"ingredient","r":"ingredient/raisin","n":"Raisin","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 21 dishes across 31 cuisines","intro":[["A raisin is a dried grape. Raisins are produced in many regions of the world and may be eaten raw or used in cooking, baking, and brewing. The word raisin is commonly used for the dried dark-colored seedless grape, while sultana is a golden-colored dried grape, and currant is a dried small Black Corinth seedless grape."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-raisin"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Raisin"}],"sections":[{"h":"Where it's cooked with","count":31,"groups":[["Belarusian cuisine","cuisine/belarusian-cuisine",[["Baba (cake)","dish/baba-cake"],["Gugelhupf","dish/gugelhupf"],["Syrniki","dish/syrniki"]]],["Russian cuisine","cuisine/russian-cuisine",[["Baba (cake)","dish/baba-cake"],["Gugelhupf","dish/gugelhupf"],["Syrniki","dish/syrniki"]]],["Ukrainian cuisine","cuisine/ukrainian-cuisine",[["Baba (cake)","dish/baba-cake"],["Gugelhupf","dish/gugelhupf"],["Syrniki","dish/syrniki"]]],["British cuisine","cuisine/british-cuisine",[["Flies' graveyard","dish/flies-graveyard"],["Hot cross bun","dish/hot-cross-bun"]]],["Dutch cuisine","cuis