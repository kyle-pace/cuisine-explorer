]],["German cuisine","cuisine/german-cuisine",[["Strudel","dish/strudel"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Strudel","dish/strudel"]]]]},{"h":"Often cooked with","links":[["Egg","ingredient/egg"],["Filo","ingredient/filo"],["Sugar","ingredient/sugar"],["Wheat flour","ingredient/wheat-flour"]]}],"img":{"src":"/labs/cuisines/img/thumb/9/9e/Baklava.jpg/500px-Baklava.jpg","w":500,"h":421,"by":"Unknown author","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Baklava.jpg"}},"dish/tehane":{"t":"dish","r":"dish/tehane","n":"Tehane","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Tehane or stuffed spleen is a delicacy of Morocco, made from a baked spleen stuffed with kefta and other ingredients. Dromedary camel spleen is traditionally used, but cow spleen is also used. Stuffed spleen is a popular street food in souks in Fez and Marrakesh, like Fes el Bali and Jemaa el-Fnaa."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-tehane"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Tehane"}],"sections":[{"h":"Where it's from","links":[["Mizrahi Jewish cuisine","cuisine/mizrahi-jewish-cuisine"],["Moroccan cuisine","cuisine/moroccan-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Cow","ingredient/cow"],["Dromedary camel","ingredient/dromedary-camel"],["Kefta","ingredient/kefta"],["Kofta","ingredient/kofta"],["Spleen as food","ingredient/spleen-as-food"]]},{"h":"Cook it","rows":[{"name":"My Moroccan Food","color":"#55b8ad","shape":"site","sub":"mymoroccanfood.com","note":"Moroccan recipe blog linked to cookbook author Nargisse Benkabbou, covering breads, soups and tagines.","url":"https://www.mymoroccanfood.com/","suggested":true,"kind":"blog"},{"name":"Taste of Maroc","color":"#55b8ad","shape":"site","sub":"tasteofmaroc.com","note":"Moroccan recipes and tutorials from Christine Benlafquih, formerly the Moroccan food writer at The Spruce Eats.","url":"https://tasteofmaroc.com/about/","suggested":true,"kind":"site"},{"name":"Salima's Kitchen","color":"#55b8ad","shape":"site","sub":"salimaskitchen.com","note":"Moroccan section of Salima Benkhalti's blog, drawing on her family cooking.","url":"https://salimaskitchen.com/category/moroccan/","suggested":true,"kind":"blog"}]},{"h":"More from Mizrahi Jewish cuisine","links":[["Gondi (food)","dish/gondi-food"]]}],"img":{"src":"/labs/cuisines/img/thumb/a/ae/Moroccan_Beef_Spleen_Stuffed_with_Kefta.jpg/500px-Moroccan_Beef_Spleen_Stuffed_with_Kefta.jpg","w":500,"h":375,"by":"Pasquale Paolo Cardo","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Moroccan_Beef_Spleen_Stuffed_with_Kefta.jpg"}},"dish/zarda-food":{"t":"dish","r":"dish/zarda-food","n":"Zarda (food)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#f0b340","intro":[["Zarda is a traditional boiled sweet rice dish, native to the Indian subcontinent, made with saffron, milk and sugar, and flavoured with cardamom, raisins, pistachios or almonds in Indo Muslim Period. The name 'zarda' comes from Persian word 'zard' زرد meaning 'yellow', because the food coloring added to the rice gives it a yellow color. Zarda is typically served after a meal.  In the Indian subcontinent, zarda was and still remains a popular dessert on special occasions such as weddings. It is quite similar to sholezard, a traditional Iranian dessert, and zerde, a traditional Turkish dessert."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-zarda-food"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Zarda_(food)"}],"sections":[{"h":"Where it's from","links":[["Bangladeshi cuisine","cuisine/bangladeshi-cuisine"],["Indian cuisine","cuisine/indian-cuisine"],["Pakistani cuisine","cuisine/pakistani-cuisine"]]},{"h":"Ingredients","count":8,"links":[["Almond","ingredient/almond"],["Carda