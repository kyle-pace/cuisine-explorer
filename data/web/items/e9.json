dia.org/wiki/Beef_jerky"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Bolivian cuisine","cuisine/bolivian-cuisine",[["Locro","dish/locro"]]],["Ecuadorian cuisine","cuisine/ecuadorian-cuisine",[["Locro","dish/locro"]]],["Peruvian cuisine","cuisine/peruvian-cuisine",[["Locro","dish/locro"]]]]},{"h":"Often cooked with","links":[["Beef","ingredient/beef"],["Cayenne pepper","ingredient/cayenne-pepper"],["Chorizo","ingredient/chorizo"],["Hot sauce","ingredient/hot-sauce"],["Maize","ingredient/maize"],["Paprika","ingredient/paprika"],["Potato","ingredient/potato"],["Zapallo","ingredient/zapallo"]]}],"img":{"src":"/labs/cuisines/img/thumb/6/64/Jerky_%281%29.jpg/500px-Jerky_%281%29.jpg","w":500,"h":281,"by":"Larry Jacobsen from Cheyenne Wyoming","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Jerky_(1).jpg"}},"dish/stollen":{"t":"dish","r":"dish/stollen","n":"Stollen","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#cf5f87","intro":[["Stollen or stol (Dutch: [stɔl]) is a fruit bread of nuts, spices, and dried or candied fruit, often coated with powdered sugar or icing sugar and often containing marzipan or almond paste. It is a traditional holiday sweet bread in Northwestern Europe, particularly in Germany and the Netherlands. The bread is also popular in Suriname."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-stollen"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Stollen"}],"sections":[{"h":"Where it's from","links":[["German cuisine","cuisine/german-cuisine"],["Thuringian cuisine","cuisine/german-cuisine-thuringia"],["Saxon cuisine","cuisine/saxon-cuisine"]]},{"h":"Ingredients","count":7,"links":[["Candied fruit","ingredient/candied-fruit"],["Cardamom","ingredient/cardamom"],["Cinnamon","ingredient/cinnamon"],["Dried fruit","ingredient/dried-fruit"],["Icing sugar","ingredient/icing-sugar"],["Powdered sugar","ingredient/powd