abs/cuisines/img/thumb/5/56/%C4%A6ob%C5%BC_Malti.jpg/500px-%C4%A6ob%C5%BC_Malti.jpg","w":500,"h":375,"by":"EnriqueTabone","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:%C4%A6ob%C5%BC_Malti.jpg"}},"dish/pie":{"t":"dish","r":"dish/pie","n":"Pie","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 5 cuisines","dot":"#94bd5c","intro":[["A pie is a baked dish which is usually made of a pastry dough casing that contains a filling of various sweet or savoury ingredients. Sweet pies may be filled with fruit (as in an apple pie), nuts (pecan pie), fruit preserves (jam tart), brown sugar (tarte au sucre), sweetened vegetables (rhubarb pie), or with thicker fillings based on eggs and dairy (as in custard pie and cream pie). Savoury pies may be filled with meat (as in a steak pie or a bacon and egg pie), eggs and cheese (such as quiches or British flans), or a mixture of meat and vegetables (pot pie or Corned beef pie)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pie"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pie"}],"sections":[{"h":"Where it's from","links":[["Brazilian cuisine","cuisine/brazilian-cuisine"],["British cuisine","cuisine/british-cuisine"],["Polish cuisine","cuisine/polish-cuisine"],["Russian cuisine","cuisine/russian-cuisine"],["Ukrainian cuisine","cuisine/ukrainian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Olivia's Cuisine","ref":"site/oliviascuisine-com","color":"#55b8ad","shape":"site","sub":"oliviascuisine.com","note":"Brazilian-born Olivia Mesquita's blog, with a large section of Brazilian classics.","url":"https://oliviascuisine.com/","suggested":true},{"name":"Easy and Delish","ref":"site/easyanddelish-com","color":"#55b8ad","shape":"site","sub":"easyanddelish.com","note":"Brazilian recipe collection from a Brazilian-born home cook based in the US.","url":"https://www.easyanddelish.com/easy-brazilian-recipes/","suggested":true},{"name