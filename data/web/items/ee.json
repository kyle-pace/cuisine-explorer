{"cuisine/punjabi-cuisine":{"t":"cuisine","r":"cuisine/punjabi-cuisine","n":"Punjabi cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["North Indian cuisine","cuisine/north-indian-cuisine"],["Pakistani cuisine","cuisine/pakistani-cuisine"]],"sub":"Regional cuisine in India","intro":[["Punjabi cuisine is a culinary style originating in the Punjab, a region in South Asia, which is now divided into an Indian part to the east and a Pakistani part to the west. This cuisine has a rich tradition of many distinct and local ways of cooking."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"punjabi-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Punjabi_cuisine"}],"sections":[{"h":"Dishes","count":1,"links":[["Sarson ka saag","dish/sarson-ka-saag"]]},{"h":"Recipe sites","count":2,"rows":[{"name":"Dassana's Veg Recipes (Punjabi)","color":"#55b8ad","shape":"site","sub":"vegrecipesofindia.com","note":"Punjabi section of Dassana Amit's large Indian vegetarian recipe blog.","url":"https://www.vegrecipesofindia.com/recipes/punjabi/","suggested":true,"kind":"blog"},{"name":"Chef Kunal Kapur","color":"#55b8ad","shape":"site","sub":"chefkunalkapur.com","note":"Indian chef and TV host Kunal Kapur's recipe site, tagged Punjabi dishes.","url":"https://www.chefkunalkapur.com/tag/punjabi","suggested":true,"kind":"site"}]},{"h":"Part of","links":[["North Indian cuisine","cuisine/north-indian-cuisine"],["Pakistani cuisine","cuisine/pakistani-cuisine"]]},{"h":"Within Punjabi cooking","count":2,"links":[["Lahori cuisine","cuisine/lahori-cuisine"],["Saraiki cuisine","cuisine/saraiki-cuisine"]]}],"cont":"Asian cuisine","img":{"src":"/world-cuisine/img/thumb/6/60/Sarson_Ka_Saag_-_Mohali_2016-08-06_8227.JPG/500px-Sarson_Ka_Saag_-_Mohali_2016-08-06_8227.JPG","w":500,"h":332,"by":"Biswarup Ganguly","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Sarson_Ka_Saag_-_Mohali_2016-08-06_8227.JPG","of":"Sars