["Cabbage roll","dish/cabbage-roll"],["Egg butter","dish/egg-butter"],["Glögg","dish/glogg"],["Kvass","dish/kvass"],["Smörgåstårta","dish/smorgastarta"]]},{"h":"Recipe sites","count":1,"rows":[{"name":"Estonian Cuisine","color":"#55b8ad","shape":"site","sub":"estoniancuisine.com","note":"English-language blog dedicated to Estonian home recipes.","url":"https://estoniancuisine.com/about-estonian-food-blog/","suggested":true,"kind":"blog"}]},{"h":"Cookbooks","count":1,"rows":[{"name":"Baltic: New and Old Recipes from Estonia, Latvia and Lithuania","color":"#f0b340","shape":"book","sub":"Simon Bajada","note":"Survey of traditional and modern cooking across the three Baltic states.","url":"","suggested":true}]},{"h":"Key ingredients","links":[["Rye bread","ingredient/rye-bread"],["Beef","ingredient/beef"],["Pork","ingredient/pork"],["Cabbage","ingredient/cabbage"],["Ground meat","ingredient/ground-meat"],["Onion","ingredient/onion"],["Rice","ingredient/rice"],["Butter","ingredient/butter"],["Almond","ingredient/almond"],["Mulled wine","ingredient/mulled-wine"],["Raisin","ingredient/raisin"],["Wine","ingredient/wine"],["Malt","ingredient/malt"],["Rye flour","ingredient/rye-flour"],["Yeast","ingredient/yeast"],["Egg","ingredient/egg"],["Mayonnaise","ingredient/mayonnaise"]],"note":"Most used across its dishes."}],"cont":"European cuisine","img":{"src":"/world-cuisine/img/thumb/9/9c/GelatinaDiMaiale.JPG/500px-GelatinaDiMaiale.JPG","w":500,"h":375,"by":"Gmelfi","lic":"Public domain","licUrl":"","page":"https://commons.wikimedia.org/wiki/File:GelatinaDiMaiale.JPG","of":"Aspic"}},"cuisine/arbereshe-cuisine":{"t":"cuisine","r":"cuisine/arbereshe-cuisine","n":"Arbëreshë cuisine","c":"#cf5f87","crumb":[["Europe","cuisines#europe"],["Italian cuisine","cuisine/italian-cuisine"]],"sub":"Regional cuisine in Italy","intro":[["The Arbëreshë cuisine is the cuisine of the Arbëreshë people (Italo-Albanians) who settled in southern Italy between the 15th and 18th centuries after successive migrations from Albania, Epirus, Chameria and Morea, during the Ottoman conquest of the Balkans."],["In the 2010 book My Calabria, by authors Rosetta Costantino and Janet Fletcher, Arbëreshë cuisine is described as largely indistinguishable from the broader Cuisine of Calabria, with only a few pasta varieties lacking a Calabrian equivalent."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"arbereshe-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Arbëreshë_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Part of","links":[["Italian cuisine","cuisine/italian-cuisine"]]}],"cont":"European cuisine","img":{"src":"/world-cuisine/img/thumb/2/24/Tumact_me_tulez.jpg/500px-Tumact_me_tulez.jpg","w":500,"h":435,"by":"Generale Lee","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Tumact_me_tulez.jpg"}},"ingredient/egg-yolk":{"t":"ingredient","r":"ingredient/egg-yolk","n":"Egg yolk","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 21 dishes across 18 cuisines","intro":[["Among animals which produce eggs, the yolk is the nutrient-bearing portion of the egg, the primary function of which is to supply food for the development of the embryo.  Some types of egg contain no yolk, for example because they are laid in situations where the food supply is sufficient (such as in the body of the host of a parasitoid) or because the embryo develops in the parent's body, which supplies the food, usually through a placenta.  Reproductive systems in which the mother's body supplies the embryo directly are said to be matrotrophic; those in which the embryo is supplied by yolk are said to be lecithotrophic.  In many species, such as all birds, and most reptiles and insects, the yolk takes the form of a special storage organ constructed in the reproductive tract of the mother.  In many other animals, especially very small species such as some"]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-egg-yolk"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Egg_yolk"}],"sections":[{"h":"Where it's cooked with","count":18,"groups":[["Indonesian cuisine","cuisine/indonesian-cuisine",[["Bakpia","dish/bakpia"],["Klappertaart","dish/klappertaart"],["Kue putri salju","dish/kue-putri-salju"],["Roti buaya","dish/roti-buaya"],["Teh talua","dish/teh-talua"]]],["Portuguese cuisine","cuisine/portuguese-cuisine",[["Encharcada","dish/encharcada"],["Fios de ovos","dish/fios-de-ovos"],["Tocino de cielo","dish/tocino-de-cielo"]]],["Andalusian cuisine","cuisine/andalusian-cuisine",[["Gazpachuelo","dish/gazpachuelo"],["Tocino de cielo","dish/tocino-de-cielo"]]],["French cuisine","cuisine/french-cuisine",[["Hollandaise sauce","dish/hollandaise-sauce"],["Lobster Thermidor","dish/lobster-thermidor"]]],["Italian cuisine","cuisine/italian-cuisine",[["Stracciatella (ice cream)","dish/stracciatella-ice-cream"],["Tiramisu","dish/tiramisu"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Hollandaise sauce","dish/hollandaise-sauce"],["Lobster Thermidor","dish/lobster-thermidor"]]],["American cuisine","cuisine/american-cuisine",[["Lobster Thermidor","dish/lobster-thermidor"]]],["Andorran cuisine","cuisine/andorran-cuisine",[["Crema catalana","dish/crema-catalana"]]],["Armenian cuisine","cuisine/armenian-cuisine",[["Spas (soup)","dish/spas-soup"]]],["Asturian cuisine","cuisine/asturian-cuisine",[["Tocino de cielo","dish/tocino-de-cielo"]]],["Belgian cuisine","cuisine/belgian-cuisine",[["Waterzooi","dish/waterzooi"]]],["British cuisine","cuisine/british-cuisine",[["Black pudding","dish/black-pudding"]]],["Catalan cuisine","cuisine/catalan-cuisine",[["Crema catalana","dish/crema-catalana"]]],["English cuisine","cuisine/english-cuisine",[["Crème anglaise","dish/creme-anglaise"]]],["Hungarian cuisine","cuisine/hungarian-cuisine",[["Rigójancsi","dish/rigojancsi"]]]