{"cuisine/cuisine-of-veracruz":{"t":"cuisine","r":"cuisine/cuisine-of-veracruz","n":"Cuisine of Veracruz","c":"#94bd5c","crumb":[["The Americas","cuisines#the-americas"],["Mexican cuisine","cuisine/mexican-cuisine"]],"sub":"Regional cuisine in Mexico","intro":[["The cuisine of Veracruz is the regional cooking of Veracruz, a Mexican state along the Gulf of Mexico. Its cooking is characterized by three main influences—indigenous, Spanish, and Afro-Cuban—per its history, which included the arrival of the Spanish and of enslaved people from Africa and the Caribbean. These influences have contributed many ingredients to the cooking including native vanilla, corn and seafood, along with rice, spices and tubers. How much the three mix depending on the area of the state, with some areas more heavily favoring one or another. The state has worked to promote its cuisine both in Mexico and abroad as part of its tourism industry."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"cuisine-of-veracruz"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cuisine_of_Veracruz"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Mexican cuisine","cuisine/mexican-cuisine"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"Zarela's Veracruz","color":"#f0b340","shape":"book","sub":"Zarela Martínez with Anne Mendelson, 2004","note":"Veracruz cooking and culture from a Mexican-born New York restaurateur whose mother was from the state.","url":"https://openlibrary.org/isbn/9780618444106","suggested":true,"isbn":"9780618444106"}]},{"h":"Part of","links":[["Mexican cuisine","cuisine/mexican-cuisine"]]}],"cont":"Cuisine of the Americas","img":{"src":"/world-cuisine/img/thumb/2/29/Garnachas_estilo_Altotonga.jpg/500px-Garnachas_estilo_Altotonga.jpg","w":500,"h":667,"by":"Koffermejia","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Garnachas_estilo_Altotonga.jpg"}},"cuisine/australian-chinese-cuisine":{"t":"cuisine","r":"cuisine/australian-chinese-cuisine","n":"Australian Chinese cuisine","c":"#55b8ad","crumb":[["Oceania","cuisines#oceania"],["Chinese cuisine","cuisine/chinese-cuisine"],["Australian cuisine","cuisine/australian-cuisine"]],"sub":"Diaspora cuisine in Ashmore and Cartier Is.","intro":[["Australian Chinese cuisine is a style of cooking developed by Australians of Chinese descent, who adapted dishes to satisfy local Anglo-Celtic tastes. Its roots can be traced to indentured Chinese who were brought to work as cooks in country pubs and sheep stations."],["Migrant numbers exploded with the gold rushes of the 19th century. By 1890, a third of all cooks were Chinese. Historians believe exemptions for Chinese chefs under the White Australia policy led to the eventual spread of Chinese restaurants across suburbs and country towns."],["Most early Chinese migrants were from Guangdong province, and so Cantonese cuisine became the chief influence, using locally available vegetables and more meat than was usual in traditional recipes. Later Chinese immigration, as well as increasingly adventurous domestic palates, have led to restaurants with more authentic dishes from a wider selection of provinces."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"australian-chinese-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Australian_Chinese_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Chinese cuisine","cuisine/chinese-cuisine"],["Australian cuisine","cuisine/australian-cuisine"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"Chopsticks or Fork? Recipes and Stories from Australia's Regional Chinese Restaurants","color":"#f0b340","shape":"book","sub":"Jennifer Wong and Lin Jie Kong, 2024","note":"Hardie Grant companion to the ABC series, profiling ten families running regional Chinese restaurants, with 32 classic Australian-Chinese recipes.","url":"https://openlibrary.org/isbn/9781743799390","suggested":true,"isbn":"9781743799390"}]},{"h":"Part of","links":[["Chinese cuisine","cuisine/chinese-cuisine"],["Australian cuisine","cuisine/australian-cuisine"]]}],"cont":"Oceanic cuisine"},"cuisine/fasting-and-abstinence-in-the-ethiopian-orthodox-tewahedo-church":{"t":"cuisine","r":"cuisine/fasting-and-abstinence-in-the-ethiopian-orthodox-tewahedo-church","n":"Ethiopian Orthodox diet","c":"#a99fb5","crumb":[["Christian diet","cuisine/christian-dietary-laws"]],"sub":"Religious cuisine or diet","intro":[["Fasting and abstinence have historically constituted a major element of the practice of the Ethiopian Orthodox Tewahedo Church, following the counsel of Saint Paul (Ge'ez: ቅዱስ ጳውሎስ; k’idus p’awilos) to \"chastise the body and bring it under subjection\" per 1 Corinthians 9:27. It is generally agreed, and asserted by the Church itself, that the fasting regime of the Ethiopian Church is the strictest of any Church, with 180 mandatory fasting days for laypeople and up to 252 days for clergy and the particularly observant. The general list of fasts are laid out in the Fetha Negest."]],"src":"wikipedia","actions":[{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fasting_and_abstinence_in_the_Ethiopian_Orthodox_Tewahedo_Church"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Christian diet","cuisine/christian-dietary-laws"]]},{"h":"Cookbooks","count":1,"rows":[{"name":"Teff Love: Adventures in Vegan Ethiopian Cooking","color":"#f0b340","shape":"book","sub":"Kittee Berns, 2015","note":"Plant-based Ethiopian cookbook whose wots, alichas and injera match the dishes eaten on Orthodox fasting days.","url":"https://openlibrary.org/isbn/9781570673115","suggested":true,"isbn":"9781570673115"}]},{"h":"Part of","links":[["Christian diet","cuisine/christian-dietary-laws"]]}],"cont":null,"img":{"src":"/world-cuisine/img/thumb/8/82/Ethiopian_Cuisine_-_All_Vegeterian_variety_among_thousands.jpg/500px-Ethiopian_Cuisine_-_All_Vegeterian_variety_among_thousands.jpg","w":500,"h":375,"by":"Berha","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Ethiopian_Cuisine_-_All_Vegeterian_variety_among_thousands.jpg"}},"ingredient/lunch-meat":{"t":"ingredient","r":"ingredient/lunch-meat","n":"Lunch meat","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 4 cuisines","intro":[["Lunch meats—also known as cold cuts, luncheon meats, cooked meats, sliced meats, cold meats, sandwich meats, delicatessens, and deli meats—are cooked or cured meats that are sliced and served cold or hot. They are typically served in sandwiches or on their own. They can be purchased canned, sliced (usually in vacuum packs), or they can be sliced to order, most often in delicatessens and charcuteries."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-lunch-meat"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Lunch_meat"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Danish cuisine","cuisine/danish-cuisine",[["Smørrebrød","dish/sm-rrebr-d"]]],["Italian cuisine","cuisine/italian-cuisine",[["Antipasto","dish/antipasto"]]],["Portuguese cuisine","cuisine/portuguese-cuisine",[["Cocido","dish/cocido"]]],["Spanish cuisine","cuisine/spanish-cuisine",[["Cocido","dish/cocido"]]]]},{"h":"Often cooked with","links":[["Carrot","ingredient/carrot"],["Phaseolus vulgaris","ingredient/phaseolus-vulgaris"],["Potato","ingredient/potato"],["Salo","ingredient/salo"],["Butter","ingredient/butter"],["Cheese","ingredient/cheese"],["Cold cut","ingredient/cold-cut"],["Garnish (cooking)","ingredient/garnish-cooking"],["Rugbrød","ingredient/rugbr-d"],["Spread","ingredient/spread"]]}],"img":{"src":"/world-cuisine/img/thumb/2/28/13-08-31-wien-redaktionstreffen-EuT-by-Bi-frie-168.jpg/500px-13-08-31-wien-redaktionstreffen-EuT-by-Bi-frie-168.jpg","w":500,"h":361,"by":"Bi-frie (talk)","lic":"CC BY 3.0","licUrl":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:13-08-31-wien-redaktionstreffen-EuT-by-Bi-frie-168.jpg"}},"ingredient/breadcrumbs":{"t":"ingredient","r":"ingredient/breadcrumbs","n":"Breadcrumbs","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 16 dishes across 10 cuisines","intro":[["Breadcrumbs are a culinary ingredient consisting of flour or crumbled bread of varying dryness, sometimes with seasonings added. They are used for a variety of purposes, including breading or crumbing foods before frying (such as breaded cutlets like tonkatsu and schnitzel), topping casseroles, stuffing poultry, thickening stews, and adding inexpensive bulk to soups, meatloaves, and similar foods."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-breadcrumbs"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Breadcrumbs"}],"sections":[{"h":"Where it's cooked with","count":10,"groups":[["American cuisine","cuisine/american-cuisine",[["Brown Betty (dessert)","dish/brown-betty-dessert"],["Chicken nugget","dish/chicken-nugget"],["Mozzarella sticks","dish/mozzarella-sticks"]]],["Italian cuisine","cuisine/italian-cuisine",[["Arancini","dish/arancini"],["Passatelli","dish/passatelli"],["Supplì","dish/suppli"]]],["Russian cuisine","cuisine/russian-cuisine",[["Chicken Kiev","dish/chicken-kiev"],["Polonaise sauce","dish/polonaise-sauce"]]],["Sicilian cuisine","cuisine/sicilian-cuisine",[["Pasta con le sarde","dish/pasta-con-le-sarde"],["Pasta mollicata","dish/pasta-mollicata"]]],["Basilicatan (Lucanian) cuisine","cuisine/cuisine-of-basilicata",[["Tumact me tulez","dish/tumact-me-tulez"]]],["Brazilian cuisine","cuisine/brazilian-cuisine",[["Coxinha","dish/coxinha"]]],["British cuisine","cuisine/british-cuisine",[["Christmas pudding","dish/christmas-pudding"]]],["Indonesian cuisine","cuisine/indonesian-cuisine",[["Roti gambang","dish/roti-gambang"]]],["Polish cuisine","cuisine/polish-cuisine",[["Kotlet schabowy","dish/kotlet-schabowy"]]],["Swedish cuisine","cuisine