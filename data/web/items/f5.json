nge cuttlefish","dish/orange-cuttlefish"],["Osmanthus cake","dish/osmanthus-cake"],["Pickled egg","dish/pickled-egg"],["Pilaf","dish/pilaf"]]}],"img":{"src":"/labs/cuisines/img/thumb/1/1e/Doujiang_and_youtiao_Taipei.jpg/500px-Doujiang_and_youtiao_Taipei.jpg","w":500,"h":333,"by":"KQuhen","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Doujiang_and_youtiao_Taipei.jpg"}},"dish/fartura":{"t":"dish","r":"dish/fartura","n":"Fartura","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Portuguese cuisine","dot":"#cf5f87","intro":[["A fartura is a fried dough made of flour, yeast, baking soda, salt, sugar, cinnamon, and water, that is fried in oil, in the form of a roll and traditionally sold at fairs in Portugal. It is preferable to consume them when they are hot so that the crunchy surface does not harden."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-fartura"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Fartura"}],"sections":[{"h":"Where it's from","links":[["Portuguese cuisine","cuisine/portuguese-cuisine"]]},{"h":"Cook it","rows":[{"name":"Food From Portugal","color":"#55b8ad","shape":"site","sub":"foodfromportugal.com","note":"Portuguese-run recipe site and video channel of traditional Portuguese dishes.","url":"https://www.foodfromportugal.com/","suggested":true,"kind":"site"}]},{"h":"More from Portuguese cuisine","links":[["Alheira","dish/alheira"],["Amêijoas à Bulhão Pato","dish/ameijoas-a-bulhao-pato"],["Arroz de marisco","dish/arroz-de-marisco"],["Bacalhau à Brás","dish/bacalhau-a-bras"],["Bacalhau à Gomes de Sá","dish/bacalhau-a-gomes-de-sa"],["Bacalhau à minhota","dish/bacalhau-a-minhota"],["Bacalhau à Narcisa","dish/bacalhau-a-narcisa"],["Bacalhau à Zé do Pipo","dish/bacalhau-a-ze-do-pipo"],["Bacalhau com natas","dish/bacalhau-com-natas"],["Batatas a murro","dish/batatas-a-murro"],["Bolinhos de bacalhau","dish/bolinhos-de-bacalhau"],["Bolo de bolacha"