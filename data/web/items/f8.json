gian cuisine","cuisine/georgian-cuisine"]]},{"h":"Ingredients","count":3,"links":[["Cheese","ingredient/cheese"],["Egg","ingredient/egg"],["Wheat flour","ingredient/wheat-flour"]]},{"h":"Cook it","rows":[{"name":"Georgian Recipes","ref":"site/georgianrecipes-net","color":"#55b8ad","shape":"site","sub":"georgianrecipes.net","note":"Recipe site dedicated to traditional Georgian dishes.","url":"https://georgianrecipes.net/about-georgian-recipes","suggested":true}]},{"h":"More from Georgian cuisine","links":[["Achma","dish/achma"],["Ajika","dish/ajika"],["Akhasheni","dish/akhasheni"],["Cabbage roll","dish/cabbage-roll"],["Chakapuli","dish/chakapuli"],["Chakhokhbili","dish/chakhokhbili"],["Chashushuli","dish/chashushuli"],["Chicken tabaka","dish/chicken-tabaka"],["Churchkhela","dish/churchkhela"],["Dambalkhacho","dish/dambalkhacho"],["Eggplant jam","dish/eggplant-jam"],["Gozinaki","dish/gozinaki"],["Kharcho","dish/kharcho"],["Khash (dish)","dish/khash-dish"],["Khvanchkara","dish/khvanchkara"],["Kindzmarauli","dish/kindzmarauli"],["Kubdari","dish/kubdari"],["Kuchmachi","dish/kuchmachi"],["Kvass","dish/kvass"],["Lobiani","dish/lobiani"],["Mchadi","dish/mchadi"],["Mujuretuli","dish/mujuretuli"],["Nadugi","dish/nadugi"],["Nigvziani badrijani","dish/nigvziani-badrijani"],["Pkhali","dish/pkhali"],["Shkmeruli","dish/shkmeruli"],["Tsolikouri","dish/tsolikouri"],["Tvishi (wine)","dish/tvishi-wine"]]}]},"dish/kransekage":{"t":"dish","r":"dish/kransekage","n":"Kransekage","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#cf5f87","intro":[["Kransekage, kransekake (Norwegian) or kransakaka (Icelandic) is a traditional Danish and Norwegian confection, often eaten on special occasions in Scandinavia. In English, the name means 'wreath cake'. In Norway it is alternatively referred to as tårnkake (English: 'tower cake') and often prepared for Constitution Day celebrations, Christmas, weddings, and baptisms. In Denmark it is typically eaten as part of New Year celebrations, while a variation of the cake, overflødighedshorn (English: 'cornucopia'), is traditionally served at weddings and baptisms."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-kransekage"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kransekage"}],"sections":[{"h":"Where it's from","links":[["Danish cuisine","cuisine/danish-cuisine"],["Norwegian cuisine","cuisine/norwegian-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Almond","ingredient/almond"],["Egg white","ingredient/egg-white"],["Prunus dulcis","ingredient/prunus-dulcis"],["Sugar","ingredient/sugar"]]},{"h":"More from Danish cuisine","links":[["Æbleflæsk","dish/blefl-sk"],["Æbleskiver","dish/bleskiver"],["Danish pastry","dish/danish-pastry"],["Glögg","dish/glogg"],["Hvidsten Inn","dish/hvidsten-inn"],["Kokkeriet","dish/kokkeriet"],["Kringle","dish/kringle"],["Labskaus","dish/labskaus"],["Risalamande","dish/risalamande"],["Rødgrød","dish/r-dgr-d"],["Smørrebrød","dish/sm-rrebr-d"]]}]},"dish/krupnik-soup":{"t":"dish","r":"dish/krupnik-soup","n":"Krupnik (soup)","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 3 cuisines","dot":"#cf5f87","intro":[["Krupnik is a thick Polish soup made from vegetable or meat broth, containing potatoes and barley groats (kasza jęczmienna, archaically called krupy—hence the name). Common additional ingredients include włoszczyzna (carrots, parsley, leek, and celery), onion, meat, and dried mushrooms."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-krupnik-soup"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Krupnik_(soup)"}],"sections":[{"h":"Where it's from","links":[["Belarusian cuisine","cuisine/belarusian-cuisine"],["Polish cuisine","cuisine/polish-cuisine"],["Ukrainian cuisine","cuisine/ukrainian-cuisine"]]},{"h":"Ingredients","count":5,"links":[["Barley","ingredient/barley"],["Broth","ingredient/broth"],["Groat","ingredient/groat"],["Groats","ingredient/groats"],["Potatoes","ingredient/potatoes"]]},{"h