{"cuisine/qinghai-cuisine":{"t":"cuisine","r":"cuisine/qinghai-cuisine","n":"Qinghai cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Chinese cuisine","cuisine/chinese-cuisine"]],"sub":"Regional cuisine in China","intro":[["Qinghai cuisine is the regional cooking style of the Han Chinese with distinct influence from the Hui, Monguor people, and Tibetans in the Qinghai province in Northwest China."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"qinghai-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Qinghai_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Part of","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]}],"cont":"Asian cuisine"},"ingredient/potato-starch":{"t":"ingredient","r":"ingredient/potato-starch","n":"Potato starch","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 5 cuisines","intro":[["Potato starch is starch extracted from potatoes. The cells of the root tubers of the potato plant contain leucoplasts (starch grains). To extract the starch, the potatoes are crushed, and the starch grains are released from the destroyed cells. The starch is then left to settle out of solution or separated by hydrocyclones, then dried to powder."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-potato-starch"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Potato_starch"}],"sections":[{"h":"Where it's cooked with","count":5,"groups":[["Swedish cuisine","cuisine/swedish-cuisine",[["Blåbärssoppa","dish/blabarssoppa"],["Rødgrød","dish/r-dgr-d"]]],["Ainu cuisine","cuisine/ainu-cuisine",[["Munini-imo","dish/munini-imo"]]],["Danish cuisine","cuisine/danish-cuisine",[["Rødgrød","dish/r-dgr-d"]]],["German cuisine","cuisine/german-cuisine",[["Rødgrød","dish/r-dgr-d"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Rødgrød","dish/r-dgr-d"]]]]},{"h":"Often cooked with","links":[["Sugar","ingredient/sugar"],["Bilberries","ingredient/bilberries"],["Bilberry","ingredient/bilberry"],["Starch","ingredient/starch"],["Potato flour","ingredient/potato-flour"],["Berry","ingredient/berry"],["Cherry","ingredient/cherry"]]}]},"dish/boustan":{"t":"dish","r":"dish/boustan","n":"Boustan","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Lebanese cuisine","dot":"#f0b340","intro":[["Boustan is a Lebanese-Canadian fast food restaurant chain in Montreal, Quebec. It was established in 1986. The name derives from the Persian word bōstān, meaning \"garden\", which has also been loaned into Arabic with the same meaning."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-boustan"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Boustan"}],"sections":[{"h":"Where it's from","links":[["Lebanese cuisine","cuisine/lebanese-cuisine"]]},{"h":"Cook it","rows":[{"name":"Maureen Abood","ref":"site/maureenabood-com","color":"#55b8ad","shape":"site","sub":"maureenabood.com","note":"Lebanese-American writer Maureen Abood's blog of classic and modern Lebanese recipes.","url":"https://maureenabood.com/blog/","suggested":true}]},{"h":"More from Lebanese cuisine","links":[["Aladdin's Eatery","dish/aladdin-s-eatery"],["Droubi's","dish/droubi-s"],["El Jannah","dish/el-jannah"],["Jibneh Arabieh","dish/jibneh-arabieh"],["Makanek","dish/makanek"],["Meghli","dish/meghli"],["Nicholas Restaurant","dish/nicholas-restaurant"],["Qatayef","dish/qatayef"],["Stuffed squash","dish/stuffed-squash"]]}]},"ingredient/kebab":{"t":"ingredient","r":"ingredient/kebab","n":"Kebab","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 2 cuisines","intro":[["Kebab, kebap, kabob (alternative North American spelling), kebob, or kabab (Kashmiri) is a variety of roasted meat dishes that originated in the Middle East."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-kebab"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Kebab"}],"sections":[{"h":"Where it's cooked with","count":2,"groups":[["Iranian cuisine","cuisine/iranian-cuisine",[["Chelow kabab","dish/chelow-kabab"]]],["Swedish cuisine","cuisine/swedish-cuisine",[["Kebab pizza","dish/kebab-pizza"]]]]},{"h":"Often cooked with","links":[["Pilaf","ingredient/pilaf"]]}]},"dish/cream-stew":{"t":"dish","r":"dish/cream-stew","n":"Cream stew","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Yoshoku","dot":"#f0b340","intro":[["Cream stew is a popular yōshoku dish consisting of meat, usually chicken or pork, and mixed vegetables, onion, carrot, potato, and cabbage, cooked in thick white roux. The vegetables are sauteed before the meat is added with some water. The surface fats are removed by degreasing, and then the roux is added. It is common in Japan to use ready-made roux, for making Japanese curry, which comes in a block from a box. The roux can also be cooked from scratch. The hard-paste roux melts from the heat and blends with the water to create a thick stew. Milk can also be used as a replacement for water to make the stew more creamy."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-cream-stew"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Cream_stew"}],"sections":[{"h":"Where it's from","links":[["Yoshoku","cuisine/yoshoku"]]},{"h":"Ingredients","count":7,"links":[["Cabbage","ingredient/cabbage"],["Carrot","ingredient/carrot"],["Chicken","ingredient/chicken"],["Onion","ingredient/onion"],["Pork","ingredient/pork"],["Potato","ingredient/potato"],["Roux","ingredient/roux"]]},{"h":"More from Yoshoku","links":[["Chicken katsu","dish/chicken-katsu"],["Doria (food)","dish/doria-food"],["Hayashi rice","dish/hayashi-rice"],["Menchi-katsu","dish/menchi-katsu"],["Naporitan","dish/naporitan"],["Rengatei","dish/rengatei"],["Tonkatsu","dish/tonkatsu"],["Volga rice","dish/volga-rice"]]}]},"dish/kangaroo-meat":{"t":"dish","r":"dish/kangaroo-meat","n":"Kangaroo meat","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish fro