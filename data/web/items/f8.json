{"cuisine/qinghai-cuisine":{"t":"cuisine","r":"cuisine/qinghai-cuisine","n":"Qinghai cuisine","c":"#f0b340","crumb":[["Asia","cuisines#asia"],["Chinese cuisine","cuisine/chinese-cuisine"]],"sub":"Regional cuisine in China","intro":[["Qinghai cuisine is the regional cooking style of the Han Chinese with distinct influence from the Hui, Monguor people, and Tibetans in the Qinghai province in Northwest China."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"qinghai-cuisine"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Qinghai_cuisine"}],"sections":[{"h":"Recipe sites","empty":"None yet","tryLinks":[["Chinese cuisine","cuisine/chinese-cuisine"]]},{"h":"Part of","links":[["Chinese cuisine","cuisine/chinese-cuisine"]]}],"cont":"Asian cuisine"},"ingredient/potato-starch":{"t":"ingredient","r":"ingredient/potato-starch","n":"Potato starch","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 3 dishes across 5 cuisines","intro":[["Potato starch is starch extracted from potatoes. The cells of the root tubers of the potato plant contain leucoplasts (starch grains). To extract the starch, the potatoes are crushed, and the starch grains are released from the destroyed cells. The starch is then left to settle out of solution or separated by hydrocyclones, then dried to powder."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-potato-starch"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Potato_starch"}],"sections":[{"h":"Where it's cooked with","count":5,"groups":[["Swedish cuisine","cuisine/swedish-cuisine",[["Blåbärssoppa","dish/blabarssoppa"],["Rødgrød","dish/r-dgr-d"]]],["Ainu cuisine","cuisine/ainu-cuisine",[["Munini-imo","dish/munini-imo"]]],["Danish cuisine","cuisine/danish-cuisine",[["Rødgrød","dish/r-dgr-d"]]],["German cuisine","cuisine/german-cuisine",[["Rødgrød","dish/r-dgr-d"]]],["Thuringian cuisine","cuisine/german-cuisine-thuringia",[["Rødgrød","dish/r-dgr-d"]]]]},{"h":"Often cooked with","links":[["Sugar",