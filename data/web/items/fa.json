/recipes/","suggested":true}]},{"h":"More from Korean cuisine","links":[["Bap (rice dish)","dish/bap-rice-dish"],["Bibim-guksu","dish/bibim-guksu"],["Bibimbap","dish/bibimbap"],["Bosintang","dish/bosintang"],["Cheonggukjang","dish/cheonggukjang"],["Danji","dish/danji"],["Doenjang","dish/doenjang"],["Garak-guksu","dish/garak-guksu"],["Gochujang","dish/gochujang"],["Gopchang","dish/gopchang"],["Han Oak","dish/han-oak"],["Hwajeon","dish/hwajeon"],["Jijimi","dish/jijimi"],["Jokbal","dish/jokbal"],["Kim Jong Grillin'","dish/kim-jong-grillin"],["Korean restaurant","dish/korean-restaurant"],["Maekjeok","dish/maekjeok"],["Maeun-tang","dish/maeun-tang"],["Makchang","dish/makchang"],["Mandu-guk","dish/mandu-guk"],["Mandu-gwa","dish/mandu-gwa"],["Meat jun","dish/meat-jun"],["Meju","dish/meju"],["Morkovcha","dish/morkovcha"],["Parachute (restaurant)","dish/parachute-restaurant"],["Revelry (restaurant)","dish/revelry-restaurant"],["Scorched rice","dish/scorched-rice"],["Seon (food)","dish/seon-food"],["Sungnyung","dish/sungnyung"],["Toki (restaurant)","dish/toki-restaurant"],["Tteokbokki","dish/tteokbokki"],["Wakame","dish/wakame"],["Yakgwa","dish/yakgwa"],["Yukpo","dish/yukpo"]]}]},"dish/original-joe-s":{"t":"dish","r":"dish/original-joe-s","n":"Original Joe's","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#94bd5c","intro":[["Original Joe's is a local chain of restaurants in the North Beach neighborhood of San Francisco and the Westlake neighborhood of Daly City. They serve a wide variety of foods, mostly Italian-American cuisine with some mainstream American favorites. Their \"signature\" dishes include Joe's Special, Chicken Parmigiana, the Joe's Famous Hamburger Sandwich and a variety of steaks and chops."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-original-joe-s"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Original_Joe's"}],"sections":[{"h":"Where it's from","links":[["American cuisine","cuisine/american-cuisine"],["Italian cuisine","cuisine/italian-cuisine"]]},{"h":"Cook it","rows":[{"name":"Pasta Grannies","ref":"site/pastagrannies-substack-com","color":"#55b8ad","shape":"site","sub":"pastagrannies.substack.com","note":"Vicky Bennison's long-running video series filming Italian grandmothers making regional pasta by hand.","url":"https://pastagrannies.substack.com/p/pasta-grannies-is-now-on-substack","suggested":true},{"name":"Recipes from Italy","ref":"site/recipesfromitaly-com","color":"#55b8ad","shape":"site","sub":"recipesfromitaly.com","note":"Traditional Italian recipes written by Italian home cooks, organized by region and course.","url":"https://recipesfromitaly.com","suggested":true},{"name":"Manu's Menu","ref":"site/manusmenu-com","color":"#55b8ad","shape":"site","sub":"manusmenu.com","note":"Italian-born home cook Manuela sharing classic family and regional Italian dishes.","url":"https://www.manusmenu.com/about/about-this-site","suggested":true}]},{"h":"More from American cuisine","links":[["5-8 Club","dish/5-8-club"],["Altabira City Tavern","dish/altabira-city-tavern"],["Angel food cake","dish/angel-food-cake"],["Applebee's","dish/applebee-s"],["Arby's","dish/arby-s"],["Arnold's Bar and Grill","dish/arnold-s-bar-and-grill"],["Banana bread","dish/banana-bread"],["Banana pudding","dish/banana-pudding"],["Barbecue sauce","dish/barbecue-sauce"],["Be Our Guest Restaurant","dish/be-our-guest-restaurant"],["Beer cake","dish/beer-cake"],["Ben's Chili Bowl","dish/ben-s-chili-bowl"],["Benjy's","dish/benjy-s"],["Besaw's","dish/besaw-s"],["Better than sex cake","dish/better-than-sex-cake"],["Blackhawk (restaurant)","dish/blackhawk-restaurant"],["Blini","dish/blini"],["Blooming onion","dish/blooming-onion"],["Bobcat Bite","dish/bobcat-bite"],["Boiling Springs Tavern","dish/boiling-springs-tavern"],["Brix Tavern","dish/brix-tavern"],["Brown Betty (dessert)","dish/brown-betty-dessert"],["Brown Derby","dish/brown-derby"],["Brunswick stew","dish/brunswick-stew"],["Buffalo wing","dish/buffalo-wing"],["Buona","dish/buona"],["Busboys and Poets","dish/busboys-and-poets"],["Butter cake","dish/butter-cake"],["Byways Cafe","dish/byways-cafe"],["Caesar salad","dish/caesar-salad"],["California Grill","dish/california-grill"],["Camp Washington Chili","dish/camp-washington-chili"],["Caramel apple","dish/caramel-apple"],["Carbonara","dish/carbonara"],["Carnation Cafe","dish/carnation-cafe"],["Cheesesteak","dish/cheesesteak"],["Chicago-style hot dog","dish/chicago-style-hot-dog"],["Chicken nugget","dish/chicken-nugget"],["Chiffon cake","dish/chiffon-cake"],["Chili con carne","dish/chili-con-carne"]]}],"img":{"src":"/labs/cuisines/img/thumb/3/3e/Original_Joes_North_Beach_SF.jpg/500px-Original_Joes_North_Beach_SF.jpg","w":500,"h":333,"by":"Original Joes","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","page":"https://commons.wikimedia.org/wiki/File:Original_Joes_North_Beach_SF.jpg"}},"ingredient/palapa-condiment":{"t":"ingredient","r":"ingredient/palapa-condiment","n":"Palapa (condiment)","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 3 cuisines","intro":[["Palapa is a sweet and spicy Filipino condiment made from thinly chopped white scallions (sakurab), pounded ginger (luya pagirison), turmeric (kalawag), labuyo chili (luya tiduk), and toasted grated coconut (niog). It originates from the Maranao people of Lanao del Sur. The ingredients are mixed together and cooked briefly or cooked until slightly dry. It is stored immediately in sealed jars (garapon) after cooking. Palapa can be used as an ingredient in certain dishes, most notably in piaparan, or as a condiment after briefly sautéing, often with a spoonful of condensed milk. It can also be eaten fresh as salad dressing. Palapa is an important cultural symbol of the Maranao people and is a common accompaniment at every meal."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-palapa-condiment"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Palapa_(condiment)"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Filipino cuisine","cuisine/filipino-cuisine",[["Piaparan","dish/piaparan"]]],["Mindanao cuisine","cuisine/filipino-cuisine-mindanao",[["Piaparan","dish/piaparan"]]],["Visayan cuisine","cuisine/filipino-cuisine-visayas",[["Piaparan","dish/piaparan"]]]]},{"h":"Often cooked with","links":[["Coconut milk","ingredient/coconut-milk"],["Garlic","ingredient/garlic"],["Turmeric","ingredient/turmeric"]]}],"img":{"src":"/labs/cuisines/img/thumb/6/6d/Palapa_%28Philippines%29.jpg/500px-Palapa_%28Philippines%29.jpg","w":500,"h":358,"by":"Obsidian Soul","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Palapa_(Philippines).jpg"}},"ingredient/almond-paste":{"t":"ingredient","r":"ingredient/almond-paste","n":"Almond paste","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 4 cuisines","intro":[["Almond paste is made from ground almonds or almond meal and sugar in equal quantities, with small amounts of cooking oil, eggs, heavy cream or corn syrup added as a binder. It is similar to marzipan, with a coarser texture. Almond paste is used as a filling in pastries, but it can also be found in chocolates. In a type of commercially manufactured almond paste called persipan, ground apricot or peach pits are added to save money."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-almond-paste"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Almond_paste"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Finnish cuisine","cuisine/finnish-cuisine",[["Semla","dish/semla"]]],["French cuisine","cuisine/french-cuisine",[["Pithivier","dish/pithivier"]]],["New Caledonian cuisine","cuisine/new-caledonian-cuisine",[["Pithivier","dish/pithivier"]]],["Swedish cuisine","cuisine/swedish-cuisine",[["Semla","dish/semla"]]]]},{"h":"Often cook