a_Exterior_Gotanda.jpg/500px-Izakaya_Exterior_Gotanda.jpg","w":500,"h":333,"by":"Japanexperterna","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Izakaya_Exterior_Gotanda.jpg"}},"ingredient/rye-bread":{"t":"ingredient","r":"ingredient/rye-bread","n":"Rye bread","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 4 dishes across 11 cuisines","intro":[["Rye bread is a type of bread made with various proportions of flour from rye grain. It can be light or dark in color, depending on the type of flour used and the addition of coloring agents, and is typically denser than bread made from wheat flour. Compared to white bread, it is higher in fiber, darker in color, and stronger in flavor. The world's largest exporter of rye bread is Poland."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-rye-bread"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Rye_bread"}],"sections":[{"h":"Where it's cooked with","count":11,"groups":[["Estonian cuisine","cuisine/estonian-cuisine",[["Kvass","dish/kvass"],["Smörgåstårta","dish/smorgastarta"]]],["American cuisine","cuisine/american-cuisine",[["Reuben sandwich","dish/reuben-sandwich"]]],["Finnish cuisine","cuisine/finnish-cuisine",[["Smörgåstårta","dish/smorgastarta"]]],["Georgian cuisine","cuisine/georgian-cuisine",[["Kvass","dish/kvass"]]],["Icelandic cuisine","cuisine/icelandic-cuisine",[["Smörgåstårta","dish/smorgastarta"]]],["Jewish cuisine","cuisine/jewish-cuisine",[["Reuben sandwich","dish/reuben-sandwich"]]],["Latvian cuisine","cuisine/latvian-cuisine",[["Kvass","dish/kvass"]]],["Lithuanian cuisine","cuisine/lithuanian-cuisine",[["Kvass","dish/kvass"]]],["Russian cuisine","cuisine/russian-cuisine",[["Karelian pasty","dish/karelian-pasty"]]],["Swedish cuisine","cuisine/swedish-cuisine",[["Smörgåstårta","dish/smorgastarta"]]],["Ukrainian cuisine","cuisine/ukrainian-cuisine",[["Kvass","dish/kvass"]]]]},{"h":"Of