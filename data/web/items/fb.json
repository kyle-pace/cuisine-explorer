 ramen","dish/iekei-ramen"],["Inago no tsukudani","dish/inago-no-tsukudani"],["Ishikawa (restaurant)","dish/ishikawa-restaurant"],["Italian Tomato","dish/italian-tomato"],["Itamae","dish/itamae"],["Itsu","dish/itsu"],["Ivan Ramen","dish/ivan-ramen"],["Izakaya","dish/izakaya"],["Izumi (restaurant)","dish/izumi-restaurant"],["Japanese cheesecake","dish/japanese-cheesecake"],["Japanese noodles","dish/japanese-noodles"],["Japanese restaurant","dish/japanese-restaurant"],["Japanese tea","dish/japanese-tea"],["Jingisukan","dish/jingisukan"],["Kadowaki (restaurant)","dish/kadowaki-restaurant"],["Kaki furai","dish/kaki-furai"],["Kamaboko","dish/kamaboko"],["Kanda (restaurant)","dish/kanda-restaurant"]]}]},"ingredient/groats":{"t":"ingredient","r":"ingredient/groats","n":"Groats","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 1 dish across 3 cuisines","intro":[["Groats (or in some cases, \"berries\") are the hulled  kernels of various cereal grains, such as oats, wheat, rye, and barley. Groats are whole grains that include the cereal germ and fiber-rich bran portion of the grain, as well as the endosperm (which is the usual product of milling)."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-groats"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Groats"}],"sections":[{"h":"Where it's cooked with","count":3,"groups":[["Belarusian cuisine","cuisine/belarusian-cuisine",[["Krupnik (soup)","dish/krupnik-soup"]]],["Polish cuisine","cuisine/polish-cuisine",[["Krupnik (soup)","dish/krupnik-soup"]]],["Ukrainian cuisine","cuisine/ukrainian-cuisine",[["Krupnik (soup)","dish/krupnik-soup"]]]]},{"h":"Often cooked with","links":[["Barley","ingredient/barley"],["Broth","ingredient/broth"],["Groat","ingredient/groat"],["Potatoes","ingredient/potatoes"]]}],"img":{"src":"/labs/cuisines/img/thumb/b/b3/Pigeons_food_cereals_mix.jpg/500px-Pigeons_food_cereals_mix.jpg","w":500,"h":763,"by":"Rakoon","lic":"CC0","licUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Pigeons_food_cereals_mix.jpg"}},"dish/pozole":{"t":"dish","r":"dish/pozole","n":"Pozole","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Mexican cuisine","dot":"#94bd5c","intro":[["Pozole is a traditional soup or stew from Mexican cuisine. It is made from hominy with meat (typically chicken or pork), and can be seasoned and garnished with shredded lettuce or cabbage, chili peppers, onion, garlic, radishes, avocado, salsa or limes.  Known in Mesoamerica since the pre-Columbian era, the stew is common across Mexico and neighboring countries, served both as a day-to-day meal and as a festive dish."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-pozole"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Pozole"}],"sections":[{"h":"Where it's from","links":[["Mexican cuisine","cuisine/mexican-cuisine"]]},{"h":"Ingredients","count":4,"links":[["Chicken","ingredient/chicken"],["Chile pepper","ingredient/chile-pepper"],["Hominy","ingredient/hominy"],["Pork","ingredient/pork"]]},{"h":"Cook it","rows":[{"name":"Mexico in My Kitchen","ref":"site/mexicoinmykitchen-com","color":"#55b8ad","shape":"site","sub":"mexicoinmykitchen.com","note":"Mely Martínez's long-running blog of Mexican home-style recipes.","url":"https://www.mexicoinmykitchen.com/","suggested":true},{"name":"Pati Jinich","ref":"site/patijinich-com","color":"#55b8ad","shape":"site","sub":"patijinich.com","note":"Recipe archive from the Mexican-born chef and host of the PBS series Pati's Mexican Table.","url":"https://patijinich.com/recipes/","suggested":true}]},{"h":"More from Mexican cuisine","links":[["Acapulco Mexican Restaurant and Cantina","dish/acapulco-mexican-restaurant-and-cantina"],["Amigos (restaurant chain)","dish/amigos-restaurant-chain"],["Animalón","dish/animalon"],["Anna's Taqueria","dish/anna-s-taqueria"],["Baker's Drive-Thru","dish/baker-s-drive-thru"],["Barburrito","dish/barburrito"],["Bir