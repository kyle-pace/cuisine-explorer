":3,"groups":[["Cuisine of New Orleans","cuisine/cuisine-of-new-orleans",[["Red beans and rice","dish/red-beans-and-rice"]]],["Louisiana Creole cuisine","cuisine/louisiana-creole-cuisine",[["Red beans and rice","dish/red-beans-and-rice"]]],["Soul food","cuisine/soul-food",[["Red beans and rice","dish/red-beans-and-rice"]]]]},{"h":"Often cooked with","links":[["Bell pepper","ingredient/bell-pepper"],["Celery","ingredient/celery"],["Kidney bean","ingredient/kidney-bean"],["Onion","ingredient/onion"],["Pork","ingredient/pork"],["Rice","ingredient/rice"],["Small red beans","ingredient/small-red-beans"]]}]},"ingredient/vanilla-extract":{"t":"ingredient","r":"ingredient/vanilla-extract","n":"Vanilla extract","c":"#c9b8dd","crumb":[["Ingredients","ingredients"]],"sub":"Ingredient in 2 dishes across 4 cuisines","intro":[["Vanilla extract is a solution made by macerating and percolating vanilla pods in a solution of ethanol and water. It is considered an essential ingredient in many Western desserts, especially baked goods like cakes, cookies, brownies, and cupcakes, as well as custards, ice creams, and puddings. Although its primary flavor compound is vanillin, pure vanilla extract contains several hundred additional flavor compounds, which are responsible for its characteristic complex, deep flavor. By contrast, artificial vanilla flavor is typically  made up of only artificially derived vanillin, which is frequently made from a by-product of the wood pulp industry."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"ingredient-vanilla-extract"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Vanilla_extract"}],"sections":[{"h":"Where it's cooked with","count":4,"groups":[["Belarusian cuisine","cuisine/belarusian-cuisine",[["Syrniki","dish/syrniki"]]],["Portuguese cuisine","cuisine/portuguese-cuisine",[["Serradura","dish/serradura"]]],["Russian cuisine","cuisine/russian-cuisine",[["Syrniki","dish/syrniki"]]],["Ukrainian cuisine","cuisine/ukrainian-cuisine",[["Syrniki","dish/syrniki"]]]]},{"h":"Often cooked with","links":[["Biscuit","ingredient/biscuit"],["Condensed milk","ingredient/condensed-milk"],["Cream","ingredient/cream"],["Marie biscuit","ingredient/marie-biscuit"],["Whipped cream","ingredient/whipped-cream"],["Cottage cheese","ingredient/cottage-cheese"],["Egg","ingredient/egg"],["Quark (dairy product)","ingredient/quark-dairy-product"],["Raisin","ingredient/raisin"],["Sugar","ingredient/sugar"],["Tvorog","ingredient/tvorog"],["Wheat flour","ingredient/wheat-flour"]]}]},"dish/soured-milk":{"t":"dish","r":"dish/soured-milk","n":"Soured milk","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish found in 2 cuisines","dot":"#f0b340","intro":[["Soured milk, sour milk, spontaneously soured milk, or naturally soured milk is the milk product fermented with indigenous microorganisms (chiefly mesophilic lactic acid bacteria), as opposed to cultured milk, of which the production involves controlled fermentation with starter cultures. Lactic acid produced by the bacteria brings tart taste and causes milk to coagulate and thicken, inhibiting the growth of harmful bacteria and improving the product's shelf life. It is unlike \"spoiled milk\" and is historically used for culinary, nutritional and preservation purposes in many cultures."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-soured-milk"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Soured_milk"}],"sections":[{"h":"Where it's from","links":[["Russian cuisine","cuisine/russian-cuisine"],["Ukrainian cuisine","cuisine/ukrainian-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Milk","ingredient/milk"]]},{"h":"Cook it","rows":[{"name":"Olga's Flavor Factory","ref":"site/olgasflavorfactory-com","color":"#55b8ad","shape":"site","sub":"olgasflavorfactory.com","note":"Russian-born home cook Olga's blog, with a dedicated Russian recipes category.","url":"https://www.olgasflavorfactory.com/category/russianrecipes/","suggested":true},{"name":"Savas Kitchen: Ukrainian recipes","ref":"site/savaskitchen-com","color":"#55b8ad","shape":"site","sub":"savaskitchen.com","note":"Ukrainian-born home cook Nataliia Savas's section of family Ukrainian recipes.","url":"https://savaskitchen.com/category/ukrainian-recipes","suggested":true}]},{"h":"More from Russian cuisine","links":[["Aspic","dish/aspic"],["Baba (cake)","dish/baba-cake"],["Beef Stroganoff","dish/beef-stroganoff"],["Blini","dish/blini"],["Borscht","dish/borscht"],["Cabbage roll","dish/cabbage-roll"],["Cabbage soup","dish/cabbage-soup"],["Caesar salad","dish/caesar-salad"],["Chicken Kiev","dish/chicken-kiev"],["Chrain","dish/chrain"],["Dressed herring","dish/dressed-herring"],["Forshmak","dish/forshmak"],["Goulash","dish/goulash"],["Gugelhupf","dish/gugelhupf"],["Kachka (restaurant)","dish/kachka-restaurant"],["Karelian pasty","dish/karelian-pasty"],["Kasha","dish/kasha"],["Khrenovina sauce","dish/khrenovina-sauce"],["Kolach (bread)","dish/kolach-bread"],["Kringle","dish/kringle"],["Medovukha","dish/medovukha"],["Mimosa salad","dish/mimosa-salad"],["Mors (drink)","dish/mors-drink"],["Nesselrode pudding","dish/nesselrode-pudding"],["Okroshka","dish/okroshka"],["Olivier salad","dish/olivier-salad"],["Pancake","dish/pancake"],["Paska (bread)","dish/paska-bread"],["Pâté","dish/pate"],["Pelmeni","dish/pelmeni"],["Pie","dish/pie"],["Pirozhki","dish/pirozhki"],["Polonaise sauce","dish/polonaise-sauce"],["Potato pancake","dish/potato-pancake"],["Pozharsky cutlet","dish/pozharsky-cutlet"],["Rassolnik","dish/rassolnik"],["Sauerkraut","dish/sauerkraut"],["Shchi","dish/shchi"],["Solyanka","dish/solyanka"],["Sorrel soup","dish/sorrel-soup"]]}]},"dish/taiwanese-fried-chicken-cutlet":{"t":"dish","r":"dish/taiwanese-fried-chicken-cutlet","n":"Taiwanese fried chicken cutlet","c":"#ede6da","crumb":[["Dishes","dishes"]],"sub":"Dish from Taiwan cuisine","dot":"#f0b340","intro":[["Taiwanese fried chicken cutlet is a common street food that was popularized in the 1990s in Taiwan and is often found in night markets. The dish consists of marinated chicken breast fillets that are dredged in sweet potato flour and rice flour, breaded with panko, shallow-fried, and then seasoned with various different spices. Salt, five-spice powder, and white pepper are the most fundamental seasonings for this dish, though other spices such as ginger powder, garlic powder, cumin, MSG, chili powder, paprika, curry leaves, sugar, sesame oil, and li hing mui powder are also used."]],"src":"wikipedia","actions":[{"kind":"globe","hash":"dish-taiwanese-fried-chicken-cutlet"},{"kind":"wiki","url":"https://en.wikipedia.org/wiki/Taiwanese_fried_chicken_cutlet"}],"sections":[{"h":"Where it's from","links":[["Taiwan cuisine","cuisine/taiwan-cuisine"]]},{"h":"Ingredients","count":1,"links":[["Fried chicken","ingredient/fried-chicken"]]},{"h":"Cook it","rows":[{"name":"Cooking in Chinglish","ref":"site/cookinginchinglish-com","color":"#55b8ad","shape":"site","sub":"cookinginchinglish.com","note":"Taiwanese home recipes from Edwina, who grew up in Taiwan.","url":"https://cookinginchinglish.com","suggested":true},{"name":"Tiny Urban Kitchen: Taiwanese Recipes","ref":"site/tinyurbankitchen-com","color":"#55b8ad","shape":"site","sub":"tinyurbankitchen.com","note":"Small set of Taiwanese recipes from Jen Che, a Taiwanese American blogger in Hong Kong.","url":"https://tinyurbankitchen.com/taiwanese-recipes/","suggested":true}]},{"h":"More from Taiwan cuisine","links":[["886 (restaurant)","dish/886-restaurant"],["Ageh (food)","dish/ageh-food"],["Alivongvong","dish/alivongvong"],["Alkemē","dish/alkeme"],["Apple bread","dish/apple-bread"],["Bah-uân","dish/bah-uan"],["Braised pork rice","dish/braised-pork-rice"],["Coffin bread","dish/coffin-bread"],["Doujiang","dish/doujiang"],["Egg yolk pastry","dish/egg-yolk-pastry"],["Iron egg","dish/iron-egg"],["Kato (restaurant)","dish/kato-restaurant"],["Kiâm-piánn","dish/kiam-piann"],["Ló͘-bah-pn̄g","dish/lo-bah-png"],["Mongolian barbecue","dish/mongolian-b