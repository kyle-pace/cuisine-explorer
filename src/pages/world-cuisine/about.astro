---
// About World cuisine. Title, headings and step format follow the about-page skill
// (.agents/skills/about-page/SKILL.md). "How it works" sits beside "Where the data comes
// from" on wide screens, with big step numbers in the margin. Counts come from the data files.
import DevLayout from 'kp-design/layouts/DevLayout.astro';

const files = import.meta.glob<{ default: any }>(
  ['../../../data/cuisines.json', '../../../data/picks.json', '../../../data/suggestions.json', '../../../data/food.json'],
  { eager: true },
);
const read = (name: string) => files[`../../../data/${name}`]?.default ?? {};
const cuisines = read('cuisines.json').cuisines ?? [];
const meta = read('cuisines.json').meta ?? {};
const dishes: number = (read('food.json').dishes ?? []).length;
const ingredients: number = (read('food.json').ingredients ?? []).length;
const shelved = new Set([...Object.keys(read('picks.json').cuisines ?? {}), ...Object.keys(read('suggestions.json').cuisines ?? {})]).size;
const n = (x: number) => x.toLocaleString('en-US');
const pages = n(Math.round((cuisines.length + dishes + ingredients) / 100) * 100);

const sources = [
  { name: 'Wikipedia', href: 'https://en.wikipedia.org/wiki/List_of_cuisines', what: 'its List of cuisines, and each cuisine’s intro from its own article (CC BY-SA)' },
  { name: 'Wikidata', href: 'https://www.wikidata.org', what: 'places and countries, dishes, and what goes in them' },
  { name: 'FAO’s FAOSTAT', href: 'https://www.fao.org/faostat/en/#data/QCL', what: 'where each ingredient is grown (CC BY 4.0)' },
  { name: 'Wikimedia Commons', href: 'https://commons.wikimedia.org', what: 'photos, each with its credit' },
  { name: 'Natural Earth', href: 'https://www.naturalearthdata.com', what: 'the shapes of countries' },
  { name: 'Open Library', href: 'https://openlibrary.org', what: 'cookbook covers' },
];

const steps = [
  {
    name: 'Read Wikipedia’s list of cuisines',
    where: 'GitHub Actions, once a week',
    body: [
      'A script reads Wikipedia’s List of cuisines from top to bottom and keeps its shape: which continent a cuisine is under, which country, which region. That shape is the explorer’s shape. I don’t reorder it.',
    ],
  },
  {
    name: 'Look up each cuisine, dish and ingredient',
    where: 'GitHub Actions, once a week',
    body: [
      `For every cuisine, it fetches the opening of its Wikipedia article and asks Wikidata where in the world it belongs. Then it gathers dishes and their ingredients from Wikidata and from the fact boxes on Wikipedia’s dish pages. Today that comes to ${n(cuisines.length)} cuisines, ${n(dishes)} dishes and ${n(ingredients)} ingredients.`,
    ],
  },
  {
    name: 'Add where ingredients grow, and photos',
    where: 'GitHub Actions, once a week',
    body: [
      'FAOSTAT says which countries grow each ingredient, which is how searching an ingredient lights up the globe. Photos come from Wikimedia Commons with the photographer’s credit.',
    ],
  },
  {
    name: 'Add my own notes and picks',
    where: 'By hand, in the site’s code',
    body: [
      `Wikipedia leaves gaps, most of all for Indigenous foodways. Where it does, I write short notes from tribal, museum and health sources (${n(meta.notes ?? 0)} so far), each with a link to suggest a correction. The cookbooks and recipe sites are mine to choose: ${n(shelved)} cuisines have a shelf, and anything marked “suggested” is research I haven’t reviewed yet.`,
    ],
  },
  {
    name: 'Check the new data before publishing',
    where: 'GitHub Actions, once a week',
    body: [
      'The new data is compared with last week’s. If it lost a big share of its cuisines, dishes, ingredients or photos, something went wrong along the way, so the new data is thrown out and last week’s stays up.',
    ],
  },
  {
    name: 'The site rebuilds',
    where: 'Cloudflare, whenever the data changes',
    body: [
      `The globe is drawn in your browser from plain data files. There’s no database. The page for each cuisine, dish and ingredient, about ${pages} of them, is put together when someone asks for it. Each photo is fetched from Wikimedia once and kept on this site’s own storage, so Wikimedia isn’t asked again on every visit.`,
    ],
  },
];
---

<DevLayout
  title="About World cuisine"
  description="What World cuisine is, how it works, where its cuisines, dishes, ingredients and photos come from, and what it collects."
  accent="tangerine"
  image="/world-cuisine/share-about.png"
  imageAlt="About World cuisine: the title beside a card listing its six steps, from Read Wikipedia’s list of cuisines to The site rebuilds."
>
  <header class="intro">
    <p class="back"><a href="/world-cuisine/">World cuisine</a></p>
    <h1>About World cuisine</h1>
  </header>

  <div class="about prose">
    <h2>What it is</h2>
    <p>
      <a href="/world-cuisine/">A globe of the world’s cuisines</a>: {n(cuisines.length)} of them across {n(meta.national ?? 0)} countries and
      territories, with {n(dishes)} dishes and {n(ingredients)} ingredients. Search an ingredient and the globe becomes a map of where it’s
      cooked with, or pick a dish to see where it’s from and what goes in it. It’s refreshed every week.
    </p>
  </div>

  <div class="columns">
    <section class="steps" aria-labelledby="how-title">
      <h2 id="how-title">How it works</h2>
      <ol>
        {
          steps.map((step) => (
            <li>
              <h3>{step.name}</h3>
              <p class="where">Where it runs: {step.where}.</p>
              {step.body.map((text) => <p>{text}</p>)}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Where the data comes from</h2>
      <ul>
        {
          sources.map((source) => (
            <li>
              <a href={source.href}>{source.name}</a>: {source.what}
            </li>
          ))
        }
        <li>My own notes and picks, added by hand</li>
      </ul>
    </section>
  </div>

  <div class="about prose">
    <h2>Good to know</h2>
    <p>
      Wikipedia is the source of truth here, so the place to fix a fact about a cuisine is its Wikipedia article. The fix shows up on the globe
      within a week. Corrections to my own notes can go through the link on each note.
    </p>
    <p>
      The weekly refresh is tested against a saved copy of Wikipedia’s list and against broken ones, so a bad download can’t empty the
      explorer.
    </p>

    <h2>Privacy</h2>
    <p>
      Analytics works the same as the rest of kylepace.dev: anonymous, no cookies, and you can turn it off
      (<a href="https://kylepace.dev/privacy/">privacy</a>). Photos load from this site. Cookbook covers load from Open Library, and opening a
      cuisine asks Wikipedia for its latest intro, so those two see a normal visit from your browser.
    </p>

    <h2>Get in touch</h2>
    <p>
      Questions or a correction: email <a href="mailto:mail@kylepace.net">mail@kylepace.net</a>. The code and data are{' '}
      <a href="https://github.com/kyle-pace/world-cuisine">on GitHub</a>.
    </p>
  </div>
</DevLayout>

<style>
  .intro {
    padding-bottom: var(--space-4);
  }

  .back {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
  }

  /* At least 24px tall to tap */
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--step-1);
  }

  .about h2:not(:first-child) {
    margin-top: var(--space-8);
  }

  /* How it works beside the sources on wide screens; stacked, steps first, on phones. */
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 40rem) minmax(14rem, 20rem);
    gap: var(--space-8) var(--space-12);
    margin: var(--space-8) 0;
    padding-top: var(--space-6);
    border-top: 3px solid var(--ink);
  }

  .steps ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    counter-increment: step;
    padding: 0 0 var(--space-6) 3rem;
  }

  /* Big step numbers in the margin. */
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.08em;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }

  .steps h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .where {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .steps p {
    max-width: 36rem;
  }

  .steps p:not(.where) {
    margin: 0 0 var(--space-2);
  }

  .sources ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sources li {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .sources li:first-child {
    border-top: 1px solid var(--line);
  }

  .sources a {
    font-weight: 700;
  }

  @media (max-width: 52rem) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
