---
// The ingredient map, at /world-cuisine/ingredient-map/: every ingredient in three or more
// dishes, placed near what it's cooked with, so neighborhoods form on their own. The
// grouping and layout are worked out at build time (scripts/build_ingredient_map.mjs,
// data/ingredient_map.json) and drawn here as a plain SVG (scripts/ingredient_map_svg.mjs),
// so the page needs only a small script for the highlighting. The list under the map is
// the same thing in words, for screen readers, keyboards and phones.
// Design plan: design/PLAN.md, "Ingredient map".
import DevLayout from 'kp-design/layouts/DevLayout.astro';
// @ts-expect-error: plain JS shared with the share card
import { mapSvg } from '../../../scripts/ingredient_map_svg.mjs';
import map from '../../../data/ingredient_map.json';
import food from '../../../data/food.json';

const n = (x: number) => x.toLocaleString('en-US');
const dishes = (food as { dishes?: unknown[] }).dishes?.length ?? 0;
const byId = new Map(map.nodes.map((node: any) => [node.id, node]));
const list = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}` : (xs[0] ?? ''));
const svg = mapSvg(map, { title: `Ingredient map: ${map.nodes.length} ingredients in ${map.groups.length} neighborhoods` });
---

<DevLayout
  title="Ingredient map"
  description={`${map.nodes.length} ingredients from World cuisine's dishes, grouped by what they're cooked with: ${map.groups.length} neighborhoods that formed on their own.`}
  accent="tangerine"
  image="/world-cuisine/share-ingredient-map.png"
  imageAlt="Ingredient map: World cuisine's ingredients as dots grouped into named neighborhoods on a dark background, with saffron paths between them."
>
  <nav class="cx-top" aria-label="World cuisine">
    <a href="/world-cuisine/">World cuisine</a>
    <span aria-hidden="true">/</span>
    <span>Ingredient map</span>
  </nav>

  <article class="imap">
    <h1>Ingredient map</h1>
    <p class="say">
      {n(map.nodes.length)} ingredients from {n(dishes)} dishes, each near the ones it shares dishes with. The {map.groups.length} neighborhoods
      formed on their own.
    </p>

    <div class="frame">
      <div class="pan" tabindex="-1">
        <Fragment set:html={svg} />
      </div>
    </div>
    <p class="now" id="map-now" aria-live="polite">
      Point at or tap an ingredient to light up what it’s cooked with<span class="touch-only">, then tap it again to open it. Drag the map sideways to see all of it</span>.
    </p>

    <section aria-labelledby="hoods-title" class="hoods">
      <h2 id="hoods-title">The neighborhoods</h2>
      <ol>
        {
          map.groups.map((g: any) => (
            <li id={`hood-${g.id}`}>
              <h3>{g.name}</h3>
              <p class="from">Mostly in {list(g.cuisines)} dishes. {g.members.length} ingredients.</p>
              <ul class="members">
                {g.members.map((id: string) => {
                  const node: any = byId.get(id);
                  return node ? (
                    <li>
                      <a href={`/world-cuisine/ingredient/${node.slug}/`} data-slug={node.slug} data-hood={g.name}>
                        {node.name}
                      </a>
                    </li>
                  ) : null;
                })}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <p class="how">
      Two ingredients are close when they share dishes, counted so everyday ones like sugar and egg don’t pull everything together. The
      neighborhoods are found from those links and named for their two most-used ingredients. <a href="/world-cuisine/about/">How World
      cuisine works</a>.
    </p>
  </article>
</DevLayout>

<script>
  import { track } from 'kp-design/analytics';

  const svg = document.querySelector<SVGSVGElement>('svg.ingredient-map');
  const now = document.getElementById('map-now');
  const resting = now?.textContent ?? '';
  let lit: string | null = null;

  function light(slug: string | null) {
    if (!svg || slug === lit) return;
    lit = slug;
    svg.classList.toggle('active', !!slug);
    svg.querySelectorAll('.on').forEach((el) => el.classList.remove('on', 'me'));
    if (!slug) {
      if (now) now.textContent = resting;
      return;
    }
    const me = svg.querySelector<SVGAElement>(`a.ing[data-slug="${CSS.escape(slug)}"]`);
    if (!me) return;
    const near = (me.dataset.near ?? '').split(' ').filter(Boolean);
    me.classList.add('on', 'me');
    for (const s of near) svg.querySelector(`a.ing[data-slug="${CSS.escape(s)}"]`)?.classList.add('on');
    svg.querySelectorAll<SVGLineElement>('.links line').forEach((l) => {
      if ((l.dataset.a === slug && near.includes(l.dataset.b ?? '')) || (l.dataset.b === slug && near.includes(l.dataset.a ?? ''))) l.classList.add('on');
    });
    if (now) now.textContent = me.dataset.say ?? '';
  }

  const target = (e: Event) => (e.target as Element | null)?.closest<SVGAElement>('a.ing');
  // On touch there's no pointing, so the first tap lights an ingredient and a second tap opens it
  let touch = false;
  svg?.addEventListener('pointerdown', (e) => (touch = e.pointerType === 'touch'));
  svg?.addEventListener('click', (e) => {
    const a = target(e);
    if (touch && a && a.dataset.slug !== lit) {
      e.preventDefault();
      e.stopImmediatePropagation();
      light(a.dataset.slug ?? null);
    }
  }, true);
  svg?.addEventListener('pointerover', (e) => { if (e.pointerType !== 'touch') light(target(e)?.dataset.slug ?? lit); });
  svg?.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') light(null); });
  // Focus lights an ingredient for keyboards; a tap also focuses it, and the click handles that
  let pointing = false;
  svg?.addEventListener('pointerdown', () => (pointing = true));
  document.addEventListener('keydown', () => (pointing = false));
  svg?.addEventListener('focusin', (e) => { if (!pointing) light(target(e)?.dataset.slug ?? null); });
  svg?.addEventListener('focusout', (e) => {
    if (!svg.contains((e as FocusEvent).relatedTarget as Node | null)) light(null);
  });

  // A link from an ingredient's page (/world-cuisine/ingredient-map/#lemongrass) lights it up
  const fromHash = decodeURIComponent(location.hash.slice(1));
  if (fromHash) {
    light(fromHash);
    svg?.querySelector(`a.ing[data-slug="${CSS.escape(fromHash)}"]`)?.scrollIntoView({ block: 'center', inline: 'center' });
  }

  // Which ingredients people open from the map, and whether from the drawing or the list
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest<HTMLAnchorElement | SVGAElement>('a.ing, .members a');
    if (!a) return;
    const slug = a.dataset.slug ?? '';
    const hood = a.dataset.hood ?? svg?.querySelector<SVGTextElement>(`.hoods text:nth-child(${Number(a.dataset.group ?? 0) + 1})`)?.textContent ?? '';
    track('Opened Ingredient', { experiment: 'world-cuisine', ingredient_slug: slug, neighborhood: hood, from: a.closest('svg') ? 'ingredient map' : 'neighborhood list' });
  });
</script>

<style is:global>
  .cx-top { max-width: var(--wide); margin: var(--space-8) auto 0; padding: 0 var(--space-4); font-size: var(--step--1); color: var(--ink-muted); display: flex; gap: var(--space-2); }
  .cx-top a { color: inherit; text-underline-offset: 3px; }

  .imap { max-width: var(--wide); margin: var(--space-4) auto var(--space-16); padding: 0 var(--space-4); }
  .imap h1 { font-family: var(--font-display); font-size: var(--step-4); line-height: 1.05; margin: 0 0 var(--space-2); }
  .imap .say { max-width: var(--measure); color: var(--ink-muted); margin: 0 0 var(--space-6); }

  /* The map: the explorer's dark ground, whatever the site's theme */
  .imap .frame { background: #1b1424; border-radius: var(--radius); overflow: hidden; }
  /* Phones: the map keeps a readable size and pans sideways inside its frame */
  .imap .pan { overflow-x: auto; overscroll-behavior-x: contain; }
  .ingredient-map { display: block; width: 100%; min-width: 56rem; height: auto; font-family: var(--font-text); }

  .ingredient-map .grounds circle { fill: #241b2f; stroke: #3a3045; stroke-width: 1.5; }
  .ingredient-map .links line { stroke: #4a3f57; }
  .ingredient-map .links line.x:not(.on) { display: none; }
  .ingredient-map .hoods text { fill: #f0b340; font-size: 22px; font-weight: 700; paint-order: stroke; stroke: #1b1424; stroke-width: 6px; }
  .ingredient-map .hit { fill: transparent; }
  .ingredient-map .dot { fill: #8a7a9c; stroke: #ede6da; stroke-width: 1.5; }
  .ingredient-map .lab { fill: #ede6da; font-size: 15px; paint-order: stroke; stroke: #1b1424; stroke-width: 5px; stroke-linejoin: round; pointer-events: none; }
  .ingredient-map .lab.more { display: none; }
  .ingredient-map a.ing { outline: none; }

  /* Lit: the ingredient and its neighbors go saffron, everything else steps back */
  .ingredient-map.active .dots a.ing:not(.on) { opacity: 0.28; }
  .ingredient-map.active .links line:not(.on) { opacity: 0.25; }
  .ingredient-map.active .hoods text { opacity: 0.45; }
  .ingredient-map a.ing.on .lab.more { display: inline; }
  .ingredient-map a.ing.on .dot { fill: #ede6da; }
  .ingredient-map a.ing.me .dot { fill: #f0b340; stroke: #f0b340; }
  .ingredient-map a.ing.me .lab { font-weight: 700; font-size: 17px; }
  .ingredient-map .links line.on { stroke: #f0b340; stroke-width: 3; }
  .ingredient-map a.ing:focus-visible .dot { stroke: #f0b340; stroke-width: 4; }

  @media (prefers-reduced-motion: no-preference) {
    .ingredient-map .dots a.ing, .ingredient-map .links line, .ingredient-map .hoods text { transition: opacity 150ms ease-out; }
  }

  .imap .touch-only { display: none; }
  @media (hover: none) { .imap .touch-only { display: inline; } }
  .imap .now { min-height: 3em; margin: var(--space-3) 0 var(--space-12); max-width: var(--measure); }

  .imap .hoods h2 { font-size: var(--step-2); margin: 0 0 var(--space-6); }
  .imap .hoods ol { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-8); }
  @media (min-width: 64rem) { .imap .hoods ol { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8) var(--space-12); } }
  .imap .hoods h3 { font-size: var(--step-1); margin: 0 0 var(--space-1); }
  .imap .from { color: var(--ink-muted); font-size: var(--step--1); margin: 0 0 var(--space-2); }
  .imap .members { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); }
  .imap .members a { display: inline-block; min-height: 1.5rem; color: inherit; text-underline-offset: 3px; }
  .imap .how { max-width: var(--measure); color: var(--ink-muted); font-size: var(--step--1); margin-top: var(--space-12); }
  .imap .how a { color: inherit; }
</style>
