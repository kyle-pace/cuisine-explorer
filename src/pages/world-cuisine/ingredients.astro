---
// Every ingredient, at /world-cuisine/ingredients/: all of World cuisine's ingredients on
// shelves of what they're cooked with. The grouping is worked out at build time
// (scripts/build_ingredient_groups.mjs, data/ingredient_groups.json); the page is plain
// lists of links, with a small script for the find box. Ingredient pages link here with
// #ing-<slug>, which marks that ingredient on its shelf (CSS :target, no script).
// Design plan: design/PLAN.md, "Every ingredient".
import DevLayout from 'kp-design/layouts/DevLayout.astro';
import data from '../../../data/ingredient_groups.json';
import food from '../../../data/food.json';

type Item = { id: string; name: string; slug: string; dishes: number };
type Shelf = { id: string; name: string; cuisines: string[]; lead: Item[]; rest: Item[]; size: number };
const shelves = data.groups as Shelf[];
const n = (x: number) => x.toLocaleString('en-US');
const dishes = (food as { dishes?: unknown[] }).dishes?.length ?? 0;
const list = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}` : (xs[0] ?? ''));
const from = (s: Shelf) =>
  s.cuisines.length
    ? `${n(s.size)} ingredients, mostly in ${list(s.cuisines)} dishes.`
    : `${n(s.size)} ingredients from dishes that list few others, so there’s nothing yet to group them by.`;
const href = (i: Item) => `/world-cuisine/ingredient/${i.slug}/`;
---

<DevLayout
  title="Every ingredient"
  description={`All ${n(data.ingredients)} ingredients in World cuisine's dishes, shelved with the ones they're cooked with.`}
  accent="tangerine"
  image="/world-cuisine/share-ingredients.png"
  imageAlt="Every ingredient: shelves of ingredient names on a dark background, each shelf named for its two most-used ingredients."
>
  <nav class="cx-top" aria-label="World cuisine">
    <a href="/world-cuisine/">World cuisine</a>
    <span aria-hidden="true">/</span>
    <span>Every ingredient</span>
  </nav>

  <article class="every">
    <h1>Every ingredient</h1>
    <p class="say">
      All {n(data.ingredients)} ingredients in World cuisine’s {n(dishes)} dishes, shelved with the ones they’re cooked with.
    </p>

    <div class="find" hidden>
      <label for="find">Find an ingredient</label>
      <input id="find" type="search" autocomplete="off" spellcheck="false" />
      <p id="found" aria-live="polite"></p>
    </div>

    <nav class="shelves" aria-label="Shelves">
      <ol>
        {shelves.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}
      </ol>
    </nav>

    {
      shelves.map((s) => (
        <section class="shelf" id={s.id} aria-labelledby={`${s.id}-name`}>
          <h2 id={`${s.id}-name`}>{s.name}</h2>
          <p class="from">{from(s)}</p>
          {s.lead.length > 0 && (
            <ul class="lead" aria-label="Most used">
              {s.lead.map((i) => (
                <li>
                  <a id={`ing-${i.slug}`} href={href(i)} data-hood={s.name}>{i.name}</a>
                </li>
              ))}
            </ul>
          )}
          <ul class="rest" aria-label={s.lead.length ? 'The rest, A to Z' : 'A to Z'}>
            {s.rest.map((i) => (
              <li>
                <a id={`ing-${i.slug}`} href={href(i)} data-hood={s.name}>{i.name}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="how">
      Two ingredients are close when they share dishes, counted so everyday ones like sugar and egg don’t pull everything together. The
      shelves are found from the ingredients in three or more dishes and named for their two most-used ones; every other ingredient joins
      the shelf its dish-mates are on. <a href="/world-cuisine/about/">How World cuisine works</a>.
    </p>
  </article>
</DevLayout>

<script>
  import { track } from 'kp-design/analytics';

  const box = document.querySelector<HTMLElement>('.find');
  const input = document.getElementById('find') as HTMLInputElement | null;
  const found = document.getElementById('found');
  const shelves = [...document.querySelectorAll<HTMLElement>('.shelf')];
  const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
  const items = shelves.flatMap((shelf) =>
    [...shelf.querySelectorAll<HTMLAnchorElement>('li a')].map((a) => ({ shelf, li: a.parentElement!, name: fold(a.textContent ?? '') })),
  );

  // The find box only works with the script, so it stays hidden without it
  if (box && input && found) {
    box.hidden = false;
    let sent = '';
    let timer = 0;
    input.addEventListener('input', () => {
      const q = fold(input.value);
      let count = 0;
      for (const it of items) {
        const show = !q || it.name.includes(q);
        it.li.hidden = !show;
        if (show) count++;
      }
      for (const shelf of shelves) {
        shelf.hidden = !!q && !items.some((it) => it.shelf === shelf && !it.li.hidden);
        for (const ul of shelf.querySelectorAll('ul')) (ul as HTMLElement).hidden = ![...ul.children].some((li) => !(li as HTMLElement).hidden);
      }
      found.textContent = !q ? '' : count ? `${count.toLocaleString('en-US')} ${count === 1 ? 'ingredient matches' : 'ingredients match'}.` : 'No ingredient matches.';
      // Whether people use the find box and whether it finds things (never what they typed)
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (q.length < 2 || q === sent) return;
        sent = q;
        track('Searched Ingredients', { experiment: 'world-cuisine', result_count: count });
      }, 1200);
    });
  }

  // Which ingredients people open from here, and from which shelf
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('.shelf a[data-hood]');
    if (!a) return;
    track('Opened Ingredient', {
      experiment: 'world-cuisine',
      ingredient_slug: a.id.replace(/^ing-/, ''),
      neighborhood: a.dataset.hood ?? '',
      from: 'ingredients page',
    });
  });
</script>

<style is:global>
  .cx-top { max-width: var(--wide); margin: var(--space-8) auto 0; padding: 0 var(--space-4); font-size: var(--step--1); color: var(--ink-muted); display: flex; gap: var(--space-2); }
  .cx-top a { color: inherit; text-underline-offset: 3px; }

  .every { max-width: 72rem; margin: var(--space-4) auto var(--space-16); padding: 0 var(--space-4); }
  .every h1 { font-family: var(--font-display); font-size: var(--step-4); line-height: 1.05; margin: 0 0 var(--space-2); }
  .every .say { max-width: var(--measure); color: var(--ink-muted); margin: 0 0 var(--space-6); }

  .every .find { margin: 0 0 var(--space-6); max-width: 28rem; }
  .every .find[hidden] { display: none; }
  .every .find label { display: block; font-weight: 700; margin-bottom: var(--space-1); }
  .every .find input {
    width: 100%; min-height: 2.75rem; padding: var(--space-2) var(--space-3); font: inherit; color: var(--ink);
    background: var(--bg-raised); border: 1px solid var(--ink-muted); border-radius: var(--radius-sm);
  }
  .every .find input:focus-visible { outline: 3px solid var(--accent-ink); outline-offset: 2px; }
  .every #found { min-height: 1.5em; margin: var(--space-1) 0 0; color: var(--ink-muted); font-size: var(--step--1); }

  /* The shelf names as a table of contents: plain links in a wrapping row */
  .every .shelves ol { list-style: none; margin: 0 0 var(--space-12); padding: var(--space-3) 0; border-block: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); font-size: var(--step--1); }
  .every .shelves a { display: inline-block; padding: var(--space-1) 0; color: inherit; text-underline-offset: 3px; }

  .every .shelf { margin: 0 0 var(--space-12); scroll-margin-top: var(--space-4); }
  .every .shelf[hidden] { display: none; }
  .every .shelf h2 { font-size: var(--step-2); line-height: 1.15; margin: 0 0 var(--space-1); color: var(--accent-ink); }
  .every .from { color: var(--ink-muted); font-size: var(--step--1); margin: 0 0 var(--space-3); max-width: var(--measure); }
  .every .shelf ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; }
  .every .shelf ul[hidden], .every .shelf li[hidden] { display: none; }
  .every .lead { gap: var(--space-1) var(--space-4); font-size: var(--step-1); font-weight: 700; margin-bottom: var(--space-2) !important; }
  .every .rest { gap: 0 var(--space-4); line-height: 1.4; }
  /* Every word on a shelf is a link and nothing else is, so they go without underlines until pointed at */
  .every .shelf a { display: inline-block; padding: 0.15rem 0; color: inherit; text-decoration: none; text-underline-offset: 3px; scroll-margin-top: 30vh; }
  .every .shelf a:hover { text-decoration: underline; }
  .every .shelf a:focus-visible { outline: 3px solid var(--accent-ink); outline-offset: 2px; border-radius: 2px; }
  /* Arriving from an ingredient's page */
  .every .shelf a:target { outline: 3px solid var(--accent-ink); outline-offset: 3px; border-radius: 2px; font-weight: 700; }

  .every .how { max-width: var(--measure); color: var(--ink-muted); font-size: var(--step--1); margin-top: var(--space-12); }
  .every .how a { color: inherit; }
</style>
